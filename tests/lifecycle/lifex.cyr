    if (g < 0) { return lx_bad("LIFE-ORPHAN-REAP", "no_grandchild", g); }
    if (lx_nspinners() != 0) { return lx_bad("LIFE-ORPHAN-REAP", "spinner_left", lx_nspinners()); }
    if (lx_kvia_w("orphan", g, s0, 500) != 9) { return lx_bad("LIFE-ORPHAN-REAP", "no_orphan_line", g); }
    if (lx_free_ok() == 0) { return lx_bad("LIFE-ORPHAN-REAP", "free_ram", lx_free()); }
    return lx_ok("LIFE-ORPHAN-REAP");
}
fn ph_orphanrace() {
