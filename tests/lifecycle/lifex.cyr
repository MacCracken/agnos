fn ph_stoppedorphan() {
    lx_phase("STOPPEDORPHAN");
    var s0 = lx_kscan();
    var p = l_spawn("stopchild");
    var t = l_us() + 1000000;
    var c = 0 - 1;
    while (l_us() < t) { c = lx_child_of(p, 0); if (c >= 0) { break; } l_sleep(2); }
    var r = lx_reap(p, 2000);
