}
fn ph_race() {
    lx_phase("RACE");
    var n = 60;
    if (LX_NCPU >= 2) { n = 200; }
    var x = 777;
    var i = 0;
    var bad = 0;
    var lastbad = 0;
    while (i < n) {
        var c = 0;
        if (i % 3 == 0) { c = l_spawn("spin"); }
        if (i % 3 == 1) { c = l_spawn("sleep 60000"); }
        if (i % 3 == 2) { c = l_spawn("sys"); }
        x = l_lcg(x);
        var ord = x % 6;
        var j = 0;
        while (j < 3) {
            var sig = 9;
            if (ord == 0) { if (j == 0) { sig = 19; } if (j == 1) { sig = 9; } if (j == 2) { sig = 18; } }
            if (ord == 1) { if (j == 0) { sig = 19; } if (j == 1) { sig = 18; } if (j == 2) { sig = 9; } }
            if (ord == 2) { if (j == 0) { sig = 9; } if (j == 1) { sig = 19; } if (j == 2) { sig = 18; } }
            if (ord == 3) { if (j == 0) { sig = 9; } if (j == 1) { sig = 18; } if (j == 2) { sig = 19; } }
            if (ord == 4) { if (j == 0) { sig = 18; } if (j == 1) { sig = 19; } if (j == 2) { sig = 9; } }
            if (ord == 5) { if (j == 0) { sig = 18; } if (j == 1) { sig = 9; } if (j == 2) { sig = 19; } }
            l_kill(c, sig);
            x = l_lcg(x);
            l_spinto(l_us() + (x % 2001));
            j = j + 1;
        }
        var r = lx_reap(c, 1000);
        if (r != 265) { bad = bad + 1; lastbad = r; if (r == (0 - 998)) { lx_killreap(c, 2000); } }
        i = i + 1;
    }
    var clean = lx_wait_nospin(1000);
    if (bad != 0) { return lx_bad("LIFE-RACE", "status", lastbad); }
    if (clean == 0) { return lx_bad("LIFE-RACE", "spinner_left", lx_nspinners()); }
    return lx_v(lx_free_ok(), "LIFE-RACE", "free_ram", lx_free());
}
# Is every LIVE descendant of root in state st? (#99 ppid chains; state 7 = dead, skipped.) n = members counted.
var LX_MEMBERS = 0;
var LX_TSUM = 0;         # the live members' tick sum (lx_tree_all)
fn lx_tree_all(root, st) {
    var n = lx_pln();
    var all = 1;
    LX_MEMBERS = 0;
    LX_TSUM = 0;
    var i = 0;
    while (i < n) {
        var r = &lx_pl + i * 64;
        var q = load64(r);
        var hop = 0;
        var x = load64(r + 16);
        var desc = 0;
        while (hop < 16) {
            if (x == root) { desc = 1; break; }
            if (x == 0) { break; }
            var xi = 0;
            var nx = 0 - 1;
            while (xi < n) { if (load64(&lx_pl + xi * 64) == x) { nx = load64(&lx_pl + xi * 64 + 16); } xi = xi + 1; }
            if (nx < 0) { break; }
            x = nx;
            hop = hop + 1;
        }
        if (q == root) { desc = 1; }
        if (desc == 1) {
            if (load64(r + 8) != 7) {
                LX_MEMBERS = LX_MEMBERS + 1;
                LX_TSUM = LX_TSUM + (load64(r + 56) & 0xFFFFFFFF);
                if (load64(r + 8) != st) { all = 0; }
            }
        }
        i = i + 1;
    }
    return all;
}
fn lx_tree_any(root, st) {
    var n = lx_pln();
    var i = 0;
    while (i < n) {
        var r = &lx_pl + i * 64;
        if (load64(r + 16) == root) { if (load64(r + 8) == st) { return 1; } }
        if (load64(r) == root) { if (load64(r + 8) == st) { return 1; } }
        i = i + 1;
    }
    return 0;
}
fn ph_tree() {
    lx_phase("TREE");
    var c = l_spawn("tree");
    var t = l_us() + 2000000;
    while (l_us() < t) { lx_tree_all(c, 99); if (LX_MEMBERS >= 3) { break; } l_sleep(5); }
    var vis = LX_MEMBERS;
    var k1 = l_kill(c, 19 | 0x100);
    var t1 = l_us() + 500000;
    var all5 = 0;
    while (l_us() < t1) { if (lx_tree_all(c, 5) == 1) { all5 = 1; break; } l_sleep(5); }
    var k2 = l_kill(c, 18 | 0x100);
    l_sleep(30);
    var any5 = lx_tree_any(c, 5);
    l_kill(c, 9 | 0x100);
    var r = lx_reap(c, 2000);
    l_sleep(500);
    var nsp = lx_nspinners();
    if (vis < 3) { lx_bad("LIFE-TREE-STOP", "members", vis); }
    else { if (k1 != 0) { lx_bad("LIFE-TREE-STOP", "kill_ret", k1); }
    else { lx_v(all5, "LIFE-TREE-STOP", "not_all_5", LX_MEMBERS); } }
    if (k2 != 0) { lx_bad("LIFE-TREE-CONT", "kill_ret", k2); } else { lx_v(any5 == 0, "LIFE-TREE-CONT", "still_5", any5); }
    if (r != 265) { return lx_bad("LIFE-TREE", "status", r); }
    if (nsp != 0) { return lx_bad("LIFE-TREE", "spinner_left", nsp); }
    return lx_v(lx_free_ok(), "LIFE-TREE", "free_ram", lx_free());
}
fn lx_noescape(mode) {
    var c = l_spawn(mode);
    l_sleep(300);
    l_kill(c, 9 | 0x100);
    var r = lx_reap(c, 2000);
    var clean = lx_wait_nospin(1000);
    if (r != 265) { return 0 - 1000 + r; }
    if (clean == 0) { return lx_nspinners(); }
    return 0;
}
fn ph_treenoescape() {
    lx_phase("TREENOESCAPE");
    var a = lx_noescape("spawnloop");
    var b = lx_noescape("forkloop");
    if (a != 0) { return lx_bad("LIFE-TREE-NOESCAPE", "spawnloop", a); }
    return lx_v(b == 0, "LIFE-TREE-NOESCAPE", "forkloop", b);
}
fn ph_treestopnoescape() {
    lx_phase("TREESTOPNOESCAPE");
    var c = l_spawn("spawnloop");
    l_sleep(300);
    var k = l_kill(c, 19 | 0x100);
    var t = l_us() + 300000;
    var all5 = 0;
    while (l_us() < t) { if (lx_tree_all(c, 5) == 1) { all5 = 1; break; } l_sleep(5); }
    var m0 = LX_MEMBERS;
    var sum0 = LX_TSUM;
    l_sleep(300);
    lx_tree_all(c, 5);
    var m1 = LX_MEMBERS;
    var sum1 = LX_TSUM;
    l_kill(c, 18 | 0x100);
    l_kill(c, 9 | 0x100);
    var r = lx_reap(c, 2000);
    var clean = lx_wait_nospin(1000);
    if (k != 0) { return lx_bad("LIFE-TREE-STOP-NOESCAPE", "kill_ret", k); }
    if (all5 == 0) { return lx_bad("LIFE-TREE-STOP-NOESCAPE", "not_all_5", m0); }
    if (m1 > m0) { return lx_bad("LIFE-TREE-STOP-NOESCAPE", "new_member", m1 - m0); }
    if (sum1 != sum0) { return lx_bad("LIFE-TREE-STOP-NOESCAPE", "ticks_moved", sum1 - sum0); }
    if (r != 265) { return lx_bad("LIFE-TREE-STOP-NOESCAPE", "status", r); }
    return lx_v(clean, "LIFE-TREE-STOP-NOESCAPE", "spinner_left", lx_nspinners());
}
fn ph_stopew37tree() {
    lx_phase("STOPEW37TREE");
    var c = l_spawn("ew37 spin");
    var t = l_us() + 3000000;
    var g = 0 - 1;
    while (l_us() < t) { g = lx_child_of(c, 0); if (g >= 0) { break; } l_sleep(5); }
    l_sleep(20);
    var k = l_kill(c, 19 | 0x100);
    var ok5 = lx_wait_state(c, 5, 500);
    var gt0 = lx_ticks(g);
    l_sleep(200);
    var gt1 = lx_ticks(g);
    var k2 = l_kill(c, 18 | 0x100);
    l_kill(c, 9 | 0x100);
    var r = lx_reap(c, 2000);
    l_sleep(500);
    var gs = lx_state(g);
    if (g < 0) { return lx_bad("LIFE-STOP-EW37-TREE", "no_grandchild", g); }
    if (k != (0 - 2)) { return lx_bad("LIFE-STOP-EW37-TREE", "tree_stop_not_-2", k); }
    if (ok5 == 0) { return lx_bad("LIFE-STOP-EW37-TREE", "waiter_not_5", lx_state(c)); }
    if (gt1 <= gt0) { return lx_bad("LIFE-STOP-EW37-TREE", "grandchild_stopped", gt1 - gt0); }
    if (k2 != 0) { return lx_bad("LIFE-STOP-EW37-TREE", "cont_ret", k2); }
    if (r != 265) { return lx_bad("LIFE-STOP-EW37-TREE", "status", r); }
    return lx_v(gs == (0 - 1), "LIFE-STOP-EW37-TREE", "grandchild_left", gs);
}
fn ph_stopzparent() {
    lx_phase("STOPZPARENT");
    var p = l_spawn("zparentspin");
    var t = l_us() + 2000000;
    var c = 0 - 1;
    while (l_us() < t) { c = lx_child_of(p, 0); if (c >= 0) { break; } l_sleep(2); }
    var z = lx_wait_state(p, 7, 2000);
    var k = l_kill(p, 19 | 0x100);
    var got5 = 0;
    var t1 = l_us() + 300000;
    while (l_us() < t1) { if (lx_state(c) == 5) { got5 = 1; } l_sleep(10); }
    var k2 = l_kill(p, 9 | 0x100);
    var cg = lx_wait_state(c, 0 - 1, 1000);
    var r = lx_reap(p, 2000);
    if (c < 0) { return lx_bad("LIFE-STOP-ZPARENT", "no_child", c); }
    if (z == 0) { return lx_bad("LIFE-STOP-ZPARENT", "parent_not_zombie", lx_state(p)); }
    if (k != (0 - 2)) { return lx_bad("LIFE-STOP-ZPARENT", "tree_stop_not_-2", k); }
    if (got5 == 1) { return lx_bad("LIFE-STOP-ZPARENT", "child_stopped", 5); }
    if (k2 != 0) { return lx_bad("LIFE-STOP-ZPARENT", "tree_kill_ret", k2); }
    if (cg == 0) { return lx_bad("LIFE-STOP-ZPARENT", "child_left", lx_state(c)); }
    return lx_v(r == 0, "LIFE-STOP-ZPARENT", "status", r);
}
fn ph_klogformat() {
    lx_phase("KLOGFORMAT");
    lx_kscan();
    if (LX_KLINES < 1) { return lx_bad("LIFE-KLOG-FORMAT", "no_lines", 0); }
    return lx_v(LX_KBAD == 0, "LIFE-KLOG-FORMAT", "unparsed", LX_KBAD);
}

# ═══════════════ 1.57.7 (S8) — PER-PROCESS RESOURCE LIMITS (spawn_limits#107; process-lifecycle.md "Resource limits") ═══════════════
# Raw #107 until cyrius wraps it. Bounded waits: memory phases 5 s, CPU phases 10 s; on expiry KILL_TREE + reap and
# -BAD timeout. N = /bin/spinner's distinct 2 MB PT_LOAD pages (the kernel's own pre-pass formula), so an image fits a
# cap of (N + 1) * 512 pages exactly (+1 = the user stack).
var LX_N = 0;
var LX_HI = 0x2000000000;
var lx_eb[512];          # 4 KB: /bin/spinner's first bytes (the phdrs), then a hand-built ELF for #3
var lx_kp[16];           # 128 B: a klug match pattern (the memcap line)
fn lx_arm(m, c) { return syscall(107, m, c, 0, 0); }
fn lx_mmap() { return syscall(27, 0x200000, 0, 0, 0); }
# Reap pid within ms; on expiry KILL_TREE + reap and -998. A spawn error (pid < 0) passes through as pid - 1000.
fn lx_wt(pid, ms) {
    if (pid < 0) { return pid - 1000; }
    var r = lx_reap(pid, ms);
    if (r == (0 - 998)) { l_kill(pid, 9 | 0x100); lx_reap(pid, 2000); }
    return r;
}
# Arm (m, c), spawn "/bin/spinner <args>", reap -> status (or the lx_wt codes).
fn lx_as(m, c, args, ms) { lx_arm(m, c); return lx_wt(l_spawn(args), ms); }
fn lx_st(t, r, want) {
    if (r == (0 - 998)) { return lx_bad(t, "timeout", r); }
    return lx_v(r == want, t, "status", r);
}
fn lx_page_count() {
    var fd = l_open("/bin/spinner");
    if (fd < 0) { return 0 - 1; }
    var n = syscall(5, fd, &lx_eb, 4096, 0);
    l_close(fd);
    if (n < 64) { return 0 - 1; }
    var phoff = load64(&lx_eb + 32);
    var phn = load16(&lx_eb + 56);
    var phe = load16(&lx_eb + 54);
    if (phoff + phn * phe > n) { return 0 - 1; }
    var m0 = 0;
    var m1 = 0;
    var c = 0;
    var i = 0;
    while (i < phn) {
        var ph = &lx_eb + phoff + i * phe;
        if (load32(ph) == 1) {
            var v = load64(ph + 16);
            var pg = v & 0xFFFFFFFFFFE00000;
            var pe = (v + load64(ph + 40) + 0x1FFFFF) & 0xFFFFFFFFFFE00000;
            while (pg < pe) {
                var b = (pg >> 21) & 127;
                if (b < 64) { if (((m0 >> b) & 1) == 0) { c = c + 1; m0 = m0 | (1 << b); } }
                else { if (((m1 >> (b - 64)) & 1) == 0) { c = c + 1; m1 = m1 | (1 << (b - 64)); } }
                pg = pg + 0x200000;
            }
        }
        i = i + 1;
    }
    return c;
}
# The §4.3a 187-byte ELF: exit(95). ph1 = 0x401000 (`ovl`, the same 2 MB page as ph0) or 0x600000 (`ovlok`).
fn lx_elf(ph1) {
    memset(&lx_eb, 0, 187);
    store32(&lx_eb, 0x464C457F);
    store8(&lx_eb + 4, 2);
    store8(&lx_eb + 5, 1);
    store8(&lx_eb + 6, 1);
    store16(&lx_eb + 16, 2);
    store16(&lx_eb + 18, 0x3E);
    store32(&lx_eb + 20, 1);
    store64(&lx_eb + 24, 0x4000B0);
    store64(&lx_eb + 32, 64);
    store16(&lx_eb + 52, 64);
    store16(&lx_eb + 54, 56);
    store16(&lx_eb + 56, 2);
    var p0 = &lx_eb + 64;
    store32(p0, 1);
    store32(p0 + 4, 5);
    store64(p0 + 16, 0x400000);
    store64(p0 + 24, 0x400000);
    store64(p0 + 32, 0xBB);
    store64(p0 + 40, 0xBB);
    store64(p0 + 48, 0x200000);
    var p1 = &lx_eb + 120;
    store32(p1, 1);
    store32(p1 + 4, 6);
    store64(p1 + 16, ph1);
    store64(p1 + 24, ph1);
    store64(p1 + 40, 0x1000);
    store64(p1 + 48, 0x1000);
    var code = &lx_eb + 0xB0;
    store8(code, 0xBF); store8(code + 1, 0x5F); store8(code + 5, 0x31); store8(code + 6, 0xC0);
    store8(code + 7, 0x0F); store8(code + 8, 0x05); store8(code + 9, 0xEB); store8(code + 10, 0xFE);
    return &lx_eb;
}
fn lx_sp3(ph1) { return syscall(3, lx_elf(ph1), 187, 0, 0); }
fn lx_pat_hex(o, v) {
    var hx[24];
    var hn = 0;
    if (v == 0) { store8(&hx, 48); hn = 1; }
    while (v > 0) { var nb = v & 15; if (nb < 10) { store8(&hx + hn, 48 + nb); } else { store8(&hx + hn, 87 + nb); } hn = hn + 1; v = v >> 4; }
    while (hn > 0) { hn = hn - 1; store8(&lx_kp + o, load8(&hx + hn)); o = o + 1; }
    store8(&lx_kp + o, 0);
    return o;
}

fn ph_limargs() {
    lx_phase("LIMARGS");
    var t = "LIFE-LIM-ARGS";
    if (lx_arm(0 - 1, 0) != (0 - 1)) { return lx_bad(t, "neg_mem", 0); }
    if (lx_arm(0, 0 - 1) != (0 - 1)) { return lx_bad(t, "neg_cpu", 0); }
    if (lx_arm(0x1000000001, 0) != (0 - 1)) { return lx_bad(t, "mem_2^36+1", 0); }
    if (lx_arm(0, 0x10000000001) != (0 - 1)) { return lx_bad(t, "cpu_2^40+1", 0); }
    if (lx_arm(0x1000000000, 0) != 0) { return lx_bad(t, "mem_2^36", 0); }
    if (lx_arm(0, 0x10000000000) != 0) { return lx_bad(t, "cpu_2^40", 0); }
    if (lx_arm(0, 0) != 0) { return lx_bad(t, "disarm", 0); }
    lx_arm(8192, 0);
    if (lx_arm(0 - 1, 0) != (0 - 1)) { return lx_bad(t, "neg_mem_2", 0); }
    return lx_st(t, lx_wt(l_spawn("mem"), 5000), 16);        # the refusal kept the (8192, 0) arm
}
fn ph_memexact() { lx_phase("MEMEXACT"); return lx_st("LIFE-MEM-EXACT", lx_as(8192, 0, "mem", 5000), 16); }
fn ph_memloader() {
    lx_phase("MEMLOADER");
    var t = "LIFE-MEM-LOADER";
    var need = (LX_N + 1) * 512;
    var o = l_cat(&lx_kp, 0, "limits: memcap refused load pid=0x");
    o = lx_pat_hex(o, LX_ME);
    o = l_cat(&lx_kp, o, " need=0x");
    o = lx_pat_hex(o, need);
    o = l_cat(&lx_kp, o, " cap=0x");
    lx_pat_hex(o, need - 512);
    var k0 = lx_kcount(&lx_kp);
    var a = lx_as(need - 512, 0, "exit 7", 5000);
    var k1 = lx_kcount(&lx_kp);
    var b = lx_as(need - 1, 0, "exit 7", 5000);
    var c = lx_as(need, 0, "exit 7", 5000);
    var d = lx_as(need + 512, 0, "exit 7", 5000);
    if (a != (0 - 1007)) { return lx_bad(t, "a_not_-7", a); }
    if (k1 <= k0) { return lx_bad(t, "no_klug_line", k1); }
    if (b != (0 - 1007)) { return lx_bad(t, "b_not_-7", b); }
    if (c != 7) { return lx_bad(t, "c_exact_cap", c); }
    return lx_v(d == 7, t, "d_control", d);
}
fn ph_memspawn3() {
    lx_phase("MEMSPAWN3");
    lx_arm(1024, 0);
    var a = lx_sp3(0x600000);
    lx_arm(1536, 0);
    var b = lx_wt(lx_sp3(0x600000), 5000);
    if (a != (0 - 1)) { lx_wt(a, 2000); return lx_bad("LIFE-MEM-SPAWN3", "under_cap_loaded", a); }
    return lx_st("LIFE-MEM-SPAWN3", b, 95);
}
fn lx_ew37(args) {
    var o = l_cat(&l_line, 0, "/bin/spinner ");
    o = l_cat(&l_line, o, args);
    store8(&l_line + o, 0);
    return syscall(37, &l_line, o, 0, 0);
}
fn ph_mem37() {
    lx_phase("MEM37");
    lx_arm((LX_N + 1) * 512 - 512, 0);
    var a = lx_ew37("exit 3");
    lx_arm(8192, 0);
    var b = lx_ew37("mem");
    if (a != (0 - 1)) { return lx_bad("LIFE-MEM-37", "under_cap_ran", a); }
    return lx_v(b == 16, "LIFE-MEM-37", "status", b);
}
fn ph_meminherit() { lx_phase("MEMINHERIT"); return lx_st("LIFE-MEM-INHERIT", lx_as(8192, 0, "memparent", 5000), 16); }
fn ph_memlower() { lx_phase("MEMLOWER"); return lx_st("LIFE-MEM-LOWER-ONLY", lx_as(8192, 0, "memarmhigh", 5000), 16); }
fn ph_memfork() { lx_phase("MEMFORK"); return lx_st("LIFE-MEM-FORK", lx_as(8192, 0, "forkmem", 5000), 16); }
# One ARM-ONESHOT kind: the armed call already ran; an UNARMED mem2 must map all 20 pages (a leftover 512-page arm
# refuses its image with -7).
fn lx_oneshot(kind, first, want) {
    var r = lx_wt(l_spawn("mem2"), 5000);
    lo_out("LIFE-ARM-ONESHOT-"); lo_out(kind);
    if (first != want) { lo_out("-BAD first"); lo_kv("v", first); lo_nl(); return 1; }
    if (r != 0) { lo_out("-BAD mem2"); lo_kv("v", r); lo_nl(); return 1; }
    lo_out("-OK\n");
    return 0;
}
fn ph_armoneshot() {
    lx_phase("ARMONESHOT");
    var f = 0;
    lx_arm(512, 0);
    var o = l_cat(&l_line, 0, "/bin/nope");
    f = f + lx_oneshot("43", syscall(43, &l_line, o, 0, 0), 0 - 4);
    lx_arm(512, 0);
    f = f + lx_oneshot("37", syscall(37, &l_line, o, 0, 0), 0 - 1);
    lx_arm(512, 0);
    f = f + lx_oneshot("3", syscall(3, &lx_eb, 0, 0, 0), 0 - 1);
    f = f + lx_oneshot("43OK", lx_as((LX_N + 1) * 512, 0, "exit 7", 5000), 7);
    # CPU kind: a leftover (0, 100 ms) arm would end the unarmed spin at 10 ticks with 280.
    lx_arm(0, 100);
    syscall(43, &l_line, o, 0, 0);
    var c = l_spawn("spin");
    var t = l_us() + 5000000;
    while (l_us() < t) { if (lx_ticks(c) >= 20) { break; } l_sleep(10); }
    var tk = lx_ticks(c);
    var r = lx_killreap(c, 2000);
    lo_out("LIFE-ARM-ONESHOT-CPU");
    if (tk < 20) { lo_out("-BAD ticks"); lo_kv("v", r); lo_nl(); f = f + 1; }
    else { if (r != 265) { lo_out("-BAD status"); lo_kv("v", r); lo_nl(); f = f + 1; } else { lo_out("-OK\n"); } }
    return lx_v(f == 0, "LIFE-ARM-ONESHOT", "kinds_bad", f);
}
fn ph_armperproc() {
    lx_phase("ARMPERPROC");
    if (syscall(25, &lx_fds, 0, 0, 0) != 0) { return lx_bad("LIFE-ARM-PER-PROCESS", "pipe", 0); }
    syscall(62, 1, load64(&lx_fds + 8), 0, 0);
    var k = l_spawn("armsleep");
    var t = l_us() + 2000000;
    var got = 0;
    while (l_us() < t) { if (syscall(5, load64(&lx_fds), &lx_rb, 1, 0) == 1) { got = 1; break; } l_sleep(10); }
    var r = lx_wt(l_spawn("exit 7"), 5000);
    var kr = lx_wt(k, 5000);
    l_close(load64(&lx_fds));
    l_close(load64(&lx_fds + 8));
    if (got == 0) { return lx_bad("LIFE-ARM-PER-PROCESS", "k_not_armed", k); }
    if (kr != 0) { return lx_bad("LIFE-ARM-PER-PROCESS", "k_status", kr); }
    return lx_st("LIFE-ARM-PER-PROCESS", r, 7);
}
fn ph_armrecycle() {
    lx_phase("ARMRECYCLE");
    var tries = 0;
    while (tries < 3) {
        var x = l_spawn("armexit");
        var xr = lx_wt(x, 5000);
        var z = l_spawn("spawn7");
        var zr = lx_wt(z, 5000);
        if (z == x) {
            if (xr != 0) { return lx_bad("LIFE-ARM-RECYCLE", "x_status", xr); }
            return lx_st("LIFE-ARM-RECYCLE", zr, 0);
        }
        tries = tries + 1;
    }
    return lx_bad("LIFE-ARM-RECYCLE", "noreuse", tries);
}
fn ph_forknoarm() { lx_phase("FORKNOARM"); return lx_st("LIFE-FORK-NO-ARM", lx_wt(l_spawn("forknoarm"), 5000), 0); }
fn ph_forkremap() {
    lx_phase("FORKREMAP");
    lx_wt(l_spawn("forkremap"), 5000);                     # the untimed warm-up of the same shape
    var f0 = lx_free();
    var r = lx_wt(l_spawn("forkremap"), 5000);
    var f1 = lx_free();
    if (r != 0) { return lx_st("LIFE-FORK-REMAP", r, 0); }
    return lx_v(f1 + 1048576 >= f0, "LIFE-FORK-REMAP", "free_ram_drop", f0 - f1);
}
fn ph_elfoverlap() {
    lx_phase("ELFOVERLAP");
    var t = "LIFE-ELF-OVERLAP";
    var a = lx_wt(lx_sp3(0x600000), 5000);
    var o = l_cat(&l_line, 0, "/bin/ovlok");
    var c = lx_wt(syscall(43, &l_line, o, 0, 0), 5000);
    var f0 = lx_free();
    var b = lx_sp3(0x401000);
    if (b >= 0) { lx_wt(b, 2000); }
    var o2 = l_cat(&l_line, 0, "/bin/ovl");
    var d = syscall(43, &l_line, o2, 0, 0);
    if (d >= 0) { lx_wt(d, 2000); }
    var f1 = lx_free();
    if (a != 95) { return lx_bad(t, "ovlok_3", a); }
    if (c != 95) { return lx_bad(t, "ovlok_43", c); }
    if (b != (0 - 1)) { return lx_bad(t, "ovl_3_loaded", b); }
    if (d != (0 - 5)) { return lx_bad(t, "ovl_43_not_-5", d); }
    return lx_v(f1 + 1048576 >= f0, t, "free_ram_drop", f0 - f1);
}
fn ph_cpuxcpu() {
    lx_phase("CPUXCPU");
    var s0 = lx_kscan();
    lx_arm(0, 500);
    var c = l_spawn("spin");
    var r = lx_wt(c, 5000);
    var v = lx_kvia_w("kill", c, s0, 1000);
    if (r != 280) { return lx_st("LIFE-CPU-XCPU", r, 280); }
    return lx_v(v == 2, "LIFE-CPU-XCPU", "via_not_tick", v);
}
fn ph_cpusys() {
    lx_phase("CPUSYS");
    var a = lx_as(0, 500, "sys", 10000);
    var b = lx_as(0, 500, "mmaploop", 10000);
    if (a != 280) { return lx_bad("LIFE-CPU-SYSCALL", "sys", a); }
    return lx_st("LIFE-CPU-SYSCALL", b, 280);
}
fn ph_cpuinherit() { lx_phase("CPUINHERIT"); return lx_st("LIFE-CPU-INHERIT", lx_as(0, 500, "parent-spin", 10000), 1); }
fn ph_cpulower() { lx_phase("CPULOWER"); return lx_st("LIFE-CPU-LOWER-ONLY", lx_as(0, 500, "armhigh", 10000), 1); }
fn ph_cpuew37() { lx_phase("CPUEW37"); return lx_st("LIFE-CPU-EW37-XCPU", lx_as(0, 500, "ew37x", 10000), 1); }
fn ph_cpufork() { lx_phase("CPUFORK"); return lx_st("LIFE-CPU-FORK", lx_as(0, 500, "forkspin", 10000), 1); }
fn ph_armmigrate() { lx_phase("ARMMIGRATE"); return lx_st("LIFE-ARM-MIGRATION", lx_wt(l_spawn("armspawn"), 10000), 1); }
# LAST: burn the GLOBAL low arena (keep the final pair mapped until lifex exits), then the high-arena phases.
fn ph_high() {
    lx_phase("HIGH");
    var i = 0;
    var stop = 0;
    while (i < 400) {
        var a = lx_mmap();
        var b = lx_mmap();
        if (a >= LX_HI) { stop = 1; break; }
        if (b >= LX_HI) { stop = 1; break; }
        syscall(28, a, 0x200000, 0, 0);
        syscall(28, b, 0x200000, 0, 0);
        i = i + 1;
    }
    var p = lx_mmap();
    syscall(28, p, 0x200000, 0, 0);
    if (stop == 0) { lx_bad("LIFE-HIGH-BURN", "no_stop", i); }
    else { lx_v(p >= LX_HI, "LIFE-HIGH-BURN", "probe_low", p); }
    lx_st("LIFE-MEM-HIGH", lx_as(8192, 0, "mem", 5000), 16);
    lx_st("LIFE-FORK-HIMAP", lx_wt(l_spawn("forkhimap"), 5000), 0);
    var tries = 0;
    while (tries < 3) {
        var x = l_spawn("himap2");
        var cx = lx_wt(x, 5000);
        var y = l_spawn("himap2");
        var cy = lx_wt(y, 5000);
        if (y == x) {
            if (cx == 255) { return lx_bad("LIFE-HIMAP-RECYCLE", "cx_low", cx); }
            if (cy != cx) { return lx_bad("LIFE-HIMAP-RECYCLE", "cursor_inherited", cy - cx); }
            return lx_ok("LIFE-HIMAP-RECYCLE");
        }
        tries = tries + 1;
    }
    return lx_bad("LIFE-HIMAP-RECYCLE", "noreuse", tries);
}

fn lx_run(name, fp) {
    if (lx_want(name) == 0) { return 0; }
    fncall0(fp);
    lx_kscan();
    return 0;
}

fn lx_driver() {
    LX_ME = l_getpid();
    lx_phases_load();
    lo_out("LIFEX-START pid="); lo_num(LX_ME); lo_nl();
    if (l_us() < 0) { lo_out("LIFE-SETUP-BAD clock v=-1\n"); lo_out("LIFEX-DONE pass=0 fail=1\n"); return 0; }
    lx_kscan();
    ph_setup();
    lx_run("FAULTBG", &ph_faultbg);
    lx_run("SIGBIT", &ph_sigbit);
    lx_run("WSTAT", &ph_wstat);
    lx_run("ZOMBIE", &ph_zombie);
    lx_run("AUTH", &ph_auth);
    lx_run("RECYCLEDPARENT", &ph_recycled);
    lx_run("ZPARENTEXIT", &ph_zparentexit);
    lx_run("ORPHAN", &ph_orphan);
    lx_run("ORPHANRACE", &ph_orphanrace);
    lx_run("KILLSYS", &ph_killsys);
    lx_run("SELFKILL", &ph_selfkill);
    lx_run("ZOMBIENOOP", &ph_zombienoop);
    lx_run("KILLSPIN", &ph_killspin);
    lx_run("KILLTICK", &ph_killtick);
    lx_run("SIGTERM", &ph_sigterm);
    lx_run("RELEASE", &ph_release);
    lx_run("LEAK", &ph_leak);
    lx_run("ZPARENTKILL", &ph_zparentkill);
    lx_run("KILLNOTREE", &ph_killnotree);
    lx_run("KLOGSTORM", &ph_klogstorm);
    lx_run("KILLBLOCKED", &ph_killblocked);
    lx_run("KBDNEXT", &ph_kbdnext);
    lx_run("FLOCKCYCLE", &ph_flockcycle);
    lx_run("NETBLOCKED", &ph_netblocked);
    lx_run("EW37", &ph_ew37);
    lx_run("EW37RACE", &ph_ew37race);
    lx_run("STOP", &ph_stop);
    lx_run("STOPTICK", &ph_stoptick);
    lx_run("KILLSTOPPED", &ph_killstopped);
    lx_run("SELFSTOP", &ph_selfstop);
    lx_run("STOPBLOCKED", &ph_stopblocked);
    lx_run("KILLSTOPPEDINPLACE", &ph_killstoppedinplace);
    lx_run("SELFUNSTOPPABLE", &ph_selfunstoppable);
    lx_run("STOPUNSTOPPABLE", &ph_stopunstoppable);
    lx_run("STOPPEDORPHAN", &ph_stoppedorphan);
    lx_run("RACE", &ph_race);
    lx_run("TREE", &ph_tree);
    lx_run("TREENOESCAPE", &ph_treenoescape);
    lx_run("TREESTOPNOESCAPE", &ph_treestopnoescape);
    lx_run("STOPEW37TREE", &ph_stopew37tree);
    lx_run("STOPZPARENT", &ph_stopzparent);
    lx_run("KLOGFORMAT", &ph_klogformat);
    # 1.57.7 (S8): the resource-limit phases, after every S7 phase; HIGH (the low-arena burn) LAST.
    lx_run("LIMARGS", &ph_limargs);
    lx_run("MEMEXACT", &ph_memexact);
    lx_run("MEMLOADER", &ph_memloader);
    lx_run("MEMSPAWN3", &ph_memspawn3);
    lx_run("MEM37", &ph_mem37);
    lx_run("MEMINHERIT", &ph_meminherit);
    lx_run("MEMLOWER", &ph_memlower);
    lx_run("MEMFORK", &ph_memfork);
    lx_run("ARMONESHOT", &ph_armoneshot);
    lx_run("ARMPERPROC", &ph_armperproc);
    lx_run("ARMRECYCLE", &ph_armrecycle);
    lx_run("FORKNOARM", &ph_forknoarm);
    lx_run("FORKREMAP", &ph_forkremap);
    lx_run("ELFOVERLAP", &ph_elfoverlap);
    lx_run("CPUXCPU", &ph_cpuxcpu);
    lx_run("CPUSYS", &ph_cpusys);
    lx_run("CPUINHERIT", &ph_cpuinherit);
    lx_run("CPULOWER", &ph_cpulower);
    lx_run("CPUEW37", &ph_cpuew37);
    lx_run("CPUFORK", &ph_cpufork);
    lx_run("ARMMIGRATE", &ph_armmigrate);
    lx_run("HIGH", &ph_high);
    lo_out("LIFEX-DONE pass="); lo_num(LX_PASS); lo_kv("fail", LX_FAIL); lo_nl();
    return 0;
}

fn main(): i64 {
    if (l_eq(argv(0), "/bin/agnsh") == 0) { lo_out("LIFEX-NOT-DRIVER\n"); return 99; }
    lx_driver();
    lo_flush();
    return 0;
}

fn _entry(): i64 { args_init(); var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
