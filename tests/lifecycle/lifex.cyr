# Spawn `spin` and wait until #99 shows it RUNNING (state 2) on 3 consecutive polls (<= 1 s). -1 = never.
fn lx_spin_running() {
    var c = l_spawn("spin");
    var t = l_us() + 1000000;
    var run = 0;
    while (l_us() < t) {
        if (lx_state(c) == 2) { run = run + 1; } else { run = 0; }
        if (run >= 3) { return c; }
    }
    lx_killreap(c, 2000);
    return 0 - 1;
}
fn ph_killtick() {
    lx_phase("KILLTICK");
    if (LX_NCPU < 2) { return lx_na("LIFE-KILL-TICK"); }
    var round = 0;
    var last = 0;
    while (round < 3) {
        var c = lx_spin_running();
        if (c >= 0) {
            var s0 = lx_kscan();
            var r = lx_killreap(c, 2000);
            var v = lx_kvia_w("kill", c, s0, 500);
            if (r != 265) { return lx_bad("LIFE-KILL-TICK", "status", r); }
            if (v == 2) { return lx_ok("LIFE-KILL-TICK"); }
            last = v;
        }
        round = round + 1;
    }
    return lx_bad("LIFE-KILL-TICK", "no_tick_round", last);
}
