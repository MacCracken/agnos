    if (v != 4) { return lx_bad("LIFE-STOP-BLOCKED", "via_not_wait", v); }
    if (tk1 != tk0) { return lx_bad("LIFE-STOP-BLOCKED", "ticks_moved", tk1 - tk0); }
    if (r < 65) { return lx_bad("LIFE-STOP-BLOCKED", "status", r); }
    if (dr > 150000) { return lx_bad("LIFE-STOP-BLOCKED", "reap_late_us", dr); }
    return lx_ok("LIFE-STOP-BLOCKED");
}
fn ph_killstoppedinplace() {
