    var c = l_spawn("selfstop");
    var t0 = l_us();
    l_sleep(200);
    var dt = l_us() - t0;
    var st = lx_state(c);
    var v = lx_kvia_w("stop", c, s0, 500);
    l_sleep(200);
    var st2 = lx_state(c);
    l_kill(c, 18);
    var r = lx_reap(c, 2000);
    if (r == (0 - 998)) { lx_killreap(c, 2000); }
    if (st != 5) { lx_bad("LIFE-SELFSTOP", "state", st); }
    else { if (v != 3) { lx_bad("LIFE-SELFSTOP", "via_not_b1", v); }
    else { if (st2 != 5) { lx_bad("LIFE-SELFSTOP", "left_5", st2); }
    else { lx_v(r == 77, "LIFE-SELFSTOP", "status", r); } } }
    if (LX_NCPU < 2) {
        if (dt > 250000) { return lx_bad("LIFE-STOP-LONE", "late_us", dt); }
        if (dt < 150000) { return lx_bad("LIFE-STOP-LONE", "early_us", dt); }
        return lx_v(st == 5, "LIFE-STOP-LONE", "state", st);
    }
    return 0;
}
fn ph_stopblocked() {
    lx_phase("STOPBLOCKED");
