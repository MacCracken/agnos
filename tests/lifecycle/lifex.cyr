    return lx_v(br == 0, "LIFE-FLOCK-CYCLE", "status_b", br);
}
fn ph_netblocked() {
    lx_phase("NETBLOCKED");
    var i = 0;
    var bad = 0;
    var cbad = 0;
    while (i < 8) {
        var line = &lx_rb;
        var o = l_cat(line, 0, "dial 2130706433 ");
        o = l_catnum(line, o, 7100 + i);
        store8(line + o, 0);
        var c = l_spawn(line);
        if (lx_wait_state(c, 6, 3000) == 0) { cbad = cbad + 1; }
        var t0 = l_us();
        if (lx_killreap(c, 2000) != 265) { bad = bad + 1; }
        if (l_us() - t0 > 2000000) { bad = bad + 1; }
        i = i + 1;
    }
    var lid = syscall(56, 7190, 0, 0, 0);
    var cid = 0 - 1;
    if (lid >= 0) { cid = syscall(47, 2130706433, 7190, 0, 0); }
    if (cid >= 0) { syscall(50, cid, 0, 0, 0); }
    if (lid >= 0) { syscall(50, lid, 0, 0, 0); }
    if (cbad != 0) { lx_bad("LIFE-KILL-BLOCKED-CONNECT", "never_blocked", cbad); }
    else { if (bad != 0) { lx_bad("LIFE-KILL-BLOCKED-CONNECT", "status", bad); }
    else { if (lid < 0) { lx_bad("LIFE-KILL-BLOCKED-CONNECT", "listen_after", lid); }
    else { lx_v(cid >= 0, "LIFE-KILL-BLOCKED-CONNECT", "connect_after", cid); } } }
    # SEND: a peer that accepts and never reads; the sender blocks in #48.
    var sl = syscall(56, 7191, 0, 0, 0);
    var s = l_spawn2("sendblock", 2130706433, 7191);
    var acc = 0 - 1;
    var t = l_us() + 3000000;
    while (l_us() < t) { acc = syscall(57, sl, 0, 0, 0); if (acc >= 0) { break; } l_sleep(5); }
    var sok = lx_wait_state(s, 6, 3000);
    var sr = lx_killreap(s, 2000);
    if (acc >= 0) { syscall(50, acc, 0, 0, 0); }
    if (sl >= 0) { syscall(50, sl, 0, 0, 0); }
    if (sl < 0) { lx_bad("LIFE-KILL-BLOCKED-SEND", "listen", sl); }
    else { if (sok == 0) { lx_bad("LIFE-KILL-BLOCKED-SEND", "never_blocked", acc); }
    else { lx_v(sr == 265, "LIFE-KILL-BLOCKED-SEND", "status", sr); } }
    # PING: a silent host.
    lx_killblocked("pingsilent 3221225985", "LIFE-KILL-BLOCKED-PING");
    return 0;
}
