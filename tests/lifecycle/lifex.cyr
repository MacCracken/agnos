# lifex — the DRIVER of agnos 1.57.7's lifecycle gate (step S7; docs/architecture/process-lifecycle.md).
#
# WHAT IS UNDER TEST: kill#16 ENDS (9), STOPS (19) and CONTINUES (18) a child — and, with KILL_TREE (0x100), every
# epoch-validated descendant — through the four boundaries (claim, tick, B1 at syscall exit, a blocked wait's signal
# point); the wait status (D2: 265 = SIGKILL, 142 = a fault, code & 0xFF = an exit); #99's state 7 (an exited,
# unreaped child) and 5 (STOPPED); orphans that reap themselves (no leaked address space); epoch-validated authority.
#
# Seeded as /bin/agnsh on a PLAIN kernel (D19): kybernet launches it (pinned to the BSP, the unstoppable fg child of
# kmain); every role is /bin/spinner (spinner.cyr). scripts/smoke/lifecycle-smoke.sh reads:
#   LIFE-PHASE <name>, then <MARKER>-OK / <MARKER>-BAD <why> / <MARKER>-NA (a -smp-restricted marker);
#   LIFE-KLOG <line> for every kernel `lifecycle: #<seq> ...` line (seq-deduplicated, re-printed after every phase);
#   LIFEX-DONE pass=N fail=M; then exit 0 (a non-zero exit would drop kybernet into its emergency shell).
# /life/phases (optional): the phases to run, one per line (absent = all).
# ⚠ BOUNDED: every wait uses #95 deadlines (#95 == -1 is a -BAD, never a silent #40 fallback); child polls are
# sleep_ms(5) loops; every child a phase created is killed and reaped before the phase ends.

include "lcommon.cyr"

var LX_PASS = 0;
var LX_FAIL = 0;
var LX_NCPU = 1;
var LX_ME = 0;
var LX_FREE0 = 0;
var LX_KSEQ = 0 - 1;     # the highest lifecycle seq re-printed so far
var LX_KLINES = 0;       # lifecycle lines seen
var LX_KBAD = 0;         # ... that did not parse
var LX_KN = 0;           # bytes in lx_kb
var lx_pl[128];          # 1024 B: proclist#99 (16 x 64-byte records)
var lx_si[16];           # 128 B: sysinfo#35
var lx_kb[8192];         # 64 KB: klug#36 (the whole ring)
var lx_ph[128];          # 1024 B: /life/phases
var LX_PHN = 0 - 1;      # -1 = no phases file (run all)
var lx_fds[2];           # 16 B: a pipe or a channel pair
var lx_rb[16];           # 128 B: a read buffer
var lx_kids[16];         # a phase's children
var lx_pat[8];           # 64 B: a klug match pattern

# ── verdicts ──
fn lx_phase(n) { lo_out("LIFE-PHASE "); lo_out(n); lo_nl(); return 0; }
fn lx_ok(t) { lo_out(t); lo_out("-OK\n"); LX_PASS = LX_PASS + 1; return 0; }
fn lx_bad(t, why, v) { lo_out(t); lo_out("-BAD "); lo_out(why); lo_kv("v", v); lo_nl(); LX_FAIL = LX_FAIL + 1; return 0; }
fn lx_na(t) { lo_out(t); lo_out("-NA\n"); return 0; }
fn lx_v(c, t, why, v) { if (c == 1) { return lx_ok(t); } return lx_bad(t, why, v); }

# ── the process table (#99) ──
fn lx_pln() { return syscall(99, &lx_pl, 16, 0, 0); }
fn lx_field(pid, off) {
    var n = lx_pln();
    var i = 0;
    while (i < n) {
        var r = &lx_pl + i * 64;
        if (load64(r) == pid) {
            if (off == 56) { return load64(r + 56) & 0xFFFFFFFF; }
            return load64(r + off);
        }
        i = i + 1;
    }
    return 0 - 1;
}
fn lx_state(pid) { return lx_field(pid, 8); }
fn lx_ticks(pid) { return lx_field(pid, 56); }
fn lx_is_spinner(r) {
    if (load8(r + 24) != 115) { return 0; }          # 's'
    if (l_eq(r + 24, "spinner") == 1) { return 1; }
    return 0;
}
# The first LIVE (not 7) record whose ppid is pp (-1 = none). any7 = 1 also returns a zombie.
fn lx_child_of(pp, any7) {
    var n = lx_pln();
    var i = 0;
    while (i < n) {
        var r = &lx_pl + i * 64;
        if (load64(r + 16) == pp) {
            if (load64(r) != pp) {
                if (any7 == 1) { return load64(r); }
                if (load64(r + 8) != 7) { return load64(r); }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}
fn lx_nspinners() {
    var n = lx_pln();
    var c = 0;
    var i = 0;
    while (i < n) { if (lx_is_spinner(&lx_pl + i * 64) == 1) { c = c + 1; } i = i + 1; }
    return c;
}
# Wait until pid is in state st (1 = yes within ms). st = -1 waits until it is not listed.
fn lx_wait_state(pid, st, ms) {
    var t = l_us() + ms * 1000;
    while (l_us() < t) {
        if (lx_state(pid) == st) { return 1; }
        l_sleep(5);
    }
    if (lx_state(pid) == st) { return 1; }
    return 0;
}
fn lx_wait_nospin(ms) {
    var t = l_us() + ms * 1000;
    while (l_us() < t) {
        if (lx_nspinners() == 0) { return 1; }
        l_sleep(10);
    }
    if (lx_nspinners() == 0) { return 1; }
    return 0;
}
# Reap `pid` (the non-blocking poll every 5 ms, bounded): its status, or -998 when still alive after ms.
fn lx_reap(pid, ms) {
    if (pid < 0) { return 0 - 999; }
    var t = l_us() + ms * 1000;
    while (l_us() < t) {
        var r = l_poll(pid);
        if (r != (0 - 2)) { return r; }
        l_sleep(5);
    }
    var r2 = l_poll(pid);
    if (r2 != (0 - 2)) { return r2; }
    return 0 - 998;
}
fn lx_killreap(pid, ms) { l_kill(pid, 9); return lx_reap(pid, ms); }
fn lx_free() {
    if (syscall(35, &lx_si, 128, 0, 0) != 0) { return 0 - 1; }
    return load64(&lx_si + 16);
}
fn lx_free_ok() {
    if (lx_free() + 1048576 >= LX_FREE0) { return 1; }
    return 0;
}

# ── klug (#36): the lifecycle lines ──
fn lx_kread() {
    LX_KN = syscall(36, &lx_kb, 65536, 0, 0);
    if (LX_KN < 0) { LX_KN = 0; }
    return LX_KN;
}
fn lx_ishex(c) {
    if (c >= 48) { if (c <= 57) { return 1; } }
    if (c >= 97) { if (c <= 102) { return 1; } }
    return 0;
}
fn lx_hexval(c) { if (c <= 57) { return c - 48; } return c - 87; }
# Match literal s at p (bounded by e). -> p + len, or -1.
fn lx_lit(p, e, s) {
    var i = 0;
    while (load8(s + i) != 0) {
        if (p + i >= e) { return 0 - 1; }
        if (load8(p + i) != load8(s + i)) { return 0 - 1; }
        i = i + 1;
    }
    return p + i;
}
# hex run at p -> end, or -1 if empty.
fn lx_hexrun(p, e) {
    var q = p;
    while (q < e) { if (lx_ishex(load8(q)) == 0) { break; } q = q + 1; }
    if (q == p) { return 0 - 1; }
    return q;
}
fn lx_hexparse(p, e) {
    var v = 0;
    var q = p;
    while (q < e) { if (lx_ishex(load8(q)) == 0) { break; } v = v * 16 + lx_hexval(load8(q)); q = q + 1; }
    return v;
}
# Does [p, e) — the text after "lifecycle: #" — parse per the S7 trace format? 1 / 0.
fn lx_kfmt(p, e) {
    var q = lx_hexrun(p, e);
    if (q < 0) { return 0; }
    var k = lx_lit(q, e, " kill pid=0x");
    if (k > 0) {
        k = lx_hexrun(k, e); if (k < 0) { return 0; }
        k = lx_lit(k, e, " sig=0x"); if (k < 0) { return 0; }
        k = lx_hexrun(k, e); if (k < 0) { return 0; }
        k = lx_lit(k, e, " via="); if (k < 0) { return 0; }
        if (lx_lit(k, e, "claim") == e) { return 1; }
        if (lx_lit(k, e, "tick") == e) { return 1; }
        if (lx_lit(k, e, "b1") == e) { return 1; }
        return 0;
    }
    k = lx_lit(q, e, " stop pid=0x");
    if (k > 0) {
        k = lx_hexrun(k, e); if (k < 0) { return 0; }
        k = lx_lit(k, e, " via="); if (k < 0) { return 0; }
        if (lx_lit(k, e, "claim") == e) { return 1; }
        if (lx_lit(k, e, "tick") == e) { return 1; }
        if (lx_lit(k, e, "b1") == e) { return 1; }
        if (lx_lit(k, e, "wait") == e) { return 1; }
        return 0;
    }
    k = lx_lit(q, e, " cont pid=0x");
    if (k > 0) {
        k = lx_hexrun(k, e); if (k < 0) { return 0; }
        k = lx_lit(k, e, " via="); if (k < 0) { return 0; }
        if (lx_lit(k, e, "sig") == e) { return 1; }
        if (lx_lit(k, e, "orphan") == e) { return 1; }
        return 0;
    }
    k = lx_lit(q, e, " orphan pid=0x");
    if (k > 0) {
        k = lx_hexrun(k, e); if (k < 0) { return 0; }
        if (lx_lit(k, e, " reaped") == e) { return 1; }
        return 0;
    }
    return 0;
}
# Re-print every NEW lifecycle line (seq > LX_KSEQ) as `LIFE-KLOG <line>` and check its format. Returns LX_KSEQ.
fn lx_kscan() {
    lx_kread();
    var b = &lx_kb;
    var e = b + LX_KN;
    var p = b;
    while (p + 12 <= e) {
        var m = lx_lit(p, e, "lifecycle: #");
        if (m < 0) { p = p + 1; continue; }
        var le = m;
        while (le < e) { if (load8(le) == 10) { break; } le = le + 1; }
        if (le >= e) { break; }                                  # an unterminated tail line: next scan
        var sq = lx_hexparse(m, le);
        if (lx_hexrun(m, le) > 0) {
            if (sq > LX_KSEQ) {
                LX_KSEQ = sq;
                LX_KLINES = LX_KLINES + 1;
                if (lx_kfmt(m, le) == 0) { LX_KBAD = LX_KBAD + 1; lo_out("LIFE-KLOG-UNPARSED "); }
                else { lo_out("LIFE-KLOG "); }
                lo_outn(p, le - p);
                lo_nl();
            }
        }
        p = le + 1;
    }
    return LX_KSEQ;
}
# The via of the first `<kind> pid=0x<pid>` line with seq > after: 1 claim · 2 tick · 3 b1 · 4 wait · 5 sig ·
# 6 orphan · 9 (an orphan line) · 0 = none. Re-scans (and re-prints) first.
fn lx_kvia(kind, pid, after) {
    lx_kscan();
    var o = l_cat(&lx_pat, 0, " ");
    o = l_cat(&lx_pat, o, kind);
    o = l_cat(&lx_pat, o, " pid=0x");
    var hx[24];
    var hn = 0;
    var hv = pid;
    if (hv == 0) { store8(&hx, 48); hn = 1; }
    while (hv > 0) { var nb = hv & 15; if (nb < 10) { store8(&hx + hn, 48 + nb); } else { store8(&hx + hn, 87 + nb); } hn = hn + 1; hv = hv >> 4; }
    while (hn > 0) { hn = hn - 1; store8(&lx_pat + o, load8(&hx + hn)); o = o + 1; }
    store8(&lx_pat + o, 0);
    var b = &lx_kb;
    var e = b + LX_KN;
    var p = b;
    while (p + 12 <= e) {
        var m = lx_lit(p, e, "lifecycle: #");
        if (m < 0) { p = p + 1; continue; }
        var le = m;
        while (le < e) { if (load8(le) == 10) { break; } le = le + 1; }
        if (le >= e) { break; }
        var sq = lx_hexparse(m, le);
        var q = lx_hexrun(m, le);
        if (q > 0) {
            if (sq > after) {
                var k = lx_lit(q, le, &lx_pat);
                if (k > 0) {
                    if (k < le) { if (load8(k) != 32) { k = 0 - 1; } }
                }
                if (k > 0) {
                    if (l_eq(kind, "orphan") == 1) { return 9; }
                    var w = k;
                    while (w + 4 <= le) { if (lx_lit(w, le, "via=") > 0) { break; } w = w + 1; }
                    var v = lx_lit(w, le, "via=");
                    if (v > 0) {
                        if (lx_lit(v, le, "claim") == le) { return 1; }
                        if (lx_lit(v, le, "tick") == le) { return 2; }
                        if (lx_lit(v, le, "b1") == le) { return 3; }
                        if (lx_lit(v, le, "wait") == le) { return 4; }
                        if (lx_lit(v, le, "sig") == le) { return 5; }
                        if (lx_lit(v, le, "orphan") == le) { return 6; }
                    }
                    return 0 - 1;
                }
            }
        }
        p = le + 1;
    }
    return 0;
}
# lx_kvia, waiting up to ms for the line to appear.
fn lx_kvia_w(kind, pid, after, ms) {
    var t = l_us() + ms * 1000;
    while (1) {
        var v = lx_kvia(kind, pid, after);
        if (v != 0) { return v; }
        if (l_us() >= t) { return 0; }
        l_sleep(10);
    }
    return 0;
}
fn lx_khas(s) {
    lx_kread();
    var e = &lx_kb + LX_KN;
    var p = &lx_kb;
    while (p < e) { if (lx_lit(p, e, s) > 0) { return 1; } p = p + 1; }
    return 0;
}
fn lx_kcount(s) {
    lx_kread();
    var e = &lx_kb + LX_KN;
    var p = &lx_kb;
    var c = 0;
    while (p < e) { if (lx_lit(p, e, s) > 0) { c = c + 1; } p = p + 1; }
    return c;
}

# ── /life/phases ──
fn lx_phases_load() {
    var fd = l_open("/life/phases");
    if (fd < 0) { LX_PHN = 0 - 1; return 0; }
    var n = syscall(5, fd, &lx_ph, 1000, 0);
    l_close(fd);
    if (n < 0) { n = 0; }
    store8(&lx_ph + n, 0);
    LX_PHN = n;
    return 0;
}
fn lx_want(name) {
    if (LX_PHN < 0) { return 1; }
    var l = strlen(name);
    var i = 0;
    while (i < LX_PHN) {
        var j = 0;
        while (j < l) { if (load8(&lx_ph + i + j) != load8(name + j)) { break; } j = j + 1; }
        if (j == l) {
            var c = load8(&lx_ph + i + l);
            if (c == 10) { return 1; }
            if (c == 0) { return 1; }
            if (c == 13) { return 1; }
            if (c == 32) { return 1; }
        }
        while (i < LX_PHN) { if (load8(&lx_ph + i) == 10) { break; } i = i + 1; }
        i = i + 1;
    }
    return 0;
}

# ═══════════════════════════════════ the phases ═══════════════════════════════════
fn ph_setup() {
    lx_phase("SETUP");
    var ok = 1;
    if (l_us() < 0) { ok = 0; }
    if (syscall(35, &lx_si, 128, 0, 0) != 0) { ok = 0; }
    LX_NCPU = load64(&lx_si + 32);
    var c = l_spawn("exit 0");
    lx_reap(c, 3000);
    LX_FREE0 = lx_free();
    lo_out("LIFE-SETUP ncpu="); lo_num(LX_NCPU); lo_kv("free", LX_FREE0); lo_kv("me", LX_ME); lo_nl();
    LX_N = lx_page_count();                                # S8: /bin/spinner's distinct 2 MB PT_LOAD pages
    lo_out("LIFE-SPINNER-PAGES "); lo_num(LX_N); lo_nl();
    if (LX_N < 1) { ok = 0; }
    lx_v(ok, "LIFE-SETUP", "clock_or_sysinfo", 0);
    return 0;
}
fn ph_faultbg() {
    lx_phase("FAULTBG");
    var c = l_spawn("fault");
    var r = lx_reap(c, 3000);
    var n = lx_kcount("fault: pid=");
    if (r != 142) { return lx_bad("LIFE-FAULT-BG", "status", r); }
    if (n != 1) { return lx_bad("LIFE-FAULT-BG", "fault_lines", n); }
    return lx_ok("LIFE-FAULT-BG");
}
fn ph_sigbit() {
    lx_phase("SIGBIT");
    if (LX_NCPU < 2) { return lx_na("LIFE-SIGBIT"); }
    if (syscall(25, &lx_fds, 0, 0, 0) != 0) { return lx_bad("LIFE-SIGBIT", "pipe", 0); }
    var rfd = load64(&lx_fds);
    var wfd = load64(&lx_fds + 8);
    var c = l_spawn1("sigrace", wfd);
    if (c < 0) { return lx_bad("LIFE-SIGBIT", "spawn", c); }
    l_sleep(20);
    var i = 0;
    var miss = 0 - 1;
    while (i < 300) {
        l_kill(c, 12);
        var t = l_us() + 200000;
        var got = 0;
        while (l_us() < t) {
            var r = syscall(5, rfd, &lx_rb, 1, 0);
            if (r == 1) { got = 1; break; }
            l_yield();
        }
        if (got == 0) { miss = i; break; }
        i = i + 1;
    }
    l_kill(c, 14);
    var st = lx_reap(c, 3000);
    if (st == (0 - 998)) { st = lx_killreap(c, 2000); }
    l_close(rfd); l_close(wfd);
    if (miss >= 0) { return lx_bad("LIFE-SIGBIT", "lost_round", miss); }
    if (st != 0) { return lx_bad("LIFE-SIGBIT", "status", st); }
    return lx_ok("LIFE-SIGBIT");
}
fn ph_wstat() {
    lx_phase("WSTAT");
    var a = lx_reap(l_spawn("exit 265"), 3000);
    var b = lx_reap(l_spawn("exit -2"), 3000);
    var z = lx_reap(l_spawn("exit 0"), 3000);
    if (a != 9) { return lx_bad("LIFE-WSTAT-MASK", "exit265", a); }
    if (b != 254) { return lx_bad("LIFE-WSTAT-MASK", "exit-2", b); }
    if (z != 0) { return lx_bad("LIFE-WSTAT-MASK", "exit0", z); }
    return lx_ok("LIFE-WSTAT-MASK");
}
fn ph_zombie() {
    lx_phase("ZOMBIE");
    var c = l_spawn("exit 7");
    if (lx_wait_state(c, 7, 2000) == 0) { lx_reap(c, 2000); return lx_bad("LIFE-ZOMBIE-LISTED", "no_state7", lx_state(c)); }
    var pp = lx_field(c, 16);
    var r = lx_reap(c, 2000);
    var gone = lx_state(c);
    if (pp != LX_ME) { return lx_bad("LIFE-ZOMBIE-LISTED", "ppid", pp); }
    if (r != 7) { return lx_bad("LIFE-ZOMBIE-LISTED", "status", r); }
    if (gone != (0 - 1)) { return lx_bad("LIFE-ZOMBIE-LISTED", "still_listed", gone); }
    return lx_ok("LIFE-ZOMBIE-LISTED");
}
fn ph_auth() {
    lx_phase("AUTH");
    var a = l_spawn1("auth", LX_ME);
    var ar = lx_reap(a, 3000);
    var c = l_spawn("spin");
    l_sleep(20);
    var bad = 0;
    var which = 0;
    if (l_kill(0, 9) != (0 - 1)) { bad = 1; which = 1; }
    if (l_kill(99, 9) != (0 - 1)) { bad = 1; which = 2; }
    if (l_kill(c, 0x209) != (0 - 1)) { bad = 1; which = 3; }
    if (l_kill(c, 0x300) != (0 - 1)) { bad = 1; which = 4; }
    if (l_kill(c, 64) != (0 - 1)) { bad = 1; which = 5; }
    if (l_kill(c, 0) != 0) { bad = 1; which = 6; }
    if (l_kill(c, 10 | 0x100) != 0) { bad = 1; which = 7; }
    lx_killreap(c, 2000);
    if (ar != 0) { return lx_bad("LIFE-AUTH", "auth_child", ar); }
    if (bad == 1) { return lx_bad("LIFE-AUTH", "check", which); }
    return lx_ok("LIFE-AUTH");
}
fn ph_recycled() {
    lx_phase("RECYCLEDPARENT");
    var b = l_spawn("spawnexitpid");
    var g = lx_reap(b, 3000);
    if (g < 0) { return lx_bad("LIFE-RECYCLED-PARENT", "spawnexitpid", g); }
    if (g >= 16) { return lx_bad("LIFE-RECYCLED-PARENT", "grandchild", g); }
    var n = 0;
    var hit = 0 - 1;
    while (n < 14) {
        var c = l_spawn1("recycled", g);
        if (c < 0) { break; }
        store64(&lx_kids + n * 8, c);
        n = n + 1;
        if (c == b) { hit = c; break; }
    }
    var hr = 0 - 1;
    var i = 0;
    var others = 0;
    while (i < n) {
        var k = load64(&lx_kids + i * 8);
        var kr = lx_reap(k, 3000);
        if (k == hit) { hr = kr; } else { if (kr != 0) { others = kr; } }
        i = i + 1;
    }
    # G (sleep 3000) is an orphan now (its parent B was reaped): it must reap itself when it exits.
    var gg = lx_wait_state(g, 0 - 1, 5000);
    if (hit < 0) { return lx_bad("LIFE-RECYCLED-PARENT", "never_got_the_slot", n); }
    if (hr != 0) { return lx_bad("LIFE-RECYCLED-PARENT", "recycled_check", hr); }
    if (others != 0) { return lx_bad("LIFE-RECYCLED-PARENT", "filler", others); }
    if (gg == 0) { return lx_bad("LIFE-RECYCLED-PARENT", "grandchild_not_reaped", lx_state(g)); }
    return lx_ok("LIFE-RECYCLED-PARENT");
}
fn ph_zparentexit() {
    lx_phase("ZPARENTEXIT");
    var p = l_spawn("zparentexit");
    var t = l_us() + 1000000;
    var c = 0 - 1;
    while (l_us() < t) { c = lx_child_of(p, 1); if (c >= 0) { break; } l_sleep(5); }
    var r = lx_reap(p, 3000);
    l_sleep(500);
    if (r != 0) { return lx_bad("LIFE-ZOMBIE-OF-EXITED", "status", r); }
    if (c < 0) { return lx_bad("LIFE-ZOMBIE-OF-EXITED", "no_child_seen", c); }
    if (lx_state(c) != (0 - 1)) { return lx_bad("LIFE-ZOMBIE-OF-EXITED", "child_listed", lx_state(c)); }
    if (lx_free_ok() == 0) { return lx_bad("LIFE-ZOMBIE-OF-EXITED", "free_ram", lx_free()); }
    return lx_ok("LIFE-ZOMBIE-OF-EXITED");
}
fn ph_orphan() {
    lx_phase("ORPHAN");
    var s0 = lx_kscan();
    var p = l_spawn("orphaner");
