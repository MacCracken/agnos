fn ph_stop() {
    lx_phase("STOP");
    var c = l_spawn("spin");
    l_sleep(50);
    var s0 = lx_kscan();
    var k = l_kill(c, 19);
    var st5 = lx_wait_state(c, 5, 500);
    var tk0 = lx_ticks(c);
    l_sleep(300);
    var tk1 = lx_ticks(c);
    var wp = l_poll(c);
    var v = lx_kvia_w("stop", c, s0, 500);
    var k2 = l_kill(c, 18);
    l_sleep(20);
    var st2 = lx_state(c);
    var tk2 = lx_ticks(c);
    l_sleep(300);
    var tk3 = lx_ticks(c);
