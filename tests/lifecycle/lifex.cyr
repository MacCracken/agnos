# Spawn `args`, wait for state 6, kill: status 265 within 2 s and KLOG kill via=b1. 1 = OK (else it printed -BAD).
fn lx_killblocked(args, tag) {
    var c = l_spawn(args);
    if (lx_wait_state(c, 6, 3000) == 0) { var q = lx_state(c); lx_killreap(c, 2000); lx_bad(tag, "never_blocked", q); return 0; }
    var s0 = lx_kscan();
    var t0 = l_us();
    var r = lx_killreap(c, 2000);
    var dt = l_us() - t0;
    var v = lx_kvia_w("kill", c, s0, 500);
    if (r != 265) { lx_bad(tag, "status", r); return 0; }
    if (dt > 2000000) { lx_bad(tag, "slow_us", dt); return 0; }
    if (v != 3) { lx_bad(tag, "via_not_b1", v); return 0; }
    lx_ok(tag);
    return 1;
}
fn ph_killblocked() {
