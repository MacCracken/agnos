    if (k != 0) { lx_bad("LIFE-STOP", "kill19", k); }
    else { if (st5 == 0) { lx_bad("LIFE-STOP", "no_state5", lx_state(c)); }
    else { if (tk1 != tk0) { lx_bad("LIFE-STOP", "ticks_moved", tk1 - tk0); }
    else { if (wp != (0 - 2)) { lx_bad("LIFE-STOP", "waitpid", wp); }
    else { if (LX_NCPU < 2) { lx_v(v == 1, "LIFE-STOP", "via_not_claim", v); }
    else { if (v == 1) { lx_ok("LIFE-STOP"); } else { lx_v(v == 2, "LIFE-STOP", "via", v); } } } } } }
    if (k2 != 0) { return lx_bad("LIFE-CONT", "kill18", k2); }
    if (st2 == 5) { return lx_bad("LIFE-CONT", "still_5", st2); }
    if (tk3 - tk2 < 5) { return lx_bad("LIFE-CONT", "ticks", tk3 - tk2); }
    return lx_v(r == 265, "LIFE-CONT", "status", r);
}
fn ph_stoptick() {
    lx_phase("STOPTICK");
    if (LX_NCPU < 2) { return lx_na("LIFE-STOP-TICK"); }
    var round = 0;
    var last = 0;
    while (round < 3) {
        var c = lx_spin_running();
        if (c >= 0) {
            var s0 = lx_kscan();
            l_kill(c, 19);
            var ok5 = lx_wait_state(c, 5, 500);
            var v = lx_kvia_w("stop", c, s0, 500);
            l_kill(c, 18);
            var r = lx_killreap(c, 2000);
            if (ok5 == 0) { return lx_bad("LIFE-STOP-TICK", "no_state5", 0); }
            if (r != 265) { return lx_bad("LIFE-STOP-TICK", "status", r); }
            if (v == 2) { return lx_ok("LIFE-STOP-TICK"); }
            last = v;
        }
        round = round + 1;
    }
    return lx_bad("LIFE-STOP-TICK", "no_tick_round", last);
}
fn ph_killstopped() {
    lx_phase("KILLSTOPPED");
    var c = l_spawn("spin");
    l_sleep(30);
    l_kill(c, 19);
    var ok5 = lx_wait_state(c, 5, 500);
    var s0 = lx_kscan();
    var r = lx_killreap(c, 2000);
    var v = lx_kvia_w("kill", c, s0, 500);
    if (ok5 == 0) { return lx_bad("LIFE-KILL-STOPPED", "no_state5", 0); }
    if (r != 265) { return lx_bad("LIFE-KILL-STOPPED", "status", r); }
    if (LX_NCPU < 2) { if (v != 1) { return lx_bad("LIFE-KILL-STOPPED", "via_not_claim", v); } }
    return lx_ok("LIFE-KILL-STOPPED");
}
fn ph_selfstop() {
    lx_phase("SELFSTOP");
