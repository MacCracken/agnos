    return lx_ok("LIFE-SIGTERM-NODEFAULT");
}
fn ph_release() {
    lx_phase("RELEASE");
    # FLOCK: a killed holder's advisory lock is released by the death chain.
    var fd = l_open("/lf");
    var h = l_spawn("flockhold");
    var t = l_us() + 2000000;
    var held = 0;
    while (l_us() < t) {
        if (l_flock(fd, 2 | 4) == (0 - 1)) { held = 1; break; }
        l_flock(fd, 8);
        l_sleep(10);
    }
    var hr = lx_killreap(h, 2000);
    var after = l_flock(fd, 2 | 4);
    l_flock(fd, 8);
    l_close(fd);
    if (held == 0) { lx_bad("LIFE-KILL-RELEASE-FLOCK", "never_held", 0); }
    else { if (hr != 265) { lx_bad("LIFE-KILL-RELEASE-FLOCK", "status", hr); }
    else { lx_v(after == 0, "LIFE-KILL-RELEASE-FLOCK", "still_locked", after); } }
    # CHAN: a killed endpoint owner reads as PEERGONE (-9) on the other end.
    var cr = syscall(97, 1, &lx_fds, 0, 0);
    var ca = load64(&lx_fds);
    var cb = load64(&lx_fds + 8);
    var ef = syscall(97, 5, cb, 0, 0);
    var ch = l_spawn("chanhold");
    l_sleep(30);
    var before = syscall(97, 3, ca, &lx_rb, 64);
    var chr = lx_killreap(ch, 2000);
    var gone = syscall(97, 3, ca, &lx_rb, 64);
    syscall(97, 4, ca, 0, 0);
    syscall(97, 4, cb, 0, 0);
    if (cr != 0) { lx_bad("LIFE-KILL-RELEASE-CHAN", "mint", cr); }
    else { if (ef < 0) { lx_bad("LIFE-KILL-RELEASE-CHAN", "endow", ef); }
    else { if (before != (0 - 8)) { lx_bad("LIFE-KILL-RELEASE-CHAN", "before", before); }
    else { if (chr != 265) { lx_bad("LIFE-KILL-RELEASE-CHAN", "status", chr); }
    else { lx_v(gone == (0 - 9), "LIFE-KILL-RELEASE-CHAN", "after", gone); } } } }
    # TCP: a killed listener's port is free again.
    var ls = l_spawn1("listen", 7777);
    var t2 = l_us() + 2000000;
    var busy = 0;
    while (l_us() < t2) {
        var lt = syscall(56, 7777, 0, 0, 0);
        if (lt < 0) { busy = 1; break; }
        syscall(50, lt, 0, 0, 0);
        l_sleep(10);
    }
    var lr = lx_killreap(ls, 2000);
    var l2 = syscall(56, 7777, 0, 0, 0);
    if (l2 >= 0) { syscall(50, l2, 0, 0, 0); }
    if (busy == 0) { return lx_bad("LIFE-KILL-RELEASE-TCP", "never_listened", 0); }
    if (lr != 265) { return lx_bad("LIFE-KILL-RELEASE-TCP", "status", lr); }
    return lx_v(l2 >= 0, "LIFE-KILL-RELEASE-TCP", "port_still_held", l2);
}
fn ph_leak() {
    lx_phase("LEAK");
    var f = 0;
    while (f < 16) {
        var c = l_spawn("spin");
        if (c < 0) { break; }
        store64(&lx_kids + f * 8, c);
        f = f + 1;
    }
    var i = 0;
    while (i < f) { l_kill(load64(&lx_kids + i * 8), 9); i = i + 1; }
    i = 0;
    while (i < f) { lx_reap(load64(&lx_kids + i * 8), 2000); i = i + 1; }
    var bad = 0;
    i = 0;
    while (i < 20) {
        var c2 = l_spawn("spin");
        l_sleep(20);
        if (lx_killreap(c2, 2000) != 265) { bad = bad + 1; }
        i = i + 1;
    }
    var f2 = 0;
    while (f2 < 16) {
        var c3 = l_spawn("spin");
        if (c3 < 0) { break; }
        store64(&lx_kids + f2 * 8, c3);
        f2 = f2 + 1;
    }
    i = 0;
    while (i < f2) { l_kill(load64(&lx_kids + i * 8), 9); i = i + 1; }
    i = 0;
    while (i < f2) { lx_reap(load64(&lx_kids + i * 8), 2000); i = i + 1; }
    if (bad != 0) { return lx_bad("LIFE-LEAK", "status", bad); }
    if (f2 != f) { return lx_bad("LIFE-LEAK", "free_slots", f2 - f); }
    if (lx_free_ok() == 0) { return lx_bad("LIFE-LEAK", "free_ram", lx_free()); }
    return lx_ok("LIFE-LEAK");
}
