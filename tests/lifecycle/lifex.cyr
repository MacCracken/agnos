    if (n0 != 0) { return lx_bad("LIFE-KILL-BLOCKED-KBD-NEXT", "reclaim_line_before", n0); }
    return lx_v(r == 265, "LIFE-KILL-BLOCKED-KBD-NEXT", "status", r);
}
