# gputex.cyr — RUNG 13's iron instrument: #92 op 0x0B TRI_TEX, GPU vs texcore.cyr.
#
# ⛔ THE INSTRUMENT IS THE ONLY LINK WITH NO ORACLE, and this arc has already lost four burns to
# exactly that. [[feedback_instrument_has_no_oracle]] Everything below is written so a red run names
# a PIXEL rather than a suspect: located diffs with the coverage byte, a per-case differing count,
# and an ABSOLUTE test whose expected bytes this tool did not compute.
#
# ⭐ THE ABSOLUTE TEST IS THE POINT. At 1:1 with integer UV and full coverage, the rendered rect must
# be byte-identical to THE SOURCE TEXTURE ITSELF — an artifact the reference never produced. Every
# other check compares two things I wrote; this one compares against an input. It is the only gate
# here that can catch the reference and the shader being wrong together.

include "lib/io.cyr"
include "texcore.cyr"

var tx_tex[512];                # 8x8 RGBA8 = 256 B  (measured sizing: N x u64 in this directory)
var tx_lut[512];                # 256 x 4 B = 1024 B
var tx_vtx[16];                 # one 48-byte vertex/UV record
var tx_edges[64];               # 3 edges x 16 B
var tx_ref[2048];               # 32x32x4 = 4096 B reference image
var tx_got[2048];               # what the GPU wrote, read back

var TXW = 32;
var TXH = 32;
var TXD = 8;                    # texture is 8x8

fn phex8(v): i64 {
    print("0x", 2);
    var d = 28;
    while (d >= 0) {
        var nib = (v >> d) & 0xF;
        if (nib < 10) { print("0123456789" + nib, 1); }
        if (nib >= 10) { print("abcdef" + (nib - 10), 1); }
        d = d - 4;
    }
    return 0;
}
fn puts2(s): i64 { ps(s); nl(); return 0; }

fn tx_build_tex(): i64 {
    var i = 0;
    while (i < 64) {
        store32(&tx_tex + i * 4, 0xFF000000 | (i << 16) | ((63 - i) << 8) | (i * 3));
        i = i + 1;
    }
    var k = 0;
    while (k < 256) { store32(&tx_lut + k * 4, 0xFF000000 | (k << 16) | (k << 8) | k); k = k + 1; }
    return 0;
}

# The corpus: the same frames texmodel gates on, so a divergence here is the EMISSION and nothing
# else. Fields: ax ay bx by cx cy u0 v0 u1 v1 u2 v2 (UV in 16.16 texel space).
var TXN = 5;
fn txf(i, f): i64 {
    if (i == 0) {   # ⭐ 1:1 identity -- the absolute test
        if (f == 0) { return 0; }  if (f == 1) { return 0; }
        if (f == 2) { return 8; }  if (f == 3) { return 0; }
        if (f == 4) { return 0; }  if (f == 5) { return 8; }
        if (f == 6) { return 0; }  if (f == 7) { return 0; }
        if (f == 8) { return 8 << 16; } if (f == 9) { return 0; }
        if (f == 10) { return 0; } return 8 << 16;
    }
    if (i == 1) {   # non-integer scale: 8 texels across 13 px -- the plan's named gate
        if (f == 0) { return 0; }  if (f == 1) { return 0; }
        if (f == 2) { return 13; } if (f == 3) { return 0; }
        if (f == 4) { return 0; }  if (f == 5) { return 13; }
        if (f == 6) { return 0; }  if (f == 7) { return 0; }
        if (f == 8) { return 8 << 16; } if (f == 9) { return 0; }
        if (f == 10) { return 0; } return 8 << 16;
    }
    if (i == 2) {   # magnified 3 texels across 24 px -- nearest must produce hard blocks
        if (f == 0) { return 0; }  if (f == 1) { return 0; }
        if (f == 2) { return 24; } if (f == 3) { return 0; }
        if (f == 4) { return 0; }  if (f == 5) { return 24; }
        if (f == 6) { return 0; }  if (f == 7) { return 0; }
        if (f == 8) { return 3 << 16; } if (f == 9) { return 0; }
        if (f == 10) { return 0; } return 3 << 16;
    }
    if (i == 4) {   # ⭐ NEGATIVE UV -- exercises the signed bias fold. Burn 1 shipped that path
        # UNTESTED: the corpus had no frame whose UV goes below zero, so a logical-shift slip there
        # would have selected the OPPOSITE edge and no case would have noticed.
        if (f == 0) { return 0; }  if (f == 1) { return 0; }
        if (f == 2) { return 16; } if (f == 3) { return 0; }
        if (f == 4) { return 0; }  if (f == 5) { return 16; }
        if (f == 6) { return 0 - (3 << 16); } if (f == 7) { return 0 - (3 << 16); }
        if (f == 8) { return 11 << 16; } if (f == 9) { return 0; }
        if (f == 10) { return 0; } return 11 << 16;
    }
    # i == 3: skewed, u and v not axis-aligned
    if (f == 0) { return 2; }  if (f == 1) { return 1; }
    if (f == 2) { return 20; } if (f == 3) { return 5; }
    if (f == 4) { return 6; }  if (f == 5) { return 22; }
    if (f == 6) { return 0; }  if (f == 7) { return 0; }
    if (f == 8) { return 8 << 16; } if (f == 9) { return 2 << 16; }
    if (f == 10) { return 1 << 16; } return 8 << 16;
}

# ⭐ WRAP FRAMES, SEPARATE FROM THE CLAMP CORPUS. The clamp frames keep UV inside the texture, so
# running them under WRAP would prove only that the two modes agree where neither does anything.
# These deliberately leave it: one tiles 3x, one goes NEGATIVE.
var TXWN = 2;
fn txwf(i, f): i64 {
    if (i == 0) {   # 3x tiling in both axes -- the texture must repeat, not smear its last row
        if (f == 0) { return 0; }  if (f == 1) { return 0; }
        if (f == 2) { return 24; } if (f == 3) { return 0; }
        if (f == 4) { return 0; }  if (f == 5) { return 24; }
        if (f == 6) { return 0; }  if (f == 7) { return 0; }
        if (f == 8) { return 24 << 16; } if (f == 9) { return 0; }
        if (f == 10) { return 0; } return 24 << 16;
    }
    # i == 1: NEGATIVE UV under wrap -- the far-edge case. Clamp sends these to texel 0; wrap sends
    # them to tw-1, and the shader's `AND (dim-1)` must agree with the reference's floor-then-mod.
    if (f == 0) { return 0; }  if (f == 1) { return 0; }
    if (f == 2) { return 16; } if (f == 3) { return 0; }
    if (f == 4) { return 0; }  if (f == 5) { return 16; }
    if (f == 6) { return 0 - (5 << 16); } if (f == 7) { return 0 - (5 << 16); }
    if (f == 8) { return 11 << 16; } if (f == 9) { return 0; }
    if (f == 10) { return 0; } return 11 << 16;
}

fn txw_name(i): i64 {
    if (i == 0) { ps("wrap-3x-tile"); }
    if (i == 1) { ps("wrap-negative-UV"); }
    return 0;
}

fn tx_name(i): i64 {
    if (i == 0) { ps("1:1-identity"); }
    if (i == 1) { ps("non-integer-scale"); }
    if (i == 2) { ps("magnified-3tex"); }
    if (i == 3) { ps("skewed"); }
    if (i == 4) { ps("negative-UV"); }
    return 0;
}

fn digest(buf, n): i64 {
    var h = 2166136261;
    var i = 0;
    while (i < n) {
        h = (h ^ (load8(buf + i) & 0xFF)) & 0xFFFFFFFF;
        h = (h * 16777619) & 0xFFFFFFFF;
        i = i + 1;
    }
    return h;
}

# Pack the frame's own three edges as the coverage shape, exactly as op 0x09's caller does.
fn tx_pack_edges(i): i64 {
    var e = 0;
    while (e < 3) {
        var a = e; var b = e + 1;
        if (b == 3) { b = 0; }
        store32(&tx_edges + (e * 4 + 0) * 4, txf(i, a * 2 + 0) << 16);
        store32(&tx_edges + (e * 4 + 1) * 4, txf(i, a * 2 + 1) << 16);
        store32(&tx_edges + (e * 4 + 2) * 4, txf(i, b * 2 + 0) << 16);
        store32(&tx_edges + (e * 4 + 3) * 4, txf(i, b * 2 + 1) << 16);
        e = e + 1;
    }
    return 0;
}

fn tx_pack_vtx(i): i64 {
    var f = 0;
    while (f < 6) { store32(&tx_vtx + f * 4, txf(i, f) << 16); f = f + 1; }
    var g = 6;
    while (g < 12) { store32(&tx_vtx + g * 4, txf(i, g)); g = g + 1; }
    return 0;
}

# Capture the coverage op 0x08 actually produces, so the reference consumes the SAME mask the GPU
# does. ⛔ Assuming 255 everywhere is the defect that cost burn 3 of rung 11.
fn tx_cov_capture(i, out): i64 {
    tx_pack_edges(i);
    var eid = syscall(86, 64 * 16);
    if (eid < 1) { return 0; }
    var mid = syscall(86, TXW * TXH);
    if (mid < 1) { syscall(74, eid); return 0; }
    if (syscall(72, eid, &tx_edges, 3 * 16) != 0) { syscall(74, eid); syscall(74, mid); return 0; }
    var z = 0;
    while (z < TXW * TXH / 8) { store64(out + z * 8, 0); z = z + 1; }
    syscall(72, mid, out, TXW * TXH);
    var d[64];
    var q = 0;
    while (q < 16) { store32(&d + q * 4, 0); q = q + 1; }
    store32(&d +  0, 8);
    store32(&d +  8, mid);
    store32(&d + 12, eid);
    store32(&d + 16, (TXH * 65536) + TXW);
    store32(&d + 36, 3);
    var rc = syscall(92, &d, 64);
    var ok = 1;
    if (rc != 0) { ok = 0; }
    if (ok == 1) { if (syscall(73, mid, out, TXW * TXH) != 0) { ok = 0; } }
    syscall(74, eid); syscall(74, mid);
    return ok;
}

var tx_cov[512];                # 32*32 = 1024 B coverage mask

fn tx_ref_fill(i, idx8): i64 {
    var y = 0;
    while (y < TXH) {
        var x = 0;
        while (x < TXW) {
            var cv = load8(&tx_cov + y * TXW + x) & 0xFF;
            var v = 0xFF101010;
            if (cv != 0) { v = tex_ref_px(&tx_tex, &tx_lut, TXD, TXD, x, y, cv, 0xFF101010, idx8); }
            store32(&tx_ref + (y * TXW + x) * 4, v);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

var tx_ndiff = 0;
var tx_dumped = 0;

fn tx_run_case_f(i, idx8, tileno, fullcov): i64 {
    var xflags = idx8;
    if (fullcov != 0) { xflags = xflags + 2; }
    # ⭐ RUNG 15: the SAME flag that switches texcore's reference switches the op's BILINEAR bit.
    # ⛔ Deliberately not a second variable. A reference computing NEAREST while the GPU computes
    # BILINEAR would report a difference that is the TEST's fault, and it would look exactly like a
    # broken shader — the most expensive possible red. One flag makes that unrepresentable.
    if (tx_bilin != 0) { xflags = xflags + 16; }      # GPU_TEX_FLAG_BILINEAR
    if (tri_prep(txf(i,0), txf(i,1), txf(i,2), txf(i,3), txf(i,4), txf(i,5),
                 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF) != 1) { return 0 - 1; }
    if (tex_prep(txf(i,6), txf(i,7), txf(i,8), txf(i,9), txf(i,10), txf(i,11)) != 1) { return 0 - 1; }
    if (fullcov == 0) {
        if (tx_cov_capture(i, &tx_cov) == 0) { return 0 - 2; }
    }
    if (fullcov != 0) {
        # ⭐ THE REFERENCE MUST BE FED 255, NOT THE CAPTURED MASK. FULLCOV's whole claim is that
        # every pixel is covered; feeding the reference a real mask here would compare the GPU's
        # full rect against a shaped reference and report a difference that is the TEST's fault.
        var cz = 0;
        while (cz < TXW * TXH) { store8(&tx_cov + cz, 255); cz = cz + 1; }
    }
    tx_ref_fill(i, idx8);

    var tx0 = (tileno % 4) * 40 + 8;
    var ty0 = (tileno / 4) * 40 + 8;

    var tid = syscall(86, 4096);
    var lid = syscall(86, 4096);
    var vid = syscall(86, 4096);
    var eid = syscall(86, 4096);
    if (tid < 1) { return 0 - 3; }
    if (lid < 1) { return 0 - 3; }
    if (vid < 1) { return 0 - 3; }
    if (eid < 1) { return 0 - 3; }

    syscall(72, tid, &tx_tex, TXD * TXD * 4);
    syscall(72, lid, &tx_lut, 256 * 4);
    tx_pack_vtx(i);
    syscall(72, vid, &tx_vtx, 48);
    tx_pack_edges(i);
    syscall(72, eid, &tx_edges, 3 * 16);

    # ⭐ CLEAR THE DESTINATION TO THE REFERENCE'S OWN BACKGROUND. Without this the two sides do not
    # share an input and the comparison can only ever be a REPORT, never a gate demanding zero.
    if (syscall(88, 0xFF101010, (TXH * 65536) + TXW, (ty0 * 65536) + tx0) != 0) { return 0 - 4; }

    var d[64];
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d +  0, 11);                       # op 0x0B TRI_TEX
    store32(&d +  4, xflags);
    store32(&d +  8, tid);
    if (fullcov == 0) { store32(&d + 12, eid); }
    store32(&d + 16, (TXH * 65536) + TXW);
    store32(&d + 20, (ty0 * 65536) + tx0);
    store32(&d + 24, vid);
    store32(&d + 28, (TXD * 65536) + TXD);
    if (idx8 != 0) { store32(&d + 32, lid); }
    if (fullcov == 0) { store32(&d + 60, 3); }
    var rc = syscall(92, &d, 64);
    if (rc != 0) {
        syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, eid);
        return 0 - 100 - ((0 - rc) & 0xFF);
    }

    var rid = syscall(86, TXW * TXH * 4);
    if (rid < 1) { return 0 - 3; }
    var pz = 0;
    while (pz < TXW * TXH * 4 / 8) { store64(&tx_got + pz * 8, 0xA5A5A5A5A5A5A5A5); pz = pz + 1; }
    syscall(72, rid, &tx_got, TXW * TXH * 4);
    var rb = syscall(90, rid, (TXH * 65536) + TXW, (ty0 * 65536) + tx0);
    if (rb != 0) { return 0 - 5; }
    if (syscall(73, rid, &tx_got, TXW * TXH * 4) != 0) { return 0 - 5; }
    syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, eid); syscall(74, rid);

    var bad = 0;
    var pi = 0;
    while (pi < TXW * TXH) {
        var got = load32(&tx_got + pi * 4) & 0xFFFFFFFF;
        var want = load32(&tx_ref + pi * 4) & 0xFFFFFFFF;
        if (got != want) {
            bad = bad + 1;
            if (tx_dumped < 4) {
                tx_dumped = tx_dumped + 1;
                ps("    diff case "); pn(i); ps(" @ x="); pn(pi % TXW); ps(" y="); pn(pi / TXW);
                ps("  cov="); pn(load8(&tx_cov + pi) & 0xFF);
                ps("  want="); phex8(want); ps("  got="); phex8(got); nl();
            }
        }
        pi = pi + 1;
    }
    tx_ndiff = tx_ndiff + bad;
    return bad;
}

# ============================================================================================
# THE BANDWIDTH MEASUREMENT — the number rung 14 must not be surprised by
# ============================================================================================
# ⭐ THE PLAN ASKS RUNG 13 TO RECORD ACHIEVED GB/s BECAUSE RUNG 14 IS BANDWIDTH-BOUND. Shipping
# rung 13 green without it would hand rung 14 a budget nobody had measured.
#
# ⛔ uptime_us #95, NOT uptime_ms #40. A foreground `run` program executes with IF CLEARED, so the
# timer never fires and #40 is FROZEN for the program's whole duration. Two iron burns were lost to
# that: one fabricated a 0 us timing and divided by it, the other spun on a clock that could not
# advance. #95 is rdtsc-backed and needs no interrupts.
#
# ⚠ WHAT IS COUNTED, stated so the number is not over-read. Bytes moved per dispatch is the
# DESTINATION rect written plus the coverage mask read plus the texels read. Texel traffic is
# counted as one dword per covered pixel — the true figure is lower because the cache serves
# repeats, so this is a LOWER bound on achieved bandwidth, not an upper one.
var TX_BENCH_REPS = 200;

# tx_bench_at — time REPS dispatches of a w x h rect covering the whole rect, and return elapsed us.
# Returns 0 - 1 if anything refused, so the caller can decline to divide.
fn tx_bench_at(w, h, reps, fullcov): i64 {
    # A frame spanning the rect, UV mapping the whole 8x8 texture across it.
    var b = &tx_vtx;
    store32(b +  0, 0);          store32(b +  4, 0);
    store32(b +  8, w << 16);    store32(b + 12, 0);
    store32(b + 16, 0);          store32(b + 20, h << 16);
    store32(b + 24, 0);          store32(b + 28, 0);
    store32(b + 32, TXD << 16);  store32(b + 36, 0);
    store32(b + 40, 0);          store32(b + 44, TXD << 16);
    var e = 0;
    while (e < 3) {
        var i0 = e; var i1 = e + 1;
        if (i1 == 3) { i1 = 0; }
        var xs = 0; var ys = 0; var xe = 0; var ye = 0;
        if (i0 == 1) { xs = w; }
        if (i0 == 2) { ys = h; }
        if (i1 == 1) { xe = w; }
        if (i1 == 2) { ye = h; }
        store32(&tx_edges + (e * 4 + 0) * 4, xs << 16);
        store32(&tx_edges + (e * 4 + 1) * 4, ys << 16);
        store32(&tx_edges + (e * 4 + 2) * 4, xe << 16);
        store32(&tx_edges + (e * 4 + 3) * 4, ye << 16);
        e = e + 1;
    }

    var tid = syscall(86, 4096);
    var vid = syscall(86, 4096);
    var eid = syscall(86, 4096);
    if (tid < 1) { return 0 - 1; }
    if (vid < 1) { return 0 - 1; }
    if (eid < 1) { return 0 - 1; }
    syscall(72, tid, &tx_tex, TXD * TXD * 4);
    syscall(72, vid, &tx_vtx, 48);
    syscall(72, eid, &tx_edges, 3 * 16);

    var d[64];
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d +  0, 11);
    store32(&d +  4, fullcov * 2);            # bit 1 = FULLCOV
    store32(&d +  8, tid);
    store32(&d + 16, (h * 65536) + w);
    store32(&d + 20, (8 * 65536) + 8);
    store32(&d + 24, vid);
    store32(&d + 28, (TXD * 65536) + TXD);
    # ⚠ FULLCOV supplies NO shape, so edge_id / n_edges / rule stay zero or the ABI refuses.
    if (fullcov == 0) { store32(&d + 12, eid); store32(&d + 60, 3); }

    if (syscall(92, &d, 64) != 0) {          # one warm-up: arming must not land in the timed window
        syscall(74, tid); syscall(74, vid); syscall(74, eid);
        return 0 - 1;
    }
    var t0 = syscall(95);
    var r = 0;
    var bad = 0;
    while (r < reps) {
        if (syscall(92, &d, 64) != 0) { bad = 1; r = reps; }
        r = r + 1;
    }
    var el = syscall(95) - t0;
    syscall(74, tid); syscall(74, vid); syscall(74, eid);
    if (bad != 0) { return 0 - 1; }
    return el;
}

# ⛔ TWO SIZES, BECAUSE ONE SIZE CANNOT SEPARATE OVERHEAD FROM BANDWIDTH — and the first version of
# this bench got that wrong. A 32x32 rect is 1024 pixels; rung 11's MEASURED cost model puts fixed
# dispatch overhead near 28.8 us, so a 56 us measurement there is almost entirely overhead and the
# MB/s derived from it says nothing about a bandwidth-bound workload. Handing rung 14 that number
# would have been handing it a surprise, which is the one thing the plan asks this bench to prevent.
#
# ⭐ Timing a SMALL and a LARGE rect and differencing gives both terms:
#     fixed_us      = the intercept -- dispatch, arming, fence, ring
#     us_per_pixel  = the slope -- the part that actually scales with work
# Rung 14 sizes its frame budget from the SLOPE; the intercept tells it how many dispatches per
# frame it can afford at all.
fn tx_bench(): i64 {
    var reps_s = TX_BENCH_REPS;
    var reps_l = 20;                          # the large rect is ~64x the work; fewer reps suffice
    var small = 32;
    var large = 256;

    var el_s = tx_bench_at(small, small, reps_s, 0);
    var el_l = tx_bench_at(large, large, reps_l, 0);
    if (el_s <= 0) { puts2("gputex: bench REFUSED -- small rect did not time; no rate reported"); return 0; }
    if (el_l <= 0) { puts2("gputex: bench REFUSED -- large rect did not time; no rate reported"); return 0; }

    var us_s = el_s * 1000 / reps_s;          # milli-microseconds, to keep a fraction in integers
    var us_l = el_l * 1000 / reps_l;
    var px_s = small * small;
    var px_l = large * large;

    ps("gputex: bench "); pn(small); ps("x"); pn(small); ps(" = ");
    pn(us_s / 1000); ps("."); pn((us_s % 1000) / 100); ps(" us/dispatch   ");
    pn(large); ps("x"); pn(large); ps(" = ");
    pn(us_l / 1000); ps("."); pn((us_l % 1000) / 100); puts2(" us/dispatch");

    # ⚠ UNITS, WRITTEN OUT, BECAUSE THE FIRST VERSION MISLABELLED THEM BY 10^6. us_s/us_l are
    # NANOSECONDS per dispatch (elapsed us x 1000 / reps). Multiplying their difference by another
    # 1000 before dividing by pixels gives PICOSECONDS PER PIXEL. The first label said "pico-us/px",
    # which would have had rung 14 sizing a budget from a number a million times too large.
    var slope_ps = (us_l - us_s) * 1000 / (px_l - px_s);        # picoseconds per pixel
    var fixed_ns = us_s - (slope_ps * px_s / 1000);             # nanoseconds per dispatch
    ps("gputex:   fixed overhead ~"); pn(fixed_ns / 1000); ps(" us/dispatch; slope ~");
    pn(slope_ps); ps(" ps/px ("); pn(slope_ps / 1000); ps("."); pn((slope_ps % 1000) / 100);
    puts2(" ns/px)");

    # ⭐ THE BUDGET, DERIVED HERE SO RUNG 14 DOES NOT HAVE TO. Two ceilings, and which one binds is
    # the whole point of measuring both terms.
    var frame_us = 28571;                                        # DOOM's 35 Hz tic
    ps("gputex:   rung-14 budget @35fps: "); pn(frame_us * 1000 / fixed_ns);
    ps(" dispatches/frame before ANY pixels, or ");
    pn(frame_us * 1000000 / slope_ps / 1000000); puts2(" Mpx/frame if fused into one");

    # ⚠ LOWER BOUND. Texel traffic is one dword per covered pixel here; the cache serves repeats,
    # so real achieved bandwidth is higher than this figure, never lower.
    var bytes_l = px_l * 4 + px_l + px_l * 4;
    var mbs = bytes_l * reps_l / el_l;
    ps("gputex:   at "); pn(large); ps("x"); pn(large); ps(": >= "); pn(mbs);
    puts2(" MB/s (lower bound -- texels counted uncached)");
    ps("gputex:   ⭐ rung 14 sizes its budget from the SLOPE; the intercept caps dispatches/frame.");
    nl();

    # ⭐⭐ THE FULLCOV SAVING, MEASURED RATHER THAN ASSERTED.
    # ⛔ The first version of this bench timed the SHAPED path twice and never set the flag, so the
    # ~52 us it printed said nothing at all about FULLCOV — and the burn brief compounded it by
    # reading "bench unchanged" as evidence the flag had not reached the record. It had; the bench
    # simply was not exercising it. Correctness (5 of 5 byte-identical) was proven that burn; the
    # SAVING was not, and the two were being conflated.
    var el_fs = tx_bench_at(small, small, reps_s, 1);
    var el_fl = tx_bench_at(large, large, reps_l, 1);
    if (el_fs <= 0) { puts2("gputex:   FULLCOV bench REFUSED at 32x32 -- no saving reported"); return 1; }
    if (el_fl <= 0) { puts2("gputex:   FULLCOV bench REFUSED at 256x256 -- no saving reported"); return 1; }
    var fus = el_fs * 1000 / reps_s;
    var ful = el_fl * 1000 / reps_l;
    ps("gputex:   FULLCOV "); pn(small); ps("x"); pn(small); ps(" = ");
    pn(fus / 1000); ps("."); pn((fus % 1000) / 100); ps(" us   ");
    pn(large); ps("x"); pn(large); ps(" = ");
    pn(ful / 1000); ps("."); pn((ful % 1000) / 100); puts2(" us");
    ps("gputex:   ⭐ saving at "); pn(small); ps("x"); pn(small); ps(": ");
    pn((us_s - fus) / 1000); ps(" us/dispatch (");
    pn((us_s - fus) * 100 / us_s); puts2("%) -- two of three dispatches removed");
    ps("gputex:   rung-14 budget WITH fullcov @35fps: ");
    pn(28571 * 1000 / fus); puts2(" dispatches/frame");
    return 1;
}

# tx_run_wrap — one WRAP case. FULLCOV is set too: these frames fill their rects, so this also
# exercises the two flags TOGETHER, which no other case does.
fn tx_run_wrap(i, tileno): i64 {
    if (tri_prep(txwf(i,0), txwf(i,1), txwf(i,2), txwf(i,3), txwf(i,4), txwf(i,5),
                 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF) != 1) { return 0 - 1; }
    if (tex_prep(txwf(i,6), txwf(i,7), txwf(i,8), txwf(i,9), txwf(i,10), txwf(i,11)) != 1) { return 0 - 1; }

    # ⛔ THE REFERENCE MUST BE PUT IN WRAP MODE TOO, or this compares tiling against clamping and
    # reports a difference that is the TEST's fault. Restored before returning so the clamp cases
    # that follow are unaffected.
    tx_wrap = 1;
    var cz = 0;
    while (cz < TXW * TXH) { store8(&tx_cov + cz, 255); cz = cz + 1; }
    tx_ref_fill(i, 0);

    var tx0 = (tileno % 4) * 40 + 8;
    var ty0 = (tileno / 4) * 40 + 8;
    var tid = syscall(86, 4096);
    var vid = syscall(86, 4096);
    if (tid < 1) { tx_wrap = 0; return 0 - 3; }
    if (vid < 1) { tx_wrap = 0; return 0 - 3; }
    syscall(72, tid, &tx_tex, TXD * TXD * 4);
    var f = 0;
    while (f < 6) { store32(&tx_vtx + f * 4, txwf(i, f) << 16); f = f + 1; }
    var g = 6;
    while (g < 12) { store32(&tx_vtx + g * 4, txwf(i, g)); g = g + 1; }
    syscall(72, vid, &tx_vtx, 48);

    if (syscall(88, 0xFF101010, (TXH * 65536) + TXW, (ty0 * 65536) + tx0) != 0) {
        tx_wrap = 0; return 0 - 4;
    }
    var d[64];
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d +  0, 11);
    store32(&d +  4, 2 + 4);                     # FULLCOV | WRAP
    store32(&d +  8, tid);
    store32(&d + 16, (TXH * 65536) + TXW);
    store32(&d + 20, (ty0 * 65536) + tx0);
    store32(&d + 24, vid);
    store32(&d + 28, (TXD * 65536) + TXD);
    var rc = syscall(92, &d, 64);
    if (rc != 0) {
        syscall(74, tid); syscall(74, vid); tx_wrap = 0;
        return 0 - 100 - ((0 - rc) & 0xFF);
    }
    var rid = syscall(86, TXW * TXH * 4);
    if (rid < 1) { tx_wrap = 0; return 0 - 3; }
    var pz = 0;
    while (pz < TXW * TXH * 4 / 8) { store64(&tx_got + pz * 8, 0xA5A5A5A5A5A5A5A5); pz = pz + 1; }
    syscall(72, rid, &tx_got, TXW * TXH * 4);
    if (syscall(90, rid, (TXH * 65536) + TXW, (ty0 * 65536) + tx0) != 0) { tx_wrap = 0; return 0 - 5; }
    if (syscall(73, rid, &tx_got, TXW * TXH * 4) != 0) { tx_wrap = 0; return 0 - 5; }
    syscall(74, tid); syscall(74, vid); syscall(74, rid);
    tx_wrap = 0;

    var bad = 0;
    var pi = 0;
    while (pi < TXW * TXH) {
        var got = load32(&tx_got + pi * 4) & 0xFFFFFFFF;
        var want = load32(&tx_ref + pi * 4) & 0xFFFFFFFF;
        if (got != want) {
            bad = bad + 1;
            if (tx_dumped < 4) {
                tx_dumped = tx_dumped + 1;
                ps("    diff WRAP case "); pn(i); ps(" @ x="); pn(pi % TXW); ps(" y="); pn(pi / TXW);
                ps("  want="); phex8(want); ps("  got="); phex8(got); nl();
            }
        }
        pi = pi + 1;
    }
    return bad;
}

# ==================================================================================================
# RUNG 14 — op 0x0C TEX_LIST: N textured primitives in ONE dispatch.
# ==================================================================================================
# ⭐ THE ORACLE IS SELF-REFERENTIAL AND THAT IS ITS STRENGTH. Rung 13's op 0x0B is proven correct —
# iron 17/17, and byte-diffed against texcore.cyr on the host. So the question for op 0x0C is not
# "is this the right picture" (that needs a fresh reference model, and a fresh model is a fresh
# thing to get wrong) but "is this the SAME picture op 0x0B draws". Draw the identical N primitives
# both ways into the identical cleared rect, read both back, and demand ZERO differing bytes.
#
# ⛔ A REPORT IS NOT A GATE. This demands 0 of TLW*TLH*4 bytes, not "close". Rung 13 learned that
# from the /255 hinge: `(x*a+127)>>8` and `(x*a+127)/255` differ on a handful of pixels out of
# thousands, look identical in a photo, and are different functions.

var TLW = 64;                   # the shared destination rect
var TLH = 48;
var TL_NP = 32;                 # primitives per list — 32 two-px columns spanning TLW

var tl_prims[384];              # 32 x 96 B = 3072 B   (measured sizing: N x u64 in this directory)
var tl_a[1536];                 # 64*48*4 = 12288 B — the op 0x0B rendering
var tl_b[1536];                 # the op 0x0C rendering
var tl_c[1536];                 # rung 14b: the op 0x0C COL-MAJOR rendering
var tl_v[16];                   # one 48-byte vtx record, reused per individual dispatch

# tl_maxph — the tallest column in the list. Needed to state the WAVE COUNTS, which are the number
# rung 14b is actually about: iron measured 177 ns per LAUNCHED wave against 22 ns per additional
# WORKING one, so the grid you launch is the cost and the pixels you shade very nearly are not.
fn tl_maxph(ragged): i64 {
    var m = 0;
    var c = 0;
    while (c < TL_NP) {
        if (tl_ph(c, ragged) > m) { m = tl_ph(c, ragged); }
        c = c + 1;
    }
    return m;
}

# tl_col_frame — column c's affine frame, RECT-LOCAL to its own (pw x TLH) strip.
# Each column samples a different slice of the texture so a mis-indexed record shows as a WRONG
# COLUMN rather than as a subtle shade — the failure mode is made loud on purpose.
fn tl_uv0(c): i64 { return (c % TXD) * 65536; }
fn tl_pw(): i64 { return TLW / TL_NP; }

# tl_ph — column c's height. ⭐ THE RAGGED VARIANT IS NOT DECORATION: it is the only thing that
# exercises the shader's `s_cmp_ge_u32 s9, s7 / s_cbranch_scc1 L_END` guard ON IRON. With every
# column the same height the grid is exactly the union and that branch never fires, so it would
# ship unexercised — precisely the residual rung 13 carried. A ragged skyline is also what a real
# DOOM seg looks like.
fn tl_ph(c, ragged): i64 {
    if (ragged == 0) { return TLH; }
    return 12 + (c * 7) % (TLH - 12);
}

# tl_pack_vtx — the 48-byte screen/UV record for column c, rect-local.
fn tl_pack_vtx(c, ragged): i64 {
    var w = tl_pw();
    var TLHc = tl_ph(c, ragged);
    store32(&tl_v +  0, 0);              store32(&tl_v +  4, 0);
    store32(&tl_v +  8, w * 65536);      store32(&tl_v + 12, 0);
    store32(&tl_v + 16, 0);              store32(&tl_v + 20, TLHc * 65536);
    store32(&tl_v + 24, tl_uv0(c));      store32(&tl_v + 28, 0);
    store32(&tl_v + 32, tl_uv0(c) + 65536); store32(&tl_v + 36, 0);
    store32(&tl_v + 40, tl_uv0(c));      store32(&tl_v + 44, TXD * 65536);
    return 0;
}

# tl_pack_prims — the same N frames as 96-byte TEX_LIST primitive records.
# ⚠ Byte-for-byte the same geometry tl_pack_vtx produces; if these two ever disagree the test is
# comparing two different pictures and its zero-diff demand becomes meaningless.
#
# ⚠ TAKES ITS DESTINATION so the two-op seam case below can build a SECOND list through this exact
# code. A hand-rolled copy of the packing for the second list would be a second thing to get wrong,
# and the whole argument of that case is that the two lists differ ONLY where it intends them to.
fn tl_pack_prims_at(dst, tid, lid, idx8, x0, y0, ragged, cm): i64 {
    var w = tl_pw();
    var c = 0;
    while (c < TL_NP) {
        var b = dst + c * 96;
        var TLHc = tl_ph(c, ragged);
        var z = 0;
        while (z < 24) { store32(b + z * 4, 0); z = z + 1; }
        store32(b +  0, (TLHc * 65536) + w);
        store32(b +  4, ((y0 + 0) * 65536) + (x0 + c * w));
        store32(b +  8, tid);
        if (idx8 != 0) { store32(b + 12, lid); }
        store32(b + 16, (TXD * 65536) + TXD);
        var fl = 2;                                  # FULLCOV — mandatory for this op
        if (idx8 != 0) { fl = fl + 1; }
        # ⭐ RUNG 14b: COLMAJOR IS THE **ONLY** FIELD THAT CHANGES, and that is the entire test.
        # The caller does NOT transpose anything — geometry, origins, UVs and the affine frame are
        # byte-for-byte what the row-major list carries. gpu_texl_build performs the transpose
        # kernel-side by feeding gpu_tex_prep the vertices with x/y swapped. So "the same records
        # plus one bit must draw the same picture" is a property ring 3 can state and check, and any
        # divergence is the kernel's, not the test's.
        if (cm != 0) { fl = fl + 8; }
        store32(b + 20, fl);
        store32(b + 24, 0);                    store32(b + 28, 0);
        store32(b + 32, w * 65536);            store32(b + 36, 0);
        store32(b + 40, 0);                    store32(b + 44, TLHc * 65536);
        store32(b + 48, tl_uv0(c));            store32(b + 52, 0);
        store32(b + 56, tl_uv0(c) + 65536);    store32(b + 60, 0);
        store32(b + 64, tl_uv0(c));            store32(b + 68, TXD * 65536);
        c = c + 1;
    }
    return 0;
}

fn tl_pack_prims(tid, lid, idx8, x0, y0, ragged, cm): i64 {
    return tl_pack_prims_at(&tl_prims, tid, lid, idx8, x0, y0, ragged, cm);
}

fn tl_readback(dst, x0, y0): i64 {
    var rid = syscall(86, TLW * TLH * 4);
    if (rid < 1) { return 0 - 3; }
    var pz = 0;
    while (pz < TLW * TLH * 4 / 8) { store64(dst + pz * 8, 0xA5A5A5A5A5A5A5A5); pz = pz + 1; }
    syscall(72, rid, dst, TLW * TLH * 4);
    var rb = syscall(90, rid, (TLH * 65536) + TLW, (y0 * 65536) + x0);
    if (rb != 0) { syscall(74, rid); return 0 - 5; }
    if (syscall(73, rid, dst, TLW * TLH * 4) != 0) { syscall(74, rid); return 0 - 5; }
    syscall(74, rid);
    return 0;
}

# tl_run — draw both ways, compare, and time each. Returns differing BYTE count, or a negative code.
fn tl_run(idx8, ragged): i64 {
    var x0 = 8;
    var y0 = 8;
    var w = tl_pw();

    var tid = syscall(86, 4096);
    var lid = syscall(86, 4096);
    var vid = syscall(86, 4096);
    var pid = syscall(86, 4096);
    if (tid < 1) { return 0 - 3; }
    if (lid < 1) { return 0 - 3; }
    if (vid < 1) { return 0 - 3; }
    if (pid < 1) { return 0 - 3; }
    syscall(72, tid, &tx_tex, TXD * TXD * 4);
    syscall(72, lid, &tx_lut, 256 * 4);

    # ⛔ ARM BOTH BLOBS BEFORE EITHER TIMED WINDOW. The first dispatch of an op pays the residency
    # write; tx_bench_at learned this and says so. Timing an unarmed 0x0C against an armed 0x0B
    # would report the arming cost as the fused op's cost and could invert the entire comparison.
    tl_pack_vtx(0, ragged);
    syscall(72, vid, &tl_v, 48);
    var wu[64];
    var wz = 0;
    while (wz < 16) { store32(&wu + wz * 4, 0); wz = wz + 1; }
    store32(&wu +  0, 11);
    var wf = 2;
    if (idx8 != 0) { wf = wf + 1; }
    store32(&wu +  4, wf);
    store32(&wu +  8, tid);
    store32(&wu + 16, (tl_ph(0, ragged) * 65536) + w);
    store32(&wu + 20, (y0 * 65536) + x0);
    store32(&wu + 24, vid);
    store32(&wu + 28, (TXD * 65536) + TXD);
    if (idx8 != 0) { store32(&wu + 32, lid); }
    if (syscall(92, &wu, 64) != 0) { return 0 - 101; }
    tl_pack_prims(tid, lid, idx8, x0, y0, ragged, 0);
    syscall(72, pid, &tl_prims, TL_NP * 96);
    var wl[64];
    var wq = 0;
    while (wq < 16) { store32(&wl + wq * 4, 0); wq = wq + 1; }
    store32(&wl +  0, 12);
    store32(&wl + 12, pid);
    store32(&wl + 16, (TLH * 65536) + TLW);
    store32(&wl + 20, (y0 * 65536) + x0);
    store32(&wl + 24, TL_NP);
    var wrc = syscall(92, &wl, 64);
    if (wrc != 0) {
        syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, pid);
        return 0 - 200 - ((0 - wrc) & 0xFF);
    }
    # ⛔ AND ARM THE COL-MAJOR BLOB TOO, HERE. It lives in its OWN arena slot with its OWN residency
    # flag (gpu_texl_cm_arm), so its first dispatch pays a 1832-byte write the row-major one already
    # paid above. Leaving that inside the timed window would charge rung 14b for arming and could
    # invert the very comparison this case exists to make.
    tl_pack_prims(tid, lid, idx8, x0, y0, ragged, 1);
    syscall(72, pid, &tl_prims, TL_NP * 96);
    if (syscall(92, &wl, 64) != 0) {
        syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, pid);
        return 0 - 220;
    }
    # back to row-major records for the A/B arms below
    tl_pack_prims(tid, lid, idx8, x0, y0, ragged, 0);
    syscall(72, pid, &tl_prims, TL_NP * 96);

    # ---- A: N individual op 0x0B FULLCOV dispatches ----
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y0 * 65536) + x0) != 0) { return 0 - 4; }
    var ta = syscall(95);
    var c = 0;
    while (c < TL_NP) {
        tl_pack_vtx(c, ragged);
        syscall(72, vid, &tl_v, 48);
        var d[64];
        var z = 0;
        while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
        store32(&d +  0, 11);                        # op 0x0B
        var f1 = 2;
        if (idx8 != 0) { f1 = f1 + 1; }
        store32(&d +  4, f1);
        store32(&d +  8, tid);
        store32(&d + 16, (tl_ph(c, ragged) * 65536) + w);
        store32(&d + 20, (y0 * 65536) + (x0 + c * w));
        store32(&d + 24, vid);
        store32(&d + 28, (TXD * 65536) + TXD);
        if (idx8 != 0) { store32(&d + 32, lid); }
        var rc = syscall(92, &d, 64);
        if (rc != 0) { return 0 - 100 - ((0 - rc) & 0xFF); }
        c = c + 1;
    }
    var tb = syscall(95);
    if (tl_readback(&tl_a, x0, y0) != 0) { return 0 - 5; }

    # ---- B: ONE op 0x0C fused dispatch, same geometry ----
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y0 * 65536) + x0) != 0) { return 0 - 4; }
    var tc = syscall(95);
    var e[64];
    var q = 0;
    while (q < 16) { store32(&e + q * 4, 0); q = q + 1; }
    store32(&e +  0, 12);                            # op 0x0C TEX_LIST
    store32(&e + 12, pid);
    store32(&e + 16, (TLH * 65536) + TLW);
    store32(&e + 20, (y0 * 65536) + x0);
    store32(&e + 24, TL_NP);
    var rl = syscall(92, &e, 64);
    var td = syscall(95);
    if (rl != 0) {
        syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, pid);
        return 0 - 200 - ((0 - rl) & 0xFF);
    }
    if (tl_readback(&tl_b, x0, y0) != 0) { return 0 - 5; }

    # ---- C: THE SAME op 0x0C LIST, COL-MAJOR. Rung 14b. ----
    # ⭐ THE ORACLE IS ARM B, NOT A MODEL. B is already proven byte-identical to 32 individual op
    # 0x0B dispatches, so demanding C == B inherits that proof and adds no new arithmetic to get
    # wrong. The records differ from B's in exactly ONE BIT; every other byte is identical, and the
    # transpose happens kernel-side. So a differing pixel can only be the transpose.
    tl_pack_prims(tid, lid, idx8, x0, y0, ragged, 1);
    syscall(72, pid, &tl_prims, TL_NP * 96);
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y0 * 65536) + x0) != 0) { return 0 - 4; }
    var te = syscall(95);
    var rm = syscall(92, &e, 64);
    var tf = syscall(95);
    if (rm != 0) {
        syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, pid);
        return 0 - 240 - ((0 - rm) & 0xFF);
    }
    if (tl_readback(&tl_c, x0, y0) != 0) { return 0 - 5; }
    syscall(74, tid); syscall(74, lid); syscall(74, vid); syscall(74, pid);

    ps("    "); pn(TL_NP); ps(" x 0x0B = "); pn(tb - ta); ps(" us");
    ps("    1 x 0x0C = "); pn(td - tc); ps(" us");
    if (td > tc) {
        if (tb > ta) { ps("    speedup "); pn((tb - ta) * 10 / (td - tc)); ps("/10x"); }
    }
    nl();

    # ⭐⭐ THE WAVE COUNTS ARE THE POINT, AND THEY ARE PRINTED SO THE BURN CHECKS THE MECHANISM AND
    # NOT JUST THE CLOCK. A time that improves for some other reason (cache, clocks, luck) is not
    # evidence the transpose happened; these two numbers are computed from the SAME rule the kernel
    # uses, so a measured speedup that does not track them means something else moved.
    #   row-major: gx = n << ceil(log2(ceil(max_pw/64))), gy = max_ph
    #   col-major: gx = n << ceil(log2(ceil(max_ph/64))), gy = max_pw
    var mph = tl_maxph(ragged);
    var srm = 0;
    while ((1 << srm) < (w + 63) / 64) { srm = srm + 1; }
    var scm = 0;
    while ((1 << scm) < (mph + 63) / 64) { scm = scm + 1; }
    var wrm = (TL_NP << srm) * mph;
    var wcm = (TL_NP << scm) * w;
    ps("    waves: row-major "); pn(wrm); ps("  col-major "); pn(wcm);
    if (wcm > 0) { ps("  ("); pn(wrm / wcm); ps("x fewer)"); }
    ps("    1 x 0x0C CM = "); pn(tf - te); ps(" us");
    if (tf > te) {
        if (td > tc) { ps("  vs RM "); pn((td - tc) * 10 / (tf - te)); ps("/10x"); }
    }
    nl();

    var bad = 0;
    var pi = 0;
    while (pi < TLW * TLH) {
        var ga = load32(&tl_a + pi * 4) & 0xFFFFFFFF;
        var gb = load32(&tl_b + pi * 4) & 0xFFFFFFFF;
        if (ga != gb) {
            bad = bad + 1;
            if (tx_dumped < 8) {
                tx_dumped = tx_dumped + 1;
                ps("    texl diff @ x="); pn(pi % TLW); ps(" y="); pn(pi / TLW);
                ps("  col="); pn((pi % TLW) / w);
                ps("  0x0B="); phex8(ga); ps("  0x0C="); phex8(gb); nl();
            }
        }
        pi = pi + 1;
    }
    # ⛔ AN ALL-BACKGROUND RECT WOULD COMPARE EQUAL AND PROVE NOTHING. If neither op drew anything,
    # both readbacks are the clear colour and `bad` is 0 — a green that means "two dispatches both
    # did nothing". Rung 13's N14 was structurally unreachable for four burns for exactly this kind
    # of reason. Demand that the 0x0B side actually painted.
    var painted = 0;
    var pk = 0;
    while (pk < TLW * TLH) {
        if ((load32(&tl_a + pk * 4) & 0xFFFFFFFF) != 0xFF101010) { painted = painted + 1; }
        pk = pk + 1;
    }
    # ⚠ THE THRESHOLD IS DERIVED FROM THE GEOMETRY, not a fixed fraction of the rect. A flat
    # "half the rect" bar happens to pass the ragged list by only 344 px (1880 of a 1536 bar), so a
    # different skyline could false-fire it — and a guard that fires for the wrong reason gets
    # deleted rather than understood. Expected = sum(pw*ph); demand three quarters of it, leaving
    # room for a texel that legitimately equals the clear colour without leaving room for "nothing
    # was drawn".
    var expect = 0;
    var ek = 0;
    while (ek < TL_NP) { expect = expect + w * tl_ph(ek, ragged); ek = ek + 1; }
    if (painted < expect * 3 / 4) {
        ps("    ⛔ the 0x0B side painted only "); pn(painted); ps(" px where the geometry demands ");
        pn(expect); puts2(" -- the comparison is vacuous");
        return 0 - 6;
    }

    # ---- rung 14b: C vs B, zero differing bytes ----
    # ⚠ THE VACUITY GUARD IS RETAINED AND POINTS AT THE **COL-MAJOR** SIDE. The check above proves
    # the 0x0B reference painted; it says nothing about C. A col-major dispatch that drew NOTHING
    # would leave tl_c at the clear colour, and comparing it against a painted tl_b would go loudly
    # red — but a col-major dispatch that drew nothing while B ALSO somehow drew nothing would
    # compare equal. Demand C painted too, against the same geometry-derived bar.
    var cpaint = 0;
    var ck = 0;
    while (ck < TLW * TLH) {
        if ((load32(&tl_c + ck * 4) & 0xFFFFFFFF) != 0xFF101010) { cpaint = cpaint + 1; }
        ck = ck + 1;
    }
    if (cpaint < expect * 3 / 4) {
        ps("    ⛔ the COL-MAJOR side painted only "); pn(cpaint); ps(" px where the geometry demands ");
        pn(expect); puts2(" -- the col-major comparison is vacuous");
        return 0 - 7;
    }
    var cbad = 0;
    var ci = 0;
    while (ci < TLW * TLH) {
        var gb2 = load32(&tl_b + ci * 4) & 0xFFFFFFFF;
        var gc = load32(&tl_c + ci * 4) & 0xFFFFFFFF;
        if (gb2 != gc) {
            cbad = cbad + 1;
            if (tx_dumped < 12) {
                tx_dumped = tx_dumped + 1;
                ps("    texl CM diff @ x="); pn(ci % TLW); ps(" y="); pn(ci / TLW);
                ps("  col="); pn((ci % TLW) / w);
                ps("  RM="); phex8(gb2); ps("  CM="); phex8(gc); nl();
            }
        }
        ci = ci + 1;
    }
    # ⛔ SEPARATE RANGES AND ROW-MAJOR FIRST — not a sum, and not col-major first.
    # Not a SUM, because a caller adding the two counts could not tell "the fused op is wrong" from
    # "the transpose is wrong", and those localise to completely different files.
    # ROW-MAJOR FIRST, because col-major is built ON row-major: if the fused op is already drawing
    # the wrong picture, the transpose being wrong too is derivative and fixing it would be wasted
    # work. This ordering is also what makes the col-major diagnosis in main() HONEST — it tells the
    # reader "the record build and the grid are already proven by the row-major arm passing", and
    # that sentence is only true because a non-zero `bad` returns here before cbad is ever reported.
    if (bad != 0) { return bad; }
    if (cbad != 0) { return 0 - 1000 - cbad; }
    return 0;
}

# ==================================================================================================
# RUNG 14 — THE OP-TO-OP SEAM: TWO op 0x0C records in ONE #92 array.
# ==================================================================================================
# ⛔⛔ WHAT THIS CATCHES, AND WHY THE EXISTING CASES CANNOT. Every case above issues op 0x0C as a
# ONE-OP #92 array, so gpo_execute_all's batch opens and closes around a single dispatch and the
# shared prep slot is never reused while the GPU is mid-read. That is the only shape rung 14 was
# ever tested in, and it is not the shape a DOOM frame has.
#
# THE DEFECT THIS IS THE REGRESSION FOR: GPU_TEXL_PREP_SUBOFF is ONE fixed
# 512-record array. gpo_execute_all sets gpu_batch_active across the WHOLE op array, and with it set
# gpu_blend_cov_run only QUEUES dwords and returns — no tail, no fence, no wait. So two op 0x0C
# records in one array run:
#     build list A into the prep slot  ->  queue A's dispatch (not executed yet)
#     build list B into THE SAME SLOT  ->  queue B's dispatch
#     ... one tail, and now BOTH dispatches read list B's records
# List A therefore draws list B's primitives at list B's origins — which lands in rect B, leaving
# rect A at the clear colour. It is rung 12's bug at the op-to-op seam rather than the
# primitive-to-primitive one, and per-primitive records did nothing about it.
#
# ⭐ THIS IS NOT A HYPOTHETICAL SHAPE. GPU_TEX_LIST_MAX is 512; a DOOM frame is ~640 wall columns.
# The frame rung 14b makes feasible CANNOT be one op — it is physically at least two.
#
# ⛔ THE TWO LISTS MUST DIFFER, OR THIS CASE PROVES NOTHING. If A and B were the same geometry at
# the same origin, B's records overwriting A's would draw the identical picture and the comparison
# would come back green on a broken kernel. So A is UNIFORM height at y0 and B is RAGGED at a
# disjoint y1: under the defect, rect A comes back entirely clear. [[feedback_echo_vs_answer]]
#
# ⚠ THE ORACLE IS THE SAME LIST DRAWN ALONE, not a model. Each list is first issued as its OWN #92
# call — separately fenced, the shape every green case above already proves correct — and read back.
# Then both are issued in ONE two-op array and read back again. The demand is zero differing bytes.
# A model would be a fresh thing to get wrong; "the same op, batched, must draw what it draws alone"
# is the entire property at issue and needs no new arithmetic.
#
# ⚠ NEGATIVE CONTROL: this case cannot be toggled from ring 3 — the fix is a kernel-side suspend, so
# there is no mutation switch to flip here. Its red-on-a-broken-kernel claim is a PREDICTION, stated
# in advance: on a kernel whose gpu_tex_list does not suspend gpu_batch_active, `seam A` reports
# ~3072 differing px (the whole rect, clear where it should be painted) and `seam B` reports 0.
# If this case ever goes red in exactly that pattern, the suspend has been lost — look there first.

var TL2_Y1 = 64;                # list B's top edge — disjoint from list A's rect at y = 8..56
var tl2_prims[384];             # list B's 32 x 96 B primitive array
var tl2_r1[1536];               # rect A, drawn by its OWN #92 call — the reference
var tl2_r2[1536];               # rect B, ditto
var tl2_g1[1536];               # rect A, drawn inside a TWO-OP array
var tl2_g2[1536];               # rect B, ditto
var tl2_bad1 = 0;
var tl2_bad2 = 0;

# tl_op0c — write one op 0x0C #92 record at `dst`. Factored out because the whole point of this case
# is that the two records differ ONLY in the slot id and the rect, so they must be built identically.
fn tl_op0c(dst, pid, x, y, np): i64 {
    var z = 0;
    while (z < 16) { store32(dst + z * 4, 0); z = z + 1; }
    store32(dst +  0, 12);                       # op 0x0C TEX_LIST
    store32(dst + 12, pid);
    store32(dst + 16, (TLH * 65536) + TLW);
    store32(dst + 20, (y * 65536) + x);
    store32(dst + 24, np);
    return 0;
}

fn tl2_cmp(refb, gotb, which): i64 {
    var bad = 0;
    var pi = 0;
    while (pi < TLW * TLH) {
        var ga = load32(refb + pi * 4) & 0xFFFFFFFF;
        var gb = load32(gotb + pi * 4) & 0xFFFFFFFF;
        if (ga != gb) {
            bad = bad + 1;
            if (tx_dumped < 16) {
                tx_dumped = tx_dumped + 1;
                ps("    seam list "); pn(which);
                ps(" diff @ x="); pn(pi % TLW); ps(" y="); pn(pi / TLW);
                ps("  alone="); phex8(ga); ps("  batched="); phex8(gb); nl();
            }
        }
        pi = pi + 1;
    }
    return bad;
}

# tl_painted — how many px of a readback are not the clear colour.
fn tl_painted(buf): i64 {
    var n = 0;
    var k = 0;
    while (k < TLW * TLH) {
        if ((load32(buf + k * 4) & 0xFFFFFFFF) != 0xFF101010) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

# tl_batch2 — the seam case. Returns 0, a positive total differing-byte count, or a negative code.
fn tl_batch2(): i64 {
    var x0 = 8;
    var y0 = 8;
    var y1 = TL2_Y1;
    var w  = tl_pw();
    tl2_bad1 = 0;
    tl2_bad2 = 0;

    var tid = syscall(86, 4096);
    var p1  = syscall(86, 4096);
    var p2  = syscall(86, 4096);
    if (tid < 1) { return 0 - 3; }
    if (p1 < 1) { return 0 - 3; }
    if (p2 < 1) { return 0 - 3; }
    syscall(72, tid, &tx_tex, TXD * TXD * 4);

    # A = uniform heights at y0.  B = RAGGED heights at y1. Different SHAPE and different ORIGIN, so
    # a record mix-up cannot render as the right picture by luck.
    tl_pack_prims_at(&tl_prims,  tid, 0, 0, x0, y0, 0, 0);
    tl_pack_prims_at(&tl2_prims, tid, 0, 0, x0, y1, 1, 0);
    syscall(72, p1, &tl_prims,  TL_NP * 96);
    syscall(72, p2, &tl2_prims, TL_NP * 96);

    # ---- REFERENCE: each list as its OWN #92 call, so each is separately fenced ----
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y0 * 65536) + x0) != 0) { return 0 - 4; }
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y1 * 65536) + x0) != 0) { return 0 - 4; }
    # ⛔ 64 BYTES, NOT 16. Cyrius FUNCTION-LOCAL `var X[N]` allocates N **BYTES** (module-scope is
    # N x u64). tl_op0c writes 16 dwords = 64 bytes, so `var o1[16]` was a 48-byte STACK SMASH.
    # ⚠ THIS COST AN IRON BURN: the seam case returned `the SOLO list-B call was REJECTED` on
    # 2026-07-27 because the overflow corrupted the neighbouring locals the SECOND record is built
    # from. Every 64-byte op record in this file is `var d[64]` / `var e[64]` for exactly this reason.
    var o1[64];
    tl_op0c(&o1, p1, x0, y0, TL_NP);
    if (syscall(92, &o1, 64) != 0) { return 0 - 201; }
    var o2[64];
    tl_op0c(&o2, p2, x0, y1, TL_NP);
    if (syscall(92, &o2, 64) != 0) { return 0 - 202; }
    if (tl_readback(&tl2_r1, x0, y0) != 0) { return 0 - 5; }
    if (tl_readback(&tl2_r2, x0, y1) != 0) { return 0 - 5; }

    # ⛔ VACUITY GUARD, BOTH RECTS. If neither list painted, every buffer is the clear colour and the
    # comparison below is 0 == 0 on a kernel that drew nothing at all. Expected = sum(pw*ph) per
    # list; demand three quarters, the same derived bar tl_run uses.
    var e1 = 0;
    var e2 = 0;
    var ek = 0;
    while (ek < TL_NP) {
        e1 = e1 + w * tl_ph(ek, 0);
        e2 = e2 + w * tl_ph(ek, 1);
        ek = ek + 1;
    }
    if (tl_painted(&tl2_r1) < e1 * 3 / 4) { return 0 - 6; }
    if (tl_painted(&tl2_r2) < e2 * 3 / 4) { return 0 - 7; }

    # ---- THE SEAM: both lists in ONE two-op array. len = 2 * GPU_OP_STRIDE = 128. ----
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y0 * 65536) + x0) != 0) { return 0 - 4; }
    if (syscall(88, 0xFF101010, (TLH * 65536) + TLW, (y1 * 65536) + x0) != 0) { return 0 - 4; }
    # ⛔ 128 BYTES: TWO 64-byte records. Same units trap as o1/o2 above.
    var q[128];
    tl_op0c(&q,      p1, x0, y0, TL_NP);
    tl_op0c(&q + 64, p2, x0, y1, TL_NP);
    var rq = syscall(92, &q, 128);
    if (rq != 0) {
        syscall(74, tid); syscall(74, p1); syscall(74, p2);
        return 0 - 300 - ((0 - rq) & 0xFF);
    }
    if (tl_readback(&tl2_g1, x0, y0) != 0) { return 0 - 5; }
    if (tl_readback(&tl2_g2, x0, y1) != 0) { return 0 - 5; }
    syscall(74, tid); syscall(74, p1); syscall(74, p2);

    tl2_bad1 = tl2_cmp(&tl2_r1, &tl2_g1, 1);
    tl2_bad2 = tl2_cmp(&tl2_r2, &tl2_g2, 2);
    return tl2_bad1 + tl2_bad2;
}

fn main(): i64 {
    puts2("gputex: RUNG 13 -- nearest-neighbour affine texturing via #92 op 0x0B");
    tx_build_tex();
    var exact = 0;
    var ran = 0;

    var i = 0;
    while (i < TXN) {
        var r = tx_run_case_f(i, 0, i, 0);
        ps("  case "); pn(i); ps(" "); tx_name(i); ps("  ");
        if (r == 0 - 1) { puts2("frame REJECTED by the reference"); }
        if (r == 0 - 2) { puts2("coverage capture FAILED -- the reference cannot be fed the GPU's input"); }
        if (r == 0 - 3) { puts2("slot allocation FAILED"); }
        if (r == 0 - 4) { puts2("fill_rect refused"); }
        if (r == 0 - 5) { puts2("#90 readback refused"); }
        if (r <= 0 - 100) { ps("op REJECTED, reason "); pn((0 - r) - 100); nl(); }
        if (r == 0) { puts2("EXACT"); exact = exact + 1; ran = ran + 1; }
        if (r > 0) { ps(""); pn(r); puts2(" differing px"); ran = ran + 1; }
        i = i + 1;
    }

    # ---- the IDX8 path, same frames through the LUT ------------------------------------
    var b = 0;
    while (b < 64) { store8(&tx_tex + b, b * 4); b = b + 1; }
    var idxexact = 0;
    var j = 0;
    while (j < TXN) {
        var r2 = tx_run_case_f(j, 1, j + 5, 0);
        ps("  IDX8 case "); pn(j); ps(" ");
        if (r2 == 0) { puts2("EXACT"); idxexact = idxexact + 1; }
        if (r2 != 0) { pn(r2); puts2(" (non-zero)"); }
        j = j + 1;
    }
    tx_build_tex();

    # ---- FULLCOV: identical pixels, one dispatch instead of three -------------------------
    # ⭐ THE GATE IS BYTE-IDENTITY, NOT "IT DREW SOMETHING". A flag that skips the coverage passes
    # must produce EXACTLY what the shaped path produces on a primitive that fills its rect;
    # anything less and the saving is bought with a wrong picture.
    # ⚠ Frame 0 is the 1:1 identity case, whose triangle covers only HALF the rect, so this is
    # deliberately compared against an all-255 reference rather than against frame 0's own output.
    puts2("gputex: FULLCOV -- coverage passes skipped; must be byte-identical to a 255 mask");
    var fcexact = 0;
    var fi = 0;
    while (fi < TXN) {
        var rf = tx_run_case_f(fi, 0, fi, 1);
        ps("  FULLCOV case "); pn(fi); ps(" ");
        if (rf == 0) { puts2("EXACT"); fcexact = fcexact + 1; }
        if (rf > 0) { pn(rf); puts2(" differing px"); }
        if (rf < 0) { ps("refused, code "); pn(0 - rf); nl(); }
        fi = fi + 1;
    }
    ps("gputex: FULLCOV "); pn(fcexact); ps(" of "); pn(TXN); puts2(" exact");

    # ---- WRAP: tiling, not saturation ---------------------------------------------------
    puts2("gputex: WRAP -- the texture must TILE; clamp would smear its last row");
    var wexact = 0;
    var wi = 0;
    while (wi < TXWN) {
        var rw = tx_run_wrap(wi, wi + 10);
        ps("  WRAP case "); pn(wi); ps(" "); txw_name(wi); ps("  ");
        if (rw == 0) { puts2("EXACT"); wexact = wexact + 1; }
        if (rw > 0) { pn(rw); puts2(" differing px"); }
        if (rw < 0) { ps("refused, code "); pn(0 - rw); nl(); }
        wi = wi + 1;
    }
    ps("gputex: WRAP "); pn(wexact); ps(" of "); pn(TXWN); puts2(" exact");

    # ---- RUNG 15: BILINEAR — byte-identity against the exact integer 4-tap reference --------
    # ⭐ RUN ON THE **CLAMP** PATH, DELIBERATELY. Both of rung 15's ordering traps — the `+1`
    # neighbour needing the pre-clamp floor, and the out-of-domain predicates needing to fire on both
    # taps — are INVISIBLE under mask-WRAP and total under CLAMP. A wrap-only arm would be the
    # comfortable choice and would prove the less interesting half. (Same shape as bimodel's M2
    # finding, which is now the third instance of this pattern in this rung.)
    #
    # ⛔⛔ THE DISCRIMINATION CHECK IS THE POINT OF THIS ARM, NOT AN EXTRA.
    # Byte-identity against the bilinear reference is necessary and NOT sufficient: if the kernel
    # silently dispatched the NEAREST blob — a wrong `bilin` flag, a slot that was never armed,
    # RSRC1_TEX where RSRC1_TEXBI belongs — then on any frame where the two filters happen to agree,
    # the arm would go green having proven nothing. So every case ALSO measures how far the GPU's
    # output sits from the NEAREST reference, and the run FAILS if that distance is zero everywhere.
    # ⚠⚠ FRAME 0 IS THE 1:1 IDENTITY CASE AND MUST REPORT `vs NEAREST: 0`. IT IS ASSERTED BELOW.
    # ⛔ THE ORIGINAL VERSION OF THIS COMMENT STATED A FALSE PREMISE and it is corrected here rather
    # than quietly rewritten: it said "fx = fy = 0, so bilinear MUST equal nearest". The CONCLUSION is
    # right; the mechanism is not. `tex_uv_at` samples at PIXEL CENTRES (px + 0.5), so at a 1:1
    # mapping every sample lands at fx = fy = **128**, a texel CENTRE — never 0. Bilinear equals
    # nearest there because the tent kernel is INTERPOLATING at texel centres, not because the
    # fraction vanishes. (Measured: tests/gpu/biprobe.cyr, 64 of 64 samples at fx = 128.)
    # ⭐ The first burn falsified this prediction — frame 0 reported 35 — and the prediction was
    # RIGHT: the filter was missing its half-texel bias. Turning it into a live assertion is what
    # makes that finding permanent instead of a log entry.
    puts2("gputex: BILINEAR -- 4-tap integer filter, CLAMP path; must match bicore byte for byte");
    var bexact = 0;
    var bdiscrim = 0;
    var bident = 0;      # frame 0 (1:1) must be IDENTICAL to nearest -- see the note above
    tx_bilin = 1;
    var bi = 0;
    while (bi < TXN) {
        var rb = tx_run_case_f(bi, 0, bi, 0);
        ps("  BILINEAR case "); pn(bi); ps(" "); tx_name(bi); ps("  ");
        if (rb == 0) { puts2("EXACT"); bexact = bexact + 1; }
        if (rb > 0) { pn(rb); puts2(" differing px"); }
        if (rb < 0) { ps("refused, code "); pn(0 - rb); nl(); }
        if (rb >= 0) {
            # Recompute the NEAREST reference over the SAME prep state and coverage mask that the
            # run just used, then measure the GPU's distance from it. tx_got still holds the readback.
            tx_bilin = 0;
            tx_ref_fill(bi, 0);
            tx_bilin = 1;
            var nd = 0;
            var p = 0;
            while (p < TXW * TXH) {
                var g = load32(&tx_got + p * 4) & 0xFFFFFFFF;
                var n = load32(&tx_ref + p * 4) & 0xFFFFFFFF;
                if (g != n) { nd = nd + 1; }
                p = p + 1;
            }
            bdiscrim = bdiscrim + nd;
            ps("      vs NEAREST: "); pn(nd); puts2(" px differ");
            # ⭐ THE 1:1 IDENTITY ASSERTION — the falsified prediction, made permanent.
            if (bi == 0) { if (nd != 0) { bident = bident + nd; } }
        }
        bi = bi + 1;
    }
    tx_bilin = 0;
    ps("gputex: BILINEAR "); pn(bexact); ps(" of "); pn(TXN);
    ps(" exact; "); pn(bdiscrim); puts2(" px separate it from nearest");

    # ---- RUNG 14: the SAME primitives, fused into ONE dispatch -------------------------------
    puts2("gputex: RUNG 14 -- 32 columns as 32 x op 0x0B vs 1 x op 0x0C, demanded byte-identical");
    var tlr = tl_run(0, 0);
    ps("  texl RGBA8  ");
    if (tlr == 0 - 3) { puts2("slot allocation FAILED"); }
    if (tlr == 0 - 4) { puts2("fill_rect refused"); }
    if (tlr == 0 - 5) { puts2("#90 readback refused"); }
    if (tlr == 0 - 6) { puts2("VACUOUS -- the 0x0B side drew nothing"); }
    if (tlr == 0 - 101) { puts2("the 0x0B warm-up was REJECTED"); }
    if (tlr == 0 - 7) { puts2("VACUOUS -- the COL-MAJOR side drew nothing"); }
    if (tlr == 0 - 220) { puts2("the COL-MAJOR warm-up was REJECTED"); }
    # ⚠ ORDER MATTERS: the col-major packing sits BELOW -1000, so the generic "op 0x0C REJECTED"
    # line has to exclude that range or it would report a byte mismatch as a reason code of 800.
    if (tlr <= 0 - 1000) { ps("COL-MAJOR differs from ROW-MAJOR in "); pn((0 - tlr) - 1000); puts2(" px"); }
    if (tlr <= 0 - 200) {
        if (tlr > 0 - 1000) { ps("op 0x0C REJECTED, reason "); pn((0 - tlr) - 200); nl(); }
    }
    if (tlr == 0) { puts2("IDENTICAL to 32 individual dispatches, and CM == RM"); }
    if (tlr > 0) { ps(""); pn(tlr); puts2(" differing px"); }

    var tli = tl_run(1, 0);
    ps("  texl IDX8   ");
    if (tli == 0) { puts2("IDENTICAL to 32 individual dispatches, and CM == RM"); }
    if (tli > 0) { ps(""); pn(tli); puts2(" differing px"); }
    if (tli <= 0 - 1000) { ps("COL-MAJOR differs from ROW-MAJOR in "); pn((0 - tli) - 1000); puts2(" px"); }
    if (tli < 0) {
        if (tli > 0 - 1000) { ps("failed, code "); pn(0 - tli); nl(); }
    }

    # ⭐ RAGGED HEIGHTS — the only case that fires the shader's `py >= ph` guard on hardware. The
    # grid is sized by the TALLEST column, so every shorter column's workgroups ARE launched for
    # rows it does not own. If the guard is missing they scribble down to the tallest column's
    # height, and the 0x0B side (which dispatches each column at its own height) will not.
    var tlg = tl_run(0, 1);
    ps("  texl ragged ");
    if (tlg == 0) { puts2("IDENTICAL — the py>=ph guard holds on iron, and CM == RM"); }
    if (tlg > 0) { ps(""); pn(tlg); puts2(" differing px — SUSPECT THE py>=ph GUARD"); }
    if (tlg <= 0 - 1000) { ps("COL-MAJOR differs from ROW-MAJOR in "); pn((0 - tlg) - 1000); puts2(" px"); }
    if (tlg < 0) {
        if (tlg > 0 - 1000) { ps("failed, code "); pn(0 - tlg); nl(); }
    }

    # ---- THE OP-TO-OP SEAM: two op 0x0C records in ONE #92 array -----------------------------
    puts2("gputex: RUNG 14 -- TWO op 0x0C in one #92 array; each must draw what it draws ALONE");
    var tlcm = 0;
    var tls = tl_batch2();
    ps("  texl seam   ");
    if (tls == 0 - 3) { puts2("slot allocation FAILED"); }
    if (tls == 0 - 4) { puts2("fill_rect refused"); }
    if (tls == 0 - 5) { puts2("#90 readback refused"); }
    if (tls == 0 - 6) { puts2("VACUOUS -- list A drew nothing even ALONE"); }
    if (tls == 0 - 7) { puts2("VACUOUS -- list B drew nothing even ALONE"); }
    if (tls == 0 - 201) { puts2("the SOLO list-A call was REJECTED"); }
    if (tls == 0 - 202) { puts2("the SOLO list-B call was REJECTED"); }
    if (tls <= 0 - 300) { ps("the TWO-OP array was REJECTED, reason "); pn((0 - tls) - 300); nl(); }
    if (tls == 0) { puts2("IDENTICAL batched and alone -- the prep slot survives the seam"); }
    if (tls > 0) {
        ps(""); pn(tls); ps(" differing px  (list A "); pn(tl2_bad1);
        ps(", list B "); pn(tl2_bad2); puts2(")");
    }

    syscall(84);
    puts2("gputex: presented -- the tiles above are ON SCREEN now");
    tx_bench();

    ps("gputex: RGBA8 "); pn(exact); ps(" of "); pn(TXN); ps(" exact; IDX8 ");
    pn(idxexact); ps(" of "); pn(TXN); puts2(" exact");

    if (tx_ndiff != 0) {
        ps("gputex: ⛔ PIXELS DIFFER -- "); pn(tx_ndiff); puts2(" total");
        puts2("gputex:   READ THE LOCATED DIFFS ABOVE. texmodel proves the algorithm at register");
        puts2("gputex:   widths and shader-blob proves the table matches the source, so the");
        puts2("gputex:   remaining suspects are the EMISSION and THIS TOOL -- in that order only");
        puts2("gputex:   because the tool's inputs are shared with the reference by construction.");
        return 85;
    }
    if (exact != TXN) { return 87; }
    if (idxexact != TXN) { return 87; }
    if (wexact != TXWN) {
        puts2("gputex: ⛔ WRAP did not match the reference. If `got` sits at texel 0 where `want`");
        puts2("gputex:   is at the FAR edge, the negative index is being clamped rather than");
        puts2("gputex:   AND-ed -- the shader took the clamp tail with the WRAP flag set.");
        return 87;
    }
    if (fcexact != TXN) {
        puts2("gputex: ⛔ FULLCOV did not reproduce the shaped path byte for byte -- the saving");
        puts2("gputex:   would be bought with a wrong picture. Refusing to report rung 13 green.");
        return 87;
    }
    if (bexact != TXN) {
        puts2("gputex: ⛔ BILINEAR did not match bicore's exact integer reference. The divider is");
        puts2("gputex:   NOT the suspect -- texgate gate 7 proves the reciprocal reproduces an exact");
        puts2("gputex:   divide across the whole 16.16 word, fraction bits included. Suspect, in");
        puts2("gputex:   order: (1) the +1 neighbour taken from the CLAMPED index instead of the");
        puts2("gputex:   pre-clamp floor; (2) an out-of-domain predicate applied to x0 but not x1;");
        puts2("gputex:   (3) a w10/w01 weight swap, which keeps the weight sum at 65536.");
        return 86;
    }
    # ⛔ THE ARM MUST BE ABLE TO TELL BILINEAR FROM NEAREST. Zero separation means every frame agreed
    # with the nearest reference, so a kernel that silently dispatched the rung-13 blob would have
    # scored a perfect green. A gate that cannot fail is not a gate.
    # ⛔⛔ THE 1:1 IDENTITY GATE — the pre-registered prediction the FIRST burn falsified.
    # A bilinear filter at exact 1:1 magnification reproduces the texture EXACTLY, because every
    # sample lands on a texel centre and the tent kernel is interpolating there. Frame 0 is that
    # mapping. The 1.56.29 burn reported 35 px differing and the filter was missing its half-texel
    # bias; this assertion is what stops that shipping green a second time.
    # ⚠ This is the ONLY iron check that compares against something other than the reference. Every
    # other line in this arm compares GPU to bicore, and a convention error SHARED by shader and
    # reference is invisible to all of them by construction -- which is exactly how it shipped.
    if (bident != 0) {
        ps("gputex: ⛔ BILINEAR at 1:1 differs from NEAREST in "); pn(bident); puts2(" px.");
        puts2("gputex:   At a 1:1 pixel-to-texel mapping every sample lands on a texel CENTRE, where");
        puts2("gputex:   an interpolating filter must return that texel untouched. This is the");
        puts2("gputex:   half-texel-bias defect the first 1.56.29 burn exposed -- check the two");
        puts2("gputex:   'v_add_u32 v23, 0xFFFF8000, v23' in tex_bilin.s and BI_HALF in bicore.cyr.");
        return 86;
    }
    if (bdiscrim == 0) {
        puts2("gputex: ⛔ BILINEAR output is IDENTICAL to nearest on every frame, so this arm cannot");
        puts2("gputex:   distinguish a working filter from one that was never dispatched. Either the");
        puts2("gputex:   corpus has no fractional sample (check txf's frames) or the kernel ran the");
        puts2("gputex:   NEAREST blob -- check gpu_tex_dispatch's bilin flag, GPU_TEXBI_SHADER_SUBOFF");
        puts2("gputex:   residency, and that RSRC1_TEXBI (not RSRC1_TEX) reached gpu_blend_cov_run.");
        return 86;
    }
    # ⛔ RUNG 14b's GATE COMES FIRST, and it must. A col-major mismatch is packed BELOW -1000, which
    # is also `!= 0`, so the row-major gate below would otherwise swallow it and print a diagnosis
    # pointing at gpu_texl_build when the row-major arm is provably fine. All three arms are checked
    # here because any of them can carry the packing.
    if (tlr <= 0 - 1000) { tlcm = 1; }
    if (tli <= 0 - 1000) { tlcm = 1; }
    if (tlg <= 0 - 1000) { tlcm = 1; }
    if (tlcm != 0) {
        puts2("gputex: ⛔ COL-MAJOR did not reproduce ROW-MAJOR byte for byte.");
        puts2("gputex:   The records differ in ONE BIT and the kernel does the transpose, so the");
        puts2("gputex:   texturing, the record build and the grid are all already proven by the");
        puts2("gputex:   row-major arm passing. Read the SHAPE of the diff:");
        puts2("gputex:   • wrong picture in COLUMNS, right in rows -> the x/y swap is PARTIAL;");
        puts2("gputex:     one of px/py still derives from the old axis (window B, tex_list_cm.s).");
        puts2("gputex:   • a sparse dotted line, one px per column -> the BOUNDS did not transpose");
        puts2("gputex:     (window P): lanes are bounded by pw where they should be bounded by ph.");
        puts2("gputex:   • correct only where ph <= 64 -> the multi-tile path; `tile` now indexes");
        puts2("gputex:     ROWS and the >= bound swapped from pw to ph incorrectly.");
        puts2("gputex:   • the AFFINE frame wrong (right pixels, wrong texels) -> the vertex x/y");
        puts2("gputex:     swap in gpu_texl_build, not the shader.");
        puts2("gputex:   texlist.cyr's MUT window P / MUT window B reproduce the first two on the");
        puts2("gputex:   HOST at zero burns — run it before flashing anything.");
        return 89;
    }

    # ⛔ RUNG 14's GATE. Zero differing bytes, both formats, or this does not ship. A fused op that
    # is merely CLOSE to 32 individual dispatches is a fused op that draws a different picture.
    if (tlr != 0) {
        puts2("gputex: ⛔ op 0x0C did not reproduce op 0x0B byte for byte (RGBA8).");
        puts2("gputex:   The texturing body is character-identical between the two shaders and");
        puts2("gputex:   gated as such, and texlist.cyr proves the grid mapping on the host. So");
        puts2("gputex:   the suspects are, in order: the record ARRAY build (gpu_texl_build), the");
        puts2("gputex:   tile_shift, and the per-primitive dst_off — not the texturing maths.");
        puts2("gputex:   A whole WRONG COLUMN points at the record index; scattered px do not.");
        return 88;
    }
    if (tlg != 0) {
        puts2("gputex: ⛔ op 0x0C diverged on RAGGED heights while matching uniform ones.");
        puts2("gputex:   That isolates it: the texturing and the record indexing are fine, and the");
        puts2("gputex:   `s_cmp_ge_u32 s9, s7 / s_cbranch_scc1 L_END` row guard is not holding.");
        puts2("gputex:   Expect the extra pixels BELOW each short column, down to the tallest.");
        return 88;
    }
    if (tli != 0) {
        puts2("gputex: ⛔ op 0x0C did not reproduce op 0x0B byte for byte (IDX8).");
        puts2("gputex:   RGBA8 matched, so the record build and grid are right and the LUT");
        puts2("gputex:   pointer is the difference — check the per-primitive lut_id resolution.");
        return 88;
    }
    # ⛔ THE OP-TO-OP SEAM GATE. A fused op that is correct alone and wrong when a second one follows
    # it in the same array is not correct — and two ops is the MINIMUM a DOOM frame needs, because
    # ~640 columns do not fit in one 512-primitive list.
    if (tls < 0) {
        puts2("gputex: ⛔ the two-op seam case could not run. It is the only case that exercises");
        puts2("gputex:   op 0x0C with the batch OPEN across two dispatches, so a green run without");
        puts2("gputex:   it does not cover the shape a DOOM frame actually has. Read the code above.");
        return 89;
    }
    if (tls != 0) {
        puts2("gputex: ⛔ op 0x0C does not survive being followed by a SECOND op 0x0C in one array.");
        puts2("gputex:   Every single-op case above passed, so the texturing, the record build, the");
        puts2("gputex:   grid and the ABI are all fine. The suspect is the SHARED PREP SLOT:");
        puts2("gputex:   GPU_TEXL_PREP_SUBOFF is one 512-record array and gpo_execute_all holds");
        puts2("gputex:   gpu_batch_active across the whole #92 array, so gpu_blend_cov_run returns");
        puts2("gputex:   WITHOUT a fence and list B's build overwrites records list A has not been");
        puts2("gputex:   read for yet. ⭐ THE SIGNATURE IS DIAGNOSTIC: list A wrong and list B clean");
        puts2("gputex:   means exactly that, and the fix is gpu_tex_list's suspend of");
        puts2("gputex:   gpu_batch_active around its dispatch -- the same 1.56.21 invariant");
        puts2("gputex:   gpu_tri_list carries. Check that it is still there before looking anywhere");
        puts2("gputex:   else. Both lists wrong is a DIFFERENT bug and none of the above applies.");
        return 89;
    }
    puts2("gputex: ⭐ RUNG 13 -- every rendered pixel byte-identical to texcore, both formats.");
    puts2("gputex: ⭐ RUNG 14 -- op 0x0C byte-identical to 32 individual op 0x0B dispatches.");
    puts2("gputex: ⭐ RUNG 14 -- and byte-identical again with a SECOND op 0x0C in the same array.");
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
