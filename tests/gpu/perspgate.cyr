# perspgate.cyr — RUNG 18's HOST GATE. Proves the reference is sound, and proves the corpus can tell
# perspective-correct interpolation apart from affine — BEFORE a shader exists.
#
# ⛔ THE ORDER MATTERS AND IT IS THE LESSON OF THE LAST TWO RUNGS. Rung 15 shipped a half-texel offset
# past four green agreement gates because every implementation carried the same wrong convention. Rung
# 17's order-independence oracle went GREEN on a completely wrong frame because a wave-uniform kernarg
# misread is deterministic. In both cases the corpus or the oracle could not SEE the defect, and that
# was discoverable on the host for free. So the first thing this file asserts is not correctness — it is
# that the figure DISCRIMINATES.

include "lib/io.cyr"
include "tricore.cyr"      # ps / pn / nl
include "perspcore.cyr"

# ⭐⭐ THE TEXTURED DISCRIMINATOR. P2 measures how far the AFFINE coordinate is from the perspective
# one; this measures how far the resulting TEXEL is, which is a different and smaller number — many
# differing coordinates land in the same checkerboard cell and sample the same colour.
# ⛔ CONFLATING THE TWO COST A BURN'S INTERPRETATION. gputri's --persp arm compares TEXELS, and its
# discriminator threshold was set from P2's coordinate figure of 1540/1541. The GPU came back byte-exact
# against the perspective reference (0 of 1541) and 731 from affine — correct in every way that matters,
# and the arm called it a failure because 731 < half of 1541. The shader was right; the threshold was
# derived from the wrong measurement.
# ⇒ this gate exists so the threshold has a MEASURED floor of its own.
var PG_TEXDIM = 256;
var pg_tex[32768];              # 256x256 x 4 B, matching gputri's checkerboard exactly

fn pg_checker(): i64 {
    var i = 0;
    while (i < PG_TEXDIM * PG_TEXDIM) {
        var tx = i % PG_TEXDIM;
        var ty = i / PG_TEXDIM;
        var c = 0xFF202020;
        if ((((tx >>> 4) + (ty >>> 4)) & 1) == 1) { c = 0xFFE0E0E0; }
        store32(&pg_tex + i * 4, c);
        i = i + 1;
    }
    return 0;
}

fn pg_fetch(u, v): i64 {
    var tx = (u >>> 16) & (PG_TEXDIM - 1);
    var ty = (v >>> 16) & (PG_TEXDIM - 1);
    return load32(&pg_tex + (ty * PG_TEXDIM + tx) * 4) & 0xFFFFFFFF;
}

fn pg_gate(name, ok): i64 {
    ps(name);
    if (ok == 1) { ps(" PASS"); nl(); return 0; }
    ps(" FAIL"); nl(); return 1;
}

fn main(): i64 {
    var bad = 0;
    ps("perspgate: rung 18 -- perspective-correct interpolation on the host"); nl(); nl();

    # ---- P1: the figure must actually DRAW. Two empty images agree on everything. ---------------
    pc_corpus_floor();
    var cov = pc_render();
    ps("P1  the floor quad covers pixels: "); pn(cov); ps(" of 4096: ");
    if (cov > 800) { ps("PASS"); nl(); }
    if (cov <= 800) { ps("FAIL -- too little coverage to measure anything"); nl(); bad = bad + 1; }

    # ---- P2 ⭐ THE DISCRIMINATOR. This is the gate that decides whether a burn can mean anything.
    # A shader that skips the divide produces the AFFINE answer. If that answer were close to the
    # perspective one on this figure, a green burn would be consistent with the divide never happening
    # — which is exactly the null-set trap rung 17's shipped corpus fell into (a one-ULP divide error
    # moved 0 of 1024 pixels there).
    var ad = pc_affine_diff();
    var adworst = pc_worst;   # ⚠ CAPTURED: later renders reset pc_worst, and a summary line
                              # reporting a stale 0 for the discriminator is worse than no summary.
    ps("P2  AFFINE vs PERSPECTIVE on this figure: "); pn(ad); ps(" of "); pn(cov);
    ps(" px differ, worst by "); pn(pc_worst); ps(" (16.16 units)"); nl();
    ps("    ⇒ a shader that skipped the divide would be wrong on that many pixels: ");
    if (ad > cov / 2) {
        if (pc_worst > 65536) { ps("PASS -- the figure DISCRIMINATES"); nl(); }
    }
    if (ad <= cov / 2) {
        ps("FAIL -- fewer than half the covered pixels move, so the corpus cannot tell"); nl();
        ps("    perspective-correct from affine and a green burn would prove nothing."); nl();
        bad = bad + 1;
    }
    if (ad > cov / 2) {
        if (pc_worst <= 65536) {
            ps("FAIL -- worst divergence is under one texel; visually indistinguishable"); nl();
            bad = bad + 1;
        }
    }

    # ---- P3: THE CONTROL. At CONSTANT w the two must agree EXACTLY. -----------------------------
    # ⛔ Without this, P2 is satisfied by a divide that perturbs everything it touches. P3 is what
    # separates "the perspective divide is doing real work" from "the perspective path is just wrong
    # in a way that happens to differ from affine".
    pc_corpus_flat();
    var cov2 = pc_render();
    var ad2 = pc_affine_diff();
    ps("P3  at CONSTANT w, affine and perspective agree exactly ("); pn(cov2);
    ps(" px covered, "); pn(ad2); ps(" differ): ");
    if (ad2 == 0) { ps("PASS -- the divide is not merely perturbing"); nl(); }
    if (ad2 != 0) {
        ps("FAIL "); pn(ad2); ps(" px differ where perspective is mathematically IDENTITY"); nl();
        bad = bad + 1;
    }

    # ---- P4: the widths, re-measured here rather than trusted from perspbits -------------------
    pc_corpus_floor();
    var cov4 = pc_render();                # ⚠ CAPTURED, not discarded: the widths below are maxima
                                           # over the covered pixels, and a render that covered none
                                           # reports max D = 0, which passes "D fits a lane".
    ps("P4  max N "); pn(pc_max_N); ps("  max D "); pn(pc_max_D);
    ps("  divide iterations per pixel "); pn(pc_iters / (pc_covered * 2)); nl();
    ps("    D fits a 32-bit lane (needs <= 2147483647): ");
    if (pc_max_D <= 2147483647) { ps("PASS"); nl(); }
    if (pc_max_D > 2147483647) { ps("FAIL"); nl(); bad = bad + 1; }
    ps("    N does NOT (it is a register PAIR in the shader): ");
    if (pc_max_N > 2147483647) { ps("PASS -- confirmed, as perspbits measured"); nl(); }
    if (pc_max_N <= 2147483647) {
        ps("⚠ N fits after all -- perspbits' 64-bit conclusion needs re-deriving"); nl();
        bad = bad + 1;
    }

    # ---- P5 ⭐ THE EXTERNAL INVARIANT, and it needs NO TOLERANCE ------------------------------
    # ⛔ THE FIRST VERSION OF P5 WAS A GATE DEFECT AND IS WORTH RECORDING. It walked outward from each
    # vertex and compared the interpolant to that vertex's own attribute — sound in principle, but it
    # took the first covered pixel in SCAN order rather than the nearest, so it could land 6 px away;
    # and near the far edge u spans 256 texels over ~16 screen pixels, i.e. ~16 texels PER PIXEL, so a
    # 6-px miss is ~96 texels against a 16-texel tolerance. It failed 2 of 6 for reasons that had
    # nothing to do with the reference. ⚠ The fix is NOT a looser tolerance — loosening a failing
    # external gate is the one move that destroys its purpose. It is an invariant with no tolerance.
    #
    # ⭐ CONSTANT ATTRIBUTE AT ALL THREE VERTICES ⇒ that value at EVERY covered pixel, for ANY w's,
    # because the weights sum to the denominator identically. Fixed by the definition of interpolation,
    # so a wrong hoist, a wrong reciprocal, a wrong divide, or a shared convention error all break it —
    # and it is checked EXACTLY, not within a slack.
    var C = pc_corpus_constattr();
    var cov3 = pc_render();
    var p5bad = 0;
    var n5 = 0;                 # ⛔ covered px actually COMPARED against C -- spent by the floor at
    var n5scan = 0;             #    the bottom of main(), where the reason is written down
    var i5 = 0;
    while (i5 < PC_W * PC_H) {
        n5scan = n5scan + 1;
        if (load64(&pc_cov + i5 * 8) == 1) {
            n5 = n5 + 1;
            if (load64(&pc_u + i5 * 8) != C) { p5bad = p5bad + 1; }
            if (load64(&pc_v + i5 * 8) != C) { p5bad = p5bad + 1; }
        }
        i5 = i5 + 1;
    }
    ps("P5  EXTERNAL: a constant attribute reproduces EXACTLY at all "); pn(cov3);
    ps(" covered px, under a 16:1 w ratio: ");
    if (p5bad == 0) {
        if (cov3 > 800) { ps("PASS"); nl(); }
    }
    if (p5bad != 0) { ps("FAIL "); pn(p5bad); ps(" px"); nl(); bad = bad + 1; }
    if (p5bad == 0) {
        if (cov3 <= 800) { ps("FAIL -- too little coverage"); nl(); bad = bad + 1; }
    }

    # ---- P6: the divide obligation, on REAL render data, by multiplication only -----------------
    pc_corpus_floor();
    var cov6 = pc_render();                # ⚠ CAPTURED: pc_obl_bad == 0 is exactly what a render
                                           # that drew NOTHING also reports. See the floor below.
    ps("P6  q*D <= N < (q+1)*D on every drawn pixel (by MULTIPLICATION, never a second divide): ");
    if (pc_obl_bad == 0) { ps("PASS"); nl(); }
    if (pc_obl_bad != 0) { ps("FAIL "); pn(pc_obl_bad); ps(" violations"); nl(); bad = bad + 1; }

    # ---- P7 ⭐ THE TEXTURED DISCRIMINATOR, which is what gputri's arm actually compares ----------
    pc_corpus_floor();
    var cov7 = pc_render();
    pg_checker();
    var texdiff = 0;
    var n7 = 0;
    var n7scan = 0;
    var i7 = 0;
    while (i7 < PC_W * PC_H) {
        n7scan = n7scan + 1;
        if (load64(&pc_cov + i7 * 8) == 1) {
            n7 = n7 + 1;
            var tp = pg_fetch(load64(&pc_u + i7 * 8), load64(&pc_v + i7 * 8));
            var ta = pg_fetch(load64(&pc_ua + i7 * 8), load64(&pc_va + i7 * 8));
            if (tp != ta) { texdiff = texdiff + 1; }
        }
        i7 = i7 + 1;
    }
    ps("P7  TEXTURED divergence: perspective vs affine sample DIFFERENT texels at ");
    pn(texdiff); ps(" of "); pn(n7); ps(" covered px"); nl();
    ps("    ⇒ this, NOT P2's coordinate figure, is the floor gputri's discriminator must use: ");
    if (texdiff > n7 / 4) { ps("PASS"); nl(); }
    if (texdiff <= n7 / 4) {
        ps("FAIL -- fewer than a quarter of texels move, so a textured burn cannot discriminate"); nl();
        bad = bad + 1;
    }
    ps("    ⚠ P2 measured "); pn(ad); ps(" COORDINATES differing and only "); pn(texdiff);
    ps(" TEXELS -- the gap is"); nl();
    ps("    the checkerboard cell size, and mistaking one for the other misreads a correct burn."); nl();

    nl();
    # ⛔ IN-ORACLE NON-VACUITY FLOOR. WHAT IT CATCHES: a gate that reports PASS having examined
    # NOTHING. Every property above passes by finding ZERO counter-examples -- `ad2 == 0` at P3,
    # `p5bad == 0` at P5, `pc_obl_bad == 0` at P6 -- and zero is precisely what an EMPTY gate
    # reports. Zero a corpus so it draws no pixel, edit a loop bound to 0, #ifdef a body out, or
    # let a shared helper stop storing coverage, and every one of those counters stays 0, `bad`
    # stays 0, and this file prints the same "Pn ... PASS" lines it prints on a healthy run.
    # cpuref.cyr's cases_ok / lit_fail pair is the model: count what was DONE, not only what was
    # WRONG, and refuse to report success over an empty count.
    # ⛔ WHY THE EXTERNAL FLOOR CANNOT SEE IT: scripts/check/host-gpu-oracles.sh weighs this oracle
    # by how many lines it printed (perspgate:12 against 18 healthy). Every "Pn" verdict above is
    # printed OUTSIDE the render or the loop that computes it, so gutting the work leaves the
    # printed line count UNTOUCHED and the runner scores the vacuous run green -- its own header
    # says so and names this file among the still-unfloored. Measured: gutting P5's comparison
    # loop left the output at all 18 lines and exit 95. Only a count taken where the work happens
    # sees that, which is why this floor lives here and not there.
    # ⚠ THE MINIMA ARE THIS FILE'S OWN MEASUREMENTS, NOT CHOSEN NUMBERS. P3/P4/P5/P6/P7 all
    # re-render a corpus whose SCREEN GEOMETRY is identical to P1's floor quad -- pc_corpus_flat,
    # pc_corpus_constattr and pc_corpus_floor carry the same four vertices (0,63) (63,63) (40,24)
    # (24,24) and differ only in w and the attributes -- so each must cover AT LEAST the `cov` P1
    # measured, and P1 already gates `cov` above at > 800. The scan floors are the loop bounds
    # themselves. `<`, never `!=`, so a widened corpus can never false-fire.
    # ⚠ P1/P2/P7's own verdicts are already self-flooring and are NOT repeated here: P1 demands
    # cov > 800, P2 demands ad > cov/2 (so > 400 real divergences), and P7's `texdiff > n7/4` is
    # false at n7 == 0. P3, P4, P5 and P6 had no such floor, and P5's is the hole with no second
    # line of defence at all.
    var vac = 0;
    if (cov2 < cov) {
        ps("P3  ** VACUOUS: covered "); pn(cov2); ps(" px, not the "); pn(cov);
        ps(" P1 measured on the SAME screen geometry -- 'affine and perspective agree exactly'");
        nl(); ps("    is what two empty images also report."); nl(); vac = vac + 1;
    }
    if (cov4 < cov) {
        ps("P4  ** VACUOUS: covered "); pn(cov4); ps(" px, not the "); pn(cov);
        ps(" P1 measured -- max D and max N are maxima over the drawn pixels, and"); nl();
        ps("    'D fits a 32-bit lane' is trivially true of a D that was never computed."); nl();
        vac = vac + 1;
    }
    if (n5scan < PC_W * PC_H) {
        ps("P5  ** VACUOUS: walked "); pn(n5scan); ps(" pixels, not PC_W*PC_H = ");
        pn(PC_W * PC_H); nl(); vac = vac + 1;
    }
    if (n5 < cov3) {
        ps("P5  ** VACUOUS: compared "); pn(n5); ps(" of the "); pn(cov3);
        ps(" covered px against the constant attribute --"); nl();
        ps("    the EXTERNAL invariant is the strongest claim in this file and it checked nothing.");
        nl(); vac = vac + 1;
    }
    if (cov6 < cov) {
        ps("P6  ** VACUOUS: covered "); pn(cov6); ps(" px, not the "); pn(cov);
        ps(" P1 measured -- the divide obligation was discharged on no pixel."); nl();
        vac = vac + 1;
    }
    if (n7scan < PC_W * PC_H) {
        ps("P7  ** VACUOUS: walked "); pn(n7scan); ps(" pixels, not PC_W*PC_H = ");
        pn(PC_W * PC_H); nl(); vac = vac + 1;
    }
    if (n7 < cov7) {
        ps("P7  ** VACUOUS: fetched "); pn(n7); ps(" of the "); pn(cov7);
        ps(" covered px through the checkerboard."); nl(); vac = vac + 1;
    }
    if (vac != 0) {
        ps("perspgate: FAIL -- "); pn(vac); ps(" gate(s) reported PASS having examined NOTHING.");
        nl();
        ps("           A gate that finds no counter-example because it looked at none is not a");
        nl();
        ps("           gate, and the line-count floor outside cannot tell the two apart.");
        nl();
        return 90;
    }
    if (bad == 0) {
        ps("perspgate: PASS -- the figure DISCRIMINATES perspective from affine ("); pn(ad);
        ps(" px, worst "); pn(adworst); ps("),"); nl();
        ps("           constant-w is exact identity, the widths are as measured, a CONSTANT attribute"); nl();
        ps("           reproduces exactly under 16:1 perspective, and the divide meets its obligation"); nl();
        ps("           by multiplication on every drawn pixel."); nl();
        return 95;
    }
    ps("perspgate: FAIL -- "); pn(bad); ps(" propert(ies) broken; do NOT write the shader yet."); nl();
    return 90;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
