# depthcore.cyr — RUNG 17's CPU reference: depth-tested triangle rasterisation, TILE-SERIALISED.
#
# ⭐ THIS IS THE ORACLE. The shader is measured against it. Same three-file split rungs 9b/11/13/15
# earned: the reference states WHAT the answer is, the model reproduces it at 32-bit register widths,
# the shader reproduces the model.
#
# ⚠ INCLUDABLE MODULE, NO main(). Cyrius shadows duplicate `fn` silently (last-def-wins, warn only),
# so a consumer that includes a file carrying its own main() runs the WRONG one and still exits 0.
# That cost a real debugging session on rung 11.
#
# ============================================================================================
# THE ALGORITHM IS THE SHADER'S, NOT A CONVENIENT EQUIVALENT
# ============================================================================================
# gpu.md's rung-17 row specifies: *one workgroup owns an 8x8 tile and processes that tile's triangle
# list IN SUBMISSION ORDER IN A SINGLE WAVE, holding colour + depth in VGPRs across the loop, one
# `global_store` at the end.* So the reference is written the same way — an outer loop over PIXELS,
# an inner loop over TRIANGLES in submission order, with colour and z as per-pixel scalars that live
# across the inner loop and are written once at the end.
#
# ⛔ IT WOULD HAVE BEEN EASIER TO WRITE THE LOOPS THE OTHER WAY ROUND (per triangle, over pixels) and
# it would give the same answer for this corpus. It is deliberately NOT written that way: the whole
# claim of rung 17 is that per-tile serialisation makes the result deterministic WITHOUT atomics, and
# a reference whose loop structure differs from the shader's cannot witness that claim — it would
# agree for reasons the shader does not share.
#
# ============================================================================================
# ⛔⛔ Z-TIES ARE ORDER-DEPENDENT, AND THAT IS TRUE OF REAL HARDWARE TOO. READ THIS BEFORE
#     TRUSTING THE ORDER-INDEPENDENCE GATE.
# ============================================================================================
# The depth test is a STRICT `<` (nearer wins, smaller z is nearer). At a pixel where two triangles
# interpolate to EXACTLY the same z, the FIRST submitted wins, because the second's `z < zbuf` is
# false. With `<=` the LAST would win. **Either way a tie is decided by submission order.**
#
# ⇒ "Two interpenetrating triangles in both orders produce byte-identical output" is therefore NOT a
# universal truth — it holds only where every covered pixel has a STRICTLY unique nearest z. A corpus
# that happened to contain a tie would make the rung-17 oracle fail against a *correct* shader, and
# the burn would be spent chasing a defect that is not there.
#
# ⭐ So `dc_render` COUNTS TIE PIXELS (`dc_ties`) and the gate asserts that count is ZERO before it
# trusts the order-independence result. The corpus is proven fair rather than assumed fair.

include "lib/io.cyr"

var DC_MAXTRI = 16;
var DC_W = 32;
var DC_H = 32;

# Per triangle: x0 y0 z0 x1 y1 z1 x2 y2 z2 colour = 10 slots. Screen coords are INTEGER pixels;
# z is an integer depth, larger = farther, matching a conventional z-buffer.
var DC_STRIDE = 10;
var dc_tri[160];                 # DC_MAXTRI * DC_STRIDE, i64 each
var dc_n = 0;

var dc_cbuf[512];                # 32*32 u32 colour
var dc_zbuf[512];                # 32*32 u32 depth
var dc_ties = 0;                 # pixels where two triangles interpolated to EXACTLY equal z
# ⭐ How many times the winding normalisation actually FIRED. Without it, "the normalisation is
# correct" and "the normalisation is dead code" produce the identical green -- and on the shipped
# corpus it IS dead code, because both triangles wind positive (areas 2688 and 2704). Same doctrine
# as depthdiv's correction-fire count and rung 9b's clamp-hit counter.
var dc_wind_flips = 0;

# ⭐ THE RENDER WINDOW'S ORIGIN, in screen pixels. `dc_render` walks a w x h window whose top-left
# screen pixel is (dc_ox, dc_oy); the sample point is the SCREEN pixel centre, so the arithmetic sees
# real screen coordinates while the buffer stays 32x32. This is what makes the OFF-ORIGIN frame
# possible without a 700-pixel-wide buffer, and it mirrors the shipping shader exactly: `dstxy` is
# folded into the constant terms CPU-side and the shader works in draw-local coordinates (plan 4.2.3).
# ⚠ Left at 0/0 by every other frame; a frame that sets it MUST put it back.
var dc_ox = 0;
var dc_oy = 0;

# ---- ABI mirror constants -----------------------------------------------------------------------
# ⚠ MIRRORED, NOT INCLUDED — a host test cannot include a kernel module, which is the same situation
# `scripts/check/rt-region-derive.sh` exists to police for the TD-3 region. These three do NOT exist
# in the kernel yet (they land with `gpo_validate_tridepth` at plan bite B5). **When B5 lands, wire
# them into a derive gate in the same edit** — a mirror nobody diffs certifies the old value forever.
var DC_ZMAX       = 16777215;    # GPU_TRID_Z_MAX      2^24-1, the largest legal per-vertex z
var DC_ZCLEAR_MIN = 16777216;    # GPU_TRID_ZCLEAR_MIN 2^24,   every far value must exceed every legal z
var DC_ZCLEAR_HW  = 4294967295;  # what gpudepth.cyr actually burns, and what the shader will compare against

fn dc_reset(): i64 { dc_n = 0; dc_ties = 0; return 0; }

fn dc_set(t, i, v): i64 { store64(&dc_tri + (t * DC_STRIDE + i) * 8, v); return 0; }
fn dc_get(t, i): i64 { return load64(&dc_tri + (t * DC_STRIDE + i) * 8); }

fn dc_add(x0, y0, z0, x1, y1, z1, x2, y2, z2, colour): i64 {
    if (dc_n >= DC_MAXTRI) { return 0; }
    var t = dc_n;
    dc_set(t, 0, x0); dc_set(t, 1, y0); dc_set(t, 2, z0);
    dc_set(t, 3, x1); dc_set(t, 4, y1); dc_set(t, 5, z1);
    dc_set(t, 6, x2); dc_set(t, 7, y2); dc_set(t, 8, z2);
    dc_set(t, 9, colour);
    dc_n = dc_n + 1;
    return 1;
}

# dc_edge — the standard edge function, evaluated in DOUBLED pixel-centre coordinates so the +0.5 is
# exact in integers: a pixel centre at (px + 0.5) becomes (2*px + 1) with every vertex doubled.
# ⚠ This is the same texel/pixel-centre convention rung 13 fixed and rung 15's half-texel bug came
# from getting wrong on the OTHER side. Doubling keeps it exact rather than approximately right.
fn dc_edge(ax, ay, bx, by, pxq, pyq): i64 {
    return (bx - ax) * (pyq - ay) - (by - ay) * (pxq - ax);
}

# dc_render — the tile-serialised reference. Renders the CURRENT triangle list into cbuf/zbuf.
# `zclear` is the far value; `bg` the background colour. Returns the number of pixels written.
#
# ⚠ PIXELS ARE THE OUTER LOOP AND TRIANGLES THE INNER ONE — see the header. Colour and z live in
# `pc`/`pz` across the whole triangle list and are stored ONCE, mirroring "hold in VGPRs, one
# global_store at the end".
fn dc_render(w, h, zclear, bg): i64 {
    var written = 0;
    dc_ties = 0;
    dc_wind_flips = 0;
    var py = 0;
    while (py < h) {
        var px = 0;
        while (px < w) {
            # doubled pixel centre, in SCREEN coordinates -- the window origin is added here so the
            # edge/depth arithmetic sees the real screen position (see dc_ox).
            var pxq = 2 * (dc_ox + px) + 1;
            var pyq = 2 * (dc_oy + py) + 1;
            var pz = zclear;
            var pc = bg;
            var t = 0;
            while (t < dc_n) {
                var ax = 2 * dc_get(t, 0); var ay = 2 * dc_get(t, 1);
                var bx = 2 * dc_get(t, 3); var by = 2 * dc_get(t, 4);
                var cx = 2 * dc_get(t, 6); var cy = 2 * dc_get(t, 7);
                var w0 = dc_edge(bx, by, cx, cy, pxq, pyq);
                var w1 = dc_edge(cx, cy, ax, ay, pxq, pyq);
                var w2 = dc_edge(ax, ay, bx, by, pxq, pyq);
                var area = w0 + w1 + w2;
                # ---- ⭐ WINDING NORMALISATION (plan 2.5, landed at bite B3) --------------------
                # A clockwise triangle has area < 0 and all three edge functions <= 0 inside it. The
                # shader CANNOT carry that second case: every reciprocal path requires area > 0, and
                # `R = floor(2^32/area)` on a negative area is meaningless. So the sign is normalised
                # once per triangle -- negate the three edge values and the area together -- and the
                # inside test collapses to a single uniform `w_i >= 0`.
                # ⭐ EXACT, not approximately equivalent: negating both numerator and denominator
                # leaves `zn/area` unchanged, and inside the triangle `zn >= 0` and `area > 0`, so
                # truncation and floor agree. The rendered image must therefore be BYTE-IDENTICAL to
                # the two-branch form -- which is what makes this a safe restructuring rather than a
                # behavioural change, and D9 proves it on a frame where the flip actually fires.
                if (area < 0) {
                    w0 = 0 - w0; w1 = 0 - w1; w2 = 0 - w2; area = 0 - area;
                    dc_wind_flips = dc_wind_flips + 1;
                }
                # ⚠ REJECT DEGENERATE TRIANGLES rather than dividing by zero. A zero-area triangle
                # covers nothing; silently skipping it is the correct raster answer, and the guard
                # has to exist because the corpus is allowed to contain one. `area > 0` below is the
                # guard: after normalisation the only remaining bad case is exactly zero.
                var inside = 0;
                if (area > 0) {
                    if (w0 >= 0) { if (w1 >= 0) { if (w2 >= 0) { inside = 1; } } }
                }
                if (inside == 1) {
                    # ⭐ EXACT integer barycentric interpolation of z. The reference divides exactly;
                    # the model will show what the shader does at register widths. Rounding is
                    # TRUNCATION toward zero via the plain divide, and the model must match it.
                    var zn = w0 * dc_get(t, 2) + w1 * dc_get(t, 5) + w2 * dc_get(t, 8);
                    var z = zn / area;
                    # ⛔ STRICT `<`: nearer wins, and a TIE keeps the incumbent (i.e. the EARLIER
                    # triangle). Ties are therefore order-dependent -- counted, not hidden.
                    if (z == pz) { dc_ties = dc_ties + 1; }
                    if (z < pz) { pz = z; pc = dc_get(t, 9); }
                }
                t = t + 1;
            }
            store32(&dc_cbuf + (py * w + px) * 4, pc & 0xFFFFFFFF);
            store32(&dc_zbuf + (py * w + px) * 4, pz & 0xFFFFFFFF);
            written = written + 1;
            px = px + 1;
        }
        py = py + 1;
    }
    return written;
}

# dc_snapshot / dc_diff — copy the colour buffer aside and compare, so two submission orders can be
# rendered and byte-compared without a second render target in the caller.
var dc_snap[512];

fn dc_snapshot(w, h): i64 {
    var i = 0;
    while (i < w * h) { store32(&dc_snap + i * 4, load32(&dc_cbuf + i * 4)); i = i + 1; }
    return 0;
}

fn dc_diff(w, h): i64 {
    var d = 0;
    var i = 0;
    while (i < w * h) {
        var a = load32(&dc_snap + i * 4) & 0xFFFFFFFF;
        var b = load32(&dc_cbuf + i * 4) & 0xFFFFFFFF;
        if (a != b) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

# dc_covered — how many pixels the current buffer differs from the background, so a gate can prove
# the corpus actually DREW something. ⛔ Two of rung 9b's twenty cases have an all-zero correct
# answer, and a shader that writes nothing reproduces them byte-exactly; the same trap applies here.
fn dc_covered(w, h, bg): i64 {
    var c = 0;
    var i = 0;
    while (i < w * h) {
        if ((load32(&dc_cbuf + i * 4) & 0xFFFFFFFF) != (bg & 0xFFFFFFFF)) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# ============================================================================================
# ⭐ THE SHARED CORPUS — ONE DEFINITION, consumed by BOTH depthgate and depthmodel.
# ============================================================================================
# ⛔ IT WAS DUPLICATED IN BOTH FILES UNTIL 2026-07-28, and that is the ATOM_DRY defect class this
# tree keeps paying for: two artifacts differing in name but not in intent. The failure mode is
# specific and nasty — the MODEL would be validated against one pair of triangles while the GATE
# proved order-independence for a different pair, and both would be green. Nothing would report it,
# because each file is internally consistent.
# ⚠ These coordinates are load-bearing, not arbitrary: red slopes near->far left-to-right, blue the
# opposite, so they CROSS in depth. depthgate's D0c asserts both win somewhere — a pair where one
# wholly occludes the other makes depth indistinguishable from painter's order and proves nothing.
var DC_BG   = 0xFF101010;
var DC_FAR  = 1000000;
var DC_RED  = 0xFFFF0000;
var DC_BLUE = 0xFF0000FF;

# dc_corpus(swap) — the interpenetrating pair, in submission order `swap`.
fn dc_corpus(swap): i64 {
    dc_reset();
    if (swap == 0) {
        dc_add(2, 2, 100,  28, 4, 900,  4, 28, 100, DC_RED);
        dc_add(2, 4, 900,  28, 2, 100,  28, 28, 900, DC_BLUE);
    }
    if (swap != 0) {
        dc_add(2, 4, 900,  28, 2, 100,  28, 28, 900, DC_BLUE);
        dc_add(2, 2, 100,  28, 4, 900,  4, 28, 100, DC_RED);
    }
    return 0;
}

# dc_corpus_coplanar(swap) — the SAME two shapes at a single constant z, so every overlapping pixel
# is a TIE. depthgate's D2 uses it to prove order-independence CAN fail; ties are resolved by
# submission order on any correct implementation, so this pair must differ between the two orders.
fn dc_corpus_coplanar(swap): i64 {
    dc_reset();
    if (swap == 0) {
        dc_add(2, 2, 500,  28, 4, 500,  4, 28, 500, DC_RED);
        dc_add(2, 4, 500,  28, 2, 500,  28, 28, 500, DC_BLUE);
    }
    if (swap != 0) {
        dc_add(2, 4, 500,  28, 2, 500,  28, 28, 500, DC_BLUE);
        dc_add(2, 2, 500,  28, 4, 500,  4, 28, 500, DC_RED);
    }
    return 0;
}

# ==================================================================================================
# ⭐⭐ THREE MORE FRAMES, ADDED 2026-07-29 — BECAUSE THE SHIPPED CORPUS IS A MEASURED NULL SET FOR
#     THE PROPERTY RUNG 17 DECLARES LOAD-BEARING.
# ==================================================================================================
# The pair above has a z gradient of ~31 units per pixel while the whole design argues about being
# exact to ONE unit. Those two numbers cannot both matter, and the measurement agrees: a divide one
# ULP short changes **0 of 1024 pixels** on it. Three independent adversarial passes put a whole
# table of broken implementations through this corpus and every one came out byte-identical:
#
#   broken implementation                      orderdiff   colour vs ref   z wrong
#   divide one ULP short (4 models)                0        0 of 1024        --
#   R2 with the correction dropped                 0        0                19 px
#   rung-13 transplant, correction dropped         0        0                92 px
#   uniform bias z -= k, any k in 1..64            0        0                507/507
#   tile list walked BACKWARDS                     0        0                0
#
# ⛔ AND THE LAST ROW IS THE WORST ONE. `dc_ties == 0` (D0a) IS order-invariance -- so "the shader
# processes the list in SUBMISSION ORDER", which is the entire claim of tile-serialisation, is
# currently tested by NOTHING. A shader walking the list backwards passes every gate in this tree.
#
# ⛔ The two properties are also MUTUALLY EXCLUSIVE on one frame (measured sweep of z-separation
# 800 -> 1): every separation where a 1-ULP error becomes visible also has `dc_ties > 0`, which fails
# D0a and fires D1 for a *correct* shader. ⇒ separate frames, each with its own gate, not one frame
# asked to do both jobs.

# dc_corpus_precision(swap) — THE SAME GEOMETRY with the z span crushed from 800 to **2**, so one
# unit of z is a large fraction of the whole range and a one-ULP divide error is visible.
# ⚠ IT HAS TIES BY CONSTRUCTION, so it is **not** an order oracle. Render it in ONE fixed order.
#
# ⭐⭐ THE SPAN IS 2 BECAUSE OF A MEASURED SWEEP, NOT BECAUSE TIGHTER IS BETTER. Sensitivity to a
# one-ULP error is **NOT MONOTONE** in the span, and the failure at the tight end is silent:
#
#     span    ties   px flipped by a +1 ULP error on one triangle
#        1     182     0     <- ⛔ EVERY shared pixel ties; the strict `<` hands them all to the
#        2      49    42        incumbent either way, so the frame is blind AGAIN, for the opposite
#        3      41    24        reason. "Crush the span as tight as possible" lands exactly here.
#        4      40    20
#        8      18    12
#      800       0     0     <- the shipped corpus: the measured null set, reproduced in-tree
#
# ⇒ 2 is the peak, and BOTH neighbours are worse. ⭐ That is not left as a comment: depthgate's D0d
# re-runs the two endpoints of this table every time and asserts the chosen span beats both, so a
# later retune cannot quietly land on either null set. Parameterised for exactly that reason.
var DC_PREC_SPAN = 2;

fn dc_corpus_precision_span(span, swap): i64 {
    var hi = 100 + span;
    dc_reset();
    if (swap == 0) {
        dc_add(2, 2, 100,  28, 4, hi,   4, 28, 100, DC_RED);
        dc_add(2, 4, hi,   28, 2, 100,  28, 28, hi,  DC_BLUE);
    }
    if (swap != 0) {
        dc_add(2, 4, hi,   28, 2, 100,  28, 28, hi,  DC_BLUE);
        dc_add(2, 2, 100,  28, 4, hi,   4, 28, 100, DC_RED);
    }
    return 0;
}

fn dc_corpus_precision(swap): i64 { return dc_corpus_precision_span(DC_PREC_SPAN, swap); }

# dc_corpus_quad(swap) — TWO TRIANGLES SHARING A DIAGONAL, the quad (4,4)-(27,4)-(27,27)-(4,27) split
# corner-to-corner. Vertex z: (4,4)=100 (27,4)=300 (27,27)=500 (4,27)=300.
#
# ⭐ THIS IS THE ONLY WITNESS THAT THE TRIANGLE LIST IS WALKED IN SUBMISSION ORDER, and it is not an
# academic construction: `dc_render` has **no top-left fill rule** (line 114 is a bare `w >= 0`), so
# BOTH triangles of a split quad cover the shared diagonal, and along that diagonal they interpolate
# to IDENTICAL z because both interpolate linearly between the same two endpoint depths. Every shared
# edge in every real mesh -- rung 18's checkerboard floor, every DOOM wall -- is an exact tie decided
# by list order. ⇒ the two orders MUST differ, and each must match the reference rendered in that
# same order. That is what separates *a reversed list* (a 3-line prep bug) from *a broken serialiser*
# (TD-5, a much larger bite) when the burn comes back wrong.
fn dc_corpus_quad(swap): i64 {
    dc_reset();
    if (swap == 0) {
        dc_add(4, 4, 100,  27,  4, 300,  27, 27, 500, DC_RED);
        dc_add(4, 4, 100,  27, 27, 500,   4, 27, 300, DC_BLUE);
    }
    if (swap != 0) {
        dc_add(4, 4, 100,  27, 27, 500,   4, 27, 300, DC_BLUE);
        dc_add(4, 4, 100,  27,  4, 300,  27, 27, 500, DC_RED);
    }
    return 0;
}

# dc_corpus_offorigin(swap) — the interpenetrating pair translated +DC_OFF_X in x AND with its z
# range scaled by DC_OFF_ZS, rendered through a window at dc_ox = DC_OFF_X (the caller sets it).
#
# ⭐ WHAT IT EXERCISES: the hoisted constant term `KC = sum(C_i z_i)` **exceeding a 32-bit field**,
# which is the one place the design depends on the record storing **mod-2^32 residues** rather than
# values. The model's A5 lane check has nothing to catch anywhere else in this tree.
#
# ⛔⛔ BOTH PARAMETERS ARE LOAD-BEARING, AND THE OBVIOUS ONE IS THE WRONG ONE. Translating by T
# pixels gives, exactly, `KC' = KC - 2*T*KX`. So KC grows with POSITION only in proportion to KX --
# and KX = sum(z_i A_i) scales with **z**, not with position. The plan specified x = 700 at the
# shipped z range, which yields |KC| = 58,124,800: **26 bits, comfortably inside an i32**, i.e. a
# frame that names the residue and never exercises it -- a third null-set probe of exactly the kind
# this rung keeps finding. Measured, not argued: that value is reproduced by the formula above from
# the origin corpus's KC = 115,200 and KX = 41,600.
# ⇒ x = 4000 (inside the ABI's 4096-px coordinate cap) AND z scaled 10x, which puts |KC| past 2^31
# while `zn = KX*x + KY*y + KC` stays ~2.4e7 -- the two magnitudes cancel, which IS the point. A gate
# in depthmodel ASSERTS |KC| > 2^31 so the frame cannot silently degrade back to a null set.
# ⚠ Scaling z uniformly leaves the COLOUR image byte-identical (it preserves every comparison and
# every tie), so the frame is still a fair translation check for depthgate's D6.
#
# ⛔ NOT AN EXTERNAL ORACLE. A constant sample-point offset commutes with integer translation, so
# byte-identity against the translated original is BLIND to a half-pixel convention error -- which is
# exactly why the plan rejects translation equivariance as *the* external gate (6.2). It is used here
# for the residue and corner-bound domains it opens, and for nothing else.
# dc_corpus_reversed(swap) — the interpenetrating pair with the winding of BOTH triangles reversed
# (vertices b and c swapped), so `area < 0` and the normalisation path is the one that runs.
#
# ⛔⛔ WITHOUT THIS FRAME THE WINDING NORMALISATION IS DEAD CODE IN EVERY TEST IN THIS TREE. Both
# shipped triangles wind positive (areas 2688 and 2704), and so do the precision, quad and off-origin
# frames, which are all derived from them. A normalisation that negated the wrong term -- or that
# negated `area` and forgot `KX/KY/KC` -- would be green everywhere. `dc_wind_flips` is what turns
# "it fired and was right" and "it never fired" into distinguishable results.
#
# ⭐ AND IT IS A REAL INVARIANT, not agreement between two implementations: **winding is a labelling
# convention.** Barycentric coordinates are intrinsic to the point and the triangle, and each vertex
# z travels with its own vertex, so relabelling b and c changes neither the covered set nor the
# interpolated z at any point. The image MUST be byte-identical. Nothing about the reference or the
# model can make that true if the normalisation is wrong.
fn dc_corpus_reversed(swap): i64 {
    dc_corpus(swap);
    var t = 0;
    while (t < dc_n) {
        var bx = dc_get(t, 3); var by = dc_get(t, 4); var bz = dc_get(t, 5);
        dc_set(t, 3, dc_get(t, 6)); dc_set(t, 4, dc_get(t, 7)); dc_set(t, 5, dc_get(t, 8));
        dc_set(t, 6, bx);           dc_set(t, 7, by);           dc_set(t, 8, bz);
        t = t + 1;
    }
    return 0;
}

var DC_OFF_X  = 4000;
var DC_OFF_ZS = 10;

fn dc_corpus_offorigin(swap): i64 {
    dc_corpus(swap);
    var t = 0;
    while (t < dc_n) {
        dc_set(t, 0, dc_get(t, 0) + DC_OFF_X);
        dc_set(t, 3, dc_get(t, 3) + DC_OFF_X);
        dc_set(t, 6, dc_get(t, 6) + DC_OFF_X);
        dc_set(t, 2, dc_get(t, 2) * DC_OFF_ZS);
        dc_set(t, 5, dc_get(t, 5) * DC_OFF_ZS);
        dc_set(t, 8, dc_get(t, 8) * DC_OFF_ZS);
        t = t + 1;
    }
    return 0;
}
