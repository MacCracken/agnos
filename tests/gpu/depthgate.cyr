# depthgate.cyr — RUNG 17's HOST GATE. Proves the depth reference is order-independent, and proves
# the gate that says so can actually FAIL.
#
# ⭐ ORDER-INDEPENDENCE IS *THE* PROPERTY THAT PROVES DEPTH, and it is the rung's stated iron oracle:
# *"two interpenetrating triangles submitted in BOTH orders produce byte-identical output."* Testing
# it here first means the burn is spent measuring the SHADER against a property already known to hold
# for the algorithm — not discovering that the property was never true.
#
# ⛔ WITHOUT D2 THIS FILE WOULD BE WORTHLESS. A renderer that ignored z entirely and simply painted
# in submission order would fail D1 — but so would a hundred other bugs, and more importantly a
# renderer that drew NOTHING would PASS D1, because two empty images are byte-identical. D2 (the
# no-depth-test mutation must break D1) and D0b (the corpus must actually cover pixels) are what turn
# D1 from a tautology into evidence.

include "lib/io.cyr"
include "tricore.cyr"      # ps / pn / nl
include "depthcore.cyr"

# ⭐ THE CORPUS LIVES IN depthcore.cyr, not here. It was duplicated into depthmodel.cyr as well
# until 2026-07-28 -- see the block there. A model validated against one pair while the gate proves
# order-independence for another is green on both sides and wrong.

# dg_z_at(t, px, py) — the interpolated z of triangle `t` at a pixel, or -1 if it does not cover it.
# ⭐ RECOMPUTED FROM THE VERTICES, deliberately not read out of dc_zbuf. D4's whole value is that it
# checks the renderer against an INDEPENDENT computation of the same quantity; asking the renderer
# what it stored and then agreeing with it would be the shared-premise blindness rung 15 shipped.
fn dg_z_at(t, px, py): i64 {
    # ⚠ Screen coordinates, same as dc_render: the window origin must be added here too, or every
    # off-origin gate would compare a z computed at x against a pixel drawn at x + DC_OFF_X.
    var pxq = 2 * (dc_ox + px) + 1;
    var pyq = 2 * (dc_oy + py) + 1;
    var ax = 2 * dc_get(t, 0); var ay = 2 * dc_get(t, 1);
    var bx = 2 * dc_get(t, 3); var by = 2 * dc_get(t, 4);
    var cx = 2 * dc_get(t, 6); var cy = 2 * dc_get(t, 7);
    var w0 = dc_edge(bx, by, cx, cy, pxq, pyq);
    var w1 = dc_edge(cx, cy, ax, ay, pxq, pyq);
    var w2 = dc_edge(ax, ay, bx, by, pxq, pyq);
    var area = w0 + w1 + w2;
    var inside = 0;
    if (area > 0) { if (w0 >= 0) { if (w1 >= 0) { if (w2 >= 0) { inside = 1; } } } }
    if (area < 0) { if (w0 <= 0) { if (w1 <= 0) { if (w2 <= 0) { inside = 1; } } } }
    if (inside == 0) { return 0 - 1; }
    return (w0 * dc_get(t, 2) + w1 * dc_get(t, 5) + w2 * dc_get(t, 8)) / area;
}

fn dg_render_order(swap): i64 {
    dc_corpus(swap);
    return dc_render(DC_W, DC_H, DC_FAR, DC_BG);
}

# dg_ulp_flips(span) — how many pixels a ONE-ULP z error on one triangle moves, at a given z span of
# the precision frame. ⚠ +1 on all three vertex z of a triangle shifts its interpolated z by exactly
# one everywhere, which is the realistic shape of a divide that is short by one -- the same shape as
# depthmodel's dm_mut_ulp, not a quantisation.
fn dg_ulp_flips(span): i64 {
    dc_corpus_precision_span(span, 0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    dc_snapshot(DC_W, DC_H);
    dc_set(1, 2, dc_get(1, 2) + 1);
    dc_set(1, 5, dc_get(1, 5) + 1);
    dc_set(1, 8, dc_get(1, 8) + 1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    return dc_diff(DC_W, DC_H);
}

fn main(): i64 {
    var bad = 0;
    ps("depthgate: rung 17 -- depth-tested rasterisation, order-independence on the host"); nl(); nl();

    # ---- D0a: THE CORPUS MUST BE FAIR. No z-ties, or order-independence is not even true. --------
    # ⛔ A tie is decided by submission order on ANY correct implementation, hardware included, so a
    # corpus containing one would make a CORRECT shader fail the iron oracle. Proven, not assumed.
    dg_render_order(0);
    ps("D0a corpus has no z-ties (order-independence is a FAIR test): ");
    if (dc_ties == 0) { ps("PASS"); nl(); }
    if (dc_ties != 0) { ps("FAIL "); pn(dc_ties); ps(" tie pixels"); nl(); bad = bad + 1; }

    # ---- D0b: AND IT MUST ACTUALLY DRAW. Two empty images are byte-identical. ---------------------
    var cov = dc_covered(DC_W, DC_H, DC_BG);
    ps("D0b the corpus covers pixels (an empty image would pass D1 vacuously): ");
    if (cov > 200) { ps("PASS "); pn(cov); ps(" px"); nl(); }
    if (cov <= 200) { ps("FAIL only "); pn(cov); ps(" px covered"); nl(); bad = bad + 1; }

    # ---- D0c: BOTH triangles must be VISIBLE somewhere, or the pair is not interpenetrating. -----
    # ⭐ THE CASE THAT MAKES THE PAIR MEANINGFUL. If one triangle wholly occludes the other, depth
    # ordering is indistinguishable from painter's order and D1 proves nothing about the z test.
    var nred = 0; var nblue = 0;
    var i = 0;
    while (i < DC_W * DC_H) {
        var p = load32(&dc_cbuf + i * 4) & 0xFFFFFFFF;
        if (p == DC_RED)  { nred  = nred + 1; }
        if (p == DC_BLUE) { nblue = nblue + 1; }
        i = i + 1;
    }
    ps("D0c both triangles win somewhere (they truly interpenetrate): ");
    if (nred > 20) {
        if (nblue > 20) { ps("PASS red "); pn(nred); ps(" px, blue "); pn(nblue); ps(" px"); nl(); }
    }
    if (nred <= 20) { ps("FAIL red only "); pn(nred); ps(" px"); nl(); bad = bad + 1; }
    if (nred > 20) {
        if (nblue <= 20) { ps("FAIL blue only "); pn(nblue); ps(" px"); nl(); bad = bad + 1; }
    }

    # ---- D1: THE RUNG'S ORACLE. Both submission orders, byte-identical. --------------------------
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dg_render_order(1);
    var d1 = dc_diff(DC_W, DC_H);
    ps("D1  both submission orders are byte-identical: ");
    if (d1 == 0) { ps("PASS"); nl(); }
    if (d1 != 0) { ps("FAIL "); pn(d1); ps(" differing px"); nl(); bad = bad + 1; }

    # ---- D2: FALSIFICATION. Painter's order (no depth test) MUST break D1. -----------------------
    # ⛔ THE GATE THAT MAKES D1 MEAN SOMETHING. Rendered without the z test, the second-submitted
    # triangle overwrites the first wherever they overlap, so the two orders MUST differ. If this
    # comes back green, D1 is not measuring the depth test and the whole file is decoration.
    # ⚠ Implemented by giving every triangle the SAME z, which makes every overlap a tie and hands
    # the pixel to submission order -- exactly painter's behaviour, using the shipped renderer rather
    # than a second code path that could disagree with it for unrelated reasons.
    dc_corpus_coplanar(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    dc_snapshot(DC_W, DC_H);
    dc_corpus_coplanar(1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var d2 = dc_diff(DC_W, DC_H);
    ps("D2  co-planar (every overlap a TIE) IS order-dependent -- D1 is connected: ");
    if (d2 != 0) { ps("RED (correct), "); pn(d2); ps(" differing px"); nl(); }
    if (d2 == 0) {
        ps("** GATE NOT CONNECTED: even a pure tie was order-independent **"); nl();
        bad = bad + 1;
    }

    # ---- D3: DETERMINISM. The same input twice must give the same output, bit for bit. ------------
    # ⚠ On iron this is the check that separates "wrong" from "nondeterministic", and the rung's own
    # failure table says a difference between two identical frames IS the finding (a wave race). On
    # the host it can only ever pass -- which is exactly why it belongs here as the CONTROL: if it
    # ever fails here, the reference itself has state it should not have.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dg_render_order(0);
    var d3 = dc_diff(DC_W, DC_H);
    ps("D3  identical input renders identically (the reference is stateless): ");
    if (d3 == 0) { ps("PASS"); nl(); }
    if (d3 != 0) { ps("FAIL "); pn(d3); ps(" px"); nl(); bad = bad + 1; }

    # ---- D4: THE NEAREST TRIANGLE WINS, checked against an independently computed answer. ---------
    # ⭐ AN EXTERNAL INVARIANT, not agreement with another implementation. At a pixel covered by both,
    # the colour must be whichever triangle has the smaller interpolated z there -- recomputed here
    # from the vertices directly rather than trusting the renderer's own bookkeeping.
    # [[feedback_oracle_must_test_external_invariant]]
    dg_render_order(0);
    var d4 = 0;
    var d4n = 0;
    var y2 = 0;
    while (y2 < DC_H) {
        var x2 = 0;
        while (x2 < DC_W) {
            var got = load32(&dc_cbuf + (y2 * DC_W + x2) * 4) & 0xFFFFFFFF;
            if (got != DC_BG) {
                var zr = dg_z_at(0, x2, y2);
                var zb = dg_z_at(1, x2, y2);
                # both cover this pixel?
                if (zr >= 0) {
                    if (zb >= 0) {
                        d4n = d4n + 1;
                        var want = DC_RED;
                        if (zb < zr) { want = DC_BLUE; }
                        if (got != want) { d4 = d4 + 1; }
                    }
                }
            }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    ps("D4  on every shared pixel the NEARER triangle won ("); pn(d4n); ps(" checked): ");
    if (d4 == 0) { ps("PASS"); nl(); }
    if (d4 != 0) { ps("FAIL "); pn(d4); ps(" px"); nl(); bad = bad + 1; }
    if (d4n < 20) {
        ps("    ** only "); pn(d4n); ps(" shared pixels -- D4 proves little **"); nl();
        bad = bad + 1;
    }

    # ==============================================================================================
    # ⭐⭐ D0d / D0e / D5 / D6 / D7 — ADDED 2026-07-29 (plan bite B2), BECAUSE EVERY GATE ABOVE
    #     RUNS ON A CORPUS MEASURED BLIND TO THE TWO THINGS THIS RUNG IS ABOUT.
    # ==============================================================================================
    # See dc_corpus_precision's block in depthcore.cyr for the measured table. Two sentences of it:
    # a divide one ULP short changes **0 of 1024 pixels** here, and `dc_ties == 0` (D0a) **is**
    # order-invariance, so "walks the list in submission order" is currently tested by nothing.
    # ⚠ NUMBERING: the plan calls the quad gate "D3", but D3 is already the determinism control
    # above. Numbered D5 here and corrected in planning/rung17-tri-depth.md rather than shadowing a
    # shipped gate name -- two gates called D3 is the ATOM_DRY defect one level up.
    nl();

    # ---- D0d: THE PRECISION FRAME IS ULP-SENSITIVE, and that is MEASURED, not assumed. -----------
    # ⛔ Pre-registered as a gate rather than discovered post-burn: if a +1 uniform z error on one
    # triangle moves nothing HERE either, then no frame in this tree can witness a divide error and
    # the burn cannot fail on the rung's only novel content.
    dc_corpus_precision(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var pties = dc_ties;
    dc_snapshot(DC_W, DC_H);
    dc_set(1, 2, dc_get(1, 2) + 1);        # +1 on all three vertex z of triangle 1 == a uniform
    dc_set(1, 5, dc_get(1, 5) + 1);        # one-ULP error in its interpolated z everywhere
    dc_set(1, 8, dc_get(1, 8) + 1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var pulp = dc_diff(DC_W, DC_H);
    # ⭐ THE TWO ENDPOINTS, RE-MEASURED EVERY RUN. Span 800 is the shipped corpus (blind because the
    # gradient dwarfs a ULP); span 1 is blind for the OPPOSITE reason -- every shared pixel ties, so
    # the strict `<` hands them all to the incumbent either way. Sensitivity is NOT monotone in the
    # span, and a retune "tighter is finer" lands straight on the second null set. Asserted, not
    # commented, so that cannot happen silently.
    var pnarrow = dg_ulp_flips(1);
    var pwide   = dg_ulp_flips(800);
    # Threshold 20 against a measured 42 at the swept optimum. ⚠ Deliberately NOT set just under 42:
    # the span-1 row of that sweep flips ZERO, so a frame retuned "tighter" fails this loudly instead
    # of drifting down to a number a tight threshold would have to be relaxed to accommodate.
    ps("D0d PRECISION frame (span "); pn(DC_PREC_SPAN); ps("): a ONE-ULP z error flips ");
    pn(pulp); ps(" px ("); pn(pties); ps(" ties): ");
    if (pulp >= 20) { ps("PASS -- the frame can witness a ULP"); nl(); }
    if (pulp < 20) {
        ps("FAIL -- still nearly blind; no frame in this tree can catch a broken divide"); nl();
        bad = bad + 1;
    }
    ps("    endpoints: span 1 flips "); pn(pnarrow); ps(" (ALL shared px tie -> blind), span 800 flips ");
    pn(pwide); ps(" (the shipped corpus -> blind): ");
    if (pulp > pnarrow) {
        if (pulp > pwide) { ps("PASS -- the chosen span beats both"); nl(); }
    }
    if (pulp <= pnarrow) {
        ps("FAIL -- a tighter span is no worse, so the non-monotonicity claim is wrong"); nl();
        bad = bad + 1;
    }
    if (pulp > pnarrow) {
        if (pulp <= pwide) {
            ps("FAIL -- the shipped wide corpus is no worse, so this frame buys nothing"); nl();
            bad = bad + 1;
        }
    }

    # ---- D0e: THE SENTINEL. Render at the value IRON ACTUALLY BURNS. -----------------------------
    # ⛔ Every call site above passes DC_FAR = 1,000,000, which is SMALLER than the ABI's own legal z
    # ceiling (2^24-1 = 16,777,215). The reference's clear plane has been sitting IN FRONT of legal
    # geometry for the whole rung, and the hardware value 0xFFFFFFFF has never once been exercised.
    # ⚠ This is the frame where the signed-vs-unsigned pin bites: under `v_cmp_lt_i32`, 0xFFFFFFFF is
    # -1, i.e. the NEAREST possible value, so nothing ever draws -- and a blank frame is byte-identical
    # in both orders, so D1 goes GREEN. That is the single most expensive wrong pick on this rung.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dc_corpus(0);
    dc_render(DC_W, DC_H, DC_ZCLEAR_HW, DC_BG);
    var d0e = dc_diff(DC_W, DC_H);
    var d0ecov = dc_covered(DC_W, DC_H, DC_BG);
    ps("D0e clearing at the HARDWARE far value 0xFFFFFFFF draws the same image ("); pn(d0ecov);
    ps(" px): ");
    if (d0e == 0) {
        if (d0ecov > 200) { ps("PASS"); nl(); }
    }
    if (d0e != 0) { ps("FAIL "); pn(d0e); ps(" px differ"); nl(); bad = bad + 1; }
    if (d0e == 0) {
        if (d0ecov <= 200) {
            ps("FAIL -- identical but EMPTY, which is what a signed compare produces"); nl();
            bad = bad + 1;
        }
    }
    ps("    the far value exceeds every legal z (>= 2^24), so an UNSIGNED compare is behind all geometry: ");
    if (DC_ZCLEAR_HW > DC_ZMAX) { ps("PASS"); nl(); }
    if (DC_ZCLEAR_HW <= DC_ZMAX) { ps("FAIL"); nl(); bad = bad + 1; }
    ps("    ⚠ but DC_FAR = "); pn(DC_FAR); ps(" is BELOW the legal z ceiling "); pn(DC_ZMAX);
    ps(" -- the reference's own clear plane sits in front of legal geometry"); nl();

    # ---- D5: THE QUAD. The ONLY witness that the list is walked in SUBMISSION ORDER. -------------
    # ⭐ And the claim is sharper than "the two orders differ": at a tie the STRICT `<` keeps the
    # incumbent, so the FIRST-submitted triangle must win every tie. Order 0 submits red first, order
    # 1 submits blue first ⇒ every differing pixel must be RED in order 0 and BLUE in order 1.
    # A shader walking the list BACKWARDS gets this exactly inverted; "they differ" alone would not.
    dc_corpus_quad(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var qties = dc_ties;
    dc_snapshot(DC_W, DC_H);
    dc_corpus_quad(1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var qdiff = 0;
    var qwrong = 0;
    var qi = 0;
    while (qi < DC_W * DC_H) {
        var qa = load32(&dc_snap + qi * 4) & 0xFFFFFFFF;
        var qb = load32(&dc_cbuf + qi * 4) & 0xFFFFFFFF;
        if (qa != qb) {
            qdiff = qdiff + 1;
            if (qa != DC_RED)  { qwrong = qwrong + 1; }
            if (qb != DC_BLUE) { qwrong = qwrong + 1; }
        }
        qi = qi + 1;
    }
    ps("D5  QUAD frame ("); pn(qties); ps(" ties): the two orders DIFFER at "); pn(qdiff);
    ps(" px: ");
    if (qdiff > 0) { ps("RED (correct -- submission order is now observable)"); nl(); }
    if (qdiff == 0) {
        ps("** NOT CONNECTED: a shared diagonal produced no ties, so nothing tests list order **"); nl();
        bad = bad + 1;
    }
    ps("    and the FIRST-submitted triangle won every one of them: ");
    if (qwrong == 0) { ps("PASS"); nl(); }
    if (qwrong != 0) {
        ps("FAIL "); pn(qwrong); ps(" -- the list is being resolved in the WRONG order"); nl();
        bad = bad + 1;
    }

    # ---- D6: OFF-ORIGIN. The residue domain, and the corner bound's real workout. ----------------
    # ⚠ Scope stated honestly: this is byte-identity against the translated original, which is BLIND
    # to a half-pixel convention error (a constant sample offset commutes with integer translation --
    # the plan rejects translation equivariance as *the* external gate for exactly that reason). Its
    # value is the ARITHMETIC domain it opens: |KC| goes from ~1e5 to ~2e11, 39 bits, which is where
    # depthmodel's A5 finally has a residue worth checking.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dc_ox = DC_OFF_X;
    dc_corpus_offorigin(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var d6 = dc_diff(DC_W, DC_H);
    var d6cov = dc_covered(DC_W, DC_H, DC_BG);
    dc_ox = 0;
    ps("D6  OFF-ORIGIN (window at x=DC_OFF_X) renders the translated figure identically ("); pn(d6cov);
    ps(" px): ");
    if (d6 == 0) {
        if (d6cov > 200) { ps("PASS"); nl(); }
    }
    if (d6 != 0) { ps("FAIL "); pn(d6); ps(" px differ"); nl(); bad = bad + 1; }
    if (d6 == 0) {
        if (d6cov <= 200) { ps("FAIL -- identical but EMPTY"); nl(); bad = bad + 1; }
    }

    # ---- D7: THE COVERAGE MAP, printed in the gate rather than discovered after the burn. --------
    # ⭐ The dispatch is one workgroup per 8x8 tile, so the 32x32 corpus is 16 tiles. A tile with no
    # DUAL-COVERED pixel cannot distinguish a depth-tested shader from a painter's-order one, and a
    # tile with no coverage at all is byte-identical for a shader that never ran in it. Knowing which
    # tiles those are BEFORE the flash is the difference between "3 tiles wrong" being a signal and
    # being noise.
    dg_render_order(0);
    var tdual = 0; var tdrawn = 0; var tempty = 0;
    var ty = 0;
    while (ty < 4) {
        var tx = 0;
        while (tx < 4) {
            var ndual = 0; var ndrawn = 0;
            var yy = 0;
            while (yy < 8) {
                var xx = 0;
                while (xx < 8) {
                    var gx = tx * 8 + xx;
                    var gy = ty * 8 + yy;
                    if ((load32(&dc_cbuf + (gy * DC_W + gx) * 4) & 0xFFFFFFFF) != DC_BG) {
                        ndrawn = ndrawn + 1;
                    }
                    if (dg_z_at(0, gx, gy) >= 0) {
                        if (dg_z_at(1, gx, gy) >= 0) { ndual = ndual + 1; }
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            if (ndual > 0)   { tdual  = tdual + 1; }
            if (ndrawn > 0)  { tdrawn = tdrawn + 1; }
            if (ndrawn == 0) { tempty = tempty + 1; }
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    ps("D7  tile coverage of the 16 dispatch tiles: "); pn(tdual);
    ps(" discriminate depth, "); pn(tdrawn); ps(" draw anything, "); pn(tempty);
    ps(" are ENTIRELY EMPTY"); nl();
    ps("    ⇒ "); pn(16 - tdual); ps(" tiles prove nothing about z (a painter's-order shader is");
    ps(" byte-identical there), and "); pn(tempty);
    ps(" are byte-identical for a shader that never ran: ");
    if (tdual >= 4) { ps("PASS"); nl(); }
    if (tdual < 4) { ps("FAIL -- too few discriminating tiles to interpret a burn"); nl(); bad = bad + 1; }

    nl();
    if (bad == 0) {
        ps("depthgate: PASS -- depth-tested rasterisation is ORDER-INDEPENDENT on a corpus proven"); nl();
        ps("           fair (no z-ties), truly interpenetrating, and non-empty; the co-planar"); nl();
        ps("           mutation shows the gate can fail. Rung 17's iron oracle is sound BEFORE"); nl();
        ps("           a single shader instruction exists."); nl();
        return 95;
    }
    ps("depthgate: FAIL -- "); pn(bad); ps(" propert(ies) broken; do NOT write the shader yet."); nl();
    return 90;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
