# depthgate.cyr — RUNG 17's HOST GATE. Proves the depth reference is order-independent, and proves
# the gate that says so can actually FAIL.
#
# ⭐ ORDER-INDEPENDENCE IS *THE* PROPERTY THAT PROVES DEPTH, and it is the rung's stated iron oracle:
# *"two interpenetrating triangles submitted in BOTH orders produce byte-identical output."* Testing
# it here first means the burn is spent measuring the SHADER against a property already known to hold
# for the algorithm — not discovering that the property was never true.
#
# ⛔ WITHOUT D2 THIS FILE WOULD BE WORTHLESS. A renderer that ignored z entirely and simply painted
# in submission order would fail D1 — but so would a hundred other bugs, and more importantly a
# renderer that drew NOTHING would PASS D1, because two empty images are byte-identical. D2 (the
# no-depth-test mutation must break D1) and D0b (the corpus must actually cover pixels) are what turn
# D1 from a tautology into evidence.

include "lib/io.cyr"
include "tricore.cyr"      # ps / pn / nl
include "depthcore.cyr"

# ⭐ THE CORPUS LIVES IN depthcore.cyr, not here. It was duplicated into depthmodel.cyr as well
# until 2026-07-28 -- see the block there. A model validated against one pair while the gate proves
# order-independence for another is green on both sides and wrong.

# dg_z_at(t, px, py) — the interpolated z of triangle `t` at a pixel, or -1 if it does not cover it.
# ⭐ RECOMPUTED FROM THE VERTICES, deliberately not read out of dc_zbuf. D4's whole value is that it
# checks the renderer against an INDEPENDENT computation of the same quantity; asking the renderer
# what it stored and then agreeing with it would be the shared-premise blindness rung 15 shipped.
fn dg_z_at(t, px, py): i64 {
    # ⚠ Screen coordinates, same as dc_render: the window origin must be added here too, or every
    # off-origin gate would compare a z computed at x against a pixel drawn at x + DC_OFF_X.
    var pxq = 2 * (dc_ox + px) + 1;
    var pyq = 2 * (dc_oy + py) + 1;
    var ax = 2 * dc_get(t, 0); var ay = 2 * dc_get(t, 1);
    var bx = 2 * dc_get(t, 3); var by = 2 * dc_get(t, 4);
    var cx = 2 * dc_get(t, 6); var cy = 2 * dc_get(t, 7);
    var w0 = dc_edge(bx, by, cx, cy, pxq, pyq);
    var w1 = dc_edge(cx, cy, ax, ay, pxq, pyq);
    var w2 = dc_edge(ax, ay, bx, by, pxq, pyq);
    var area = w0 + w1 + w2;
    var inside = 0;
    if (area > 0) { if (w0 >= 0) { if (w1 >= 0) { if (w2 >= 0) { inside = 1; } } } }
    if (area < 0) { if (w0 <= 0) { if (w1 <= 0) { if (w2 <= 0) { inside = 1; } } } }
    if (inside == 0) { return 0 - 1; }
    return (w0 * dc_get(t, 2) + w1 * dc_get(t, 5) + w2 * dc_get(t, 8)) / area;
}

fn dg_render_order(swap): i64 {
    dc_corpus(swap);
    return dc_render(DC_W, DC_H, DC_FAR, DC_BG);
}

# dg_ulp_flips(span) — how many pixels a ONE-ULP z error on one triangle moves, at a given z span of
# the precision frame. ⚠ +1 on all three vertex z of a triangle shifts its interpolated z by exactly
# one everywhere, which is the realistic shape of a divide that is short by one -- the same shape as
# depthmodel's dm_mut_ulp, not a quantisation.
# dg_absmax_at(t, px, py) — the largest |value| among w0, w1, w2 and zn for triangle `t` at one
# pixel. ⚠ Evaluated UNCONDITIONALLY, inside the triangle or not: the shader is predicated and runs
# every lane, so the bound the validator needs is over the whole draw rect, not over the covered set.
# ==================================================================================================
# ⭐⭐ THE EXTERNAL INVARIANTS (plan 6.2, bite B4) — the two gates that do NOT rest on a shared premise
# ==================================================================================================
# ⛔ EVERY GATE ABOVE IS INTERNAL. D1's both-orders oracle is a consistency property that a wrong
# shader and a wrong reference can satisfy TOGETHER -- which is precisely what happened at rung 15,
# where bicore, bimodel, texcore AND the shader all implemented the same wrong half-texel convention
# and every agreement gate went green. `depthmodel` vs `depthcore` has the same exposure: they were
# written in the same week by the same hand from the same derivation.
# ⛔ Translation equivariance was REJECTED as the external gate: a constant sample-point offset
# COMMUTES with integer translation, so it is blind to exactly the error it would be proposed to
# catch. (D6 uses it, but only for the arithmetic domain it opens -- never as the oracle.)

# ---- G7's counterparty: the inside test of the INDEPENDENTLY BURNED 2D path ----------------------
# `tri_prep`/`tri_ref_px` is rung 9/11's reference for `tri_rgba` / op 0x0A -- a shipped, iron-burned
# rasteriser. Three things make it a genuine external witness rather than a sibling:
#   1. **Different number system.** It keeps vertices in PIXELS and samples at 16.16
#      `(px << 16) + 32768`; `depthcore` DOUBLES the vertices and samples at `2*px + 1`. Both denote
#      the pixel centre, and neither can be transformed into the other by a shared constant.
#   2. **Different edge derivation.** Its signs fall out of the lambda_B / lambda_C definitions (see
#      tricore.cyr:147-158, where getting them wrong produced a uniformly black frame); `depthcore`
#      takes three symmetric cross products.
#   3. **It was burned.** Its answers were checked against silicon, not against a co-designed model.
# ⇒ if the two disagree on a single pixel of the silhouette, one of the two half-pixel conventions is
# wrong -- and that is the exact class of defect rung 15 shipped past four green gates.
# ---- mutations for the external gates: each MUST make its gate go red ----------------------------
# ⛔ A gate that has never failed is a claim, not a check -- and these three passed on their first run,
# which is exactly when that distinction matters most.
var dg_mut_corner = 0;   # D10: sample at the pixel CORNER instead of its centre -- a half-pixel
                         #      convention error, i.e. the precise class rung 15 shipped past four
                         #      green gates. If D10 cannot see this, it cannot see the thing it exists for.
var dg_mut_plane  = 0;   # D11a: perturb the fitted plane's constant term by one
var dg_mut_lflip  = 0;   # D11b: reverse the sense of the interpenetration line

fn dg_tp_inside(px, py): i64 {
    var pcx = ((dc_ox + px) << 16) + 32768;
    var pcy = ((dc_oy + py) << 16) + 32768;
    if (dg_mut_corner != 0) {
        pcx = (dc_ox + px) << 16;
        pcy = (dc_oy + py) << 16;
    }
    var eb = tp_get(TP_KXB) * pcx + tp_get(TP_KYB) * pcy + tp_get(TP_K0B);
    var ec = tp_get(TP_KXC) * pcx + tp_get(TP_KYC) * pcy + tp_get(TP_K0C);
    var ea = tp_get(TP_A2) - eb - ec;      # the identity, not a third cross product
    if (ea >= 0) { if (eb >= 0) { if (ec >= 0) { return 1; } } }
    return 0;
}

# ---- G8's machinery: each triangle's depth plane fitted in 3-SPACE, from the vertices alone -------
# ⭐ NOTHING HERE TOUCHES AN EDGE FUNCTION, A BARYCENTRIC WEIGHT OR THE HOIST. The three (x, y, z)
# vertices span a plane; its normal is one 3D cross product, and `z = (a*X + b*Y + c)/d` follows. That
# is a completely different route to the same quantity, which is what makes D11 external.
var dg_pa[2]; var dg_pb[2]; var dg_pc[2]; var dg_pd[2];

fn dg_plane_fit(t): i64 {
    # ⚠ X and Y doubled, Z not -- matching the doubled sample points. z is linear in (x, y), so
    # rescaling x and y just rescales the coefficients; evaluating at doubled samples recovers it.
    var X0 = 2 * dc_get(t, 0); var Y0 = 2 * dc_get(t, 1); var Z0 = dc_get(t, 2);
    var X1 = 2 * dc_get(t, 3); var Y1 = 2 * dc_get(t, 4); var Z1 = dc_get(t, 5);
    var X2 = 2 * dc_get(t, 6); var Y2 = 2 * dc_get(t, 7); var Z2 = dc_get(t, 8);
    var ux = X1 - X0; var uy = Y1 - Y0; var uz = Z1 - Z0;
    var vx = X2 - X0; var vy = Y2 - Y0; var vz = Z2 - Z0;
    var nx = uy * vz - uz * vy;
    var ny = uz * vx - ux * vz;
    var nz = ux * vy - uy * vx;
    var a = 0 - nx;
    var b = 0 - ny;
    var c = nx * X0 + ny * Y0 + nz * Z0;
    var d = nz;
    if (dg_mut_plane != 0) { c = c + 1; }
    # normalise to a positive denominator so sign(z0 - z1) == sign(L) below
    if (d < 0) { a = 0 - a; b = 0 - b; c = 0 - c; d = 0 - d; }
    store64(&dg_pa + t * 8, a);
    store64(&dg_pb + t * 8, b);
    store64(&dg_pc + t * 8, c);
    store64(&dg_pd + t * 8, d);
    return 0;
}

# dg_bary_at — the reference's OWN numerator and denominator at a pixel, for D11a to cross-multiply
# against the plane fit. Left in globals because Cyrius has no tuple return.
var dg_zn = 0;
var dg_ar = 0;

fn dg_bary_at(t, px, py): i64 {
    var pxq = 2 * (dc_ox + px) + 1;
    var pyq = 2 * (dc_oy + py) + 1;
    var ax = 2 * dc_get(t, 0); var ay = 2 * dc_get(t, 1);
    var bx = 2 * dc_get(t, 3); var by = 2 * dc_get(t, 4);
    var cx = 2 * dc_get(t, 6); var cy = 2 * dc_get(t, 7);
    var w0 = dc_edge(bx, by, cx, cy, pxq, pyq);
    var w1 = dc_edge(cx, cy, ax, ay, pxq, pyq);
    var w2 = dc_edge(ax, ay, bx, by, pxq, pyq);
    dg_ar = w0 + w1 + w2;
    dg_zn = w0 * dc_get(t, 2) + w1 * dc_get(t, 5) + w2 * dc_get(t, 8);
    return 0;
}

# dg_g7() — the constant-z silhouette comparison. Returns the number of disagreeing pixels.
# ⚠ COVERAGE is compared, not colour: `tri_ref_px` blends premultiplied ARGB against a coverage byte
# produced by a separate area-integrating rasteriser, which is a different quantity. The INSIDE
# DECISION is what the two paths genuinely share, and it is where a half-pixel convention lives.
var dg_g7_cov = 0;
var dg_g7_prep = 0;

fn dg_g7(): i64 {
    var bad7 = 0;
    dg_g7_cov = 0;
    dg_g7_prep = 0;
    var t7 = 0;
    while (t7 < 2) {
        dc_corpus(0);
        var vx0 = dc_get(t7, 0); var vy0 = dc_get(t7, 1);
        var vx1 = dc_get(t7, 3); var vy1 = dc_get(t7, 4);
        var vx2 = dc_get(t7, 6); var vy2 = dc_get(t7, 7);
        # ONE triangle, CONSTANT z -- so the depth test cannot influence the silhouette and what is
        # left is purely the coverage rule, which is the thing the two paths must agree about.
        dc_reset();
        dc_add(vx0, vy0, 500, vx1, vy1, 500, vx2, vy2, 500, DC_RED);
        dc_render(DC_W, DC_H, DC_FAR, DC_BG);
        if (tri_prep(vx0, vy0, vx1, vy1, vx2, vy2, DC_RED, DC_RED, DC_RED) != 1) {
            dg_g7_prep = dg_g7_prep + 1;
        }
        var y7 = 0;
        while (y7 < DC_H) {
            var x7 = 0;
            while (x7 < DC_W) {
                var got = 0;
                if ((load32(&dc_cbuf + (y7 * DC_W + x7) * 4) & 0xFFFFFFFF) != DC_BG) { got = 1; }
                if (got == 1) { dg_g7_cov = dg_g7_cov + 1; }
                if (got != dg_tp_inside(x7, y7)) { bad7 = bad7 + 1; }
                x7 = x7 + 1;
            }
            y7 = y7 + 1;
        }
        t7 = t7 + 1;
    }
    return bad7;
}

# dg_g8() — the plane-fit identity (a) and the interpenetration line (b), in one pixel walk.
var dg_g8a_bad = 0; var dg_g8a_n = 0;
var dg_g8b_bad = 0; var dg_g8b_n = 0; var dg_g8_online = 0;

fn dg_g8(): i64 {
    dg_render_order(0);
    dg_plane_fit(0);
    dg_plane_fit(1);
    var La = load64(&dg_pa + 0) * load64(&dg_pd + 8) - load64(&dg_pa + 8) * load64(&dg_pd + 0);
    var Lb = load64(&dg_pb + 0) * load64(&dg_pd + 8) - load64(&dg_pb + 8) * load64(&dg_pd + 0);
    var Lc = load64(&dg_pc + 0) * load64(&dg_pd + 8) - load64(&dg_pc + 8) * load64(&dg_pd + 0);
    if (dg_mut_lflip != 0) { La = 0 - La; Lb = 0 - Lb; Lc = 0 - Lc; }
    dg_g8a_bad = 0; dg_g8a_n = 0;
    dg_g8b_bad = 0; dg_g8b_n = 0; dg_g8_online = 0;
    var y8 = 0;
    while (y8 < DC_H) {
        var x8 = 0;
        while (x8 < DC_W) {
            var X = 2 * (dc_ox + x8) + 1;
            var Y = 2 * (dc_oy + y8) + 1;
            var z0 = dg_z_at(0, x8, y8);
            var z1 = dg_z_at(1, x8, y8);
            # (a) on every pixel each triangle covers
            var tt = 0;
            while (tt < 2) {
                var zc = z0;
                if (tt == 1) { zc = z1; }
                if (zc >= 0) {
                    dg_bary_at(tt, x8, y8);
                    var lhs = (load64(&dg_pa + tt * 8) * X
                             + load64(&dg_pb + tt * 8) * Y
                             + load64(&dg_pc + tt * 8)) * dg_ar;
                    var rhs = dg_zn * load64(&dg_pd + tt * 8);
                    dg_g8a_n = dg_g8a_n + 1;
                    if (lhs != rhs) { dg_g8a_bad = dg_g8a_bad + 1; }
                }
                tt = tt + 1;
            }
            # (b) on pixels both cover
            if (z0 >= 0) {
                if (z1 >= 0) {
                    var L = La * X + Lb * Y + Lc;
                    if (L == 0) { dg_g8_online = dg_g8_online + 1; }
                    # ⚠ Only where the RENDERED (truncated) depths actually differ. Where they are
                    # equal the pixel is a tie and submission order decides it, which says nothing
                    # about the line. floor is monotone, so z0 != z1 implies the exact values differ
                    # in the same direction -- no truncation case can slip through here.
                    if (z0 != z1) {
                        dg_g8b_n = dg_g8b_n + 1;
                        var got = load32(&dc_cbuf + (y8 * DC_W + x8) * 4) & 0xFFFFFFFF;
                        var want = DC_RED;
                        if (z1 < z0) { want = DC_BLUE; }
                        if (got != want) { dg_g8b_bad = dg_g8b_bad + 1; }
                        # and the analytic line must agree about which side we are on
                        if (z0 < z1) { if (L >= 0) { dg_g8b_bad = dg_g8b_bad + 1; } }
                        if (z1 < z0) { if (L <= 0) { dg_g8b_bad = dg_g8b_bad + 1; } }
                    }
                }
            }
            x8 = x8 + 1;
        }
        y8 = y8 + 1;
    }
    return 0;
}

fn dg_absmax_at(t, px, py): i64 {
    var pxq = 2 * (dc_ox + px) + 1;
    var pyq = 2 * (dc_oy + py) + 1;
    var ax = 2 * dc_get(t, 0); var ay = 2 * dc_get(t, 1);
    var bx = 2 * dc_get(t, 3); var by = 2 * dc_get(t, 4);
    var cx = 2 * dc_get(t, 6); var cy = 2 * dc_get(t, 7);
    var w0 = dc_edge(bx, by, cx, cy, pxq, pyq);
    var w1 = dc_edge(cx, cy, ax, ay, pxq, pyq);
    var w2 = dc_edge(ax, ay, bx, by, pxq, pyq);
    var zn = w0 * dc_get(t, 2) + w1 * dc_get(t, 5) + w2 * dc_get(t, 8);
    var m = w0; if (m < 0) { m = 0 - m; }
    var a = w1; if (a < 0) { a = 0 - a; }
    if (a > m) { m = a; }
    a = w2; if (a < 0) { a = 0 - a; }
    if (a > m) { m = a; }
    a = zn; if (a < 0) { a = 0 - a; }
    if (a > m) { m = a; }
    return m;
}

fn dg_ulp_flips(span): i64 {
    dc_corpus_precision_span(span, 0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    dc_snapshot(DC_W, DC_H);
    dc_set(1, 2, dc_get(1, 2) + 1);
    dc_set(1, 5, dc_get(1, 5) + 1);
    dc_set(1, 8, dc_get(1, 8) + 1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    return dc_diff(DC_W, DC_H);
}

fn main(): i64 {
    var bad = 0;
    ps("depthgate: rung 17 -- depth-tested rasterisation, order-independence on the host"); nl(); nl();

    # ---- D0a: THE CORPUS MUST BE FAIR. No z-ties, or order-independence is not even true. --------
    # ⛔ A tie is decided by submission order on ANY correct implementation, hardware included, so a
    # corpus containing one would make a CORRECT shader fail the iron oracle. Proven, not assumed.
    dg_render_order(0);
    ps("D0a corpus has no z-ties (order-independence is a FAIR test): ");
    if (dc_ties == 0) { ps("PASS"); nl(); }
    if (dc_ties != 0) { ps("FAIL "); pn(dc_ties); ps(" tie pixels"); nl(); bad = bad + 1; }

    # ---- D0b: AND IT MUST ACTUALLY DRAW. Two empty images are byte-identical. ---------------------
    var cov = dc_covered(DC_W, DC_H, DC_BG);
    ps("D0b the corpus covers pixels (an empty image would pass D1 vacuously): ");
    if (cov > 200) { ps("PASS "); pn(cov); ps(" px"); nl(); }
    if (cov <= 200) { ps("FAIL only "); pn(cov); ps(" px covered"); nl(); bad = bad + 1; }

    # ---- D0c: BOTH triangles must be VISIBLE somewhere, or the pair is not interpenetrating. -----
    # ⭐ THE CASE THAT MAKES THE PAIR MEANINGFUL. If one triangle wholly occludes the other, depth
    # ordering is indistinguishable from painter's order and D1 proves nothing about the z test.
    var nred = 0; var nblue = 0;
    var i = 0;
    while (i < DC_W * DC_H) {
        var p = load32(&dc_cbuf + i * 4) & 0xFFFFFFFF;
        if (p == DC_RED)  { nred  = nred + 1; }
        if (p == DC_BLUE) { nblue = nblue + 1; }
        i = i + 1;
    }
    ps("D0c both triangles win somewhere (they truly interpenetrate): ");
    if (nred > 20) {
        if (nblue > 20) { ps("PASS red "); pn(nred); ps(" px, blue "); pn(nblue); ps(" px"); nl(); }
    }
    if (nred <= 20) { ps("FAIL red only "); pn(nred); ps(" px"); nl(); bad = bad + 1; }
    if (nred > 20) {
        if (nblue <= 20) { ps("FAIL blue only "); pn(nblue); ps(" px"); nl(); bad = bad + 1; }
    }

    # ---- D1: THE RUNG'S ORACLE. Both submission orders, byte-identical. --------------------------
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dg_render_order(1);
    var d1 = dc_diff(DC_W, DC_H);
    ps("D1  both submission orders are byte-identical: ");
    if (d1 == 0) { ps("PASS"); nl(); }
    if (d1 != 0) { ps("FAIL "); pn(d1); ps(" differing px"); nl(); bad = bad + 1; }

    # ---- D2: FALSIFICATION. Painter's order (no depth test) MUST break D1. -----------------------
    # ⛔ THE GATE THAT MAKES D1 MEAN SOMETHING. Rendered without the z test, the second-submitted
    # triangle overwrites the first wherever they overlap, so the two orders MUST differ. If this
    # comes back green, D1 is not measuring the depth test and the whole file is decoration.
    # ⚠ Implemented by giving every triangle the SAME z, which makes every overlap a tie and hands
    # the pixel to submission order -- exactly painter's behaviour, using the shipped renderer rather
    # than a second code path that could disagree with it for unrelated reasons.
    dc_corpus_coplanar(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    dc_snapshot(DC_W, DC_H);
    dc_corpus_coplanar(1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var d2 = dc_diff(DC_W, DC_H);
    ps("D2  co-planar (every overlap a TIE) IS order-dependent -- D1 is connected: ");
    if (d2 != 0) { ps("RED (correct), "); pn(d2); ps(" differing px"); nl(); }
    if (d2 == 0) {
        ps("** GATE NOT CONNECTED: even a pure tie was order-independent **"); nl();
        bad = bad + 1;
    }

    # ---- D3: DETERMINISM. The same input twice must give the same output, bit for bit. ------------
    # ⚠ On iron this is the check that separates "wrong" from "nondeterministic", and the rung's own
    # failure table says a difference between two identical frames IS the finding (a wave race). On
    # the host it can only ever pass -- which is exactly why it belongs here as the CONTROL: if it
    # ever fails here, the reference itself has state it should not have.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dg_render_order(0);
    var d3 = dc_diff(DC_W, DC_H);
    ps("D3  identical input renders identically (the reference is stateless): ");
    if (d3 == 0) { ps("PASS"); nl(); }
    if (d3 != 0) { ps("FAIL "); pn(d3); ps(" px"); nl(); bad = bad + 1; }

    # ---- D4: THE NEAREST TRIANGLE WINS, checked against an independently computed answer. ---------
    # ⭐ AN EXTERNAL INVARIANT, not agreement with another implementation. At a pixel covered by both,
    # the colour must be whichever triangle has the smaller interpolated z there -- recomputed here
    # from the vertices directly rather than trusting the renderer's own bookkeeping.
    # [[feedback_oracle_must_test_external_invariant]]
    dg_render_order(0);
    var d4 = 0;
    var d4n = 0;
    var y2 = 0;
    while (y2 < DC_H) {
        var x2 = 0;
        while (x2 < DC_W) {
            var got = load32(&dc_cbuf + (y2 * DC_W + x2) * 4) & 0xFFFFFFFF;
            if (got != DC_BG) {
                var zr = dg_z_at(0, x2, y2);
                var zb = dg_z_at(1, x2, y2);
                # both cover this pixel?
                if (zr >= 0) {
                    if (zb >= 0) {
                        d4n = d4n + 1;
                        var want = DC_RED;
                        if (zb < zr) { want = DC_BLUE; }
                        if (got != want) { d4 = d4 + 1; }
                    }
                }
            }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    ps("D4  on every shared pixel the NEARER triangle won ("); pn(d4n); ps(" checked): ");
    if (d4 == 0) { ps("PASS"); nl(); }
    if (d4 != 0) { ps("FAIL "); pn(d4); ps(" px"); nl(); bad = bad + 1; }
    if (d4n < 20) {
        ps("    ** only "); pn(d4n); ps(" shared pixels -- D4 proves little **"); nl();
        bad = bad + 1;
    }

    # ==============================================================================================
    # ⭐⭐ D0d / D0e / D5 / D6 / D7 — ADDED 2026-07-29 (plan bite B2), BECAUSE EVERY GATE ABOVE
    #     RUNS ON A CORPUS MEASURED BLIND TO THE TWO THINGS THIS RUNG IS ABOUT.
    # ==============================================================================================
    # See dc_corpus_precision's block in depthcore.cyr for the measured table. Two sentences of it:
    # a divide one ULP short changes **0 of 1024 pixels** here, and `dc_ties == 0` (D0a) **is**
    # order-invariance, so "walks the list in submission order" is currently tested by nothing.
    # ⚠ NUMBERING: the plan calls the quad gate "D3", but D3 is already the determinism control
    # above. Numbered D5 here and corrected in planning/rung17-tri-depth.md rather than shadowing a
    # shipped gate name -- two gates called D3 is the ATOM_DRY defect one level up.
    nl();

    # ---- D0d: THE PRECISION FRAME IS ULP-SENSITIVE, and that is MEASURED, not assumed. -----------
    # ⛔ Pre-registered as a gate rather than discovered post-burn: if a +1 uniform z error on one
    # triangle moves nothing HERE either, then no frame in this tree can witness a divide error and
    # the burn cannot fail on the rung's only novel content.
    dc_corpus_precision(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var pties = dc_ties;
    dc_snapshot(DC_W, DC_H);
    dc_set(1, 2, dc_get(1, 2) + 1);        # +1 on all three vertex z of triangle 1 == a uniform
    dc_set(1, 5, dc_get(1, 5) + 1);        # one-ULP error in its interpolated z everywhere
    dc_set(1, 8, dc_get(1, 8) + 1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var pulp = dc_diff(DC_W, DC_H);
    # ⭐ THE TWO ENDPOINTS, RE-MEASURED EVERY RUN. Span 800 is the shipped corpus (blind because the
    # gradient dwarfs a ULP); span 1 is blind for the OPPOSITE reason -- every shared pixel ties, so
    # the strict `<` hands them all to the incumbent either way. Sensitivity is NOT monotone in the
    # span, and a retune "tighter is finer" lands straight on the second null set. Asserted, not
    # commented, so that cannot happen silently.
    var pnarrow = dg_ulp_flips(1);
    var pwide   = dg_ulp_flips(800);
    # Threshold 20 against a measured 42 at the swept optimum. ⚠ Deliberately NOT set just under 42:
    # the span-1 row of that sweep flips ZERO, so a frame retuned "tighter" fails this loudly instead
    # of drifting down to a number a tight threshold would have to be relaxed to accommodate.
    ps("D0d PRECISION frame (span "); pn(DC_PREC_SPAN); ps("): a ONE-ULP z error flips ");
    pn(pulp); ps(" px ("); pn(pties); ps(" ties): ");
    if (pulp >= 20) { ps("PASS -- the frame can witness a ULP"); nl(); }
    if (pulp < 20) {
        ps("FAIL -- still nearly blind; no frame in this tree can catch a broken divide"); nl();
        bad = bad + 1;
    }
    ps("    endpoints: span 1 flips "); pn(pnarrow); ps(" (ALL shared px tie -> blind), span 800 flips ");
    pn(pwide); ps(" (the shipped corpus -> blind): ");
    if (pulp > pnarrow) {
        if (pulp > pwide) { ps("PASS -- the chosen span beats both"); nl(); }
    }
    if (pulp <= pnarrow) {
        ps("FAIL -- a tighter span is no worse, so the non-monotonicity claim is wrong"); nl();
        bad = bad + 1;
    }
    if (pulp > pnarrow) {
        if (pulp <= pwide) {
            ps("FAIL -- the shipped wide corpus is no worse, so this frame buys nothing"); nl();
            bad = bad + 1;
        }
    }

    # ---- D0e: THE SENTINEL. Render at the value IRON ACTUALLY BURNS. -----------------------------
    # ⛔ Every call site above passes DC_FAR = 1,000,000, which is SMALLER than the ABI's own legal z
    # ceiling (2^24-1 = 16,777,215). The reference's clear plane has been sitting IN FRONT of legal
    # geometry for the whole rung, and the hardware value 0xFFFFFFFF has never once been exercised.
    # ⚠ This is the frame where the signed-vs-unsigned pin bites: under `v_cmp_lt_i32`, 0xFFFFFFFF is
    # -1, i.e. the NEAREST possible value, so nothing ever draws -- and a blank frame is byte-identical
    # in both orders, so D1 goes GREEN. That is the single most expensive wrong pick on this rung.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dc_corpus(0);
    dc_render(DC_W, DC_H, DC_ZCLEAR_HW, DC_BG);
    var d0e = dc_diff(DC_W, DC_H);
    var d0ecov = dc_covered(DC_W, DC_H, DC_BG);
    ps("D0e clearing at the HARDWARE far value 0xFFFFFFFF draws the same image ("); pn(d0ecov);
    ps(" px): ");
    if (d0e == 0) {
        if (d0ecov > 200) { ps("PASS"); nl(); }
    }
    if (d0e != 0) { ps("FAIL "); pn(d0e); ps(" px differ"); nl(); bad = bad + 1; }
    if (d0e == 0) {
        if (d0ecov <= 200) {
            ps("FAIL -- identical but EMPTY, which is what a signed compare produces"); nl();
            bad = bad + 1;
        }
    }
    ps("    the far value exceeds every legal z (>= 2^24), so an UNSIGNED compare is behind all geometry: ");
    if (DC_ZCLEAR_HW > DC_ZMAX) { ps("PASS"); nl(); }
    if (DC_ZCLEAR_HW <= DC_ZMAX) { ps("FAIL"); nl(); bad = bad + 1; }
    ps("    ⚠ but DC_FAR = "); pn(DC_FAR); ps(" is BELOW the legal z ceiling "); pn(DC_ZMAX);
    ps(" -- the reference's own clear plane sits in front of legal geometry"); nl();

    # ---- D5: THE QUAD. The ONLY witness that the list is walked in SUBMISSION ORDER. -------------
    # ⭐ And the claim is sharper than "the two orders differ": at a tie the STRICT `<` keeps the
    # incumbent, so the FIRST-submitted triangle must win every tie. Order 0 submits red first, order
    # 1 submits blue first ⇒ every differing pixel must be RED in order 0 and BLUE in order 1.
    # A shader walking the list BACKWARDS gets this exactly inverted; "they differ" alone would not.
    dc_corpus_quad(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var qties = dc_ties;
    dc_snapshot(DC_W, DC_H);
    dc_corpus_quad(1);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var qdiff = 0;
    var qwrong = 0;
    var qi = 0;
    while (qi < DC_W * DC_H) {
        var qa = load32(&dc_snap + qi * 4) & 0xFFFFFFFF;
        var qb = load32(&dc_cbuf + qi * 4) & 0xFFFFFFFF;
        if (qa != qb) {
            qdiff = qdiff + 1;
            if (qa != DC_RED)  { qwrong = qwrong + 1; }
            if (qb != DC_BLUE) { qwrong = qwrong + 1; }
        }
        qi = qi + 1;
    }
    ps("D5  QUAD frame ("); pn(qties); ps(" ties): the two orders DIFFER at "); pn(qdiff);
    ps(" px: ");
    if (qdiff > 0) { ps("RED (correct -- submission order is now observable)"); nl(); }
    if (qdiff == 0) {
        ps("** NOT CONNECTED: a shared diagonal produced no ties, so nothing tests list order **"); nl();
        bad = bad + 1;
    }
    ps("    and the FIRST-submitted triangle won every one of them: ");
    if (qwrong == 0) { ps("PASS"); nl(); }
    if (qwrong != 0) {
        ps("FAIL "); pn(qwrong); ps(" -- the list is being resolved in the WRONG order"); nl();
        bad = bad + 1;
    }

    # ---- D6: OFF-ORIGIN. The residue domain, and the corner bound's real workout. ----------------
    # ⚠ Scope stated honestly: this is byte-identity against the translated original, which is BLIND
    # to a half-pixel convention error (a constant sample offset commutes with integer translation --
    # the plan rejects translation equivariance as *the* external gate for exactly that reason). Its
    # value is the ARITHMETIC domain it opens: |KC| goes from ~1e5 to ~2e11, 39 bits, which is where
    # depthmodel's A5 finally has a residue worth checking.
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    dc_ox = DC_OFF_X;
    dc_corpus_offorigin(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var d6 = dc_diff(DC_W, DC_H);
    var d6cov = dc_covered(DC_W, DC_H, DC_BG);
    dc_ox = 0;
    ps("D6  OFF-ORIGIN (window at x=DC_OFF_X) renders the translated figure identically ("); pn(d6cov);
    ps(" px): ");
    if (d6 == 0) {
        if (d6cov > 200) { ps("PASS"); nl(); }
    }
    if (d6 != 0) { ps("FAIL "); pn(d6); ps(" px differ"); nl(); bad = bad + 1; }
    if (d6 == 0) {
        if (d6cov <= 200) { ps("FAIL -- identical but EMPTY"); nl(); bad = bad + 1; }
    }

    # ---- D7: THE COVERAGE MAP, printed in the gate rather than discovered after the burn. --------
    # ⭐ The dispatch is one workgroup per 8x8 tile, so the 32x32 corpus is 16 tiles. A tile with no
    # DUAL-COVERED pixel cannot distinguish a depth-tested shader from a painter's-order one, and a
    # tile with no coverage at all is byte-identical for a shader that never ran in it. Knowing which
    # tiles those are BEFORE the flash is the difference between "3 tiles wrong" being a signal and
    # being noise.
    dg_render_order(0);
    var tdual = 0; var tdrawn = 0; var tempty = 0;
    var ty = 0;
    while (ty < 4) {
        var tx = 0;
        while (tx < 4) {
            var ndual = 0; var ndrawn = 0;
            var yy = 0;
            while (yy < 8) {
                var xx = 0;
                while (xx < 8) {
                    var gx = tx * 8 + xx;
                    var gy = ty * 8 + yy;
                    if ((load32(&dc_cbuf + (gy * DC_W + gx) * 4) & 0xFFFFFFFF) != DC_BG) {
                        ndrawn = ndrawn + 1;
                    }
                    if (dg_z_at(0, gx, gy) >= 0) {
                        if (dg_z_at(1, gx, gy) >= 0) { ndual = ndual + 1; }
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            if (ndual > 0)   { tdual  = tdual + 1; }
            if (ndrawn > 0)  { tdrawn = tdrawn + 1; }
            if (ndrawn == 0) { tempty = tempty + 1; }
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    ps("D7  tile coverage of the 16 dispatch tiles: "); pn(tdual);
    ps(" discriminate depth, "); pn(tdrawn); ps(" draw anything, "); pn(tempty);
    ps(" are ENTIRELY EMPTY"); nl();
    ps("    ⇒ "); pn(16 - tdual); ps(" tiles prove nothing about z (a painter's-order shader is");
    ps(" byte-identical there), and "); pn(tempty);
    ps(" are byte-identical for a shader that never ran: ");
    if (tdual >= 4) { ps("PASS"); nl(); }
    if (tdual < 4) { ps("FAIL -- too few discriminating tiles to interpret a burn"); nl(); bad = bad + 1; }

    # ---- D8: THE CORNER BOUND, and the shortcut it rests on, PROVEN rather than assumed ---------
    # ⭐ The validator (plan 1.4 rule 18) will bound `w0 w1 w2 zn` by evaluating them at the FOUR
    # CORNERS of the draw rect only, on the grounds that all four are affine in (x,y) so their
    # extremes must lie at corners. That reasoning is correct but it is *reasoning*, and it is the
    # only thing standing between an ABI-legal record and a 32-bit lane silently wrapping. So D8
    # checks it against brute force: the corner maximum must EQUAL the maximum over every pixel of
    # the rect. If a cheaper bound is ever substituted, this is what refuses it.
    # ⛔ An attacker found a triangle that passes every other proposed rule and peaks at 1.52x a
    # 32-bit lane over its own bounding box while its INSIDE peak is legal -- which is why this
    # evaluates unconditionally and why an inside-only bound is not a bound at all.
    dg_render_order(0);
    var cmax = 0;
    var fmax = 0;
    var td = 0;
    while (td < dc_n) {
        var c1 = dg_absmax_at(td, 0, 0);
        var c2 = dg_absmax_at(td, DC_W - 1, 0);
        var c3 = dg_absmax_at(td, 0, DC_H - 1);
        var c4 = dg_absmax_at(td, DC_W - 1, DC_H - 1);
        if (c1 > cmax) { cmax = c1; }
        if (c2 > cmax) { cmax = c2; }
        if (c3 > cmax) { cmax = c3; }
        if (c4 > cmax) { cmax = c4; }
        var fy2 = 0;
        while (fy2 < DC_H) {
            var fx2 = 0;
            while (fx2 < DC_W) {
                var v = dg_absmax_at(td, fx2, fy2);
                if (v > fmax) { fmax = v; }
                fx2 = fx2 + 1;
            }
            fy2 = fy2 + 1;
        }
        td = td + 1;
    }
    ps("D8  corner bound "); pn(cmax); ps(" == brute-force whole-rect maximum "); pn(fmax);
    ps(", both under 2^31: ");
    if (cmax == fmax) {
        if (cmax < 2147483648) { ps("PASS -- the four-corner shortcut is sound on real data"); nl(); }
    }
    if (cmax != fmax) {
        ps("FAIL -- the extreme is NOT at a corner, so the validator's rule is unsound"); nl();
        bad = bad + 1;
    }
    if (cmax == fmax) {
        if (cmax >= 2147483648) {
            ps("FAIL -- the corpus itself exceeds a 32-bit lane"); nl();
            bad = bad + 1;
        }
    }

    # ---- D9: WINDING IS A LABELLING CONVENTION, and the normalisation must actually run ---------
    # ⛔ Both shipped triangles wind POSITIVE (areas 2688 and 2704) and every derived frame inherits
    # it, so before this frame existed the normalisation added at B3 was dead code in every test in
    # the tree. `dc_wind_flips` separates "fired and was right" from "never fired".
    dg_render_order(0);
    dc_snapshot(DC_W, DC_H);
    var wfn = dc_wind_flips;
    dc_corpus_reversed(0);
    dc_render(DC_W, DC_H, DC_FAR, DC_BG);
    var d9 = dc_diff(DC_W, DC_H);
    var wfr = dc_wind_flips;
    ps("D9  REVERSED winding renders identically (diff="); pn(d9); ps("); normalisation fired ");
    pn(wfr); ps(" times vs "); pn(wfn); ps(" on the normal frame: ");
    if (d9 == 0) {
        if (wfr > 0) {
            if (wfn == 0) { ps("PASS"); nl(); }
        }
    }
    if (d9 != 0) {
        ps("FAIL -- relabelling two vertices changed the image, which no correct raster can do"); nl();
        bad = bad + 1;
    }
    if (d9 == 0) {
        if (wfr == 0) {
            ps("** NOT CONNECTED: the normalisation never ran on the reversed frame **"); nl();
            bad = bad + 1;
        }
    }
    if (d9 == 0) {
        if (wfn != 0) {
            ps("** the NORMAL frame also flipped -- the two frames are not distinct **"); nl();
            bad = bad + 1;
        }
    }

    nl();
    # ---- D10 (G7): CONSTANT-Z SILHOUETTE vs THE INDEPENDENTLY BURNED 2D PATH -------------------
    var d10 = dg_g7();
    var d10cov = dg_g7_cov;
    var d10bad_prep = dg_g7_prep;
    ps("D10 EXTERNAL: constant-z silhouette == the burned 2D path (tri_prep, 16.16 sample, pixel");
    ps(" vertices) over "); pn(d10cov); ps(" covered px: ");
    if (d10 == 0) {
        if (d10cov > 200) {
            if (d10bad_prep == 0) { ps("PASS -- both half-pixel conventions agree"); nl(); }
        }
    }
    if (d10 != 0) {
        ps("FAIL "); pn(d10); ps(" px disagree -- ONE OF THE TWO SAMPLE CONVENTIONS IS WRONG"); nl();
        bad = bad + 1;
    }
    if (d10 == 0) {
        if (d10cov <= 200) { ps("FAIL -- silhouette essentially empty, nothing compared"); nl(); bad = bad + 1; }
    }
    if (d10bad_prep != 0) {
        ps("FAIL -- tri_prep refused a corpus triangle, so it witnessed nothing"); nl();
        bad = bad + 1;
    }

    # ---- D11 (G8): THE INTERPENETRATION LINE, DERIVED WITHOUT RENDERING ANYTHING ---------------
    # ⭐ THE ONE GATE THAT TESTS THE GEOMETRY OF THE DEPTH DECISION RATHER THAN ITS BYTES. Each
    # triangle's depth is a plane in 3-space fitted from its three (x,y,z) vertices by a single cross
    # product -- no edge function, no barycentric weight, no hoist. Two planes meet in a LINE, and
    # `z_0(x,y) = z_1(x,y)` is that line, obtainable on the CPU before anything is drawn.
    #   D11a -- the fitted plane and the barycentric interpolation are the SAME rational at every
    #           covered pixel: `(a*X + b*Y + c) * area == zn * d`, cross-multiplied, exact integers.
    #           This validates the entire edge-function machinery against a route that shares no code.
    #   D11b -- on every dual-covered pixel the winner is on the correct side of that line.
    # Neither the shader nor `depthcore` can fake either one.
    dg_g8();
    var p11a = dg_g8a_bad; var n11a = dg_g8a_n;
    var p11b = dg_g8b_bad; var n11b = dg_g8b_n; var online = dg_g8_online;
    ps("D11a EXTERNAL: the 3D plane fit == the barycentric interpolation at all "); pn(n11a);
    ps(" covered px: ");
    if (p11a == 0) {
        if (n11a > 400) { ps("PASS"); nl(); }
    }
    if (p11a != 0) { ps("FAIL "); pn(p11a); ps(" px"); nl(); bad = bad + 1; }
    if (p11a == 0) {
        if (n11a <= 400) { ps("FAIL -- too few covered px to mean anything"); nl(); bad = bad + 1; }
    }
    ps("D11b EXTERNAL: every one of "); pn(n11b);
    ps(" dual-covered px is on the correct side of the analytic interpenetration line (");
    pn(online); ps(" exactly ON it): ");
    if (p11b == 0) {
        if (n11b > 100) { ps("PASS"); nl(); }
    }
    if (p11b != 0) { ps("FAIL "); pn(p11b); ps(" violations"); nl(); bad = bad + 1; }
    if (p11b == 0) {
        if (n11b <= 100) {
            ps("FAIL -- too few discriminating px; the line is untested"); nl();
            bad = bad + 1;
        }
    }

    # ---- ⭐⭐ AND NOW PROVE ALL THREE CAN FAIL -----------------------------------------------------
    # All three passed on their first run. That is exactly the situation in which "the gate is right"
    # and "the gate is inert" are indistinguishable, and it is how rung 15's half-texel reached iron.
    # ⛔ M-D10 IS THE IMPORTANT ONE: it moves the 2D path's sample point from the pixel CENTRE to the
    # pixel CORNER -- a half-pixel convention error, the precise defect class that shipped at rung 15
    # past four green agreement gates. If D10 stayed green here it would be worthless.
    dg_mut_corner = 1;
    var md10 = dg_g7();
    dg_mut_corner = 0;
    ps("M-D10 sampling at the pixel CORNER instead of its centre (a HALF-PIXEL error): ");
    if (md10 > 0) { ps("RED (correct), "); pn(md10); ps(" px -- D10 can see the rung-15 defect class"); nl(); }
    if (md10 == 0) {
        ps("** NOT CONNECTED: a half-pixel shift changed nothing, so D10 proves nothing **"); nl();
        bad = bad + 1;
    }

    dg_mut_plane = 1;
    dg_g8();
    var md11a = dg_g8a_bad;
    dg_mut_plane = 0;
    ps("M-D11a fitted plane's constant term off by one: ");
    if (md11a > 0) { ps("RED (correct), "); pn(md11a); ps(" px"); nl(); }
    if (md11a == 0) { ps("** NOT CONNECTED **"); nl(); bad = bad + 1; }

    dg_mut_lflip = 1;
    dg_g8();
    var md11b = dg_g8b_bad;
    dg_mut_lflip = 0;
    ps("M-D11b interpenetration line's sense reversed: ");
    if (md11b > 0) { ps("RED (correct), "); pn(md11b); ps(" violations"); nl(); }
    if (md11b == 0) { ps("** NOT CONNECTED **"); nl(); bad = bad + 1; }

    nl();
    if (bad == 0) {
        ps("depthgate: PASS -- depth-tested rasterisation is ORDER-INDEPENDENT on a corpus proven"); nl();
        ps("           fair (no z-ties), truly interpenetrating, and non-empty; the co-planar"); nl();
        ps("           mutation shows the gate can fail. Rung 17's iron oracle is sound BEFORE"); nl();
        ps("           a single shader instruction exists."); nl();
        return 95;
    }
    ps("depthgate: FAIL -- "); pn(bad); ps(" propert(ies) broken; do NOT write the shader yet."); nl();
    return 90;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
