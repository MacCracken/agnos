[package]
name = "gpufill"
version = "0.1.0"
description = "agnos ring-3 CP-DMA fill proof (P9 / #13) — gpu_fill#85 + present#84 from userland: GPU-clears the blit back buffer red/green/blue with a PM4 DMA_DATA constant-fill on the compute ring and flips each to the scanout. Exits 95 iff every fill+present succeeded; the screen changing colour is the visual oracle."
license = "GPL-3.0-only"
language = "cyrius"
# ⚠ Tracks the KERNEL's pin, not the oldest version that happens to compile. tests/gpu binaries run
# INSIDE agnos and reach the kernel's syscalls, so a lagging pin here means the tools are built by a
# different compiler than the kernel they exercise — and a codegen difference between the two would
# surface as a GPU bug. Raised 6.4.74 -> 6.4.78 at rung 9a to match cyrius.cyml at the repo root.
# Raised 6.4.78 -> 6.5.20 and then -> 6.5.21 at 1.56.44, again to match the root — the root pin had
# drifted three minors behind the installed cycc, and 6.5.21 landed before the cut closed.
# Raised 6.5.21 -> 6.5.27 -> 6.5.28 -> 6.5.36 with the root at 1.56.51. Since 1.56.49 this is a
# GATE, not a convention: scripts/check/toolchain-pin-check.sh compares every manifest's pin
# string against the root's and fails the build on any disagreement.
cyrius = "6.6.20"

[build]
src = "gpufill.cyr"
output = "build/gpufill"

# syscalls -> SYS_EXIT, sys_uptime_ms (#40), sys_sched_yield (#44) and the GPU pair sys_gpu_fill (#85) /
# sys_gpu_present (#84), which landed in cyrius [6.4.70] (hence the pin) from this repo's ask
# docs/development/issues/archived/2026-07-21-gpu-present-fill-syscall-cyrius-wrappers.md. Those two are behind a
# file-level `#ifdef CYRIUS_TARGET_AGNOS` gate, so an off-agnos build fails to COMPILE rather than emitting
# Linux rmdir/creat. The result IS the exit code, read via the exec path's "run: exit N".
[deps]
# ⚠ 1.57.14 (cyrius 6.6.20): `alloc` names `poison` since 6.6.18 (under `#ifdef CYRIUS_POISON` — never compiled
# here, but `cyrius deps` walks includes textually and vendors it) — declared because `cyrius lib sync` copies only
# what is declared (the 1.57.2 tests/chan precedent).
# ⚠ 1.57.14: 42 of the .cyr files here — the host oracles (bigate, cpuref, doomcol, edgeasm, …) and the
# ring-3 gputri / gpudepth / gputex / gpuprof alike — `include "lib/io.cyr"` at SOURCE level, which no `[deps]`
# walk sees. Until here io's closure was undeclared and never vendored; it resolved from the pinned toolchain's
# lib only because no tests/gpu/lib/io.cyr existed, and a stale one left by an older vendoring would have shadowed
# the pin. `io` and its closure (`result`, `fmt` -> `vec`) are declared: `cyrius lib sync` == `cyrius deps`,
# 24/24 files `cmp`-equal to versions/6.6.20/lib.
stdlib = ["syscalls", "string", "args", "alloc", "atomic", "fnptr", "poison", "io", "result", "fmt", "vec"]
