# modeset — agnos ring-3 /bin/modeset. H3 of the modeset arc: the userland entry to the modeset seam.
#
# `run /bin/modeset --caps` (or bare) calls #93 gpu_modeset_op with a CAPS op and prints the modeset surface
# it discovered, then exits with a code that names the outcome — the klug-capturable oracle the gpu-test
# tools use (`run: exit NN`):
#
#   95 = caps read, display LIT and the modeset seam is live
#   96 = caps read, seam live, but NO lit display here (QEMU, or a dark port) — informational, not a failure
#   97 = #93 returned an ABI / validation error (decoded + printed: idx + reason)
#   98 = the LATCH is BLOCKED this boot — a previous modeset did not disarm (H2). Recover: rm /.modeset-armed
#   99 = the syscall returned an unexpected value
#
# The ACTUAL modeset (M-lane: dump / measure / OTG re-commit / transmitter) is iron work behind the arm-once
# latch, added as new op codes to this same #93 with NO new syscall number (decision D-3 / MD-4). H3 proves
# the seam: the tool reaches the kernel, the kernel validates a descriptor array and writes caps back, and
# the exit code is decisive under QEMU with no GPU.
#
# Uses the NAMED wrapper sys_gpu_modeset_op (cyrius >= 6.4.74, filed as
# 2026-07-23-gpu-modeset-op-93-cyrius-wrapper.md). It lives behind a FILE-LEVEL #ifdef CYRIUS_TARGET_AGNOS
# gate, so off-agnos it does not exist and a build referencing it fails at COMPILE time with no binary —
# which matters because on Linux x86_64 #93 is fchown.

# ── op codes + caps layout (mirror kernel syscall.cyr) ──
# record (64 B): +0 op · +4 flags(=0) · +8 out_uva(u64) · +16 out_len(u64) · +24..63 reserved(=0)
# caps  (32 B): +0 flags · +4 opmask · +8 h_active · +12 v_active · +16 h_total · +20 v_total
#               +24 pixclk_100hz · +28 refresh_mHz

fn m_puts(s): i64 {
    var n = 0;
    while (load8(s + n) != 0) { n = n + 1; }
    syscall(1, 1, s, n);
    return 0;
}
fn m_num(v): i64 {
    var buf[24];
    var i = 23;
    var neg = 0;
    var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    if (x == 0) { store8(&buf + i, 48); i = i - 1; }
    while (x > 0) { store8(&buf + i, 48 + x % 10); i = i - 1; x = x / 10; }
    if (neg == 1) { store8(&buf + i, 45); i = i - 1; }
    syscall(1, 1, &buf + i + 1, 23 - i);
    return 0;
}
fn m_nl(): i64 { syscall(1, 1, "\n", 1); return 0; }

# one "modeset: KEY=VAL" line
fn m_kv(k, v): i64 { m_puts("modeset: "); m_puts(k); m_puts("="); m_num(v); m_nl(); return 0; }

fn modeset_caps(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }   # zero the whole record
    store32(&rec + 0, 1);                                     # op = MDO_OP_CAPS (0x01)
    var caps[32];
    var c = 0;
    while (c < 8) { store32(&caps + c * 4, 0); c = c + 1; }
    store64(&rec + 8, &caps);                                 # out_uva
    store64(&rec + 16, 32);                                   # out_len

    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        m_puts("modeset: #93 error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(code & 0xFF); m_nl();
        m_puts("modeset: (reasons: 2=badop 3=outbuf 11=desc 12=reserved)"); m_nl();
        return 97;
    }
    if (r != 0) {
        m_puts("modeset: #93 returned unexpected "); m_num(r); m_nl();
        return 99;
    }

    var flags   = load32(&caps + 0);
    var opmask  = load32(&caps + 4);
    m_puts("modeset: caps OK"); m_nl();
    m_kv("opmask", opmask);
    m_kv("flags", flags);
    m_kv("h_active", load32(&caps + 8));
    m_kv("v_active", load32(&caps + 12));
    m_kv("h_total", load32(&caps + 16));
    m_kv("v_total", load32(&caps + 20));
    m_kv("pixclk_100hz", load32(&caps + 24));
    m_kv("refresh_mHz", load32(&caps + 28));

    # decode the flag bits into greppable words (machine + operator)
    if ((flags & 1) != 0)  { m_puts("modeset: latch-armable YES"); m_nl(); }
    if ((flags & 1) == 0)  { m_puts("modeset: latch-armable NO"); m_nl(); }
    if ((flags & 2) != 0)  { m_puts("modeset: display LIT"); m_nl(); }
    if ((flags & 2) == 0)  { m_puts("modeset: display DARK"); m_nl(); }
    if ((flags & 4) != 0)  { m_puts("modeset: atom AVAILABLE"); m_nl(); }
    if ((flags & 8) != 0)  { m_puts("modeset: pixclk MEASURED"); m_nl(); }

    if ((flags & 16) != 0) {
        m_puts("modeset: LATCH BLOCKED this boot -- a previous modeset did not disarm"); m_nl();
        m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
        return 98;
    }
    if ((flags & 2) != 0) { return 95; }    # display lit + seam live — the full-green result on iron
    return 96;                              # seam live, no lit display (QEMU / dark port) — informational
}

# M1/M2/M3 — trigger the read-only DCN pipe dump (#93 op 0x02). The dump itself prints `rd <off> <val>`
# to the KERNEL log (klug) progressively (hang-localising), so capture it with `run /bin/klug > m1.txt`;
# this call just triggers it and reports the outcome. Under QEMU (no DCN) it returns reason 1.
fn modeset_dump(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 2);                                    # op = MDO_OP_DUMP (0x02)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 dump error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        # reason 1 (no GPU / live pipe != 0) is the QEMU informational path, not a failure — 96 like caps
        # and --lock, so the exit code means the same thing across all three M-lane arg ops.
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 -- QEMU has no DCN"); m_nl(); return 96; }
        return 97;
    }
    m_puts("modeset: dump complete -- capture with:  run /bin/klug > m1.txt"); m_nl();
    return 95;
}

# M4 — trigger the OTG-lock proof (#93 op 0x03). The kernel op arms the H2 latch, takes the OTG master
# update lock, writes V_TOTAL back to its OWN value, re-arms the surface (VUPDATE trigger) and releases —
# a live-pipe write that changes nothing, so the lock MECHANISM is validated in isolation. Pass = lock
# acked AND I1 advanced AND no underflow, all printed to klug. This call triggers it and reports the
# outcome. Under QEMU (no DCN) it returns reason 1 -> 96. First WRITE bite of work list B — the latch is
# now live; disarm with `rm /.modeset-armed` when done.
#   95 = lock OK (acked, pipe kept scanning, no underflow)     97 = a hardware check failed (detail in klug)
#   96 = no GPU here (QEMU / dark port) -- informational        98 = latch would not arm (blocked / read-only fs)
fn modeset_lock(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 3);                                    # op = MDO_OP_LOCK (0x03)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 lock error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 4) {
            m_puts("modeset: latch would not arm -- blocked (prior modeset did not disarm) or read-only fs"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
            return 98;
        }
        if (reason == 5) { m_puts("modeset: LOCK did not ack -- master update lock timed out (see klug)"); m_nl(); return 97; }
        if (reason == 6) { m_puts("modeset: STALL -- I1 did not advance under the lock (see klug)"); m_nl(); return 97; }
        if (reason == 7) { m_puts("modeset: UNDERFLOW -- OPTC bit10 set after the lock (see klug)"); m_nl(); return 97; }
        m_puts("modeset: (reasons: 2=badop 3=outbuf 11=desc 12=reserved)"); m_nl();
        return 97;
    }
    if (r != 0) {
        m_puts("modeset: #93 lock returned unexpected "); m_num(r); m_nl();
        return 99;
    }
    m_puts("modeset: LOCK OK -- acked, pipe kept scanning, no underflow -- capture:  run /bin/klug"); m_nl();
    m_puts("modeset: disarm when done with:  rm /.modeset-armed"); m_nl();
    return 95;
}

# M5 — the first REAL modeset (#93 op 0x04). The kernel op arms the H2 latch, then runs A/B/C phases:
# measure the inherited refresh (v_total 1481), write v_total 1501, restore 1481 — each write watchdog-guarded
# (if the frame counter stops, the inherited V_TOTAL is restored in-kernel). The proof is I2 (frame-counted
# refresh, printed to klug): 1481->1501 must drop it 59.951->59.152 Hz, then restore. This call triggers it
# and reports the outcome. Under QEMU (no DCN) it returns reason 1 -> 96. The latch is live afterward; disarm
# with `rm /.modeset-armed`. Exit codes name the outcome for the burn tracker:
#   95 = FIRST MODESET COMMITTED (refresh moved to prediction + restored)   93 = refresh did NOT move (shadow-only)
#   96 = no GPU here (QEMU)                92 = moved but off prediction     91 = watchdog fired (pipe restored)
#   94 = refused: pipe not the calibrated mode / DRR on   97 = unmeasurable   98 = latch would not arm
#   90 = OPTC underflow -- timing may be live but scanout is CORRUPT (the free-running-instrument blind spot)
fn modeset_vtotal(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 4);                                    # op = MDO_OP_VTOTAL (0x04)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 vtotal error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 4) {
            m_puts("modeset: latch would not arm -- blocked (prior modeset did not disarm) or read-only fs"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
            return 98;
        }
        if (reason == 7) { m_puts("modeset: OPTC UNDERFLOW -- scanout corrupt though timing may be live (see klug)"); m_nl(); return 90; }
        if (reason == 8) { m_puts("modeset: refused -- V_TOTAL is not the calibrated 1480 (pipe not the known mode)"); m_nl(); return 94; }
        if (reason == 9) { m_puts("modeset: refused -- V_TOTAL_CONTROL nonzero (DRR/VRR on) -- untested path"); m_nl(); return 94; }
        if (reason == 10) { m_puts("modeset: WATCHDOG fired -- pipe stopped, inherited V_TOTAL restored (see klug)"); m_nl(); return 91; }
        if (reason == 13) { m_puts("modeset: refresh did NOT move -- write landed in shadow, VUPDATE never swapped (see klug)"); m_nl(); return 93; }
        if (reason == 14) { m_puts("modeset: refresh moved but OFF prediction -- totals or stride wrong (see klug)"); m_nl(); return 92; }
        if (reason == 15) { m_puts("modeset: refresh unmeasurable -- pipe not counting cleanly (see klug)"); m_nl(); return 97; }
        return 97;
    }
    if (r != 0) {
        m_puts("modeset: #93 vtotal returned unexpected "); m_num(r); m_nl();
        return 99;
    }
    m_puts("modeset: FIRST MODESET COMMITTED -- refresh moved 59.951->59.152->59.951 Hz -- capture:  run /bin/klug"); m_nl();
    m_puts("modeset: disarm when done with:  rm /.modeset-armed"); m_nl();
    return 95;
}

# M6 — the same-mode OTG envelope re-commit (#93 op 0x05). The kernel op arms the H2 latch, then
# DISABLES the pipe (OTG_MASTER_EN=0 — the panel blanks briefly), reprograms the full timing group with its
# own saved values, and re-enables (OTG_MASTER_EN=1). The proof is I1 (frame counter): it must STOP during
# the disable window and RESUME after enable, printed to klug. This is the envelope M8 (the transmitter) will
# run #4/#76 inside. Under QEMU (no DCN) it returns reason 1 -> 96. Disarm with `rm /.modeset-armed` after.
#   95 = envelope OK (stopped then resumed, rate restored)   89 = disable did NOT stop the pipe (envelope no-op)
#   96 = no GPU here (QEMU)             91 = pipe DARK -- did not resume (recover via H2)   90 = OPTC underflow
#   92 = off-rate after re-enable       94 = refused (not calibrated / DRR on)   97 = unmeasurable   98 = latch
# --pixclk — 1.56.33. Dispatch MDO_OP_PIXCLK (0x09) and REPORT THE REFUSAL AS A PASS.
#
# ⛔⛔ THIS FLAG WAS MISSING WHEN THE BURN WAS FIRST PRE-REGISTERED, and the gap is worth recording
# because of its shape: the kernel op landed, the dump group landed, the rubric said "run
# /bin/modeset --pixclk", and the tool had no such flag. It would have fallen through to usage —
# and "no output for --pixclk" is INDISTINGUISHABLE from "the op refused silently", which is exactly
# the class of burn line that cannot be adjudicated. Caught by the operator's stage-check reporting
# the binary as byte-identical: it was, because nothing had been written here yet.
#
# ⭐ REASON 24 (MDO_E_NOPLL) IS THE EXPECTED, CORRECT ANSWER and exits 95. `pll_id` is #12's `phyid`
# and no rule derives it from silicon yet, so the kernel refuses rather than guessing. Reporting
# that as a failure would train the operator to treat the safety property as a defect.
#   95 = refused with MDO_E_NOPLL -- THE PASS      96 = no GPU / no live display (QEMU)
#   87 = refused with MDO_E_DTOCLK -- the pipe reports a DTO clock, so #12 is the wrong command
#        for it. **STOP**: burn 1 read DP_DTO_ENABLE clear and the cold path is built on #12.
#   89 = got past gpu_pll_discover (refusal ordering wrong)   88 = #12 EXECUTED -- STOP
#   94 = some other refusal -- read it against MDO_E_* before proceeding
fn modeset_pixclk(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 9);                                    # op = MDO_OP_PIXCLK (0x09)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 pixclk idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 24) {
            m_puts("modeset: REFUSED with MDO_E_NOPLL -- and that is the PASS."); m_nl();
            m_puts("modeset:   the DTO is off, so this pipe is PLL-driven and ATOM #12 is the right"); m_nl();
            m_puts("modeset:   command for it. Only the INSTANCE is underived, so the kernel refuses"); m_nl();
            m_puts("modeset:   instead of guessing. pll_id 0/1/2 make ATOM #12 bail with ZERO"); m_nl();
            m_puts("modeset:   writes -- a clean return that reads exactly like success."); m_nl();
            return 95;
        }
        # ⛔ 25 IS NOT A PASS ON THIS PANEL. Burn 1 read DP_DTO_ENABLE clear, which is what makes #12
        # the right mechanism at all; 25 means that bit came back SET. Either a DP output is driving
        # this pipe or the discriminator is reading the wrong register — and the cold path is built
        # on #12, so it must not proceed until that is settled. A separate exit from 94's generic
        # "unexpected refusal" because this one names its own next step.
        if (reason == 25) {
            m_puts("modeset: REFUSED with MDO_E_DTOCLK -- this pipe reports a DTO-driven clock."); m_nl();
            m_puts("modeset: ** UNEXPECTED on this panel ** -- burn 1 read DP_DTO_ENABLE CLEAR, and"); m_nl();
            m_puts("modeset: the whole cold path assumes #12 (a PLL command) is the right mechanism."); m_nl();
            m_puts("modeset: Re-read PIXEL_RATE_CNTL on BASE_IDX 1 before any clock work. STOP."); m_nl();
            return 87;
        }
        if (reason == 1) { m_puts("modeset: no GPU / no live display -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 23) {
            m_puts("modeset: derived OK but this build cannot execute #12 (ATOM_RUN_PIXCLK unset)"); m_nl();
            m_puts("modeset: ** UNEXPECTED at this cut ** -- it got PAST gpu_pll_discover, which"); m_nl();
            m_puts("modeset: refuses unconditionally. The refusal ordering is wrong. STOP."); m_nl();
            return 89;
        }
        m_puts("modeset: unexpected refusal -- read the reason against MDO_E_* before proceeding"); m_nl();
        return 94;
    }
    m_puts("modeset: ** #12 RETURNED SUCCESS ** -- it should be unreachable in this build."); m_nl();
    m_puts("modeset: STOP. A clock command executed that nothing was supposed to be able to run."); m_nl();
    return 88;
}

fn modeset_recommit(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 5);                                    # op = MDO_OP_RECOMMIT (0x05)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 recommit error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 4) {
            m_puts("modeset: latch would not arm -- blocked (prior modeset did not disarm) or read-only fs"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
            return 98;
        }
        if (reason == 8) { m_puts("modeset: refused -- V_TOTAL is not the calibrated 1480 (pipe not the known mode)"); m_nl(); return 94; }
        if (reason == 9) { m_puts("modeset: refused -- V_TOTAL_CONTROL nonzero (DRR/VRR on) -- untested path"); m_nl(); return 94; }
        if (reason == 16) { m_puts("modeset: OTG_MASTER_EN=0 did NOT stop the pipe -- the envelope is a no-op (see klug)"); m_nl(); return 89; }
        if (reason == 17) {
            m_puts("modeset: pipe DARK -- stopped but did NOT resume after re-enable (see klug)"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed  then power-cycle (H2)"); m_nl();
            return 91;
        }
        if (reason == 7) { m_puts("modeset: OPTC UNDERFLOW -- envelope corrupted scanout (see klug)"); m_nl(); return 90; }
        if (reason == 14) { m_puts("modeset: off-rate -- refresh did not return to the inherited value (see klug)"); m_nl(); return 92; }
        if (reason == 15) { m_puts("modeset: unmeasurable -- pipe resumed but will not count (see klug)"); m_nl(); return 97; }
        return 97;
    }
    if (r != 0) {
        m_puts("modeset: #93 recommit returned unexpected "); m_num(r); m_nl();
        return 99;
    }
    m_puts("modeset: RECOMMIT OK -- envelope 0->reprogram->1, stopped then resumed"); m_nl();
    m_puts("modeset: ⚠ EYE-CHECK the panel -- a green OK with a BLACK screen = the underflow-dark case (power-cycle, H2)"); m_nl();
    m_puts("modeset: capture:  run /bin/klug   then disarm:  rm /.modeset-armed"); m_nl();
    return 95;
}

# M8 — the TRANSMITTER (#93 op 0x06). The DVI->HDMI encoder (+ PHY) edge run INSIDE M6's iron-proven OTG
# envelope: BE<->FE disconnect -> ATOM #4 DIGxEncoderControl -> infoframes -> BE<->FE connect -> ATOM #76
# DIG1TransmitterControl(ENABLE) -> replay -> OTG re-commit, all watchdog-guarded.
#
# ⛔ WHAT ACTUALLY RUNS IS A BUILD PROPERTY, NOT AN ARGUMENT — a ring-3 caller can never ask for the live PHY
# edge. A production kernel answers 94 (no HDMI_ATOM). An HDMI_ATOM build runs the envelope + #4 and SKIPS
# #76 (cannot blank). Only a kernel ALSO built with ATOM_RUN_TRANSMITTER fires the real transmitter.
#
# ⛔ THIS IS NOT THE AUDIO FIX — that framing is falsified. The oracles here are DISPLAY SURVIVAL and an
# unchanged refresh; audio is M9's separate test. EYE-CHECK the panel: the kernel instruments free-run off
# the OTG PLL and cannot see a black screen.
#   95 = envelope survived the edge   94 = refused (no HDMI_ATOM / not the calibrated mode / DRR on)
#   96 = no GPU here (QEMU)           93 = an ATOM step failed        91 = pipe dark (watchdog fired)
#   89 = disable did not stop         92 = off-rate   90 = OPTC underflow   88 = BE<->FE bracket failed
#   97 = unmeasurable                 98 = latch would not arm
fn modeset_transmitter(): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, 6);                                    # op = MDO_OP_TRANSMIT (0x06)
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 transmit error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 / no live DIG -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 4) {
            m_puts("modeset: latch would not arm -- blocked (prior modeset did not disarm) or read-only fs"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
            return 98;
        }
        if (reason == 18) {
            m_puts("modeset: refused -- this kernel was NOT built with HDMI_ATOM, so no ATOM table can run"); m_nl();
            m_puts("modeset: (that is the safety model: a production kernel cannot drive the PHY)"); m_nl();
            return 94;
        }
        if (reason == 19) { m_puts("modeset: an ATOM step FAILED (vbios/parse/init or a table returned nonzero) -- see klug"); m_nl(); return 93; }
        if (reason == 20) { m_puts("modeset: BE<->FE reconnect did not read back -- routing not restored (see klug)"); m_nl(); return 88; }
        if (reason == 8) { m_puts("modeset: refused -- V_TOTAL is not the calibrated 1480 (pipe not the known mode)"); m_nl(); return 94; }
        if (reason == 9) { m_puts("modeset: refused -- V_TOTAL_CONTROL nonzero (DRR/VRR on) -- untested path"); m_nl(); return 94; }
        if (reason == 16) { m_puts("modeset: OTG_MASTER_EN=0 did NOT stop the pipe -- envelope is a no-op (see klug)"); m_nl(); return 89; }
        if (reason == 17) {
            m_puts("modeset: pipe DARK after the edge -- the watchdog ran (see klug for whether it relit)"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed  then power-cycle (H2)"); m_nl();
            return 91;
        }
        if (reason == 7) { m_puts("modeset: OPTC UNDERFLOW -- the edge corrupted scanout (see klug)"); m_nl(); return 90; }
        if (reason == 14) { m_puts("modeset: off-rate -- refresh did not return to the inherited value (see klug)"); m_nl(); return 92; }
        if (reason == 15) { m_puts("modeset: unmeasurable -- pipe resumed but will not count (see klug)"); m_nl(); return 97; }
        return 97;
    }
    if (r != 0) {
        m_puts("modeset: #93 transmit returned unexpected "); m_num(r); m_nl();
        return 99;
    }
    m_puts("modeset: TRANSMIT OK -- the enveloped encoder edge survived, rate restored"); m_nl();
    m_puts("modeset: ⚠ EYE-CHECK the panel -- a green OK with a BLACK screen = the underflow-dark case (power-cycle, H2)"); m_nl();
    m_puts("modeset: capture:  run /bin/klug   then disarm:  rm /.modeset-armed"); m_nl();
    return 95;
}

# ── M9: the two AUDIO arms. `--audio-pre` (op 0x07) and `--audio-post` (op 0x08).
#
# ⛔ THESE TWO ARE ONE EXPERIMENT WITH ONE VARIABLE. The kernel routes both into the SAME
# mdo_transmit_run(arm) — same envelope, same watchdog, same H1 spill, and provably identical
# staging (the host-side --plan-diff proves the write lists differ ONLY in the position of one
# 5-op block). The ONLY difference is where the unmute lands relative to the transmitter edge:
#   --audio-pre   unmute BEFORE the edge  = what agnos has always done  = the CONTROL
#   --audio-post  unmute AFTER  the edge  = what amdgpu does (+22.2 ms) = the TREATMENT
#
# ⚠ Run BOTH in ONE boot, and do not tell the ear which is which beforehand. One sink state,
# one cable, one volume — a cross-boot comparison cannot control the sink's latched state
# ([[feedback_ear_oracle_needs_negative_control]]).
#
# ⚠ A kernel without MODESET_AUDIO ∧ ATOM_TX_CYCLE does not ADVERTISE these ops and answers
# MDO_E_BADOP (reason 2) -> exit 87, which reads as "wrong kernel", never as a silent no-op.
fn modeset_audio(op: i64, name: i64): i64 {
    var rec[64];
    var i = 0;
    while (i < 16) { store32(&rec + i * 4, 0); i = i + 1; }
    store32(&rec + 0, op);
    var r = sys_gpu_modeset_op(&rec, 64);
    if (r < 0) {
        var code = 0 - r;
        var reason = code & 0xFF;
        m_puts("modeset: #93 audio error idx="); m_num(code >> 8);
        m_puts(" reason="); m_num(reason); m_nl();
        if (reason == 2) {
            m_puts("modeset: op NOT ADVERTISED -- this kernel lacks MODESET_AUDIO and/or ATOM_TX_CYCLE."); m_nl();
            m_puts("modeset: WRONG KERNEL for the M9 arms. Build with both, or the control and the"); m_nl();
            m_puts("modeset: treatment would be the same experiment under two names."); m_nl();
            return 87;
        }
        if (reason == 1) { m_puts("modeset: no GPU / live pipe != 0 / no live DIG -- QEMU has no DCN"); m_nl(); return 96; }
        if (reason == 4) {
            m_puts("modeset: latch would not arm -- blocked or read-only fs"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed"); m_nl();
            return 98;
        }
        if (reason == 18) { m_puts("modeset: refused -- not built with HDMI_ATOM"); m_nl(); return 94; }
        if (reason == 19) { m_puts("modeset: an ATOM step FAILED -- see klug"); m_nl(); return 93; }
        if (reason == 20) { m_puts("modeset: BE<->FE reconnect did not read back -- see klug"); m_nl(); return 88; }
        if (reason == 21) {
            m_puts("modeset: PHY DOWN -- #76 DISABLE took but ENABLE failed. POWER-CYCLE."); m_nl();
            return 86;
        }
        if (reason == 22) {
            # ⛔ THE DISPLAY IS FINE. Reported AFTER the display verdict on purpose so that
            # "panel survived, audio refused" never reads as a modeset failure.
            m_puts("modeset: AUDIO REFUSED -- the DISPLAY IS FINE; the audio half did not program."); m_nl();
            m_puts("modeset: this is NOT a dark panel. See klug for which half refused."); m_nl();
            return 85;
        }
        if (reason == 17) {
            m_puts("modeset: pipe DARK after the edge -- watchdog ran (see klug)"); m_nl();
            m_puts("modeset: recover with:  rm /.modeset-armed  then power-cycle (H2)"); m_nl();
            return 91;
        }
        if (reason == 7) { m_puts("modeset: OPTC UNDERFLOW -- see klug"); m_nl(); return 90; }
        if (reason == 14) { m_puts("modeset: off-rate -- refresh did not return (see klug)"); m_nl(); return 92; }
        if (reason == 23) {
            # ⛔ NOT a rate failure. The M9 burn printed "off-rate" for this and it read as a
            # timing problem when the actual cause was ATOM #76 ENABLE resetting DIG_MODE to DVI.
            m_puts("modeset: NO-HDMI -- the link did NOT end in HDMI signalling, so the HDMI"); m_nl();
            m_puts("modeset: block was INERT and no unmute could carry audio. The DISPLAY IS FINE."); m_nl();
            m_puts("modeset: This is NOT a result about sequencing -- both arms fail it identically."); m_nl();
            return 83;
        }
        if (reason == 15) { m_puts("modeset: unmeasurable (see klug)"); m_nl(); return 97; }
        return 97;
    }
    if (r != 0) { m_puts("modeset: #93 audio returned unexpected "); m_num(r); m_nl(); return 99; }
    m_puts("modeset: AUDIO ARM OK -- edge survived, rate restored, audio programmed"); m_nl();
    m_puts("modeset: ⚠ EYE-CHECK the panel AND EAR-CHECK the sink. rc 0 means the WRITES went"); m_nl();
    m_puts("modeset: out -- it does NOT mean sound came out. The ear is the oracle."); m_nl();
    m_puts("modeset: capture:  run /bin/klug   then disarm:  rm /.modeset-armed"); m_nl();
    return 95;
}

fn modeset_audio_pre(): i64  { m_puts("modeset: ARM 1 CONTROL   (unmute BEFORE the edge)"); m_nl(); return modeset_audio(7, 1); }
fn modeset_audio_post(): i64 { m_puts("modeset: ARM 2 TREATMENT (unmute AFTER the edge)");  m_nl(); return modeset_audio(8, 2); }

# `--dump` = the M1/M2/M3 read-only pipe dump; `--lock` = the M4 OTG-lock proof (WRITES under the latch);
# `--caps` (or bare) = the caps probe. argc/argv come from the kernel's parked init stack; if that ever
# reads 0 (the argv-init trap) the tool falls back to caps, so a bare `run /bin/modeset` always works.
fn modeset_main(): i64 {
    args_init();
    if (argc() >= 2) {
        var a1 = argv(1);
        if (streq(a1, "--dump") == 1) { return modeset_dump(); }
        if (streq(a1, "--lock") == 1) { return modeset_lock(); }
        if (streq(a1, "--vtotal") == 1) { return modeset_vtotal(); }
        if (streq(a1, "--recommit") == 1) { return modeset_recommit(); }
        if (streq(a1, "--pixclk") == 1) { return modeset_pixclk(); }
        if (streq(a1, "--transmitter") == 1) { return modeset_transmitter(); }
        if (streq(a1, "--audio-pre") == 1) { return modeset_audio_pre(); }
        if (streq(a1, "--audio-post") == 1) { return modeset_audio_post(); }
        if (streq(a1, "--caps") == 1) { return modeset_caps(); }
        # ⛔ AN ARGUMENT WE DO NOT KNOW IS AN ERROR, NOT A CAPS PROBE. Silently running a
        # different operation than the one asked for is how a typo becomes a wasted burn.
        m_puts("modeset: UNKNOWN ARGUMENT -- no operation was performed."); m_nl();
        m_puts("modeset: valid: --dump --lock --vtotal --recommit --transmitter --pixclk"); m_nl();
        m_puts("modeset:        --audio-pre --audio-post --caps"); m_nl();
        return 84;
    }
    # ⛔⛔ NO ARGUMENTS SEEN. This is the argv-init trap, and on the 2026-07-24 M9 burn it cost
    # the whole run: the operator typed `modeset --audio-pre` (no `run /bin/` prefix), argc read
    # 0, this fell through to the caps probe, and caps returned 95 on a lit panel — an exit code
    # indistinguishable from a successful arm. Two arms were "run", neither existed, and the
    # resulting silence looked like data. Falling back is still right (a bare `run /bin/modeset`
    # must work), but it must NEVER be silent about it.
    m_puts("modeset: ================================================================"); m_nl();
    m_puts("modeset: ⚠ NO ARGUMENTS SEEN -- running the CAPS PROBE only."); m_nl();
    m_puts("modeset: IF YOU ASKED FOR AN ARM, IT DID **NOT** RUN. Nothing was written,"); m_nl();
    m_puts("modeset: no edge fired, and any silence you hear means NOTHING."); m_nl();
    m_puts("modeset: Invoke with the full path:   run /bin/modeset --audio-pre"); m_nl();
    m_puts("modeset: ================================================================"); m_nl();
    return modeset_caps();
}

fn _entry(): i64 {
    var r = modeset_main();
    syscall(SYS_EXIT, r);
    return 0;
}
_entry();
