# perspbits.cyr — RUNG 18's FIRST QUESTION, MEASURED: how many bits do the perspective numerator and
# denominator actually need?
#
# ⭐ WHY THIS IS THE FIRST THING, BEFORE ANY DESIGN. Rung 17's whole shader rests on one premise: every
# per-pixel quantity fits a SIGNED 32-BIT LANE, guaranteed by a validator corner bound. If rung 18's
# numerator does not fit, then none of rung 17's machinery carries over unchanged and the shader is a
# different program — 64-bit intermediates, a different divide, a different validator rule. That is a
# decision worth one host program and zero burns.
#
# THE ALGEBRA. Perspective-correct interpolation of an attribute `a` with per-vertex clip `w`:
#
#     a_persp(x,y) = [ SUM e_i(x,y) * (a_i / w_i) ] / [ SUM e_i(x,y) * (1 / w_i) ]
#
# In integers, represent the reciprocal as a fixed-point per-vertex constant W_i = 2^K / w_i. Then
#
#     D(x,y) = SUM e_i * W_i              <- affine in (x,y), integer coefficients
#     N(x,y) = SUM e_i * (W_i * a_i)      <- affine in (x,y), integer coefficients
#     a_persp = N / D                     <- the 2^K cancels exactly
#
# ⭐ Both are affine, so BOTH hoist to A*x + B*y + C exactly like rung 17's depth numerator. The hoist
# machinery, the winding normalisation and the dstxy fold all carry over untouched. What does NOT
# obviously carry over is the WIDTH, and that is what this measures.
#
# ⛔ THE STRUCTURAL WORRY, STATED BEFORE MEASURING SO THE NUMBER CAN REFUTE IT: the quotient is a
# texture coordinate in 16.16, up to 2^28 for a 4096-texel axis. If the quotient is ~2^28 and the
# divisor is ~2^D bits, the numerator is ~2^(28+D) BY CONSTRUCTION. There is no arrangement of a
# 32-bit numerator and a 32-bit divisor that yields a 28-bit fixed-point quotient with any headroom.
# If that reasoning is right, rung 18 needs a 64/32 divide and the answer is a bit-width, not an opinion.

include "lib/io.cyr"
include "tricore.cyr"      # ps / pn / nl

# ⛔⛔ K IS NOT FREE, AND THAT IS THE WHOLE FINDING OF THIS PROBE. W_i = 2^K / w_i, so K sets the
# precision of the per-vertex reciprocal AND the magnitude of everything downstream:
#   K too SMALL  -> W_i is coarse, the interpolated ratio is wrong, the picture bows like affine
#   K too LARGE  -> N = sum(e_i * W_i * a_i) overflows, and at K=30 it already needs 63 bits, i.e. the
#                   REFERENCE ITSELF is one bit from undefined. GPU_EDGE_COORD_MAX's comment names
#                   exactly this trap: "above roughly M*d ~ 2^63 the oracle itself has no defined
#                   value and 'identical' is meaningless."
# ⇒ The question rung 18 turns on is whether a K exists that is large enough to be ACCURATE and small
# enough to be REPRESENTABLE. That is a measurement, not an argument, and it is what pb_sweep answers.
var pb_K = 30;

fn pb_bits(v): i64 {
    var m = v;
    if (m < 0) { m = 0 - m; }
    var n = 0;
    while (m > 0) { n = n + 1; m = m >>> 1; }
    return n;
}

var pb_maxN = 0;
var pb_maxD = 0;
var pb_maxQ = 0;
var pb_snap[480000];
var pb_minD = 0;
var pb_probeQ = 0;      # the quotient at one fixed inside pixel, for the convergence check
var pb_over = 0;        # pixels where N exceeded 62 bits -- the reference is undefined there
var pb_q[480000];       # the WHOLE frame's quotients, so convergence is not judged from one pixel

# ⛔ IN-ORACLE NON-VACUITY COUNTERS. Each records what this run actually DID, not what it found
# wrong. They are spent by the floor at the bottom of main(), which is where the reason they exist
# is written down.
var pb_probes = 0;      # pb_probe calls that actually ran
var pb_pxtot = 0;       # pixels at which N and D were actually evaluated
var pb_qtot = 0;        # of those, pixels where a quotient N/D was actually computed and stored
var pb_ksteps = 0;      # K values pb_sweep actually walked
var pb_snapn = 0;       # trips of the snapshot loop
var pb_convn = 0;       # trips of the whole-frame comparison loop

# pb_probe — a floor quad in STRONG perspective, the exact figure the rung's oracle calls for, and
# evaluate N and D at every pixel of the draw rect (not just inside: the shader is PREDICATED and runs
# every lane, which is the lesson rung 17's corner bound was written from).
#
# Geometry: a triangle of a ground quad seen from a camera near the plane, so w spans a wide range —
# `wnear` at the bottom of the screen, `wfar` at the horizon. That ratio IS the perspective strength,
# and it is what drives the bit width.
# mulq -- W_i * a_i at full 16.16 attribute precision, the per-vertex product prep computes once.
fn mulq(Wi, Ai): i64 { return Wi * Ai; }

fn pb_probe(w, h, wnear, wfar, tex): i64 {
    # vertices in doubled-integer screen coords, same domain rung 17 proves
    var ax = 2 * 0;        var ay = 2 * (h - 1);     # bottom-left,  near
    var bx = 2 * (w - 1);  var by = 2 * (h - 1);     # bottom-right, near
    var cx = 2 * 0;        var cy = 2 * 0;           # top-left,     far
    # per-vertex reciprocals, fixed point
    var one = 1 << pb_K;
    var Wa = one / wnear;
    var Wb = one / wnear;
    var Wc = one / wfar;
    # per-vertex attribute (texture coordinate in 16.16), spanning the texture
    var Ua = 0;
    var Ub = tex * 65536;
    var Uc = 0;

    pb_maxN = 0; pb_maxD = 0; pb_maxQ = 0; pb_minD = 0;
    pb_probes = pb_probes + 1;
    var first = 1;
    var py = 0;
    while (py < h) {
        var px = 0;
        while (px < w) {
            var qx = 2 * px + 1;
            var qy = 2 * py + 1;
            # the three edge functions, i opposing vertex i -- identical convention to depthcore
            var e0 = (cx - bx) * (qy - by) - (cy - by) * (qx - bx);
            var e1 = (ax - cx) * (qy - cy) - (ay - cy) * (qx - cx);
            var e2 = (bx - ax) * (qy - ay) - (by - ay) * (qx - ax);
            var area = e0 + e1 + e2;
            if (area < 0) { e0 = 0 - e0; e1 = 0 - e1; e2 = 0 - e2; area = 0 - area; }
            pb_pxtot = pb_pxtot + 1;   # ⛔ non-vacuity: this is where N and D actually get evaluated
            var D = e0 * Wa + e1 * Wb + e2 * Wc;
            # ⚠ W_i * a_i is a PER-VERTEX product, computed once on the CPU -- it is what makes N affine
            # ⚠ FULL 16.16, NOT divided back down. The shader must EMIT a 16.16 texture coordinate, so the
            # quotient has to carry those 16 fraction bits -- an earlier version of this probe divided them
            # out and measured integer-texel precision, understating the numerator by 16 bits.
            var N = e0 * (Wa / 65536 * Ua) + e1 * (Wb / 65536 * Ub) + e2 * (Wc / 65536 * Uc);
            N = e0 * mulq(Wa, Ua) + e1 * mulq(Wb, Ub) + e2 * mulq(Wc, Uc);
            if (pb_bits(N) > pb_maxN) { pb_maxN = pb_bits(N); }
            if (pb_bits(N) > 62) { pb_over = pb_over + 1; }
            if (pb_bits(D) > pb_maxD) { pb_maxD = pb_bits(D); }
            var inside = 0;
            if (e0 >= 0) { if (e1 >= 0) { if (e2 >= 0) { inside = 1; } } }
            if (inside == 1) {
                if (D > 0) {
                    pb_qtot = pb_qtot + 1;   # ⛔ non-vacuity: a quotient was actually computed
                    var Q = N / D;
                    if (pb_bits(Q) > pb_maxQ) { pb_maxQ = pb_bits(Q); }
                    if (first == 1) { pb_minD = D; first = 0; }
                    if (D < pb_minD) { pb_minD = D; }
                    # one fixed sample, 3/4 down and 1/4 across -- well inside, strong perspective
                    if (py == h * 3 / 4) { if (px == w / 4) { pb_probeQ = Q; } }
                    store64(&pb_q + (py * w + px) * 8, Q);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return 0;
}

fn pb_row(label, w, h, wnear, wfar, tex): i64 {
    pb_probe(w, h, wnear, wfar, tex);
    ps(label);
    ps("  N needs "); pn(pb_maxN);
    ps(" bits, D needs "); pn(pb_maxD);
    ps(" bits, quotient "); pn(pb_maxQ);
    ps(" bits, min inside D "); pn(pb_minD); nl();
    return 0;
}

fn pb_sweep(): i64 {
    ps("K   N bits  D bits  Q bits   q at the probe pixel   N>62 bits (reference undefined)"); nl();
    var prev = 0;
    var bestK = 0;
    var k = 12;
    while (k <= 34) {
        pb_K = k;
        pb_ksteps = pb_ksteps + 1;
        pb_probe(800, 600, 4096, 256, 4096);
        ps("  "); pn(k);
        ps("    "); pn(pb_maxN);
        ps("      "); pn(pb_maxD);
        ps("      "); pn(pb_maxQ);
        ps("        "); pn(pb_probeQ);
        ps("            "); pn(pb_over);
        # ⭐ CONVERGENCE, not absolute truth. An exact rational reference for this quantity needs ~2^73
        # and overflows i64, so the honest test is whether the answer has STOPPED MOVING as K grows.
        # Two consecutive K agreeing to the last 16.16 unit is the signal that K is large enough.
        if (k > 12) {
            var d = pb_probeQ - prev;
            if (d < 0) { d = 0 - d; }
            ps("   moved "); pn(d);
            if (d <= 1) { if (pb_over == 0) { if (bestK == 0) { bestK = k; } } }
        }
        prev = pb_probeQ;
        nl();
        k = k + 2;
    }
    nl();
    # ⛔ WHOLE-FRAME CONVERGENCE, because a single probe pixel is exactly the kind of insensitive
    # oracle that shipped rung 15's half-texel and passed rung 17's kernarg swap. Snapshot every
    # quotient at the low K, re-render at the high end of the safe window, and count how many moved.
    pb_K = 12;
    pb_probe(800, 600, 4096, 256, 4096);
    var i = 0;
    while (i < 480000) {
        store64(&pb_snap + i * 8, load64(&pb_q + i * 8));
        pb_snapn = pb_snapn + 1;
        i = i + 1;
    }
    pb_K = 24;
    pb_probe(800, 600, 4096, 256, 4096);
    var moved = 0;
    var worst = 0;
    i = 0;
    while (i < 480000) {
        var d = load64(&pb_q + i * 8) - load64(&pb_snap + i * 8);
        if (d < 0) { d = 0 - d; }
        if (d != 0) { moved = moved + 1; }
        if (d > worst) { worst = d; }
        pb_convn = pb_convn + 1;
        i = i + 1;
    }
    ps("WHOLE-FRAME convergence K=12 vs K=24: "); pn(moved);
    ps(" of 480000 px moved, worst by "); pn(worst); ps(" (16.16 units)"); nl();
    if (moved != 0) {
        ps("  ⚠ the one-pixel probe said 'moved 0' and the FRAME disagrees -- K=12 is NOT converged"); nl();
    }
    nl();
    if (bestK != 0) {
        ps("⭐ USABLE WINDOW EXISTS: K = "); pn(bestK);
        ps(" is the smallest K where the quotient has converged AND no pixel"); nl();
        ps("   pushes the numerator past 62 bits. Rung 18's scaling is DETERMINED, not chosen."); nl();
        return bestK;
    }
    ps("⛔ NO USABLE K: every K either has not converged or overflows the reference."); nl();
    ps("   ⇒ the single-divide formulation is REFUTED and rung 18 needs the normalised-barycentric"); nl();
    ps("     decomposition instead (divide the weights first, then combine)."); nl();
    return 0;
}

fn main(): i64 {
    ps("perspbits: rung 18 -- can the perspective divide be done in integers at ALL, and at what scale?"); nl();
    ps("           a signed 32-bit lane holds 31 bits; i64 holds 63. Both bounds matter here."); nl(); nl();
    var bestK = pb_sweep();
    nl();
    ps("Fixed at the chosen scale, across perspective strengths (800x600, 4096-texel axis):"); nl();
    if (bestK != 0) { pb_K = bestK; }
    pb_row("  mild    persp  2:1 : ", 800, 600, 4096, 2048, 4096);
    pb_row("  strong  persp 16:1 : ", 800, 600, 4096,  256, 4096);
    pb_row("  extreme persp 64:1 : ", 800, 600, 4096,   64, 4096);
    nl();
    ps("VERDICT"); nl();
    if (pb_maxN > 31) {
        ps("  ⛔ N needs "); pn(pb_maxN); ps(" bits -- it does NOT fit the 32-bit lane rung 17 assumes."); nl();
        ps("  ⇒ rung 18 is a 64-bit numerator over a 32-bit divisor, with the divisor VARYING per"); nl();
        ps("     pixel (rung 17's was constant per triangle and precomputed on the CPU). None of"); nl();
        ps("     rung 17's divide carries over; only the affine hoist does."); nl();
    }
    # ⛔ IN-ORACLE NON-VACUITY FLOOR. WHAT IT CATCHES: this file's success condition is `bestK != 0`,
    # and bestK is awarded to the first K whose PROBE PIXEL stopped moving while no pixel overflowed
    # 62 bits. A probe that evaluated NOTHING satisfies both: pb_probeQ never changes from its
    # initial 0, so `moved 0` at every K, pb_over stays 0, and bestK is handed to k = 14 on the
    # strength of two identical measurements OF NOTHING. Empty the pixel loop, zero its bound,
    # #ifdef the body out, and this file reports "USABLE WINDOW EXISTS" and exits 95 having measured
    # no numerator, no denominator and no quotient at all.
    # ⛔ WHY THE EXTERNAL FLOOR CANNOT SEE IT: scripts/check/host-gpu-oracles.sh weighs this oracle
    # by how many lines it printed (perspbits:18 against 27 healthy). Every one of pb_sweep's 12 K
    # rows, the whole-frame convergence line, and all three pb_row strength rows are printed OUTSIDE
    # the pixel loop that computes them, so gutting that loop leaves 23 of the 27 lines standing --
    # measured -- which clears the floor of 18 with room to spare and the runner scores the vacuous
    # run green. Its own header says so and names this file among the still-unfloored. Only a count
    # taken where the arithmetic happens sees it. cpuref.cyr's cases_ok / lit_fail pair is the model.
    # ⚠ THE MINIMA ARE THIS FILE'S OWN LOOP BOUNDS AND CALL SITES, not chosen numbers, and every one
    # uses `<` so a wider sweep can never false-fire.
    var vac = 0;
    if (pb_ksteps < (34 - 12) / 2 + 1) {
        ps("** VACUOUS: pb_sweep walked "); pn(pb_ksteps); ps(" K values, not the ");
        pn((34 - 12) / 2 + 1); ps(" its own k = 12..34 step 2 loop names."); nl();
        ps("   Convergence is a comparison between CONSECUTIVE K; fewer than two is not one.");
        nl(); vac = vac + 1;
    }
    if (pb_probes < pb_ksteps + 5) {
        ps("** VACUOUS: pb_probe ran "); pn(pb_probes); ps(" times, not the "); pn(pb_ksteps + 5);
        ps(" this file calls for"); nl();
        ps("   (one per swept K, plus the two whole-frame convergence renders, plus the three");
        nl(); ps("   pb_row perspective strengths)."); nl(); vac = vac + 1;
    }
    if (pb_pxtot < 800 * 600) {
        ps("** VACUOUS: N and D were evaluated at "); pn(pb_pxtot);
        ps(" pixels, fewer than the 800x600 = "); pn(800 * 600); nl();
        ps("   of a SINGLE pb_probe frame -- and this run makes "); pn(pb_probes);
        ps(" of them, so the floor is one"); nl();
        ps("   frame with the rest as slack. Every bit width this file reports is a maximum over");
        nl(); ps("   those pixels, and a maximum over none is 0, which overflows nothing."); nl();
        vac = vac + 1;
    }
    if (pb_qtot < pb_pxtot / 4) {
        ps("** VACUOUS: a quotient was computed at "); pn(pb_qtot); ps(" of "); pn(pb_pxtot);
        ps(" pixels."); nl();
        ps("   pb_probe's triangle is the bottom-left, bottom-right and top-left CORNERS of the");
        nl();
        ps("   w x h draw rect, so it covers HALF of it by construction; a quarter is the floor,");
        nl();
        ps("   with 2x slack. Both the probe-pixel convergence and pb_maxQ live inside that half.");
        nl(); vac = vac + 1;
    }
    if (pb_snapn < 480000) {
        ps("** VACUOUS: the K=12 snapshot copied "); pn(pb_snapn);
        ps(" quotients, not the 480000 its loop bound names."); nl(); vac = vac + 1;
    }
    if (pb_convn < 480000) {
        ps("** VACUOUS: the whole-frame convergence compared "); pn(pb_convn);
        ps(" quotients, not the 480000 its loop"); nl();
        ps("   bound names -- and 'moved 0 of 480000' is what comparing none also prints. That");
        nl();
        ps("   line exists precisely because the one-pixel probe was too insensitive to trust.");
        nl(); vac = vac + 1;
    }
    if (vac != 0) {
        ps("perspbits: FAIL -- "); pn(vac);
        ps(" measurement(s) were reported over work that did not happen."); nl();
        ps("           A bit width measured on no pixels is not a small width, it is NO width, and");
        nl();
        ps("           the line-count floor outside cannot tell the two apart."); nl();
        return 90;
    }
    if (bestK == 0) { return 90; }
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
