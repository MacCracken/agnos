# asmagree.cyr — RUNG 7 of the 3D arc. Does mabda's sovereign gfx9 encoder reproduce the bytes
# agnos actually ships and has proven on iron?
#
# ============================================================================================
# ⚠⚠ SCOPE CORRECTION — READ THIS BEFORE JUDGING THE BITE AGAINST ITS PLAN ROW
# ============================================================================================
# The plan's rung 7 says: *"Assemble agnos's 11 existing kernel/shaders/*.s with mabda's
# gfx9_encode.cyr; byte-diff against the shipped hex tables."*
#
# **That is not directly possible, and the plan row is wrong about it.** mabda's
# `src/gfx9_encode.cyr` is an ENCODER, not an ASSEMBLER: 19 functions that pack instruction
# FIELDS into dwords (`gfx9_enc_vop3a_lo(op, vdst)`, `gfx9_enc_sop1(op, sdst, ssrc0)`, …). There
# is no tokeniser, no parser, no mnemonic table — nothing that consumes `.s` text. Verified by
# reading every `fn` in that file.
#
# Writing a gfx9 assembler is a genuine sub-project, not a zero-burn HOST rung, and pretending
# otherwise would either blow the bite open or produce a fake green.
#
# ⭐ WHAT THIS BITE DOES INSTEAD, AND WHY IT SATISFIES THE RUNG'S ACTUAL PURPOSE.
# The rung exists for one reason, stated in its own falsification cell: *"found before anyone
# hand-writes a 200-instruction kernel."* The question is therefore **"is mabda's encoder
# trustworthy enough to author the rasteriser with, instead of hand-assembling it?"** — not
# "can it parse text". So this tool encodes, instruction by instruction, a representative
# instruction from EVERY encoding class agnos's shipped shaders use, and byte-diffs each against
# the dword agnos actually ships and has run on iron.
#
# ⚠ HONEST LIMIT, stated rather than buried: this proves the encoder agrees with agnos's
# hand-assembly PER ENCODING CLASS. It does NOT prove agreement over all 11 shaders
# instruction-for-instruction, because reproducing those instruction-for-instruction by hand is
# the same hand-assembly whose trustworthiness is in question — it would be marking its own
# homework. A full `.s` -> bytes proof needs an assembler, which is a separate, sized bite.
#
# ============================================================================================
# PROVENANCE
# ============================================================================================
# Every expected dword below is transcribed from `kernel/core/gpu.cyr`'s shader-blob store32
# sequences — the bytes agnos uploads to the GPU and that are iron-proven on archaemenid (the
# perm / blend / matmul trackers). They are not from LLVM, not from a manual, not from me.
#
# Build:  cd tests/gpu && cyrius build asmagree.cyr build/asmagree
# Run:    ./build/asmagree     -> 95 = every class agrees · 90 = a disagreement (named)

include "lib/io.cyr"
# ⛔ WAS `../../mabda/...` = agnos/mabda, absent. See the note in edgeasm.cyr — both sovereign-encoder
# oracles were unbuildable and unrun until 1.56.44.
include "../../../mabda/src/gfx9_encode.cyr"

fn slen(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
fn ps(s): i64 { print(s, slen(s)); return 0; }
fn nl(): i64 { print("\n", 1); return 0; }
fn puts(s): i64 { ps(s); nl(); return 0; }
fn pnum(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var x = v; var buf[24]; var i = 0;
    while (x > 0) { store8(&buf + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    while (i > 0) { i = i - 1; print(&buf + i, 1); }
    return 0;
}
fn phex(v): i64 {
    var i = 7;
    ps("0x");
    while (i >= 0) {
        var d = (v >> (i * 4)) & 0xF;
        if (d < 10) { store8(&hexb, 48 + d); }
        if (d >= 10) { store8(&hexb, 87 + d); }
        print(&hexb, 1);
        i = i - 1;
    }
    return 0;
}
var hexb[8];

var pass_n = 0;
var fail_n = 0;

# ⚠ Compare, report, and NAME the class. A bare count of failures would tell the next person
# that the encoder is untrustworthy without telling them which encoding to distrust.
fn agree(name, got, want): i64 {
    ps("  ");
    ps(name);
    ps("  encoded ");
    phex(got);
    ps("  shipped ");
    phex(want);
    if (got == want) { puts("   AGREE"); pass_n = pass_n + 1; return 1; }
    puts("   ** DISAGREE **");
    fail_n = fail_n + 1;
    return 0;
}

fn main(): i64 {
    puts("asmagree -- RUNG 7: mabda's gfx9 encoder vs agnos's iron-proven shipped bytes");
    puts("============================================================================");
    puts("");
    puts("Expected dwords are transcribed from kernel/core/gpu.cyr's shader blobs -- the");
    puts("bytes agnos uploads and has run on archaemenid. Source: the perm shader blob.");
    puts("");

    # ---- VOP2: v_lshlrev_b32 v1, 2, v0 ----------------------------------------------------
    # shipped 0x24020082 (dst_phys+0). VOP2 op 0x12 (v_lshlrev_b32), vdst=1, src0=inline 2, vsrc1=v0
    agree("VOP2   v_lshlrev_b32 v1,2,v0 ",
          gfx9_enc_vop2(0x12, 1, gfx9_inline_int(2), 0), 0x24020082);

    # ---- VOP1: v_mov_b32 v3, s0 -----------------------------------------------------------
    # shipped 0x7e060200 (dst_phys+4). VOP1 op 0x01 (v_mov_b32), vdst=3, src0=s0
    agree("VOP1   v_mov_b32 v3,s0      ",
          gfx9_enc_vop1(0x01, 3, gfx9_sgpr(0)), 0x7e060200);

    # ---- VOP1 again, different regs: v_mov_b32 v4, s1 -------------------------------------
    agree("VOP1   v_mov_b32 v4,s1      ",
          gfx9_enc_vop1(0x01, 4, gfx9_sgpr(1)), 0x7e080201);

    # ---- VOP2 with VCC: v_add_co_u32 v3, vcc, v3, v1 --------------------------------------
    # shipped 0x32060303. VOP2 op 0x19, vdst=3, src0=v3, vsrc1=v1
    agree("VOP2   v_add_co_u32 v3,v3,v1",
          gfx9_enc_vop2(0x19, 3, gfx9_vgpr(3), 1), 0x32060303);

    # ---- VOP2 addc with inline 0: v_addc_co_u32 v4, vcc, 0, v4, vcc ------------------------
    # shipped 0x38080880. VOP2 op 0x1C, vdst=4, src0=inline 0, vsrc1=v4
    agree("VOP2   v_addc_co_u32 v4,0,v4",
          gfx9_enc_vop2(0x1C, 4, gfx9_inline_int(0), 4), 0x38080880);

    # ---- SOP1 with 32-bit literal: s_mov_b32 s6, 0x0c010c00 --------------------------------
    # shipped 0xbe8600ff then the literal 0x0c010c00. ssrc0=0xFF means "literal follows".
    agree("SOP1   s_mov_b32 s6,<lit>   ",
          gfx9_enc_sop1(0x00, 6, 0xFF), 0xbe8600ff);
    agree("       (its 32-bit literal) ", 0x0c010c00, 0x0c010c00);

    # ---- SOPP: s_waitcnt vmcnt(0) ----------------------------------------------------------
    # shipped 0xbf8c0f70. SOPP op 0x0C, simm16 = 0x0f70
    agree("SOPP   s_waitcnt vmcnt(0)   ",
          gfx9_enc_sopp(0x0C, 0x0f70), 0xbf8c0f70);

    # ---- VOP3A low dword: v_perm_b32 v8, 0, v2, s4 ----------------------------------------
    # shipped 0xd1ed0008 / 0x00... . VOP3A opcode 0x1ED, vdst=8.
    # ⭐ THE HIGH-VALUE ONE. perm.s documents at length that VOP3's operand pool is BACKWARDS
    # from the written order and that a wrong selector yields a wrong PICTURE, never a fault.
    # If mabda's encoder disagrees here, that is exactly the bug worth finding at zero burns.
    agree("VOP3A  v_perm_b32 v8 (lo)   ",
          gfx9_enc_vop3a_lo(0x1ED, 8), 0xd1ed0008);

    # ---- SOP1 plain (no literal): s_mov_b32 s6, s0 -----------------------------------------
    # Not in the perm blob; encoded to exercise the non-literal SOP1 path. Expected value is
    # DERIVED from the SOP1 layout, and is marked as such rather than claimed as shipped.
    ps("  SOP1   s_mov_b32 s6,s0      encoded ");
    phex(gfx9_enc_sop1(0x00, 6, gfx9_sgpr(0)));
    puts("   (derived, not a shipped byte -- reported, not asserted)");

    # ========================================================================================
    # B5 (rung 9b) — THE CLASSES RUNG 9b INTRODUCES
    # ========================================================================================
    # ⚠⚠ READ THE PROVENANCE DIFFERENCE BEFORE CITING THIS SECTION.
    #
    # Everything ABOVE is checked against bytes agnos SHIPS AND HAS RUN ON ARCHAEMENID. That is
    # the strongest evidence available: two independent parties (agnos's hand-assembly and
    # mabda's encoder) agreeing on a dword the SILICON accepted.
    #
    # ⛔ The block BELOW cannot make that claim. Nine of these instructions appear in NO shipped
    # agnos shader, so there is no iron-proven byte to compare against. Their expected dwords
    # come from `llvm-mc -arch=amdgcn -mcpu=gfx90c -show-encoding` — a THIRD OPINION, used here
    # exactly as this file's own failure text prescribes: a one-off investigation tool, never a
    # build gate (arc decision D-1).
    #
    # So this block proves "mabda's encoder agrees with LLVM", NOT "these bytes work on gfx90c".
    # ⭐ `v_mul_hi_u32` in particular has NEVER executed on agnos silicon and rung 9b's entire
    # divider rests on it — which is why it gets its own ANSWER-REGISTER oracle on the first
    # burn ([[feedback_echo_vs_answer_registers]]), and why agreement here is a prerequisite for
    # that burn rather than a substitute for it.
    #
    # ⚠ The table was RE-DERIVED by running llvm-mc in this session, not transcribed from the
    # plan — and that caught a real error in the plan's table, which listed `s_andn2_b64` as
    # SOP2 op 0x09 with a dword whose sdst field is 4, not 2. It also caught MY OWN first
    # hand-decode of the corrected dword, which said 0x12. The opcode is 0x13, and it took a
    # byte-diff against an independent assembler to settle it.
    # [[feedback_audit_re_derive_dont_validate_comments]]
    puts("");
    puts("---- B5: the classes rung 9b introduces (llvm-mc reference, NOT iron-proven) ----");

    # VOP1 — two opcodes rung 9b needs that appear in no shipped agnos shader.
    agree("VOP1   v_ffbh_u32 v1,v2     ", gfx9_enc_vop1(0x2D, 1, gfx9_vgpr(2)), 0x7e025b02);
    agree("VOP1   v_readfirstlane s1,v2", gfx9_enc_vop1(0x02, 1, gfx9_vgpr(2)), 0x7e020502);

    # VOP3 — BOTH dwords. ⭐ The lo/hi PAIR is what rung 7 never checked and what B4's tool
    # emits atomically; a dropped hi dword shifts the whole stream and yields a wrong picture.
    agree("VOP3lo v_mul_hi_u32 v1,v2,v3", gfx9_enc_vop3a_lo(0x286, 1), 0xd2860001);
    agree("VOP3hi v_mul_hi_u32 v1,v2,v3", gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(3), 0), 0x00020702);
    agree("VOP3lo v_mul_lo_u32 v1,v2,v3", gfx9_enc_vop3a_lo(0x285, 1), 0xd2850001);
    # v_cndmask_b32_e64 — the VOP3 form with an SGPR-PAIR selector in src2, which the VOP2 form
    # cannot express. The divider's guard mask needs exactly this.
    agree("VOP3lo v_cndmask_b32_e64    ", gfx9_enc_vop3a_lo(0x100, 1), 0xd1000001);
    agree("VOP3hi v_cndmask_b32_e64    ", gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(3), gfx9_sgpr(20)), 0x00520702);
    # v_cmp_ne_u32_e64 — VOPC as VOP3, writing an SGPR PAIR instead of VCC. The restoring loop
    # needs a second mask alongside vcc.
    agree("VOP3lo v_cmp_ne_u32_e64     ", gfx9_enc_vop3a_lo(0xCD, 22), 0xd0cd0016);
    agree("VOP3hi v_cmp_ne_u32_e64     ", gfx9_enc_vop3a_hi(gfx9_inline_int(0), gfx9_vgpr(16), 0), 0x00022080);

    # VOP2 — the min/max family, whose opcode numbers surveyor 1 could not derive from anything
    # in either repo and listed as UNKNOWN.
    agree("VOP2   v_min_i32 v1,v2,v3   ", gfx9_enc_vop2(0x0C, 1, gfx9_vgpr(2), 3), 0x18020702);
    agree("VOP2   v_max_i32 v1,v2,v3   ", gfx9_enc_vop2(0x0D, 1, gfx9_vgpr(2), 3), 0x1a020702);
    agree("VOP2   v_min_u32 v1,v2,v3   ", gfx9_enc_vop2(0x0E, 1, gfx9_vgpr(2), 3), 0x1c020702);
    agree("VOP2   v_max_u32 v1,v2,v3   ", gfx9_enc_vop2(0x0F, 1, gfx9_vgpr(2), 3), 0x1e020702);
    agree("VOP2   v_xor_b32 v1,v2,v3   ", gfx9_enc_vop2(0x15, 1, gfx9_vgpr(2), 3), 0x2a020702);
    agree("VOP2   v_or_b32 v1,v2,v3    ", gfx9_enc_vop2(0x14, 1, gfx9_vgpr(2), 3), 0x28020702);
    agree("VOP2   v_sub_u32 v1,v2,v3   ", gfx9_enc_vop2(0x35, 1, gfx9_vgpr(2), 3), 0x6a020702);
    agree("VOP2   v_ashrrev_i32 v1,31,v2", gfx9_enc_vop2(0x11, 1, gfx9_inline_int(31), 2), 0x2202049f);
    agree("VOP2   v_lshrrev_b32 v1,31,v2", gfx9_enc_vop2(0x10, 1, gfx9_inline_int(31), 2), 0x2002049f);
    agree("VOP2   v_cndmask_b32 (VOP2) ", gfx9_enc_vop2(0x00, 1, gfx9_vgpr(2), 3), 0x00020702);

    # VOPC
    agree("VOPC   v_cmp_ge_u32 vcc,v1,v2", gfx9_enc_vopc(0xCE, gfx9_vgpr(1), 2), 0x7d9c0501);

    # FLAT — ⭐ global_store_byte is the SUB-DWORD store. No agnos shader has ever issued one
    # (the only byte op anywhere is a global_load_ubyte in blend_cov), and every 8bpp mask
    # writer needs it. Its opcode was DERIVED by surveyor 1 and is CONFIRMED here.
    agree("FLATlo global_load_dwordx4  ", gfx9_enc_flat_lo(0x17, GFX9_FLAT_SEG_GLOBAL, 0, 0, 0), 0xdc5c8000);
    agree("FLAThi global_load_dwordx4  ", gfx9_enc_flat_hi(4, GFX9_SADDR_OFF, 0, 0), 0x047f0000);
    agree("FLATlo global_store_byte glc", gfx9_enc_flat_lo(0x18, GFX9_FLAT_SEG_GLOBAL, 0, 1, 0), 0xdc618000);
    agree("FLAThi global_store_byte glc", gfx9_enc_flat_hi(0, GFX9_SADDR_OFF, 2, 0), 0x007f0200);

    # SOP — ⚠ s_andn2_b64 is SOP2 op **0x13**. The plan's table said 0x09, AND my own first
    # hand-decode of the llvm-mc dword said 0x12 (I mis-shifted). The byte-diff below is what
    # caught both. That is the entire argument for this file existing: an opcode number that
    # "looks decoded" is worth nothing until something independent disagrees with it.
    agree("SOP2   s_andn2_b64          ", gfx9_enc_sop2(0x13, 2, gfx9_sgpr(4), gfx9_sgpr(6)), 0x89820604);
    agree("SOP2   s_or_b64 vcc,vcc,s22 ", gfx9_enc_sop2(0x0F, 106, 106, gfx9_sgpr(22)), 0x87ea166a);
    agree("SOP1   s_ff1_i32_b32 s1,s2  ", gfx9_enc_sop1(0x10, 1, gfx9_sgpr(2)), 0xbe811002);
    agree("SOP1   s_flbit_i32_b32 s1,s2", gfx9_enc_sop1(0x12, 1, gfx9_sgpr(2)), 0xbe811202);
    agree("SOP1   s_mov_b64 exec,-1    ", gfx9_enc_sop1(0x01, 126, gfx9_inline_int(0 - 1)), 0xbefe01c1);
    agree("SOPP   s_cbranch_execnz 0   ", gfx9_enc_sopp(0x09, 0), 0xbf890000);
    agree("SOPP   s_cbranch_scc1 0     ", gfx9_enc_sopp(0x05, 0), 0xbf850000);

    # ============================================================================================
    # RUNG 13 — the encoding classes tex_rgba.s introduced
    # ============================================================================================
    # ⭐ THIS IS THE SOVEREIGNTY CHECK, NOT A FORMALITY. tex_rgba's 425 dwords shipped verified by
    # llvm-mc ALONE, which is one assembler short of this tree's standing bar. llvm is a build-time
    # cross-check and never enters the kernel — the blob is a plain `store32` table in gpu.cyr — but
    # a table only ONE tool has ever agreed with is a table with a single point of failure.
    #
    # ⚠ EVERY EXPECTED DWORD BELOW WAS DECODED FROM THE SHIPPED BLOB, and the operand fields were
    # extracted programmatically rather than typed. Hand-transcribing opcode numbers into a gate
    # whose whole job is catching transcription error would be marking its own homework.
    # ⚠ These dwords are iron-proven: rung 13 closed at exit 95 with 10 of 10 cases byte-identical,
    # so what mabda's encoder is being asked to reproduce is machine code that has RUN.
    agree("SOP2   s_lshl_b32            ", gfx9_enc_sop2(0x1C, 10, 8, 134), 0x8e0a8608);
    agree("SOP2   s_mul_i32             ", gfx9_enc_sop2(0x24, 11, 9, 6), 0x920b0609);
    agree("SOP2   s_sub_i32             ", gfx9_enc_sop2(0x03, 61, 160, 30), 0x81bd1ea0);
    agree("SOP2   s_cselect_b64         ", gfx9_enc_sop2(0x0B, 62, 193, 128), 0x85be80c1);
    agree("SOP2   s_ashr_i32            ", gfx9_enc_sop2(0x20, 13, 36, 159), 0x900d9f24);
    agree("SOP1   s_and_saveexec_b64    ", gfx9_enc_sop1(0x20, 20, 106), 0xbe94206a);
    agree("SOPP   s_cbranch_execz       ", gfx9_enc_sopp(0x08, 0x018F), 0xbf88018f);
    agree("SOPP   s_branch              ", gfx9_enc_sopp(0x02, 0x0011), 0xbf820011);
    agree("SOPP   s_endpgm              ", gfx9_enc_sopp(0x01, 0x0000), 0xbf810000);
    agree("SOPP   s_cbranch_scc0        ", gfx9_enc_sopp(0x04, 0x000A), 0xbf84000a);
    agree("SOPC   s_cmp_eq_u32          ", gfx9_enc_sopc(0x06, 31, 128), 0xbf06801f);
    agree("SOPC   s_cmp_ge_i32          ", gfx9_enc_sopc(0x03, 45, 128), 0xbf03802d);
    agree("SMEM   s_load_dwordx4        ", gfx9_enc_smem_lo(0x02, 24, 0, 0), 0xc00a0600);
    agree("VOP2   v_add_u32             ", gfx9_enc_vop2(0x34, 1, 10, 0), 0x6802000a);
    agree("VOP2   v_and_b32             ", gfx9_enc_vop2(0x13, 14, 13, 5), 0x261c0a0d);
    agree("VOP2   v_sub_co_u32          ", gfx9_enc_vop2(0x1A, 12, 268, 8), 0x3418110c);
    agree("VOP2   v_subb_co_u32         ", gfx9_enc_vop2(0x1D, 13, 269, 9), 0x3a1a130d);
    agree("VOPC   v_cmp_gt_u32          ", gfx9_enc_vopc(0xCC, 6, 1), 0x7d980206);
    agree("VOPC   v_cmp_ne_u32          ", gfx9_enc_vopc(0xCD, 128, 4), 0x7d9a0880);
    agree("VOPC   v_cmp_le_u64          ", gfx9_enc_vopc(0xEB, 272, 20), 0x7dd62910);
    agree("VOP3A  v_mul_lo_u32          ", gfx9_enc_vop3a_lo(0x285, 8), 0xd2850008);
    agree("VOP3A  v_mul_hi_u32          ", gfx9_enc_vop3a_lo(0x286, 9), 0xd2860009);
    agree("FLAT   global_load_ubyte     ", gfx9_enc_flat_lo(0x10, 2, 0x0, 0, 0), 0xdc408000);
    agree("FLAT   global_load_dword     ", gfx9_enc_flat_lo(0x14, 2, 0x0, 0, 0), 0xdc508000);
    agree("FLAT   global_store_dword    ", gfx9_enc_flat_lo(0x1C, 2, 0x0, 0, 0), 0xdc708000);
    puts("");
    ps("classes agreeing: "); pnum(pass_n);
    ps("   disagreeing: "); pnum(fail_n); puts("");
    puts("");
    if (fail_n != 0) {
        puts("** DISAGREEMENT. Either mabda's encoder is wrong for that class, or agnos's");
        puts("   hand-assembly is. The class is named above; resolve it with a third opinion");
        puts("   (llvm-mc -mcpu=gfx90c, as a ONE-OFF investigation -- D-1 rejected llvm-mc as a");
        puts("   BUILD GATE, not as a tool) before any rung authors a kernel with this encoder.");
        return 90;
    }
    puts("AGREE across every encoding class exercised.");
    puts("");
    puts("⚠ WHAT THIS DOES **NOT** ESTABLISH: agreement over all 11 shaders");
    puts("  instruction-for-instruction. That needs a real .s parser, which mabda does not");
    puts("  have -- see the scope correction at the top of this file. Rung 7's plan row must");
    puts("  be amended, and rungs that author kernels with this encoder should cite THIS");
    puts("  result, with this limit attached.");
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
