# texcore.cyr — RUNG 13's CPU reference: nearest-neighbour, affine-UV texture mapping.
#
# ⭐ THIS IS THE ORACLE. The host model (texmodel) is measured against it and the shader is measured
# against the model. It is deliberately written in the plainest arithmetic that is still exact —
# no funnel shift, no reciprocal, no register-width simulation. Those belong in the model, whose
# whole job is to reproduce THIS at 32-bit widths.
#
# ⚠ INCLUDABLE MODULE, NO main(). Cyrius shadows duplicate `fn` silently (last-def-wins, warn only),
# so a consumer that includes a file carrying its own main() runs the WRONG one and still exits 0.
# That cost a real debugging session on rung 11 — hence tricore/triref, and hence this split too.
#
# ⛔ THE FRAME MACHINERY IS REUSED, NOT REIMPLEMENTED. tri_prep already derives the exact edge
# functions and the E_A = 2A - E_B - E_C identity, and it is iron-proven across rungs 11 and 12.
# Texturing changes WHAT is interpolated, not HOW the barycentrics are found. A second copy here
# would be a second thing to keep correct, and the two would drift.

include "lib/io.cyr"
include "tricore.cyr"
# ⭐ RUNG 15. bicore supplies bi_lerp4 — the EXACT integer 4-tap blend, proven exhaustively by bigate
# (weight sum exactly 65536 over all 65,536 fraction pairs; accumulator inside a 32-bit lane). The
# bilinear reference below composes bicore's BLEND with this file's ADDRESSING (tx_fetch_at,
# tx_floormod, the clamp ladder) rather than duplicating either. That is deliberate: a second copy of
# the addressing would be free to drift from the nearest path it is supposed to match texel-for-texel
# at fx=fy=0, and a second copy of the blend would not be the thing bigate proved.
include "bicore.cyr"

# ---- the UV frame ---------------------------------------------------------------------------
# Six 16.16 texel-space coordinates, one pair per vertex, in the same order tri_prep took them.
var TX_N  = 8;
var tx_uv[8];
fn tx_set(i, v): i64 { store64(&tx_uv + i * 8, v); return 0; }
fn tx_get(i): i64 { return load64(&tx_uv + i * 8); }

var TX_U0 = 0;
var TX_V0 = 1;
var TX_U1 = 2;
var TX_V1 = 3;
var TX_U2 = 4;
var TX_V2 = 5;

# ⛔ THE OVERFLOW GATE IS NOT DECORATION. The UV numerator is E * u summed over three vertices.
# |E| can reach 2A * GPU_TRI_E_RATIO and |u| reaches 4096 << 16 = 2^28 at the texture-dimension cap,
# so the product CAN exceed i64 for an extreme frame. Rung 11 hit exactly this class of bug — a
# silent wrap that surfaced as a plausible-looking wrong picture far from its cause. Rather than
# assume the corpus stays small, the reference REFUSES to answer when the product would wrap.
# tex_prep returns 0 in that case and every consumer must treat 0 as "no answer", never as "black".
var TX_NUM_MAX = 2305843009213693952;   # 2^61 — headroom of 4x over the 3-term sum

var tx_ready = 0;

# tex_prep — bind the UV frame to the CURRENT tri_prep frame. Call tri_prep FIRST.
# Returns 1 on success, 0 if the frame or the UVs put the numerator out of exact range.
fn tex_prep(u0, v0, u1, v1, u2, v2): i64 {
    tx_ready = 0;
    tx_set(TX_U0, u0); tx_set(TX_V0, v0);
    tx_set(TX_U1, u1); tx_set(TX_V1, v1);
    tx_set(TX_U2, u2); tx_set(TX_V2, v2);

    var a2 = tp_get(TP_A2);
    if (a2 <= 0) { return 0; }                  # degenerate frame — tri_prep already refused

    # Bound the worst-case |E| over the frame the same way the ABI does, then check the product.
    var emax = a2 * 1024;                       # GPU_TRI_E_RATIO
    var umax = 0;
    var i = 0;
    while (i < 6) {
        var a = tx_get(i);
        if (a < 0) { a = 0 - a; }
        if (a > umax) { umax = a; }
        i = i + 1;
    }
    if (umax != 0) {
        if (emax > TX_NUM_MAX / umax) { return 0; }
    }
    tx_ready = 1;
    return 1;
}

# tex_uv_at — the affine interpolant at a pixel centre. Writes u,v (16.16) through the two slots.
# ⚠ Uses the SAME E_A = 2A - E_B - E_C identity as the colour path, so a divergence between the two
# is a divergence in tri_prep, not in one of them.
var tx_u_out = 0;
var tx_v_out = 0;

fn tex_uv_at(px, py): i64 {
    var pcx = (px << 16) + 32768;
    var pcy = (py << 16) + 32768;
    var eb = tp_get(TP_KXB) * pcx + tp_get(TP_KYB) * pcy + tp_get(TP_K0B);
    var ec = tp_get(TP_KXC) * pcx + tp_get(TP_KYC) * pcy + tp_get(TP_K0C);
    var ea = tp_get(TP_A2) - eb - ec;
    var a2 = tp_get(TP_A2);

    # ⚠ The rounding direction here is MODE-DEPENDENT — see tx_floordiv. Under clamp it is
    # unobservable and the plain divide is used; under wrap it selects the opposite edge and the
    # floor is restored. The texel-centre convention in tex_fetch is load-bearing in both.
    var un = ea * tx_get(TX_U0) + eb * tx_get(TX_U1) + ec * tx_get(TX_U2);
    var vn = ea * tx_get(TX_V0) + eb * tx_get(TX_V1) + ec * tx_get(TX_V2);
    tx_u_out = tx_floordiv(un, a2);
    tx_v_out = tx_floordiv(vn, a2);
    return 0;
}

# ⭐ MODE-DEPENDENT ROUNDING, AND THE HISTORY IS THE POINT.
#
# This began as a floor-divide. The falsification pass killed it: a truncate-instead-of-floor
# mutation broke NOTHING under clamp-to-edge, because floor and truncate differ only on a negative
# value and every negative texel index clamps to 0. It was deleted on proof, with the deletion note
# carrying an explicit expiry — "if WRAP is ever added, this reasoning EXPIRES."
#
# ⛔ RUNG 14 ADDED WRAP, SO IT EXPIRED. Under wrap a negative index maps back INTO the texture, and
# the two roundings then select DIFFERENT texels. The floor is restored, but ONLY on the wrap path:
# the clamp path keeps the plain divide it was proven with, so rung 13's ten iron-green cases are
# byte-for-byte untouched.
fn tx_floordiv(n, d): i64 {
    # ⛔ THE DELETION PROOF EXPIRED, EXACTLY AS THIS COMMENT SAID IT WOULD. Under CLAMP the floor
    # was unobservable — every negative index clamps to 0 — so it was deleted on proof. Under WRAP a
    # negative index maps INTO the texture, and floor vs truncate then select DIFFERENT texels:
    # trunc(-0.5) = 0 wraps to 0, floor(-0.5) = -1 wraps to dim-1, the opposite edge.
    # ⚠ The clamp path keeps the plain divide it was proven with, so rung 13's ten iron-green cases
    # are byte-for-byte untouched by this change.
    if (tx_wrap == 0) { return n / d; }
    if (tmut_trunc == 1) { return n / d; }      # the mutation the wrap arms must catch
    var q = n / d;
    if (n < 0) { if (q * d != n) { q = q - 1; } }
    return q;
}

# floormod — the result is always in [0, m), matching DOOM's `wty % thf; if (wty < 0) wty += thf`.
fn tx_floormod(v, m): i64 {
    var r = v % m;
    if (r < 0) { r = r + m; }
    return r;
}

# The addressed fetch, shared by the clamp and wrap paths so both read texels the same way and only
# the ADDRESSING differs between them.
fn tx_fetch_at(tex, lut, tw, off, idx8): i64 {
    if (idx8 == 1) {
        var ix = load8(tex + off) & 0xFF;
        return load32(lut + ix * 4) & 0xFFFFFFFF;
    }
    return load32(tex + off * 4) & 0xFFFFFFFF;
}

# tex_fetch — nearest texel with CLAMP-TO-EDGE, in either supported format.
# `u`,`v` are 16.16 texel space. Returns a premultiplied ARGB dword.
#
# ⛔ NEAREST IS `floor(u >> 16)`, WITH NO +0.5. The texel-centre convention is fixed here and the
# shader must match it exactly: the plan's own failure table says "right at integer scale, wrong at
# fractional => texel-centre +0.5", so this line is the one that test discriminates on.
# ⭐ THE MUTATIONS ARE PART OF THE ORACLE, NOT DEBUG LEFTOVERS. A selftest that has never been seen
# to fail is documentation. Each flag below is a plausible implementation slip — two of them are
# named in the plan's own failure table — and tex_falsify() requires every one to BREAK the arms.
var tmut_centre = 0;            # add the +0.5 texel centre the plan warns about
var tmut_lshift = 0;            # use `>>` (LOGICAL) instead of `>>>` on the texel shift
var tmut_trunc  = 0;            # truncate instead of flooring -- DEAD under clamp, LIVE under wrap

# ⭐ WRAP IS NOW A SHIPPED MODE, NOT A MUTATION — RUNG 14 REQUIRES IT.
# cyrius-doom's `render_draw_tex_column` holds its V accumulator as `wty % (th << 16)` with a
# negative correction, i.e. TRUE MODULO. A wall column's V range routinely exceeds the texture
# height, so clamp-to-edge would smear the last row down the whole wall instead of tiling it.
# `tx_wrap` selects it; 0 keeps the clamp-to-edge that rungs 13's ten cases are proven against.
var tx_wrap = 0;

fn tex_fetch(tex, lut, tw, th, u, v, idx8): i64 {
    if (tmut_centre == 1) { u = u + 32768; v = v + 32768; }
    # ⚠ `>>>` IS ARITHMETIC AND `>>` IS LOGICAL IN CYRIUS — inverted from C, and one of the traps
    # this tree has already been bitten by. A logical shift turns a negative UV into a huge positive
    # index, which clamps to the LAST texel instead of the first: a mirrored edge, not a crash.
    var tu = u >>> 16;
    var tv = v >>> 16;
    if (tmut_lshift == 1) { tu = u >> 16; tv = v >> 16; }
    if (tx_wrap != 0) {
        return tx_fetch_at(tex, lut, tw, tx_floormod(tv, th) * tw + tx_floormod(tu, tw), idx8);
    }
    if (tu < 0) { tu = 0; }
    if (tv < 0) { tv = 0; }
    if (tu > tw - 1) { tu = tw - 1; }
    if (tv > th - 1) { tv = th - 1; }
    var off = tv * tw + tu;
    if (idx8 == 1) {
        var ix = load8(tex + off) & 0xFF;
        return load32(lut + ix * 4) & 0xFFFFFFFF;
    }
    return load32(tex + off * 4) & 0xFFFFFFFF;
}

# tex_ref_px — the whole reference for one pixel: interpolate UV, fetch, modulate by coverage,
# composite src-over onto `dst`.
#
# ⚠ COVERAGE MODULATES THE PREMULTIPLIED SOURCE, with the SAME exact /255 the colour path uses.
# `(x * a + 127) >> 8` is NOT the same function as `(x * a + 127) / 255`; rung 11 established that
# the exact divide is the bit-identity hinge, and reusing the shortcut here would reintroduce the
# very disagreement that took a burn to find.
var tx_clamp_hits = 0;                          # instrumentation: did clamp-to-edge actually fire?
var tx_premul_hits = 0;

# ============================================================================================
# ⭐ RUNG 15 — THE BILINEAR FETCH. Same addressing as tex_fetch above, four taps instead of one.
# ============================================================================================
# ⛔ THE ADDRESSING IS DUPLICATED FROM tex_fetch ON PURPOSE, LINE FOR LINE, INCLUDING BOTH MUTATION
# HOOKS. The alternative — factoring one shared addressing helper — would have been cleaner code and
# WORSE evidence: the mutations `tmut_centre` and `tmut_lshift` exist to prove the nearest path's
# texel-centre and shift-kind are load-bearing, and if bilinear shared that code the same mutation
# could no longer distinguish which path it broke. Two copies, both mutated, is what keeps the
# falsification per-path.
#
# ⚠ x1/y1 COME FROM THE PRE-CLAMP FLOOR (bx/by), NEVER FROM THE CLAMPED x0/y0. This is trap 1 from
# tex_bilin.s's header, restated here because the reference must have it too or the two agree on a
# shared bug: clamp(clamp(-1)+1) = 1 but clamp(-1+1) = 0. Under mask-WRAP the two orders are
# identical, so a wrap-only corpus would never separate them.
fn tex_fetch_bilin(tex, lut, tw, th, u, v, idx8): i64 {
    # ⚠ tmut_centre NOW MEANS SOMETHING DIFFERENT ON THIS PATH, and saying so is the point. On the
    # nearest path +32768 is "the +0.5 the plan warns about" — a bug. Here it exactly CANCELS the
    # BI_HALF bias below, so it reverts the half-texel fix. Still a valid mutation, different meaning.
    # ⛔ STANDING GAP: tex_selftest/tex_falsify never call this function, so tmut_centre has never
    # been falsified on the BILINEAR path at all. Written down rather than implied.
    if (tmut_centre == 1) { u = u + 32768; v = v + 32768; }
    # ⭐ THE HALF-TEXEL BIAS — see bicore.cyr's BI_HALF block for the convention-free argument.
    # Nearest is floor(u); linear taps are floor(u - 0.5). Those are the SAME convention (texel i's
    # centre at i + 0.5), not a contradiction — they differ by 0.5 because nearest rounds to the
    # nearest centre while linear brackets between centres.
    u = u - BI_HALF;
    v = v - BI_HALF;
    var bx = u >>> 16;
    var by = v >>> 16;
    if (tmut_lshift == 1) { bx = u >> 16; by = v >> 16; }
    # ⚠ TRUNCATING, matching bi_frac and the shader's v_lshrrev_b32 + v_and_b32. A rounded fraction
    # here against a truncated one there is bimodel's M5 mutation, and it reads on screen as a
    # uniform half-texel drift rather than an obvious break.
    var fx = (u >> 8) & 0xFF;
    var fy = (v >> 8) & 0xFF;

    var x0 = 0; var y0 = 0; var x1 = 0; var y1 = 0;
    if (tx_wrap != 0) {
        x0 = tx_floormod(bx, tw);      y0 = tx_floormod(by, th);
        x1 = tx_floormod(bx + 1, tw);  y1 = tx_floormod(by + 1, th);
    }
    if (tx_wrap == 0) {
        x0 = bx;     if (x0 < 0) { x0 = 0; } if (x0 > tw - 1) { x0 = tw - 1; }
        y0 = by;     if (y0 < 0) { y0 = 0; } if (y0 > th - 1) { y0 = th - 1; }
        x1 = bx + 1; if (x1 < 0) { x1 = 0; } if (x1 > tw - 1) { x1 = tw - 1; }
        y1 = by + 1; if (y1 < 0) { y1 = 0; } if (y1 > th - 1) { y1 = th - 1; }
    }

    var p00 = tx_fetch_at(tex, lut, tw, y0 * tw + x0, idx8);
    var p10 = tx_fetch_at(tex, lut, tw, y0 * tw + x1, idx8);
    var p01 = tx_fetch_at(tex, lut, tw, y1 * tw + x0, idx8);
    var p11 = tx_fetch_at(tex, lut, tw, y1 * tw + x1, idx8);

    # ⚠ ALL FOUR BYTES, and the channel ORDER is irrelevant because a 4-tap blend is per-channel
    # independent — the shader walks 24→0 and this walks 0→24, and they agree. What is NOT irrelevant
    # is the weight-to-tap assignment: w10 pairs with (x1,y0), w01 with (x0,y1). Swapping them keeps
    # the weight sum at 65536 and is caught only by bigate G6 and bimodel M1.
    var out = 0;
    var k = 0;
    while (k < 4) {
        var sh = k * 8;
        var c = bi_lerp4((p00 >> sh) & 0xFF, (p10 >> sh) & 0xFF,
                         (p01 >> sh) & 0xFF, (p11 >> sh) & 0xFF, fx, fy);
        out = out | ((c & 0xFF) << sh);
        k = k + 1;
    }
    return out & 0xFFFFFFFF;
}

# ⭐ ONE MODE FLAG, READ BY BOTH THE REFERENCE AND THE SYSCALL FLAGS IN gputex. Same idiom as
# tx_wrap. ⛔ It must stay ONE variable: if the reference's filter and the op's BILINEAR bit came
# from two different flags they could disagree, and a reference computing NEAREST while the GPU
# computes BILINEAR reports a difference that is the TEST's fault — the single most expensive kind
# of red, because it looks exactly like a broken shader.
var tx_bilin = 0;

fn tex_ref_px(tex, lut, tw, th, px, py, cov, dst, idx8): i64 {
    if (cov == 0) { return dst; }
    tex_uv_at(px, py);

    # Record whether this sample was outside the texture, so a corpus that never leaves the
    # interior cannot claim to have tested clamp-to-edge.
    var tu = tx_u_out >>> 16;
    var tv = tx_v_out >>> 16;
    if (tu < 0) { tx_clamp_hits = tx_clamp_hits + 1; }
    if (tv < 0) { tx_clamp_hits = tx_clamp_hits + 1; }
    if (tu > tw - 1) { tx_clamp_hits = tx_clamp_hits + 1; }
    if (tv > th - 1) { tx_clamp_hits = tx_clamp_hits + 1; }

    # ⭐ THE FILTER IS THE ONLY THING THAT CHANGES. Everything below — the exact /255 coverage
    # modulation, the premultiplied clamp, src-over — is shared verbatim between nearest and
    # bilinear, because it is rung 11's bit-identity hinge and duplicating it for a new filter is how
    # the two would silently drift.
    var texel = 0;
    if (tx_bilin == 0) { texel = tex_fetch(tex, lut, tw, th, tx_u_out, tx_v_out, idx8); }
    if (tx_bilin != 0) { texel = tex_fetch_bilin(tex, lut, tw, th, tx_u_out, tx_v_out, idx8); }

    var out = 0;
    var qa = 255;
    var ch = 0;
    while (ch < 4) {
        var sh = 24 - ch * 8;
        var c = (texel >> sh) & 0xFF;
        var q = (c * cov + 127) / 255;
        if (q > 255) { q = 255; }
        if (ch == 0) { qa = q; }
        if (q > qa) { q = qa; tx_premul_hits = tx_premul_hits + 1; }
        out = out | (q << sh);
        ch = ch + 1;
    }
    return tri_src_over(out, dst);
}

# ============================================================================================
# THE SELFTEST — what this reference asserts about ITSELF
# ============================================================================================
# ⭐ Every arm is a property that would be WRONG under a plausible implementation slip, not a
# restatement of the code. An arm nobody can imagine failing is documentation, not a test.
fn tex_selftest(tex, lut): i64 {
    var fail = 0;

    # Build an 8x8 RGBA8 texture whose every texel is DISTINCT, so a wrong address is visible
    # rather than accidentally right.
    var i = 0;
    while (i < 64) {
        store32(tex + i * 4, 0xFF000000 | (i << 16) | ((63 - i) << 8) | (i * 3));
        i = i + 1;
    }
    var k = 0;
    while (k < 256) { store32(lut + k * 4, 0xFF000000 | (k << 16) | (k << 8) | k); k = k + 1; }

    # ---- arm 1: 1:1 identity. A frame the size of the texture with UV == position must return
    # each texel EXACTLY. This is the absolute test the plan names -- an oracle against an artifact
    # the reference did not produce.
    tri_prep(0, 0, 8, 0, 0, 8, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF);
    if (tex_prep(0, 0, 8 << 16, 0, 0, 8 << 16) != 1) {
        ps("texcore: arm1 tex_prep REFUSED"); nl(); fail = fail + 1;
    }
    var bad1 = 0;
    var y = 0;
    while (y < 8) {
        var x = 0;
        while (x < 8) {
            var got = tex_ref_px(tex, lut, 8, 8, x, y, 255, 0xFF000000, 0);
            var want = load32(tex + (y * 8 + x) * 4) & 0xFFFFFFFF;
            if (got != want) { bad1 = bad1 + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    if (bad1 != 0) {
        ps("texcore: arm1 FAILED -- 1:1 identity differs in "); pn(bad1); ps(" texels"); nl();
        fail = fail + 1;
    }

    # ---- arm 2: clamp-to-edge fires and SATURATES. Sampling far outside must return the corner
    # texel, not wrap and not black.
    var corner = tex_fetch(tex, lut, 8, 8, 0 - (99 << 16), 0 - (99 << 16), 0);
    if (corner != (load32(tex) & 0xFFFFFFFF)) {
        ps("texcore: arm2 FAILED -- negative UV did not clamp to texel 0"); nl(); fail = fail + 1;
    }
    var far = tex_fetch(tex, lut, 8, 8, 99 << 16, 99 << 16, 0);
    if (far != (load32(tex + 63 * 4) & 0xFFFFFFFF)) {
        ps("texcore: arm2 FAILED -- large UV did not clamp to the last texel"); nl(); fail = fail + 1;
    }

    # ---- arm 3: NEAREST truncates, and the boundary is where it is. u just under 1.0 must still
    # be texel 0; u exactly 1.0 must be texel 1. A +0.5 texel-centre slip moves both.
    if (tex_fetch(tex, lut, 8, 8, 65535, 0, 0) != (load32(tex) & 0xFFFFFFFF)) {
        ps("texcore: arm3 FAILED -- u=0.99998 did not select texel 0"); nl(); fail = fail + 1;
    }
    if (tex_fetch(tex, lut, 8, 8, 65536, 0, 0) != (load32(tex + 4) & 0xFFFFFFFF)) {
        ps("texcore: arm3 FAILED -- u=1.0 did not select texel 1"); nl(); fail = fail + 1;
    }

    # ---- arm 4: IDX8 goes through the LUT. Byte i of the texture must produce LUT entry i.
    var b = 0;
    while (b < 64) { store8(tex + b, b * 4); b = b + 1; }
    var iv = tex_fetch(tex, lut, 8, 8, 3 << 16, 2 << 16, 1);
    var wantlut = load32(lut + ((2 * 8 + 3) * 4) * 4) & 0xFFFFFFFF;
    if (iv != wantlut) {
        ps("texcore: arm4 FAILED -- IDX8 fetch did not go through the LUT"); nl(); fail = fail + 1;
    }

    # ---- arm 5: the overflow gate REFUSES rather than wrapping. A UV at the domain cap against a
    # large frame must be rejected, or the reference would answer with a silently wrapped number.
    tri_prep(0, 0, 4000, 0, 0, 4000, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF);
    if (tex_prep(0, 0, 4096 << 16, 0, 0, 4096 << 16) != 0) {
        ps("texcore: arm5 FAILED -- the overflow gate did NOT fire; the reference would wrap"); nl();
        fail = fail + 1;
    }

    # ---- arm 6: coverage 0 is a no-op, and coverage 255 is the unmodulated texel.
    tri_prep(0, 0, 8, 0, 0, 8, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF);
    tex_prep(0, 0, 8 << 16, 0, 0, 8 << 16);
    var iz = 0;
    while (iz < 64) {
        store32(tex + iz * 4, 0xFF000000 | (iz << 16) | ((63 - iz) << 8) | (iz * 3));
        iz = iz + 1;
    }
    if (tex_ref_px(tex, lut, 8, 8, 3, 3, 0, 0xFF123456, 0) != 0xFF123456) {
        ps("texcore: arm6 FAILED -- coverage 0 changed the destination"); nl(); fail = fail + 1;
    }
    return fail;
}

# ============================================================================================
# THE WRAP ARMS — what WRAP asserts that CLAMP does not
# ============================================================================================
# ⭐ SEPARATE ARMS, NOT A FLAG ON THE CLAMP ONES. Clamp's arms assert saturation; wrap's assert
# tiling. Running the clamp battery with tx_wrap set would only prove the two differ, which is the
# falsification, not the specification. These say what wrap must DO.
fn tex_wrap_selftest(tex, lut): i64 {
    var fail = 0;
    var i = 0;
    while (i < 64) {
        store32(tex + i * 4, 0xFF000000 | (i << 16) | ((63 - i) << 8) | (i * 3));
        i = i + 1;
    }

    # ---- arm W1: one texture beyond the right edge is texel 0 again, not the last texel -----
    if (tex_fetch(tex, lut, 8, 8, 8 << 16, 0, 0) != (load32(tex) & 0xFFFFFFFF)) {
        ps("texcore: W1 FAILED -- u = tw did not wrap to texel 0"); nl(); fail = fail + 1;
    }
    if (tex_fetch(tex, lut, 8, 8, 9 << 16, 0, 0) != (load32(tex + 4) & 0xFFFFFFFF)) {
        ps("texcore: W1 FAILED -- u = tw+1 did not wrap to texel 1"); nl(); fail = fail + 1;
    }

    # ---- arm W2: NEGATIVE u wraps to the FAR edge. This is the arm the restored floor exists
    # for: truncation would land on texel 0 here, flooring lands on texel tw-1.
    if (tex_fetch(tex, lut, 8, 8, 0 - 65536, 0, 0) != (load32(tex + 7 * 4) & 0xFFFFFFFF)) {
        ps("texcore: W2 FAILED -- u = -1 did not wrap to the LAST texel"); nl(); fail = fail + 1;
    }
    # ⛔ THE FRACTIONAL NEGATIVE IS THE DISCRIMINATOR. u = -0.5 must floor to -1 and wrap to tw-1;
    # truncating gives 0, which is the OPPOSITE edge and looks entirely plausible on screen.
    if (tex_fetch(tex, lut, 8, 8, 0 - 32768, 0, 0) != (load32(tex + 7 * 4) & 0xFFFFFFFF)) {
        ps("texcore: W2 FAILED -- u = -0.5 truncated instead of flooring"); nl(); fail = fail + 1;
    }

    # ---- arm W3: v wraps independently of u, and the row stride is honoured ----------------
    if (tex_fetch(tex, lut, 8, 8, 3 << 16, 8 << 16, 0) != (load32(tex + 3 * 4) & 0xFFFFFFFF)) {
        ps("texcore: W3 FAILED -- v = th did not wrap to row 0"); nl(); fail = fail + 1;
    }

    # ---- arm W4: many periods out still lands correctly (no single-subtract assumption) -----
    if (tex_fetch(tex, lut, 8, 8, 43 << 16, 0, 0) != (load32(tex + 3 * 4) & 0xFFFFFFFF)) {
        ps("texcore: W4 FAILED -- u = 43 (5 periods + 3) did not wrap to texel 3"); nl();
        fail = fail + 1;
    }

    # ---- arm W5: THE INTERPOLATED PATH, in the window where floor and truncate diverge ------
    # ⛔ W1-W4 call tex_fetch DIRECTLY, so none of them reaches tx_floordiv — which lives in
    # tex_uv_at. The truncate mutation was therefore unfalsifiable by them, and said so.
    #
    # ⭐ THE WINDOW, DERIVED NOT GUESSED: floor and truncate differ by one 1/65536th of a texel, so
    # they select different texels only when u straddles a texel boundary from below — i.e. u in
    # (-1 ULP, 0). Truncate lands on texel 0; floor lands on tw-1, the OPPOSITE edge.
    # ⚠ NOT measure-zero in practice: in a DOOM wall column u is CONSTANT down the column, so a
    # column landing in this window renders entirely from the wrong texel. Rare per column,
    # catastrophic when hit — which is exactly why the floor is load-bearing under wrap.
    #
    # The frame below puts u(0,0) at -1/16 of a ULP: u0 = -1 texel, u1 = 15 texels minus one ULP,
    # so u(px=0) = -65536 + (u1 + 65536)/16 lands just below zero.
    tri_prep(0, 0, 8, 0, 0, 8, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF);
    if (tex_prep(0 - 65536, 0, (15 << 16) - 1, 0, 0 - 65536, 0) != 1) {
        ps("texcore: W5 SETUP FAILED -- tex_prep refused the boundary frame"); nl();
        fail = fail + 1;
    }
    var w5 = tex_ref_px(tex, lut, 8, 8, 0, 0, 255, 0xFF000000, 0);
    var w5want = tri_src_over(load32(tex + 7 * 4) & 0xFFFFFFFF, 0xFF000000);
    if (w5 != w5want) {
        ps("texcore: W5 FAILED -- u just below 0 did not floor to the FAR edge (texel 7)"); nl();
        fail = fail + 1;
    }
    return fail;
}

# ============================================================================================
# THE FALSIFICATION PASS — every mutation MUST break the selftest
# ============================================================================================
# ⛔ WITHOUT THIS, A GREEN SELFTEST MEANS NOTHING. Rung 11's `trimodel` gate was reported as proving
# the algorithm while its sample lattice could not reach x=62 — precisely where iron disagreed. The
# lesson is that a gate proves what it SAMPLES, so each arm has to be shown capable of failing
# before its passing is worth anything. [[feedback_instrument_has_no_oracle]]
fn tex_falsify(tex, lut): i64 {
    var bad = 0;

    tmut_centre = 1;
    var m1 = tex_selftest(tex, lut);
    tmut_centre = 0;
    ps("  mutation texel-centre +0.5 breaks "); pn(m1); ps(" arm(s)");
    if (m1 == 0) { ps("   <== DID NOT FIRE"); bad = bad + 1; }
    nl();

    # ⚠ WRAP IS NO LONGER A MUTATION, it is a shipped mode — so it is falsified the other way:
    # selecting it MUST change the arms, because the arms assert clamp-to-edge behaviour.
    tx_wrap = 1;
    var m2 = tex_selftest(tex, lut);
    tx_wrap = 0;
    ps("  mode WRAP breaks "); pn(m2); ps(" clamp arm(s)");
    if (m2 == 0) {
        ps("   <== DID NOT FIRE: wrap and clamp are indistinguishable here, so neither is tested");
        bad = bad + 1;
    }
    nl();

    # ⭐ AND THE RESURRECTED FLOOR-DIVIDE MUST MATTER AGAIN. Under wrap, truncating instead of
    # flooring selects the OPPOSITE edge for a negative UV. If this does not fire, the wrap arms
    # never sample a negative coordinate and the restored floor is as untested as it was unneeded.
    tx_wrap = 1;
    var wf = tex_wrap_selftest(tex, lut);
    tx_wrap = 0;
    ps("  wrap arms: "); pn(wf); ps(" failure(s) with the floor-divide IN PLACE");
    if (wf != 0) { ps("   <== WRAP IS BROKEN"); bad = bad + 1; }
    nl();

    # ⛔ AND NOW THE ONE THAT JUSTIFIES RESTORING IT AT ALL. Under clamp this mutation was PROVABLY
    # dead and the code was deleted for it. If it is still dead under wrap, the floor is once again
    # unreachable and restoring it was cargo — the arms would have to grow, or the code go back out.
    tx_wrap = 1;
    tmut_trunc = 1;
    var wt = tex_wrap_selftest(tex, lut);
    tmut_trunc = 0;
    tx_wrap = 0;
    ps("  mutation truncate-under-WRAP breaks "); pn(wt); ps(" wrap arm(s)");
    if (wt == 0) {
        ps("   <== DID NOT FIRE: the floor is STILL unreachable and should not have been restored");
        bad = bad + 1;
    }
    nl();

    # ⚠ THIS ONE REPLACED A DEAD MUTATION. It was originally truncate-instead-of-floor, which broke
    # nothing — see tx_floordiv for why that was a proof rather than a gap. The logical-shift slip is
    # a real Cyrius trap and it IS observable: a negative UV becomes a huge positive index and clamps
    # to the opposite edge.
    tmut_lshift = 1;
    var m3 = tex_selftest(tex, lut);
    tmut_lshift = 0;
    ps("  mutation logical-shift on a negative UV breaks "); pn(m3); ps(" arm(s)");
    if (m3 == 0) {
        ps("   <== DID NOT FIRE: no arm samples a NEGATIVE UV, so the shift choice is untested");
        bad = bad + 1;
    }
    nl();
    return bad;
}
