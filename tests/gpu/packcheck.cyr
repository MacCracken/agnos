# packcheck — prove gpu_pack2(lo,hi) + store64 lays down the SAME BYTES as two store32s.
# The only way 1.56.28's pairing can be wrong is the packing arithmetic, so that is what this tests,
# with adversarial values: negatives (which sign-extend if unmasked), the 32-bit boundary, and zero.

include "lib/io.cyr"
include "tricore.cyr"   # ps/nl

fn gpu_pack2(lo, hi) { return (lo & 0xFFFFFFFF) | ((hi & 0xFFFFFFFF) << 32); }

var buf_a[64];    # written as two store32 (the OLD form)
var buf_b[64];    # written as one store64 (the NEW form)

fn check(lo, hi, tag): i64 {
    store32(&buf_a + 0, lo & 0xFFFFFFFF);
    store32(&buf_a + 4, hi & 0xFFFFFFFF);
    store64(&buf_b + 0, gpu_pack2(lo, hi));
    var i = 0;
    var bad = 0;
    while (i < 8) {
        if ((load8(&buf_a + i) & 0xFF) != (load8(&buf_b + i) & 0xFF)) { bad = bad + 1; }
        i = i + 1;
    }
    if (bad != 0) {
        ps("  MISMATCH "); ps(tag); nl();
        return 1;
    }
    return 0;
}

fn main(): i64 {
    var bad = 0;
    bad = bad + check(0, 0,                     "zero/zero               ");
    bad = bad + check(1, 2,                     "small/small             ");
    bad = bad + check(0 - 1, 0,                 "NEGATIVE lo, zero hi    ");
    bad = bad + check(0, 0 - 1,                 "zero lo, NEGATIVE hi    ");
    bad = bad + check(0 - 1, 0 - 1,             "both negative           ");
    bad = bad + check(0 - 2147483648, 2147483647, "int32 min / int32 max ");
    bad = bad + check(4294967295, 4294967295,   "both 0xFFFFFFFF         ");
    bad = bad + check(2147483648, 1,            "lo at the sign boundary ");
    bad = bad + check(0 - 123456789, 987654321, "mixed sign realistic    ");
    # a full 64-bit quantity stored whole must equal its lo/hi split (the cov_mc / a2 / limu case)
    var q = 0 - 81985529216486896;
    store32(&buf_a + 0, q & 0xFFFFFFFF);
    store32(&buf_a + 4, (q >> 32) & 0xFFFFFFFF);
    store64(&buf_b + 0, q);
    var i = 0;
    while (i < 8) {
        if ((load8(&buf_a + i) & 0xFF) != (load8(&buf_b + i) & 0xFF)) { bad = bad + 1; }
        i = i + 1;
    }
    if (bad == 0) {
        ps("packcheck: PASS -- store64 pairing is byte-identical to the store32 pairs"); nl();
        return 0;
    }
    ps("packcheck: FAIL"); nl();
    return 1;
}
fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
