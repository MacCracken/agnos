# trimodel.cyr — THE CORRECTNESS GATE for barycentric attribute interpolation.
#
# ============================================================================================
# WHY THIS FILE IS THE KEYSTONE
# ============================================================================================
# This is the shader's algorithm — the hoisted reciprocal, the 96-bit numerator, the funnel
# shift, the estimate-and-correct quotient — written in Cyrius and byte-diffed against
# triref.cyr, which divides exactly and is the oracle.
#
# ⭐ THE POINT IS ATTRIBUTION. If this is green and a hardware run comes back red, the fault is
# in the EMISSION — encoding, register allocation, branch offsets, wave-vs-lane control flow —
# and NOT in the algorithm, because the algorithm is already proven. Without that split, a red
# run leaves both halves suspect and every subsequent flash is a coin toss. On the previous rung
# this discipline produced 8 of 11 bites at zero flashes, and when a run did come back red the
# model reproduced the failure exactly, on the one case out of twenty that failed.
#
# ⚠ WHAT IS AND IS NOT MODELLED AT REGISTER WIDTH, stated so nobody over-reads the coverage:
#   * MODELLED at 32-bit: the divider (verbatim from the shipped edge kernel), the funnel, the
#     numerator's 96-bit accumulate as explicit high/low halves, every u32 mask.
#   * NOT modelled: the construction of E from its coefficients. |E| <= 2^52 fits i64, and the
#     shader builds it from 32-bit pieces. That seam is covered by the byte-diff, not by width
#     discipline here — if the shader's 2-dword build were wrong, the outputs would differ.
# A model that quietly used i64 everywhere would prove the algorithm in a width the GPU does not
# have, which is the most expensive false green available.

include "lib/io.cyr"
include "tricore.cyr"


# ============================================================================================
# tm_px — the shader's answer for one pixel, at register widths
# ============================================================================================
var tm_kx_dead = 0;             # mutation: wire the x term to zero
var tm_skip_corr = 0;           # mutation: skip the exact correction
var tm_bias_trunc = 0;          # mutation: truncate the rounding bias by one
var tm_e_clamp = 0;             # mutation: clamp E into [0, 2A] -- a REJECTED design, kept as a test

fn tm_px(px, py, cov, dst): i64 {
    if (cov == 0) { return dst; }

    var pcx = (px << 16) + 32768;
    var pcy = (py << 16) + 32768;

    var kxb = tp_get(TP_KXB);
    var kxc = tp_get(TP_KXC);
    if (tm_kx_dead == 1) { kxb = 0; kxc = 0; }

    var eb = kxb * pcx + tp_get(TP_KYB) * pcy + tp_get(TP_K0B);
    var ec = kxc * pcx + tp_get(TP_KYC) * pcy + tp_get(TP_K0C);
    var ea = tp_get(TP_A2) - eb - ec;

    # ⛔ THE REJECTED E-CLAMP, kept as a live mutation. All three design judges recommended
    # clamping each weight into [0, 2A] to guarantee a non-negative numerator. It is WRONG: it
    # breaks the gradient reproduction at the far corner, because outside the frame the weights
    # legitimately leave [0, 2A] and clamping them changes the interpolant rather than just its
    # sign. Recording it as a mutation is what keeps that refutation honest — without it, the
    # rejection is prose, and the next reader re-derives the same "obvious" improvement.
    if (tm_e_clamp == 1) {
        var a2c = tp_get(TP_A2);
        if (eb < 0) { eb = 0; }
        if (eb > a2c) { eb = a2c; }
        if (ec < 0) { ec = 0; }
        if (ec > a2c) { ec = a2c; }
        ea = a2c - eb - ec;
        if (ea < 0) { ea = 0; }
    }

    var d255 = tp_get(TP_D255);
    var t = tp_get(TP_T);
    var dh = tp_get(TP_DH);
    var vv = tp_get(TP_V);
    var ll = tp_get(TP_L);

    var bias = d255 >> 1;
    if (tm_bias_trunc == 1) { bias = (d255 - 1) >> 1; }

    var out = 0;
    var qa = 255;
    var ch = 0;
    while (ch < 4) {
        var sh = 24 - ch * 8;
        var pa = ((tp_get(TP_CA) >> sh) & 0xFF) * cov;
        var pb = ((tp_get(TP_CB) >> sh) & 0xFF) * cov;
        var pc = ((tp_get(TP_CC) >> sh) & 0xFF) * cov;

        n_zero();
        n_madd(ea, pa);
        n_madd(eb, pb);
        n_madd(ec, pc);
        if (n_is_neg() == 1) { n_zero(); }      # clamp BEFORE the bias, as the reference does
        n_add_u(bias);

        var nh = n_shr(t);
        var q = tm_quot(nh, dh, vv, ll);

        # ⭐ THE SINGLE EXACT CORRECTION, as a compare against the ORIGINAL 96-bit numerator
        # rather than against the funnelled one — the funnel threw away low bits, so correcting
        # on nh would be correcting against a value that is not the real numerator.
        if (tm_skip_corr == 0) {
            var need = (q + 1) * d255;
            var cur_hi = n_hi;
            var cur_lo = n_lo;
            var need_hi = need >> 32;
            var need_lo = u32(need);
            var ge = 0;
            if (cur_hi > need_hi) { ge = 1; }
            if (cur_hi == need_hi) { if (cur_lo >= need_lo) { ge = 1; } }
            if (ge == 1) { q = q + 1; tm_corr_count = tm_corr_count + 1; }
        }

        if (q > 255) { q = 255; }
        if (ch == 0) { qa = q; }
        if (q > qa) { q = qa; }
        out = out | (q << sh);
        ch = ch + 1;
    }
    return tri_src_over(out, dst);
}

# ============================================================================================
# THE BYTE DIFF — the gate
# ============================================================================================
fn tm_diff_case(i): i64 {
    var ok = tri_prep(tc_get(i,0), tc_get(i,1), tc_get(i,2), tc_get(i,3),
                      tc_get(i,4), tc_get(i,5), tc_get(i,6), tc_get(i,7), tc_get(i,8));
    if (ok != 1) { return 0 - 1; }              # rejected cases are not diffed
    var bad = 0;
    var y = 0;
    while (y < 24) {
        var x = 0;
        while (x < 24) {
            var pxx = x * 11 + 2;
            var pyy = y * 9 + 3;
            var cv = 17 + ((x * 7 + y * 13) % 239);
            var want = tri_ref_px(pxx, pyy, cv, 0xFF101010);
            var got = tm_px(pxx, pyy, cv, 0xFF101010);
            if (want != got) { bad = bad + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return bad;
}

# ⛔ THE SPARSE LATTICE ABOVE HAS A HOLE, AND AN IRON BURN FOUND IT. `tm_diff_case` samples
# px = x*11 + 2 and py = y*9 + 3, so of the 4096 pixels in a 64x64 render window it tests 24x24 of
# a DIFFERENT, wider grid — and x = 62 is not reachable at all (62-2 is not a multiple of 11).
# Burn 5 came back with case 4 differing in exactly 32 pixels at x = 58..63 on partial coverage,
# none of which this gate had ever evaluated. A gate proves what it SAMPLES, and this one was
# reported as if it proved the whole surface. [[feedback_instrument_has_no_oracle]]
#
# This sweeps EVERY pixel of the real render window against a coverage set that includes the
# values the burn actually reported (95 and 31), plus the endpoints and a midpoint. Cost is ~2.4M
# evaluations across the corpus, which is seconds on the host and buys the whole surface.
fn ph8(v): i64 {
    var d = 28;
    while (d >= 0) {
        var nib = (v >> d) & 0xF;
        if (nib < 10) { print("0123456789" + nib, 1); }
        if (nib >= 10) { print("abcdef" + (nib - 10), 1); }
        d = d - 4;
    }
    return 0;
}

var tm_first_px = 0 - 1;
var tm_first_py = 0 - 1;
var tm_first_cov = 0;
var tm_first_want = 0;
var tm_first_got = 0;

fn tm_dense_case(i): i64 {
    var ok = tri_prep(tc_get(i,0), tc_get(i,1), tc_get(i,2), tc_get(i,3),
                      tc_get(i,4), tc_get(i,5), tc_get(i,6), tc_get(i,7), tc_get(i,8));
    if (ok != 1) { return 0; }
    var bad = 0;
    var py = 0;
    while (py < 64) {
        var px = 0;
        while (px < 64) {
            var ci = 0;
            while (ci < 6) {
                var cv = 1;
                if (ci == 1) { cv = 31; }       # ⭐ the two values burn 5 reported
                if (ci == 2) { cv = 95; }
                if (ci == 3) { cv = 128; }
                if (ci == 4) { cv = 254; }
                if (ci == 5) { cv = 255; }
                var want = tri_ref_px(px, py, cv, 0xFF101010);
                var got = tm_px(px, py, cv, 0xFF101010);
                if (want != got) {
                    if (tm_first_px < 0) {
                        tm_first_px = px; tm_first_py = py; tm_first_cov = cv;
                        tm_first_want = want; tm_first_got = got;
                    }
                    bad = bad + 1;
                }
                ci = ci + 1;
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return bad;
}

fn tm_dense_sweep(label): i64 {
    var total = 0;
    var i = 0;
    while (i < TC_N) {
        var b = tm_dense_case(i);
        if (b > 0) {
            ps("    "); ps(label); ps(": case "); pn(i); ps(" ("); tc_name(i);
            ps(") "); pn(b); ps(" differing samples"); nl();
            total = total + b;
        }
        i = i + 1;
    }
    return total;
}

fn tm_sweep(label): i64 {
    var total = 0;
    var i = 0;
    while (i < TC_N) {
        var b = tm_diff_case(i);
        if (b > 0) {
            ps("    "); ps(label); ps(": case "); pn(i); ps(" ("); tc_name(i);
            ps(") "); pn(b); ps(" differing pixels"); nl();
            total = total + b;
        }
        i = i + 1;
    }
    return total;
}

# ⭐ THE CONVICTION TEST. Burn 5 reported four exact (pixel, coverage, want, got) tuples for corpus
# case 4. This replays them against the model with the suspect mutation ON. A mutation that
# reproduces the observed bytes EXACTLY is not a theory about the shader, it is a demonstration of
# what the shader is doing — and it means the fix can be verified on the host before a flash.
fn tm_convict(): i64 {
    ps("  --- burn-5 conviction test: E-high multiplied as UNSIGNED ---"); nl();
    tri_prep(tc_get(4,0), tc_get(4,1), tc_get(4,2), tc_get(4,3),
             tc_get(4,4), tc_get(4,5), tc_get(4,6), tc_get(4,7), tc_get(4,8));
    var hit = 0;
    var i = 0;
    while (i < 4) {
        var px = 62; var py = 48; var cv = 95; var iron = 0xff120012;
        if (i == 1) { px = 63; py = 48; cv = 31; iron = 0xff070007; }
        if (i == 2) { px = 58; py = 49; cv = 95; iron = 0xff110011; }
        if (i == 3) { px = 59; py = 49; cv = 31; iron = 0xff060006; }

        tm_ehi_unsigned = 0;
        var clean = tm_px(px, py, cv, 0xFF101010);
        tm_ehi_unsigned = 1;
        var mutated = tm_px(px, py, cv, 0xFF101010);
        tm_ehi_unsigned = 0;

        ps("    px="); pn(px); ps(" py="); pn(py); ps(" cov="); pn(cv);
        ps("  ref=0x"); ph8(clean);
        ps("  mutated=0x"); ph8(mutated);
        ps("  IRON=0x"); ph8(iron);
        if (mutated == iron) { ps("   <== MATCHES IRON"); hit = hit + 1; }
        nl();
        i = i + 1;
    }
    ps("  mutation reproduced "); pn(hit); ps(" of 4 iron samples"); nl();
    return hit;
}

# ============================================================================================
# THE BATCH (op 0x0A) CONVICTION — reproducing iron's `--list` digest on the HOST
# ============================================================================================
# ⭐ WHY THIS IS POSSIBLE AT ALL. `--list` needs a GPU, so its result looked unreachable from here.
# But refraster.cyr is byte-identical to the GPU rasteriser (20 of 20, four burns running), so the
# real coverage masks CAN be produced on the host — and tm_px models the shader. Compose the two
# and the whole batch is reproducible offline. If the mutated model lands on iron's digest
# (0xda27e77a) then op 0x0A's red is the SAME defect as op 0x09's, already fixed, and the next
# flash is a verification rather than another diagnosis.
var bt_tbl[288];
var bt_buf[2048];
var bt_cov[3072];

fn bt_build(): i64 {
    tl_set(&bt_tbl, 0,0,  2); tl_set(&bt_tbl, 0,1,  2); tl_set(&bt_tbl, 0,2, 60);
    tl_set(&bt_tbl, 0,3,  2); tl_set(&bt_tbl, 0,4,  2); tl_set(&bt_tbl, 0,5, 60);
    tl_set(&bt_tbl, 0,6, 0xFFFF0000); tl_set(&bt_tbl, 0,7, 0xFF00FF00); tl_set(&bt_tbl, 0,8, 0xFF0000FF);
    tl_set(&bt_tbl, 1,0, 60); tl_set(&bt_tbl, 1,1,  2); tl_set(&bt_tbl, 1,2, 60);
    tl_set(&bt_tbl, 1,3, 60); tl_set(&bt_tbl, 1,4,  2); tl_set(&bt_tbl, 1,5, 60);
    tl_set(&bt_tbl, 1,6, 0xFF00FFFF); tl_set(&bt_tbl, 1,7, 0xFFFFFF00); tl_set(&bt_tbl, 1,8, 0xFFFF00FF);
    tl_set(&bt_tbl, 2,0, 16); tl_set(&bt_tbl, 2,1, 16); tl_set(&bt_tbl, 2,2, 48);
    tl_set(&bt_tbl, 2,3, 16); tl_set(&bt_tbl, 2,4, 32); tl_set(&bt_tbl, 2,5, 48);
    tl_set(&bt_tbl, 2,6, 0xFFFFFFFF); tl_set(&bt_tbl, 2,7, 0xFF808080); tl_set(&bt_tbl, 2,8, 0xFF404040);
    tl_set(&bt_tbl, 3,0,  8); tl_set(&bt_tbl, 3,1, 40); tl_set(&bt_tbl, 3,2, 40);
    tl_set(&bt_tbl, 3,3, 40); tl_set(&bt_tbl, 3,4,  8); tl_set(&bt_tbl, 3,5, 56);
    tl_set(&bt_tbl, 3,6, 0xFF804020); tl_set(&bt_tbl, 3,7, 0xFF208040); tl_set(&bt_tbl, 3,8, 0xFF402080);
    tl_set(&bt_tbl, 4,0, 24); tl_set(&bt_tbl, 4,1,  4); tl_set(&bt_tbl, 4,2, 56);
    tl_set(&bt_tbl, 4,3, 24); tl_set(&bt_tbl, 4,4, 24); tl_set(&bt_tbl, 4,5, 40);
    tl_set(&bt_tbl, 4,6, 0xFF00FF80); tl_set(&bt_tbl, 4,7, 0xFF8000FF); tl_set(&bt_tbl, 4,8, 0xFFFF8000);
    tl_set(&bt_tbl, 5,0,  4); tl_set(&bt_tbl, 5,1, 48); tl_set(&bt_tbl, 5,2, 36);
    tl_set(&bt_tbl, 5,3, 48); tl_set(&bt_tbl, 5,4,  4); tl_set(&bt_tbl, 5,5, 60);
    tl_set(&bt_tbl, 5,6, 0xFF102030); tl_set(&bt_tbl, 5,7, 0xFF304010); tl_set(&bt_tbl, 5,8, 0xFF203040);
    return 6;
}

fn bt_digest(buf, n): i64 {
    var hsh = 2166136261;
    var i = 0;
    while (i < n) {
        hsh = (hsh ^ (load8(buf + i) & 0xFF)) & 0xFFFFFFFF;
        hsh = (hsh * 16777619) & 0xFFFFFFFF;
        i = i + 1;
    }
    return hsh;
}

# ⭐ HYPOTHESIS VARIANTS for what op 0x0A might be doing differently. The harness is CALIBRATED —
# variant 0 with the mutation off reproduces iron's reference digest bit-exactly — so a variant that
# lands on iron's GPU digest identifies the defect without a flash.
var bt_variant = 0;             # 0 normal · 1 reverse order · 2 first tri only · 3 last tri only
                                # 4 all share triangle 0's coverage · 5 no read-modify-write

# Composite the batch in submission order using tm_px, honouring whatever mutation is armed.
fn bt_render(n, w, h): i64 {
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) { store32(&bt_buf + (y * w + x) * 4, 0xFF101010); x = x + 1; }
        y = y + 1;
    }
    var k = 0;
    while (k < n) {
        var i = k;
        if (bt_variant == 1) { i = n - 1 - k; }
        var skip = 0;
        if (bt_variant == 2) { if (i != 0) { skip = 1; } }
        if (bt_variant == 3) { if (i != n - 1) { skip = 1; } }
        var covtri = i;
        if (bt_variant == 4) { covtri = 0; }
        if (skip == 1) { k = k + 1; continue; }
        if (tri_prep(tl_get(&bt_tbl,i,0), tl_get(&bt_tbl,i,1), tl_get(&bt_tbl,i,2),
                     tl_get(&bt_tbl,i,3), tl_get(&bt_tbl,i,4), tl_get(&bt_tbl,i,5),
                     tl_get(&bt_tbl,i,6), tl_get(&bt_tbl,i,7), tl_get(&bt_tbl,i,8)) == 1) {
            var yy = 0;
            while (yy < h) {
                var xx = 0;
                while (xx < w) {
                    var cv = load8(&bt_cov + covtri * w * h + yy * w + xx) & 0xFF;
                    if (cv != 0) {
                        var cur = load32(&bt_buf + (yy * w + xx) * 4) & 0xFFFFFFFF;
                        if (bt_variant == 5) { cur = 0xFF101010; }
                        store32(&bt_buf + (yy * w + xx) * 4, tm_px(xx, yy, cv, cur));
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
        }
        k = k + 1;
    }
    return 0;
}

fn tm_batch_convict(): i64 {
    var w = 64; var h = 64;
    var n = bt_build();
    ps("  --- burn-5 BATCH conviction: op 0x0A reproduced offline ---"); nl();

    # Real coverage, from the rasteriser that is byte-identical to the GPU's.
    rr_set_dims(w, h);
    var i = 0;
    while (i < n) {
        edges_reset();
        # ⚠ FIXED POINT. edge_add stores coordinates verbatim and raster() works in 16.16, so raw
        # pixel values submit a triangle a 65536th of its intended size — which rasterises to an
        # empty mask and reads, misleadingly, as "the batch drew nothing".
        tri_add(fx(tl_get(&bt_tbl,i,0)), fx(tl_get(&bt_tbl,i,1)), fx(tl_get(&bt_tbl,i,2)),
                fx(tl_get(&bt_tbl,i,3)), fx(tl_get(&bt_tbl,i,4)), fx(tl_get(&bt_tbl,i,5)));
        cov_clear(&bt_cov + i * w * h);
        raster(&bt_cov + i * w * h);
        i = i + 1;
    }

    # ⭐ SIX CONSTRAINTS, NOT ONE. Burn 7's prefix bisect published the GPU digest at every n from
    # 1 to 6. A hypothesis now has to reproduce the WHOLE SEQUENCE, which is a far harder bar than
    # matching one number by luck — and n=1 is a free calibration point, since iron's GPU and
    # reference agree there exactly.
    var hit = 0;
    var v = 0;
    while (v < 6) {
        ps("    variant "); pn(v); ps(":");
        var nn = 1;
        var allmatch = 1;
        while (nn <= n) {
            var iron = 0x7dfa3797;
            if (nn == 2) { iron = 0xa70d44e9; }
            if (nn == 3) { iron = 0xb2854731; }
            if (nn == 4) { iron = 0xef01eb26; }
            if (nn == 5) { iron = 0x4742417e; }
            if (nn == 6) { iron = 0xefd67dae; }
            bt_variant = v;
            tm_ehi_unsigned = 0;
            bt_render(nn, w, h);
            var d = bt_digest(&bt_buf, w * h * 4);
            ps("  n"); pn(nn);
            if (d == iron) { ps("=HIT"); }
            if (d != iron) { ps("=.."); allmatch = 0; }
            nn = nn + 1;
        }
        if (allmatch == 1) {
            ps("   ⭐⭐ REPRODUCES EVERY PREFIX -- THIS IS WHAT op 0x0A DOES");
            hit = 1;
        }
        nl();
        v = v + 1;
    }
    bt_variant = 0;
    tm_ehi_unsigned = 0;
    if (hit == 0) {
        ps("    ⚠ no variant reproduces iron's prefix sequence -- op 0x0A's defect is not in"); nl();
        ps("      this hypothesis set. Do NOT name a suspect on the strength of a guess."); nl();
    }
    return hit;
}

fn main(): i64 {
    ps("trimodel -- the shader algorithm at register widths, byte-diffed vs the reference"); nl();
    tc_init();
    var fail = 0;
    tm_convict();
    tm_batch_convict();

    # --- GATE 1: the model reproduces the reference, byte for byte -------------------------
    tm_corr_count = 0;
    var d = tm_sweep("GATE1");
    if (d != 0) {
        ps("  GATE 1 FAILED: "); pn(d); ps(" differing pixels across the corpus"); nl();
        fail = fail + 1;
    }
    if (d == 0) {
        ps("  gate 1 GREEN: 0 differing bytes across all corpus cases"); nl();
        ps("    exact correction fired "); pn(tm_corr_count); ps(" times"); nl();
    }

    # --- GATE 1b: THE DENSE SWEEP -- every pixel of the real window, not a lattice ----------
    # ⛔ ADDED AFTER BURN 5. Gate 1's grid never evaluates x = 62, and that is precisely where the
    # iron disagreed. If this is green while iron is red, the divergence is in the EMISSION and not
    # in the algorithm; if it is red, the algorithm was never proven at those pixels at all and
    # every "zero burns" claim resting on gate 1 was overstated.
    var dd = tm_dense_sweep("GATE1b-dense");
    if (dd != 0) {
        ps("  GATE 1b FAILED: "); pn(dd); ps(" differing samples over the FULL window"); nl();
        ps("    first at px="); pn(tm_first_px); ps(" py="); pn(tm_first_py);
        ps(" cov="); pn(tm_first_cov); nl();
        ps("    want=0x"); ph8(tm_first_want); ps("  got=0x"); ph8(tm_first_got); nl();
        ps("  ⭐ The MODEL disagrees with the REFERENCE here. The shader emission is not"); nl();
        ps("    implicated -- this is a defect in one of these two, on the host, reproducible."); nl();
        fail = fail + 1;
    }
    if (dd == 0) {
        ps("  gate 1b GREEN: 0 differing samples over ALL 4096 px x 6 coverages per case"); nl();
    }
    # ⭐ Does the premultiplied restore fire when coverage is NOT clipped to the frame? Burn 6's N14
    # failed because every dispatched case used the frame's own edges as the coverage shape, so no
    # pixel outside the frame was ever evaluated. The dense sweep above ignores coverage geometry
    # entirely, so this number answers -- on the host -- whether decoupling the shape will fix it.
    ps("  premul restore fired "); pn(tr_premul_hits);
    ps(" times over the shape-independent sweep"); nl();
    if (tr_premul_hits == 0) {
        ps("  ⚠ ZERO -- decoupling the coverage shape will NOT make N14 fire; the corpus"); nl();
        ps("    itself cannot reach the restore and needs a case that extrapolates."); nl();
    }

    # ⚠ A correction that NEVER fires is untested code. Report it as a gate, not a statistic.
    if (tm_corr_count == 0) {
        ps("  GATE 1 WARNING: the +1 correction never fired -- it is UNTESTED by this corpus"); nl();
        fail = fail + 1;
    }

    # --- GATE 2: FALSIFICATION -- killing the x term MUST break it -------------------------
    # ⭐ And it must break the 3-colour triangles while leaving the gradient rects GREEN, which
    # is the proof that a gradient-shaped oracle cannot police the x term at all.
    tm_kx_dead = 1;
    var dk = tm_sweep("x-term-dead");
    tm_kx_dead = 0;
    if (dk == 0) {
        ps("  GATE 2 FAILED: wiring the x term to zero changed NOTHING -- the corpus"); nl();
        ps("    cannot see the x term, so gate 1 proves less than it appears to"); nl();
        fail = fail + 1;
    }
    if (dk != 0) {
        ps("  gate 2 GREEN: killing the x term breaks "); pn(dk); ps(" pixels"); nl();
    }

    # --- GATE 3: FALSIFICATION -- skipping the correction MUST break it --------------------
    tm_skip_corr = 1;
    var dc = tm_sweep("no-correction");
    tm_skip_corr = 0;
    if (dc == 0) {
        ps("  GATE 3 FAILED: skipping the exact correction changed nothing -- either the"); nl();
        ps("    correction is dead code or the corpus never reaches a case that needs it"); nl();
        fail = fail + 1;
    }
    if (dc != 0) {
        ps("  gate 3 GREEN: skipping the correction breaks "); pn(dc); ps(" pixels"); nl();
    }

    # --- GATE 4: the REJECTED E-clamp must break the gradient cases ------------------------
    # ⛔ THE PLAN ASKED FOR A PARITY GATE HERE AND IT IS UNCONSTRUCTIBLE. It wanted "an odd
    # denominator must still be bit-exact". D255 = 255 * 2A and 2A carries a << 16, so D255 always
    # has at least 16 trailing zeros and CAN NEVER BE ODD. The parity arm tested nothing: its
    # mutation (bias - 1) broke exactly the same 33 pixels as gate 3, because both perturb the
    # same rounding boundary. Two gates reporting identical failures are one gate.
    # Replaced with the refutation the plan actually needed recorded as a test.
    tm_e_clamp = 1;
    var de = tm_sweep("E-clamped");
    tm_e_clamp = 0;
    if (de == 0) {
        ps("  GATE 4 FAILED: clamping E into [0,2A] changed NOTHING -- then the rejection of"); nl();
        ps("    that design is unsupported and it should be reconsidered on its merits"); nl();
        fail = fail + 1;
    }
    if (de != 0) {
        ps("  gate 4 GREEN: the REJECTED E-clamp breaks "); pn(de); ps(" pixels -- refutation holds"); nl();
    }

    if (fail != 0) {
        ps("trimodel: "); pn(fail); ps(" GATE FAILURE(S)"); nl();
        return 1;
    }
    ps("trimodel: all gates green."); nl();
    ps("⇒ The algorithm is proven at register widths BEFORE one instruction is assembled."); nl();
    ps("⇒ If the iron burn is red, the fault is in the EMISSION, not the algorithm."); nl();
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
