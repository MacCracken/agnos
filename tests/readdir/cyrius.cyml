[package]
name = "rdat"
version = "0.1.0"
description = "agnos ring-3 resumable-readdir exerciser (#101, 1.56.50) — reads a directory in small batches via readdir_at's cursor and proves the paged walk sees exactly what the single-shot #81 sees; exits 95 iff the whole contract holds."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.28"

[build]
src = "rdat.cyr"
output = "build/rdat"

# `syscalls` gives SYS_EXIT, sys_readdir (#81) and the raw `syscall()` used for #101 — the
# stdlib has no sys_readdir_at wrapper yet, so the number is named here instead of inlined.
[deps]
stdlib = ["syscalls"]
