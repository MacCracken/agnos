[package]
name = "rdat"
version = "0.1.0"
description = "agnos ring-3 resumable-readdir exerciser (#101, 1.56.50) — reads a directory in small batches via readdir_at's cursor and proves the paged walk sees exactly what the single-shot #81 sees; exits 95 iff the whole contract holds."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
src = "rdat.cyr"
output = "build/rdat"

# `syscalls` gives SYS_EXIT, sys_readdir (#81), and — since the 6.5.36 pin — SYS_READDIR_AT +
# sys_readdir_at (#101) as a real wrapper. rdat.cyr still issues #101 through the raw
# `syscall()` ON PURPOSE: this is the ABI exerciser, and routing it through the stdlib wrapper
# would make it test the wrapper's agreement with itself rather than the kernel's arm.
[deps]
# ⚠ 1.57.14 (cyrius 6.6.20): `syscalls` alone is NOT a closed set — it names `alloc` (since 6.6.6; CX-only under
# `#ifdef CYRIUS_TARGET_CX` through 6.6.8, unconditional since 6.6.9), which names `atomic` + `fnptr` and, since
# 6.6.18, `poison` (under `#ifdef CYRIUS_POISON`, never compiled here). `cyrius deps` walks includes textually, so
# it resolved alloc/atomic/fnptr at the 6.6.6 pin too: this manifest was short BEFORE the move, which uncovered it.
# `cyrius lib sync` copies only what is DECLARED, so the transitives are declared (the 1.57.2 tests/chan
# precedent); `cyrius deps` vendoring 15 files where lib sync vendored 7 is how the 1.57.14 move measured it.
stdlib = ["syscalls", "alloc", "atomic", "fnptr", "poison"]
