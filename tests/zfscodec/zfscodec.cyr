# zfscodec.cyr — HOST oracle for kernel/core/zfs_codec.cyr, the ZFS driver's checksum and
# decompression primitives. Exits 95 iff every case passes (repo convention), 90 otherwise.
#
# ⭐ ONE IMPLEMENTATION. This INCLUDES the kernel file rather than mirroring it, so what passes here
# is the code the kernel runs, compiled by the same cyrius pin. The expected side is
# gen/vectors.cyr, generated by scripts/check/zfs-codec-vectors.py from hashlib, zlib, the lz4 CLI
# and Python ports of the OpenZFS compressors — never from this tree's Cyrius.
#
# ⛔ HOSTILE-INPUT PROOF BY GUARD PAGE. Every decoder case runs TWICE:
#   placement 0 — src ends exactly at a PROT_NONE page and so does dst's capacity: any read past
#                 src + slen or write past dst + dlen is a SIGSEGV, i.e. this binary does not exit 95;
#   placement 1 — src and dst START right after a PROT_NONE page (an offset reaching before dst, or
#                 a negative index, faults), and dst is canaried for 64 bytes past dlen.
# Both placements must return the same verdict, reproduce the plaintext on success, leave bytes past
# the decoded length untouched, leave src unmodified, and leave zfs_codec_outlen at 0 on failure.
# Checksums and the ZAP hash run at both placements too (a padding bug that reads one byte past the
# buffer faults at placement 0). The fuzz cases (zt_fuzz) throw 600 mutants of a valid stream at
# each decoder under the same two placements and require only "0 or -1, no fault, canary intact".
#
# Run: scripts/check/host-zfs-oracles.sh (regenerates the vectors and rebuilds this every time).

include "../../kernel/klib/kstring.cyr"
include "../../kernel/core/zfs_codec.cyr"
include "gen/vectors.cyr"

var ZT_PAGE = 4096;
var ZT_AREA = 1114112;            # 1 MiB + 64 KiB (page multiple): the largest vector, with slack
var ZT_FLOOR = 200;               # fewer cases than this ran => vacuous, whatever the counters say
var ZT_LOCAL = 1;                 # cases this file adds beyond the generated ones (init idempotence)

var zt_pass = 0;
var zt_fail = 0;
var zt_ran = 0;
var zt_srcA = 0;                  # guarded source area: [PROT_NONE][ZT_AREA][PROT_NONE]
var zt_dstA = 0;                  # guarded destination area, same shape
var zt_stage = 0;                 # where a blob is loaded before it is placed
var zt_plain = 0;                 # expected plaintext
var zt_prng = 0;                  # the 1 MiB splitmix64 buffer
var zt_fz = 0;                    # fuzz work buffer
var zt_rs = 0;                    # splitmix64 state
var zt_e[4];                      # 32 B — expected checksum words
var zt_o[4];                      # 32 B — computed checksum words

# --- output ---------------------------------------------------------------------------------------
fn zt_puts(s) {
    syscall(SYS_WRITE, 1, s, strlen(s));
    return 0;
}

fn zt_nl() {
    syscall(SYS_WRITE, 1, "\n", 1);
    return 0;
}

fn zt_putn(v) {
    var b[24];                    # 24 B — up to 20 decimal digits
    if (v < 0) {
        zt_puts("-");
        v = 0 - v;
    }
    var i = 23;
    store8(&b + i, 48 + (v % 10));
    v = v / 10;
    while (v > 0) {
        i = i - 1;
        store8(&b + i, 48 + (v % 10));
        v = v / 10;
    }
    syscall(SYS_WRITE, 1, &b + i, 24 - i);
    return 0;
}

fn zt_hex(v) {
    var b[16];                    # 16 B — 16 hex digits
    var i = 0;
    while (i < 16) {
        var d = (v >> (60 - i * 4)) & 15;
        if (d < 10) { store8(&b + i, 48 + d); } else { store8(&b + i, 87 + d); }
        i = i + 1;
    }
    syscall(SYS_WRITE, 1, &b, 16);
    return 0;
}

fn zt_ok(name) {
    zt_ran = zt_ran + 1;
    zt_pass = zt_pass + 1;
    zt_puts("PASS ");
    zt_puts(name);
    zt_nl();
    return 0;
}

fn zt_bad(name, why) {
    zt_ran = zt_ran + 1;
    zt_fail = zt_fail + 1;
    zt_puts("FAIL ");
    zt_puts(name);
    zt_puts(": ");
    zt_puts(why);
    zt_nl();
    return 0;
}

# --- memory ---------------------------------------------------------------------------------------
fn zt_map(n) {
    var p = syscall(9, 0, n, 3, 0x22, 0 - 1, 0);          # PROT_READ|WRITE, MAP_PRIVATE|ANONYMOUS
    if (p < 0) {
        zt_puts("zfscodec: FAIL -- mmap refused; nothing was tested");
        zt_nl();
        syscall(SYS_EXIT, 2);
    }
    return p;
}

fn zt_guarded() {
    var base = zt_map(ZT_AREA + 2 * ZT_PAGE);
    var r1 = syscall(10, base, ZT_PAGE, 0);
    var r2 = syscall(10, base + ZT_PAGE + ZT_AREA, ZT_PAGE, 0);
    if (r1 != 0) { zt_puts("zfscodec: FAIL -- mprotect refused"); zt_nl(); syscall(SYS_EXIT, 2); }
    if (r2 != 0) { zt_puts("zfscodec: FAIL -- mprotect refused"); zt_nl(); syscall(SYS_EXIT, 2); }
    return base + ZT_PAGE;
}

fn zt_rand() {
    zt_rs = zt_rs + 0x9E3779B97F4A7C15;
    var z = zt_rs;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    return z ^ (z >> 31);
}

# uniform-ish in [0, n): drop the sign bit first, `%` is a signed remainder
fn zt_below(n) {
    return (zt_rand() >> 1) % n;
}

fn zt_fnv(p, n) {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < n) {
        h = (h ^ load8(p + i)) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# Load blob `id` into p and prove the embedding is byte-exact. Returns its length, or -1.
fn zt_load(id, p) {
    var n = zv_blob(id, p);
    if (n < 0) { return 0 - 1; }
    if (zt_fnv(p, n) != zv_blob_fnv(id)) { return 0 - 1; }
    return n;
}

# Bytes [p, p + n) all equal v?
fn zt_all(p, n, v) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) != v) { return 0; }
        i = i + 1;
    }
    return 1;
}

# --- the PRNG buffer ------------------------------------------------------------------------------
fn zt_prng_fill() {
    zt_rs = zv_prng_seed();
    var i = 0;
    while (i < zv_prng_len()) {
        store64(zt_prng + i, zt_rand());
        i = i + 8;
    }
    return 0;
}

fn zt_prng_check(fnv, first) {
    var name = "prng: oracle's splitmix64 buffer == generator's";
    if (load64(zt_prng) != first) { return zt_bad(name, "first word differs"); }
    if (zt_fnv(zt_prng, zv_prng_len()) != fnv) { return zt_bad(name, "buffer hash differs"); }
    return zt_ok(name);
}

# --- checksums ------------------------------------------------------------------------------------
fn zt_e4(a, b, c, d) {
    store64(&zt_e, a);
    store64(&zt_e + 8, b);
    store64(&zt_e + 16, c);
    store64(&zt_e + 24, d);
    return 0;
}

fn zt_call_sum(kind, p, n, out) {
    if (kind == 1) { return zfs_sha256_words(p, n, out); }
    if (kind == 2) { return zfs_sha512_256_words(p, n, out); }
    if (kind == 3) { return zfs_sha512_256_le_words(p, n, out); }
    if (kind == 4) { return zfs_fletcher4(p, n, out); }
    if (kind == 5) { return zfs_fletcher2(p, n, out); }
    return 0 - 2;
}

# zt_sum(kind, name, sel, len, expect): sel >= 0 is a blob id, -1 the PRNG buffer's first len bytes.
fn zt_sum(kind, name, sel, len, expect) {
    var data = zt_prng;
    if (sel >= 0) {
        var n = zt_load(sel, zt_stage);
        if (n != len) { return zt_bad(name, "vector blob failed its embedding check"); }
        data = zt_stage;
    }
    var place = 0;
    while (place < 2) {
        var src = zt_srcA + ZT_AREA - len;
        if (place == 1) { src = zt_srcA; }
        memcpy(src, data, len);
        memset(&zt_o, 0, 32);
        var rc = zt_call_sum(kind, src, len, &zt_o);
        if (rc != expect) { return zt_bad(name, "wrong return value"); }
        if (expect == 0) {
            var i = 0;
            while (i < 4) {
                if (load64(&zt_o + i * 8) != load64(&zt_e + i * 8)) {
                    zt_puts("  word ");
                    zt_putn(i);
                    zt_puts(" got ");
                    zt_hex(load64(&zt_o + i * 8));
                    zt_puts(" want ");
                    zt_hex(load64(&zt_e + i * 8));
                    zt_nl();
                    return zt_bad(name, "checksum words differ");
                }
                i = i + 1;
            }
        }
        place = place + 1;
    }
    return zt_ok(name);
}

# --- streaming SHA-256 ----------------------------------------------------------------------------
# Uneven piece sizes, cycled: straddle the 64-byte block in every way (1, 63, 64, 65, 0, 55, 56 ...).
fn zt_piece(k) {
    var j = k % 15;
    if (j == 0) { return 1; }
    if (j == 1) { return 63; }
    if (j == 2) { return 64; }
    if (j == 3) { return 65; }
    if (j == 4) { return 4095; }
    if (j == 5) { return 0; }
    if (j == 6) { return 7; }
    if (j == 7) { return 128; }
    if (j == 8) { return 3; }
    if (j == 9) { return 8192; }
    if (j == 10) { return 55; }
    if (j == 11) { return 56; }
    if (j == 12) { return 127; }
    if (j == 13) { return 1000; }
    return 453;
}

# zt_stream(name, total, inter): feed the first `total` PRNG bytes through begin/update/end in the
# pieces above; must equal the expected (one-shot) words. inter = 1 also runs one-shot SHA-256 and
# SHA-512/256 (and a refused negative-length update) between pieces, which must neither disturb the
# stream nor be disturbed by it.
fn zt_stream(name, total, inter) {
    var src = zt_srcA + ZT_AREA - total;
    memcpy(src, zt_prng, total);
    zfs_sha256_begin();
    var off = 0;
    var k = 0;
    while (off < total) {
        var n = zt_piece(k);
        if (n > total - off) { n = total - off; }
        if (zfs_sha256_update(src + off, n) != 0) { return zt_bad(name, "update refused a piece"); }
        off = off + n;
        k = k + 1;
        if (inter == 1) {
            if ((k % 5) == 0) {
                zfs_sha256_words("abc", 3, &zt_o);
                if (load64(&zt_o) != 0xBA7816BF8F01CFEA) { return zt_bad(name, "interleaved sha256 wrong"); }
                zfs_sha512_256_words("abc", 3, &zt_o);
                if (load64(&zt_o) != 0x53048E2681941EF9) { return zt_bad(name, "interleaved sha512/256 wrong"); }
                if (zfs_sha256_update(src, 0 - 1) != 0 - 1) { return zt_bad(name, "negative len accepted"); }
            }
        }
    }
    memset(&zt_o, 0, 32);
    zfs_sha256_end(&zt_o);
    var i = 0;
    while (i < 4) {
        if (load64(&zt_o + i * 8) != load64(&zt_e + i * 8)) {
            zt_puts("  word ");
            zt_putn(i);
            zt_puts(" got ");
            zt_hex(load64(&zt_o + i * 8));
            zt_puts(" want ");
            zt_hex(load64(&zt_e + i * 8));
            zt_nl();
            return zt_bad(name, "streamed digest differs from the one-shot digest");
        }
        i = i + 1;
    }
    if (inter == 1) {
        zt_puts("  ");
        zt_puts(name);
        zt_puts(": ");
        zt_putn(k);
        zt_puts(" pieces");
        zt_nl();
    }
    return zt_ok(name);
}

# --- ZAP hash -------------------------------------------------------------------------------------
fn zt_zap(name, sid, salt, bits, expect) {
    var n = zt_load(sid, zt_stage);
    if (n < 0) { return zt_bad(name, "vector blob failed its embedding check"); }
    var place = 0;
    while (place < 2) {
        var p = zt_srcA + ZT_AREA - n;
        if (place == 1) { p = zt_srcA; }
        memcpy(p, zt_stage, n);
        var h = zfs_zap_hash_bits(salt, p, n, bits);
        if (h != expect) {
            zt_puts("  got ");
            zt_hex(h);
            zt_puts(" want ");
            zt_hex(expect);
            zt_nl();
            return zt_bad(name, "hash differs");
        }
        if (bits == 28) {
            if (zfs_zap_hash(salt, p, n) != expect) { return zt_bad(name, "zfs_zap_hash != _bits(.., 28)"); }
        }
        place = place + 1;
    }
    return zt_ok(name);
}

# --- decoders -------------------------------------------------------------------------------------
fn zt_call_dec(kind, src, slen, dst, dlen) {
    if (kind == 1) { return zfs_lz4_decompress(src, slen, dst, dlen); }
    if (kind == 2) { return zfs_lzjb_decompress(src, slen, dst, dlen); }
    if (kind == 3) { return zfs_zle_decompress(src, slen, dst, dlen, 64); }
    if (kind == 4) { return zfs_gzip_decompress(src, slen, dst, dlen); }
    return 0 - 2;
}

# One decode at one placement. Returns 0 if every invariant held, else a reason string.
fn zt_dec_once(kind, place, slen, plen, dcap, expect) {
    var src = zt_srcA + ZT_AREA - slen;
    var dst = zt_dstA + ZT_AREA - dcap;
    var span = dcap;
    if (place == 1) {
        src = zt_srcA;
        dst = zt_dstA;
        span = dcap + 64;
    }
    memcpy(src, zt_stage, slen);
    memset(dst, 0xA5, span);
    zfs_codec_outlen = 12345;
    var rc = zt_call_dec(kind, src, slen, dst, dcap);
    if (rc != expect) {
        zt_puts("  placement ");
        zt_putn(place);
        zt_puts(": rc ");
        zt_putn(rc);
        zt_puts(", want ");
        zt_putn(expect);
        zt_nl();
        return "wrong return value";
    }
    if (memeq(src, zt_stage, slen) == 0) { return "decoder wrote into its source"; }
    if (rc == 0) {
        if (zfs_codec_outlen != plen) { return "zfs_codec_outlen != plaintext length"; }
        if (memeq(dst, zt_plain, plen) == 0) { return "output differs from the plaintext"; }
        if (zt_all(dst + plen, span - plen, 0xA5) == 0) { return "wrote past the decoded length"; }
    } else {
        if (zfs_codec_outlen != 0) { return "zfs_codec_outlen not 0 after a failure"; }
        if (place == 1) {
            if (zt_all(dst + dcap, 64, 0xA5) == 0) { return "wrote past dlen"; }
        }
    }
    return 0;
}

# zt_dec(kind, name, sid, pid, dcap, expect): decode blob sid with capacity dcap; on success the
# output must equal blob pid (pid -1: no plaintext, a negative case).
fn zt_dec(kind, name, sid, pid, dcap, expect) {
    var slen = zt_load(sid, zt_stage);
    if (slen < 0) { return zt_bad(name, "vector blob failed its embedding check"); }
    var plen = 0;
    if (pid >= 0) {
        plen = zt_load(pid, zt_plain);
        if (plen < 0) { return zt_bad(name, "plaintext blob failed its embedding check"); }
    }
    if (dcap + 64 > ZT_AREA) { return zt_bad(name, "vector larger than the test area"); }
    var why = zt_dec_once(kind, 0, slen, plen, dcap, expect);
    if (why != 0) { return zt_bad(name, why); }
    why = zt_dec_once(kind, 1, slen, plen, dcap, expect);
    if (why != 0) { return zt_bad(name, why); }
    return zt_ok(name);
}

# zt_fuzz(kind, name, sid, cap, iters, fnv): mutate a valid stream `iters` times — byte flips,
# truncation, saturation — and decode every mutant at both placements. Anything but 0 / -1, a fault,
# a smashed canary or an outlen beyond cap is a failure.
fn zt_fuzz(kind, name, sid, cap, iters, fnv) {
    var clen = zt_load(sid, zt_stage);
    if (clen < 0) { return zt_bad(name, "vector blob failed its embedding check"); }
    if (zt_fnv(zt_stage, clen) != fnv) { return zt_bad(name, "fuzz seed stream mismatch"); }
    zt_rs = fnv;
    var acc = 0;
    var rej = 0;
    var it = 0;
    while (it < iters) {
        memcpy(zt_fz, zt_stage, clen);
        var n = clen;
        var kind_m = zt_below(8);
        if (kind_m < 5) {
            var k = 1 + zt_below(4);
            while (k > 0) {
                var at = zt_below(n);
                store8(zt_fz + at, load8(zt_fz + at) ^ (1 + zt_below(255)));
                k = k - 1;
            }
        } elif (kind_m == 5) {
            n = zt_below(clen);
        } elif (kind_m == 6) {
            var at2 = zt_below(n);
            if (zt_below(2) == 0) { store8(zt_fz + at2, 0xFF); } else { store8(zt_fz + at2, 0); }
        } else {
            var at3 = zt_below(n);
            store8(zt_fz + at3, load8(zt_fz + at3) ^ (1 + zt_below(255)));
            n = zt_below(clen);
        }
        var place = 0;
        while (place < 2) {
            var src = zt_srcA + ZT_AREA - n;
            var dst = zt_dstA + ZT_AREA - cap;
            if (place == 1) {
                src = zt_srcA;
                dst = zt_dstA;
                memset(dst + cap, 0xA5, 64);
            }
            memcpy(src, zt_fz, n);
            var rc = zt_call_dec(kind, src, n, dst, cap);
            if (rc == 0) {
                if (zfs_codec_outlen > cap) { return zt_bad(name, "outlen beyond dlen"); }
                if (place == 0) { acc = acc + 1; }
            } elif (rc == 0 - 1) {
                if (zfs_codec_outlen != 0) { return zt_bad(name, "outlen not 0 after a failure"); }
                if (place == 0) { rej = rej + 1; }
            } else {
                return zt_bad(name, "returned neither 0 nor -1");
            }
            if (place == 1) {
                if (zt_all(dst + cap, 64, 0xA5) == 0) { return zt_bad(name, "wrote past dlen"); }
            }
            place = place + 1;
        }
        it = it + 1;
    }
    if (rej == 0) { return zt_bad(name, "no mutant was refused: the fuzzer is not reaching the decoder"); }
    zt_puts("  ");
    zt_puts(name);
    zt_puts(": ");
    zt_putn(iters);
    zt_puts(" mutants x 2 placements, ");
    zt_putn(rej);
    zt_puts(" refused, ");
    zt_putn(acc);
    zt_puts(" accepted, no fault");
    zt_nl();
    return zt_ok(name);
}

# --- local cases ----------------------------------------------------------------------------------
fn zt_init_idempotent() {
    var name = "zfs_codec_init twice, then sha256 abc";
    zfs_codec_init();
    zfs_codec_init();
    zfs_sha256_words("abc", 3, &zt_o);
    if (load64(&zt_o) != 0xBA7816BF8F01CFEA) { return zt_bad(name, "word 0"); }
    if (load64(&zt_o + 24) != 0xB410FF61F20015AD) { return zt_bad(name, "word 3"); }
    return zt_ok(name);
}

fn main() {
    zt_puts("zfscodec: host oracle for kernel/core/zfs_codec.cyr");
    zt_nl();
    zt_srcA = zt_guarded();
    zt_dstA = zt_guarded();
    zt_stage = zt_map(ZT_AREA);
    zt_plain = zt_map(ZT_AREA);
    zt_fz = zt_map(ZT_AREA);
    zt_prng = zt_map(zv_prng_len());
    zt_prng_fill();
    # no zfs_codec_init() here on purpose: the first checksum case proves the lazy init
    zv_run();
    zt_init_idempotent();
    var want = zv_case_count() + ZT_LOCAL;
    zt_puts("zfscodec: ");
    zt_putn(zt_ran);
    zt_puts(" case(s) run of ");
    zt_putn(want);
    zt_puts(", ");
    zt_putn(zt_pass);
    zt_puts(" pass, ");
    zt_putn(zt_fail);
    zt_puts(" fail");
    zt_nl();
    if (zt_fail != 0) { return 90; }
    if (zt_ran != want) {
        zt_puts("zfscodec: FAIL -- the case count does not match the generated list");
        zt_nl();
        return 90;
    }
    if (zt_pass < ZT_FLOOR) {
        zt_puts("zfscodec: FAIL -- vacuous: fewer than the floor of cases passed");
        zt_nl();
        return 90;
    }
    zt_puts("zfscodec: PASS");
    zt_nl();
    return 95;
}

fn _entry() {
    var r = main();
    syscall(SYS_EXIT, r);
    return 0;
}
_entry();
