[package]
name = "faulter"
version = "0.1.0"
description = "agnos fault-handling test — a program that deliberately takes a #PF, used to check that a faulted background (&) job is torn down instead of halting the shell."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
src = "faulter.cyr"
output = "build/faulter"

# syscalls -> sys_write + SYS_EXIT. Nothing else: the point is a SMALL binary that
# reaches its fault fast, so the shell's reaction is the only variable under test.
[deps]
# ⚠ 1.57.14 (cyrius 6.6.20): `alloc` includes `poison` since 6.6.18 — declared because `cyrius lib sync` copies only
# what is declared (the 1.57.2 tests/chan precedent; `cyrius deps` vendored it where lib sync did not).
stdlib = ["syscalls", "alloc", "atomic", "fnptr", "poison"]
