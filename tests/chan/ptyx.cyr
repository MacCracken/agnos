# ptyx.cyr — the ipc BITE 9 proof: an UNMODIFIED program, using nothing but plain read(2)/write(2)
# on fd 0 and fd 1, talking over a channel because the kernel made its stdio one.
#
# ⛔ THE POINT IS EVERYTHING THIS FILE DOES *NOT* DO. It never calls `chan_op`. It does not know a
# channel exists, does not read `AGNOS_CHAN`, and does not mint, endow or poll anything. It is the
# same shape as agnsh, which reads fd 0 with a plain `sys_read` and would never have worked against a
# band it had to be rewritten for. A PTY that requires the child to learn a new API is not a PTY.
#
# The parent (the boot selftest) mints a channel, queues one record into this child's inbox, endows
# the far end in PTY MODE (`CH_ENDOW` with a4=1, which installs the endpoint at fd 0/1/2), and execs
# us. We read our stdin, verify it, and answer on our stdout.
#
# ⚠ The parent and this child are NOT concurrent — `sh_exec` is run-to-completion under IF=0 — so the
# input record is queued BEFORE the exec and our reply is drained AFTER we exit. That is why this
# proves the plumbing without needing a scheduler that does not exist yet at this layer.

fn say(s, n) { sys_write(1, s, n); return 0; }

fn main(): i64 {
    alloc_init();

    # ⭐ PLAIN read(2) ON fd 0 — no chan_op. If the kernel's VFS_CHAN read arm or the PTY-mode
    # placement is missing, this returns an error and the whole bite is unproven.
    var buf = alloc(128);
    var n = sys_read(0, buf, 64);
    if (n <= 0) {
        say("PTYX-STDIN-READ-FAILED\n", 23);
        say("PTYX-DONE\n", 10);
        return 1;
    }

    # The parent queued exactly "PING" (4 bytes). A record transport delivers it whole or not at all.
    var ok = 1;
    if (n != 4) { ok = 0; }
    if (load8(buf) != 80) { ok = 0; }        # 'P'
    if (load8(buf + 1) != 73) { ok = 0; }    # 'I'
    if (load8(buf + 2) != 78) { ok = 0; }    # 'N'
    if (load8(buf + 3) != 71) { ok = 0; }    # 'G'

    if (ok == 1) { say("PTYX-STDIO-OK\n", 14); }
    else { say("PTYX-STDIN-CONTENT-WRONG\n", 25); }

    # ⛔ ONE UNCONDITIONAL FINAL LINE, and it must be a line that can only be LAST — a dwell marker
    # that matches a verdict truncates the run at the first verdict and reads as a failing assertion
    # rather than a cut-off log. (Learned the hard way by chanx.)
    say("PTYX-DONE\n", 10);
    if (ok == 1) { return 0; }
    return 1;
}

fn _entry(): i64 { args_init(); var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
