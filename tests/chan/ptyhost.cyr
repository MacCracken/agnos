# ptyhost.cyr — the ring-3 PTY HOST for ipc bite 9. This is puka's `pty_*` backend in miniature:
# mint a channel, endow the far end to a child IN PTY MODE, spawn it, then pump its output.
#
# ⛔ WHY THIS IS A RING-3 PROGRAM AND NOT A BOOT SELFTEST. The first cut ran the host from the kernel
# boot context, and it structurally cannot work: that context is **pid 0**, and the first spawned user
# process is also **slot 0** — so `proc_alloc_slot` bumps pid 0's epoch when the child is born, and the
# parent's OWN endpoints stop authorizing (`chan_auth` compares incarnations, which is bite 2's whole
# purpose). A parent that holds a channel across a spawn must be a real process. `chanx` never noticed
# because it only ever inspects the CHILD's behaviour; nothing there survives the spawn and reads back.
#
# ⭐ THE CHILD (`/bin/ptyx`) NEVER CALLS `chan_op`. It reads fd 0 and writes fd 1 with plain
# read(2)/write(2). Everything below is the host side; the child side is "be an ordinary program".

fn say(s, n) { sys_write(1, s, n); sys_write(1, "\n", 1); return 0; }

fn say_num(s, n, v) {
    sys_write(1, s, n);
    print_num(v);
    sys_write(1, "\n", 1);
    return 0;
}

fn main(): i64 {
    alloc_init();
    say("PTYHOST-START", 13);

    var fds = alloc(32);
    if (sys_chan_mint(fds) != 0) { say("PTYHOST-MINT-FAIL", 17); return 1; }
    var fa = load64(fds);          # host end — we keep this
    var fb = load64(fds + 8);      # child end — becomes the child's stdio

    # ⛔ QUEUE THE CHILD'S STDIN BEFORE THE SPAWN. Sending from `fa` lands the record in `fb`'s inbox,
    # which is what the child reads as fd 0. Doing it first means the child finds its input already
    # waiting and the test does not depend on the two processes interleaving in a particular order.
    var pbuf = alloc(64);
    store8(pbuf, 80); store8(pbuf + 1, 73); store8(pbuf + 2, 78); store8(pbuf + 3, 71);   # "PING"
    if (sys_chan_send(fa, pbuf, 4) != 4) { say("PTYHOST-SEND-FAIL", 17); return 1; }

    # ⭐ PTY-MODE ENDOWMENT. a4 = CH_ENDOW_STDIO (1000) installs this endpoint at the child's fd 0, 1
    # AND 2. The stdlib's `sys_chan_endow` takes no mode argument, so the raw form is used here — a4 is
    # the fifth argument to `syscall`, matching `sys_chan_send`'s (fd, buf, len) convention.
    # ⚠ 1000 is deliberately larger than any legal record length: a4 doubles as a LENGTH for SEND/RECV
    # and is not cleared between ops, so only a value no length can take is safe to read a mode from.
    var cfd = syscall(97, 5, fb, 0, 1000);        # 5 = CH_ENDOW
    if (cfd < 0) { say_num("PTYHOST-ENDOW-FAIL ", 19, cfd); return 1; }
    say_num("PTYHOST-CHILD-FD ", 17, cfd);

    # ⭐ `ptyhost agnsh` hosts the REAL SHELL instead of the toy child — the actual bite-9 goal minus
    # the composited window. agnsh is the honest test because it was written years before this band
    # and reads fd 0 with a plain `sys_read`; nothing in it was adapted.
    var path = "/bin/ptyx";
    var plen = 9;
    var shell = 0;
    if (argc() > 1) {
        if (load8(argv(1)) == 97) { path = "/bin/agnsh"; plen = 10; shell = 1; }   # 'a'
    }
    var pid = sys_spawn_path(path, plen);
    if (pid < 0) { say_num("PTYHOST-SPAWN-FAIL ", 19, pid); return 1; }
    say_num("PTYHOST-SPAWNED ", 16, pid);

    # ⭐ PUMP. This is `pty_pump`: read records off the host end and emit them. Bounded by IDLE ROUNDS,
    # not by a total count, so a slow child is tolerated but a dead one cannot hang us.
    # ⛔ THE RETRY IS A PREEMPTIBLE SPIN, NOT `sys_sleep_ms` AND NOT `sched_yield`. planning/ipc.md §9.4:
    # sleep_ms is `preempt_disable; sti; hlt` — it would starve the very child we are waiting for — and
    # sched_yield is a documented silent no-op under a foreground run. The kernel never blocks on a
    # channel (one SYSCALL stack per CPU), so waiting is userland's job and must stay preemptible.
    var rbuf = alloc(128);
    var lines = 0;
    var idle = 0;
    var done = 0;
    var fed = 0;
    while (done == 0) {
        # ⛔ FEED THE SHELL ONLY AFTER IT HAS SPOKEN. A command sent before agnsh has drained its
        # startup would sit in a queue it has not read yet, and a `version` that produced no answer
        # would look like the channel failing rather than the shell not being ready.
        if (shell == 1) {
            if (fed == 0) {
                if (lines > 2) {
                    var cmd = alloc(32);
                    store8(cmd, 118); store8(cmd + 1, 101); store8(cmd + 2, 114);
                    store8(cmd + 3, 115); store8(cmd + 4, 105); store8(cmd + 5, 111);
                    store8(cmd + 6, 110); store8(cmd + 7, 10);                  # "version\n"
                    sys_chan_send(fa, cmd, 8);
                    fed = 1;
                    idle = 0;
                }
            }
        }
        var r = sys_chan_recv(fa, rbuf, 128);
        if (r > 0) {
            idle = 0;
            lines = lines + 1;
            sys_write(1, "PTYHOST-OUT ", 12);
            sys_write(1, rbuf, r);
            if (load8(rbuf + r - 1) != 10) { sys_write(1, "\n", 1); }
        }
        else {
            if (r == 0 - CH_E_PEERGONE) { done = 1; }
            else {
                idle = idle + 1;
                if (idle > 400) { done = 1; }
                var spin = 0;
                while (spin < 20000) { spin = spin + 1; }
            }
        }
    }

    sys_waitpid(pid);
    if (shell == 1) { say("PTYHOST-SHELL-MODE", 18); }
    say_num("PTYHOST-RECORDS ", 16, lines);
    if (lines > 0) { say("PTYHOST-PASS", 12); }
    else { say("PTYHOST-FAIL-NO-OUTPUT", 22); }
    sys_chan_close(fa);
    say("PTYHOST-DONE", 12);
    if (lines > 0) { return 0; }
    return 1;
}

fn _entry(): i64 { args_init(); var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
