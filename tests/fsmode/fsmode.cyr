# fsmode — the RING-3 half of agnos 1.57.18's open#7 create mode (AO_MODE) and fsync#115 on ext2.
#
# Issue: 2026-11-06-open-has-no-create-mode (filed from thoth 0.55.1: its tool pins, session store and session log are
#        0600 on Linux and macOS and landed 0644 on agnos; the "Related" half: fsync was the whole-system sync#12).
# Seeded as /bin/agnsh on a PLAIN kernel by scripts/smoke/fs-create-mode-smoke.sh, which maps the markers below, KILLS
# QEMU on the DONE line (a crash cut: no close, no sync, no shutdown after it) and then reads the partition on the host
# (debugfs: every mode, the durable file's bytes; e2fsck -fn). Raw `syscall(N, a1, a2, a3, a4)` with explicit zeros (a
# 3-argument call passes a garbage r10). A failure prints `FSMODE-FAIL-<name> v=...` and never its OK marker. The
# program ends `FSMODE-DONE pass=P fail=F` and then SLEEPS (never exits): the host's kill is the cut.
#
#   M  AO_MODE (a3 0x4000; bits 32..63 = the mode): creates of 0600, 0640, 0755, 04755 and 01644 read back by stat#33
#      as S_IFREG | the mode; no AO_MODE with a field set -> 0644 (the field ignored); an EXISTING file opened with
#      AO_CREAT | AO_MODE 0777 keeps its 0600; a field above 07777 (010000, 0xFFFFFFFF, bit 63) -> -1 and nothing made.
#   F  fsync#115: on an ext2 file fd 0 and NO sector written (sysinfo#35's NVMe band: ext2 writes through, the fsync is
#      the device flush); a read-only fd and an AO_DIRECTORY fd 0; the console, both pipe ends, a closed fd, 99 and -1
#      -> -1. Then the MEASUREMENT (FSMODE-MEASURE): 20 x (write 4 KiB, fsync#115) against 20 x (write 4 KiB, sync#12)
#      — microseconds (uptime_us#95) and sectors written per call, and by the write after each.
#   D  /fm/durable: 5,000 bytes written, fsync#115 -> 0, then the DONE line and the cut; the host reads them back.

# Module-scope `var X[N]` is N u64 = 8N BYTES.
var f_lb[32];           # 256 B the current output line
var F_LN = 0;
var F_PASS = 0;
var F_FAIL = 0;
var f_wb[1024];         # 8 KB write buffer
var f_st[6];            # 48 B stat#33 struct (§4.1)
var f_si[26];           # 208 B sysinfo#35 (§4.4): blk2_write (NVMe) at +144
var f_pp[2];            # pipe#25's two fds

fn f_flush() { if (F_LN > 0) { syscall(1, 1, &f_lb, F_LN, 0); } F_LN = 0; return 0; }
fn f_putc(ch) {
    if (F_LN >= 250) { f_flush(); }
    store8(&f_lb + F_LN, ch);
    F_LN = F_LN + 1;
    if (ch == 10) { f_flush(); }
    return 0;
}
fn f_out(s) { var i = 0; while (load8(s + i) != 0) { f_putc(load8(s + i)); i = i + 1; } return 0; }
fn f_num(n) {
    if (n < 0) { f_putc(45); n = 0 - n; }
    var d[3];
    var i = 0;
    if (n == 0) { f_putc(48); return 0; }
    while (n > 0) { store8(&d + i, 48 + n % 10); n = n / 10; i = i + 1; }
    while (i > 0) { i = i - 1; f_putc(load8(&d + i)); }
    return 0;
}
fn f_oct(n) { if (n >= 8) { f_oct(n / 8); } f_putc(48 + n % 8); return 0; }
fn f_kv(k, v) { f_out(" "); f_out(k); f_out("="); f_num(v); return 0; }
fn f_nl() { f_out("\n"); return 0; }
fn f_ok(m) { f_out(m); f_nl(); F_PASS = F_PASS + 1; return 0; }
fn f_fail(m, v) { f_out("FSMODE-FAIL-"); f_out(m); f_kv("v", v); f_nl(); F_FAIL = F_FAIL + 1; return 0; }
fn f_len(s) { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }

fn f_open(p, fl) { return syscall(7, p, f_len(p), fl, 0); }
fn f_close(fd) { return syscall(6, fd, 0, 0, 0); }
fn f_fsync(fd) { return syscall(115, fd, 0, 0, 0); }
fn f_sync() { return syscall(12, 0, 0, 0, 0); }
fn f_us() { return syscall(95, 0, 0, 0, 0); }
fn f_mode(p) { if (syscall(33, p, f_len(p), &f_st, 0) != 0) { return 0 - 1; } return load64(&f_st); }
fn f_size(p) { if (syscall(33, p, f_len(p), &f_st, 0) != 0) { return 0 - 1; } return load64(&f_st + 16); }
fn f_wsec() { if (syscall(35, &f_si, 208, 0, 0) != 0) { return 0 - 1; } return load64(&f_si + 144); }
# open#7's a3 for a create of mode m: AO_WRONLY | AO_CREAT | AO_EXCL | AO_MODE, m in bits 32..63
fn f_cflags(m) { return 0x6101 | (m << 32); }
fn f_byte(k) { return (k * 7 + 3 + (k >> 9)) & 0xFF; }

# One create of mode m at p: stat#33 must read S_IFREG | m.
fn f_mk(p, m, name) {
    var fd = f_open(p, f_cflags(m));
    var md = f_mode(p);
    if (fd >= 0) { f_close(fd); }
    f_out("FSMODE-M "); f_out(p); f_out(" want=0"); f_oct(0x8000 | m); f_out(" got=0");
    if (md >= 0) { f_oct(md); } else { f_out("-1"); }
    f_kv("fd", fd); f_nl();
    if (fd >= 0 && md == (0x8000 | m)) { f_ok(name); } else { f_fail(name, md); }
    return 0;
}

fn ph_m() {
    if (syscall(9, "/fm", 3, 0, 0) != 0) { f_fail("MKDIR", 0 - 1); }
    f_mk("/fm/m600", 0x180, "FSMODE-MODE-0600-OK");
    f_mk("/fm/m640", 0x1A0, "FSMODE-MODE-0640-OK");
    f_mk("/fm/m755", 0x1ED, "FSMODE-MODE-0755-OK");
    f_mk("/fm/m4755", 0x9ED, "FSMODE-MODE-04755-OK");
    f_mk("/fm/m1644", 0x3A4, "FSMODE-MODE-01644-OK");
    # no AO_MODE, the field set: ignored, the default 0644
    var dfd = f_open("/fm/mdef", 0x2101 | (0x180 << 32));
    var dm = f_mode("/fm/mdef");
    if (dfd >= 0) { f_close(dfd); }
    f_out("FSMODE-M /fm/mdef"); f_kv("mode", dm); f_nl();
    if (dfd >= 0 && dm == 0x81A4) { f_ok("FSMODE-MODE-DEFAULT-OK"); } else { f_fail("MODE-DEFAULT", dm); }
    # an EXISTING file: AO_CREAT | AO_MODE 0777 opens it and leaves its 0600 alone
    var efd = f_open("/fm/m600", 0x4101 | (0x1FF << 32));
    var em = f_mode("/fm/m600");
    if (efd >= 0) { f_close(efd); }
    if (efd >= 0 && em == 0x8180) { f_ok("FSMODE-MODE-EXISTING-KEPT-OK"); } else { f_fail("MODE-EXISTING-KEPT", em); }
    # a field above 07777: -1, nothing created (010000, all 32 bits, and bit 63 — a3 negative)
    var b1 = f_open("/fm/mbad", f_cflags(0x1000));
    var b2 = f_open("/fm/mbad", f_cflags(0xFFFFFFFF));
    var b3 = f_open("/fm/mbad", 0x6101 | (1 << 63));
    var bs = f_mode("/fm/mbad");
    f_out("FSMODE-M /fm/mbad"); f_kv("b1", b1); f_kv("b2", b2); f_kv("b3", b3); f_kv("stat", bs); f_nl();
    if (b1 == 0 - 1 && b2 == 0 - 1 && b3 == 0 - 1 && bs == 0 - 1) { f_ok("FSMODE-MODE-BAD-REFUSED-OK"); }
    else { f_fail("MODE-BAD-REFUSED", bs); }
    return 0;
}

fn ph_f() {
    var k = 0;
    while (k < 8192) { store8(&f_wb + k, f_byte(k)); k = k + 1; }
    var fd = f_open("/fm/data", 0x2102);                           # AO_RDWR | AO_CREAT | AO_EXCL
    var w = syscall(1, fd, &f_wb, 8192, 0);
    var s0 = f_wsec();
    var r = f_fsync(fd);
    var s1 = f_wsec();
    f_out("FSMODE-F file"); f_kv("fd", fd); f_kv("write", w); f_kv("fsync", r); f_kv("sectors", s1 - s0); f_nl();
    if (fd >= 0 && w == 8192 && r == 0 && s0 >= 0 && s1 == s0) { f_ok("FSMODE-FSYNC-FILE-OK"); } else { f_fail("FSYNC-FILE", r); }
    var ro = f_open("/fm/data", 0);
    var rr = f_fsync(ro);
    if (ro >= 0 && rr == 0) { f_ok("FSMODE-FSYNC-RDONLY-OK"); } else { f_fail("FSYNC-RDONLY", rr); }
    var dd = f_open("/fm", 0x800);
    var dr = f_fsync(dd);
    if (dd >= 0 && dr == 0) { f_ok("FSMODE-FSYNC-DIR-OK"); } else { f_fail("FSYNC-DIR", dr); }
    var pc = syscall(25, &f_pp, 0, 0, 0);
    var c1 = f_fsync(1);
    var c2 = f_fsync(load64(&f_pp));
    var c3 = f_fsync(load64(&f_pp + 8));
    var c4 = f_fsync(30);                                            # a closed fd
    var c5 = f_fsync(99);
    var c6 = f_fsync(0 - 1);
    f_out("FSMODE-F nonfile"); f_kv("console", c1); f_kv("pipe_r", c2); f_kv("pipe_w", c3); f_kv("closed", c4);
    f_kv("fd99", c5); f_kv("fdneg", c6); f_nl();
    if (pc == 0 && c1 == 0 - 1 && c2 == 0 - 1 && c3 == 0 - 1 && c4 == 0 - 1 && c5 == 0 - 1 && c6 == 0 - 1) {
        f_ok("FSMODE-FSYNC-NONFILE-REFUSED-OK");
    } else { f_fail("FSYNC-NONFILE-REFUSED", c1); }
    f_close(load64(&f_pp));
    f_close(load64(&f_pp + 8));
    f_close(dd);
    f_close(ro);
    # the MEASUREMENT: per call — microseconds and sectors of fsync#115 / sync#12, and of the write after each
    var fus = 0;
    var fsec = 0;
    var fws = 0;
    var sus = 0;
    var ssec = 0;
    var sws = 0;
    var i = 0;
    while (i < 40) {
        var a = f_wsec();
        syscall(1, fd, &f_wb, 4096, 0);
        var b = f_wsec();
        var t0 = f_us();
        var rc = 0;
        if (i < 20) { rc = f_fsync(fd); } else { rc = f_sync(); }
        var t1 = f_us();
        var c = f_wsec();
        if (rc != 0) { f_fail("MEASURE-CALL", i); }
        if (i > 0 && i < 20) { fus = fus + t1 - t0; fsec = fsec + c - b; fws = fws + b - a; }
        if (i > 20) { sus = sus + t1 - t0; ssec = ssec + c - b; sws = sws + b - a; }
        i = i + 1;
    }
    f_out("FSMODE-MEASURE n=19 fsync115_us="); f_num(fus / 19); f_kv("fsync115_sectors", fsec); f_kv("write_after_fsync_sectors", fws);
    f_kv("sync12_us", sus / 19); f_kv("sync12_sectors", ssec); f_kv("write_after_sync_sectors", sws); f_nl();
    if (fsec == 0 && ssec >= 38) { f_ok("FSMODE-MEASURE-OK"); } else { f_fail("MEASURE", fsec); }
    f_close(fd);
    return 0;
}

fn ph_d() {
    var k = 0;
    while (k < 5000) { store8(&f_wb + k, f_byte(k + 11)); k = k + 1; }
    var fd = f_open("/fm/durable", 0x2102);
    var w = syscall(1, fd, &f_wb, 5000, 0);
    var r = f_fsync(fd);
    if (fd >= 0 && w == 5000 && r == 0) { f_ok("FSMODE-DURABLE-FSYNCED-OK"); } else { f_fail("DURABLE-FSYNCED", r); }
    return 0;                                                        # the fd stays open: the cut comes first
}

fn main(): i64 {
    f_out("FSMODE-ALIVE"); f_nl();
    ph_m();
    ph_f();
    ph_d();
    f_out("FSMODE-DONE"); f_kv("pass", F_PASS); f_kv("fail", F_FAIL); f_nl();
    while (1 == 1) { syscall(41, 1000, 0, 0, 0); }                   # sleep: the host's kill on DONE is the cut
    return 0;
}

fn _entry(): i64 { var rc = main(); syscall(0, rc, 0, 0, 0); return 0; }
_entry();
