# zfsx — ring-3 exerciser for the ZFS mount (agnos 1.57.11 read-only; 1.57.12 B5 writes).
#
# ⭐ IT RUNS FROM ZFS. scripts/tool/zfs-fixture.sh stages this binary into the pool's `agnostank/payload`
# dataset, and scripts/harness/zfs-ring3-test.py types `/mnt/zfs/agnostank/payload/zfsx` at agnsh — so the
# spawn#43 that starts it already read the ELF through vfs_file_size + vfs_read_file_at on FS_ZFS. A run that
# reports any exit code at all has proven exec-from-ZFS.
# The fixture's contract (scripts/tool/zfs-fixture.sh recipe 1, pool `agnostank`, mounted at /agnostank):
# hello.txt = "hello from zfs\n" with a hard link hello-link.txt, sym-short -> hello.txt, dir3000/f0000..f2999,
# big.bin (6 MiB). ⚠ THE EXIT CODE IS THE RESULT: 95 = every clause held; 60..91 and 100..161 name the first one that
# broke (scripts/harness/zfs-ring3-test.py carries the table).
# 1.57.12 B5 (design § a.4, § i.1): the pool is read-write now, but agnostank/zpl4 is not (ZPL 4 — the ROOT dataset, which
# has agnostank@snap1, was not either until B9): the write verbs are refused THERE (81-85, 111, 112), and on a read-only
# fd (88). The
# writes (100-110) go to agnostank/custom (mounted at /somewhere/else) — custom.txt, written, extended, written past its
# end (a hole), read back, AO_TRUNC'd and written again: FIVE txgs (policy A: one per write#1 and per truncating open),
# with bytes from agnos-gen-1 (zx_gen — scripts/smoke/lib/zfs-expect.py's generator), so the harness predicts the file
# exactly and OpenZFS verifies the pool after the run (lane main@ring3). 1.57.12 B6 (114-130): then it CREATES there —
# mkdir b6, AO_CREAT | AO_EXCL b6/new.txt + 100 bytes, symlink#63 b6/sym -> new.txt (agnostank/custom holds the symlink
# layout since fixture RECIPE 5; lstat / readlink / stat through it), AO_CREAT | AO_TRUNC b6/t.txt + 10 (a new name: not
# truncated) — six more txgs, stat / getdents of what it made, and the refusals: an existing name, AO_EXCL, a symlink
# whose target holds a NUL byte, one on the read-only root, a relative AO_CREAT path of 4126 bytes (B6 review: a long one
# was truncated to 254 and created; 266 bytes against that bound until 1.57.18, whose cwd ingress bounds the INPUT at
# 4095). Every refused ZFS verb logs `zfs: <verb> refused (<why>)` — the harness holds the run
# to that list, in order. 1.57.12 B8 (124, 126, 128, 148-149): what B6 refused there now SUCCEEDS — a symlink in
# coff/kid (no symlink layout: a NEW SA layout, the LAYOUTS add) and a 50-byte name in b6 (its microzap UPGRADED to a fat
# ZAP, so every later op in b6 — B7's links, renames, unlinks — works on a fat ZAP); getdents of the fat b6; a 255-byte
# name (13 name chunks) created, stat'ed and unlinked, and the 50-byte one unlinked — five more txgs.
# 1.57.12 B7 (131-145): then it REMOVES and RENAMES there — link#32 b6/new.txt -> new-link.txt (nlink 2), rename#31 b6/t.txt
# -> t2.txt, the second name across directories (-> custom-hl.txt) and unlink#30 of it (nlink 1 again: new.txt keeps the
# stale PARENT design § k.15 names, OpenZFS's own state), a directory made, moved across (b6/d -> b7d) and rmdir#10'd, the
# symlink b6/sym unlinked, an fd across the unlink of t2.txt and the create (b6/r.txt) that may take its number back —
# read / write / SEEK_END -1 each time (D11) — ten more txgs; and the refusals: unlink of a directory, rmdir of a
# non-empty one and of a file, rename and link across datasets, a directory under itself, link of a directory, link and
# rmdir on the read-only root, rmdir of a mount point; (B7 review, 146-147) a NEW name holding a NUL byte — rename#31 to
# "new.txt\0x" (its chunk's C string would be new.txt's own) and link#32 to "\0lnk" (a chunk that reads as free).
# 1.57.12 B9 (150-155 — its own track's 148-153, renumbered past B8's 148-149 at the merge): then it writes in the
# SNAPSHOTTED ROOT, agnostank (@snap1) — every block its ops kill there is the snapshot's, so it goes to the root's
# deadlist and is never freed: an RMW of tiny.bin, rand-1m.bin AO_TRUNC'd and written (eight records and their L1),
# hello.txt's EMBEDDED block rewritten and read back under hello-link.txt, unlink of deep/a/b/c/d/e/leaf.txt, the
# emptied e moved to deep/e9, mkdir deep/z9 + a new file of 20 bytes — nine txgs.
# 1.57.12 B11 (156-161): POLICY B — a write is coalesced per fd and durable at close / sync#12 / exit (design § b.2 D1 (b)).
# On agnostank/custom: b11.bin created and 8 x 64 KiB written through ONE fd — one txg, at its close — and read back;
# 2,000 bytes written through fd A and read through fd B before A is closed (commit-before-observe: B sees them, 157);
# an extend through A seen by stat#33 (158); a write through a third fd committed by sync#12 (159, which answers 0);
# b11big.bin, 2 MiB through one fd whose CLOSE commits it — the per-CPU tick counters of sysinfo#35 read around that
# close and printed (`zfsx: b11 close ticks ...`: a CPU that held interrupts off for the commit missed its ticks — the
# harness reports them, design k.126 (B11)); and b11exit.bin, written and NEVER CLOSED: the exit's fd-table teardown
# commits it (160 is the clause before it; the pool is the proof). Nine txgs.
# 1.57.18 (162-165, 170-174): open#7's AO_MODE — m600.txt / m640.txt / m755.bin / m604.txt (0604: the ACL's allow0 +
# deny2 entries) created with their modes and read back by stat#33, mdef.txt (no AO_MODE: 0644), the existing m600.txt
# opened AO_CREAT | AO_MODE 0777 and kept, a field above 07777 refused — five txgs; then fsync#115 in a FORKED CHILD
# that runs once zfsx is gone (zx_child: a pending file committed by its fsync, a read-only fd committing another fd's
# writes, an ext2 fsync that commits nothing of ZFS's against sync#12 that does, a directory and non-file fds, and
# f115b.bin left PENDING while five other fds are fsync'd — not one sector written); it prints `zfsx: child verdict N`
# and sleeps, so the harness's kill is a crash cut that must lose f115b.bin's bytes and keep the rest. Seven txgs.

# ⚠ The large buffers live at MODULE scope (8 B per element): an agnos exec gets ~12 KB of usable init stack
# (roadmap TRUE), so a 64 KiB local would fault before the first syscall.
var zx_gd[512];       # 4 KiB getdents buffer
var zx_page[512];     # 4 KiB = 64 readdir_at records
var zx_big[8192];     # 64 KiB read buffer
var zx_wb[256];       # 2 KiB write buffer (agnos-gen-1 bytes)
var zx_wc[256];       # 2 KiB read-back buffer

fn zx_len(s) { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
# Print s (NUL-terminated) and then v in decimal (v >= 0) to fd 1. 0.
fn zx_putn(s, v) {
    syscall(1, 1, s, zx_len(s));
    var d[24];
    var i = 23;
    store8(&d + i, 0);
    if (v == 0) {
        i = i - 1;
        store8(&d + i, 48);
    }
    while (v > 0) {
        i = i - 1;
        store8(&d + i, 48 + v % 10);
        v = v / 10;
    }
    syscall(1, 1, &d + i, 23 - i);
    return 0;
}
fn zx_eq(a, b, n) { var i = 0; while (i < n) { if (load8(a + i) != load8(b + i)) { return 0; } i = i + 1; } return 1; }
fn zx_zero(a, n) { var i = 0; while (i < n) { if (load8(a + i) != 0) { return 0; } i = i + 1; } return 1; }
fn zx_open(p, fl) { return syscall(7, p, zx_len(p), fl, 0); }
# agnos-gen-1 (scripts/smoke/lib/zfs-expect.py `gen`; the kernel's zfs_wenc.cyr zfs_gen_fill): bytes [off, off + n) of the
# stream of seed s — FNV-1a-64 of s, splitmix64's (x >> 3)-th word, its little-endian byte x & 7.
fn zx_word(h, i) {
    var z = h + (i + 1) * 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    return z ^ (z >> 31);
}
fn zx_gen(s, off, dst, n) {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (load8(s + i) != 0) { h = (h ^ load8(s + i)) * 0x100000001B3; i = i + 1; }
    var k = 0;
    while (k < n) {
        var x = off + k;
        store8(dst + k, (zx_word(h, x >> 3) >> ((x & 7) * 8)) & 0xFF);
        k = k + 1;
    }
    return 0;
}

# ---- 1.57.18 helpers: open#7's AO_MODE and fsync#115 ----
var zx_si[26];        # 208 B sysinfo#35 (ABI § 4.4): the per-device sectors-WRITTEN band at +104 + tag * 16 + 8
var zx_st2[6];        # 48 B a stat#33 struct for the helpers
# Sectors written so far on every block device (tags 1..5 of sysinfo#35's band): a commit writes, nothing else here does.
fn zx_wsec() {
    if (syscall(35, &zx_si, 208, 0, 0) != 0) { return 0 - 1; }
    var t = 1;
    var n = 0;
    while (t <= 5) { n = n + load64(&zx_si + 104 + t * 16 + 8); t = t + 1; }
    return n;
}
fn zx_us() { return syscall(95, 0, 0, 0, 0); }
# A create of permission bits m at p (AO_WRONLY | AO_CREAT | AO_EXCL | AO_MODE, m in bits 32..63): stat#33 must read
# S_IFREG | m. 0 / -1, the line printed either way.
fn zx_mk(p, m) {
    var fd = syscall(7, p, zx_len(p), 0x6101 | (m << 32), 0);
    if (fd >= 0) { syscall(6, fd, 0, 0, 0); }
    var md = 0 - 1;
    if (syscall(33, p, zx_len(p), &zx_st2, 0) == 0) { md = load64(&zx_st2); }
    syscall(1, 1, "zfsx: AO_MODE ", 14);
    syscall(1, 1, p, zx_len(p));
    zx_putn(" want=", 0x8000 | m);
    zx_putn(" got=", md & 0xFFFF);
    syscall(1, 1, "\n", 1);
    if (fd < 0 || md != (0x8000 | m)) { return 0 - 1; }
    return 0;
}
# The child's lines go out as ONE write#1 each (zx_ls / zx_ln, then zx_lput): the child runs beside agnsh, whose prompt
# lands on the same console the moment zfsx exits — a line written in pieces came out split by it ("zfsx: child verdict
# [ASSIST] > 170"), which the harness could not read.
var zx_lb[32];        # 256 B the line being built
var ZX_LN = 0;
fn zx_ls(s) { var i = 0; while (load8(s + i) != 0 && ZX_LN < 250) { store8(&zx_lb + ZX_LN, load8(s + i)); ZX_LN = ZX_LN + 1; i = i + 1; } return 0; }
fn zx_ln(v) {
    if (v < 0) { zx_ls("-"); v = 0 - v; }
    var d[3];
    var i = 0;
    if (v == 0) { zx_ls("0"); return 0; }
    while (v > 0) { store8(&d + i, 48 + v % 10); v = v / 10; i = i + 1; }
    while (i > 0 && ZX_LN < 250) { i = i - 1; store8(&zx_lb + ZX_LN, load8(&d + i)); ZX_LN = ZX_LN + 1; }
    return 0;
}
fn zx_lput() {
    store8(&zx_lb + ZX_LN, 10);
    syscall(1, 1, &zx_lb, ZX_LN + 1, 0);
    ZX_LN = 0;
    return 0;
}
# The child's verdict (95 = clauses 170-174 held), printed for the harness — then it SLEEPS, never exits: its last file's
# writes stay pending until the harness kills QEMU.
fn zx_cv(code) {
    zx_ls("zfsx: child verdict ");
    zx_ln(code);
    zx_lput();
    while (1 == 1) { syscall(41, 1000, 0, 0, 0); }
    return 0;
}
# ⭐ fsync#115 on the ZFS mount (1.57.18) — run by a CHILD once zfsx itself is gone (the fork in zx_main), so its last
# pending write is held by a live process when the harness's kill cuts the machine:
#   170 f115a.bin: 1,000 bytes pending, fsync#115 of its fd -> 0 and the commit WROTE (the sectors band moved)
#   171 f115r.bin: a READ-ONLY fd opened before the write; another fd's 500 bytes pending, fsync#115 of the READ-ONLY fd
#       commits them
#   172 f115p.bin pending + an ext2 file (/zfsx-f115.txt, 4 KiB): the ext2 fsync#115 writes NOTHING (ext2 writes through;
#       ZFS's pending txg stays pending), then sync#12 commits f115p.bin — microseconds and sectors printed
#   173 a ZFS AO_DIRECTORY fd: 0; the console, a pipe's ends, a closed fd, 99: -1
#   174 f115b.bin: 700 bytes pending, then fsync#115 of EVERY other fd (f115a, both f115r fds, the directory, the ext2
#       file) -> 0 and NOT ONE sector written: another file's fsync commits nothing of it. The cut must lose them.
fn zx_child() {
    var fa = "/mnt/zfs/somewhere/else/f115a.bin";
    var a = zx_open(fa, 0x2102);
    if (a < 0) { return zx_cv(170); }
    zx_gen("zfsx/f115a", 0, &zx_wb, 1000);
    if (syscall(1, a, &zx_wb, 1000, 0) != 1000) { return zx_cv(170); }
    var s0 = zx_wsec();
    var t0 = zx_us();
    if (syscall(115, a, 0, 0, 0) != 0) { return zx_cv(170); }
    var t1 = zx_us();
    var s1 = zx_wsec();
    zx_ls("zfsx: child fsync#115 of the pending file: us=");
    zx_ln(t1 - t0);
    zx_ls(" sectors=");
    zx_ln(s1 - s0);
    zx_lput();
    if (s0 < 0 || s1 <= s0) { return zx_cv(170); }
    var fr = "/mnt/zfs/somewhere/else/f115r.bin";
    var w = zx_open(fr, 0x2102);
    var r = zx_open(fr, 0);
    if (w < 0 || r < 0) { return zx_cv(171); }
    zx_gen("zfsx/f115r", 0, &zx_wb, 500);
    if (syscall(1, w, &zx_wb, 500, 0) != 500) { return zx_cv(171); }
    s0 = zx_wsec();
    if (syscall(115, r, 0, 0, 0) != 0) { return zx_cv(171); }
    s1 = zx_wsec();
    if (s1 <= s0) { return zx_cv(171); }
    var fp = "/mnt/zfs/somewhere/else/f115p.bin";
    var p = zx_open(fp, 0x2102);
    if (p < 0) { return zx_cv(172); }
    zx_gen("zfsx/f115p", 0, &zx_wb, 600);
    if (syscall(1, p, &zx_wb, 600, 0) != 600) { return zx_cv(172); }
    var ep = "/zfsx-f115.txt";
    var e = zx_open(ep, 0x102);
    if (e < 0 || syscall(1, e, &zx_big, 4096, 0) != 4096) { return zx_cv(172); }
    s0 = zx_wsec();
    t0 = zx_us();
    if (syscall(115, e, 0, 0, 0) != 0) { return zx_cv(172); }
    t1 = zx_us();
    s1 = zx_wsec();
    var t2 = zx_us();
    if (syscall(12, 0, 0, 0, 0) != 0) { return zx_cv(172); }
    var t3 = zx_us();
    var s2 = zx_wsec();
    zx_ls("zfsx: child with a ZFS txg pending: ext2 fsync#115 us=");
    zx_ln(t1 - t0);
    zx_ls(" sectors=");
    zx_ln(s1 - s0);
    zx_ls(" | sync#12 us=");
    zx_ln(t3 - t2);
    zx_ls(" sectors=");
    zx_ln(s2 - s1);
    zx_lput();
    if (s1 != s0 || s2 <= s1) { return zx_cv(172); }
    var dn = "/mnt/zfs/somewhere/else";
    var d = zx_open(dn, 0x800);
    var pq[2];
    if (d < 0 || syscall(115, d, 0, 0, 0) != 0 || syscall(25, &pq, 0, 0, 0) != 0) { return zx_cv(173); }
    if (syscall(115, 1, 0, 0, 0) != 0 - 1 || syscall(115, load64(&pq), 0, 0, 0) != 0 - 1) { return zx_cv(173); }
    if (syscall(115, load64(&pq + 8), 0, 0, 0) != 0 - 1 || syscall(115, 30, 0, 0, 0) != 0 - 1 || syscall(115, 99, 0, 0, 0) != 0 - 1) { return zx_cv(173); }
    var fb = "/mnt/zfs/somewhere/else/f115b.bin";
    var b = zx_open(fb, 0x2102);
    if (b < 0) { return zx_cv(174); }
    zx_gen("zfsx/f115b", 0, &zx_wb, 700);
    if (syscall(1, b, &zx_wb, 700, 0) != 700) { return zx_cv(174); }
    s0 = zx_wsec();
    if (syscall(115, a, 0, 0, 0) != 0 || syscall(115, r, 0, 0, 0) != 0 || syscall(115, w, 0, 0, 0) != 0) { return zx_cv(174); }
    if (syscall(115, d, 0, 0, 0) != 0 || syscall(115, e, 0, 0, 0) != 0) { return zx_cv(174); }
    s1 = zx_wsec();
    zx_ls("zfsx: child f115b.bin pending, fsync#115 of five other fds: sectors=");
    zx_ln(s1 - s0);
    zx_lput();
    if (s1 != s0) { return zx_cv(174); }
    return zx_cv(95);
}

fn zx_main(): i64 {
    var hp = "/mnt/zfs/agnostank/hello.txt";
    var buf[64];
    # ---- open / read / EOF ----
    var fd = zx_open(hp, 0);
    if (fd < 0) { return 60; }
    var n = syscall(5, fd, &buf, 64);
    if (n != 15 || zx_eq(&buf, "hello from zfs\n", 15) == 0) { return 61; }
    if (syscall(5, fd, &buf, 64) != 0) { return 62; }
    # ---- lseek#58 on a VFS_ZFS_FILE ----
    if (syscall(58, fd, 6, 0) != 6) { return 63; }
    if (syscall(5, fd, &buf, 4) != 4 || zx_eq(&buf, "from", 4) == 0) { return 64; }
    if (syscall(58, fd, 0, 2) != 15) { return 65; }
    # ---- a read-only fd is not writable (the root itself is writable since B9) ----
    if (syscall(1, fd, "x", 1) >= 0) { return 88; }
    syscall(6, fd);
    # ---- stat#33 / lstat#102 / readlink#70 ----
    var st[48];
    if (syscall(33, hp, zx_len(hp), &st) != 0) { return 66; }
    if ((load64(&st) & 0xF000) != 0x8000) { return 67; }
    if (load64(&st + 16) != 15) { return 68; }
    if (load64(&st + 8) != 2) { return 69; }                 # hello.txt + hello-link.txt
    var sp = "/mnt/zfs/agnostank/sym-short";
    if (syscall(102, sp, zx_len(sp), &st) != 0 || (load64(&st) & 0xF000) != 0xA000) { return 70; }
    if (syscall(33, sp, zx_len(sp), &st) != 0 || load64(&st + 16) != 15) { return 71; }
    var ln = syscall(70, sp, zx_len(sp), &buf, 64);
    if (ln != 9 || zx_eq(&buf, "hello.txt", 9) == 0) { return 72; }
    var miss = "/mnt/zfs/agnostank/no-such-file";
    if (syscall(33, miss, zx_len(miss), &st) == 0) { return 89; }
    # ---- getdents#29 on an AO_DIRECTORY fd: ".", "..", then 3000 names ----
    var dp = "/mnt/zfs/agnostank/dir3000";
    var dfd = zx_open(dp, 0x800);
    if (dfd < 0) { return 73; }
    var total = 0;
    var first = 1;
    var g = syscall(29, dfd, &zx_gd, 4096);
    while (g > 0) {
        var o = 0;
        while (o < g) {
            var rl = load16(&zx_gd + o);
            if (rl < 8) { return 74; }
            if (first == 1) {
                if (load8(&zx_gd + o + 3) != 1 || load8(&zx_gd + o + 8) != 46) { return 75; }   # "." first
                first = 0;
            }
            total = total + 1;
            o = o + rl;
        }
        g = syscall(29, dfd, &zx_gd, 4096);
    }
    syscall(6, dfd);
    if (total != 3002) { return 74; }
    # ---- readdir_at#101: 64 at a time, every f0000..f2999 exactly once, cursor ends at -1 ----
    var seen[384];                                           # 3072 bits
    var k = 0;
    while (k < 384) { store8(&seen + k, 0); k = k + 1; }
    var cur[8];
    store64(&cur, 0);
    var cnt = 0;
    var guard = 0;
    while (load64(&cur) != (0 - 1) && guard < 200) {
        var r = syscall(101, dp, &zx_page, 64, &cur);
        if (r < 0) { return 76; }
        var i = 0;
        while (i < r) {
            var rec = &zx_page + i * 64;
            if (load8(rec) != 102 || load8(rec + 5) != 0 || load8(rec + 63) != 0) { return 90; }   # "fNNNN", a file
            var v = (load8(rec + 1) - 48) * 1000 + (load8(rec + 2) - 48) * 100 + (load8(rec + 3) - 48) * 10 + (load8(rec + 4) - 48);
            if (v < 0 || v >= 3000) { return 90; }
            var bit = 1 << (v & 7);
            if ((load8(&seen + (v >> 3)) & bit) != 0) { return 90; }   # a name listed twice
            store8(&seen + (v >> 3), load8(&seen + (v >> 3)) | bit);
            cnt = cnt + 1;
            i = i + 1;
        }
        guard = guard + 1;
    }
    if (cnt != 3000) { return 76; }
    if (load64(&cur) != (0 - 1)) { return 77; }
    # ---- statfs#103 ----
    var sf[32];
    var rp = "/mnt/zfs/agnostank";
    if (syscall(103, rp, zx_len(rp), &sf) != 0) { return 78; }
    if (load64(&sf) != 4096) { return 79; }                  # ashift=12
    if (load64(&sf + 8) <= 0 || load64(&sf + 16) > load64(&sf + 8) || load64(&sf + 24) > load64(&sf + 16)) { return 80; }
    # ---- every write verb is refused on a READ-ONLY DATASET (agnostank/zpl4: ZPL 4 — the root was until B9) ----
    var np = "/mnt/zfs/agnostank/zpl4/new-file";
    var op4 = "/mnt/zfs/agnostank/zpl4/old.txt";
    if (zx_open(np, 0x100) >= 0) { return 81; }              # AO_CREAT
    if (zx_open(op4, 0x1) >= 0) { return 82; }               # AO_WRONLY
    if (syscall(9, np, zx_len(np)) == 0) { return 83; }      # mkdir
    if (syscall(30, op4, zx_len(op4)) == 0) { return 84; }   # unlink
    if (syscall(31, op4, zx_len(op4), np, zx_len(np)) == 0) { return 85; }   # rename
    # ---- mountlist#104 reports the pool as backend 4 at /mnt/zfs ----
    var ml[640];
    var mn = syscall(104, &ml, 8);
    var saw = 0;
    var j = 0;
    while (j < mn) {
        var mr = &ml + j * 80;
        if (load64(mr) == 4 && load64(mr + 8) == 8 && zx_eq(mr + 16, "/mnt/zfs", 8) == 1) { saw = 1; }
        j = j + 1;
    }
    if (saw == 0) { return 86; }
    # ---- a multi-block file streams to exactly its size (6 MiB through 64 KiB reads) ----
    var bp = "/mnt/zfs/agnostank/big.bin";
    if (syscall(33, bp, zx_len(bp), &st) != 0) { return 87; }
    var want = load64(&st + 16);
    var bfd = zx_open(bp, 0);
    if (bfd < 0) { return 87; }
    var got = 0;
    var rr = syscall(5, bfd, &zx_big, 65536);
