    zx_gen("zfsx/b11e", 524288, &zx_wb, 100);
    if (syscall(58, a11, 524288, 0) != 524288 || syscall(1, a11, &zx_wb, 100) != 100) { return 158; }
    if (syscall(33, cpb, zx_len(cpb), &st) != 0 || load64(&st + 16) != 524388) { return 158; }   # stat sees the extend
    syscall(6, a11);
    syscall(6, b11);
    var s11 = zx_open(cpb, 1);
    zx_gen("zfsx/b11s", 600000, &zx_wb, 50);
    if (s11 < 0 || syscall(58, s11, 600000, 0) != 600000 || syscall(1, s11, &zx_wb, 50) != 50) { return 159; }
    if (syscall(12) != 0) { return 159; }                    # sync#12: the pending write committed
    syscall(6, s11);
    if (syscall(33, cpb, zx_len(cpb), &st) != 0 || load64(&st + 16) != 600050) { return 159; }
    # the interrupt-latency probe (design k.126 (B11)): 2 MiB through one fd, the per-CPU ticks read around its close
    var gb = "/mnt/zfs/somewhere/else/b11big.bin";
    var g11 = zx_open(gb, 0x2102);
    if (g11 < 0) { return 160; }
    k11 = 0;
    while (k11 < 32) {
        zx_gen("zfsx/b11big", k11 * 65536, &zx_big, 65536);
        if (syscall(1, g11, &zx_big, 65536) != 65536) { return 160; }
        k11 = k11 + 1;
    }
    var si0[104];
    var si1[104];
    if (syscall(35, &si0, 104) != 0) { return 160; }
    if (syscall(6, g11) != 0) { return 160; }
    if (syscall(35, &si1, 104) != 0) { return 160; }
    syscall(1, 1, "zfsx: b11 close ticks", 21);
    var c = 0;
    while (c < 4) {
        var dt = load64(&si1 + 40 + c * 16) + load64(&si1 + 48 + c * 16) - load64(&si0 + 40 + c * 16) - load64(&si0 + 48 + c * 16);
        zx_putn(" cpu", c);
        zx_putn("=", dt);
        c = c + 1;
    }
    syscall(1, 1, "\n", 1);
    # ---- 1.57.18: open#7's AO_MODE (a3 0x4000; bits 32..63 = a create's mode) — clauses 162-165 ----
    # 0600 / 0640 / 0755 and 0604 (a mode whose trivial ACL needs zfs_acl_chmod's allow0 + deny2 entries: other may read,
    # the group may not) on agnostank/custom, one txg each; stat#33 reads S_IFREG | the mode. The pool's verify holds
    # each to OpenZFS's own stat(1) and getfacl (B-stat, B-acl) and the SA to zfs-sa-check.py.
    if (zx_mk("/mnt/zfs/somewhere/else/m600.txt", 0x180) != 0) { return 162; }
    if (zx_mk("/mnt/zfs/somewhere/else/m640.txt", 0x1A0) != 0) { return 162; }
    if (zx_mk("/mnt/zfs/somewhere/else/m755.bin", 0x1ED) != 0) { return 162; }
    if (zx_mk("/mnt/zfs/somewhere/else/m604.txt", 0x184) != 0) { return 162; }
    var md = "/mnt/zfs/somewhere/else/mdef.txt";                # no AO_MODE, the field set: ignored — the default 0644
    var mdf = zx_open(md, 0x2101 | (0x180 << 32));
    if (mdf < 0) { return 163; }
    syscall(6, mdf);
    if (syscall(33, md, zx_len(md), &st) != 0 || load64(&st) != 0x81A4) { return 163; }
    var m6 = "/mnt/zfs/somewhere/else/m600.txt";                # an EXISTING file, AO_CREAT | AO_MODE 0777: untouched, no txg
    var mef = zx_open(m6, 0x4101 | (0x1FF << 32));
    if (mef < 0) { return 164; }
    syscall(6, mef);
    if (syscall(33, m6, zx_len(m6), &st) != 0 || load64(&st) != 0x8180) { return 164; }
    var mb = "/mnt/zfs/somewhere/else/mbad.txt";                # a field above 07777: -1 before any backend, nothing made
    if (zx_open(mb, 0x6101 | (0x1000 << 32)) != 0 - 1 || zx_open(mb, 0x6101 | (1 << 63)) != 0 - 1) { return 165; }
    if (syscall(33, mb, zx_len(mb), &st) == 0) { return 165; }
    # ---- 1.57.18: fsync#115 — a CHILD, after this process is gone (clauses 170-175; zx_child) ----
    # Forked HERE, before b11exit.bin opens (the child must not hold its fd); it blocks on the pipe until this process
    # dies — the exit commits b11exit.bin first — then runs its clauses and SLEEPS with one file's writes pending, which
    # the harness's kill (a crash cut) must lose while every fsync#115'd file survives.
    var pp[2];
    if (syscall(25, &pp, 0, 0, 0) != 0) { return 170; }
    var kid = syscall(96, 0, 0, 0, 0);
    if (kid == 0) {
        syscall(6, load64(&pp + 8), 0, 0, 0);
        var one[1];
        while (syscall(5, load64(&pp), &one, 1, 0) > 0) { }          # EOF: the parent is gone
        syscall(41, 1500, 0, 0, 0);                                    # agnsh's `run: exit 95` and prompt go out first
        zx_child();
    }
    if (kid < 0) { return 170; }
    syscall(6, load64(&pp), 0, 0, 0);
    # b11exit.bin: written, never closed — the exit's teardown commits it
    var x11 = zx_open("/mnt/zfs/somewhere/else/b11exit.bin", 0x2102);
    if (x11 < 0) { return 161; }
    zx_gen("zfsx/b11x", 0, &zx_wb, 1000);
    if (syscall(1, x11, &zx_wb, 1000) != 1000) { return 161; }
    return 95;
}

fn main(): i64 { return zx_main(); }
fn _entry(): i64 { var rc = main(); syscall(SYS_EXIT, rc); return 0; }
_entry();
