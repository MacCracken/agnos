# fgc — every CHILD role of agnos 1.57.7's foreground-exec gate (step S3b; docs/architecture/foreground-exec.md).
# Seeded as /bin/fgc by scripts/smoke/fg-smoke.sh. The role is argv[1]; the driver is fgx (/bin/agnsh).
# With NO role it exits 3: the recovery image seeds THIS binary as /bin/agnsh so kybernet falls into its emergency
# shell (`kybernet: emergency shell (exec rc=3)`), where the smoke types `run /bin/fgc <role>` (DEP-4).
# ⚠ BOUNDED EVERYWHERE: kill#16 ends nothing before the lifecycle step, so every role ends on its own clock (#95).

include "fgcommon.cyr"

var fgc_sent[8];        # 64 B: the ewloop stack-sentinel pattern
var fgc_fp[16];         # 128 B: xmm0-15 patterns for fpthrash

# fpthrash's asm: load xmm0..xmm15 from the 128-byte pattern block at `buf`.
# REGISTER CONTRACT: in — buf at [rbp-8] (the first-parameter idiom; this function contains asm, so cyrius does
# not regalloc it). Out — none. Clobbers rax and xmm0-15 (the whole point: every XMM register holds this child's
# pattern when the kernel next switches it out). movq xmmN, [rax+8N]: F3 [REX.R 44 for N >= 8] 0F 7E modrm disp8.
fn fgc_thrash_once(buf) {
    asm {
        0x48; 0x8B; 0x45; 0xF8;                     # mov rax, [rbp-8]
        0xF3; 0x0F; 0x7E; 0x40; 0x00;               # movq xmm0,  [rax+0]
        0xF3; 0x0F; 0x7E; 0x48; 0x08;               # movq xmm1,  [rax+8]
        0xF3; 0x0F; 0x7E; 0x50; 0x10;               # movq xmm2,  [rax+16]
        0xF3; 0x0F; 0x7E; 0x58; 0x18;               # movq xmm3,  [rax+24]
        0xF3; 0x0F; 0x7E; 0x60; 0x20;               # movq xmm4,  [rax+32]
        0xF3; 0x0F; 0x7E; 0x68; 0x28;               # movq xmm5,  [rax+40]
        0xF3; 0x0F; 0x7E; 0x70; 0x30;               # movq xmm6,  [rax+48]
        0xF3; 0x0F; 0x7E; 0x78; 0x38;               # movq xmm7,  [rax+56]
        0xF3; 0x44; 0x0F; 0x7E; 0x40; 0x40;         # movq xmm8,  [rax+64]
        0xF3; 0x44; 0x0F; 0x7E; 0x48; 0x48;         # movq xmm9,  [rax+72]
        0xF3; 0x44; 0x0F; 0x7E; 0x50; 0x50;         # movq xmm10, [rax+80]
        0xF3; 0x44; 0x0F; 0x7E; 0x58; 0x58;         # movq xmm11, [rax+88]
        0xF3; 0x44; 0x0F; 0x7E; 0x60; 0x60;         # movq xmm12, [rax+96]
        0xF3; 0x44; 0x0F; 0x7E; 0x68; 0x68;         # movq xmm13, [rax+104]
        0xF3; 0x44; 0x0F; 0x7E; 0x70; 0x70;         # movq xmm14, [rax+112]
        0xF3; 0x44; 0x0F; 0x7E; 0x78; 0x78;         # movq xmm15, [rax+120]
    }
    return 0;
}
fn role_fpthrash() {
    var t_end = fg_us() + 100000;
    var k = 1;
    while (fg_us() < t_end) {
        var j = 0;
        while (j < 16) { store64(&fgc_fp + j * 8, 0x5A5A000000000000 + k * 16 + j); j = j + 1; }
        fgc_thrash_once(&fgc_fp);
        k = k + 1;
    }
    return 0;
}

# tickself MS: burn MS ms, then read this process's own #99 tick count. A scheduled IF=1 child accrues ticks; an
# out-of-band IF=0 child (the pre-S3b #37 / kmain `run`) takes no timer interrupt and reads 0.
fn role_tickself(ms) {
    var t0 = fg_us();
    if (t0 == (0 - 1)) { return 2; }
    fg_burnto(t0 + ms * 1000);
    var t = fg_ticks(fg_getpid());
    fg_out("FG-TICKSELF ticks="); fg_num(t); fg_out("\n");
    if (t >= 5) { return 0; }
    return 1;
}
# spawnwait: #43 `fgc exit 5`, then poll waitpid#4 (non-blocking) + sched_yield#44 for <= 3 s — the agnoshi pattern.
# The grandchild's code, or 99 when it never ran (a #37 child that cannot yield holds its CPU).
fn role_spawnwait() {
    var p = fg_spawn("exit", 5, 0 - 1);
    if (p < 0) { return 98; }
    var t0 = fg_us();
    while (fg_us() - t0 < 3000000) {
        var r = fg_poll(p);
        if (r != (0 - 2)) { return r; }
        fg_yield();
    }
    return 99;
}
# nest N: N == 0 -> 40; else r = #37 `fgc nest N-1`; r < 0 -> 99, else r + 1.
fn role_nest(n) {
    if (n <= 0) { return 40; }
    var r = fg_ew("nest", n - 1, 0 - 1);
    if (r < 0) { return 99; }
    return r + 1;
}
fn role_hello() {
    var m = "FG-HELLO-FROM-CHILD\n";
    syscall(1, 1, m, strlen(m), 0);                     # ONE write: one line, never split by another writer
    return 0;
}
fn role_env(key) {
    var base = _agnos_argv_base();
    if (base == 0) { return 60; }
    var ac = load64(base);
    var kl = strlen(key);
    var j = 0;
    while (j < 64) {
        var ep = load64(base + 8 + (ac + 1 + j) * 8);
        if (ep == 0) { return 60; }
        var m = 1;
        var ci = 0;
        while (ci < kl) {
            if (load8(ep + ci) != load8(key + ci)) { m = 0; break; }
            ci = ci + 1;
        }
        if (m == 1) {
            if (load8(ep + kl) == 61) {
                if (fg_eq(ep + kl + 1, "fgv") == 1) { return 61; }
                return 60;
            }
        }
        j = j + 1;
    }
    return 60;
}
# ewloop N: N x #37 `fgc exit 1` from this (scheduled, unpinned) process. Before and after each: the address of a
# local and 8 stack sentinels must be unchanged, and #37 must return 1. 0 = all intact, 90 + i = the first mismatch.
fn role_ewloop(n) {
    var sent[64];                                       # 8 u64 sentinels ON THIS STACK (function-local: 64 BYTES)
    var i = 0;
    while (i < n) {
        var a0 = &sent;
        var s = 0;
        while (s < 8) { store64(&sent + s * 8, 0x6E770000 + i * 256 + s); s = s + 1; }
        var r = fg_ew("exit", 1, 0 - 1);
        if (&sent != a0) { return 90 + i; }
        s = 0;
        while (s < 8) {
            if (load64(&sent + s * 8) != 0x6E770000 + i * 256 + s) { return 90 + i; }
            s = s + 1;
        }
        if (r != 1) { return 90 + i; }
        i = i + 1;
    }
    return 0;
}
# churn MS: until MS ms by #95: #43 `fgc exit 1`, then WAIT_BLOCK-reap it; -2 (table full) -> 5 ms back-off.
fn role_churn(ms) {
    var t_end = fg_us() + ms * 1000;
    while (fg_us() < t_end) {
        var p = fg_spawn("exit", 1, 0 - 1);
        if (p < 0) { fg_sleep(5); }
        else { fg_wait(p); }
    }
    return 0;
}
# hub: #43 x 3 `fgc churn 800` (each retried <= 1 s on -2), then WAIT_BLOCK-reap all three.
fn role_hub() {
    var c0 = fg_spawn_retry("churn", 800, 0 - 1, 1000);
    var c1 = fg_spawn_retry("churn", 800, 0 - 1, 1000);
    var c2 = fg_spawn_retry("churn", 800, 0 - 1, 1000);
    if (c0 >= 0) { fg_wait(c0); }
    if (c1 >= 0) { fg_wait(c1); }
    if (c2 >= 0) { fg_wait(c2); }
    return 0;
}
# storm: #43 `fgc hub` (retried <= 1 s on -2), then exit at once — the hub is the ONE orphan per storm.
fn role_storm() {
    fg_spawn_retry("hub", 0 - 1, 0 - 1, 1000);
    return 11;
}
# writeloop MS: write "ow\n" (ONE write — the smoke deletes whole `ow\n` lines), spin ~1 ms, until MS.
fn role_writeloop(ms) {
    var t_end = fg_us() + ms * 1000;
    var m = "ow\n";
    while (fg_us() < t_end) {
        syscall(1, 1, m, 3, 0);
        fg_burnto(fg_us() + 1000);
    }
    return 0;
}
fn role_memfree() {
    var f = fg_sysinfo(16);
    fg_out("FG-MEMFREE "); fg_num(f); fg_out("\n");
    return 0;
}

fn fgc_role(role) {
    if (fg_eq(role, "exit") == 1) { return fg_atoi(argv(2)); }
    if (fg_eq(role, "burnms") == 1) { fg_burnto(fg_us() + fg_atoi(argv(2)) * 1000); return 0; }
    if (fg_eq(role, "spin") == 1) { fg_burnto(fg_us() + fg_atoi(argv(2)) * 1000); return 0; }
    if (fg_eq(role, "loop") == 1) { fg_spinloop(fg_atoi(argv(2))); return 0; }
    if (fg_eq(role, "tickself") == 1) { return role_tickself(fg_atoi(argv(2))); }
    if (fg_eq(role, "spawnwait") == 1) { return role_spawnwait(); }
    if (fg_eq(role, "nest") == 1) { return role_nest(fg_atoi(argv(2))); }
    if (fg_eq(role, "fault") == 1) { return load64(0); }
    if (fg_eq(role, "hello") == 1) { return role_hello(); }
    if (fg_eq(role, "env") == 1) { return role_env(argv(2)); }
    if (fg_eq(role, "fpthrash") == 1) { return role_fpthrash(); }
    if (fg_eq(role, "ewloop") == 1) { return role_ewloop(fg_atoi(argv(2))); }
    if (fg_eq(role, "churn") == 1) { return role_churn(fg_atoi(argv(2))); }
    if (fg_eq(role, "hub") == 1) { return role_hub(); }
    if (fg_eq(role, "storm") == 1) { return role_storm(); }
    if (fg_eq(role, "writeloop") == 1) { return role_writeloop(fg_atoi(argv(2))); }
    if (fg_eq(role, "orphanwrite") == 1) { fg_spawn("writeloop", 5000, 0 - 1); return 0; }
    if (fg_eq(role, "memfree") == 1) { return role_memfree(); }
    fg_out("FG-CHILD-UNKNOWN-ROLE\n");
    return 97;
}

fn main(): i64 {
    if (argc() < 2) { return 3; }                      # no role: the recovery image's /bin/agnsh (DEP-4)
    return fgc_role(argv(1));
}

fn _entry(): i64 { args_init(); var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
