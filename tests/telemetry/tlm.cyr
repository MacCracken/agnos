# tlm — agnos ring-3 exerciser for the 1.56.59 telemetry counters (chakshu filing §1/§2/§3/§4).
#
# ⛔ THE ORACLE IS "IT MOVED", NOT "IT IS READABLE". Every counter here would read 0 on a kernel that
# declared the variable and never incremented it, and 0 is a plausible-looking answer — so a test that
# merely called the syscalls and checked for a non-negative return would pass on exactly the defect
# worth catching. Each assertion below therefore SAMPLES, GENERATES LOAD, SAMPLES AGAIN, and requires
# the counter to have INCREASED. That is also the property a monitor actually depends on: it
# differences two samples to draw a rate, and a frozen counter renders as a flat line, not an error.
#
# ⚠ MONOTONICITY IS ASSERTED SEPARATELY FROM MOVEMENT. A counter that is reset between samples reads
# as a NEGATIVE delta and produces a nonsense rate — the exact defect that makes nvme_io_submit_count
# unusable (bench.cyr zeroes it). "Never decreases" is a different claim from "increases".
#
# Exit 95 iff every counter is live and monotonic; 70-97 pinpoint which one is not.

fn tlm_main(): i64 {
    # ---- §4: per-process CPU time, surfaced in proclist(#99) record +56 low u32 ----
    # ⚠ THIS PROCESS IS THE ONE BEING MEASURED, so the load is just running: the 100 Hz timer charges
    # whoever is current. A busy loop is the load; no syscall is needed to generate it.
    var buf[1024];                              # 16 records * 64 B
    var n = syscall(99, &buf, 16);
    if (n < 1) { return 80; }
    var me = syscall(2);                        # getpid
    var t0 = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { t0 = load64(&buf + i * 64 + 56) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (t0 < 0) { return 81; }                  # our own pid is absent from the process table

    # Burn enough wall time that at least a few 100 Hz ticks land on us.
    var spin = 0;
    while (spin < 40000000) { spin = spin + 1; }

    n = syscall(99, &buf, 16);
    var t1 = 0 - 1;
    i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { t1 = load64(&buf + i * 64 + 56) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (t1 < 0) { return 82; }
    if (t1 < t0) { return 83; }                 # went BACKWARDS — reset somewhere, unusable as a rate
    if (t1 == t0) { return 84; }                # never moved — the counter is declared but dead

    # ---- §4b: HALTED TIME IS NOT CPU TIME ----
    # ⛔ §4 ABOVE CANNOT CATCH THIS AND SHIPPED WITHOUT IT. Its load is a BUSY LOOP, so it proves the
    # counter advances for a process that is genuinely running — and a counter that advances at
    # WALL-CLOCK rate for a process doing nothing passes it identically. That is exactly what shipped
    # in 1.56.59: sleep_ms#41 halts with the caller still current (preempt_disable, so
    # do_context_switch early-returns), the timer ISR charged the tick anyway, and chakshu v0.9.9
    # rendered a SLEEPING process at 100% CPU. They built the column, measured it, and backed it out.
    # ⇒ The oracle for "this is CPU time, not wall time" is to BLOCK and assert the counter does NOT
    # move. Without this assertion the 1.56.60 halt-exclusion fix has no gate and can rot silently.
    # ⚠ SLOP IS DELIBERATE, NOT LAZINESS. cpu_in_halt is set just BEFORE the `hlt` and cleared just
    # AFTER it (arch/x86_64/io.cyr), so a tick landing in either window is charged — at most one per
    # wait, plus the wake tick itself. 300 ms is ~30 ticks of wall time; a threshold of 5 fails hard
    # on the old wall-clock behaviour (~30) while tolerating that bounded window.
    var s0 = 0 - 1;
    n = syscall(99, &buf, 16);
    i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { s0 = load64(&buf + i * 64 + 56) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (s0 < 0) { return 64; }
    syscall(41, 300);                           # sleep_ms — block ~30 ticks in a halt
    var s1 = 0 - 1;
    n = syscall(99, &buf, 16);
    i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { s1 = load64(&buf + i * 64 + 56) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (s1 < 0) { return 65; }
    if (s1 < s0) { return 66; }                 # went backwards across a sleep
    if ((s1 - s0) > 5) { return 74; }           # ⛔ HALTED TIME IS BEING CHARGED AS CPU TIME

    # ---- §4c: A SLEEP MUST NOT WEDGE THE COUNTER ----
    # ⛔ THE HALT-EXCLUSION FIX HAS ITS OWN FAILURE MODE AND THIS IS THE ORACLE FOR IT. If the
    # per-CPU `cpu_in_halt` flag is set before the `hlt` but never cleared, EVERY later tick on that
    # core is suppressed and the counter is dead for the rest of the boot. That is not hypothetical:
    # it is what the first 1.56.60 implementation did, because the timer ISR calls do_context_switch
    # and a tick that wakes a halt can switch to a different process, so arch_wait's post-hlt clear
    # never runs. The ISR therefore CONSUMES the flag. Assert the consequence: after blocking, a
    # busy loop must still accrue ticks.
    var w0 = s1;
    var spin3 = 0;
    while (spin3 < 40000000) { spin3 = spin3 + 1; }
    var w1 = 0 - 1;
    n = syscall(99, &buf, 16);
    i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { w1 = load64(&buf + i * 64 + 56) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (w1 < 0) { return 67; }
    if (w1 == w0) { return 68; }                # ⛔ THE SLEEP WEDGED THE COUNTER — flag never cleared
    # ⚠ THIS ARM IS NOT MUTATION-PROVEN AND MUST NOT BE READ AS COVERAGE FOR THE WEDGE.
    # Measured 2026-09-03: reverting the ISR to READ the flag without consuming it still exits 95
    # here. The wedge needs a context switch to happen OUT of a halt, and this harness runs
    # essentially one ring-3 process, so do_context_switch has nobody to switch to. The hazard is
    # real — it was observed once, as exit 84, on a boot where the switch did occur — but this
    # assertion catches it only opportunistically. Stated plainly for the same reason the §8 note
    # above states which of its exits cannot fire: an assertion that does not bite must never be
    # mistaken for one that does. Making it deterministic needs a second runnable process.

    # ---- §5: per-process RSS, proclist(#99) record +56 HIGH u32, in 4 KiB pages ----
    # ⚠ SAMPLED FROM THE SAME RECORDS AS §4 — the high half of the slot whose low half was just proven
    # live. Reading the whole u64 and shifting is what a real consumer does, so a kernel that wrote the
    # two halves with separate stores and let them tear would be caught here.
    var rs = 0 - 1;
    i = 0;
    while (i < n) {
        if (load64(&buf + i * 64) == me) { rs = (load64(&buf + i * 64 + 56) >> 32) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (rs < 0) { return 93; }
    # ⛔ A RUNNING RING-3 PROCESS HAS RESIDENT MEMORY BY CONSTRUCTION — it is executing out of it. 0 is
    # the answer a dead counter gives and the ONE value that cannot be true here, which is what makes
    # this bite rather than decorate. Measured on a real boot: this process reports 3 user PDEs.
    if (rs == 0) { return 94; }
    # agnos maps user memory in 2 MB pages, so RSS moves in units of 512 x 4 KiB. A non-multiple means
    # the accounting unit and the mapping granularity have drifted apart.
    if ((rs % 512) != 0) { return 96; }
    # ⛔ CEILING — THE ASSERTION THAT CATCHES THE WRONG WALK. `proc_create_address_space` fills PD[0..7]
    # kernel-identity and PD[8..63] identity-SUPERVISOR, so a walk that dropped the US test would count
    # ~129 entries and report ~258 MB for this ~22 KB binary. 32768 pages = 128 MB is comfortably above
    # a real process and far below that failure.
    if (rs > 32768) { return 97; }


    # ---- §8: per-core CPU accounting, sysinfo(#35) EXTENSION at +40 ----
    # ⛔ THE FIRST ASSERTION IS BACKWARD COMPATIBILITY, and it comes first on purpose. This capability
    # was first built as a new syscall #106 and moved onto sysinfo's tail instead, because #35 already
    # takes a caller length and a new number costs a cyrius release. The one thing that move must not
    # break is a caller passing the OLD length: it has to get the same 40 bytes and the same success.
    # ⚠ WHAT THESE ASSERTIONS DO AND DO NOT COVER, measured rather than assumed. Exit 63 (writing past
    # +40 for a small caller) BITES — mutation-proven: relaxing the guard to `arg2 >= 40` reddens it.
    # Exit 60 (a small caller getting a spurious -1 from an over-wide is_user_range) does NOT bite from
    # ring 3: a 40-byte stack buffer still has 104 valid bytes after it, so the wider range validates
    # anyway. Catching that needs a buffer at the very end of the user window, which this exerciser
    # cannot place. Stated because an assertion that cannot fail should never be mistaken for coverage.
    var si40[40];
    var si_k = 0;
    while (si_k < 40) { store8(&si40 + si_k, 0xEE); si_k = si_k + 1; }
    if (syscall(35, &si40, 40) != 0) { return 60; }        # old-length call must still succeed
    if (load64(&si40 + 32) < 1) { return 61; }             # cpu_count — the old tail must be written
    # A length between the old and new minimum must ALSO still work and write only the old 40.
    var si104[104];
    si_k = 0;
    while (si_k < 104) { store8(&si104 + si_k, 0xEE); si_k = si_k + 1; }
    if (syscall(35, &si104, 64) != 0) { return 62; }
    if (load8(&si104 + 40) != 0xEE) { return 63; }         # +40 untouched below the new minimum

    # Now the extension itself.
    si_k = 0;
    while (si_k < 104) { store8(&si104 + si_k, 0); si_k = si_k + 1; }
    if (syscall(35, &si104, 104) != 0) { return 70; }
    var u0 = load64(&si104 + 40 + 0 * 16 + 0);             # cpu0 user
    var k0 = load64(&si104 + 40 + 0 * 16 + 8);             # cpu0 kernel
    var spin2 = 0;
    while (spin2 < 40000000) { spin2 = spin2 + 1; }
    if (syscall(35, &si104, 104) != 0) { return 70; }
    var u1 = load64(&si104 + 40 + 0 * 16 + 0);
    var k1 = load64(&si104 + 40 + 0 * 16 + 8);
    if (u1 < u0) { return 71; }                            # user ticks went backwards
    if (k1 < k0) { return 72; }                            # kernel ticks went backwards
    # ⛔ THE ASSERTION THAT CATCHES A WRONG RING TEST. We just burned wall time in RING 3, so the USER
    # counter must have moved. A test asserting only (user+kernel) grew would pass on a kernel that
    # charged everything to kernel — a wrong RPL mask — with totals still looking plausible.
    if (u1 == u0) { return 73; }

    # ---- §1 + §2: network packet and byte counters, net_config(#61) fields 8-11 ----
    # ⚠ READ ALL FOUR FIRST. Reading one, generating load, then reading another would compare two
    # different quantities and could pass on a kernel where only one of them is wired.
    var txp0 = syscall(61, 8);
    var rxp0 = syscall(61, 9);
    var txb0 = syscall(61, 10);
    var rxb0 = syscall(61, 11);
    if (txp0 < 0) { return 85; }                # field not implemented at all
    if (rxp0 < 0) { return 85; }
    if (txb0 < 0) { return 85; }
    if (rxb0 < 0) { return 85; }

    # Generate real wire traffic. ⚠ `icmp_echo`#55 takes ONE argument (its arity is frozen — the ABI
    # says so) and BLOCKS ~3 s, so one call is enough and two would just cost six seconds. The gateway
    # is the target: under the harness's SLIRP it always answers, and on iron it is the one address
    # guaranteed reachable. ⛔ The RETURN is deliberately ignored — a timeout still TRANSMITTED, which
    # is what the tx counters are being asked about. Asserting a reply would make this gate fail on a
    # substrate with no network rather than on a broken counter.
    syscall(55, syscall(61, 2));                # icmp_echo(gateway) — field 2 is net_gateway
    var txp1 = syscall(61, 8);
    var txb1 = syscall(61, 10);
    if (txp1 < txp0) { return 86; }             # tx packets went backwards
    if (txb1 < txb0) { return 87; }             # tx bytes went backwards
    if (txp1 == txp0) { return 88; }            # nothing counted — the counter is dead
    # ⛔ BYTES MUST OUTPACE PACKETS. A byte counter accidentally wired to the packet increment would
    # satisfy every check above; requiring the byte delta to exceed the packet delta catches it,
    # because no real frame is one byte long.
    if ((txb1 - txb0) <= (txp1 - txp0)) { return 89; }

    # ---- §3: per-device disk sectors, sysinfo(#35) EXTENSION at +104 ----
    # ⛔ THIS WAS `blkstats`#105 AND THE NUMBER WAS WITHDRAWN. Same reason the per-core band above is
    # not `cpustat`#106: sysinfo already takes a length, and a closed 5-value tag enum over flat by-tag
    # arrays is exactly a fixed-size tail block. Reading it here through the SAME call proves the two
    # bands coexist and that the length tiering (40 / 104 / 200) actually gates them independently.
    var si200[200];
    var sj = 0;
    while (sj < 200) { store8(&si200 + sj, 0xEE); sj = sj + 1; }
    # A 104-length caller must get the per-core band and NOT the disk band.
    if (syscall(35, &si200, 104) != 0) { return 75; }
    if (load8(&si200 + 104) != 0xEE) { return 76; }     # +104 untouched below the new minimum
    sj = 0;
    while (sj < 200) { store8(&si200 + sj, 0); sj = sj + 1; }
    if (syscall(35, &si200, 200) != 0) { return 77; }
    # ⚠ TAG IS PROBED, NOT ASSUMED — which backend is live depends on the substrate (nvme under this
    # harness, ahci or usb-ms elsewhere). Slot 0 is BLK_NONE and must always read 0.
    if (load64(&si200 + 104 + 0 * 16 + 0) != 0) { return 78; }   # slot 0 is reserved, must stay 0
    var tag = 1;
    var found = 0 - 1;
    while (tag <= 5) {
        if (load64(&si200 + 104 + tag * 16 + 0) > 0) { found = tag; tag = 6; }
        if (tag < 6) { tag = tag + 1; }
    }
    if (found < 0) { return 90; }                       # no device reports ANY sector read

    # ---- §3b: THE BAND MUST MOVE UNDER REAL I/O ----
    # ⛔ THE STATIC CHECK ABOVE IS NOT AN ORACLE FOR THIS BAND, and shipping it as one cost a
    # consumer a whole panel. "Some tag > 0" is satisfied by the BOOT PROBE alone, so it passed over
    # a kernel whose counters were frozen from boot: the only increment sites were blk_read_on /
    # blk_write_on (the SINGLE-sector calls), and every multi-sector path bypassed them — including
    # ext2_read_block, which is how all filesystem I/O actually reaches the disk. chakshu v0.9.9 read
    # this band, saw 0 B/s through a heavy copy, and is keeping `disk: n/a` because of it.
    # ⇒ Use the SAME two-sample "the counter MOVED" oracle §4, §8 and §1/§2 already use. Their own
    # filing named this as the right oracle and this band was the one place it was not applied.
    #
    # ⚠ THE LOAD MUST BE A REAL DISK READ, not a syscall that merely touches the block layer. open#7
    # is mount-routed to ext2 (1.41.3) and there is NO block cache between ext2_read_block and the
    # backend, so reading a file is guaranteed device traffic. /bin/tlm is this binary itself —
    # the harness copies it into the seeded rootfs, so it is present by construction rather than by
    # assumption about image contents.
    # ⛔ A MAGNITUDE THRESHOLD, NOT "IT MOVED" — AND THAT DISTINCTION IS THE WHOLE GATE.
    # MEASURED 2026-09-03: a "delta > 0" version of this arm PASSED with the multi-sector counting
    # deliberately removed. Opening a file also performs SINGLE-sector reads (ext2_blk_read ->
    # blk_read_on, e.g. the superblock and inode table), and those were counted all along — so the
    # counter moves a little whether or not the path this arm exists to cover is wired. The
    # discriminator has to be the SIZE of the delta: 12 passes over this ~22 KB binary is ~260 KB of
    # file data, which can only be ~500+ sectors if ext2_read_block's multi-sector path is counting.
    # A few dozen single-sector metadata reads cannot reach 256.
    var r0 = load64(&si200 + 104 + found * 16 + 0);
    var rdbuf[2048];
    var pass = 0;
    var gotany = 0;
    while (pass < 12) {
        var fd = syscall(7, "/bin/tlm", 8, 0);
        if (fd < 0) { return 79; }                      # could not open our own binary
        var got = 1;
        while (got > 0) {
            got = syscall(5, fd, &rdbuf, 2048);
            if (got > 0) { gotany = gotany + got; }
        }
        syscall(6, fd);
        pass = pass + 1;
    }
    if (gotany < 65536) { return 91; }                  # far less data than expected — load never ran
    sj = 0;
    while (sj < 200) { store8(&si200 + sj, 0); sj = sj + 1; }
    if (syscall(35, &si200, 200) != 0) { return 92; }
    var r1 = load64(&si200 + 104 + found * 16 + 0);
    if (r1 < r0) { return 98; }                         # went BACKWARDS — unusable as a rate
    if ((r1 - r0) < 256) { return 99; }                 # ⛔ THE ASSERTION THAT WOULD HAVE CAUGHT IT

    return 95;
}

fn main(): i64 { return tlm_main(); }
fn _entry(): i64 { var rc = main(); syscall(SYS_EXIT, rc); return 0; }
_entry();
