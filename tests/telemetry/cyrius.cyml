[package]
name = "tlm"
version = "0.1.0"
description = "agnos ring-3 exerciser for the 1.56.59 telemetry counters — proves per-process CPU ticks (#99 +56), network packet/byte counters (#61 fields 8-11) and per-device disk sectors (#105) are LIVE and MONOTONIC, not merely present; exits 95 iff every counter moved under load."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
src = "tlm.cyr"
output = "build/tlm"

# ⚠ #105 IS ISSUED BY RAW NUMBER ON PURPOSE, and it has no wrapper yet — the cyrius peer is filed at
# cyrius/docs/development/issues/2026-09-02-agnos-syscall-105-blkstats-wrapper.md. Even once it lands
# this stays raw, the same rule tests/readdir/rdat.cyr records: this is the ABI exerciser, and routing
# it through the stdlib wrapper would test the wrapper's agreement with itself, not the kernel arm.
[deps]
# ⚠ 1.57.14 (cyrius 6.6.20): `syscalls` alone is NOT a closed set — it names `alloc` (since 6.6.6; CX-only under
# `#ifdef CYRIUS_TARGET_CX` through 6.6.8, unconditional since 6.6.9), which names `atomic` + `fnptr` and, since
# 6.6.18, `poison` (under `#ifdef CYRIUS_POISON`, never compiled here). `cyrius deps` walks includes textually, so
# it resolved alloc/atomic/fnptr at the 6.6.6 pin too: this manifest was short BEFORE the move, which uncovered it.
# `cyrius lib sync` copies only what is DECLARED, so the transitives are declared (the 1.57.2 tests/chan
# precedent); `cyrius deps` vendoring 15 files where lib sync vendored 7 is how the 1.57.14 move measured it.
stdlib = ["syscalls", "alloc", "atomic", "fnptr", "poison"]
