# refraster.cyr — THE CPU reference rasteriser. ONE implementation, included by every tool
# that claims agreement with it. 3D arc, rung 9b bite B0.
#
# ============================================================================================
# WHY THIS FILE EXISTS — "byte-identical to the CPU reference" had THREE referents
# ============================================================================================
# Before this extraction the same rasteriser was hand-transcribed into `cpuref.cyr`,
# `refagree.cyr` and `tileown.cyr`, each with its own array bounds and width constants. That is
# the ATOM_DRY defect class one level up: three artifacts differing in name but *supposed* to
# not differ in behaviour, with nothing enforcing it. ⛔ Cyrius shadows duplicate `fn`s
# silently and warn-only ([[reference_cyrius_duplicate_fn_shadow]]), so a divergence between
# them would not even produce an error — the last definition would quietly win.
#
# Rung 9b's whole oracle is a byte-diff against "the reference". That phrase needs exactly one
# referent, and this file is it.
#
# ⛔ INCLUDE-ONLY. No `main`, no `_entry`. `cpuref.cyr` is a *program*; including it would give
# duplicate `main`/`_entry` and — per the shadowing rule above — the wrong one would run.
#
# ============================================================================================
# ⭐ THE `accrow` OVERFLOW — a latent fatal IN THE ORACLE, fixed here
# ============================================================================================
# The original declared `var accrow[64]` at module scope. Module-scope `var X[N]` allocates
# N x u64 ([[cyrius-var-array-u64-units]]), so that is 64 slots — and `span_add` indexes it by
# pixel x up to `W`. At the shipped W=64 that lands exactly on the last slot and is correct, so
# the bug has never fired. At ANY W > 64 it writes past the end into `crx`/`crd`, which are
# declared on the very next line.
#
# ⚠ Read what that would have meant: the corruption is in the REFERENCE, not in the shader. It
# would present as the GPU disagreeing with the CPU on wide masks — a plausible wrong triangle —
# and the entire investigation would have been pointed at the shader. Rung 9b's corpus requires
# a 200x64 case and a 128-wide case, so this stops being latent the moment that corpus lands.
#
# The fix is a declared `MAXW` and a RUN-TIME refusal, not a comment saying "keep W <= 64". A
# comment is not a check, and this is the file every later rung cites.

# ---- sadish's fixed-point constants, reproduced exactly -----------------------------------
var R_SHIFT = 16;
var R_ONE   = 65536;
var R_SS    = 4;              # SD_FILL_SS

fn r_fixed_mul(a, b): i64 { return (a * b) >> R_SHIFT; }

# ---- geometry buffers ---------------------------------------------------------------------
# W/H are RUN-TIME settable via rr_set_dims(); the arrays are sized by the compile-time
# maxima below and the setter refuses anything that would not fit.
var RR_MAXW = 512;            # accrow slots — the widest mask any corpus case may use
var RR_MAXH = 512;
var RR_MAXX = 512;            # crossing list: 2 per edge worst case, but MAXE bounds it

var W = 64;
var H = 64;
# ⚠ 256, raised from 64 at the EDGE_CAP probe bite. The corpus needs only 64 (case 20's 64-gon),
# but `gputri --bench`'s edge sweep must reach the points ABOVE the shipped cap to measure the
# per-edge cost the cap is supposed to move on. ⛔ This is the ORACLE's capacity, not the ABI's:
# GPU_EDGE_CAP still ships at 64 and the kernel still rejects more. Raising it here changes no
# corpus geometry — verified by the 20 digests being byte-identical across the change.
var MAXE = 256;
var ex0[256]; var ey0[256]; var ex1[256]; var ey1[256];
var n_edges = 0;
# ⚠ 512 slots, NOT 64. See the header. `span_add` indexes this by pixel x up to W.
var accrow[512];
var crx[512]; var crd[512];
var rr_dim_fault = 0;         # 1 = a dimension was refused; every consumer must check it

# rr_set_dims(w, h) -> 1 ok / 0 REFUSED. A refusal is loud and sticky: rr_dim_fault latches so
# a caller that ignores the return value still cannot report a green result.
#
# ⛔ REFUSES rather than clamps. A clamped dimension would silently rasterise a different shape
# than the caller asked for, and the diff against the GPU would then be attributed to the GPU.
fn rr_set_dims(w, h): i64 {
    if (w < 1) { rr_dim_fault = 1; return 0; }
    if (h < 1) { rr_dim_fault = 1; return 0; }
    if (w > RR_MAXW) { rr_dim_fault = 1; return 0; }
    if (h > RR_MAXH) { rr_dim_fault = 1; return 0; }
    W = w;
    H = h;
    return 1;
}

fn edges_reset(): i64 { n_edges = 0; return 0; }
fn edge_add(x0, y0, x1, y1): i64 {
    # ⛔⛔ HORIZONTAL EDGES ARE **KEPT**, and the first iron burn is why.
    #
    # This used to drop `y0 == y1` at ingest. That is harmless for `raster()` — the half-open
    # test below can never satisfy both `sy >= ylo` and `sy < yhi` when ylo == yhi, so a
    # horizontal edge contributes no crossing either way and the reference output is
    # BYTE-IDENTICAL with or without the drop (verified: all 20 digests unchanged).
    #
    # ⚠ But these arrays are ALSO the "one source of truth" the ring-3 tool submits to `#92`,
    # and the ABI requires `n_edges >= 3`. Dropping the horizontal edge left a flat-topped
    # triangle holding only TWO, so the kernel correctly rejected it with GPO_E_EDGEBUF — on
    # exactly the five corpus cases that contain one (4, 7, 8, 11, 18), which is precisely the
    # set B1 identified and then failed to act on.
    #
    # ⭐ Keeping them is also the more faithful model: the SHADER receives every submitted edge
    # including the horizontals and filters them with its own half-open guard. Filtering at
    # ingest meant the CPU and the GPU were not being given the same geometry.
    if (n_edges >= MAXE) { return 0; }
    store64(&ex0 + n_edges * 8, x0); store64(&ey0 + n_edges * 8, y0);
    store64(&ex1 + n_edges * 8, x1); store64(&ey1 + n_edges * 8, y1);
    n_edges = n_edges + 1;
    return 0;
}

fn tri_add(ax, ay, bx, by, cx, cy): i64 {
    edge_add(ax, ay, bx, by);
    edge_add(bx, by, cx, cy);
    edge_add(cx, cy, ax, ay);
    return 0;
}

fn fx(v): i64 { return v << R_SHIFT; }

# ---- the analytic-x span accumulator — sadish's sd_span_add ---------------------------------
fn span_add(xs, xe, weight): i64 {
    if (xe <= xs) { return 0; }
    var lo = xs; if (lo < 0) { lo = 0; }
    var wmax = W << R_SHIFT;
    var hi = xe; if (hi > wmax) { hi = wmax; }
    if (hi <= lo) { return 0; }
    var px = lo >> R_SHIFT;
    var stop = 0;
    while (stop == 0) {
        if (px >= W) { stop = 1; }
        if (px < W) {
            var pl = px << R_SHIFT;
            if (pl >= hi) { stop = 1; }
            if (pl < hi) {
                var pr = (px + 1) << R_SHIFT;
                var a = lo; if (a < pl) { a = pl; }
                var b = hi; if (b > pr) { b = pr; }
                if (b > a) {
                    var add = r_fixed_mul(weight, b - a);
                    store64(&accrow + px * 8, load64(&accrow + px * 8) + add);
                }
                px = px + 1;
            }
        }
    }
    return 0;
}

# ---- the reference rasteriser — sadish's sd_fill_impl, nonzero rule -------------------------
fn raster(cov): i64 {
    var weight = R_ONE / R_SS;
    var py = 0;
    while (py < H) {
        var zi = 0;
        while (zi < W) { store64(&accrow + zi * 8, 0); zi = zi + 1; }
        var s = 0;
        while (s < R_SS) {
            # ⚠ EXACT sub-scanline placement. A different rounding here shifts every edge by a
            # fraction of a pixel and shows up as a uniform ±1 coverage difference — which is
            # exactly the degradation the plan warns must be REPORTED, not absorbed.
            var sy = (py << R_SHIFT) + (s * R_ONE + (R_ONE >> 1)) / R_SS;
            var nc = 0;
            var ei = 0;
            while (ei < n_edges) {
                var ay = load64(&ey0 + ei * 8);
                var by = load64(&ey1 + ei * 8);
                var ylo = ay; var yhi = by; var dir = 1;
                if (ay > by) { ylo = by; yhi = ay; dir = 0 - 1; }
                # ⛔ THE HALF-OPEN RULE. See the header: this single pair of comparisons is what
                # makes a shared edge belong to exactly one triangle.
                if (sy >= ylo) {
                    if (sy < yhi) {
                        var ax = load64(&ex0 + ei * 8);
                        var bx = load64(&ex1 + ei * 8);
                        var xx = ax + ((bx - ax) * (sy - ay)) / (by - ay);
                        store64(&crx + nc * 8, xx);
                        store64(&crd + nc * 8, dir);
                        nc = nc + 1;
                    }
                }
                ei = ei + 1;
            }
            # insertion sort by x — sadish's, same algorithm so ties order identically
            var a = 1;
            while (a < nc) {
                var kx = load64(&crx + a * 8);
                var kd = load64(&crd + a * 8);
                var b = a - 1;
                var stop = 0;
                while (stop == 0) {
                    if (b < 0) { stop = 1; }
                    if (b >= 0) {
                        if (load64(&crx + b * 8) > kx) {
                            store64(&crx + (b + 1) * 8, load64(&crx + b * 8));
                            store64(&crd + (b + 1) * 8, load64(&crd + b * 8));
                            b = b - 1;
                        }
                        if (load64(&crx + b * 8) <= kx) { stop = 1; }
                    }
                }
                store64(&crx + (b + 1) * 8, kx);
                store64(&crd + (b + 1) * 8, kd);
                a = a + 1;
            }
            # nonzero winding -> covered spans
            var wind = 0;
            var ci = 0;
            while (ci < nc - 1) {
                wind = wind + load64(&crd + ci * 8);
                if (wind != 0) {
                    span_add(load64(&crx + ci * 8), load64(&crx + (ci + 1) * 8), weight);
                }
                ci = ci + 1;
            }
            s = s + 1;
        }
        var px = 0;
        while (px < W) {
            var c = (load64(&accrow + px * 8) * 255) >> R_SHIFT;
            if (c > 255) { c = 255; }
            store8(cov + py * W + px, c);
            px = px + 1;
        }
        py = py + 1;
    }
    return 0;
}

fn cov_clear(cov): i64 {
    var i = 0;
    while (i < W * H) { store8(cov + i, 0); i = i + 1; }
    return 0;
}

# rr_selftest() -> 1 / 0. Proves the extraction's OWN invariants, so a consumer that includes
# this file can assert them cheaply rather than trusting the header.
#
# ============================================================================================
# ⚠⚠ THE FIRST VERSION OF THIS FUNCTION WAS A FALSE GATE, AND THE MUTATION CAUGHT IT
# ============================================================================================
# It checked only that `rr_set_dims` REFUSED out-of-range dimensions — i.e. it tested the
# DECLARED limit `RR_MAXW`, never the storage behind it. Shrinking `accrow` back to 64 slots
# left it passing, because nothing in the test ever indexed accrow past 63.
#
# That is exactly the failure class this whole file exists to prevent, reproduced inside the
# guard against it: a green assertion that cannot go red. The check below therefore reproduces
# the REAL failure MECHANISM instead of restating the declaration.
#
# ⛔ It depends on `crx` being laid out immediately after `accrow` in declaration order — which
# is not a guarantee Cyrius makes in general, but IS precisely the adjacency the original bug
# corrupted. If a future Cyrius reorders module globals this check silently weakens rather than
# breaking, so keep the mutation calibration (shrink accrow to 64, expect FAIL) in the bite log.
fn rr_selftest(): i64 {
    var ok = 1;
    if (rr_set_dims(0, 8) != 0)            { ok = 0; }      # w < 1 refused
    if (rr_set_dims(8, 0) != 0)            { ok = 0; }      # h < 1 refused
    if (rr_set_dims(RR_MAXW + 1, 8) != 0)  { ok = 0; }      # over-wide refused
    if (rr_dim_fault != 1)                 { ok = 0; }      # the latch armed
    rr_dim_fault = 0;
    if (rr_set_dims(RR_MAXW, 4) != 1)      { ok = 0; }      # the declared maximum is USABLE
    if (rr_dim_fault != 0)                 { ok = 0; }

    # ⭐ THE REAL CHECK. Arm a canary in the neighbour, then write across accrow at exactly the
    # indices span_add would use at RR_MAXW. If accrow is undersized the write lands on crx and
    # the canary dies — which is the original bug, fired on purpose.
    store64(&crx + 0, 0x5AFEC0DE);
    var i = 0;
    while (i < RR_MAXW) { store64(&accrow + i * 8, 0x1111 + i); i = i + 1; }
    if (load64(&crx + 0) != 0x5AFEC0DE) { ok = 0; }         # accrow overflowed into crx
    # and the pattern must have survived intact — a too-short accrow that wrapped would show here
    i = 0;
    while (i < RR_MAXW) {
        if (load64(&accrow + i * 8) != 0x1111 + i) { ok = 0; }
        i = i + 1;
    }
    store64(&crx + 0, 0);

    if (rr_set_dims(64, 64) != 1)          { ok = 0; }      # back to the shipped default
    return ok;
}

# ============================================================================================
# THE 20-CASE CORPUS — bite B1 of rung 9b
# ============================================================================================
# ⛔ THIS DID NOT EXIST. `gpu.md` cites "the 20-case corpus" twice (:808, :816) and BOTH are
# specification, never a manifest. The tree had 8 `corpus_case` calls + 3 `shared_edge_pair`
# calls = 11, and rung 8's own closure text honestly says "Corpus: 8 cases". A rung that
# reports a pass against a corpus nobody wrote has quietly redefined its own oracle, so the 20
# are ENUMERATED here, each with the reason it earns a slot, and the number is never inherited
# un-itemised again.
#
# ⭐ ONE SOURCE OF TRUTH FOR BOTH SIDES. `rr_case_load(i)` fills the SAME `ex0/ey0/ex1/ey1`
# arrays that `raster()` reads, so the ring-3 tool builds its `#92` edge array from exactly the
# geometry the reference rasterised. Two hand-kept lists — one for the CPU, one for the GPU —
# is how a "mismatch" turns out to be two different triangles.
#
# ⚠ Cases 2 and 6 rasterise to ALL ZERO by design. A shader that writes nothing "passes" them.
# They must never be counted as evidence on their own — see rr_case_expect_lit().
#
# | #  | case                        | why it earns a slot                                    |
# |----|-----------------------------|--------------------------------------------------------|
# |  1 | plain triangle              | baseline                                                |
# |  2 | zero-area / collinear       | all-zero answer (vacuous-pass hazard)                   |
# |  3 | backfacing CW               | `wind != 0` fills BOTH windings; a naive `wind > 0`      |
# |    |                             | passes every other case and fails only here             |
# |  4 | 1-px sliver                 | contains a horizontal edge                              |
# |  5 | clipped off-screen (neg)    | ⛔ THE SIGN-EXTENSION TRAP — `load32` zero-extends       |
# |  6 | fully outside               | all-zero answer (vacuous-pass hazard)                   |
# |  7 | pixel-centre straddling     | horizontal edge + exact half-pixel boundaries           |
# |  8 | full-canvas cover           | horizontal edge + coords beyond the mask (clamp path)   |
# |  9 | bowtie (self-intersecting)  | fragment-partition discriminator                        |
# | 10 | TWO overlapping triangles   | ⛔ MANDATORY. Merging a pixel's fragments instead of      |
# |    | in ONE edge array (6 edges) | summing them changes output, and a SINGLE triangle can  |
# |    |                             | never expose it — every 1-tri case passes either way    |
# | 11 | shared-edge quad, axis-alig | watertightness geometry (also split by oracle (ii))     |
# | 12 | shared-edge quad, skewed    | watertightness geometry                                 |
# | 13 | shared-edge quad, near-full | watertightness geometry                                 |
# | 14 | OPEN (non-closed) 3-edge    | `gpo_validate_edge` requires ne >= 3, never CLOSURE, so  |
# |    | path                        | an open path is ABI-legal and must not hang the walk    |
# | 15 | x-asymmetric triangle       | ⚠ gputri's built-in triangle is symmetric about the     |
# |    |                             | mask's x centre, so an x-MIRRORED tgid map shifts it by |
# |    |                             | one pixel instead of looking obviously wrong            |
# | 16 | width NOT a multiple of 64  | the EXEC bounds guard (37x29)                           |
# | 17 | tile-boundary, edge on x=64 | block-boundary ownership                                |
# | 18 | tile-boundary, corner       | block-boundary ownership                                |
# | 19 | WIDE mask 200x64            | ⭐ tgid_x wraps 3x+ — AND this is the exact case that     |
# |    |                             | would have fired B0's `accrow[64]` overflow             |
# | 20 | regular 64-gon              | the edge loop at the shipped cap (all 64 survive the    |
# |    |                             | horizontal-edge drop; verified at generation)           |

var RR_NCASES = 20;

# Vertices of the regular 64-gon (case 20): centre (64,64), radius 56, in a 128x128 mask.
# ⛔ EXACT 16.16 INTEGERS, precomputed. No runtime trig — a corpus case whose geometry depends
# on a math library is not bit-reproducible across toolchains, and this file IS the oracle.
var rr_gon[128];
var rr_gon_ready = 0;
fn rr_gon_init(): i64 {
    if (rr_gon_ready == 1) { return 0; }
    store64(&rr_gon +   0 * 16,    7864320); store64(&rr_gon +   0 * 16 + 8,    4194304);
    store64(&rr_gon +   1 * 16,    7846648); store64(&rr_gon +   1 * 16 + 8,    4554028);
    store64(&rr_gon +   2 * 16,    7793802); store64(&rr_gon +   2 * 16 + 8,    4910289);
    store64(&rr_gon +   3 * 16,    7706290); store64(&rr_gon +   3 * 16 + 8,    5259653);
    store64(&rr_gon +   4 * 16,    7584957); store64(&rr_gon +   4 * 16 + 8,    5598758);
    store64(&rr_gon +   5 * 16,    7430969); store64(&rr_gon +   5 * 16 + 8,    5924338);
    store64(&rr_gon +   6 * 16,    7245811); store64(&rr_gon +   6 * 16 + 8,    6233256);
    store64(&rr_gon +   7 * 16,    7031265); store64(&rr_gon +   7 * 16 + 8,    6522538);
    store64(&rr_gon +   8 * 16,    6789397); store64(&rr_gon +   8 * 16 + 8,    6789397);
    store64(&rr_gon +   9 * 16,    6522538); store64(&rr_gon +   9 * 16 + 8,    7031265);
    store64(&rr_gon +  10 * 16,    6233256); store64(&rr_gon +  10 * 16 + 8,    7245811);
    store64(&rr_gon +  11 * 16,    5924338); store64(&rr_gon +  11 * 16 + 8,    7430969);
    store64(&rr_gon +  12 * 16,    5598758); store64(&rr_gon +  12 * 16 + 8,    7584957);
    store64(&rr_gon +  13 * 16,    5259653); store64(&rr_gon +  13 * 16 + 8,    7706290);
    store64(&rr_gon +  14 * 16,    4910289); store64(&rr_gon +  14 * 16 + 8,    7793802);
    store64(&rr_gon +  15 * 16,    4554028); store64(&rr_gon +  15 * 16 + 8,    7846648);
    store64(&rr_gon +  16 * 16,    4194304); store64(&rr_gon +  16 * 16 + 8,    7864320);
    store64(&rr_gon +  17 * 16,    3834580); store64(&rr_gon +  17 * 16 + 8,    7846648);
    store64(&rr_gon +  18 * 16,    3478319); store64(&rr_gon +  18 * 16 + 8,    7793802);
    store64(&rr_gon +  19 * 16,    3128955); store64(&rr_gon +  19 * 16 + 8,    7706290);
    store64(&rr_gon +  20 * 16,    2789850); store64(&rr_gon +  20 * 16 + 8,    7584957);
    store64(&rr_gon +  21 * 16,    2464270); store64(&rr_gon +  21 * 16 + 8,    7430969);
    store64(&rr_gon +  22 * 16,    2155352); store64(&rr_gon +  22 * 16 + 8,    7245811);
    store64(&rr_gon +  23 * 16,    1866070); store64(&rr_gon +  23 * 16 + 8,    7031265);
    store64(&rr_gon +  24 * 16,    1599211); store64(&rr_gon +  24 * 16 + 8,    6789397);
    store64(&rr_gon +  25 * 16,    1357343); store64(&rr_gon +  25 * 16 + 8,    6522538);
    store64(&rr_gon +  26 * 16,    1142797); store64(&rr_gon +  26 * 16 + 8,    6233256);
    store64(&rr_gon +  27 * 16,     957639); store64(&rr_gon +  27 * 16 + 8,    5924338);
    store64(&rr_gon +  28 * 16,     803651); store64(&rr_gon +  28 * 16 + 8,    5598758);
    store64(&rr_gon +  29 * 16,     682318); store64(&rr_gon +  29 * 16 + 8,    5259653);
    store64(&rr_gon +  30 * 16,     594806); store64(&rr_gon +  30 * 16 + 8,    4910289);
    store64(&rr_gon +  31 * 16,     541960); store64(&rr_gon +  31 * 16 + 8,    4554028);
    store64(&rr_gon +  32 * 16,     524288); store64(&rr_gon +  32 * 16 + 8,    4194304);
    store64(&rr_gon +  33 * 16,     541960); store64(&rr_gon +  33 * 16 + 8,    3834580);
    store64(&rr_gon +  34 * 16,     594806); store64(&rr_gon +  34 * 16 + 8,    3478319);
    store64(&rr_gon +  35 * 16,     682318); store64(&rr_gon +  35 * 16 + 8,    3128955);
    store64(&rr_gon +  36 * 16,     803651); store64(&rr_gon +  36 * 16 + 8,    2789850);
    store64(&rr_gon +  37 * 16,     957639); store64(&rr_gon +  37 * 16 + 8,    2464270);
    store64(&rr_gon +  38 * 16,    1142797); store64(&rr_gon +  38 * 16 + 8,    2155352);
    store64(&rr_gon +  39 * 16,    1357343); store64(&rr_gon +  39 * 16 + 8,    1866070);
    store64(&rr_gon +  40 * 16,    1599211); store64(&rr_gon +  40 * 16 + 8,    1599211);
    store64(&rr_gon +  41 * 16,    1866070); store64(&rr_gon +  41 * 16 + 8,    1357343);
    store64(&rr_gon +  42 * 16,    2155352); store64(&rr_gon +  42 * 16 + 8,    1142797);
    store64(&rr_gon +  43 * 16,    2464270); store64(&rr_gon +  43 * 16 + 8,     957639);
    store64(&rr_gon +  44 * 16,    2789850); store64(&rr_gon +  44 * 16 + 8,     803651);
    store64(&rr_gon +  45 * 16,    3128955); store64(&rr_gon +  45 * 16 + 8,     682318);
    store64(&rr_gon +  46 * 16,    3478319); store64(&rr_gon +  46 * 16 + 8,     594806);
    store64(&rr_gon +  47 * 16,    3834580); store64(&rr_gon +  47 * 16 + 8,     541960);
    store64(&rr_gon +  48 * 16,    4194304); store64(&rr_gon +  48 * 16 + 8,     524288);
    store64(&rr_gon +  49 * 16,    4554028); store64(&rr_gon +  49 * 16 + 8,     541960);
    store64(&rr_gon +  50 * 16,    4910289); store64(&rr_gon +  50 * 16 + 8,     594806);
    store64(&rr_gon +  51 * 16,    5259653); store64(&rr_gon +  51 * 16 + 8,     682318);
    store64(&rr_gon +  52 * 16,    5598758); store64(&rr_gon +  52 * 16 + 8,     803651);
    store64(&rr_gon +  53 * 16,    5924338); store64(&rr_gon +  53 * 16 + 8,     957639);
    store64(&rr_gon +  54 * 16,    6233256); store64(&rr_gon +  54 * 16 + 8,    1142797);
    store64(&rr_gon +  55 * 16,    6522538); store64(&rr_gon +  55 * 16 + 8,    1357343);
    store64(&rr_gon +  56 * 16,    6789397); store64(&rr_gon +  56 * 16 + 8,    1599211);
    store64(&rr_gon +  57 * 16,    7031265); store64(&rr_gon +  57 * 16 + 8,    1866070);
    store64(&rr_gon +  58 * 16,    7245811); store64(&rr_gon +  58 * 16 + 8,    2155352);
    store64(&rr_gon +  59 * 16,    7430969); store64(&rr_gon +  59 * 16 + 8,    2464270);
    store64(&rr_gon +  60 * 16,    7584957); store64(&rr_gon +  60 * 16 + 8,    2789850);
    store64(&rr_gon +  61 * 16,    7706290); store64(&rr_gon +  61 * 16 + 8,    3128955);
    store64(&rr_gon +  62 * 16,    7793802); store64(&rr_gon +  62 * 16 + 8,    3478319);
    store64(&rr_gon +  63 * 16,    7846648); store64(&rr_gon +  63 * 16 + 8,    3834580);
    rr_gon_ready = 1;
    return 0;
}

# rr_case_load(i) -> 1 ok / 0 refused. Sets W/H and fills the edge list. 1-based case ids.
# ⛔ Sequential `if` on a fixed selector, never chained `else if` — Cyrius kernel/tool idiom
# ([[reference_cyrius_control_flow_idioms]]).
fn rr_case_load(i): i64 {
    edges_reset();
    rr_dim_fault = 0;

    if (i == 1)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(8), fx(8), fx(48), fx(12), fx(20), fx(50)); }
    if (i == 2)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(4), fx(4), fx(20), fx(20), fx(40), fx(40)); }
    if (i == 3)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(8), fx(50), fx(20), fx(8), fx(48), fx(44)); }
    if (i == 4)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(2), fx(30), fx(60), fx(30), fx(60), fx(31)); }
    if (i == 5)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(0 - 40), fx(0 - 40), fx(30), fx(10), fx(10), fx(30)); }
    if (i == 6)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(200), fx(200), fx(260), fx(210), fx(210), fx(260)); }
    if (i == 7)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(10), fx(10), fx(40), fx(10), fx(10), fx(40)); }
    if (i == 8)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(0 - 10), fx(0 - 10), fx(90), fx(0 - 10), fx(30), fx(90)); }
    # 9 — bowtie: A-B-C-D wound so the two lobes have OPPOSITE winding through the crossover.
    if (i == 9)  { if (rr_set_dims(64, 64) != 1) { return 0; }
                   edge_add(fx(8),  fx(8),  fx(56), fx(56));
                   edge_add(fx(56), fx(56), fx(56), fx(8));
                   edge_add(fx(56), fx(8),  fx(8),  fx(56));
                   edge_add(fx(8),  fx(56), fx(8),  fx(8)); }
    # 10 — FOUR shapes in ONE edge array, carrying TWO distinct properties.
    #
    # (a) two OVERLAPPING triangles — winding accumulated across separate shapes.
    #
    # (b) ⭐ two rectangles separated by a SUB-PIXEL GAP, both entirely inside pixel column 10.
    #     THIS is what makes fragment MERGING detectable, and the overlapping pair does NOT:
    #     overlapping shapes produce ONE continuous covered span, so there is only ever one
    #     fragment per pixel per sub-scanline and merging is indistinguishable from summing.
    #     Two shapes with a gap NARROWER THAN A PIXEL put two disjoint fragments in the same
    #     pixel on the same sub-scanline — and each is truncated separately by `>> 2`.
    #     Widths are chosen ≡ 2 (mod 4) in 16.16 so the two discarded remainders sum to a whole
    #     unit: summing gives 4096+4096 = 8192, merging gives (16386+16386)>>2 = 8193.
    #     ⚠ MEASURED, not assumed: the merge mutation passed all 20 cases and 160 random shapes
    #     until this geometry existed.
    if (i == 10) { if (rr_set_dims(64, 64) != 1) { return 0; }
                   tri_add(fx(6),  fx(6),  fx(40), fx(10), fx(14), fx(44));
                   tri_add(fx(20), fx(18), fx(58), fx(24), fx(30), fx(58));
                   edge_add(655360,       fx(8),  671746,       fx(8));
                   edge_add(671746,       fx(8),  671746,       fx(40));
                   edge_add(671746,       fx(40), 655360,       fx(40));
                   edge_add(655360,       fx(40), 655360,       fx(8));
                   edge_add(695360,       fx(8),  711746,       fx(8));
                   edge_add(711746,       fx(8),  711746,       fx(40));
                   edge_add(711746,       fx(40), 695360,       fx(40));
                   edge_add(695360,       fx(40), 695360,       fx(8)); }
    if (i == 11) { if (rr_set_dims(64, 64) != 1) { return 0; }
                   edge_add(fx(8),  fx(8),  fx(48), fx(8));
                   edge_add(fx(48), fx(8),  fx(48), fx(48));
                   edge_add(fx(48), fx(48), fx(8),  fx(48));
                   edge_add(fx(8),  fx(48), fx(8),  fx(8)); }
    if (i == 12) { if (rr_set_dims(64, 64) != 1) { return 0; }
                   edge_add(fx(6),  fx(10), fx(50), fx(4));
                   edge_add(fx(50), fx(4),  fx(54), fx(46));
                   edge_add(fx(54), fx(46), fx(10), fx(52));
                   edge_add(fx(10), fx(52), fx(6),  fx(10)); }
    if (i == 13) { if (rr_set_dims(64, 64) != 1) { return 0; }
                   edge_add(fx(3),  fx(3),  fx(60), fx(5));
                   edge_add(fx(60), fx(5),  fx(58), fx(60));
                   edge_add(fx(58), fx(60), fx(5),  fx(58));
                   edge_add(fx(5),  fx(58), fx(3),  fx(3)); }
    # 14 — OPEN path: three edges that do NOT return to the start. ABI-legal (ne >= 3 is the
    # only requirement), so the walk must terminate cleanly rather than run off the row.
    if (i == 14) { if (rr_set_dims(64, 64) != 1) { return 0; }
                   edge_add(fx(10), fx(10), fx(50), fx(20));
                   edge_add(fx(50), fx(20), fx(30), fx(50));
                   edge_add(fx(30), fx(50), fx(20), fx(34)); }
    # 15 — deliberately NOT symmetric about x = W/2, so an x-mirrored tgid map is visible.
    if (i == 15) { if (rr_set_dims(128, 64) != 1) { return 0; }
                   tri_add(fx(6), fx(6), fx(38), fx(14), fx(18), fx(52)); }
    if (i == 16) { if (rr_set_dims(37, 29) != 1) { return 0; }
                   tri_add(fx(3), fx(2), fx(34), fx(9), fx(12), fx(26)); }
    if (i == 17) { if (rr_set_dims(128, 64) != 1) { return 0; }
                   tri_add(fx(64), fx(4), fx(64), fx(60), fx(96), fx(32)); }
    if (i == 18) { if (rr_set_dims(128, 64) != 1) { return 0; }
                   tri_add(fx(56), fx(24), fx(72), fx(24), fx(64), fx(40)); }
    if (i == 19) { if (rr_set_dims(200, 64) != 1) { return 0; }
                   tri_add(fx(4), fx(4), fx(196), fx(20), fx(90), fx(60)); }
    if (i == 20) { if (rr_set_dims(128, 128) != 1) { return 0; }
                   rr_gon_init();
                   var k = 0;
                   while (k < 64) {
                       var n = k + 1;
                       if (n == 64) { n = 0; }
                       edge_add(load64(&rr_gon + k * 16), load64(&rr_gon + k * 16 + 8),
                                load64(&rr_gon + n * 16), load64(&rr_gon + n * 16 + 8));
                       k = k + 1;
                   } }

    if (i < 1)          { return 0; }
    if (i > RR_NCASES)  { return 0; }
    if (rr_dim_fault != 0) { return 0; }
    # ⛔ A case that loaded NO edges means the selector missed — that is a typo, not a test.
    #
    # ⚠ THE BOUND IS 1, NOT 3, AND THE REASON IS LOAD-BEARING FOR THE SHADER. `edge_add` DROPS
    # horizontal edges (y0 == y1) because they can never satisfy both `sy >= ylo` and
    # `sy < yhi`. So a flat-topped triangle SUBMITS 3 edges and RETAINS 2 — cases 4, 7, 8, 11
    # and 18 all do exactly this, and a `< 3` check here rejected all five as "refused to load"
    # when they were correct.
    #
    # ⭐ The consequence for rung 9b: `#92`'s `ne >= 3` counts SUBMITTED edges, and the shader
    # receives all of them including the horizontal ones. It must produce NO crossing for a
    # horizontal edge rather than assuming the caller pre-filtered — the reference does the
    # filtering internally, so an unfiltered GPU would disagree on five of the twenty cases.
    if (n_edges < 1) { return 0; }
    return 1;
}

# rr_case_edges_submitted(i) -> what a `#92` caller puts in `n_edges`.
# ⭐ Since the first iron burn this is simply `n_edges`: horizontal edges are no longer dropped
# at ingest, so the submitted count and the stored count are the same number, and the CPU and
# the GPU are finally given the SAME geometry. Kept as a named function because consumers ask
# the question and the answer should have one place to change.
fn rr_case_edges_submitted(i): i64 { return n_edges; }

# rr_case_expect_lit(i) -> 1 if this case MUST produce at least one non-zero coverage byte.
# ⭐ Cases 2 and 6 are all-zero BY DESIGN, so a dead shader reproduces them perfectly. Any
# consumer comparing GPU against reference must call this and refuse to count an all-zero
# result as a pass on the other 18 — otherwise "20/20 identical" is satisfiable by writing
# nothing at all, which is exactly the outcome gputri classifies as UNTOUCHED.
fn rr_case_expect_lit(i): i64 {
    if (i == 2) { return 0; }
    if (i == 6) { return 0; }
    return 1;
}

# rr_corpus_audit() -> 1 / 0. ⭐ Does the corpus still have the STRUCTURAL PROPERTIES it was
# built for? Determinism and non-vacuity are per-case checks and they do NOT answer this.
#
# ⚠ WRITTEN BECAUSE A MUTATION SLIPPED THROUGH. Narrowing case 19 from 200x64 to 64x64 left the
# corpus reporting a clean "20 of 20 deterministic and non-vacuous" while its name still said
# "WIDE mask 200x64" — the case had silently stopped exercising tgid_x wrap AND the `accrow`
# width that B0 exists to protect. A corpus that cannot notice one of its own cases being
# neutered is a list of shapes, not a test.
#
# Each property below is here because some rung's oracle depends on it. Losing one is a silent
# reduction in what "20/20 identical" means.
fn rr_corpus_audit(): i64 {
    var maxw = 0;
    var maxe = 0;
    var n_nonmul64 = 0;
    var n_narrow = 0;
    var n_multishape = 0;
    var case10_edges = 0;
    var n_negcoord = 0;
    var n_empty = 0;
    var n_horiz = 0;
    var i = 1;
    while (i <= RR_NCASES) {
        if (rr_case_load(i) == 1) {
            if (W > maxw) { maxw = W; }
            if (n_edges > maxe) { maxe = n_edges; }
            if (W % 64 != 0) { n_nonmul64 = n_nonmul64 + 1; }
            if (W < 64)       { n_narrow = n_narrow + 1; }
            if (n_edges > 3)  { n_multishape = n_multishape + 1; }
            if (i == 10)      { case10_edges = n_edges; }
            if (rr_case_expect_lit(i) == 0) { n_empty = n_empty + 1; }
            # ⭐ A horizontal edge is now KEPT, so the property is checked DIRECTLY rather than
            # inferred from a count mismatch. What matters is that the corpus still hands the
            # shader at least one `y0 == y1` edge to filter with its own half-open guard — an
            # unfiltered GPU disagrees on five of the twenty cases.
            var hz = 0;
            while (hz < n_edges) {
                if (load64(&ey0 + hz * 8) == load64(&ey1 + hz * 8)) { n_horiz = n_horiz + 1; }
                hz = hz + 1;
            }
            var k = 0;
            while (k < n_edges) {
                if (load64(&ex0 + k * 8) < 0) { n_negcoord = n_negcoord + 1; }
                if (load64(&ey0 + k * 8) < 0) { n_negcoord = n_negcoord + 1; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    var ok = 1;
    # ⭐ 200 is not arbitrary: it is >3x the 64-lane workgroup width (tgid_x must wrap at least
    # three times) and it is the width that would have fired B0's accrow[64] overflow.
    if (maxw < 200)        { ok = 0; }
    if (maxe < 64)         { ok = 0; }   # the edge loop reaches the shipped cap
    if (n_nonmul64 < 1)    { ok = 0; }   # a partial final workgroup exists
    # ⚠ DISTINCT from the above, and the distinction is why the check is here: 200 % 64 = 8, so
    # a wide mask already gives a partial final workgroup. What it does NOT give is a mask
    # NARROWER than one workgroup, where the very first wave is partial and every lane past the
    # width must mask off before an address is formed. Only case 16 (37 wide) tests that.
    if (n_narrow < 1)      { ok = 0; }
    if (n_multishape < 1)  { ok = 0; }   # at least one shape with more than 3 edges
    # ⛔ THE MANDATORY CASE, CHECKED BY NAME. `n_multishape` above is a PROXY and it is too
    # weak: a quad has 4 edges and satisfies it, so deleting case 10's second triangle left the
    # audit green. Case 10 is the ONLY case with two separate closed shapes in one edge array,
    # and it is the only thing that can distinguish summing a pixel's coverage fragments from
    # merging them — every single-shape case passes either way. A proxy that a quad satisfies
    # does not protect it, so the requirement is stated directly.
    if (case10_edges < 10) { ok = 0; }
    # ⚠ 10, not 6. Case 10 must carry BOTH properties: the overlapping pair (winding across
    # shapes) AND the sub-pixel-gap pair (two fragments in one pixel). The overlap alone left
    # the fragment-merge mutation undetected across all 20 cases and 160 random shapes.
    if (n_negcoord < 1)    { ok = 0; }   # the sign-extension trap
    if (n_empty != 2)      { ok = 0; }   # exactly the two all-zero cases, no more, no fewer
    if (n_horiz < 1)       { ok = 0; }   # horizontal edges reach the shader unfiltered
    rr_set_dims(64, 64);
    return ok;
}

fn rr_case_name(i): i64 {
    if (i == 1)  { return "plain triangle"; }
    if (i == 2)  { return "zero-area (collinear)"; }
    if (i == 3)  { return "backfacing (CW)"; }
    if (i == 4)  { return "sliver (1px tall)"; }
    if (i == 5)  { return "off-screen (negative coords)"; }
    if (i == 6)  { return "fully outside"; }
    if (i == 7)  { return "pixel-centre straddle"; }
    if (i == 8)  { return "full-canvas cover"; }
    if (i == 9)  { return "bowtie (self-intersecting)"; }
    if (i == 10) { return "overlap pair + SUB-PIXEL-GAP pair (fragments)"; }
    if (i == 11) { return "shared-edge quad, axis-aligned"; }
    if (i == 12) { return "shared-edge quad, skewed"; }
    if (i == 13) { return "shared-edge quad, near-full"; }
    if (i == 14) { return "OPEN 3-edge path (not closed)"; }
    if (i == 15) { return "x-asymmetric triangle"; }
    if (i == 16) { return "width not a multiple of 64 (37x29)"; }
    if (i == 17) { return "tile boundary, edge on x=64"; }
    if (i == 18) { return "tile boundary, corner"; }
    if (i == 19) { return "WIDE mask 200x64"; }
    if (i == 20) { return "regular 64-gon (n_edges at cap)"; }
    return "<bad case id>";
}

# ============================================================================================
# INTEGER-DIVIDE PRIMITIVES — one implementation, shared by every tool
# ============================================================================================
# ⛔ THESE LIVED IN edgemodel.cyr AND WERE ABOUT TO BE COPIED INTO triref.cyr. That is exactly the
# defect this file was created to kill: the same routine hand-transcribed into several tools with
# nothing enforcing that they agree, and Cyrius shadowing duplicate `fn`s SILENTLY and warn-only, so
# a divergence would not even error — the last definition would quietly win.
# Moved here 2026-07-26 so the attribute-interpolation reference, the shader model and the kernel
# prologue all divide the same way by construction rather than by inspection.
fn u32(x): i64 { return x & 0xFFFFFFFF; }
# ⚠ CYRIUS SHIFTS ARE INVERTED FROM C/JAVA: `>>` is LOGICAL (zero-fill), `>>>` is ARITHMETIC.
# [[reference_cyrius_shift_right_is_logical]]. The divider wants LOGICAL throughout (it is all
# unsigned); the abs idiom below wants ARITHMETIC, and using `>>` there would make the sign
# mask 0 for negatives and silently return the wrong magnitude.
fn sar32(x, n): i64 { return u32(((x << 32) >>> (32 + n))); }
# v_ffbh_u32 — count leading zeros of a 32-bit value.
fn clz32(x): i64 {
    if (x == 0) { return 32; }
    var v = u32(x);
    var n = 0;
    while ((v & 0x80000000) == 0) { v = u32(v << 1); n = n + 1; }
    return n;
}
# ============================================================================================
# DISPATCH 1 — the per-edge prologue (`edge_setup.s`), one lane per edge
# ============================================================================================
# Prep record, 32 bytes: [ax, ay, ylo, yhi] [N, d, V, L]
var PREP_W = 8;                 # i64 slots per record in THIS model (the shader packs 8 x u32)
var prep[4096];                 # module-scope var[N] = N x u64; 512 edges x 8 = 4096 slots
var prep_n = 0;

# V = floor((2^63 - 1) / dp) via the 32-iteration integer RESTORING loop.
#
# ⛔ NO v_rcp_f32 ANYWHERE, and that is a deliberate sovereignty call. LLVM's f32-reciprocal
# division macro is exact only EMPIRICALLY — its own source comment says so, it was
# demonstrably wrong before 2020, and a +1-ULP perturbation the ISA permits breaks it inside
# our operand range. This loop is exact BY CONSTRUCTION and, hoisted per edge, costs nothing
# amortised. [[feedback_sovereignty_over_slip_at_base]]
#
# ⚠ The numerator's high dword is 0x7FFFFFFF and its low dword is all-ones. Since dp >= 2^31,
# the high dword is always < dp, and the bit shifted in is ALWAYS 1 — so the numerator needs no
# register at all. `top` must be captured BEFORE the shift because the shift is 32-bit and
# drops the carry.
fn recip32(dp): i64 {
    var r = 0x7FFFFFFF;
    var v = 0;
    var k = 0;
    while (k < 32) {
        var top = (r >> 31) & 1;
        r = u32(u32(r << 1) | 1);
        var ge = 0;
        if (top == 1) { ge = 1; }
        if (top != 1) { if (r >= dp) { ge = 1; } }
        if (ge == 1) { r = u32(r - dp); }
        v = u32(u32(v << 1) | ge);
        k = k + 1;
    }
    return v;
}
