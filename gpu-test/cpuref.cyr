# cpuref.cyr — RUNG 8 of the 3D arc. The CPU reference rasteriser and its two oracles.
#
# ============================================================================================
# WHY THIS IS A RUNG AND NOT A HELPER
# ============================================================================================
# Every Phase II rung's oracle is "byte-identical to the CPU reference". If the reference is
# wrong, every one of those greens is wrong in the same direction and nothing downstream can
# detect it — the GPU would be validated against a mistake. So the reference gets its own rung,
# its own oracles, and it is proven BEFORE anything cites it.
#
# ⛔ IT LIVES IN THE RING-3 TOOL, NEVER IN THE KERNEL. The build-size discipline threshold is
# already blown at 1.8 MB; a reference rasteriser in kernel text would be pure cost.
#
# ============================================================================================
# THE TWO ORACLES, AND WHY IT TAKES TWO
# ============================================================================================
# (i)  AGREEMENT — the reference agrees with sadish itself, byte-for-byte, over the corpus.
#      Catches: port errors. Does NOT catch: sadish being wrong, because this reference is a
#      port OF sadish. On its own it is close to marking its own homework.
#
# (ii) INTERNAL CONSISTENCY — on every shared-edge pair, ZERO double-covered and ZERO uncovered
#      pixels along the seam. ⭐ This one does NOT depend on the reference being right. Two
#      triangles meeting on an exact shared edge must tile that edge perfectly under ANY correct
#      fill rule; a crack or a double-hit is a fill-rule bug no agreement test can see, because
#      a port reproduces its source's cracks faithfully.
#
#      On the GPU the same bug presents as FLICKER, which reads as a coherence problem and gets
#      chased for burns. Catching it here costs nothing.
#
# ============================================================================================
# PORTED FROM sadish/src/raster.cyr — sd_fill_impl / sd_span_add
# ============================================================================================
# 16.16 fixed point (SD_SHIFT=16) · SD_FILL_SS=4 vertical sub-scanlines ·
# sub-scanline y = (py<<16) + (s*ONE + ONE/2)/ssy · HALF-OPEN y test (sy >= ylo && sy < yhi) ·
# analytic exact x-overlap per pixel per sub-scanline · weight = ONE/ssy ·
# coverage byte = (acc*255)>>16, clamped to 255.
#
# ⚠ THE HALF-OPEN RULE IS THE WHOLE SHARED-EDGE STORY. `sy >= ylo` and `sy < yhi` is what makes
# a shared horizontal boundary belong to exactly one of the two triangles. Change it to `<=` and
# oracle (ii) fails with double-coverage; change it to `>` and it fails with a crack. That is
# precisely why oracle (ii) exists and why it is not redundant with (i).
#
# Build:  cd gpu-test && cyrius build cpuref.cyr build/cpuref
# Run:    ./build/cpuref     -> 95 = both oracles pass · 90 = a failure (named)

include "lib/io.cyr"

fn slen(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
fn ps(s): i64 { print(s, slen(s)); return 0; }
fn nl(): i64 { print("\n", 1); return 0; }
fn puts(s): i64 { ps(s); nl(); return 0; }
fn pnum(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var neg = 0; var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var buf[24]; var i = 0;
    while (x > 0) { store8(&buf + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&buf + i, 1); }
    return 0;
}

# ⭐ THE REFERENCE NOW LIVES IN ONE PLACE. Bite B0 of rung 9b extracted the rasteriser into
# gpu-test/refraster.cyr because "byte-identical to the CPU reference" had THREE hand-transcribed
# referents (here, refagree.cyr, tileown.cyr) with different array bounds — and Cyrius shadows
# duplicate fns SILENTLY, so a divergence between them would not even warn.
#
# ⚠ The extraction also fixed a latent FATAL in this file: `var accrow[64]` is 64 u64 slots and
# span_add indexes it by pixel x up to W. At W=64 that is exactly in bounds, so it never fired —
# but rung 9b's corpus needs a 200x64 case, and at any W > 64 it wrote into crx/crd. The
# corruption would have been in the ORACLE, presenting as the GPU disagreeing on wide masks.
include "refraster.cyr"

# Consumer-side scratch. NOT part of the reference: these are this tool's own comparison
# buffers, so they stay here rather than in refraster.cyr where every other consumer would
# inherit 32 KB it does not use. Module-scope var[N] = N x u64, so 4096 slots = 32 KB, ample
# for the 64x64 masks this tool rasterises.
var covA[4096];
var covB[4096];

# ============================================================================================
# ORACLE (ii) — SHARED-EDGE WATERTIGHTNESS. Does not depend on the reference being right.
# ============================================================================================
# Two triangles split a quad along a diagonal. Rasterised SEPARATELY, every pixel's coverage
# from the two must sum to what the undivided quad gives — no more (double-hit) and no less
# (crack). ⚠ Summed coverage is compared against the QUAD, not against 255, because interior
# pixels of an AA rasteriser are legitimately < 255 at the quad's own outer boundary.
var covQ[4096];

fn shared_edge_pair(ax, ay, bx, by, cx, cy, dx, dy, name): i64 {
    # the quad A-B-C-D as one path
    edges_reset();
    edge_add(fx(ax), fx(ay), fx(bx), fx(by));
    edge_add(fx(bx), fx(by), fx(cx), fx(cy));
    edge_add(fx(cx), fx(cy), fx(dx), fx(dy));
    edge_add(fx(dx), fx(dy), fx(ax), fx(ay));
    cov_clear(&covQ); raster(&covQ);

    # triangle 1: A-B-C
    edges_reset(); tri_add(fx(ax), fx(ay), fx(bx), fx(by), fx(cx), fx(cy));
    cov_clear(&covA); raster(&covA);
    # triangle 2: A-C-D  (shares the exact edge A-C)
    edges_reset(); tri_add(fx(ax), fx(ay), fx(cx), fx(cy), fx(dx), fx(dy));
    cov_clear(&covB); raster(&covB);

    var doubles = 0;
    var cracks = 0;
    var worst = 0;
    var i = 0;
    while (i < W * H) {
        var q = load8(&covQ + i);
        var s = load8(&covA + i) + load8(&covB + i);
        if (s > 255) { s = 255; }
        var d = s - q;
        if (d < 0) { d = 0 - d; }
        if (d > worst) { worst = d; }
        if (s > q) { if (d > 1) { doubles = doubles + 1; } }
        if (s < q) { if (d > 1) { cracks = cracks + 1; } }
        i = i + 1;
    }
    ps("  "); ps(name);
    ps("  double-covered "); pnum(doubles);
    ps("  cracked "); pnum(cracks);
    ps("  worst delta "); pnum(worst);
    if (doubles == 0) {
        if (cracks == 0) { puts("   WATERTIGHT"); return 1; }
    }
    puts("   ** LEAK **");
    return 0;
}

# ============================================================================================
# ORACLE (i) — DETERMINISM + STABILITY over the corpus.
# ============================================================================================
# ⚠ HONEST SCOPE, stated rather than implied. The plan's rung 8 says this oracle is
# "the reference agrees with SADISH ITSELF on 200 random paths". That comparison requires
# linking sadish's canvas/path/alloc machinery into this tool, which is a real integration and
# is NOT done here. What IS proven here is that the ported inner math is DETERMINISTIC and
# STABLE over the corpus, plus the far stronger oracle (ii).
#
# ⛔ THEREFORE: rung 8 is PARTIAL. The sadish cross-check is a named, remaining sub-item and
# must land before rung 9 cites "byte-identical to the CPU reference". Saying so here is the
# whole point — a rung that quietly redefines its own oracle is how an arc drifts.
fn corpus_case(name, ax, ay, bx, by, cx, cy): i64 {
    edges_reset(); tri_add(fx(ax), fx(ay), fx(bx), fx(by), fx(cx), fx(cy));
    cov_clear(&covA); raster(&covA);
    edges_reset(); tri_add(fx(ax), fx(ay), fx(bx), fx(by), fx(cx), fx(cy));
    cov_clear(&covB); raster(&covB);
    var diff = 0;
    var lit = 0;
    var i = 0;
    while (i < W * H) {
        if (load8(&covA + i) != load8(&covB + i)) { diff = diff + 1; }
        if (load8(&covA + i) != 0) { lit = lit + 1; }
        i = i + 1;
    }
    ps("  "); ps(name); ps("  lit px "); pnum(lit);
    if (diff == 0) { puts("   deterministic"); return 1; }
    ps("  NONDETERMINISTIC ("); pnum(diff); puts(" px differ)   ** FAIL **");
    return 0;
}

fn main(): i64 {
    puts("cpuref -- RUNG 8: the CPU reference rasteriser and its oracles");
    puts("=============================================================");
    puts("Ported from sadish/src/raster.cyr: 16.16, 4 sub-scanlines, analytic-x, half-open y.");
    puts("");
    var ok = 1;

    # ⭐ B0 GATE. The shared reference's own invariants, asserted before anything cites it.
    # ⚠ The load-bearing case is the wide one: the pre-extraction `var accrow[64]` held exactly
    # 64 slots while `span_add` indexes it to W, so any W > 64 wrote into `crx`/`crd` — silently
    # corrupting the ORACLE and presenting as a plausible wrong triangle at rung 9b. If accrow
    # ever shrinks back, this fails HERE, not 200 lines away in another tool.
    if (rr_selftest() != 1) {
        puts("** refraster.cyr selftest FAILED -- the shared reference is not sound.");
        puts("   Nothing downstream may cite it. Check accrow sizing and rr_set_dims.");
        return 91;
    }
    puts("[refraster] shared reference selftest PASS (dims refuse, wide mask fits)");
    puts("");

    puts("[corpus] determinism + degenerate handling");
    if (corpus_case("plain triangle      ", 8, 8, 48, 12, 20, 50) == 0) { ok = 0; }
    if (corpus_case("zero-area (collinear)", 4, 4, 20, 20, 40, 40) == 0) { ok = 0; }
    if (corpus_case("backfacing (CW)     ", 8, 50, 20, 8, 48, 44) == 0) { ok = 0; }
    if (corpus_case("sliver (1px tall)   ", 2, 30, 60, 30, 60, 31) == 0) { ok = 0; }
    if (corpus_case("off-screen (clipped)", 0 - 40, 0 - 40, 30, 10, 10, 30) == 0) { ok = 0; }
    if (corpus_case("fully outside       ", 200, 200, 260, 210, 210, 260) == 0) { ok = 0; }
    if (corpus_case("pixel-centre straddle", 10, 10, 40, 10, 10, 40) == 0) { ok = 0; }
    if (corpus_case("full-canvas cover   ", 0 - 10, 0 - 10, 90, 0 - 10, 30, 90) == 0) { ok = 0; }
    puts("");

    puts("[shared-edge] watertightness -- the oracle that does NOT depend on the reference");
    if (shared_edge_pair(8, 8, 48, 8, 48, 48, 8, 48, "axis-aligned quad   ") == 0) { ok = 0; }
    if (shared_edge_pair(6, 10, 50, 4, 54, 46, 10, 52, "skewed quad         ") == 0) { ok = 0; }
    if (shared_edge_pair(3, 3, 60, 5, 58, 60, 5, 58, "near-full quad      ") == 0) { ok = 0; }
    puts("");

    if (ok == 0) {
        puts("** RUNG 8 FAILED. Do not let any Phase II rung cite this reference.");
        return 90;
    }
    puts("Corpus deterministic; every shared-edge pair WATERTIGHT (no cracks, no double-hits).");
    puts("");
    puts("⚠⚠ RUNG 8 IS **PARTIAL** -- READ BEFORE RUNG 9 OPENS.");
    puts("   Oracle (ii), watertightness, is DONE and is the strong one: it is independent of");
    puts("   the reference being correct.");
    puts("   Oracle (i) as the plan specifies it -- byte-for-byte agreement with SADISH ITSELF");
    puts("   over 200 random paths -- is NOT done. It needs sadish's canvas/path/alloc linked");
    puts("   into this tool, a real integration, not a line of code.");
    puts("   Until it lands, 'byte-identical to the CPU reference' rests on a port that has");
    puts("   been proven self-consistent and watertight, but NOT proven equal to its source.");
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
