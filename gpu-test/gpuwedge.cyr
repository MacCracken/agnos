# gpuwedge.cyr — RUNG 5 of the 3D arc. The hang/recovery battery, from ring 3.
#
# ============================================================================================
# ⛔ A RING-3 TOOL, NEVER A BOOT SELF-TEST — AND THAT IS NOT A STYLE CHOICE
# ============================================================================================
# The D lane spent five burns learning this: a bite whose oracle is a human watching the screen
# belongs in a SHELL COMMAND, not in kernel init. If these arms ran at boot, every failure would
# cost a reflash + power cycle, and a wedge that killed the console would take its own evidence
# with it. From the shell the operator runs one arm, reads the result, and decides.
#
# ============================================================================================
# WHY RUNG 5 EARNS ITS BURN EVEN IF 3D NEVER SHIPS
# ============================================================================================
# agnos has NO GPU hang detection today. A runaway tentib ternary matmul through #82, or a
# malformed #92 batch from aethersafha — both of which SHIP RIGHT NOW — kill the box with no
# log. Every safety property agnos has bounds how long the CPU WAITS, never what the GPU DOES.
# This is the bite that changes that, and it is deliberately first in the arc.
#
# ============================================================================================
# THE FIVE ARMS — one variable each, ONE boot
# ============================================================================================
#   A  controlled wedge   ⭐ PRIMARY ORACLE: the bracket must NAME the WAIT packet.
#                            ⚠ It passes even if every recovery rung then fails — "we can SEE
#                            the hang" and "we can CLEAR the hang" are different claims, and
#                            collapsing them would let a failed recovery hide a working
#                            instrument that every later rung depends on.
#   B  dequeue + re-map      CP_HQD_ACTIVE must read 0 — cleared BY HARDWARE, an answer, not an
#                            echo of our own DEQUEUE_REQUEST write.
#   C  negative control      matmul bit-correct BEFORE and AFTER. ⛔ If it is not correct after,
#                            recovery is WORSE THAN THE HANG and R-4 (give up cleanly) becomes
#                            the default on any ambiguity.
#   D  free                  while wedged, does the console still paint? This is the
#                            load-bearing, never-measured assumption under the ENTIRE GFX risk
#                            model. If the console dies with the GPU, Phase III must be re-costed
#                            before it opens.
#   E  guard negative        S6 shipped its EXEC guard with NO unguarded arm, so "the guard
#                            stopped the overrun" is INFERRED, not measured — and every ring-3
#                            specified triangle's memory safety rests on it.
#
# ⛔ RUN ORDER MATTERS: C first (establish the baseline), then A, then B, then C again (the
# after-reading), then D. Running C only once proves nothing about recovery.
#
# Build:  cd gpu-test && cyrius build --agnos gpuwedge.cyr build/gpuwedge_agnos
# Iron:   run /bin/gpuwedge --baseline   (C, before)
#         run /bin/gpuwedge --wedge      (A)  <- panel may go dark; that is the experiment
#         run /bin/gpuwedge --recover    (B)
#         run /bin/gpuwedge --verify     (C, after)
#         run /bin/gpuwedge --console    (D)
#         run /bin/klug > /wedge.txt

include "lib/io.cyr"

fn w_puts(s, n): i64 { print(s, n); print("\n", 1); return 0; }
fn w_num(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var neg = 0; var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var b[24]; var i = 0;
    while (x > 0) { store8(&b + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&b + i, 1); }
    return 0;
}

var ARM_A = 1;
var ARM_B = 2;
var ARM_C = 3;
var ARM_D = 4;

# #94 gpu_recover_op(arm). Returns 95 on the arm's own success, or a negative reason.
fn recover_op(arm): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(94, arm, 0, 0);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
}

fn report(arm, r): i64 {
    if (r == 95) { w_puts("gpuwedge: arm OK (exit 95)", 26); return 95; }
    if (r == 0 - 1) {
        w_puts("gpuwedge: refused -- no GPU, or this kernel lacks GPU_RECOVER.", 61);
        w_puts("gpuwedge: the wedge arms are COMPILED OUT without that flag, by design:", 70);
        w_puts("gpuwedge: a production kernel must not be able to hang its own GPU.", 66);
        return 96;
    }
    if (r == 0 - 2) {
        w_puts("gpuwedge: ARM A FAILED -- the wedge RETIRED instead of hanging.", 62);
        w_puts("gpuwedge: nothing was hung, so arms B-E would prove NOTHING. Stop here.", 70);
        return 90;
    }
    if (r == 0 - 3) {
        w_puts("gpuwedge: ARM C FAILED -- matmul NOT bit-correct.", 48);
        w_puts("gpuwedge: recovery is WORSE THAN THE HANG. R-4 must be the default.", 66);
        return 89;
    }
    if (r == 0 - 4) {
        w_puts("gpuwedge: ARM B -- the ladder reached R-4 and gave up.", 53);
        w_puts("gpuwedge: that is a RESULT, not a crash: check the panel and the shell.", 70);
        w_puts("gpuwedge: if both are alive, R-4's degradation works and Phase III is", 68);
        w_puts("gpuwedge: survivable; if the console died, it is NOT, and that one fact", 70);
        w_puts("gpuwedge: settles the whole GFX-ring question. Run --console next.", 65);
        return 91;
    }
    w_puts("gpuwedge: unexpected return ", 28); w_num(r); print("\n", 1);
    return 97;
}

fn main(): i64 {
    args_init();
    if (argc() >= 2) {
        var a = argv(1);
        if (streq(a, "--baseline") == 1) {
            w_puts("gpuwedge: ARM C (BEFORE) -- establishing the bit-correct baseline", 64);
            return report(ARM_C, recover_op(ARM_C));
        }
        if (streq(a, "--wedge") == 1) {
            w_puts("gpuwedge: ARM A -- WEDGING THE GPU ON PURPOSE.", 45);
            w_puts("gpuwedge: the panel may go dark. That is the experiment, not a fault.", 68);
            w_puts("gpuwedge: the ORACLE is the forensic bracket in the log, not this exit.", 70);
            return report(ARM_A, recover_op(ARM_A));
        }
        if (streq(a, "--recover") == 1) {
            w_puts("gpuwedge: ARM B -- dequeue + re-map", 34);
            return report(ARM_B, recover_op(ARM_B));
        }
        if (streq(a, "--verify") == 1) {
            w_puts("gpuwedge: ARM C (AFTER) -- matmul must STILL be bit-correct", 58);
            return report(ARM_C, recover_op(ARM_C));
        }
        if (streq(a, "--console") == 1) {
            w_puts("gpuwedge: ARM D -- console survival while the GPU is wedged", 58);
            return report(ARM_D, recover_op(ARM_D));
        }
        # ⛔ An unknown argument is an ERROR, never a default action. A tool that silently does
        # something other than what was asked is how a typo becomes a wasted burn -- the exact
        # failure that cost the M9 arc a flash on 2026-07-24.
        w_puts("gpuwedge: UNKNOWN ARGUMENT -- nothing was done.", 46);
        w_puts("gpuwedge: --baseline --wedge --recover --verify --console", 56);
        return 84;
    }
    w_puts("gpuwedge -- RUNG 5, the GPU hang/recovery battery", 48);
    w_puts("", 0);
    w_puts("⚠ NO ARGUMENTS SEEN -- nothing was done. This tool never acts by default:", 72);
    w_puts("  one of its arms deliberately hangs the GPU.", 44);
    w_puts("", 0);
    w_puts("Run IN THIS ORDER, one boot:", 27);
    w_puts("  run /bin/gpuwedge --baseline    C before -- the baseline", 57);
    w_puts("  run /bin/gpuwedge --wedge       A        -- the bracket is the oracle", 70);
    w_puts("  run /bin/gpuwedge --recover     B        -- CP_HQD_ACTIVE must read 0", 70);
    w_puts("  run /bin/gpuwedge --verify      C after  -- still bit-correct?", 63);
    w_puts("  run /bin/gpuwedge --console     D        -- did the console survive?", 69);
    w_puts("  run /bin/klug > /wedge.txt", 27);
    return 96;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
