# triref.cyr — thin runner for the reference + corpus. The substance is in tricore.cyr, which is
# an includable module; this file exists only to give it a main() and an exit code.
# ⚠ Consumers (trimodel.cyr) must include TRICORE, never this file — including a program that has
# its own main() shadows the includer's main and Cyrius only warns.

include "lib/io.cyr"
include "tricore.cyr"

fn main(): i64 {
    ps("triref -- CPU reference for barycentric RGBA attribute interpolation"); nl();
    var fail = tr_selftest();
    tc_init();
    var abad = tc_audit();
    if (abad != 0) { ps("triref: corpus AUDIT failed, "); pn(abad); ps(" problem(s)"); nl(); }
    fail = fail + abad;
    ps("corpus:"); nl();
    fail = fail + tc_run();
    if (fail != 0) {
        ps("triref: "); pn(fail); ps(" FAILURES"); nl();
        return 1;
    }
    ps("triref: all arms green -- vertex reproduction, x/y variation, premul invariant,"); nl();
    ps("        src-over endpoints, degenerate-frame refusal, recip32 domain, and a"); nl();
    ps("        self-audited corpus whose reject arm fires."); nl();
    ps("⇒ This is the oracle. The shader model is measured against it, not beside it."); nl();
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
