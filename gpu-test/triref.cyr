# triref.cyr — thin runner for the reference + corpus. The substance is in tricore.cyr, which is
# an includable module; this file exists only to give it a main() and an exit code.
# ⚠ Consumers (trimodel.cyr) must include TRICORE, never this file — including a program that has
# its own main() shadows the includer's main and Cyrius only warns.

include "lib/io.cyr"
include "tricore.cyr"

var tp_scratch[2048];           # 64*64*4 = 16384 B = 2048 u64 slots (measured sizing)
fn ph8(v): i64 {
    var d = 28;
    while (d >= 0) {
        var nib = (v >> d) & 0xF;
        if (nib < 10) { print("0123456789" + nib, 1); }
        if (nib >= 10) { print("abcdef" + (nib - 10), 1); }
        d = d - 4;
    }
    return 0;
}

fn main(): i64 {
    ps("triref -- CPU reference for barycentric RGBA attribute interpolation"); nl();
    var fail = tr_selftest();
    tc_init();
    var abad = tc_audit();
    if (abad != 0) { ps("triref: corpus AUDIT failed, "); pn(abad); ps(" problem(s)"); nl(); }
    fail = fail + abad;
    # The kernel prints its own copy of this record during the QEMU ABI battery; the two are
    # diffed field by field. Corpus case 0's frame, so both sides use identical inputs.
    tri_prep(0, 0, 256, 0, 0, 256, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF);
    tr_prep_dump();
    # ⭐ N16's host side. gputri prints the same number on the GPU box; they MUST match, and a
    # mismatch indicts the COMPILER (an --agnos codegen divergence moving both the reference and
    # the comparison together) rather than the shader.
    ps("triref: N16 corpus digest 0x"); ph8(tc_corpus_digest(&tp_scratch, 64, 64)); nl();
    ps("corpus:"); nl();
    fail = fail + tc_run();
    if (fail != 0) {
        ps("triref: "); pn(fail); ps(" FAILURES"); nl();
        return 1;
    }
    ps("triref: all arms green -- vertex reproduction, x/y variation, premul invariant,"); nl();
    ps("        src-over endpoints, degenerate-frame refusal, recip32 domain, and a"); nl();
    ps("        self-audited corpus whose reject arm fires."); nl();
    ps("⇒ This is the oracle. The shader model is measured against it, not beside it."); nl();
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
