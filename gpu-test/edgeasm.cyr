fn bc_emit(): i64 {
    var p = 0;
    p = e_sop2(p, 0x1C, 10, S(8), K(6));
    p = e_vop2(p, 0x34, 12, S(10), 0);
    p = e_vopc(p, 0xCC, S(6), 12);
    p = e_sop1(p, 0x20, 20, VCC);
    p = e_sop2(p, 0x24, 11, S(9), S(4));
    p = e_sop2(p, 0x00, 11, S(11), S(10));
    p = e_sop2(p, 0x00, 12, S(0), S(11));
    p = e_sop2(p, 0x04, 13, S(1), K(0));
    p = e_sop2(p, 0x1C, 14, S(8), K(8));
    p = e_sop2(p, 0x24, 15, S(9), S(5));
    p = e_sop2(p, 0x00, 15, S(15), S(14));
    p = e_sop2(p, 0x00, 16, S(2), S(15));
    p = e_sop2(p, 0x04, 17, S(3), K(0));
    p = e_vop1(p, 0x01, 4, S(12));
    p = e_vop1(p, 0x01, 5, S(13));
    p = e_vop2(p, 0x19, 4, V(4), 0);
    p = e_vop2(p, 0x1C, 5, K(0), 5);
    p = e_flat(p, 0x10, 0, 2, 0, 4, 0);
    p = e_vop2(p, 0x12, 1, K(2), 0);
    p = e_vop1(p, 0x01, 6, S(16));
    p = e_vop1(p, 0x01, 7, S(17));
    p = e_vop2(p, 0x19, 6, V(6), 1);
    p = e_vop2(p, 0x1C, 7, K(0), 7);
    p = e_flat(p, 0x14, 0, 3, 0, 6, 0);
    p = e_sopp(p, 0x0C, 3952);
    p = e_sop1_lit(p, 0x00, 24, 0x3B808081);
    p = e_vop1(p, 0x11, 8, V(2));
    p = e_vop2(p, 0x05, 8, S(24), 8);
    p = e_sop1_lit(p, 0x00, 25, 0xBB808081);
    p = e_vop1(p, 0x14, 9, S(7));
    p = e_vop2(p, 0x05, 9, V(9), 8);
    p = e_vop3(p, 0x1CB, 10, V(9), S(25), F1);
    p = e_vop1(p, 0x11, 13, S(7));
    p = e_vop2(p, 0x05, 13, V(13), 8);
    p = e_vop1(p, 0x11, 14, V(3));
    p = e_vop3(p, 0x1CB, 13, V(14), V(10), V(13));
    p = e_vop3(p, 0x1DD, 11, V(13), K(0), V(11));
    p = e_vop1(p, 0x12, 13, S(7));
    p = e_vop2(p, 0x05, 13, V(13), 8);
    p = e_vop1(p, 0x12, 14, V(3));
    p = e_vop3(p, 0x1CB, 13, V(14), V(10), V(13));
    p = e_vop3(p, 0x1DD, 11, V(13), K(1), V(11));
