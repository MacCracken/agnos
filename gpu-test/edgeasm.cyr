    p = e_vop2(p, 0x00, 7, V(7), 49);
    p = e_vop2(p, 0x14, 8, V(8), 48);
    p = e_sop2(p, 0x00, 14, S(14), K(1));
    p = e_sopc(p, 0x0A, S(14), S(4));
    p = ea_branch(p, 0x05, 1);   # s_cbranch_scc1
    p = e_vopc(p, 0xCD, K(0), 8);
    p = e_sop2(p, 0x0D, 106, VCC, EXEC_LO);
    p = ea_branch(p, 0x06, 2);   # s_cbranch_vccz
    p = e_vop2(p, 0x0C, 50, V(7), 3);
    p = e_vop2(p, 0x35, 51, V(50), 5);
    p = e_vop2(p, 0x10, 51, K(2), 51);
    p = e_vopc(p, 0xCD, K(0), 6);
    p = e_vop2(p, 0x00, 51, K(0), 51);
    p = e_vopc(p, 0xCD, K(0), 8);
    p = e_vop2(p, 0x00, 51, K(0), 51);
    p = e_vop2(p, 0x34, 4, V(4), 51);
    p = e_vop1(p, 0x01, 5, V(50));
    p = e_vopc(p, 0xC1, V(5), 3);
    p = e_sop2(p, 0x0D, 106, VCC, EXEC_LO);
    p = ea_branch(p, 0x07, 3);   # s_cbranch_vccnz
    p = ea_label(p, 2);
    p = e_sop2(p, 0x00, 12, S(12), K(1));
    p = e_sopc(p, 0x0A, S(12), K(4));
    p = ea_branch(p, 0x05, 4);   # s_cbranch_scc1
    p = e_vop1_lit(p, 0x01, 52, 0x00010000);
    p = e_vop2(p, 0x0E, 4, V(4), 52);
    p = e_vop2(p, 0x12, 53, K(8), 4);
    p = e_vop2(p, 0x35, 53, V(53), 4);
    p = e_vop2(p, 0x10, 53, K(16), 53);
    p = e_sop2(p, 0x24, 16, S(9), S(6));
    p = e_vop1(p, 0x01, 54, S(2));
    p = e_vop1(p, 0x01, 55, S(3));
    p = e_vop3b(p, 0x119, 106, 54, V(54), S(16), S(0));
    p = e_vop2(p, 0x1C, 55, K(0), 55);
    p = e_vop2(p, 0x19, 54, V(54), 1);
    p = e_vop2(p, 0x1C, 55, K(0), 55);
    p = e_flat(p, 0x18, 1, 0, 53, 54, 0);
    p = e_sopp(p, 0x0C, 3952);
    p = ea_label(p, 0);
    p = e_sopp(p, 0x01, 0);
    if (ea_fixup() != 1) { return 0 - 1; }
    return p;
}

fn blob_check(name, nlen, n, emitted): i64 {
    if (emitted < 0) { ps("  ** "); print(name, nlen); puts("  FIXUP FAILED"); return 0; }
    if (emitted / 4 != n) {
        ps("  ** "); print(name, nlen); ps("  emitted "); pnum(emitted / 4);
        ps(" dwords, llvm-mc says "); pnum(n); nl();
        return 0;
    }
    var bad = 0;
    var i = 0;
    while (i < n) {
        var got = load32(&isa + i * 4) & 0xFFFFFFFF;
        var wnt = load64(&want + i * 8);
        if (got != wnt) {
            bad = bad + 1;
            if (bad < 6) {
                ps("  ** "); print(name, nlen); ps(" dword "); pnum(i);
                ps("  llvm-mc "); phex(wnt); ps("  edgeasm "); phex(got); nl();
            }
        }
        i = i + 1;
    }
    ps("  "); print(name, nlen); ps("  "); pnum(n - bad); ps(" of "); pnum(n);
    if (bad == 0) { puts(" byte-identical"); return 1; }
    puts(" MATCH -- DISAGREEMENT"); return 0;
}

fn main(): i64 {
    puts("edgeasm -- RUNG 9b BITE B4: the authoring tool, calibrated on a shipped shader");
    puts("=============================================================================");
    var ok = 1;

    # ---- GATE 1: re-emit blend_cov byte-identically ---------------------------------------
    puts("[gate 1] re-emit blend_cov's 67 SHIPPED, IRON-PROVEN dwords");
    bc_expected();
    var n = bc_emit() / 4;
    if (ea_fault != 0) { puts("  ** an asserting wrapper REFUSED during emission"); ok = 0; }
    if (n != 67) {
        ps("  ** emitted "); pnum(n); puts(" dwords, expected 67");
        ok = 0;
    }
    var bad = 0;
    var i = 0;
    while (i < 67) {
        var got = load32(&isa + i * 4) & 0xFFFFFFFF;
        var wnt = load64(&bc_want + i * 8);
        if (got != wnt) {
            bad = bad + 1;
            if (bad < 6) {
                ps("  ** dword "); pnum(i); ps("  want "); phex(wnt); ps("  got "); phex(got); nl();
            }
        }
        i = i + 1;
    }
    if (bad == 0) { puts("  -> 67 of 67 byte-identical"); }
    if (bad != 0) {
        ps("  -> "); pnum(bad); puts(" of 67 DIFFER");
        puts("  ** The tool cannot reproduce a known-good shader. It must not emit a new one.");
        ok = 0;
    }

    # ---- GATE 2: the label/fixup pass ------------------------------------------------------
    # A backward branch, a forward branch, and the two refusals that matter.
    puts("[gate 2] the label/fixup pass");
    ea_labels_reset();
    ea_fault = 0;
    var p = 0;
    p = ea_label(p, 0);                                  # L0 at byte 0
    p = e_sopp(p, 0x00, 0);                              # s_nop
    p = e_sopp(p, 0x00, 0);
    p = ea_branch(p, 0x02, 0);                           # s_cbranch_scc1 BACK to L0
    var fwd = p;
    p = ea_branch(p, 0x02, 1);                           # forward to L1
    p = e_sopp(p, 0x00, 0);
    p = ea_label(p, 1);
    if (ea_fixup() != 1) { puts("  ** fixup FAILED"); ok = 0; }
    # backward branch at byte 8 -> target 0: simm = (0 - 12)/4 = -3 -> 0xFFFD
    var b0 = load32(&isa + 8) & 0xFFFF;
    if (b0 != 65533) { ps("  ** backward simm16 want 65533 got "); pnum(b0); nl(); ok = 0; }
    # forward branch at byte 12 -> target 20: simm = (20 - 16)/4 = 1
    var b1 = load32(&isa + fwd) & 0xFFFF;
    if (b1 != 1) { ps("  ** forward simm16 want 1 got "); pnum(b1); nl(); ok = 0; }
    if (ea_fault != 0) { puts("  ** a wrapper refused during a VALID sequence"); ok = 0; }
    if (ok == 1) { puts("  -> backward -3 and forward +1 both resolved"); }

    # ---- GATE 3: the refusals must actually refuse ------------------------------------------
    # ⛔ Every wrapper here exists to turn a SILENT mis-encoding loud. If a refusal does not
    # fire, the wrapper is decoration and mabda's unvalidated packer is what actually ships.
    puts("[gate 3] the refusals fire");
    var r = 0;
    ea_fault = 0; V(300);            if (ea_fault == 1) { r = r + 1; }
    ea_fault = 0; S(200);            if (ea_fault == 1) { r = r + 1; }
    ea_fault = 0; K(1000);           if (ea_fault == 1) { r = r + 1; }
    ea_fault = 0; e_vop3(0, 0x285, 1, LIT, V(2), V(3));  if (ea_fault == 1) { r = r + 1; }
    ea_fault = 0; ea_labels_reset(); ea_label(0, 3); ea_label(4, 3); if (ea_fault == 1) { r = r + 1; }
    ea_fault = 0; ea_labels_reset(); ea_branch(0, 0x02, 7); if (ea_fixup() == 0) { r = r + 1; }
    # ⭐ THE simm16 RANGE CHECK. Added because the mutation that DELETED it passed: no ordinary
    # case can produce an out-of-range offset (the ISA buffer is 8 KB and simm16 spans 128 KB of
    # branch distance), so the check was shipping untested. The label position is set DIRECTLY
    # rather than by emitting 32k dwords — the arithmetic is what is under test, not the buffer.
    # ⛔ An unchecked overflow would WRAP and branch somewhere plausible: a wrong picture, never
    # a fault, which is the entire failure class this tool exists to eliminate.
    # ⛔ THE DANGEROUS SHAPE: patch site outside the buffer while the OFFSET IS IN RANGE. Both
    # br and tgt at 200000 give simm = -1, so the simm16 check passes and only the bounds check
    # stands between ea_fixup and a write 192 KB past the end of `isa`. Found by mutation: the
    # first version of this case had tgt = 0, which made simm = -50001 and was caught by the
    # RANGE check instead — so deleting the bounds check still passed, and the SIGSEGV it
    # protects against was one in-range offset away.
    ea_fault = 0; ea_labels_reset();
    store64(&lab_off + 6 * 8, 200000);
    store64(&patch_off + 0 * 8, 200000); store64(&patch_tgt + 0 * 8, 6); n_patch = 1;
    if (ea_fixup() == 0) { r = r + 1; }                 # patch site outside the ISA buffer
    # The simm16 bound, tested on the ARITHMETIC directly -- see ea_simm_ok's header for why it
    # cannot be reached through ea_fixup at an 8 KB buffer size.
    if (ea_simm_ok(0, 200000) == 0) { r = r + 1; }      # +49999 dwords
    if (ea_simm_ok(200000, 0) == 0) { r = r + 1; }      # -50001 dwords
    if (ea_simm_ok(0, 131068) == 1) { r = r + 1; }      # +32767 EXACTLY -- must be ACCEPTED
    ea_fault = 0;
    ps("  -> "); pnum(r); puts(" of 10 refusals fired");
    if (r != 10) {
        puts("  ** a wrapper that does not refuse is decoration -- mabda's packer ships instead.");
        ok = 0;
    }

    # ---- GATE 4 (B6): the two rung-9b blobs vs llvm-mc ------------------------------------
    puts("[gate 4] the two 9b blobs, edgeasm vs llvm-mc on the SAME source");
    ea_fault = 0;
    setup_want();
    ea_vgpr_reset();
    if (blob_check("edge_setup", 10, 58, setup_emit()) == 0) { ok = 0; }
    # ⚠ edge_setup and edge_cov SHARE RSRC1 (0x002C00CD, 56 VGPRs) -- that shared descriptor is what
    # lets the shipped dispatcher run both unmodified. So both are checked against 56.
    if (ea_vgpr_check(56, "edge_setup") == 0) { ok = 0; }
    var setup_hi = ea_vgpr_max;
    cov_want();
    ea_vgpr_reset();
    if (blob_check("edge_cov  ", 10, 135, cov_emit()) == 0) { ok = 0; }
    if (ea_vgpr_check(56, "edge_cov") == 0) { ok = 0; }
    if (ea_fault != 0) { puts("  ** an asserting wrapper REFUSED while emitting a 9b blob"); ok = 0; }

    # ---- GATE 5: the VGPR high-water gate itself ------------------------------------------
    # ⭐ A gate that cannot fail is not a gate, and this one guards a value with NO hardware
    # oracle: RSRC1 is not GRBM-readable, so nothing on the machine can contradict a wrong
    # declaration. Prove it fires by asking it to accept a deliberately impossible budget.
    puts("[gate 5] the VGPR high-water gate must REFUSE an under-declaration");
    ps("  edge_setup uses up to v"); pnum(setup_hi);
    ps(", edge_cov up to v"); pnum(ea_vgpr_max);
    puts(" (both declare 56)");
    var saved = ea_fault;
    ea_fault = 0;
    var fired = 0;
    if (ea_vgpr_check(1, "MUTANT") == 0) { fired = 1; }
    ea_fault = saved;
    if (fired == 0) {
        puts("  ** the gate ACCEPTED a 1-VGPR declaration for a blob using dozens --");
        puts("  ** it is decoration and no later bite may cite it");
        ok = 0;
    }
    if (fired == 1) { puts("  the gate refuses a 1-VGPR declaration, as it must"); }

    puts("");
    if (ok == 0) { puts("** B4 FAILED. The tool is not trustworthy; do not author with it."); return 90; }
    puts("B4 PASS -- the tool reproduces a shipped iron-proven shader byte-for-byte,");
    puts("resolves forward and backward branches, and refuses every silent mis-encoding");
    puts("mabda's pure bit-packers would otherwise let through.");
    return 95;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
