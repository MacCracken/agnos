# ============================================================================================
# tri_emit — the SOVEREIGN re-emission of tri_rgba, instruction by instruction
# ============================================================================================
# ⛔ THIS IS THE SECOND ASSEMBLER, AND THAT IS ITS ENTIRE PURPOSE. llvm-mc produced tri_want()
# above; this reproduces the same 269 dwords through mabda's encoder and this file's asserting
# wrappers. Agreement means two independent toolchains derived the same machine code from the same
# intent — so a red hardware run indicts the ALGORITHM or the DISPATCH, not a mis-encoded operand.
# A blob verified by one assembler has not met the tree's bar (see gpu.cyr above edge_setup_write).
#
# ⚠ AUTHORED IN SECTIONS, each byte-diffed as it lands. The shader is 269 dwords; emitting all of
# it before checking any of it would mean a single wrong operand shows up as "N dwords differ" with
# no locality. tri_emit_upto() reports how far the two agree, so a divergence names its own
# instruction.
var TRI_N_TOTAL = 269;

fn tri_emit(): i64 {
    ea_labels_reset();
    var p = 0;

    # ---- prologue: bounds guard, coverage fetch, per-lane zero-coverage exit ---------------
    p = e_sop1(p, 0x01, 126, K(0 - 1));          # [  0] s_mov_b64 exec, -1
    p = e_sop2(p, 0x1C, 10, S(8), K(6));         # [  1] s_lshl_b32 s10, s8, 6
    p = e_vop2(p, 0x34, 1, S(10), 0);            # [  2] v_add_u32 v1, s10, v0
    p = e_vopc(p, 0xCC, S(6), 1);                # [  3] v_cmp_gt_u32 vcc, s6, v1
    p = e_sop1(p, 0x20, 20, VCC);                # [  4] s_and_saveexec_b64 s[20:21], vcc
    p = ea_branch(p, 0x08, 0);                   # [  5] s_cbranch_execz L_END
    p = e_smem(p, 0x02, 12, 0, 0x0);             # [  6] s_load_dwordx4 s[12:15], s[0:1], 0x0
    p = e_sopp(p, 0x0C, 0xC07F);                 # [  8] s_waitcnt lgkmcnt(0)
    p = e_sop2(p, 0x24, 11, S(9), S(6));         # [  9] s_mul_i32 s11, s9, s6
    p = e_vop2(p, 0x34, 2, S(11), 1);            # [ 10] v_add_u32_e32 v2, s11, v1
    p = e_vop2(p, 0x19, 2, S(12), 2);            # [ 11] v_add_co_u32_e32 v2, vcc, s12, v2
    p = e_vop1(p, 0x01, 3, S(13));               # [ 12] v_mov_b32_e32 v3, s13
    p = e_vop2(p, 0x1C, 3, K(0), 3);             # [ 13] v_addc_co_u32_e32 v3, vcc, 0, v3, vcc
    p = e_flat(p, 0x10, 0, 4, 0, 2, 0);          # [ 14] global_load_ubyte v4, v[2:3], off
    p = e_sopp(p, 0x0C, 0x0F70);                 # [ 16] s_waitcnt vmcnt(0)
    p = e_vopc(p, 0xCD, K(0), 4);                # [ 17] v_cmp_ne_u32_e32 vcc, 0, v4
    p = e_sop1(p, 0x20, 22, VCC);                # [ 18] s_and_saveexec_b64 s[22:23], vcc
    p = ea_branch(p, 0x08, 0);                   # [ 19] s_cbranch_execz L_END
    p = e_smem(p, 0x02, 24, 0, 0x10);            # [ 20] s_load_dwordx4 s[24:27], s[0:1], 0x10
    p = e_smem(p, 0x02, 28, 0, 0x20);            # [ 22] s_load_dwordx4 s[28:31], s[0:1], 0x20
    p = e_smem(p, 0x02, 32, 0, 0x30);            # [ 24] s_load_dwordx4 s[32:35], s[0:1], 0x30
