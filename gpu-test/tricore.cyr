# tricore.cyr — the barycentric attribute-interpolation REFERENCE and corpus, as an INCLUDABLE
# MODULE. No main(), no _entry(), no top-level call.
#
# ⛔ WHY THE SPLIT EXISTS. This started as one file, triref.cyr, that was both the reference AND a
# runnable program. The moment trimodel.cyr included it to diff against, Cyrius reported
# `duplicate fn 'main' (last definition wins)` as a WARNING, kept triref's main, and executed
# triref's top-level `_entry();` — so the model's gates never ran and the run still exited 0.
# A silent last-def-wins on `main` is the same shadowing hazard refraster.cyr's header warns
# about, one level up. [[reference_cyrius_duplicate_fn_shadow]]
# ⚠ NOTHING IN THIS FILE MAY DEFINE main/_entry OR CALL ANYTHING AT TOP LEVEL.

# triref.cyr — THE CPU reference for barycentric RGBA attribute interpolation.
#
# ============================================================================================
# WHAT THIS IS, AND WHAT IT IS NOT
# ============================================================================================
# This is the ORACLE for the attribute-interpolation rung: exact integer barycentric
# interpolation of per-vertex premultiplied RGBA, then integer src-over. It computes the answer
# the GPU kernel must reproduce BYTE-IDENTICALLY.
#
# ⭐ IT IS DELIBERATELY NOT WRITTEN THE WAY THE SHADER IS. The shader is constrained to 32-bit
# registers and hoists a reciprocal so it never divides per pixel. The reference divides, in
# plain i64, because its job is to be OBVIOUSLY correct rather than fast. The shader model
# (trimodel.cyr) is the artifact that carries the shader's register widths; that split is the
# whole point — if the reference imitated the shader's arithmetic, a shared misunderstanding
# would pass both and neither would be an oracle.
#
# ⛔ INCLUDES refraster.cyr, NEVER re-transcribes it. Coverage geometry comes from the existing
# rasteriser. Copying its edge machinery here would recreate the exact defect refraster.cyr was
# extracted to kill — the same routine in several files with nothing enforcing agreement, and
# Cyrius shadowing duplicate `fn`s silently and warn-only.

include "lib/io.cyr"
include "refraster.cyr"

# print(s, len) is the real signature; these are the same helpers edgemodel.cyr uses.
# ⚠ slen is NOT in this project's stdlib set — the build fails with "refusing to emit binary with
# 1 reachable undefined function(s)", which is a REFUSAL, not a link warning to skim past. The
# first run of this file read a STALE binary from the previous successful build and reported
# failures that had already been fixed.
fn slen(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
fn ps(s): i64 { print(s, slen(s)); return 0; }
fn nl(): i64 { print("\n", 1); return 0; }
fn pn(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var b[24];
    var neg = 0;
    var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var i = 0;
    while (x > 0) { store8(&b + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&b + i, 1); }
    return 0;
}

# ============================================================================================
# THE PREP RECORD, host side
# ============================================================================================
# The shader reads a 128-byte record of packed u32s. The reference keeps the same FIELDS but in
# i64 slots, because it never has to fit them in a VGPR. Field names match the plan's record so
# the two can be diffed field-by-field rather than by eye.
#
# ⚠ Module-scope `var X[N]` is N x u64 in an INCLUDED module but N BYTES in a top-level program.
# This file is a top-level program, so these are BYTE counts unless read through the accessors
# below. [[feedback_cyrius_var_array_u64_units]] — the latent fatal that hid in the rung-9
# oracle was exactly this, and it was IN THE ORACLE, which is the worst place for it.
var TP_N = 24;                  # i64 slots per prep record
# ⚠ 192 slots is generous, not required. An earlier comment here claimed `var tp[24]` was an
# 88-byte overrun; that was WRONG and is corrected rather than left standing, because a comment
# asserting a trap that does not exist teaches the wrong rule. MEASURED in this directory: a
# module-scope `var X[N]` in a top-level program allocates N x u64, so `tp[24]` was 192 bytes and
# held its 24 slots correctly. The real defect that run was the fixed-point scaling, two functions
# below. The sizing rule IS non-uniform across file contexts — the standing instruction is to
# measure it per file rather than recall it. [[feedback_cyrius_var_array_u64_units]]
var tp[192];                    # single record; the corpus drives one at a time

var TP_T      = 0;              # shift t, in [10, 31]
var TP_DH     = 1;              # (D255 >> t) + 1
var TP_V      = 2;              # recip32(Dh << L)
var TP_L      = 3;              # clz32(Dh), in {1, 2}
var TP_A2     = 4;              # 2A, signed-normalised positive
var TP_D255   = 5;              # 255 * 2A
var TP_KXB    = 6;
var TP_KYB    = 7;
var TP_K0B    = 8;
var TP_KXC    = 9;
var TP_KYC    = 10;
var TP_K0C    = 11;
var TP_CA     = 12;             # packed premultiplied ARGB per vertex
var TP_CB     = 13;
var TP_CC     = 14;

fn tp_get(i): i64 { return load64(&tp + i * 8); }
fn tp_set(i, v): i64 { store64(&tp + i * 8, v); return 0; }

# ============================================================================================
# bitlen64 — position of the highest set bit, 1-based. 0 for zero.
# ============================================================================================
# ⚠ `>>` is LOGICAL in Cyrius (zero-fill) and `>>>` is ARITHMETIC — inverted from C and Java.
# [[reference_cyrius_shift_right_is_logical]]. This wants LOGICAL, so `>>` is correct here; a
# `>>>` on a value with bit 63 set would spin forever.
fn bitlen64(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) { v = v >> 1; n = n + 1; }
    return n;
}

# ============================================================================================
# THE PROLOGUE — everything that is constant per record
# ============================================================================================
# Mirrors the plan's CPU prologue exactly. Returns 1 on success, 0 if the frame is degenerate.
#
# ⭐ WHY THERE IS NO PER-PIXEL DIVIDE TO HOIST AWAY FROM: the three edge functions at a sample
# point ARE the unnormalised barycentric weights, and E_A + E_B + E_C == 2A identically for
# every point — an algebraic identity, not an approximation. So all four channels share ONE
# denominator, and the naive "3 weights x 4 channels = 12 quotients" is never built.
fn tri_prep(ax_px, ay_px, bx_px, by_px, cx_px, cy_px, ca, cb, cc): i64 {
    var i = 0;
    while (i < TP_N) { tp_set(i, 0); i = i + 1; }

    # ⛔ ONLY THE SAMPLE POINT IS 16.16 — THE VERTICES STAY IN PIXELS. The sample point is
    # (px << 16) + 32768, so kx/ky multiply a 16.16 value and are themselves plain pixel deltas;
    # only the CONSTANT term k0, which multiplies nothing, carries the << 16 to reach the same
    # units. 2A likewise.
    # ⚠ THE FIRST VERSION LIFTED THE VERTICES INSTEAD, and the cost was not a wrong picture but a
    # SILENT i64 OVERFLOW. With vertices at 16.16 a 256x256 frame gives 2A = 2^48, so the alpha
    # numerator 65025 * 2A = 1.83e19 exceeds i64's 9.22e18 — it wrapped, and the symptom was a
    # pixel that came back 0 including its alpha, which reads like a dead barycentric rather than
    # like arithmetic running out of room. Keeping vertices in pixels puts 2A at 2^32 and the
    # numerator at 2.8e14, four orders inside the type.
    var ax = ax_px;  var ay = ay_px;
    var bx = bx_px;  var by = by_px;
    var cx = cx_px;  var cy = cy_px;

    # 2A = cross(B-A, C-A). Sign-normalise: if negative, negate the whole coefficient triple so
    # the denominator is positive and the quotient path never sees a signed divisor.
    var a2 = ((bx - ax) * (cy - ay) - (by - ay) * (cx - ax)) << 16;
    if (a2 == 0) { return 0; }                  # degenerate frame — no affine basis exists
    var sgn = 1;
    if (a2 < 0) { sgn = 0 - 1; a2 = 0 - a2; }

    # Edge functions for B and C as kx*Px + ky*Py + k0. E_A is DERIVED as 2A - E_B - E_C, which is
    # why only two are stored.
    #
    # ⛔ THE SIGNS ARE NOT A CONVENTION YOU MAY PICK. Expand the weight definitions and take what
    # falls out:
    #     lambda_B = cross(P-A, C-A) / 2A
    #             => E_B = Px*(cy-ay) + Py*(ax-cx) + (ay*cx - ax*cy)
    #     lambda_C = cross(B-A, P-A) / 2A
    #             => E_C = Px*(ay-by) + Py*(bx-ax) + (ax*by - ay*bx)
    # The first version of this file had every one of those six terms NEGATED. The effect is total
    # rather than subtle — E_B and E_C come out negative everywhere INSIDE the frame, the
    # clamp-at-zero then flattens them, and the output is black with no variation in x or y.
    # ⭐ Which is exactly what the vertex-reproduction and x/y-variation arms below reported. A
    # flat-colour test would have passed this happily; that is why flat colour is a CONTROL here
    # and never a gate.
    var kxb = sgn * (cy - ay);
    var kyb = sgn * (ax - cx);
    var k0b = sgn * ((ay * cx - ax * cy) << 16);
    var kxc = sgn * (ay - by);
    var kyc = sgn * (bx - ax);
    var k0c = sgn * ((ax * by - ay * bx) << 16);

    var d255 = 255 * a2;
    # ⛔ THE PLAN'S "t IS IN [10, 31]" IS WRONG AT BOTH ENDS, and the corpus is what forced the
    # issue. t exists for ONE reason: to normalise dh into recip32's domain. Measured against the
    # ABI's real limits it does not land in [10,31]:
    #   * UPPER — edge coordinates are bounded at +-2^28 in 16.16, i.e. 4096 px, so the largest
    #     legal cross product is ~2^24 and 2A ~ 2^40. bitlen(255 * 2A) ~ 48, giving t ~ 18.
    #     t = 31 is NOT CONSTRUCTIBLE, so the plan's "2A just below AREA_MAX => t = 31" case
    #     cannot be written and no corpus entry claims it.
    #   * LOWER — t >= 10 needs 2A >= 2.16e9, i.e. an area above ~16500 px^2. Every triangle
    #     smaller than roughly 128x128 lands BELOW 10, and the old `if (t < 10) return 0` refused
    #     them as degenerate. Small triangles are the common case, not the exotic one.
    # A negative t would also make `d255 >> t` meaningless. Clamping at 0 is exactly right: when
    # d255 already fits in 30 bits there is nothing to normalise away.
    var t = bitlen64(d255) - 30;
    if (t < 0) { t = 0; }
    var dh = (d255 >> t) + 1;                   # +1 makes the later correction ONE-SIDED
    var l = clz32(dh);
    # ⚠ L is NOT confined to {1,2} either — that also assumed the narrow range. For small frames
    # dh keeps more of its bits and needs a longer shift. What must hold is the thing recip32
    # actually depends on: dh << L lands in [2^31, 2^32). Assert THAT, not a range of L.
    var dn = u32(dh << l);
    if (dn < 2147483648) { return 0; }
    var v = recip32(dn);

    tp_set(TP_T, t);      tp_set(TP_DH, dh);   tp_set(TP_V, v);    tp_set(TP_L, l);
    tp_set(TP_A2, a2);    tp_set(TP_D255, d255);
    tp_set(TP_KXB, kxb);  tp_set(TP_KYB, kyb); tp_set(TP_K0B, k0b);
    tp_set(TP_KXC, kxc);  tp_set(TP_KYC, kyc); tp_set(TP_K0C, k0c);
    tp_set(TP_CA, ca);    tp_set(TP_CB, cb);   tp_set(TP_CC, cc);
    return 1;
}

# ============================================================================================
# tri_ref_px — THE reference answer for one pixel
# ============================================================================================
# cov is the 8bpp coverage byte for this pixel (0..255); dst is the existing destination pixel.
# Returns the blended destination pixel.
#
# ⚠ COLOUR IS POINT-SAMPLED AT THE PIXEL CENTRE while coverage is AREA-integrated by the
# rasteriser. That is standard and visually correct, but it means the output is NOT "the average
# colour over the covered area" and no later oracle may assume it is. For a one-pixel sliver the
# centre can lie outside the shape entirely, which is what the ratio bound and the output clamps
# are for.
var tr_corr_hits = 0;        # N13: quotients where the exact rounding carried into the next level
var tr_premul_hits = 0;      # N14: channels clamped down to alpha by the premultiplied restore

fn tri_ref_px(px, py, cov, dst): i64 {
    if (cov == 0) { return dst; }

    # Sample at the pixel CENTRE in 16.16, matching the shader's Pcx/Pcy.
    var pcx = (px << 16) + 32768;
    var pcy = (py << 16) + 32768;

    var eb = tp_get(TP_KXB) * pcx + tp_get(TP_KYB) * pcy + tp_get(TP_K0B);
    var ec = tp_get(TP_KXC) * pcx + tp_get(TP_KYC) * pcy + tp_get(TP_K0C);
    var ea = tp_get(TP_A2) - eb - ec;           # the identity, not a third cross product

    var d255 = tp_get(TP_D255);
    var out = 0;
    var qa = 255;

    # Alpha FIRST (channel 0 => shift 24), so qa is live when r/g/b are clamped against it.
    var ch = 0;
    while (ch < 4) {
        var sh = 24 - ch * 8;
        var pa = ((tp_get(TP_CA) >> sh) & 0xFF) * cov;
        var pb = ((tp_get(TP_CB) >> sh) & 0xFF) * cov;
        var pc = ((tp_get(TP_CC) >> sh) & 0xFF) * cov;

        var n = ea * pa + eb * pb + ec * pc;
        # ⚠ A sample centre outside the shape gives a NEGATIVE weight and hence a negative
        # numerator. Clamp at zero BEFORE rounding, exactly as the shader does — clamping after
        # would round -0.5 to 0 by a different route and the two would disagree by 1 LSB.
        if (n < 0) { n = 0; }
        var q = (n + (d255 >> 1)) / d255;       # round-half-up, exact i64 divide
        # N13 instrumentation: did the bias carry the quotient up a level? That is precisely the
        # case the shader's estimate-and-correct step must catch, so a corpus where it NEVER happens
        # leaves that step untested.
        if (n / d255 != q) { tr_corr_hits = tr_corr_hits + 1; }
        if (q > 255) { q = 255; }
        if (ch == 0) { qa = q; }
        # Premultiplied invariant: no channel may exceed alpha.
        if (q > qa) { q = qa; tr_premul_hits = tr_premul_hits + 1; }
        out = out | (q << sh);
        ch = ch + 1;
    }

    return tri_src_over(out, dst);
}

# ============================================================================================
# Integer src-over on premultiplied ARGB: out = src + dst * (255 - src_a) / 255
# ============================================================================================
# ⚠ THE /255 IS THE BIT-IDENTITY HINGE. The usual shortcut `(x * a + 127) >> 8` is NOT the same
# function as `(x * a + 127) / 255` — they differ by 1 LSB on a large fraction of inputs, and
# which one the shader uses decides whether byte-identity is achievable at all. This uses the
# exact divide; the shader model must reproduce THIS, not a plausible neighbour of it.
fn tri_src_over(src, dst): i64 {
    var sa = (src >> 24) & 0xFF;
    var inv = 255 - sa;
    var out = 0;
    var ch = 0;
    while (ch < 4) {
        var sh = 24 - ch * 8;
        var s = (src >> sh) & 0xFF;
        var d = (dst >> sh) & 0xFF;
        var v = s + (d * inv + 127) / 255;
        if (v > 255) { v = 255; }
        out = out | (v << sh);
        ch = ch + 1;
    }
    return out;
}

# ============================================================================================
# SELFTEST
# ============================================================================================
fn tr_selftest(): i64 {
    var fail = 0;

    # --- 1. degenerate frames are REFUSED, not silently mishandled -------------------------
    if (tri_prep(0, 0, 10, 0, 20, 0, 0, 0, 0) != 0) {
        ps("FAIL: collinear frame accepted"); nl();
        fail = fail + 1;
    }
    if (tri_prep(5, 5, 5, 5, 5, 5, 0, 0, 0) != 0) {
        ps("FAIL: zero-area frame accepted"); nl();
        fail = fail + 1;
    }

    # --- 2. a real frame preps, and t lands in the proven window ---------------------------
    if (tri_prep(0, 0, 256, 0, 0, 256, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF) != 1) {
        ps("FAIL: legal frame refused"); nl();
        fail = fail + 1;
    }
    var t = tp_get(TP_T);
    if (t < 0) { ps("FAIL: t negative -- the shift would be meaningless"); nl(); fail = fail + 1; }
    if (t > 31) { ps("FAIL: t above 31 -- beyond the funnel shift's range"); nl(); fail = fail + 1; }
    # The real invariant is recip32's domain, checked in tri_prep; L itself is unconstrained.
    var dn = u32(tp_get(TP_DH) << tp_get(TP_L));
    if (dn < 2147483648) { ps("FAIL: dh << L below recip32's domain"); nl(); fail = fail + 1; }

    # --- 3. ⭐ VERTEX REPRODUCTION. At vertex A the weights are (2A, 0, 0), so the answer must
    # be vertex A's colour exactly. This is the arm that actually tests the barycentrics; a
    # shader with a dead x-term still passes a flat-colour case, so flat colour is a CONTROL,
    # never a gate. Sampled at the pixel whose CENTRE is nearest each vertex.
    var got = tri_ref_px(0, 0, 255, 0xFF000000) & 0xFFFFFF;
    if (got == 0) { ps("FAIL: vertex A reproduced as black"); nl(); fail = fail + 1; }

    # --- 4. FALSIFICATION ARM: the weights must VARY in x. Two pixels on the same row with
    # different x must give different colours on a frame whose colours differ. A model that
    # wires kx to zero passes every gradient test ever written; this is what catches it.
    var p0 = tri_ref_px(8, 8, 255, 0);
    var p1 = tri_ref_px(200, 8, 255, 0);
    if (p0 == p1) {
        ps("FAIL: colour does not vary in x -- the x term is dead"); nl();
        fail = fail + 1;
    }
    # ... and in y, for the same reason.
    var p2 = tri_ref_px(8, 200, 255, 0);
    if (p0 == p2) {
        ps("FAIL: colour does not vary in y -- the y term is dead"); nl();
        fail = fail + 1;
    }

    # --- 5. zero coverage is a pass-through, byte for byte ---------------------------------
    if (tri_ref_px(8, 8, 0, 0x11223344) != 0x11223344) {
        ps("FAIL: zero coverage did not pass dst through"); nl();
        fail = fail + 1;
    }

    # --- 6. the premultiplied invariant holds on the output --------------------------------
    var q = tri_ref_px(8, 8, 255, 0);
    var qa = (q >> 24) & 0xFF;
    var ci = 1;
    while (ci < 4) {
        var cv = (q >> (24 - ci * 8)) & 0xFF;
        if (cv > qa) {
            ps("FAIL: channel exceeds alpha, ch="); pn(ci); nl();
            fail = fail + 1;
        }
        ci = ci + 1;
    }

    # --- 7. opaque src over any dst is the src, unchanged -----------------------------------
    if (tri_src_over(0xFF123456, 0xFFFFFFFF) != 0xFF123456) {
        ps("FAIL: opaque src-over is not the identity on src"); nl();
        fail = fail + 1;
    }
    # --- 8. fully transparent src leaves dst exactly ----------------------------------------
    if (tri_src_over(0x00000000, 0x11223344) != 0x11223344) {
        ps("FAIL: transparent src-over did not preserve dst"); nl();
        fail = fail + 1;
    }

    return fail;
}


# ============================================================================================
# THE CORPUS — ONE table, driving both the reference and the #92 records
# ============================================================================================
# ⛔ SINGLE SOURCE OF TRUTH. Every case's geometry and colours are stated exactly once, here. The
# reference reads it, and the ABI records will be built from it. The rung-9 corpus drifted because
# a case could be edited on one side and not the other; that is what the audit arm below exists to
# stop, and why nothing downstream may hand-transcribe a case.
#
# ⚠ EVERY VERTEX COLOUR MUST SATISFY c <= a PER CHANNEL. These are PREMULTIPLIED. Straight alpha
# is not an error anywhere in the pipeline — it washes out SILENTLY — and with three independent
# vertex colours the odds of seeding it wrong are materially higher than with two stops. The audit
# asserts it rather than trusting the author.
#
# Layout per case: 6 geometry + 3 colours + 1 flag = 10 i64 slots.
var TC_STRIDE = 10;
var TC_N      = 16;
var tcase[1200];                # 15 cases x 10 slots x 8 BYTES  (top-level program => BYTES)

var TCF_NONE   = 0;
var TCF_FLAT   = 1;             # control only, never a pass-gate on its own
var TCF_REJECT = 2;             # must be REFUSED by tri_prep -- falsification arm

fn tc_set(i, f, v): i64 { store64(&tcase + (i * TC_STRIDE + f) * 8, v); return 0; }
fn tc_get(i, f): i64 { return load64(&tcase + (i * TC_STRIDE + f) * 8); }

fn tc_put(i, ax, ay, bx, by, cx, cy, ca, cb, cc, flag): i64 {
    tc_set(i, 0, ax); tc_set(i, 1, ay); tc_set(i, 2, bx); tc_set(i, 3, by);
    tc_set(i, 4, cx); tc_set(i, 5, cy);
    tc_set(i, 6, ca); tc_set(i, 7, cb); tc_set(i, 8, cc); tc_set(i, 9, flag);
    return 0;
}

fn tc_init(): i64 {
    # 1  three-colour triangle, frame == shape, weights VARY IN X. The primary gate, and the ONLY
    #    gate on the x term -- every rect-shaped case reduces to a function of y alone.
    tc_put(0,   0,   0, 256,   0,   0, 256, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 2  case 1 with the vertex order ROTATED. Barycentric interpolation is a property of the
    #    frame, not of which vertex was written first, so this must be BIT-IDENTICAL to case 1.
    tc_put(1,   0, 256,   0,   0, 256,   0, 0xFF0000FF, 0xFFFF0000, 0xFF00FF00, TCF_NONE);
    # 3  case 1 MIRRORED IN X -- catches a sign error in the x term that case 1 alone cannot.
    tc_put(2, 256,   0,   0,   0, 256, 256, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 4  flat colour. ⚠ A CONTROL, NOT A GATE: a shader with a dead x term passes this perfectly.
    tc_put(3,   0,   0, 256,   0,   0, 256, 0xFF808080, 0xFF808080, 0xFF808080, TCF_FLAT);
    # 5  gradient rect, EVEN height -- the two-triangle-as-one-frame equivalence, even parity.
    tc_put(4,   0,   0, 256,   0,   0,  64, 0xFFC000C0, 0xFFC000C0, 0x00000000, TCF_NONE);
    # 6  gradient rect, ODD height (200, the shipped gradient height) -- the parity branch that
    #    could have diverged from case 5.
    tc_put(5,   0,   0, 256,   0,   0, 200, 0xFFC000C0, 0xFFC000C0, 0x00000000, TCF_NONE);
    # 7  quad as ONE record: a frame spanning both triangles. Seamless BY CONSTRUCTION -- one
    #    coverage pass, one blend, so a seam is not structurally representable.
    tc_put(6,   0,   0, 256,   0,   0, 256, 0xFFFF8000, 0xFF00FF80, 0xFF8000FF, TCF_NONE);
    # 8  the SAME quad expressed as a second, different frame. Measures the honest cross-record
    #    seam; reported, never gated at zero, because sequential src-over of two half-covered
    #    boundary pixels genuinely differs from compositing their union.
    tc_put(7, 256, 256,   0, 256, 256,   0, 0xFFFF8000, 0xFF00FF80, 0xFF8000FF, TCF_NONE);
    # 9  DECOUPLING: a frame much larger than the shape it colours. This is the whole structural
    #    claim -- geometry and attribute basis are independent.
    tc_put(8, 0-512, 0-512, 1024, 0-512, 0-512, 1024, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 10 skewed frame, still well inside the coordinate bound.
    tc_put(9,   0,   0, 2048,  16,   16, 2048, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 11 ⭐ FALSIFICATION: collinear vertices. No affine basis exists, so tri_prep MUST refuse. A
    #    corpus with no failing arm is a hope, not a corpus.
    tc_put(10,  0,   0, 100, 100, 200, 200, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_REJECT);
    # 12 SMALL frame -- exercises the low end of t, which the plan wrongly assumed unreachable.
    tc_put(11,  0,   0,  16,   0,   0,  16, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 13 LARGEST frame inside the +-4096 px coordinate bound -- the high end of t that actually
    #    exists. (The plan's t = 31 case is unconstructible; see tri_prep.)
    tc_put(12,  0,   0, 4000,   0,   0, 4000, 0xFFFF0000, 0xFF00FF00, 0xFF0000FF, TCF_NONE);
    # 14 ALPHA VARYING across the frame, over a non-black destination -- the src-over tail.
    tc_put(13,  0,   0, 256,   0,   0, 256, 0xFF804020, 0x80402010, 0x20100804, TCF_NONE);
    # 15 PREMULTIPLICATION BOUNDARY: c == a exactly at every vertex, so the min(q_ch, q_a) clamp
    #    is exercised at its edge rather than in its interior.
    tc_put(14,  0,   0, 256,   0,   0, 256, 0xFFFFFFFF, 0x80808080, 0x40404040, TCF_NONE);
    # 16 ⭐ EXTRAPOLATION: a SMALL frame in the middle of a large sample grid, with colour ratios
    #    that diverge from alpha's. Inside a frame, barycentric interpolation is a convex
    #    combination, so c <= a is preserved automatically and min(q_ch, q_a) CAN NEVER FIRE.
    #    Only outside — where the weights leave [0,1] and the interpolant extrapolates — can a
    #    channel overtake alpha. Alpha runs 32 -> 255 across this frame while the colours run
    #    32 -> 0, so extrapolating past vertex A drives alpha below the channels.
    #    ⚠ Added because N14 caught its absence: without this case the premultiplied restore is
    #    never exercised and a shader omitting it passes the whole corpus.
    tc_put(15, 32, 32, 40, 32, 32, 40, 0x20202020, 0xFF000000, 0xFF000000, TCF_NONE);
    return 0;
}

fn tc_name(i): i64 {
    if (i ==  0) { ps("tri3col-xvary"); }
    if (i ==  1) { ps("tri3col-rotated"); }
    if (i ==  2) { ps("tri3col-mirrored"); }
    if (i ==  3) { ps("flat-CONTROL"); }
    if (i ==  4) { ps("grad-even-h64"); }
    if (i ==  5) { ps("grad-odd-h200"); }
    if (i ==  6) { ps("quad-one-record"); }
    if (i ==  7) { ps("quad-other-frame"); }
    if (i ==  8) { ps("decoupled-frame"); }
    if (i ==  9) { ps("skew-frame"); }
    if (i == 10) { ps("collinear-REJECT"); }
    if (i == 11) { ps("small-frame-low-t"); }
    if (i == 12) { ps("large-frame-high-t"); }
    if (i == 13) { ps("alpha-varying"); }
    if (i == 14) { ps("premul-boundary"); }
    if (i == 15) { ps("extrapolation-premul"); }
    return 0;
}

# ============================================================================================
# tc_audit — the corpus polices ITSELF before anything is measured against it
# ============================================================================================
# ⛔ A CORPUS THAT IS NEVER AUDITED DRIFTS. In rung 9 a case was narrowed by an edit and stayed
# "deterministic" while no longer testing what it was added for. These checks are cheap and they
# run every time.
fn tc_audit(): i64 {
    var bad = 0;
    var i = 0;
    while (i < TC_N) {
        # (a) premultiplied invariant on every vertex colour, every channel
        var v = 6;
        while (v < 9) {
            var col = tc_get(i, v);
            var a = (col >> 24) & 0xFF;
            var ch = 1;
            while (ch < 4) {
                var c = (col >> (24 - ch * 8)) & 0xFF;
                if (c > a) {
                    ps("AUDIT: case "); pn(i); ps(" ("); tc_name(i);
                    ps(") vertex colour is NOT premultiplied: channel exceeds alpha"); nl();
                    bad = bad + 1;
                }
                ch = ch + 1;
            }
            v = v + 1;
        }
        # (b) coordinates inside the ABI's +-4096 px (that is +-2^28 in 16.16)
        var f = 0;
        while (f < 6) {
            var q = tc_get(i, f);
            if (q > 4096) { ps("AUDIT: case "); pn(i); ps(" coord above +4096"); nl(); bad = bad + 1; }
            if (q < 0 - 4096) { ps("AUDIT: case "); pn(i); ps(" coord below -4096"); nl(); bad = bad + 1; }
            f = f + 1;
        }
        i = i + 1;
    }
    # (c) ⭐ the corpus must CONTAIN a falsification arm and an x-varying arm. A corpus that
    #     quietly loses its failing case still reports all-green.
    var nrej = 0;
    var nflat = 0;
    i = 0;
    while (i < TC_N) {
        if (tc_get(i, 9) == TCF_REJECT) { nrej = nrej + 1; }
        if (tc_get(i, 9) == TCF_FLAT) { nflat = nflat + 1; }
        i = i + 1;
    }
    if (nrej == 0) { ps("AUDIT: corpus has NO reject case -- no falsification arm"); nl(); bad = bad + 1; }
    if (nflat == 0) { ps("AUDIT: corpus has NO flat control"); nl(); bad = bad + 1; }
    return bad;
}

# Run every case through the reference and report a digest per case, plus the observed t range.
fn tc_run(): i64 {
    var bad = 0;
    var tmin = 999;
    var tmax = 0 - 999;
    var i = 0;
    while (i < TC_N) {
        var ok = tri_prep(tc_get(i,0), tc_get(i,1), tc_get(i,2), tc_get(i,3),
                          tc_get(i,4), tc_get(i,5), tc_get(i,6), tc_get(i,7), tc_get(i,8));
        var want_reject = 0;
        if (tc_get(i, 9) == TCF_REJECT) { want_reject = 1; }
        if (want_reject == 1) {
            if (ok != 0) {
                ps("FAIL: case "); pn(i); ps(" ("); tc_name(i); ps(") was ACCEPTED but must reject"); nl();
                bad = bad + 1;
            }
            i = i + 1;
            continue;
        }
        if (ok != 1) {
            ps("FAIL: case "); pn(i); ps(" ("); tc_name(i); ps(") was REFUSED"); nl();
            bad = bad + 1;
            i = i + 1;
            continue;
        }
        var t = tp_get(TP_T);
        if (t < tmin) { tmin = t; }
        if (t > tmax) { tmax = t; }

        # Digest: fold the reference's output over a fixed sample lattice. Order-sensitive, so a
        # transposition changes it.
        var dg = 0;
        var y = 0;
        while (y < 8) {
            var x = 0;
            while (x < 8) {
                var px = x * 17 + 3;
                var py = y * 13 + 5;
                var v = tri_ref_px(px, py, 255, 0xFF101010);
                dg = (dg * 31 + v) & 0xFFFFFFFFFFFFF;
                x = x + 1;
            }
            y = y + 1;
        }
        ps("  case "); pn(i); ps(" "); tc_name(i); ps("  t="); pn(t); ps("  digest="); pn(dg); nl();
        i = i + 1;
    }
    ps("  observed t range: ["); pn(tmin); ps(", "); pn(tmax);
    ps("]  (the plan claimed [10,31]; both ends were wrong)"); nl();
    return bad;
}

# ============================================================================================
# tr_prep_dump — print the prep record in the SAME field order the kernel prints it
# ============================================================================================
# ⭐ THE OTHER HALF OF A CROSS-IMPLEMENTATION DIFF. The kernel computes this record with its own
# copy of the integer-divide primitives (it cannot include a host file, and Cyrius shadows duplicate
# fns silently, so the two can drift with nothing complaining). Printing both from the same inputs
# and diffing field by field is the only thing watching that seam.
fn tr_prep_dump(): i64 {
    ps("tri-prep:");
    var order[32];
    store64(&order +  0 * 8, 0);        # cov_lo placeholder -- the host has no cov address
    var f = 0;
    # Field order mirrors gpu_tri_prep_dump: cov_lo cov_hi t t32 | Dh V L - | A2lo A2hi D255lo D255hi
    #                                        | kxB kyB k0Blo k0Bhi | kxC kyC k0Clo k0Chi | cA cB cC
    ps(" 19087360");                    # cov_lo = 0x1234000, the literal the kernel is handed
    ps(" 0");
    ps(" "); pn(tp_get(TP_T));
    ps(" "); pn(32 - tp_get(TP_T));
    ps(" "); pn(tp_get(TP_DH));
    ps(" "); pn(tp_get(TP_V));
    ps(" "); pn(tp_get(TP_L));
    ps(" 0");
    ps(" "); pn(tp_get(TP_A2) & 0xFFFFFFFF);
    ps(" "); pn((tp_get(TP_A2) >> 32) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_D255) & 0xFFFFFFFF);
    ps(" "); pn((tp_get(TP_D255) >> 32) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_KXB) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_KYB) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_K0B) & 0xFFFFFFFF);
    ps(" "); pn((tp_get(TP_K0B) >> 32) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_KXC) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_KYC) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_K0C) & 0xFFFFFFFF);
    ps(" "); pn((tp_get(TP_K0C) >> 32) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_CA) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_CB) & 0xFFFFFFFF);
    ps(" "); pn(tp_get(TP_CC) & 0xFFFFFFFF);
    nl();
    return 0;
}

# ============================================================================================
# tc_corpus_digest — THE shared corpus digest, computed identically by every consumer
# ============================================================================================
# ⭐ N16 COMPARES TWO BINARIES, SO THE COMPUTATION MUST LIVE IN ONE PLACE. gputri (built --agnos,
# running on the GPU box) and triref (built for the host) both call this. If it were written twice,
# a difference between the two would be indistinguishable from the codegen divergence N16 exists to
# detect — which is the whole point of the check.
# ⚠ Caller supplies the scratch buffer: tricore is an includable module and must not own storage
# sized for one consumer's geometry.
var tc_dg_distinct = 0;
var tc_dg_rowspan = 0;

fn tc_case_digest(buf, w, h): i64 {
    var seen[256];
    var z = 0;
    while (z < 256) { store8(&seen + z, 0); z = z + 1; }
    tc_dg_distinct = 0;
    tc_dg_rowspan = 0;
    var midy = h / 2;
    var rowmin = 256;
    var rowmax = 0 - 1;
    var hsh = 2166136261;
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var v = tri_ref_px(x, y, 255, 0xFF101010);
            store32(buf + (y * w + x) * 4, v);
            var g = (v >> 8) & 0xFF;
            if (load8(&seen + g) == 0) { store8(&seen + g, 1); tc_dg_distinct = tc_dg_distinct + 1; }
            if (y == midy) {
                if (g < rowmin) { rowmin = g; }
                if (g > rowmax) { rowmax = g; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (rowmax >= rowmin) { tc_dg_rowspan = rowmax - rowmin; }
    var i = 0;
    var n = w * h * 4;
    while (i < n) {
        hsh = (hsh ^ (load8(buf + i) & 0xFF)) & 0xFFFFFFFF;
        hsh = (hsh * 16777619) & 0xFFFFFFFF;
        i = i + 1;
    }
    return hsh;
}

# Fold every non-reject case into one number. This is what N16 compares across binaries.
fn tc_corpus_digest(buf, w, h): i64 {
    var acc = 0;
    var i = 0;
    while (i < TC_N) {
        if (tc_get(i, 9) != TCF_REJECT) {
            if (tri_prep(tc_get(i,0), tc_get(i,1), tc_get(i,2), tc_get(i,3),
                         tc_get(i,4), tc_get(i,5), tc_get(i,6), tc_get(i,7), tc_get(i,8)) == 1) {
                acc = ((acc * 31) + tc_case_digest(buf, w, h)) & 0xFFFFFFFF;
            }
        }
        i = i + 1;
    }
    return acc;
}

# ============================================================================================
# RUNG 12 — the batched-triangle reference
# ============================================================================================
# ⭐ A TRIANGLE LIST IS COMPOSITED IN SUBMISSION ORDER, one triangle at a time, each src-over'd
# onto the result of the last. That ordering IS the semantics: triangles overlap, and "all of them
# at once" is not a defined operation. The reference therefore loops in exactly the order the
# kernel does, and any divergence in order shows up as a byte difference rather than as a subtle
# blend error nobody can attribute.
# ⚠ Caller supplies the triangle table: 9 i64 slots per triangle (6 coords + 3 colours), pixel
# coordinates, matching the layout the instrument packs into its #86 vertex slot.
var TL_STRIDE = 9;

fn tl_get(tbl, i, f): i64 { return load64(tbl + (i * TL_STRIDE + f) * 8); }

fn tl_set(tbl, i, f, v): i64 { store64(tbl + (i * TL_STRIDE + f) * 8, v); return 0; }

# Render n triangles from `tbl` into `buf` (w*h ARGB), starting from `bg`.
fn tl_render(tbl, n, buf, w, h, bg): i64 {
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) { store32(buf + (y * w + x) * 4, bg); x = x + 1; }
        y = y + 1;
    }
    var i = 0;
    while (i < n) {
        if (tri_prep(tl_get(tbl,i,0), tl_get(tbl,i,1), tl_get(tbl,i,2), tl_get(tbl,i,3),
                     tl_get(tbl,i,4), tl_get(tbl,i,5),
                     tl_get(tbl,i,6), tl_get(tbl,i,7), tl_get(tbl,i,8)) == 1) {
            var yy = 0;
            while (yy < h) {
                var xx = 0;
                while (xx < w) {
                    # ⚠ Coverage here is the triangle's own shape, so a point outside it contributes
                    # nothing. The reference asks the SAME question the rasteriser does — is this
                    # pixel centre inside? — rather than trusting the interpolator to clamp it away.
                    var pcx = (xx << 16) + 32768;
                    var pcy = (yy << 16) + 32768;
                    var eb = tp_get(TP_KXB) * pcx + tp_get(TP_KYB) * pcy + tp_get(TP_K0B);
                    var ec = tp_get(TP_KXC) * pcx + tp_get(TP_KYC) * pcy + tp_get(TP_K0C);
                    var ea = tp_get(TP_A2) - eb - ec;
                    var inside = 1;
                    if (ea < 0) { inside = 0; }
                    if (eb < 0) { inside = 0; }
                    if (ec < 0) { inside = 0; }
                    if (inside == 1) {
                        var cur = load32(buf + (yy * w + xx) * 4) & 0xFFFFFFFF;
                        store32(buf + (yy * w + xx) * 4, tri_ref_px(xx, yy, 255, cur));
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}
