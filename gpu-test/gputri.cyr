# gputri.cyr — RUNG 9 of the 3D arc. The rasteriser's ring-3 instrument. Bite B8.
#
# ============================================================================================
# THE ORACLE: the GPU's mask must be BYTE-IDENTICAL to refraster.cyr over the 20-case corpus
# ============================================================================================
# ⛔ AND THAT ALONE IS NOT ENOUGH, which is why N1-N8 exist. Two of the twenty cases have an
# ALL-ZERO correct answer ("zero-area" and "fully outside"), so a shader that writes nothing
# reproduces them byte-exactly. A comparison with no negative controls is satisfiable by a dead
# dispatch, and it would report 20/20.
#
# Every control below is a gate that must FIRE. If any does not, the tool exits 86 and can never
# reach 95 — a control that silently fails to run is worse than no control, because it turns a
# green result from evidence into decoration.
#
# ============================================================================================
# ⭐ THE DIGEST GATE — the one check that catches BOTH SIDES BEING WRONG TOGETHER
# ============================================================================================
# `cpuref` (host) and `gputri` (--agnos) include the SAME refraster.cyr, but they are compiled
# through different code paths. A `--agnos` codegen divergence would make this tool's reference
# AND its comparison agree with each other while both differ from the host's. Byte-comparing the
# GPU against a locally-wrong reference would then report a clean pass.
#
# So each case's reference mask is FNV-1a digested and printed by BOTH tools, and the burn is
# only readable if they match. `gpu.md:1019` names this failure class explicitly.
#
# Build:  cd gpu-test && cyrius build --agnos gputri.cyr build/gputri_agnos
# Iron:   run /bin/gputri --digest   reference digests, to diff against host cpuref FIRST
#         run /bin/gputri --cov      the 20-case corpus + N1-N8
#
# Exits: 95 every case exact AND every control fired · 100 no GPU / no carveout (QEMU)
#        96 seam live, shader not resident · 92 fill-rule · 91 shape · 89 tgid-mapping
#        88 UNTOUCHED · 87 wrote but covered nothing · 86 a negative control FAILED
#        85 in-tool reference digest != host cpuref digest · 90 named #92 fault · 84 bad arg

include "lib/io.cyr"
include "refraster.cyr"

fn slen(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
fn ps(s): i64 { print(s, slen(s)); return 0; }
fn nl(): i64 { print("\n", 1); return 0; }
fn puts(s): i64 { ps(s); nl(); return 0; }
fn pnum(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var neg = 0; var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var b[24]; var i = 0;
    while (x > 0) { store8(&b + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&b + i, 1); }
    return 0;
}
fn phex8(v): i64 {
    ps("0x");
    var i = 7;
    while (i >= 0) {
        var nib = (v >> (i * 4)) & 0xF;
        var ch = 48 + nib; if (nib > 9) { ch = 87 + nib; }
        var c[2]; store8(&c, ch); print(&c, 1);
        i = i - 1;
    }
    return 0;
}

var SENTINEL = 0xA5;

# ============================================================================================
# BUFFERS — ⚠ SIZED FROM THE CORPUS, and the two previous sizes were BOTH WRONG
# ============================================================================================
# Module-scope `var X[N]` is N x u64 = 8N BYTES ([[cyrius-var-array-u64-units]]).
#
# ⛔ `tri_edges[8]` was 64 bytes = EXACTLY 4 EDGES. Corpus case 9 (bowtie) has 4 and fit by
# luck; case 10 has 10 and case 20 has 64 — both would have written straight past the end into
# the mask buffer declared next to it. A corrupted edge array produces a plausible WRONG
# TRIANGLE, the single hardest symptom in this rung's failure table to attribute.
var tri_edges[128];             # 1024 B = 64 edges x 16 B, the shipped EDGE_CAP
#
# ⛔ And ONE buffer served as BOTH the sentinel prefill and the readback. That makes the
# comparison read the GPU's own output as the "expected" value for any byte the GPU did not
# write — the exact aliasing that turns a dead shader into a pass. They are separate now.
var tri_ref[2048];              # 16384 B — the CPU reference mask (128x128 is the corpus max)
var tri_gpu[2048];              # 16384 B — what the GPU actually wrote, read back
var tri_poison[2048];           # 16384 B — N1's deliberately corrupted copy

var ctl_fired[16];              # N1..N8 — each must be 1 by the end or the tool exits 86

# FNV-1a 32, masked to 32 bits. A digest, not a hash: it exists so two tools can agree on a byte
# array without shipping the array between them.
fn digest(buf, n): i64 {
    var h = 2166136261;
    var i = 0;
    while (i < n) {
        h = (h ^ (load8(buf + i) & 0xFF)) & 0xFFFFFFFF;
        h = (h * 16777619) & 0xFFFFFFFF;
        i = i + 1;
    }
    return h;
}

fn tri_report(reason): i64 {
    if (reason == 1)  { puts("gputri: GPO_E_NOGPU -- no GPU/display here. (exit 100)"); return 100; }
    if (reason == 7) {
        puts("gputri: GPO_E_ARM -- the edge shader is not resident.");
        puts("gputri: the ABI seam validates but no blob is armed. On a kernel built before");
        puts("gputri: 9b's B7 that is EXPECTED; on a current one it means gpu_edge_arm's own");
        puts("gputri: gates refused (no arena, no ring, matmul unproven). (exit 96)");
        return 96;
    }
    if (reason == 2)  { puts("gputri: GPO_E_BADOP -- this kernel predates op 0x08."); return 90; }
    if (reason == 3)  { puts("gputri: GPO_E_BADSLOT -- edge slot invalid or not GPU-visible."); return 90; }
    if (reason == 6)  { puts("gputri: GPO_E_DIM -- mask dimensions rejected."); return 90; }
    if (reason == 8)  { puts("gputri: GPO_E_DISPATCH -- the watchdog expired. Run gpuwedge."); return 90; }
    if (reason == 12) { puts("gputri: GPO_E_RESERVED -- a field this op does not define was non-zero."); return 90; }
    if (reason == 13) { puts("gputri: GPO_E_UNPROVEN -- the dispatch envelope is unproven this boot."); return 90; }
    if (reason == 16) { puts("gputri: GPO_E_EDGEBUF -- edge count or edge slot size rejected."); return 90; }
    if (reason == 17) { puts("gputri: GPO_E_DSTSLOT -- destination mask slot rejected."); return 90; }
    if (reason == 18) { puts("gputri: GPO_E_RULE -- winding rule rejected (NONZERO only)."); return 90; }
    if (reason == 19) { puts("gputri: GPO_E_ALIAS -- edge and destination are the same slot."); return 90; }
    if (reason == 20) { puts("gputri: GPO_E_COORD -- an endpoint is outside +-2^28."); return 90; }
    ps("gputri: unexpected reason "); pnum(reason); nl();
    return 90;
}

# Pack the edge list refraster currently holds into the 16-byte-per-edge #92 array.
# ⭐ ONE SOURCE OF TRUTH: these are the SAME ex0/ey0/ex1/ey1 the reference rasterised. Two
# hand-kept geometry lists is how a "mismatch" turns out to be two different triangles.
fn tri_pack_edges(): i64 {
    var i = 0;
    while (i < n_edges) {
        var b = &tri_edges + i * 16;
        store32(b +  0, load64(&ex0 + i * 8));
        store32(b +  4, load64(&ey0 + i * 8));
        store32(b +  8, load64(&ex1 + i * 8));
        store32(b + 12, load64(&ey1 + i * 8));
        i = i + 1;
    }
    return n_edges;
}

# Classify a mismatch into the plan's four outcomes. A bare "differs" would send the next burn
# down whichever path was guessed first.
fn tri_classify(w, h): i64 {
    var untouched = 0; var covered = 0; var diff = 0; var worst = 0;
    var i = 0;
    while (i < w * h) {
        var g = load8(&tri_gpu + i) & 0xFF;
        var r = load8(&tri_ref + i) & 0xFF;
        if (g == SENTINEL) { untouched = untouched + 1; }
        if (g != 0) { if (g != SENTINEL) { covered = covered + 1; } }
        if (g != r) {
            diff = diff + 1;
            var d = g - r; if (d < 0) { d = 0 - d; }
            if (d > worst) { worst = d; }
        }
        i = i + 1;
    }
    if (diff == 0) { return 0; }
    ps("    differing "); pnum(diff); ps(" of "); pnum(w * h);
    ps("   worst delta "); pnum(worst);
    ps("   untouched "); pnum(untouched); nl();
    if (untouched == w * h) {
        puts("    UNTOUCHED -- every byte still reads 0xA5. The dispatch retired but wrote");
        puts("    NOTHING. Two causes, and rung 5 arm E separates them: the post-dispatch");
        puts("    coherence packet is missing, or the EXEC guard rejected every lane.");
        puts("    ⛔ This is NOT an edge-setup bug. Do not go looking there.");
        return 88;
    }
    if (untouched != 0) {
        puts("    PARTIAL -- some bytes written, others still sentinel. That is a TGID MAPPING");
        puts("    fault: whole workgroups never dispatched.");
        return 89;
    }
    if (covered == 0) {
        puts("    WROTE, COVERED NOTHING -- the shader ran and cleared the mask. Write-back");
        puts("    demonstrably works, so the winding evaluated to zero: a FILL RULE fault.");
        return 87;
    }
    if (worst <= 2) {
        puts("    SHAPE RIGHT, EDGE PIXELS DIFFER by <= 2 -- a FILL RULE / rounding fault, not");
        puts("    a geometry one. Check the sub-scanline placement and the >> 2 truncation.");
        return 92;
    }
    puts("    WRONG SHAPE -- large deltas. Edge setup or the crossing solve.");
    return 91;
}

# ---- one corpus case, end to end ----------------------------------------------------------
fn tri_case(ci): i64 {
    if (rr_case_load(ci) != 1) { puts("  ** case refused to load"); return 86; }
    var w = W; var h = H;
    var ne = tri_pack_edges();

    cov_clear(&tri_ref);
    raster(&tri_ref);

    # ⛔ FRESH SLOTS PER CASE, and the prefill is MANDATORY. A #86 slot is a FIXED 2 MB window
    # per index, so a freed-then-reallocated slot hands back the SAME memory with the previous
    # case's pixels still in it. Without the sentinel a stale ghost reads as a pass — the
    # C2g-1 path gpucopy already hit on iron.
    var eid = syscall(86, 64 * 16);
    if (eid < 1) { return 100; }
    var did = syscall(86, w * h);
    if (did < 1) { syscall(74, eid); return 100; }

    if (syscall(72, eid, &tri_edges, ne * 16) != 0) { syscall(74, eid); syscall(74, did); return 90; }
    var i = 0;
    while (i < w * h / 8) { store64(&tri_gpu + i * 8, 0xA5A5A5A5A5A5A5A5); i = i + 1; }
    if (syscall(72, did, &tri_gpu, w * h) != 0) { syscall(74, eid); syscall(74, did); return 90; }

    var d[64];
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d +  0, 8);
    store32(&d +  8, did);
    store32(&d + 12, eid);
    store32(&d + 16, (h * 65536) + w);
    store32(&d + 36, ne);
    var rc = syscall(92, &d, 64);
    if (rc != 0) {
        syscall(74, eid); syscall(74, did);
        return tri_report((0 - rc) & 0xFF);
    }
    if (syscall(73, did, &tri_gpu, w * h) != 0) { syscall(74, eid); syscall(74, did); return 90; }
    syscall(74, eid); syscall(74, did);
    return tri_classify(w, h);
}

fn tri_cov(): i64 {
    if (rr_selftest() != 1) { puts("gputri: refraster selftest FAILED -- the oracle is unsound."); return 86; }
    var ci = 0;
    while (ci < 16) { store64(&ctl_fired + ci * 8, 0); ci = ci + 1; }

    puts("gputri: the 20-case corpus, GPU vs refraster.cyr");
    var fails = 0; var worst_code = 0; var lit_big = 0;
    ci = 1;
    while (ci <= RR_NCASES) {
        var r = tri_case(ci);
        if (r == 100) { puts("gputri: no GPU carveout here -- this tool needs iron. (exit 100)"); return 100; }
        if (r == 96)  { return 96; }
        ps("  "); pnum(ci); ps(" "); ps(rr_case_name(ci));
        ps("  "); pnum(W); ps("x"); pnum(H); ps("  edges "); pnum(n_edges);
        ps("  ref-digest "); phex8(digest(&tri_ref, W * H));
        if (r == 0) { puts("   exact"); }
        if (r != 0) { puts("   ** MISMATCH **"); fails = fails + 1; worst_code = r; }
        # N3 / N4 evidence, gathered from the REFERENCE itself
        var lit = 0; var mid = 0;
        var q = 0;
        while (q < W * H) {
            var v = load8(&tri_ref + q) & 0xFF;
            if (v != 0) { lit = lit + 1; }
            if (v != 0) { if (v != 255) { mid = mid + 1; } }
            q = q + 1;
        }
        if (lit >= 1000) { lit_big = lit_big + 1; }
        if (mid >= 1) { store64(&ctl_fired + 4 * 8, 1); }        # N4
        ci = ci + 1;
    }
    # N3 — at least three cases with real coverage. Two corpus cases are correctly ALL-ZERO, so
    # a dead shader reproduces them byte-exactly; without this the pass is satisfiable by one.
    if (lit_big >= 3) { store64(&ctl_fired + 3 * 8, 1); }

    # ---- N1: comparator calibration. A deliberately poisoned copy MUST compare unequal. -----
    # ⛔ Without this, a comparator that always says "equal" reports 20/20 and nothing notices.
    rr_case_load(1); cov_clear(&tri_ref); raster(&tri_ref);
    var pi = 0;
    while (pi < W * H) { store8(&tri_poison + pi, load8(&tri_ref + pi)); pi = pi + 1; }
    store8(&tri_poison + (W * H / 2), (load8(&tri_ref + (W * H / 2)) ^ 0xFF) & 0xFF);
    if (digest(&tri_poison, W * H) != digest(&tri_ref, W * H)) { store64(&ctl_fired + 1 * 8, 1); }

    # ---- N2: the sentinel itself must be observable. Prefill, read back WITHOUT dispatching. -
    # If this comes back as anything but all-sentinel, the prefill/readback path is lying and
    # every "UNTOUCHED" verdict above it is unreliable.
    var ns = syscall(86, 4096);
    if (ns >= 1) {
        var j = 0;
        while (j < 512) { store64(&tri_gpu + j * 8, 0xA5A5A5A5A5A5A5A5); j = j + 1; }
        syscall(72, ns, &tri_gpu, 4096);
        var k2 = 0;
        while (k2 < 512) { store64(&tri_gpu + k2 * 8, 0); k2 = k2 + 1; }
        syscall(73, ns, &tri_gpu, 4096);
        var allsent = 1;
        var m = 0;
        while (m < 4096) { if ((load8(&tri_gpu + m) & 0xFF) != SENTINEL) { allsent = 0; } m = m + 1; }
        if (allsent == 1) { store64(&ctl_fired + 2 * 8, 1); }
        syscall(74, ns);
    }

    # ---- N5 / N6: the corpus must still CONTAIN the discriminating shapes -------------------
    rr_case_load(3);  if (n_edges >= 3) { store64(&ctl_fired + 5 * 8, 1); }   # backfacing CW
    rr_case_load(16); if (W % 64 != 0)  { store64(&ctl_fired + 6 * 8, 1); }   # non-mult-of-64

    # ---- N7: the same case twice in one boot must be byte-identical -------------------------
    var a1 = 0; var a2 = 0;
    if (tri_case(1) == 0) { a1 = digest(&tri_gpu, W * H); }
    if (tri_case(1) == 0) { a2 = digest(&tri_gpu, W * H); }
    if (a1 != 0) { if (a1 == a2) { store64(&ctl_fired + 7 * 8, 1); } }

    # ---- N8: free-then-realloc must hand back a usable slot ---------------------------------
    var s1 = syscall(86, 4096);
    if (s1 >= 1) {
        syscall(74, s1);
        var s2 = syscall(86, 4096);
        if (s2 >= 1) { syscall(74, s2); store64(&ctl_fired + 8 * 8, 1); }
    }

    var missing = 0;
    var k = 1;
    while (k <= 8) {
        if (load64(&ctl_fired + k * 8) != 1) {
            ps("  ** NEGATIVE CONTROL N"); pnum(k); puts(" DID NOT FIRE");
            missing = missing + 1;
        }
        k = k + 1;
    }
    if (missing != 0) {
        puts("gputri: a control that does not fire makes a green result decoration, not");
        puts("gputri: evidence. Refusing to report success. (exit 86)");
        return 86;
    }
    puts("gputri: negative controls N1-N8 all fired");
    if (fails != 0) {
        ps("gputri: "); pnum(fails); puts(" case(s) mismatched -- see the classification above");
        return worst_code;
    }
    puts("gputri: 20 of 20 byte-identical to refraster.cyr, every control fired. (exit 95)");
    return 95;
}

# ---- --digest: print every case's reference digest, to diff against host cpuref -------------
fn tri_digest(): i64 {
    if (rr_selftest() != 1) { return 86; }
    puts("gputri: reference digests -- diff against host `./build/cpuref` line for line");
    var ci = 1;
    while (ci <= RR_NCASES) {
        if (rr_case_load(ci) == 1) {
            cov_clear(&tri_ref); raster(&tri_ref);
            ps("  digest "); pnum(ci); ps(" "); phex8(digest(&tri_ref, W * H));
            ps("  "); puts(rr_case_name(ci));
        }
        ci = ci + 1;
    }
    puts("gputri: ⚠ ANY difference means this build's reference is not the host's, and every");
    puts("gputri: byte-comparison is then against the wrong answer. That is exit 85, and it is");
    puts("gputri: the only check that catches BOTH sides being wrong TOGETHER.");
    return 95;
}


# ============================================================================================
# RUNG 10 — THE KILL GATE. `--bench`
# ============================================================================================
# ⛔ THIS MEASUREMENT CAN KILL RUNGS 11-12, AND THAT IS A LEGITIMATE OUTCOME. The arc's tier-1
# justification is that GPU coverage beats CPU coverage on a real frame's workload. If the
# crossover sits ABOVE what a real frame covers, the coverage justification is DEAD, rungs 11-12
# do not open on it, and the arc re-bases on rung 14 (DOOM) which does not depend on this at all.
# That is a RESULT, not a failure, and it must be reported immediately.
#
# ⭐ PRE-REGISTERED BEFORE THE FLASH (gpu.md rung 10, published in the tracker):
#     unbatched crossover ~ 12,000 covered px (~110x110)
#     batched   crossover ~ 50,000 covered px/frame (~80 glyphs)
# Printed as a NUMBER so the prediction is falsifiable rather than decorative.
#
# ⚠ HOW IT IS TIMED, AND WHY THAT IS HONEST. `uptime_ms`#40 is 100 Hz — 10 ms granularity, three
# orders of magnitude coarser than one dispatch. So each point REPEATS until at least 200 ms of
# wall time has elapsed and divides. That measures the full ring-3 round trip (submit + fence +
# wait), which IS the cost a compositor actually pays — not a kernel-internal timer that would
# flatter the GPU by hiding the wait.
#
# ⚠ BOTH SIDES ARE TIMED THE SAME WAY, on the same boot, on the same geometry, from the same
# source of truth. A crossover measured against a CPU path timed on a different machine or a
# different shape would be worthless.
# ⭐ MICROSECONDS, via uptime_us#95 — NOT uptime_ms#40.
# ⛔ #40 reads timer_ticks, and a FOREGROUND `run` program executes with IF CLEARED, so the timer
# never fires and #40 is FROZEN for the program's entire duration. Two iron burns were lost to
# that before it was understood: the first fabricated a 0 us timing and divided by it, the second
# spun waiting for a clock that could not advance. #95 is rdtsc-backed and needs no interrupts.
var BENCH_TARGET_US = 100000;   # 100 ms of wall time before we trust the division
var BENCH_REP_CAP   = 4000000;  # refuse past this rather than invent a number
var bench_buf[8192];            # 65536 B = 256x256, the largest bench size
var bench_recs[512];            # 4096 B = 64 records of 64 B -- the #92 batch ceiling
var bench_reps = 0;             # reps the last measurement actually used (evidence, not derived)
var bench_ms   = 0;             # wall ms the last measurement actually spent

# ============================================================================================
# ⛔⛔ THIS LOOP REFUSES. IT DOES NOT INVENT A NUMBER. THE FIRST VERSION DID, AND IT HUNG THE BOX.
# ============================================================================================
# The 1.56.18 burn-3 lockup was caused here. The original bailed out of the adaptive loop by
# ASSIGNING `el = BENCH_TARGET_MS` — a fabricated value — and then divided it by a `reps` that
# had already been quadrupled. At 32x32 that produced `200000 / 262144` = **0 us**, and the
# caller's `(gpu * 100) / cpu` then divided by zero and took the machine down.
#
# ⚠ THE CLOCK WAS NEVER THE PROBLEM. `uptime_ms`#40 advances fine (cyrius-doom depends on it).
# The fault was a measurement routine whose failure mode was to produce a plausible number
# instead of admitting it could not measure — in the one tool whose entire job is to produce a
# number that decides whether rungs 11-12 open.
#
# Rules this obeys now, and every future bench arm should:
#   1. The returned figure comes from the SAME iteration that met the target. Never from a
#      forced value, never from a different rep count.
#   2. Exhausting the cap returns a NEGATIVE sentinel — a refusal the caller must handle — not
#      a number that looks like a timing.
#   3. `bench_reps` / `bench_ms` carry the RAW evidence so the operator sees what was measured
#      rather than only what was derived.
fn bench_time_cpu(): i64 {
    var reps = 1;
    while (reps <= BENCH_REP_CAP) {
        var t0 = syscall(95);
        var r = 0;
        while (r < reps) { cov_clear(&bench_buf); raster(&bench_buf); r = r + 1; }
        var el = syscall(95) - t0;
        if (el >= BENCH_TARGET_US) {
            bench_reps = reps; bench_ms = el;
            return el / reps;
        }
        reps = reps * 4;
    }
    return 0 - 1;                                   # REFUSAL: too fast to time at this cap
}

fn bench_time_gpu(batch): i64 {
    var reps = 1;
    while (reps <= BENCH_REP_CAP) {
        var t0 = syscall(95);
        var r = 0;
        while (r < reps) {
            if (syscall(92, &bench_recs, batch * 64) != 0) { return 0 - 2; }   # dispatch refused
            r = r + 1;
        }
        var el = syscall(95) - t0;
        if (el >= BENCH_TARGET_US) {
            bench_reps = reps; bench_ms = el;
            return el / (reps * batch);
        }
        reps = reps * 4;
    }
    return 0 - 1;
}

# ⭐ CLOCK SANITY, RUN FIRST. If uptime_ms does not advance, every number below is fiction and
# the tool must say so instead of printing zeros. Costs ~150 ms and removes an entire class of
# silent-garbage result.
# ⛔ BOUNDED BY ITERATIONS, NOT BY THE CLOCK IT IS TESTING. The first version spun until the
# clock advanced, with a 200,000,000-syscall escape hatch — which is not an escape hatch. When
# the clock genuinely could not advance it hung the machine. A guard whose exit condition is the
# thing under test is not a guard.
fn bench_clock_ok(): i64 {
    var t0 = syscall(95);
    if (t0 < 0) { return 0; }                       # #95 reports -1 when calibration was refused
    var i = 0;
    while (i < 2000000) {
        if (syscall(95) - t0 > 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One equilateral-ish triangle covering roughly half of a wxh mask, so covered_px ~ w*h/2.
fn bench_shape(w, h): i64 {
    edges_reset();
    tri_add(fx(1), fx(1), fx(w - 2), fx(h / 3), fx(w / 3), fx(h - 2));
    return n_edges;
}

fn bench_covered(): i64 {
    cov_clear(&bench_buf); raster(&bench_buf);
    var lit = 0; var i = 0;
    while (i < W * H) { if ((load8(&bench_buf + i) & 0xFF) != 0) { lit = lit + 1; } i = i + 1; }
    return lit;
}

var bench_cross1 = 0;
var bench_cross16 = 0;
var bench_refusals = 0;

# ⭐ THE CPU HALF RUNS WITHOUT A GPU, ON PURPOSE. It exercises the adaptive loop, the refusal
# path and every division guard in QEMU at zero burns — which is exactly what was NOT testable
# when the first version hung real hardware.
fn bench_cpu_only(): i64 {
    puts("[cpu-only] the timing harness itself -- runs with no GPU, so it is QEMU-testable");
    var sizes[8];
    store64(&sizes + 0, 32);  store64(&sizes + 8, 64);   store64(&sizes + 16, 96);
    store64(&sizes + 24, 128); store64(&sizes + 32, 192); store64(&sizes + 40, 256);
    var i = 0;
    while (i < 6) {
        var n = load64(&sizes + i * 8);
        if (rr_set_dims(n, n) != 1) { puts("  ** dims refused"); return 0; }
        bench_shape(n, n);
        var cov = bench_covered();
        var c = bench_time_cpu();
        ps("  "); pnum(n); ps("x"); pnum(n); ps("  covered "); pnum(cov); ps("  cpu ");
        if (c < 0) {
            ps("REFUSED (too fast to time in "); pnum(BENCH_REP_CAP); puts(" reps)");
            bench_refusals = bench_refusals + 1;
        }
        if (c >= 0) {
            pnum(c); ps("us   [evidence: "); pnum(bench_ms); ps(" us over ");
            pnum(bench_reps); puts(" reps]");
        }
        i = i + 1;
    }
    return 1;
}

fn bench_point(w, h, batch): i64 {
    if (rr_set_dims(w, h) != 1) { puts("  ** dims refused"); return 0; }
    var ne = bench_shape(w, h);
    var cov = bench_covered();
    var eid = syscall(86, 64 * 16);
    if (eid < 1) { return 0 - 1; }
    var did = syscall(86, w * h);
    if (did < 1) { syscall(74, eid); return 0 - 1; }
    tri_pack_edges();
    syscall(72, eid, &tri_edges, ne * 16);

    var z = 0;
    while (z < 512) { store64(&bench_recs + z * 8, 0); z = z + 1; }
    var b = 0;
    while (b < batch) {
        var d = &bench_recs + b * 64;
        store32(d +  0, 8);
        store32(d +  8, did);
        store32(d + 12, eid);
        store32(d + 16, (h * 65536) + w);
        store32(d + 36, ne);
        b = b + 1;
    }
    if (syscall(92, &bench_recs, batch * 64) != 0) {     # warm-up, outside the sample
        syscall(74, eid); syscall(74, did);
        puts("  ** GPU dispatch refused"); return 0 - 1;
    }
    var g = bench_time_gpu(batch);
    var g_reps = bench_reps; var g_ms = bench_ms;
    syscall(74, eid); syscall(74, did);
    var c = bench_time_cpu();

    ps("  "); pnum(w); ps("x"); pnum(h); ps("  batch "); pnum(batch);
    ps("  covered "); pnum(cov); ps("  cpu ");
    if (c < 0) { ps("REFUSED"); }
    if (c >= 0) { pnum(c); ps("us"); }
    ps("  gpu ");
    if (g < 0) { ps("REFUSED"); }
    if (g >= 0) { pnum(g); ps("us"); }
    ps("   [gpu "); pnum(g_ms); ps("us/"); pnum(g_reps); ps("reps]  ");
    # ⛔ EVERY division guarded. A zero here is what took the machine down at burn 3.
    if (c < 0)  { puts("NO VERDICT -- cpu timing refused"); bench_refusals = bench_refusals + 1; return cov; }
    if (g < 0)  { puts("NO VERDICT -- gpu timing refused"); bench_refusals = bench_refusals + 1; return cov; }
    if (c == 0) { puts("NO VERDICT -- cpu measured 0 us"); bench_refusals = bench_refusals + 1; return cov; }
    if (g == 0) { puts("NO VERDICT -- gpu measured 0 us"); bench_refusals = bench_refusals + 1; return cov; }
    if (g < c) {
        ps("GPU wins ("); pnum((c * 100) / g); puts("% speedup factor x100)");
        if (batch == 1) { if (bench_cross1 == 0)  { bench_cross1 = cov; } }
        if (batch != 1) { if (bench_cross16 == 0) { bench_cross16 = cov; } }
    }
    if (g >= c) { ps("CPU wins (gpu is "); pnum((g * 100) / c); puts("% of cpu time)"); }
    return cov;
}

fn tri_bench(): i64 {
    puts("gputri: RUNG 10 -- THE KILL GATE. GPU vs CPU coverage cost.");
    puts("");
    puts("PRE-REGISTERED (gpu.md, published before the flash):");
    puts("  unbatched crossover ~ 12000 covered px   batched ~ 50000 covered px/frame");
    puts("⚠ timed via uptime_us#95 (rdtsc); each point repeats to >= 100 ms and divides.");
    puts("  BOTH sides measured the same way, same boot, same geometry, same edge list.");
    puts("⛔ This tool REFUSES rather than inventing a figure it could not measure.");
    puts("");
    if (bench_clock_ok() != 1) {
        puts("gputri: ⛔ uptime_us#95 DID NOT ADVANCE. Every timing would be fiction.");
        puts("gputri: refusing to print numbers. (exit 86)");
        return 86;
    }
    puts("[clock] uptime_us#95 advances -- timings are meaningful");
    bench_cross1 = 0; bench_cross16 = 0; bench_refusals = 0;

    bench_cpu_only();
    puts("");
    puts("[unbatched] one #92 record per call -- one fence per mask");
    if (bench_point(32, 32, 1) < 0) {
        puts("gputri: no GPU carveout -- the CPU half above still validated the harness. (exit 100)");
        return 100;
    }
    bench_point(64,  64,  1);
    bench_point(96,  96,  1);
    bench_point(128, 128, 1);
    bench_point(192, 192, 1);
    bench_point(256, 256, 1);
    puts("");
    puts("[batched 16] sixteen records per call -- ONE fence amortised over sixteen masks");
    bench_point(32,  32,  16);
    bench_point(64,  64,  16);
    bench_point(96,  96,  16);
    bench_point(128, 128, 16);
    bench_point(192, 192, 16);
    bench_point(256, 256, 16);
    puts("");

    ps("MEASURED unbatched crossover: ");
    if (bench_cross1 == 0)  { puts("NONE at any size measured"); }
    if (bench_cross1 != 0)  { pnum(bench_cross1); puts(" covered px"); }
    ps("MEASURED batched-16 crossover: ");
    if (bench_cross16 == 0) { puts("NONE at any size measured"); }
    if (bench_cross16 != 0) { pnum(bench_cross16); puts(" covered px"); }
    puts("");
    if (bench_refusals != 0) {
        ps("⚠ "); pnum(bench_refusals); puts(" point(s) gave NO VERDICT -- read them above.");
        puts("  A crossover derived from a partial sweep is not the pre-registered number.");
    }
    puts("⛔ READ THE PRE-REGISTERED OUTCOME TABLE IN THE TRACKER BEFORE INTERPRETING THIS.");
    puts("   A crossover ABOVE a real frame's coverage KILLS the tier-1 coverage justification");
    puts("   for rungs 11-12. That is a RESULT, not a failure, and is reported immediately.");
    puts("");
    puts("⚠ NOT MEASURED: n_edges above the shipped EDGE_CAP of 64, and masks above 256x256.");
    puts("   Raising the cap needs those points and is a separate bite -- the cap must move on");
    puts("   MEASUREMENT, never on the arithmetic model that set it.");
    return 95;
}

fn main(): i64 {
    args_init();
    if (argc() >= 2) {
        var a = argv(1);
        if (streq(a, "--cov") == 1) {
            puts("gputri: RUNG 9b -- edge array -> 8bpp coverage mask via #92 op 0x08");
            return tri_cov();
        }
        if (streq(a, "--digest") == 1) { return tri_digest(); }
        if (streq(a, "--bench") == 1) { return tri_bench(); }
        # An unknown argument is an ERROR, never a default action -- the typo that cost the M9
        # arc a flash on 2026-07-24 is exactly this failure mode.
        puts("gputri: UNKNOWN ARGUMENT -- nothing was done.");
        puts("gputri: --cov --digest --bench");
        return 84;
    }
    puts("gputri -- RUNG 9b, the edge rasteriser's instrument");
    puts("");
    puts("  run /bin/gputri --digest    reference digests, diff against host cpuref FIRST");
    puts("  run /bin/gputri --cov       the 20-case corpus + negative controls N1-N8");
    puts("  run /bin/gputri --bench     RUNG 10's KILL GATE: GPU vs CPU coverage crossover");
    puts("");
    puts("Exits: 95 all exact + all controls fired · 100 no GPU here · 96 shader not resident");
    puts("       92 fill-rule · 91 shape · 89 tgid · 88 UNTOUCHED · 87 covered nothing");
    puts("       86 a control failed · 85 digest mismatch · 90 named fault · 84 bad arg");
    return 96;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
