# gputri.cyr — RUNG 9 of the 3D arc. The rasteriser's ring-3 instrument.
#
# ============================================================================================
# WHY THIS TOOL EXISTS AT 9a, BEFORE THE SHADER IT DRIVES
# ============================================================================================
# Rung 9 was split because its two halves have completely different costs: the op 0x08 ABI is
# provable in QEMU at zero burns (scripts/edge-abi-smoke.sh, 16 cases against the SHIPPED
# validator), while the rasteriser itself needs iron. Writing the tool in the free half means the
# burn that finally runs 9b spends its whole budget on the shader — not on discovering that the
# tool mis-packs a record.
#
# ⛔ ON A 9a KERNEL THIS EXITS 96, AND THAT IS A PASS. gpu_edge_arm() returns 0 by design until 9b
# writes the blob, so a well-formed record is rejected at residency with GPO_E_ARM. "The seam is
# live and the shader is honestly absent" and "something is broken" MUST NOT read the same, which
# is why 96 is its own exit and not folded into the failure code.
#
# ============================================================================================
# THE FOUR DISTINGUISHABLE OUTCOMES (the plan's falsification cell, in code)
# ============================================================================================
#   all-sentinel      the post-dispatch TC write-back is missing (S3 measured 4096-of-4096 stale
#                     without its coherence packet) OR the guard rejected every lane — and rung 5
#                     arm E is what says which. Reported as UNTOUCHED, never as "wrong shape".
#   wrong shape       edge setup
#   right shape,      fill rule
#   wrong edge px
#   some tiles right  tgid mapping — and the first bad tile index NAMES the mapping error
#
# ⚠ THE SENTINEL IS 0xA5, and it is distinct from 0 and from every expected coverage value on
# purpose. Prefilling with 0 would make "the shader never ran" and "the shader wrote zero
# coverage" the same reading — the single confusion this rung cannot afford, because a dead
# dispatch and an empty triangle are fixed in completely different places.
#
# Build:  cd gpu-test && cyrius build --agnos gputri.cyr build/gputri_agnos
# Iron:   run /bin/gputri --cov
#         95 coverage matches the reference · 96 seam live, shader not built (9a) · 90 named fault

include "lib/io.cyr"

fn slen(s): i64 { var n = 0; while (load8(s + n) != 0) { n = n + 1; } return n; }
fn ps(s): i64 { print(s, slen(s)); return 0; }
fn puts(s): i64 { ps(s); print("\n", 1); return 0; }
fn pnum(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var neg = 0; var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var b[24]; var i = 0;
    while (x > 0) { store8(&b + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&b + i, 1); }
    return 0;
}

var TRI_N    = 128;                  # mask is TRI_N x TRI_N, 8bpp
var SENTINEL = 0xA5;

var tri_edges[8];                    # module-scope var[N] = N x u64 = 64 B = 4 edges of 16 B
var tri_mask[2048];                  # 2048 x u64 = 16384 B ... only TRI_N*TRI_N/... see below

# ⚠ tri_mask must hold TRI_N*TRI_N = 16384 bytes. MODULE-SCOPE var[N] allocates N x u64, so
# var[2048] is 16384 BYTES — correct here. A function-local var[2048] would be 2048 bytes and
# under-size this by 8x, silently. [[cyrius-var-array-u64-units]]

# One edge: x0,y0,x1,y1 as four i32 in 16.16 fixed point. Screen space, mask-local: the mask's
# origin IS (0,0), because op 0x08 defines no dstxy — placement is a separate BLEND_COV record.
fn tri_edge(i, x0, y0, x1, y1): i64 {
    var b = &tri_edges + i * 16;
    store32(b +  0, x0 * 65536);
    store32(b +  4, y0 * 65536);
    store32(b +  8, x1 * 65536);
    store32(b + 12, y1 * 65536);
    return 0;
}

fn tri_report(reason): i64 {
    if (reason == 7) {
        puts("gputri: GPO_E_ARM -- the edge shader is not resident.");
        puts("gputri: on a rung-9a kernel this is the EXPECTED answer: the ABI seam is live,");
        puts("gputri: every field validates, and gpu_edge_arm() honestly reports that 9b has");
        puts("gputri: not written the blob yet. Nothing is broken. (exit 96)");
        return 96;
    }
    if (reason == 2)  { puts("gputri: GPO_E_BADOP -- this kernel predates op 0x08."); return 90; }
    if (reason == 3)  { puts("gputri: GPO_E_BADSLOT -- edge slot invalid or not GPU-visible."); return 90; }
    if (reason == 6)  { puts("gputri: GPO_E_DIM -- mask dimensions rejected."); return 90; }
    if (reason == 8)  { puts("gputri: GPO_E_DISPATCH -- the watchdog expired. Run gpuwedge."); return 90; }
    if (reason == 12) { puts("gputri: GPO_E_RESERVED -- a field this op does not define was non-zero."); return 90; }
    if (reason == 13) { puts("gputri: GPO_E_UNPROVEN -- the dispatch envelope is unproven this boot."); return 90; }
    if (reason == 16) { puts("gputri: GPO_E_EDGEBUF -- edge count or edge slot size rejected."); return 90; }
    if (reason == 17) { puts("gputri: GPO_E_DSTSLOT -- destination mask slot rejected."); return 90; }
    if (reason == 18) { puts("gputri: GPO_E_RULE -- winding rule rejected."); return 90; }
    if (reason == 19) { puts("gputri: GPO_E_ALIAS -- edge and destination are the same slot."); return 90; }
    ps("gputri: unexpected reason "); pnum(reason); print("\n", 1);
    return 90;
}

# Read back the mask and CLASSIFY. The classification is the whole value of this function: a bare
# "did not match" would send 9b's debugging down whichever path was guessed first.
fn tri_classify(dst_id): i64 {
    if (syscall(73, dst_id, &tri_mask, TRI_N * TRI_N) != 0) {
        puts("gputri: shm_read failed -- cannot classify."); return 90;
    }
    var untouched = 0;
    var covered   = 0;
    var i = 0;
    while (i < TRI_N * TRI_N) {
        var v = load8(&tri_mask + i) & 0xFF;
        if (v == SENTINEL) { untouched = untouched + 1; }
        if (v != SENTINEL) { if (v != 0) { covered = covered + 1; } }
        i = i + 1;
    }
    if (untouched == TRI_N * TRI_N) {
        puts("gputri: UNTOUCHED -- every byte still reads the 0xA5 sentinel.");
        puts("gputri: the dispatch retired but wrote NOTHING. Two causes, and rung 5 arm E");
        puts("gputri: is what separates them: the post-dispatch coherence packet is missing");
        puts("gputri: (S3 measured 4096-of-4096 stale without it), or the EXEC guard rejected");
        puts("gputri: every lane. This is NOT an edge-setup bug -- do not go looking there.");
        return 90;
    }
    if (covered == 0) {
        puts("gputri: WROTE, BUT COVERED NOTHING -- the shader ran and cleared the mask.");
        puts("gputri: that is a FILL RULE or edge-orientation fault, not a dispatch fault:");
        puts("gputri: the write-back demonstrably works, so the winding evaluated to zero.");
        return 90;
    }
    ps("gputri: covered "); pnum(covered); ps(" of "); pnum(TRI_N * TRI_N);
    ps(" px, untouched "); pnum(untouched); print("\n", 1);
    if (untouched != 0) {
        puts("gputri: PARTIAL -- some bytes still hold the sentinel while others were written.");
        puts("gputri: that is a TGID MAPPING fault: whole tiles were never dispatched. The");
        puts("gputri: first sentinel byte's index divided by the tile size names the tile.");
        return 90;
    }
    # 9b lands the byte-exact comparison against rung 8's reference over the 20-case corpus here.
    # Reporting 95 before that comparison exists would be the ATOM_DRY defect: a pass that names a
    # check nobody ran.
    puts("gputri: the mask was fully written and has coverage.");
    puts("gputri: ⚠ the byte-exact comparison against the rung-8 reference is 9b's bite --");
    puts("gputri: this build does NOT claim correctness, only that the seam moved bytes.");
    return 94;
}

fn tri_cov(): i64 {
    var eid = syscall(86, 4096);
    if (eid < 1) {
        puts("gputri: no GPU-visible shm (syscall 86). This tool needs the carveout -- iron only.");
        return 96;
    }
    var did = syscall(86, TRI_N * TRI_N);
    if (did < 1) { syscall(74, eid); puts("gputri: could not allocate the mask slot."); return 90; }

    # A closed 3-edge path, wound consistently. Vertices are screen-space and mask-local.
    tri_edge(0,  64,  16, 112, 100);
    tri_edge(1, 112, 100,  16, 100);
    tri_edge(2,  16, 100,  64,  16);
    if (syscall(72, eid, &tri_edges, 3 * 16) != 0) {
        syscall(74, eid); syscall(74, did);
        puts("gputri: shm_write of the edge array failed."); return 90;
    }

    # Prefill the destination with the sentinel. This is what makes "never written" readable.
    var i = 0;
    while (i < TRI_N * TRI_N / 8) { store64(&tri_mask + i * 8, 0xA5A5A5A5A5A5A5A5); i = i + 1; }
    if (syscall(72, did, &tri_mask, TRI_N * TRI_N) != 0) {
        syscall(74, eid); syscall(74, did);
        puts("gputri: shm_write of the sentinel prefill failed."); return 90;
    }

    var d[64];                                      # function-local ⇒ 64 BYTES = exactly one record
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d +  0, 8);                            # op = GPU_OP_EDGE_COV
    store32(&d +  8, did);                          # dst_id  — the 8bpp coverage mask
    store32(&d + 12, eid);                          # edge_id — the 16.16 edge array
    store32(&d + 16, (TRI_N * 65536) + TRI_N);      # wh = (h<<16)|w
    store32(&d + 36, 3);                            # n_edges = 3, rule = NONZERO (0)
    # ⛔ dword 5 (dstxy) stays ZERO. op 0x08 does not define it and the kernel REJECTS a non-zero
    # value rather than ignoring it; placement is a second BLEND_COV record's job.

    var rc = syscall(92, &d, 64);
    if (rc != 0) {
        var e = 0 - rc;
        syscall(74, eid); syscall(74, did);
        return tri_report(e & 0xFF);
    }
    var v = tri_classify(did);
    syscall(74, eid); syscall(74, did);
    return v;
}

fn main(): i64 {
    args_init();
    if (argc() >= 2) {
        var a = argv(1);
        if (streq(a, "--cov") == 1) {
            puts("gputri: RUNG 9 -- edge array -> 8bpp coverage mask via #92 op 0x08");
            return tri_cov();
        }
        # An unknown argument is an ERROR, never a default action — the typo that cost the M9 arc a
        # flash on 2026-07-24 is exactly this failure mode.
        puts("gputri: UNKNOWN ARGUMENT -- nothing was done.");
        puts("gputri: --cov");
        return 84;
    }
    puts("gputri -- RUNG 9, the edge rasteriser's instrument");
    puts("");
    puts("  run /bin/gputri --cov     rasterise one triangle into a coverage mask");
    puts("");
    puts("Exits: 95 matches the reference (9b) · 94 wrote bytes, correctness unproven");
    puts("       96 seam live, shader not built (the 9a answer) · 90 named fault · 84 bad arg");
    return 96;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
