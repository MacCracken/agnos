# === AHCI/SATA host controller — Phase 1 (read-only enumeration) ===
#
# AHCI is the modern SATA host interface — PCI class triple 0x01 / 0x06
# / 0x01 (Mass Storage / SATA / AHCI 1.0). Distinct from NVMe (0x01 /
# 0x08 / 0x02), legacy IDE (0x01 / 0x01 / *), and SCSI (0x01 / 0x00).
# Reference: Intel AHCI 1.3.1 spec + Linux's `drivers/ata/libahci.c`
# `ahci_save_initial_config` + `ahci_port_intr` paths.
#
# Phase 1 is pure read-only enumeration: locate the HBA via PCI class
# probe, remap BAR5 (AHCI Base = ABAR — NOT BAR0 — distinct from NVMe
# which uses BAR0), enable bus mastering, read CAP / VS / PI / GHC,
# decode capability fields, walk the PI bitmap to identify port-status
# for each implemented port (DET = device detection, SIG = device
# signature → SATA / ATAPI / port-multiplier / SEMB classification).
#
# Phase 1 explicitly out of scope (Phase 2+ territory):
#   - HBA reset (GHC.HR=1, poll-clear)
#   - AHCI-mode set if firmware left controller in legacy mode (GHC.AE=1)
#   - Per-port command-list + FIS-receive allocation (32 entries × 32 B
#     command-list + 256-B FIS buffer per port, both 1 KB-aligned)
#   - Per-port spin-up (PxCMD.SUD=1) + start (PxCMD.ST=1)
#   - IDENTIFY DEVICE (ATA cmd 0xEC) → model / serial / firmware /
#     LBA48 capacity
#   - READ DMA EXT (cmd 0x25) / WRITE DMA EXT (cmd 0x35)
#   - block-layer registration (`blk_register_ahci`) — adds the third
#     backend to block.cyr's tag-dispatch
#   - MSI/MSI-X — staying with polling per the xhci + nvme precedent
#
# CMOS checkpoints: 0x4B (HBA probe done — CAP/GHC/VS decoded), 0x4C
# (port enumeration done — every implemented port's SSTS/SIG read).
# Continues the storage-arc sequence 0x40-0x48 (NVMe) / 0x49-0x4A
# (GPT) / 0x4B-0x4C (AHCI). Same CMOS slot 0x50, progressive values.
#
# No-op if no AHCI controller is present on the PCI bus — typical for
# pure-NVMe boxes (QEMU NVMe-only smoke) and for `nvme0`-as-only-disk
# configurations. Iron archaemenid has both: M.2 NVMe (Crucial P3 at
# `nvme0`, iron-validated Attempt 80) AND a 2.5" SATA SSD 1.8 TB on
# `sda` — the AHCI surface AGNOS first sees in iron will be this `sda`.

# --- AHCI register offsets (from ABAR base, per AHCI 1.3.1 §3.1) ----

var AHCI_REG_CAP   = 0x00;   # Host Capabilities
var AHCI_REG_GHC   = 0x04;   # Global Host Control
var AHCI_REG_IS    = 0x08;   # Interrupt Status (RWC bitmap)
var AHCI_REG_PI    = 0x0C;   # Ports Implemented (bitmap; bit i = port i present)
var AHCI_REG_VS    = 0x10;   # AHCI Version
var AHCI_REG_CAP2  = 0x24;   # Host Capabilities Extended (AHCI 1.2+)
var AHCI_REG_BOHC  = 0x28;   # BIOS/OS Handoff Control (AHCI 1.2+)

# Per-port register block — base at ABAR + 0x100 + port_id * 0x80
var AHCI_PORT_BASE   = 0x100;
var AHCI_PORT_STRIDE = 0x80;
# Per-port register offsets within each port's 0x80-byte block:
var AHCI_P_CLB   = 0x00;   # Command List Base (low 32)
var AHCI_P_CLBU  = 0x04;   # Command List Base (high 32, AHCI S64A only)
var AHCI_P_FB    = 0x08;   # FIS Base (low 32)
var AHCI_P_FBU   = 0x0C;   # FIS Base (high 32)
var AHCI_P_IS    = 0x10;   # Interrupt Status
var AHCI_P_IE    = 0x14;   # Interrupt Enable
var AHCI_P_CMD   = 0x18;   # Command and Status
var AHCI_P_TFD   = 0x20;   # Task File Data
var AHCI_P_SIG   = 0x24;   # Device Signature
var AHCI_P_SSTS  = 0x28;   # SATA Status (DET / SPD / IPM)
var AHCI_P_SCTL  = 0x2C;   # SATA Control
var AHCI_P_SERR  = 0x30;   # SATA Error
var AHCI_P_SACT  = 0x34;   # SATA Active
var AHCI_P_CI    = 0x38;   # Command Issue

# AHCI device-signature constants (PxSIG, AHCI 1.3.1 §3.3.7).
var AHCI_SIG_ATA   = 0x00000101;   # SATA HDD/SSD (most common)
var AHCI_SIG_ATAPI = 0xEB140101;   # SATA optical / removable
var AHCI_SIG_SEMB  = 0xC33C0101;   # SATA enclosure mgmt bridge
var AHCI_SIG_PM    = 0x96690101;   # SATA port multiplier

# --- Module state ----------------------------------------------------

var ahci_present     = 0;
var ahci_pci_idx     = 0;
var ahci_mmio_base   = 0;
var ahci_cap         = 0;
var ahci_cap2        = 0;
var ahci_ghc         = 0;
var ahci_pi          = 0;
var ahci_vs          = 0;
var ahci_ver_major   = 0;
var ahci_ver_minor   = 0;
var ahci_np          = 0;     # Number of Ports (zero-based, +1 = actual)
var ahci_ncs         = 0;     # Number of Command Slots (zero-based, +1)
var ahci_iss         = 0;     # Interface Speed Support (1/2/3 = 1.5/3/6 Gbps)
var ahci_s64a        = 0;     # Supports 64-bit addressing
var ahci_sam         = 0;     # Supports AHCI mode only (no legacy IDE switch)
var ahci_sss         = 0;     # Supports Staggered Spin-up
var ahci_sncq        = 0;     # Supports Native Command Queuing
var ahci_devices_found = 0;   # Count of ports with DET=3 (device present + comm)

# --- MMIO accessors --------------------------------------------------
#
# load32 against AHCI ABAR — mirrors nvme.cyr's "never load64 on MMIO"
# discipline applied to the AHCI register surface. AHCI 1.3.1 §3.1 is
# explicit that all HBA registers are 32-bit access; doubleword loads
# only.

fn ahci_mmio_read32(off) {
    return load32(ahci_mmio_base + off);
}

fn ahci_mmio_write32(off, val) {
    store32(ahci_mmio_base + off, val);
    return 0;
}

# --- Phase 1: probe --------------------------------------------------
#
# Returns 1 if an AHCI controller was located, BAR5 was non-zero, and
# CAP/GHC/VS/PI were successfully decoded. Returns 0 on:
#   - no AHCI device on the PCI bus (pci_find_by_class < 0)
#   - BAR5 == 0 (firmware did not assign — corrupt PCI config)
# Either is a normal no-op condition, not an error.

fn ahci_probe() {
    # 1. PCI class probe. AHCI 1.0 is class=0x01, subclass=0x06,
    #    prog_if=0x01 — see PCI Code & ID Assignment Spec §B.7.
    #    Distinct from RAID (0x04), legacy IDE (0x01), SCSI (0x00).
    var idx = pci_find_by_class(0x01, 0x06, 0x01);
    if (idx < 0) {
        kprintln("ahci: no controller found", 25);
        return 0;
    }

    # 2. Fetch BAR5 (ABAR = AHCI Base) — distinct from NVMe's BAR0.
    #    AHCI 1.3.1 §2.1.11: BAR5 is the canonical ABAR location, and
    #    is the only BAR a spec-compliant AHCI controller uses for
    #    its register interface.
    var abar = pci_bar_64(idx, 5);
    if (abar == 0) {
        kprintln("ahci: BAR5 is zero (firmware did not assign)", 44);
        return 0;
    }

    # 3. Enable bus mastering + memory space access. Symmetric to NVMe
    #    Phase 1's invocation; firmware usually leaves it set but we
    #    assert it for defensive boot-state hygiene.
    pci_enable_bus_master_idx(idx);

    # 4. Cache the probe before any register access.
    ahci_present   = 1;
    ahci_pci_idx   = idx;
    ahci_mmio_base = abar;

    # 5. Remap ABAR's 2 MB chunk as UC. Boot identity map leaves BARs
    #    at PAT entry 0 = WB; AHCI MMIO cannot be cached. Same call
    #    nvme_probe + xhci_init use.
    vmm_remap_uc_2mb(abar);

    # 6. Read CAP. Decode the fields we care about for Phase 1:
    #    NP  (bits  0-4): Number of Ports (zero-based)
    #    NCS (bits  8-12): Number of Command Slots (zero-based)
    #    ISS (bits 20-23): Interface Speed Support (1.5/3/6 Gbps)
    #    SAM (bit 18): Supports AHCI Mode only
    #    SSS (bit 27): Supports Staggered Spin-up
    #    SNCQ (bit 30): Supports Native Command Queuing
    #    S64A (bit 31): Supports 64-bit Addressing
    ahci_cap   = ahci_mmio_read32(AHCI_REG_CAP);
    ahci_np    = ahci_cap & 0x1F;
    ahci_ncs   = (ahci_cap >> 8) & 0x1F;
    ahci_iss   = (ahci_cap >> 20) & 0x0F;
    ahci_sam   = (ahci_cap >> 18) & 0x01;
    ahci_sss   = (ahci_cap >> 27) & 0x01;
    ahci_sncq  = (ahci_cap >> 30) & 0x01;
    ahci_s64a  = (ahci_cap >> 31) & 0x01;

    # 7. Read GHC. Bits we observe (none of these are written in Phase 1):
    #    AE  (bit 31): AHCI Enable
    #    IE  (bit 1): Interrupt Enable
    #    HR  (bit 0): HBA Reset (reads 1 while reset in progress)
    ahci_ghc = ahci_mmio_read32(AHCI_REG_GHC);

    # 8. Read PI (Ports Implemented). Bitmap — bit i = port i is
    #    implemented in the silicon. Note: implemented ≠ has-device;
    #    that's PxSSTS.DET, read in ahci_enum_ports.
    ahci_pi = ahci_mmio_read32(AHCI_REG_PI);

    # 9. Read VS. AHCI 1.3.1 §3.1.5 layout:
    #    bits 31-16: Major
    #    bits 15-0:  Minor
    ahci_vs        = ahci_mmio_read32(AHCI_REG_VS);
    ahci_ver_major = (ahci_vs >> 16) & 0xFFFF;
    ahci_ver_minor = ahci_vs & 0xFFFF;

    # 10. Report. Two lines: discovery + capability summary. Same
    #     shape as nvme_probe's two-line print.
    kprint("ahci: found at ", 15);
    kprint_num(abar);
    kprint(", version=", 10);
    kprint_num(ahci_ver_major);
    kprint(".", 1);
    kprint_num(ahci_ver_minor);
    kprintln("", 0);

    kprint("ahci: NP=", 9);
    kprint_num(ahci_np + 1);
    kprint(" NCS=", 5);
    kprint_num(ahci_ncs + 1);
    kprint(" ISS=", 5);
    kprint_num(ahci_iss);
    kprint(" SAM=", 5);
    kprint_num(ahci_sam);
    kprint(" SSS=", 5);
    kprint_num(ahci_sss);
    kprint(" SNCQ=", 6);
    kprint_num(ahci_sncq);
    kprint(" S64A=", 6);
    kprint_num(ahci_s64a);
    kprintln("", 0);

    kprint("ahci: GHC=", 10);
    kprint_num(ahci_ghc);
    kprint(" PI=", 4);
    kprint_num(ahci_pi);
    kprintln("", 0);

    # CMOS kcp = 0x4B (AHCI HBA probe completed).
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x4B; 0xE6; 0x71; }
    return 1;
}

# --- Phase 1: port enumeration ---------------------------------------
#
# Walk the PI bitmap, read SSTS + SIG for each implemented port,
# classify device class. Read-only — no PxCMD reset / spin-up / CL+FIS
# allocation. The PxCMD register IS read for state visibility but never
# written; Phase 2 owns the bring-up sequence.
#
# SSTS.DET decode (AHCI 1.3.1 §3.3.10):
#   0 = No device, no PHY communication
#   1 = Device present, no PHY communication (handshake failure)
#   3 = Device present, PHY communication established (operational)
#   4 = Offline mode (loopback / BIST in progress)
#
# Returns the count of ports with DET=3 (device present + comm).

fn ahci_enum_ports() {
    if (ahci_present == 0) { return 0; }

    var count = 0;
    var port  = 0;
    var max_port = ahci_np + 1;   # NP is zero-based
    if (max_port > 32) { max_port = 32; }   # PI is a 32-bit bitmap; defensive cap

    while (port < max_port) {
        var bit_set = (ahci_pi >> port) & 0x01;
        if (bit_set == 1) {
            var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
            var ssts     = ahci_mmio_read32(port_off + AHCI_P_SSTS);
            var sig      = ahci_mmio_read32(port_off + AHCI_P_SIG);
            var det      = ssts & 0x0F;
            var spd      = (ssts >> 4) & 0x0F;

            kprint("ahci: port ", 11);
            kprint_num(port);
            kprint(" DET=", 5);
            kprint_num(det);
            kprint(" SPD=", 5);
            kprint_num(spd);
            kprint(" SIG=", 5);
            kprint_num(sig);

            if (det == 3) {
                count = count + 1;
                if (sig == AHCI_SIG_ATA) {
                    kprintln(" (SATA)", 7);
                } else {
                    if (sig == AHCI_SIG_ATAPI) {
                        kprintln(" (ATAPI)", 8);
                    } else {
                        if (sig == AHCI_SIG_SEMB) {
                            kprintln(" (SEMB)", 7);
                        } else {
                            if (sig == AHCI_SIG_PM) {
                                kprintln(" (port multiplier)", 18);
                            } else {
                                kprintln(" (unknown sig)", 14);
                            }
                        }
                    }
                }
            } else {
                if (det == 0) {
                    kprintln(" (no device)", 12);
                } else {
                    kprintln(" (PHY handshake incomplete)", 27);
                }
            }
        }
        port = port + 1;
    }

    ahci_devices_found = count;
    # CMOS kcp = 0x4C (AHCI port enumeration done).
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x4C; 0xE6; 0x71; }
    return count;
}

# === AHCI Phase 2 — HBA reset + per-port bring-up ====================
#
# Per AHCI 1.3.1 §10.1.2 system-software initialization sequence:
#   1. Indicate AHCI awareness (GHC.AE=1) — usually firmware-set, we
#      re-assert.
#   2. Optionally reset the HBA (GHC.HR=1 → poll until cleared by HW).
#      We perform reset to ensure a known-state baseline regardless of
#      what gnoboot/UEFI left behind.
#   3. Re-set GHC.AE=1 (reset clears it).
#   4. For each implemented + DET=3 SATA port:
#       a. PxCMD.ST=0 (in case firmware started it; defensive)
#       b. wait PxCMD.CR=0
#       c. PxCMD.FRE=0
#       d. wait PxCMD.FR=0
#       e. allocate command list (1 KB, 1 KB-aligned) — pmm_alloc gives
#          a 4 KB-aligned page; 1 KB alignment is satisfied trivially.
#          Use only the first 1 KB; the remaining 3 KB of the page is
#          intentional waste in Phase 2 (Phase 4 may pack per-port
#          PRDT scratch into it; not now).
#       f. allocate FIS receive area (256 B, 256 B-aligned) — same
#          allocator, same alignment guarantee.
#       g. zero both pages.
#       h. write PxCLB/PxCLBU (CL base 64-bit) and PxFB/PxFBU.
#       i. clear PxSERR by writing 0xFFFFFFFF (W1C).
#       j. PxCMD.FRE=1, wait PxCMD.FR=1.
#       k. PxCMD.SUD=1 if CAP.SSS=1 (cold spin-up). If SSS=0 the bit is
#          RO=1 (HW always spun up); write is no-op.
#       l. wait for PxTFD.STS.BSY=0 && DRQ=0 (device ready for commands)
#       m. PxCMD.ST=1 (begin processing commands).
#       n. wait PxCMD.CR=1.
#
# ATAPI ports (SIG=0xEB140101) are SKIPPED in Phase 2 — same command
# infrastructure but different command-set semantics; iron archaemenid
# has no ATAPI, so no functional regression. Phase 5+ (if ever) can
# wire CD/DVD support.
#
# CMOS checkpoints: 0x4D (HBA reset cleared), 0x4E (all SATA ports
# initialized — every DET=3+SIG=SATA port that survived port-init).

var AHCI_MAX_PORTS    = 32;
# ⛔ 1.57.8 (DMA1): CPU pointers into the pmm DMA pages (command list, command table, IDENTIFY buffer) are their
# DIRECT-MAP aliases (dma_kva). ahci_issue_rw runs from fs syscalls under the caller's CR3, where a ring-3
# PT_LOAD in [0x400000, 0x10000000) can shadow a pmm page's identity VA. A `*_phys` value only goes into PxCLB/
# PxFB, a command header's CTBA or a PRDT's DBA. (Issue 2026-09-25-dma-cpu-pointers-still-use-identity-vas.)
var ahci_port_cl_kva[256];      # 32 ports × 8 bytes per u64 — command list CPU pointer (direct map)
var ahci_port_fis_phys[256];    # 32 ports × 8 bytes per u64
var ahci_port_inited[32];       # 32 × u8 flag
var ahci_ports_inited_count = 0;

# Init-time register waits (ahci_port_init's bring-up) keep the 1M-iteration ceiling NVMe + xhci use.
var AHCI_TIMEOUT_SPINS = 1000000;

# ⛔ 1.57.9 — A COMMAND THAT TIMES OUT IS NOT OVER UNTIL THE PORT'S ENGINE IS PROVEN STOPPED.
# (docs/development/issues/2026-09-25-ahci-timeout-abandons-an-in-flight-command.md; docs/architecture/ahci-command-recovery.md)
# Until 1.57.9 each command poll was an ITERATION count (1M MMIO spins, FLUSH 30M) and on a stuck PxCI or a PxTFD.ERR it
# returned 0 with ST=1 and PxCI still set. The PRDT points at the CALLER's buffer, so the device could DMA into memory
# the caller had already reused, and the next command rewrote slot 0's header and the CT under a command the HBA still
# owned. After a TFES the HBA halts with CI set, so every later issue failed ahci_port_wait_idle for the rest of the boot.
# Now: (1) the budgets are WALL TIME on klog_uptime_us() (a spin backstop of budget*64 while the TSC is uncalibrated,
# as nvme_io_poll_n): 5 s per R/W and IDENTIFY, 30 s per FLUSH (Linux's ATA_EH_CMD_DFL_TIMEOUT and FLUSH retry budget).
# (2) A timeout or an error runs AHCI 1.3.1 §6.2.2.1 BEFORE the issue path returns (ahci_port_recover: ST=0 and wait
# CR=0, so the HBA clears PxCI and its DMA engine is idle; clear SERR/IS; COMRESET if BSY/DRQ; ST=1), inside the same
# ahci_lock hold, so no caller ever gets a buffer back from a live command. (3) If the engine will not stop, a COMRESET
# and then an HBA reset (GHC.HR) end its DMA and the ports go OFFLINE (ahci_port_dead): every later issue fails fast
# before it touches slot 0, the CT or a buffer. That flag is the only "late" record: unlike NVMe, AHCI can cancel a
# command from the host, so a timed-out command is settled synchronously instead of being reaped later.
var AHCI_IO_BUDGET_US    = 5000000;     # 5 s per READ/WRITE DMA EXT and per IDENTIFY
var AHCI_FLUSH_BUDGET_US = 30000000;    # 30 s per FLUSH CACHE EXT (a large write cache; ATA8-ACS)
var AHCI_STOP_BUDGET_US  = 500000;      # PxCMD.CR / FR follow ST / FRE within 500 ms (§10.1.2; Linux ahci_stop_engine)
var AHCI_IDLE_BUDGET_US  = 1000000;     # the pre-issue gate (BSY/DRQ, PxCI, PxSACT clear)
var AHCI_LINK_BUDGET_US  = 1000000;     # PxSSTS.DET=3 after a COMRESET; GHC.HR clear after an HBA reset (§10.4)
var AHCI_IS_ERR          = 0x78000000;  # PxIS TFES(30) | HBFS(29) | HBDS(28) | IFS(27): the command failed
var ahci_port_dead[4];                  # 32 x u8: 1 = port OFFLINE (engine would not restart / link lost / HBA reset)
# Recovery events: recorded under ahci_lock, printed by the lock wrappers AFTER unlock (no kprint under ahci_lock).
var AHCI_N_TIMEOUT  = 1;     # the budget ran out with PxCI still set
var AHCI_N_ERROR    = 2;     # PxIS reported an error (TFES / HBFS / HBDS / IFS)
var AHCI_N_NOTIDLE  = 4;     # the port was not idle before an issue
var AHCI_N_COMRESET = 8;     # a COMRESET was sent (BSY/DRQ stuck, or the engine would not stop)
var AHCI_N_OFFLINE  = 16;    # the port was taken offline
var AHCI_N_HBA      = 32;    # the engine would not stop even after a COMRESET: GHC.HR, every port offline
var AHCI_N_HBASTUCK = 64;    # ... and GHC.HR did not clear: the HBA's DMA is NOT proven stopped
var AHCI_N_LATEOK   = 128;   # the budget ran out, but a last look found the command complete
var AHCI_N_RECOVERED = 256;  # ahci_port_recover brought the port back (engine stopped, PxCI clear, restarted)
var ahci_note       = 0;     # events of the current lock hold
var ahci_last_note  = 0;     # the events of the last completed wrapper call (read by AHCI_SELFTEST)
var ahci_test_stuck = 0;     # AHCI_SELFTEST 'lost' arm ONLY: ahci_engine_stop really stops, then REPORTS "still running"

# 1 once `budget_us` has passed since t0 (a klog_uptime_us() reading). t0 == 0 means the TSC is not calibrated yet,
# and then `spins` (the caller's loop count, one MMIO read per spin) is the bound: budget*64, nvme_io_poll_n's backstop.
fn ahci_expired(t0, spins, budget_us) {
    if (t0 > 0) {
        if ((klog_uptime_us() - t0) >= budget_us) { return 1; }
        return 0;
    }
    if (spins >= budget_us * 64) { return 1; }
    return 0;
}

# Poll the 32-bit register at ABAR+off until (value & mask) == want, for up to budget_us of wall time. 1 = seen,
# 0 = not seen. One last read after the deadline, so a register that settled right at it is not reported stuck.
fn ahci_wait_reg(off, mask, want, budget_us) {
    var wt0 = klog_uptime_us();
    var wsp = 0;
    while (ahci_expired(wt0, wsp, budget_us) == 0) {
        if ((ahci_mmio_read32(off) & mask) == want) { return 1; }
        wsp = wsp + 1;
    }
    if ((ahci_mmio_read32(off) & mask) == want) { return 1; }
    return 0;
}

# Wait at least `us` microseconds. One PxSSTS read per spin, so the uncalibrated backstop is paced by the bus.
fn ahci_delay_us(port_off, us) {
    var dt0 = klog_uptime_us();
    var dsp = 0;
    while (ahci_expired(dt0, dsp, us) == 0) {
        ahci_mmio_read32(port_off + AHCI_P_SSTS);
        dsp = dsp + 1;
    }
    return 0;
}

# ST=0, then wait for CR (the command-list DMA engine) to clear. QUIET (recovery calls it under ahci_lock; the shutdown
# path's ahci_port_stop prints its own result). 1 = stopped: the HBA has cleared PxCI (§3.3.14) and does no more DMA for
# this port. 0 = CR still set, or the register reads all-ones (the HBA is gone). Already stopped (ST and CR clear)
# returns at once, like Linux's ahci_stop_engine.
fn ahci_engine_stop(port_off, budget_us) {
    var cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    if (cmd == 0xFFFFFFFF) { return 0; }
    var stopped = 1;
    if ((cmd & 0x8001) != 0) {
        ahci_mmio_write32(port_off + AHCI_P_CMD, cmd & 0xFFFFFFFE);
        stopped = ahci_wait_reg(port_off + AHCI_P_CMD, 0x8000, 0, budget_us);
    }
    if (ahci_test_stuck != 0) { stopped = 0; }   # AHCI_SELFTEST 'lost': the stop is REAL, the report says it failed
    return stopped;
}

# CAP fields not previously cached — needed in Phase 2 logic.
fn ahci_cap_sss() { return (ahci_cap >> 27) & 0x01; }

# --- HBA reset --------------------------------------------------------

# The HBA reset itself, QUIET (1.57.9: ahci_port_recover escalates to it under ahci_lock, where nothing may kprint).
# 1. GHC.AE=1 before the reset (§10.1.2 step 1). 2. GHC.HR=1; the HBA clears it when the reset is done — within 1 s
# (§10.4.3), on wall time. 3. Re-assert AE (the reset clears it). 1 = reset done, 0 = GHC.HR stuck.
fn ahci_hba_reset_quiet() {
    var ghc = ahci_mmio_read32(AHCI_REG_GHC);
    ahci_mmio_write32(AHCI_REG_GHC, ghc | 0x80000000);
    ghc = ahci_mmio_read32(AHCI_REG_GHC);
    ahci_mmio_write32(AHCI_REG_GHC, ghc | 0x01);
    if (ahci_wait_reg(AHCI_REG_GHC, 0x01, 0, AHCI_LINK_BUDGET_US) == 0) { return 0; }
    ghc = ahci_mmio_read32(AHCI_REG_GHC) | 0x80000000;
    ahci_mmio_write32(AHCI_REG_GHC, ghc);
    ahci_ghc = ghc;
    return 1;
}

fn ahci_hba_reset() {
    if (ahci_present == 0) { return 0; }
    if (ahci_hba_reset_quiet() == 1) {
        # CMOS kcp = 0x4D (HBA reset cleared, AE re-asserted).
        # asm contract: no inputs, no outputs; mov al,0x50 / out 0x70,al (CMOS index) / mov al,0x4D / out 0x71,al
        # (CMOS data). Clobbers al only.
        asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x4D; 0xE6; 0x71; }
        kprintln("ahci: HBA reset complete, AE=1", 30);
        return 1;
    }
    kprintln("ahci: HBA reset timeout (GHC.HR stuck)", 38);
    return 0;
}

# --- Per-port command-list + FIS init --------------------------------

# Shutdown arc bite 4 — stop a port's DMA engines, AND SAY WHETHER IT WORKED.
#
# This is steps a-d of ahci_port_init below, lifted out. The reason it is a separate
# function rather than a call into that one is the RETURN STATUS: the inline version
# leaves its wait loops by assigning `spins = AHCI_TIMEOUT_SPINS`, which is
# byte-identical to having timed out, so no caller can tell whether the engine
# actually stopped.
#
# At init that ambiguity is harmless — the port is about to be reprogrammed anyway.
# At SHUTDOWN it is not: the command-list and FIS-receive buffers are physical pages
# the HBA writes into by DMA, and freeing or reusing them while CR/FR are still set
# hands live DMA targets back to the allocator. Silent 8-byte scribbles into
# whatever lands there next is exactly the class of corruption that is impossible to
# diagnose afterwards. Returns 1 = stopped, 0 = still running (caller must NOT
# reclaim the buffers).
# 1.57.9: both waits are the shared wall-time ones (500 ms each, AHCI §10.1.2), and the ST/CR half is
# ahci_engine_stop, the same quiet helper error recovery uses under ahci_lock.
fn ahci_port_stop(port) {
    var port_off = 0;
    var cmd = 0;

    if (ahci_present == 0) { return 0; }
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;

    # ST=0, then wait for CR (command-list running) to clear.
    if (ahci_engine_stop(port_off, AHCI_STOP_BUDGET_US) == 0) {
        kprint("ahci: port ", 11); kprint_num(port);
        kprintln(" command engine still running", 29);
        return 0;
    }

    # FRE=0, then wait for FR (FIS receive running) to clear.
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd & 0xFFFFFFEF);
    if (ahci_wait_reg(port_off + AHCI_P_CMD, 0x4000, 0, AHCI_STOP_BUDGET_US) == 0) {
        kprint("ahci: port ", 11); kprint_num(port);
        kprintln(" fis receive still running", 26);
        return 0;
    }

    kprint("ahci: port ", 11); kprint_num(port);
    kprintln(" stopped", 8);
    return 1;
}

fn ahci_port_init(port) {
    if (ahci_present == 0) { return 0; }
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }

    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;

    # a. PxCMD.ST=0 (defensive; firmware might have started it).
    var cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    cmd = cmd & 0xFFFFFFFE;     # clear ST (bit 0)
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd);

    # b. Wait for PxCMD.CR=0 (command-list running clear).
    var spins = 0;
    while (spins < AHCI_TIMEOUT_SPINS) {
        var c = ahci_mmio_read32(port_off + AHCI_P_CMD);
        if ((c >> 15 & 0x01) == 0) { spins = AHCI_TIMEOUT_SPINS; }
        else { spins = spins + 1; }
    }

    # c. PxCMD.FRE=0.
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    cmd = cmd & 0xFFFFFFEF;     # clear FRE (bit 4)
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd);

    # d. Wait for PxCMD.FR=0.
    spins = 0;
    while (spins < AHCI_TIMEOUT_SPINS) {
        var c = ahci_mmio_read32(port_off + AHCI_P_CMD);
        if ((c >> 14 & 0x01) == 0) { spins = AHCI_TIMEOUT_SPINS; }
        else { spins = spins + 1; }
    }

    # e+f. Allocate command list (1 KB used of a 4 KB page) and FIS
    #      receive (256 B used of a 4 KB page). pmm_alloc returns
    #      4 KB-aligned phys; 1 KB / 256 B alignment is trivially OK.
    var cl_phys  = pmm_alloc();
    var fis_phys = pmm_alloc();
    if (cl_phys == 0) { return 0; }
    if (fis_phys == 0) { return 0; }

    # g. Zero both pages. Single-byte stores in a loop — slow but
    #    used only once per port at init.
    var cl_kva  = dma_kva(cl_phys);
    var fis_kva = dma_kva(fis_phys);
    var i = 0;
    while (i < 1024) { store8(cl_kva + i, 0); i = i + 1; }
    i = 0;
    while (i < 256) { store8(fis_kva + i, 0); i = i + 1; }

    # Cache the CL's CPU pointer and the FIS phys by port index for later phases.
    store64(&ahci_port_cl_kva + port * 8, cl_kva);
    store64(&ahci_port_fis_phys + port * 8, fis_phys);

    # h. Program PxCLB / PxCLBU (CL base) and PxFB / PxFBU (FIS base).
    #    Split 64-bit phys into two 32-bit halves — same posture as
    #    NVMe's ASQ/ACQ programming. The "& 0xFFFFFFFF" mask is
    #    redundant but documents intent.
    ahci_mmio_write32(port_off + AHCI_P_CLB,  cl_phys & 0xFFFFFFFF);
    ahci_mmio_write32(port_off + AHCI_P_CLBU, (cl_phys >> 32) & 0xFFFFFFFF);
    ahci_mmio_write32(port_off + AHCI_P_FB,   fis_phys & 0xFFFFFFFF);
    ahci_mmio_write32(port_off + AHCI_P_FBU,  (fis_phys >> 32) & 0xFFFFFFFF);

    # i. Clear PxSERR (W1C — writing 1 to each bit clears it).
    ahci_mmio_write32(port_off + AHCI_P_SERR, 0xFFFFFFFF);

    # j. PxCMD.FRE=1, wait PxCMD.FR=1.
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    cmd = cmd | 0x10;           # set FRE (bit 4)
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd);

    spins = 0;
    while (spins < AHCI_TIMEOUT_SPINS) {
        var c = ahci_mmio_read32(port_off + AHCI_P_CMD);
        if ((c >> 14 & 0x01) == 1) { spins = AHCI_TIMEOUT_SPINS; }
        else { spins = spins + 1; }
    }

    # k. PxCMD.SUD=1 if CAP.SSS=1. If SSS=0 the bit is RO; write is
    #    effectively a no-op so we always issue it (defensive).
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    cmd = cmd | 0x02;           # set SUD (bit 1)
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd);

    # l. Wait for PxTFD.STS.BSY=0 (bit 7) && DRQ=0 (bit 3). Device-
    #    ready gate before issuing commands. Short spin — device is
    #    usually already idle on a healthy SATA SSD.
    spins = 0;
    while (spins < AHCI_TIMEOUT_SPINS) {
        var tfd = ahci_mmio_read32(port_off + AHCI_P_TFD);
        var stat = tfd & 0xFF;
        if ((stat & 0x88) == 0) { spins = AHCI_TIMEOUT_SPINS; }
        else { spins = spins + 1; }
    }

    # m. PxCMD.ST=1 — begin processing commands.
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    cmd = cmd | 0x01;           # set ST (bit 0)
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd);

    # n. Wait PxCMD.CR=1 (command-list running).
    spins = 0;
    while (spins < AHCI_TIMEOUT_SPINS) {
        var c = ahci_mmio_read32(port_off + AHCI_P_CMD);
        if ((c >> 15 & 0x01) == 1) { spins = AHCI_TIMEOUT_SPINS; }
        else { spins = spins + 1; }
    }

    store8(&ahci_port_inited + port, 1);
    ahci_ports_inited_count = ahci_ports_inited_count + 1;

    kprint("ahci: port ", 11);
    kprint_num(port);
    kprint(" initialized (CL @ ", 19);
    kprint_num(cl_phys);
    kprint(", FIS @ ", 8);
    kprint_num(fis_phys);
    kprintln(")", 1);
    return 1;
}

# --- AHCI Phase 2 main entry -----------------------------------------
#
# Drives reset + walks the PI bitmap, calling `ahci_port_init` for
# every implemented SATA port (DET=3 + SIG=0x00000101). ATAPI / PM /
# SEMB / no-device ports are skipped. Returns the count of successfully
# initialized SATA ports.

fn ahci_init_all() {
    if (ahci_present == 0) { return 0; }
    # HBA reset is OPTIONAL per AHCI 1.3.1 §10.1.2 — gnoboot/UEFI leaves
    # the controller in AHCI-mode + AE=1 + ports PHY-handshaked, so we
    # trust that handoff state and skip the reset (which would invalidate
    # the PHY links + force per-port DET=3 wait + SIG re-stabilization,
    # all for no gain at Phase 2). `ahci_hba_reset` stays defined for
    # Phase 3+ consumers that need a known-state baseline.
    # Defensive: re-assert GHC.AE=1 in case some firmware path left it
    # cleared. Cheap, idempotent.
    var ghc = ahci_mmio_read32(AHCI_REG_GHC);
    if ((ghc & 0x80000000) == 0) {
        ghc = ghc | 0x80000000;
        ahci_mmio_write32(AHCI_REG_GHC, ghc);
    }

    var inited   = 0;
    var port     = 0;
    var max_port = ahci_np + 1;
    if (max_port > AHCI_MAX_PORTS) { max_port = AHCI_MAX_PORTS; }

    while (port < max_port) {
        var bit_set = (ahci_pi >> port) & 0x01;
        if (bit_set == 1) {
            var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
            var ssts     = ahci_mmio_read32(port_off + AHCI_P_SSTS);
            var sig      = ahci_mmio_read32(port_off + AHCI_P_SIG);
            var det      = ssts & 0x0F;
            # Only initialize SATA HDDs/SSDs in Phase 2 — ATAPI gets
            # a separate command-set track (Phase 5+ if ever).
            if (det == 3) {
                if (sig == AHCI_SIG_ATA) {
                    if (ahci_port_init(port) == 1) {
                        inited = inited + 1;
                    }
                }
            }
        }
        port = port + 1;
    }

    # CMOS kcp = 0x4E (per-port init done).
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x4E; 0xE6; 0x71; }
    return inited;
}

# === AHCI Phase 3 — IDENTIFY DEVICE ==================================
#
# First command issued through the Phase 2 CL+FIS infrastructure. ATA
# command 0xEC (IDENTIFY DEVICE) — the SATA equivalent of NVMe's
# IDENTIFY CTRL — returns a 512-byte data block describing the drive
# (model / serial / firmware / LBA48 capacity / sector size).
#
# Command path (AHCI 1.3.1 §5 + ATA/ATAPI-8 §7.16):
#   1. Allocate a Command Table (CT) per port — variable size; for
#      IDENTIFY we need 80 B header + 16 B for one PRDT entry = 96 B.
#      pmm_alloc returns 4 KB; we use the first 128 B of it. The
#      remaining 3.875 KB is intentional waste until a multi-PRDT
#      command (Phase 4 multi-LBA read) consumes it.
#   2. Allocate a 512-B IDENTIFY data buffer (4 KB page, first 512 B
#      used).
#   3. Build an H2D Register FIS (20 B) at CT+0:
#       byte 0: 0x27 (FIS type = H2D Register)
#       byte 1: 0x80 (bit 7 = Command, bits 0-3 = PM port = 0)
#       byte 2: 0xEC (IDENTIFY DEVICE opcode)
#       bytes 3-15: zeros (no LBA / no count / no features for IDENTIFY)
#   4. Build PRDT[0] at CT+0x80 (16 B):
#       bytes 0-3:  DBA  = data_phys low 32
#       bytes 4-7:  DBAU = data_phys high 32
#       bytes 8-11: reserved (0)
#       bytes 12-15: bits 0-21 = DBC = 511 (= byte_count - 1), bit 31 = I (interrupt, 0)
#   5. Build Command Header (CL slot 0, 32 B):
#       bytes 0-1:  bits 0-4 = CFL = 5 (H2D FIS is 5 DWORDs), bit 6 = W = 0 (read)
#       bytes 2-3:  PRDTL = 1 (one PRDT entry)
#       bytes 4-7:  PRDBC = 0 (HBA fills on completion)
#       bytes 8-11: CTBA = CT phys low 32
#       bytes 12-15: CTBAU = CT phys high 32
#       bytes 16-31: reserved (0)
#   6. Set PxCI bit 0 (Command Issue slot 0) — kick the command.
#   7. Poll PxCI bit 0 to clear (command consumed by HBA + completed
#      by device). Also check PxIS / PxTFD for error state.
#   8. Decode IDENTIFY data:
#       words 10-19 (off 20-39): Serial Number (20 ASCII, byte-swapped per word)
#       words 23-26 (off 46-53): Firmware Revision (8 ASCII, byte-swapped)
#       words 27-46 (off 54-93): Model Number (40 ASCII, byte-swapped)
#       words 60-61 (off 120-123): LBA28 sector count (legacy)
#       words 100-103 (off 200-207): LBA48 sector count (u64)
#
# CMOS kcp = 0x4F (IDENTIFY done for at least one port). Issued on the
# first successful per-port IDENTIFY parse, not on every port.

var ahci_port_ct_phys[256];    # 32 ports × 8 bytes
var ahci_port_id_phys[256];    # 32 ports × 8 bytes

# Last-IDENTIFY-decoded fields (cached per ahci_identify_device call).
var ahci_id_lba48      = 0;
var ahci_id_lba_bytes  = 512;  # default; word 106 may override

# --- Pre-issue quiescence gate ---------------------------------------
#
# AHCI 1.3.1 §3.3.14 says PxCI bits should be set only when the slot is
# at its default (cleared) value AND the port's task file is idle. On
# real silicon (vs QEMU), controller-internal slot release lags device
# completion — issuing the next command before that lag clears wedges
# the new command (PxCI bit 0 stays set, poll exhausts spin budget).
# Surfaced first iron try on Attempt 81 (WD Blue SA510 SATA Gen3 on
# AMD FCH AHCI 1.3): IDENTIFY → R/W → R/W → R/W all PASS, follow-up
# IDENTIFY hangs.
#
# Match Linux's ata_qc_issue / ahci_qc_issue pattern: wait for
# PxTFD.STS.BSY=0 + DRQ=0 (device idle), PxCI=0, PxSACT=0 before
# issuing the next command. Returns 1 on idle, 0 on timeout.

fn ahci_port_wait_idle(port) {
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    var it0 = klog_uptime_us();                      # 1.57.9: a wall-time budget, not an iteration count
    var spins = 0;
    while (ahci_expired(it0, spins, AHCI_IDLE_BUDGET_US) == 0) {
        var tfd  = ahci_mmio_read32(port_off + AHCI_P_TFD);
        var ci   = ahci_mmio_read32(port_off + AHCI_P_CI);
        var sact = ahci_mmio_read32(port_off + AHCI_P_SACT);
        var sts  = tfd & 0xFF;
        if ((sts & 0x88) == 0) {
            if (ci == 0) {
                if (sact == 0) { return 1; }
            }
        }
        spins = spins + 1;
    }
    return 0;
}

# --- 1.57.9: error / timeout recovery (AHCI 1.3.1 §6.2.2.1, §10.4) -----
#
# Everything here runs under ahci_lock (a preempt-disabled spinlock; the HBA is polled, PxIE is never written) and is
# QUIET: events go into ahci_note and the lock wrappers print them after unlock. A long stall on a failing disk is the
# accepted trade (1.57.8's NVMe rule): it is better than a buffer handed back to a live DMA engine.

# COMRESET (§10.4.2): stop the engine first ("may assume the interface is in a hung condition and may continue" if CR
# sticks), PxSCTL.DET=1 for at least 1 ms, DET=0, wait for PxSSTS.DET=3 (device present, PHY up), clear PxSERR, then
# wait for BSY/DRQ to clear (the device's signature FIS). SPD (bits 4-7) is kept and IPM=3 (no partial/slumber), as
# Linux's sata_link_hardreset writes it. 1 = link up and device ready, 0 = not.
fn ahci_comreset(port_off) {
    ahci_engine_stop(port_off, AHCI_STOP_BUDGET_US);
    var sctl = ahci_mmio_read32(port_off + AHCI_P_SCTL) & 0x0F0;
    ahci_mmio_write32(port_off + AHCI_P_SCTL, sctl | 0x301);      # IPM=3, DET=1: send COMRESET
    ahci_delay_us(port_off, 1000);                                 # >= 1 ms
    ahci_mmio_write32(port_off + AHCI_P_SCTL, sctl | 0x300);      # DET=0: release it
    if (ahci_wait_reg(port_off + AHCI_P_SSTS, 0x0F, 3, AHCI_LINK_BUDGET_US) == 0) { return 0; }
    ahci_mmio_write32(port_off + AHCI_P_SERR, 0xFFFFFFFF);
    return ahci_wait_reg(port_off + AHCI_P_TFD, 0x88, 0, AHCI_IO_BUDGET_US);
}

# FRE on (wait FR=1), then ST=1 and wait CR=1 (§3.3.7: ST may be set only while FRE is set). 1 = running.
fn ahci_engine_start(port_off) {
    var cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    if ((cmd & 0x10) == 0) { ahci_mmio_write32(port_off + AHCI_P_CMD, cmd | 0x10); }
    if (ahci_wait_reg(port_off + AHCI_P_CMD, 0x4000, 0x4000, AHCI_STOP_BUDGET_US) == 0) { return 0; }
    cmd = ahci_mmio_read32(port_off + AHCI_P_CMD);
    ahci_mmio_write32(port_off + AHCI_P_CMD, cmd | 0x01);
    return ahci_wait_reg(port_off + AHCI_P_CMD, 0x8000, 0x8000, AHCI_STOP_BUDGET_US);
}

# The engine will not stop even after a COMRESET, so it may still be DMAing: only an HBA reset ends that (§10.4.3,
# "staggered reset", least intrusive first). GHC.HR resets EVERY port, so every port goes offline. If HR itself sticks
# the HBA's DMA is NOT proven stopped: AHCI_N_HBASTUCK is printed, and the ports stay offline either way.
fn ahci_hba_escalate() {
    ahci_note = ahci_note | AHCI_N_HBA | AHCI_N_OFFLINE;
    if (ahci_hba_reset_quiet() == 0) { ahci_note = ahci_note | AHCI_N_HBASTUCK; }
    var ep = 0;
    while (ep < AHCI_MAX_PORTS) { store8(&ahci_port_dead + ep, 1); ep = ep + 1; }
    return 0;
}

# AHCI 1.3.1 §6.2.2.1 non-queued error recovery, run by the issue path that timed out or failed BEFORE it returns.
# 1 = the port runs again with PxCI clear. 0 = the port is OFFLINE. Either way its DMA engine is proven stopped (or the
# HBA was reset) before this returns, so the caller's buffer, slot 0's header and the CT are free to reuse. The order is
# Linux's EH (freeze, reset, THEN finish the command), not FreeBSD's finish-then-reset: here the return value itself
# hands the buffer back.
#   1. ST=0, wait CR=0: the HBA clears PxCI. CR sticks: COMRESET and stop again; still stuck: HBA reset.
#   2. Clear PxSERR and PxIS AFTER the stop (a late D2H FIS of the failed command may still arrive, §10.4.1).
#   3. BSY or DRQ still set: COMRESET (§6.2.2.1 step 5). A link that does not come back: port offline.
#   4. ST=1 (FRE first), wait CR=1. An engine that will not restart: port offline.
fn ahci_port_recover(port) {
    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    if (ahci_engine_stop(port_off, AHCI_STOP_BUDGET_US) == 0) {
        ahci_note = ahci_note | AHCI_N_COMRESET;
        ahci_comreset(port_off);
        if (ahci_engine_stop(port_off, AHCI_STOP_BUDGET_US) == 0) {
            ahci_hba_escalate();
            return 0;
        }
    }
    ahci_mmio_write32(port_off + AHCI_P_SERR, 0xFFFFFFFF);
    ahci_mmio_write32(port_off + AHCI_P_IS,   0xFFFFFFFF);
    if ((ahci_mmio_read32(port_off + AHCI_P_TFD) & 0x88) != 0) {
        ahci_note = ahci_note | AHCI_N_COMRESET;
        if (ahci_comreset(port_off) == 0) {
            ahci_note = ahci_note | AHCI_N_OFFLINE;
            store8(&ahci_port_dead + port, 1);
            return 0;
        }
        ahci_mmio_write32(port_off + AHCI_P_SERR, 0xFFFFFFFF);
        ahci_mmio_write32(port_off + AHCI_P_IS,   0xFFFFFFFF);
    }
    if (ahci_engine_start(port_off) == 0) {
        if (ahci_engine_stop(port_off, AHCI_STOP_BUDGET_US) == 0) {
            ahci_hba_escalate();
            return 0;
        }
        ahci_note = ahci_note | AHCI_N_OFFLINE;
        store8(&ahci_port_dead + port, 1);
        return 0;
    }
    ahci_note = ahci_note | AHCI_N_RECOVERED;
    return 1;
}

# The settle-equivalent at the top of every issue path: an OFFLINE port never touches slot 0, the CT or a buffer again,
# and a port that is not idle (a halted engine, a device stuck BSY) is recovered once before the issue. 1 = go.
fn ahci_port_ready(port) {
    if (load8(&ahci_port_dead + port) != 0) { return 0; }
    if (ahci_port_wait_idle(port) == 1) { return 1; }
    ahci_note = ahci_note | AHCI_N_NOTIDLE;
    if (ahci_port_recover(port) == 0) { return 0; }
    return ahci_port_wait_idle(port);
}

# Wait for slot 0: 1 = PxCI bit 0 clear with no error, 0 = PxIS reports an error (AHCI_IS_ERR), -1 = the budget ran
# out. PxIS, not PxTFD.ERR, is the error signal: PxTFD is a copy of the LAST D2H FIS, so after one failed command its
# ERR bit stays set until the device sends another, and the pre-1.57.9 poll read that stale ERR and failed the next
# command while it was still running. PxCI is read BEFORE PxIS, so an error that clears CI is still seen. The budget is
# checked BEFORE the reads: a zero budget gives up without looking (the AHCI_SELFTEST fault injection).
fn ahci_poll_slot0(port_off, budget_us) {
    var pt0 = klog_uptime_us();
    var psp = 0;
    while (ahci_expired(pt0, psp, budget_us) == 0) {
        psp = psp + 1;
        var pci = ahci_mmio_read32(port_off + AHCI_P_CI);
        if ((ahci_mmio_read32(port_off + AHCI_P_IS) & AHCI_IS_ERR) != 0) { return 0; }
        if ((pci & 0x01) == 0) { return 1; }
    }
    return 0 - 1;
}

# Issue slot 0 (its header and CT already built) and see it through. On an error or a timeout the port is recovered
# BEFORE this returns (ahci_port_recover), so the command's buffer, slot 0 and the CT are never handed back while the
# HBA still owns them. 1 = the command completed, 0 = it failed (the port is idle again, or offline).
fn ahci_run_slot0(port, port_off, budget_us) {
    ahci_mmio_write32(port_off + AHCI_P_IS,   0xFFFFFFFF);     # fresh error state (W1C)
    ahci_mmio_write32(port_off + AHCI_P_SERR, 0xFFFFFFFF);
    ahci_mmio_write32(port_off + AHCI_P_CI, 1);                 # issue slot 0
    var rr = ahci_poll_slot0(port_off, budget_us);
    if (rr == 1) { return 1; }
    if (rr < 0) {
        # §6.2.2.1 step 1: read PxCI. A command that finished in the window is a completion, not a timeout.
        var lci = ahci_mmio_read32(port_off + AHCI_P_CI) & 0x01;
        if ((ahci_mmio_read32(port_off + AHCI_P_IS) & AHCI_IS_ERR) != 0) {
            ahci_note = ahci_note | AHCI_N_ERROR;
        } else {
            if (lci == 0) {
                ahci_note = ahci_note | AHCI_N_LATEOK;
                return 1;
            }
            ahci_note = ahci_note | AHCI_N_TIMEOUT;
        }
    } else {
        ahci_note = ahci_note | AHCI_N_ERROR;
    }
    ahci_port_recover(port);
    return 0;
}

# Print a wrapper's recovery events (after ahci_spin_unlock), e.g. "ahci: port 0 timeout - recovered".
fn ahci_print_note(port, note) {
    if (note == 0) { return 0; }
    kprint("ahci: port ", 11);
    kprint_num(port);
    if ((note & AHCI_N_TIMEOUT) != 0)  { kprint(" timeout", 8); }
    if ((note & AHCI_N_ERROR) != 0)    { kprint(" error", 6); }
    if ((note & AHCI_N_NOTIDLE) != 0)  { kprint(" not-idle", 9); }
    if ((note & AHCI_N_LATEOK) != 0)   { kprint(" completed-late", 15); }
    if ((note & AHCI_N_COMRESET) != 0) { kprint(" comreset", 9); }
    if ((note & AHCI_N_HBA) != 0)      { kprint(" hba-reset", 10); }
    if ((note & AHCI_N_HBASTUCK) != 0) { kprint(" hba-reset-stuck (DMA not proven stopped)", 41); }
    if ((note & AHCI_N_OFFLINE) != 0)   { kprint(" - port offline", 15); }
    if ((note & AHCI_N_RECOVERED) != 0) { kprint(" - recovered", 12); }
    kprintln("", 0);
    return 0;
}

# --- Byte-swapped ASCII print (ATA IDENTIFY quirk) -------------------
#
# IDENTIFY DEVICE returns text fields with each 16-bit word stored as
# (high_byte, low_byte) in memory — opposite of the natural ASCII
# byte order. To print, swap each pair: print byte at offset+1 first,
# then byte at offset.
#
# Right-trim trailing 0x20 padding per ATA8-ACS §7.16.7 (matches Linux's
# ata_id_c_string in drivers/ata/libata-core.c). Byte-swap means printed-
# char-index k maps to field-byte (k XOR 1): if k even -> k+1, else k-1.

fn ahci_print_id_string(id_buf, off, len) {
    var trim = len;
    while (trim > 0) {
        var k = trim - 1;
        var bidx = 0;
        if ((k & 1) == 0) { bidx = k + 1; }
        if ((k & 1) == 1) { bidx = k - 1; }
        if (load8(id_buf + off + bidx) != 0x20) { trim = trim; break; }
        trim = trim - 1;
    }
    var i = 0;
    var printed = 0;
    while (i < len) {
        if (printed < trim) {
            kprint(id_buf + off + i + 1, 1);
            printed = printed + 1;
        }
        if (printed < trim) {
            kprint(id_buf + off + i, 1);
            printed = printed + 1;
        }
        i = i + 2;
    }
    return 0;
}

# --- Issue IDENTIFY DEVICE on one port -------------------------------

# SMP sub-bite 5: whole-HBA lock via the INNER-WRAPPER pattern. ahci_identify_device
# has 6 return points (idle-fail, 2x pmm-alloc-fail, task-file ERR, timeout, success)
# and heavy kprint on the success path — a hand-placed unlock at every return is
# error-prone, so the body is ahci_identify_device_inner and this thin wrapper does
# ONE lock/unlock around it (single acquire/release, no multi-return-unlock hazard).
# Runs ONLY at single-core boot probe (before APs exist), so the success-path kprint
# under ahci_lock (console < ahci backward) is a boot-only residual with no cycle
# (console-lock holders never do device I/O). Polling-only HBA (never writes PxIE).
# 1.57.9: failures (timeout, PxIS error, not idle, offline) are recovered inside and printed by this wrapper after
# unlock (ahci_print_note); only the boot-time success lines still print under the lock.
fn ahci_identify_device(port) {
    ahci_spin_lock();
    ahci_note = 0;
    var r = ahci_identify_device_inner(port);
    var note = ahci_note;
    ahci_note = 0;
    ahci_last_note = note;
    ahci_spin_unlock();
    ahci_print_note(port, note);
    return r;
}
fn ahci_identify_device_inner(port) {
    if (ahci_present == 0) { return 0; }
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }

    if (ahci_port_ready(port) == 0) { return 0; }

    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    var cl_kva   = load64(&ahci_port_cl_kva + port * 8);

    # Allocate Command Table + IDENTIFY data buffer on first use.
    # Cached for the port's lifetime; subsequent IDENTIFY calls reuse.
    var ct_phys = load64(&ahci_port_ct_phys + port * 8);
    if (ct_phys == 0) {
        ct_phys = pmm_alloc();
        if (ct_phys == 0) { return 0; }
        store64(&ahci_port_ct_phys + port * 8, ct_phys);
    }
    var ct_kva = dma_kva(ct_phys);
    var id_phys = load64(&ahci_port_id_phys + port * 8);
    if (id_phys == 0) {
        id_phys = pmm_alloc();
        if (id_phys == 0) { return 0; }
        store64(&ahci_port_id_phys + port * 8, id_phys);
    }
    var id_kva = dma_kva(id_phys);

    # Zero CT + ID buffer.
    var i = 0;
    while (i < 128) { store8(ct_kva + i, 0); i = i + 1; }
    i = 0;
    while (i < 512) { store8(id_kva + i, 0); i = i + 1; }

    # --- Build H2D Register FIS at CT+0 ---
    store8(ct_kva + 0,  0x27);     # FIS type = H2D Register
    store8(ct_kva + 1,  0x80);     # C bit set, PM port 0
    store8(ct_kva + 2,  0xEC);     # Command = IDENTIFY DEVICE
    # bytes 3-15 left zero (no features / no LBA / no count / no ICC)

    # --- Build PRDT[0] at CT+0x80 ---
    store32(ct_kva + 0x80, id_phys & 0xFFFFFFFF);          # DBA
    store32(ct_kva + 0x84, (id_phys >> 32) & 0xFFFFFFFF);  # DBAU
    store32(ct_kva + 0x88, 0);                              # Reserved
    store32(ct_kva + 0x8C, 511);                            # DBC = byte_count - 1 (no I bit)

    # --- Build Command Header in CL slot 0 ---
    # bytes 0-1: CFL=5 in bits 0-4, W=0 (read)
    store32(cl_kva + 0,  5);
    # bytes 2-3: PRDTL=1 (stored at offset 2 as 16-bit, but Cyrius
    # store32 above wrote bytes 0-3; the PRDTL field needs to be in
    # bytes 2-3 of the header word. Rebuild with full 32-bit value:
    #   bits 0-4  = CFL = 5
    #   bit 6     = W   = 0
    #   bits 16-31 = PRDTL = 1
    store32(cl_kva + 0, (1 << 16) | 5);
    store32(cl_kva + 4, 0);                                 # PRDBC
    store32(cl_kva + 8, ct_phys & 0xFFFFFFFF);              # CTBA
    store32(cl_kva + 12, (ct_phys >> 32) & 0xFFFFFFFF);     # CTBAU
    # bytes 16-31: reserved, leave zero from the zeroing pass.
    store32(cl_kva + 16, 0);
    store32(cl_kva + 20, 0);
    store32(cl_kva + 24, 0);
    store32(cl_kva + 28, 0);

    # --- Issue slot 0 and see it through: clear PxIS/PxSERR, PxCI bit 0 = 1, poll it clear on a 5 s wall-time
    #     budget. A PxIS error or a timeout recovers the port (§6.2.2.1) before this returns (1.57.9). ---
    if (ahci_run_slot0(port, port_off, AHCI_IO_BUDGET_US) == 0) { return 0; }

    # --- Decode IDENTIFY data ---
    # LBA48 sector count: u64 at offset 200 (words 100-103). LBA bytes
    # default 512; word 106 bit 12 = "logical sector longer than 256
    # words" → check word 117-118 for actual size. Phase 3 simple path
    # assumes 512 B/LBA (true for >99% of consumer drives).
    ahci_id_lba48     = load64(id_kva + 200);
    ahci_id_lba_bytes = 512;

    kprint("ahci: port ", 11);
    kprint_num(port);
    kprint(" model='", 8);
    ahci_print_id_string(id_kva, 54, 40);
    kprint("' serial='", 10);
    ahci_print_id_string(id_kva, 20, 20);
    kprint("' fw='", 6);
    ahci_print_id_string(id_kva, 46, 8);
    kprintln("'", 1);

    kprint("ahci: port ", 11);
    kprint_num(port);
    kprint(" LBA48=", 7);
    kprint_num(ahci_id_lba48);
    kprint(" sectors (", 10);
    kprint_num((ahci_id_lba48 * ahci_id_lba_bytes) / 1048576);
    kprintln(" MiB)", 5);

    return 1;
}

# --- Drive IDENTIFY across every initialized SATA port ---------------

fn ahci_identify_all() {
    if (ahci_present == 0) { return 0; }
    var port      = 0;
    var max_port  = ahci_np + 1;
    if (max_port > AHCI_MAX_PORTS) { max_port = AHCI_MAX_PORTS; }
    var any_ok    = 0;

    while (port < max_port) {
        if (load8(&ahci_port_inited + port) == 1) {
            if (ahci_identify_device(port) == 1) {
                any_ok = 1;
            }
        }
        port = port + 1;
    }

    if (any_ok == 1) {
        # CMOS kcp = 0x4F (AHCI IDENTIFY done for at least one port).
        asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x4F; 0xE6; 0x71; }
    }
    return any_ok;
}

# === AHCI Phase 4 — READ/WRITE DMA EXT + block-layer registration ====
#
# Real disk I/O. Uses the Phase 2 CL+FIS infrastructure and the Phase 3
# command-issue pattern. ATA commands:
#   - READ DMA EXT  (0x25): 48-bit LBA, 16-bit sector count, into PRDT buffer
#   - WRITE DMA EXT (0x35): same shape, write direction (CH.W=1)
#
# Single-PRDT path only — covers transfers up to PRDT.DBC max (4 MB
# per entry). Multi-PRDT (large sequential transfer split across pages)
# can land in Phase 5 if needed. Most consumer-side reads/writes are
# single-sector or page-sized → single-PRDT covers them all.
#
# Block-layer registration policy:
#   - BLK_NONE   → AHCI takes the slot (no other backend)
#   - BLK_VIRTIO → AHCI overrides (real iron beats QEMU paravirt)
#   - BLK_NVME   → AHCI does NOT override (NVMe is the modern primary;
#                  AHCI is auxiliary on multi-disk iron)
# `ahci_blk_port` records which AHCI port is registered. Phase 4
# defaults to the lowest-numbered initialized SATA port.

var ahci_blk_port = 0 - 1;    # -1 = not registered; set to port idx on register

# --- Build H2D FIS for READ/WRITE DMA EXT ----------------------------
#
# 20-byte H2D Register FIS with LBA48 + count layout (ATA/ATAPI-8
# §7.21 READ DMA EXT, §7.62 WRITE DMA EXT):
#   byte 0:  0x27 (FIS type)
#   byte 1:  0x80 (C bit, PM port 0)
#   byte 2:  opcode (0x25 read / 0x35 write)
#   byte 3:  features low (0)
#   bytes 4-6: LBA[23:0]
#   byte 7:  device = 0x40 (LBA mode bit set; bits 0-3 = LBA[27:24] but
#                            in LBA48 mode bits 0-3 are unused since
#                            high bits come from the exp register)
#   bytes 8-10: LBA[47:24]
#   byte 11: features high (0)
#   bytes 12-13: sector count
#   byte 14: ICC (0)
#   byte 15: control (0)
#   bytes 16-19: reserved
fn ahci_build_rw_fis(ct_kva, opcode, lba, count) {    # ct_kva: the CT's CPU pointer (direct map)
    # Clear the FIS region (20 bytes).
    var i = 0;
    while (i < 20) { store8(ct_kva + i, 0); i = i + 1; }

    store8(ct_kva + 0,  0x27);
    store8(ct_kva + 1,  0x80);
    store8(ct_kva + 2,  opcode);

    # LBA[23:0] → bytes 4, 5, 6
    store8(ct_kva + 4, lba & 0xFF);
    store8(ct_kva + 5, (lba >> 8) & 0xFF);
    store8(ct_kva + 6, (lba >> 16) & 0xFF);
    # device byte: LBA mode (bit 6 = 1). LBA48 puts high bits in exp,
    # not in device byte's low nibble.
    store8(ct_kva + 7, 0x40);

    # LBA[47:24] → bytes 8, 9, 10
    store8(ct_kva + 8,  (lba >> 24) & 0xFF);
    store8(ct_kva + 9,  (lba >> 32) & 0xFF);
    store8(ct_kva + 10, (lba >> 40) & 0xFF);

    # count → bytes 12-13
    store8(ct_kva + 12, count & 0xFF);
    store8(ct_kva + 13, (count >> 8) & 0xFF);

    return 0;
}

# --- Issue a single-PRDT command (read or write) ---------------------
#
# Internal common path for READ/WRITE DMA EXT. Returns 1 on success,
# 0 on any failure (PxCI never set, task-file ERR, timeout).

# SMP sub-bite 5: whole-HBA lock via the INNER-WRAPPER pattern (4 return points after
# the lock point — single lock/unlock around the inner body avoids hand-placing an
# unlock at each). Locks at the TOP (before ahci_port_wait_idle) so the check-then-act
# TOCTOU on PxCI is closed. Slot-0 command list/table/PRDT/FIS + PxCI are shared HBA
# state. Polling-only HBA (never writes PxIE, no MSI/IDT vector → no ISR contends).
# fs_lock is held ABOVE this when FS reads/writes a block (fs < ahci, forward order).
# No kprint inside → no console-order concern.
# 1.57.9: recovery events are printed by the wrapper AFTER unlock (ahci_print_note), so the "no kprint inside" rule
# holds. ahci_issue_rw_n takes the poll budget: AHCI_SELFTEST passes 0 to force a timed-out, still-running command.
fn ahci_issue_rw_n(port, opcode, lba, count, data_phys, is_write, budget_us) {
    ahci_spin_lock();
    ahci_note = 0;
    var r = ahci_issue_rw_inner(port, opcode, lba, count, data_phys, is_write, budget_us);
    var note = ahci_note;
    ahci_note = 0;
    ahci_last_note = note;
    ahci_spin_unlock();
    ahci_print_note(port, note);
    return r;
}
fn ahci_issue_rw(port, opcode, lba, count, data_phys, is_write) {
    return ahci_issue_rw_n(port, opcode, lba, count, data_phys, is_write, AHCI_IO_BUDGET_US);
}
fn ahci_issue_rw_inner(port, opcode, lba, count, data_phys, is_write, budget_us) {
    if (ahci_present == 0) { return 0; }
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }
    if (count <= 0) { return 0; }
    if (count > 128) { return 0; }      # cap per-cmd at 64 KB (128 sectors)

    if (ahci_port_ready(port) == 0) { return 0; }

    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    var cl_kva   = load64(&ahci_port_cl_kva + port * 8);
    var ct_phys  = load64(&ahci_port_ct_phys + port * 8);
    if (ct_phys == 0) {
        ct_phys = pmm_alloc();
        if (ct_phys == 0) { return 0; }
        store64(&ahci_port_ct_phys + port * 8, ct_phys);
    }
    var ct_kva = dma_kva(ct_phys);

    # Zero the part of the CT we'll touch (FIS 20 B + PRDT 16 B at 0x80).
    var i = 0;
    while (i < 20)  { store8(ct_kva + i, 0); i = i + 1; }
    i = 0;
    while (i < 16)  { store8(ct_kva + 0x80 + i, 0); i = i + 1; }

    ahci_build_rw_fis(ct_kva, opcode, lba, count);

    # PRDT[0]: DBA / DBAU / Reserved / DBC.
    var byte_count = count * 512;
    store32(ct_kva + 0x80, data_phys & 0xFFFFFFFF);
    store32(ct_kva + 0x84, (data_phys >> 32) & 0xFFFFFFFF);
    store32(ct_kva + 0x88, 0);
    store32(ct_kva + 0x8C, byte_count - 1);  # DBC = byte_count - 1

    # Command Header slot 0: CFL=5 (H2D FIS DWORDs), W bit per direction,
    # PRDTL=1, CTBA = ct_phys.
    var ch_word0 = 5;                          # CFL = 5
    if (is_write == 1) { ch_word0 = ch_word0 | 0x40; }   # W = bit 6
    ch_word0 = ch_word0 | (1 << 16);            # PRDTL = 1
    store32(cl_kva + 0,  ch_word0);
    store32(cl_kva + 4,  0);                   # PRDBC
    store32(cl_kva + 8,  ct_phys & 0xFFFFFFFF);
    store32(cl_kva + 12, (ct_phys >> 32) & 0xFFFFFFFF);
    store32(cl_kva + 16, 0);
    store32(cl_kva + 20, 0);
    store32(cl_kva + 24, 0);
    store32(cl_kva + 28, 0);

    # Issue and see it through; a PxIS error or a timeout recovers the port before this returns (1.57.9).
    return ahci_run_slot0(port, port_off, budget_us);
}

# --- Public READ / WRITE primitives ----------------------------------

fn ahci_read_lba(port, lba, count, buf) {
    return ahci_issue_rw(port, 0x25, lba, count, buf, 0);
}

fn ahci_write_lba(port, lba, count, buf) {
    return ahci_issue_rw(port, 0x35, lba, count, buf, 1);
}

# --- Issue a non-data ATA command (no PRDT) --------------------------
#
# Sibling of ahci_issue_rw for commands with no data phase — FLUSH
# CACHE EXT (0xEA). Same present/inited/wait-idle guards, same H2D FIS
# scaffolding (ahci_build_rw_fis with lba=0/count=0 — FLUSH CACHE EXT
# ignores both), but the command header sets PRDTL=0 (no PRDT) and W=0,
# and the completion poll uses the generous flush ceiling. Returns 1 on
# success, 0 on PxTFD.ERR / stuck CI / timeout. 1.33.5 fsync barrier
# (per flush-cache-prior-art.md § 2.2).
# SMP sub-bite 5: whole-HBA lock via the INNER-WRAPPER pattern (same multi-return
# rationale as ahci_issue_rw). No kprint inside → no console-order concern.
fn ahci_issue_nodata(port, opcode) {
    ahci_spin_lock();
    ahci_note = 0;
    var r = ahci_issue_nodata_inner(port, opcode);
    var note = ahci_note;
    ahci_note = 0;
    ahci_last_note = note;
    ahci_spin_unlock();
    ahci_print_note(port, note);
    return r;
}
fn ahci_issue_nodata_inner(port, opcode) {
    if (ahci_present == 0) { return 0; }
    if (port < 0) { return 0; }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }

    if (ahci_port_ready(port) == 0) { return 0; }

    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    var cl_kva   = load64(&ahci_port_cl_kva + port * 8);
    var ct_phys  = load64(&ahci_port_ct_phys + port * 8);
    if (ct_phys == 0) {
        ct_phys = pmm_alloc();
        if (ct_phys == 0) { return 0; }
        store64(&ahci_port_ct_phys + port * 8, ct_phys);
    }
    var ct_kva = dma_kva(ct_phys);

    # Zero the FIS region (20 B). No PRDT for a non-data command.
    var i = 0;
    while (i < 20) { store8(ct_kva + i, 0); i = i + 1; }

    # FLUSH CACHE EXT ignores LBA/count; reuse the rw FIS builder with
    # lba=0 count=0 (byte2=opcode, byte7=0x40 LBA-mode, rest zero).
    ahci_build_rw_fis(ct_kva, opcode, 0, 0);

    # Command Header slot 0: CFL=5 (H2D FIS DWORDs), W=0 (non-data),
    # PRDTL=0 (no PRDT), CTBA = ct_phys.
    store32(cl_kva + 0,  5);                   # CFL=5, PRDTL=0, W=0
    store32(cl_kva + 4,  0);                   # PRDBC
    store32(cl_kva + 8,  ct_phys & 0xFFFFFFFF);
    store32(cl_kva + 12, (ct_phys >> 32) & 0xFFFFFFFF);
    store32(cl_kva + 16, 0);
    store32(cl_kva + 20, 0);
    store32(cl_kva + 24, 0);
    store32(cl_kva + 28, 0);

    # Issue and see it through on the 30 s FLUSH budget; an error or a timeout recovers the port first (1.57.9).
    return ahci_run_slot0(port, port_off, AHCI_FLUSH_BUDGET_US);
}

# --- Boot-time demos -------------------------------------------------
#
# Two-tier demo split per the 1.31.1 § AHCI iron-burn audit:
#   - ahci_read_demo()  — always-on; read LBA 0, print first 8 bytes
#                         (mirrors `nvme_rw_demo`'s read half). Safe on
#                         any drive: no writes, no side effects.
#   - ahci_write_demo() — compile-gated behind `AHCI_RW_DEMO`. Sentinel
#                         write to LBA 5 + read-back verify. DEFAULT OFF
#                         in production; enable via `AHCI_RW_DEMO=1
#                         ./scripts/build.sh` for QEMU smoke or scratch
#                         drives. LBA 5 of a GPT disk sits inside the
#                         partition-entry array — landing a sentinel
#                         there is recoverable but not the right default
#                         posture.
#
# Single port only (lowest-numbered initialized).

var ahci_demo_buf = 0;
var ahci_demo_buf2 = 0;

fn ahci_read_demo() {
    if (ahci_present == 0) { return 0; }
    var port = 0;
    while (port < AHCI_MAX_PORTS) {
        if (load8(&ahci_port_inited + port) == 1) { port = port; break; }
        port = port + 1;
    }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }

    if (ahci_demo_buf == 0) {
        ahci_demo_buf = pmm_alloc();
        if (ahci_demo_buf == 0) { return 0; }
    }
    var dk = dma_kva(ahci_demo_buf);       # 1.57.8 (DMA1): CPU pointer = direct map; the phys goes to the PRDT

    var i = 0;
    while (i < 512) { store8(dk + i, 0); i = i + 1; }
    if (ahci_read_lba(port, 0, 1, ahci_demo_buf) == 0) {
        kprint("ahci: port ", 11);
        kprint_num(port);
        kprintln(" LBA0 read FAILED", 17);
        return 0;
    }
    kprint("ahci: port ", 11);
    kprint_num(port);
    kprint(" LBA0 first 8 bytes:", 20);
    i = 0;
    while (i < 8) {
        kprint(" ", 1);
        kprint_num(load8(dk + i));
        i = i + 1;
    }
    kprintln("", 0);
    return 1;
}

#ifdef AHCI_RW_DEMO
fn ahci_write_demo() {
    if (ahci_present == 0) { return 0; }
    var port = 0;
    while (port < AHCI_MAX_PORTS) {
        if (load8(&ahci_port_inited + port) == 1) { port = port; break; }
        port = port + 1;
    }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }

    if (ahci_demo_buf == 0) {
        ahci_demo_buf = pmm_alloc();
        if (ahci_demo_buf == 0) { return 0; }
    }
    if (ahci_demo_buf2 == 0) {
        ahci_demo_buf2 = pmm_alloc();
        if (ahci_demo_buf2 == 0) { return 0; }
    }
    var dk = dma_kva(ahci_demo_buf);
    var dk2 = dma_kva(ahci_demo_buf2);

    # 1. Sentinel at LBA 5: "AHCI-OK!" (8 bytes), rest zero.
    var i = 0;
    while (i < 512) { store8(dk2 + i, 0); i = i + 1; }
    store8(dk2 + 0, 65);    # A
    store8(dk2 + 1, 72);    # H
    store8(dk2 + 2, 67);    # C
    store8(dk2 + 3, 73);    # I
    store8(dk2 + 4, 45);    # -
    store8(dk2 + 5, 79);    # O
    store8(dk2 + 6, 75);    # K
    store8(dk2 + 7, 33);    # !

    if (ahci_write_lba(port, 5, 1, ahci_demo_buf2) == 0) {
        kprint("ahci: port ", 11);
        kprint_num(port);
        kprintln(" LBA5 write FAILED", 18);
        return 0;
    }

    # 2. Read back into a fresh buffer.
    i = 0;
    while (i < 512) { store8(dk + i, 0); i = i + 1; }
    if (ahci_read_lba(port, 5, 1, ahci_demo_buf) == 0) {
        kprint("ahci: port ", 11);
        kprint_num(port);
        kprintln(" LBA5 read-back FAILED", 22);
        return 0;
    }

    # 3. Verify the first 8 bytes match "AHCI-OK!".
    var ok = 1;
    if (load8(dk + 0) != 65) { ok = 0; }
    if (load8(dk + 1) != 72) { ok = 0; }
    if (load8(dk + 2) != 67) { ok = 0; }
    if (load8(dk + 3) != 73) { ok = 0; }
    if (load8(dk + 4) != 45) { ok = 0; }
    if (load8(dk + 5) != 79) { ok = 0; }
    if (load8(dk + 6) != 75) { ok = 0; }
    if (load8(dk + 7) != 33) { ok = 0; }

    kprint("ahci: port ", 11);
    kprint_num(port);
    if (ok == 1) {
        kprintln(" LBA5 write-then-read round-trip PASS", 37);
    } else {
        kprintln(" LBA5 write-then-read round-trip FAIL", 37);
    }
    return ok;
}
#endif

# --- Block-layer dispatch wrappers (single + multi-sector) -----------

fn ahci_blk_read(sector, buf) {
    if (ahci_blk_port < 0) { return 0 - 1; }
    if (ahci_read_lba(ahci_blk_port, sector, 1, buf) == 1) { return 0; }
    return 0 - 1;
}

fn ahci_blk_write(sector, buf) {
    if (ahci_blk_port < 0) { return 0 - 1; }
    if (ahci_write_lba(ahci_blk_port, sector, 1, buf) == 1) { return 0; }
    return 0 - 1;
}

# FLUSH CACHE EXT (0xEA) on the registered port. 1.33.5 fsync barrier.
fn ahci_blk_flush() {
    if (ahci_blk_port < 0) { return 0 - 1; }
    if (ahci_issue_nodata(ahci_blk_port, 0xEA) == 1) { return 0; }
    return 0 - 1;
}

fn ahci_blk_read_sectors(start, count, buf) {
    if (ahci_blk_port < 0) { return 0 - 1; }
    if (count <= 0) { return 0 - 1; }
    # Single-PRDT cap is 128 sectors per call; chunk larger requests.
    var done = 0;
    while (done < count) {
        var chunk = count - done;
        if (chunk > 128) { chunk = 128; }
        if (ahci_read_lba(ahci_blk_port, start + done, chunk, buf + done * 512) == 0) {
            return 0 - 1;
        }
        done = done + chunk;
    }
    return 0;
}

# --- Block-layer registration ----------------------------------------
#
# Pick the lowest-numbered initialized port (which had a successful
# IDENTIFY → ahci_id_lba48 is set from that last call). Capacity for
# the registered backend = that port's LBA48 sector count.
#
# Policy: don't override NVMe (modern primary). Do override virtio
# (paravirt fallback). Take BLK_NONE if no backend has registered.

fn ahci_register_block_dev() {
    if (ahci_present == 0) { return 0; }

    var port = 0;
    while (port < AHCI_MAX_PORTS) {
        if (load8(&ahci_port_inited + port) == 1) {
            port = port; break;
        }
        port = port + 1;
    }
    if (port >= AHCI_MAX_PORTS) { return 0; }
    if (load8(&ahci_port_inited + port) != 1) { return 0; }

    # Refresh capacity from a per-port IDENTIFY (Phase 3 cached only
    # the last-called port's data; re-run for the registration port).
    if (ahci_identify_device(port) == 0) { return 0; }

    ahci_blk_port = port;

    # Don't override NVMe — it's the modern primary on multi-disk iron.
    if (blk_active == BLK_NVME) {
        kprint("ahci: registered as secondary block_dev (port ", 46);
        kprint_num(port);
        kprint(", ", 2);
        kprint_num(ahci_id_lba48);
        kprintln(" LBAs x 512B; NVMe primary)", 27);
        # Bite (G) — mark AHCI as callable via blk_read_on(BLK_AHCI, ...)
        # even though it's not blk_active. Filesystem-layer probes
        # (ext2 multi-backend mount) iterate on blk_registered, not
        # blk_active.
        blk_mark_registered(BLK_AHCI);
        # CMOS kcp = 0x50 (AHCI block-layer registration done, secondary path).
        asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x50; 0xE6; 0x71; }
        return 1;
    }

    blk_register_ahci(ahci_id_lba48, 512);
    kprint("ahci: registered as block_dev (port ", 36);
    kprint_num(port);
    kprint(", ", 2);
    kprint_num(ahci_id_lba48);
    kprintln(" LBAs x 512B)", 13);
    # CMOS kcp = 0x50 (AHCI block-layer registration done, primary path).
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x50; 0xE6; 0x71; }
    return 1;
}

#ifdef AHCI_SELFTEST
# ═══ 1.57.9 AHCI_SELFTEST — a timed-out command's buffer, slot 0 and CT are never reused while the HBA owns them ═══
# Fault injection: ahst_inject issues a READ through ahci_issue_rw_n with a ZERO budget, so the poll gives up before
# looking and the command is still in flight — the timeout the issue describes. The smoke throttles the SATA disk
# (100 IOPS) and ahst_prime fills QEMU's throttle bucket first, so the injected read really is ~10 ms late.
# Arms (DESTRUCTIVE: sectors at capacity/2 of a blank QEMU scratch disk):
#   stamp  8 LBAs at cap/2 get a per-LBA, per-word pattern (setup).
#   reuse  8x: a late read into page B, then at once the caller stamps B; 50 ms later B must still hold the stamp, and a
#          normal read of the same LBA into B is byte-exact. RED on the pre-1.57.9 abandon (the late DMA lands on the
#          caller's stamp). The discriminating arm.
#   shift  one late read, then 16 reads of known LBAs byte-exact and a FLUSH: slot 0 and the CT are reused cleanly.
#   tfes   a read past capacity fails with a PxIS error; the next read succeeds byte-exact with the port idle (no
#          not-idle recovery). RED on the pre-1.57.9 poll, which read the stale PxTFD.ERR and failed the next command.
#   lost   ahci_test_stuck makes the engine "refuse" to stop: COMRESET, then GHC.HR, every port offline. B is not
#          written after the return, the next I/O fails at once, GHC.HR has cleared and the port's ST/CR are clear.
#          This leaves AHCI OFF for the rest of the boot; the smoke stops at "ahcist: done".
fn ahst_word(lba, i) { return 0x4148000000000000 | ((lba & 0xFFFFFFFF) << 16) | i; }
fn ahst_stamp(buf, lba) {
    for (var i = 0; i < 64; i = i + 1) { store64(buf + i * 8, ahst_word(lba, i)); }
    return 0;
}
fn ahst_bad(buf, lba) {
    var nbad = 0;
    for (var i = 0; i < 64; i = i + 1) {
        if (load64(buf + i * 8) != ahst_word(lba, i)) { nbad = nbad + 1; }
    }
    return nbad;
}
fn ahst_fill(buf, v) {
    for (var i = 0; i < 64; i = i + 1) { store64(buf + i * 8, v); }
    return 0;
}
fn ahst_diff(buf, v) {
    var nd = 0;
    for (var i = 0; i < 64; i = i + 1) {
        if (load64(buf + i * 8) != v) { nd = nd + 1; }
    }
    return nd;
}
fn ahst_wait_ms(ms) {
    var t0 = klog_uptime_us();
    var sp = 0;
    while (sp < 50000000) {
        sp = sp + 1;
        if (t0 > 0) { if ((klog_uptime_us() - t0) > ms * 1000) { sp = 50000000; } }
    }
    return 0;
}
# Fill QEMU's throttle bucket (burst = iops/10) so the next command waits its ~10 ms turn.
fn ahst_prime(port, lba, phys) {
    for (var i = 0; i < 12; i = i + 1) { ahci_read_lba(port, lba, 1, phys); }
    return 0;
}
# 1 = the read was really left in flight (the zero-budget poll timed out; the port was recovered).
fn ahst_inject(port, lba, phys) {
    if (ahci_issue_rw_n(port, 0x25, lba, 1, phys, 0, 0) == 1) {
        kprintln("ahcist: inject FAIL (the command was not late)", 46);
        return 0;
    }
    if ((ahci_last_note & AHCI_N_TIMEOUT) == 0) {
        kprintln("ahcist: inject FAIL (no timeout recorded)", 41);
        return 0;
    }
    return 1;
}
fn ahst_verdict(name, nlen, ok, a, b) {
    kprint("ahcist: ", 8);
    kprint(name, nlen);
    if (ok == 1) { kprint(" PASS", 5); } else { kprint(" FAIL", 5); }
    kprint(" bad=", 5); kprint_num(a);
    kprint(" aux=", 5); kprint_num(b);
    kprintln("", 0);
    return 0;
}

fn ahci_late_selftest() {
    if (ahci_blk_port < 0) { kprintln("ahcist: SKIP no AHCI port", 25); kprintln("ahcist: done", 12); return 0; }
    var port = ahci_blk_port;
    var port_off = AHCI_PORT_BASE + port * AHCI_PORT_STRIDE;
    var cap = ahci_id_lba48;
    var base = cap / 2;
    var pa = pmm_alloc();                   # PRDT (phys) values
    var pb = pmm_alloc();
    var pc = pmm_alloc();
    if (pa == 0) { kprintln("ahcist: SKIP no memory", 22); kprintln("ahcist: done", 12); return 0; }
    if (pb == 0) { kprintln("ahcist: SKIP no memory", 22); kprintln("ahcist: done", 12); return 0; }
    if (pc == 0) { kprintln("ahcist: SKIP no memory", 22); kprintln("ahcist: done", 12); return 0; }
    var ka = dma_kva(pa);                   # CPU pointers: the direct map (1.57.8 DMA1)
    var kb = dma_kva(pb);
    var kc = dma_kva(pc);

    # stamp
    var wf = 0;
    for (var k = 0; k < 8; k = k + 1) {
        ahst_stamp(ka, base + k);
        if (ahci_write_lba(port, base + k, 1, pa) == 0) { wf = wf + 1; }
    }
    var wok = 0;
    if (wf == 0) { wok = 1; }
    ahst_verdict("stamp", 5, wok, wf, base);

    # reuse
    var ubad = 0;
    var uinj = 0;
    for (var u = 0; u < 8; u = u + 1) {
        ahst_prime(port, base + 7, pc);
        uinj = uinj + ahst_inject(port, base + 1, pb);
        var q = 0x5155000000000000 | u;
        ahst_fill(kb, q);
        ahst_wait_ms(50);
        ubad = ubad + ahst_diff(kb, q);
        ahst_fill(kb, 0xEEEEEEEEEEEEEEEE);
        if (ahci_read_lba(port, base + 1, 1, pb) == 0) { ubad = ubad + 1; }
        ubad = ubad + ahst_bad(kb, base + 1);
    }
    var uok = 0;
    if (uinj == 8) { if (ubad == 0) { uok = 1; } }
    ahst_verdict("reuse", 5, uok, ubad, uinj);

    # shift
    ahst_prime(port, base + 7, pc);
    var sinj = ahst_inject(port, base + 2, pb);
    var sbad = 0;
    var sf = 0;
    for (var r = 0; r < 16; r = r + 1) {
        var kk = (r * 5 + 3) & 7;
        ahst_fill(kc, 0xEEEEEEEEEEEEEEEE);
        if (ahci_read_lba(port, base + kk, 1, pc) == 0) { sf = sf + 1; }
        sbad = sbad + ahst_bad(kc, base + kk);
    }
    if (ahci_blk_flush() != 0) { sf = sf + 1; }
    var sok = 0;
    if (sinj == 1) { if (sbad == 0) { if (sf == 0) { sok = 1; } } }
    ahst_verdict("shift", 5, sok, sbad + sf, sinj);

    # tfes
    var te = ahci_read_lba(port, cap + 16, 1, pc);
    var tnote = ahci_last_note;
    ahst_fill(kc, 0xEEEEEEEEEEEEEEEE);
    var tg = ahci_read_lba(port, base + 3, 1, pc);
    var tgn = ahci_last_note;
    var tbad = ahst_bad(kc, base + 3);
    var tok = 0;
    if (te == 0) { if ((tnote & AHCI_N_ERROR) != 0) { if (tg == 1) { if (tgn == 0) { if (tbad == 0) { tok = 1; } } } } }
    ahst_verdict("tfes", 4, tok, tbad + 1 - tg, tnote * 256 + tgn);

    # lost
    ahst_prime(port, base + 7, pc);
    ahci_test_stuck = 1;
    var lr = ahci_issue_rw_n(port, 0x25, base + 4, 1, pb, 0, 0);
    var lnote = ahci_last_note;
    ahci_test_stuck = 0;
    ahst_fill(kb, 0x4C4F535400000000);
    ahst_wait_ms(50);
    var lbad = ahst_diff(kb, 0x4C4F535400000000);
    var lnext = ahci_read_lba(port, base, 1, pc);
    var lcmd = ahci_mmio_read32(port_off + AHCI_P_CMD) & 0x8001;
    var lhr = ahci_mmio_read32(AHCI_REG_GHC) & 0x01;
    var ldead = load8(&ahci_port_dead + port);
    var lok = 1;
    if (lr != 0) { lok = 0; }
    if ((lnote & AHCI_N_HBA) == 0) { lok = 0; }
    if ((lnote & AHCI_N_HBASTUCK) != 0) { lok = 0; }
    if (lbad != 0) { lok = 0; }
    if (lnext != 0) { lok = 0; }
    if (lcmd != 0) { lok = 0; }
    if (lhr != 0) { lok = 0; }
    if (ldead != 1) { lok = 0; }
    ahst_verdict("lost", 4, lok, lbad + lnext + lcmd + lhr, lnote);
    kprintln("ahcist: done", 12);
    return 0;
}
#endif
