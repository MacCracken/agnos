# === Kernel GPU arc — bite F0: probe + register-aperture ID dump =============
#
# The first bite of the 1.54.x kernel GPU arc ("push pixels AND data through the
# GPU"). F0 is the read-only foundation: find the AMD Cezanne iGPU on PCI, map
# its BAR5 register aperture uncacheable, and read a few always-safe identity /
# liveness registers to PROVE the aperture is correctly addressed before any
# later bite writes a page table (C1 GPUVM), a command ring (C2 CP/MEC), or a
# shader (C3). No DMA, no firmware, no device-state writes — the lowest-risk
# possible first touch of the GPU.
#
# Iron-only: QEMU emulates no gfx90c/DCN, so on QEMU this either finds no AMD
# display device (clean no-op) or a non-AMD VGA with no BAR5 (reported, skipped).
# Validation: boot archaemenid, `klug > /f/gpu.txt`, read back the dump.
#
# Constants + the Renoir IP base table live in gpu_regs.cyr. Later bites (C0
# firmware-reality, C1 GPUVM, C2 CP/MEC ring, P0 DCN pipe) build on this seam.

var gpu_present  = 0;        # 1 = an AMD GPU was bound by F0
var gpu_pci_idx  = 0 - 1;    # PCI enumeration index of the bound GPU
var gpu_mmio     = 0;        # BAR5 register-aperture base (VA == PA, UC-mapped)
# C1: the PSP GPCOM ring — 32 KB usable + a page of alignment slack. Module-global
# `var X[N]` = N x u64, so [4608] = 36 KB (32 KB ring rounded up to a page + slack).
# (C1a's register-only probe used this static buffer; C1b re-creates the ring in a
# UC region — DMA needs UC — so this static buffer is now the C1a-record path only.)
var gpu_psp_ring[4608];
# C1b: the UC command-ring buffers (allocated + UC-mapped in gpu_psp_setup; reused by
# the later LOAD_IP_FW path). ring/cmd/fence live in one 2 MB UC region.
var gpu_psp_ring2 = 0;       # UC GPCOM ring base
var gpu_psp_cmd   = 0;       # 4 KB UC command buffer
var gpu_psp_fence = 0;       # UC fence word
var gpu_psp_fctr  = 0;       # monotonic fence counter (first submit = 1)
# the FB-aperture arena setup: the compute arena in the UMA carveout — CPU-physical base (UC-mapped) + the MEC
# MC (FB-aperture) base. the compute-queue HQD setup/d build the ring/MQD here. Set by gpu_vm_setup.
var gpu_arena_mc   = 0;      # MEC/FB-aperture MC address (pq_base = mc>>8)
var gpu_arena_phys = 0;      # CPU physical address (UC-mapped)
var gpu_queue_active = 0;    # the compute-queue HQD setup: 1 = MEC1/pipe0/queue0 mapped (HQD active, empty)
var gpu_sdma_ready   = 0;    # the SDMA ring bring-up: 1 = SDMA0 GFX ring up (F32 un-halted + idle, ring configured)
var gpu_ring_fetched = 0;    # the first PM4 fetch: 1 = the MEC fetched+consumed a PM4 packet (VM-fetch gate open)
var gpu_ring_wptr    = 0;    # CPU-canonical ring write cursor in DWORDS (the first PM4 fetch sets =8; the WRITE_DATA fence/the first shader dispatch append)
var gpu_fence_ok     = 0;    # the WRITE_DATA fence: 1 = MEC executed WRITE_DATA AND the write is CPU-visible
var gpu_shader_ok    = 0;    # the first shader dispatch: 1 = shader RAN + store CPU-visible; -1 no-retire; -2 store-stale; -3 fault
var gpu_mt_ok        = 0;    # the first 64-thread dispatch: 1 = all 64 tids written CPU-visible; -1 no-retire; -2 partial; -3 fault
var gpu_kernarg_ok   = 0;    # the kernarg dispatch: 1 = all 64 out[i]==in[i] via kernarg pointers; -1 no-retire; -2 partial; -3 fault
var gpu_reduce_ok    = 0;    # the dot-product dispatch: 1 = all 64 dot products correct (loop+MAC); -1 no-retire; -2 partial; -3 fault
var gpu_matmul_ok    = 0;    # the integer matmul proof: 1 = 8x8 integer matmul bit-correct vs CPU; -1 no-retire; -2 partial; -3 fault
var gpu_matmul_f64_ok = 0;   # f64: 1 = 8x8 f64 matmul bit-correct (exact-int data) vs CPU; -1 no-retire; -2 partial; -3 fault
var gpu_f64_fidelity_ok = 0; # f64 fidelity: 1 = rosnet-bit-correct on NON-exact (rounding) data vs in-kernel f64_mul/f64_add; -1/-2/-3 as above
var gpu_display_ok    = 0;   # P0 (1.55.x display arc): 1 = lit HUBP scanout matches fb_phys; -1 no match; -2 surface matched but no OTG lit
var gpu_display_pipe  = 0 - 1; # P0: the HUBP instance scanning out our console (P1 re-points this one)
var gpu_display_surf  = 0;   # P0: that pipe's FRONT surface MC address (the P1 restore target)
var gpu_display_swmode = 0;  # P4: the lit pipe's HUBP SW_MODE (0 = linear; non-zero = tiled → console bands)
var gpu_vblank_ok     = 0;   # P2: 1 = frame counter advances + both scan phases observable (the pacing signal); -1 counter stuck; -2 no blank; -3 no active
# blit#39 double-buffering (tear-free full-screen apps). Falls back to the direct FB when unarmed.
var gpu_bb_armed      = 0;   # 1 = the two app buffers are WC-mapped + cleared
var gpu_bb_a_phys     = 0;   # buffer A: CPU (carveout direct-DRAM window) / MC (what the HUBP fetches)
var gpu_bb_a_mc       = 0;
var gpu_bb_b_phys     = 0;   # buffer B
var gpu_bb_b_mc       = 0;
var gpu_bb_back       = 0;   # current RENDER target: 0 = A, 1 = B (the other is being scanned)
var gpu_bb_fbsize     = 0;   # framebuffer byte size (pitch*height) — the CP-DMA fill span for gpu_fill_sys
# ⚠ gpu_blend_ok is a SELFTEST-ONLY flag: set only by gpu_shader_blend_test under #ifdef SHADER_BLEND, so it
# is 0 in every production kernel. It must NEVER gate a runtime path (#92 gates on gpu_matmul_ok instead —
# gpu_shader_dispatch5 runs ungated at every boot). It DOES gate gpu_shader_cov_test and gpu_shader_rect_test,
# which is why SHADER_COV/SHADER_RECT require SHADER_BLEND — enforced in scripts/build.sh after a burn was
# spent on a kernel that printed "gpu: skipping coverage" and proved nothing.
var gpu_blend_ok      = 0;   # plan-S2: 1 = per-pixel alpha blend proven on the CUs
var gpu_rect_ok       = 0;   # plan-S5: 1 = grid blend into the scanout back buffer proven (and presented)
var gpu_blend_armed   = 0;   # 1 = blend_rect resident in its own arena slot for #92 op GPU_OP_BLEND_RECT
var gpu_cov_ok        = 0;   # plan-S10: 1 = coverage (anti-aliased) blend proven on iron
var gpu_cov_armed     = 0;   # 1 = blend_cov resident in its own arena slot for #92 op GPU_OP_BLEND_COV
var gpu_glyph_ok      = 0;   # plan-S9: 1 = 1bpp glyph expansion proven on iron
var gpu_glyph_armed   = 0;   # 1 = glyph_1bpp resident for #92 op GPU_OP_GLYPH_1BPP
var gpu_grad_ok       = 0;   # plan-S11: 1 = linear gradient proven on iron
# ============================================================================================
# THE EDGE ENVELOPE — MOVED ON MEASUREMENT, 1.56.19
# ============================================================================================
# ⭐ MEASURED on archaemenid (probe burn, `gputri --bench` edge sweep, 128x128 fixed):
#
#   ne     4      8     16     32     64    128    256
#   us    66    105    186    342    655   1278   2525
#   marginal us/edge (fixed cost removed): 9.50 9.62 9.87 9.81 9.79 9.76 9.75
#
# ⭐⭐ FLAT to ~2.6% across a 64x range in E, so COST IS LINEAR IN E. Least-squares:
#     cost_us = 28.8 + 0.0005953 * (w*h) * n_edges
# and that 28.8 us intercept independently agrees with burn 5's ~28 us derived from a completely
# different sweep (mask size at fixed E=3). Two independent measurements, one constant.
#
# ⛔ SO EDGE_CAP ALONE WAS THE WRONG KNOB, and the numbers say so plainly. It PERMITTED
# 4096^2 x E=64 (~639 ms — six times over the watchdog) and FORBADE 64^2 x E=256 (~0.65 ms).
# The real constraint is the WORK PRODUCT w*h*n_edges. The edge count is now bounded only by the
# ABI's 256, and the work product is the gate that actually protects the watchdog.
#
# GPU_EDGE_WORK_MAX = 2^26. Derivation, not a guess:
#   * the dispatch watchdog is 100 ms of REAL time. It was ~93.9 ms when this bound was first derived,
#     because the cycles-per-us figure was hardcoded at 3000 against a calibrated 3194; gpu_tsc_per_us()
#     now returns the measured value, so the nominal and the real number finally agree;
#   * 2^26 work units predict ~40.0 ms = 40.0% of that, leaving >2x headroom for clock boost,
#     shape variation, and the fit's own error;
#   * it ACCEPTS 4096^2 with a triangle (~30 ms) and 256^2 with 256 edges (~10 ms), and REJECTS
#     4096^2 x E=64. Those are the envelopes that matter.
# ⚠ The clock retune only WIDENED this margin (42.6% -> 40.0% of the window), so the bound did not move.
#   Raise it only from a fresh sweep, the same way this one was set.
var GPU_EDGE_CAP      = 256;         # the ABI maximum; the work product below is the real gate
var GPU_EDGE_WORK_MAX = 67108864;    # 2^26 w*h*n_edges  ~= 40 ms of the 100 ms watchdog
var gpu_edge_armed    = 0;   # 3D rung 9: 1 = edge_cov blob resident (written at 9b; 0 through all of 9a)
var gpu_grad_armed    = 0;   # 1 = grad_linear resident in its own arena slot for the #92 op path
var gpu_perm_ok       = 0;   # plan-S4: 1 = v_perm_b32 byte crossbar + channel swap proven on iron
var gpu_blend_pk_ok   = 0;   # plan-S4: 1 = VOP3P packed blend proven bit-identical to the f32 blend
var gpu_batch_ok      = 0;   # plan-S12: 1 = a batched frame proven pixel-identical to op-by-op
# ⛔ REMOVED 1.56.25 — the plan-D phase clock (`gpu_ts_base` / `gpu_ts_reset()` / `gpu_ts_mark()`).
# It stamped "gpu: [T+NNNms] <label>" on each D-lane transition so a framebuffer PHOTO could identify
# which phase it caught. Its consumers were the D-lane boot self-tests, and those were deleted at
# 1.56.x — the note directly below has said so ever since, while the clock itself stayed, callerless
# and reading as live instrumentation to anyone planning the next photo bite. Zero call sites
# repo-wide at removal. The D lane is closed; if a future visual bite needs phase stamping, write it
# then against that bite's actual oracle — and see [[feedback_dlane_five_burns_what_went_wrong]] on
# why a visual test must not be a boot self-test in the first place.
var gpu_otg_lock_acked = 0;  # last gpu_otg_lock result — 0 means the lock TIMED OUT and nothing committed
# gpu_d1_ok / gpu_d2_ok are GONE with the boot self-tests that set them (1.56.x). Nothing ever read them —
# they were write-only flags, which is the tell that a boot self-test was standing in for a result the
# operator was going to have to read off the panel anyway. The D lane's verdict now lives where it always
# belonged: in what the operator saw on the panel across the five burns that closed the lane.
# plan-S3 coherence toggles. BOTH default to 1 and PRODUCTION NEVER CHANGES THEM — decision D-6 keeps the
# pre-dispatch invalidate unconditional (it is load-bearing twice: stale I$ on a rewritten shader VA, and
# stale GL2 lines when a shader reads bytes CP-DMA just wrote MC-direct). They exist so gpu_shader_cohere_test
# can MEASURE what each packet actually buys, which has never been done — every build to date emitted both
# unconditionally, so "the write-back is load-bearing for display visibility" is an assumption.
# ⚠ Only ever set via gpu_cohere_run(), which restores both on EVERY exit path. A leaked 0 here re-creates
# the the first 64-thread dispatch stale-shader class that cost eight burns.
# plan-S12: when non-zero, the *_run emitters put their dispatch in the ring and RETURN WITHOUT the tail —
# the batch driver (gpo_execute_all) owns the single TC write-back, the single fence and the single kick.
# ⚠ Written in exactly one place, gpo_execute_all, which clears it on every exit path. It is safe as an
# ambient flag only because pass 1 has already validated every op, so pass 2 cannot fail mid-emit and leave
# a partial program in the ring with no fence behind it.
var gpu_batch_active  = 0;

# ============================================================================================
# 1.56.26 — `#92` PHASE PROFILE. The instrument that decomposes `F`.
# ============================================================================================
# THE QUESTION, stated so it cannot drift: rung 14b's refit put **264 µs of FIXED cost** in one
# `#92` call, measured ONLY at 32 primitives. If that term scales PER PRIMITIVE (~7.4 µs each) a
# 640-column DOOM frame carries ~4.7 ms of CPU that **no transpose can remove** — comparable to the
# entire row-major GPU cost. If it is PER DISPATCH it is 0.27 ms and irrelevant. **The two answers
# differ by 17× and nothing has separated them**, because every number so far came from timing the
# whole syscall from ring 3, which cannot tell the three phases apart.
#
# So the kernel times its own phases and reports them, rather than ring 3 timing the total and
# guessing. The phases are the three real stages of `gpu_shader_op_sys`:
#   COPYIN   — proc_copy_from_user of the descriptor array (scales with the ARRAY, not the work)
#   VALIDATE — the gpo_validate pass over n records (per-RECORD; the suspected ~7.4 µs lives here
#              or in BUILD)
#   BUILD    — the gpo_execute pass: per-op prep (gpu_texl_build / gpu_tex_prep) + ring emission
#   WAIT     — gpu_batch_tail + gpu_ring_kick_wait: the actual GPU time plus submission
# COPYIN+VALIDATE+BUILD is CPU work that a transpose cannot touch. WAIT is what col-major moved.
# ⭐ Reading them separately at two primitive counts answers the question with no new hypothesis:
# if VALIDATE+BUILD grows ~linearly in n_prims, F is per-primitive; if it is flat, F is per-dispatch.
#
# ⭐ AND THE GRID IS OBSERVED, NOT PREDICTED. Every wave count quoted in this arc so far was computed
# CPU-side by the instrument from what it BELIEVED the kernel would launch. `gpu_prof_gx/_gy` are
# captured inside `gpu_blend_cov_run` — the one primitive all ten dispatch sites funnel through — so
# they are what was actually programmed. A disagreement between the two IS a finding.
#
# ⚠ Unconditional, deliberately NOT behind an `#ifdef`. Four `rdtsc` reads against a 264 µs call is
# noise (~10 ns), and a build flag would mean the measuring kernel differs from the shipping one —
# the ATOM_DRY shape that has already cost this project burns
# ([[feedback_ifdef_bites_name_their_build_flags]]). One kernel, always measurable.
# ⚠ LAST-CALL semantics, not cumulative: each `#92` overwrites these. A caller that wants a stable
# read must not issue another `#92` between the call it cares about and its `#89` probe.
var gpu_prof_copyin_us = 0;   # descriptor copy-in
var gpu_prof_valid_us  = 0;   # gpo_validate over all n records
var gpu_prof_build_us  = 0;   # gpo_execute over all n records (prep + ring emission)
var gpu_prof_wait_us   = 0;   # gpu_batch_tail + gpu_ring_kick_wait
var gpu_prof_gx        = 0;   # grid X actually programmed at the LAST dispatch
var gpu_prof_gy        = 0;   # grid Y actually programmed at the LAST dispatch
var gpu_prof_waves     = 0;   # gx*gy summed across EVERY dispatch in the last #92 call
var gpu_prof_nops      = 0;   # records in the last #92 call
# ⭐ Self-drain time: GPU execution that happens INSIDE the build loop because the op suspended
# batching to wait on its own fence (gpu_tex_list / gpu_tri_list, the 1.56.21 invariant). Accumulated
# by both dispatch primitives and then moved out of BUILD and into WAIT by gpo_execute_all, so BUILD
# means CPU prep + ring emission and nothing else. Without this the whole measurement is confounded —
# see the ⛔⛔ note at the self-drain site.
var gpu_prof_drain_us  = 0;

# gpu_prof_us(t0) — elapsed microseconds since a prior rdtsc().
# ⚠ Returns 0 rather than a negative on a backwards delta. The TSC is invariant on this silicon and
# these calls do not migrate mid-syscall, but a 0 is an obviously-absent datum whereas a negative
# would propagate into a u32 field as a colossal positive and read as a real measurement.
fn gpu_prof_us(t0) {
    var now = rdtsc();
    if (now <= t0) { return 0; }
    return (now - t0) / gpu_tsc_per_us();
}
var gpu_tex_armed     = 0;      # rung 13: the texturing blob is resident
var gpu_texl_armed    = 0;      # rung 14: the fused-list blob is resident
var gpu_texl_cm_armed = 0;      # rung 14b: the COL-MAJOR blob is resident (a separate 4 KB slot)
var gpu_texbi_armed   = 0;      # rung 15: the BILINEAR blob is resident (its own 4 KB slot, 48 VGPRs)
var gpu_texl_maxw     = 0;      # widest primitive in the list just built -> the tile shift
var gpu_texl_maxh     = 0;      # tallest ditto -> the tile shift under COLMAJOR
var gpu_texl_colmajor = 0;      # rung 14b: lane axis of the list just built (0 = X, 1 = Y)
var gpu_cohere_wb     = 1;   # 1 = emit the post-dispatch TC write-back (7 dwords)
var gpu_cohere_inv    = 1;   # 1 = emit the pre-dispatch ACQUIRE_MEM invalidate (7 dwords)
var gpu_bb_pitch      = 0;   # framebuffer row pitch in BYTES — the dst stride for gpu_blit_shm_sys
var gpu_scanout_pid   = 0 - 1; # pid owning the scanout (-1 = the console owns it)
# P3a display-audio discovery (read-only probe results)
var gpu_audio_dp      = 0 - 1; # 1 = the lit stream is DP (DTO1, constant module); 0 = HDMI (DTO0, pixel-clock module); -1 = unknown
var gpu_audio_dig     = 0 - 1; # the live stream encoder (DIG) carrying the lit stream
# ⛔ THE RE-DISCOVERY TRIPWIRE. Set to 1 while a caller has deliberately torn down the BE<->FE routing
# (mdo_transmit_run's disconnect, STAGE-1's DIG_ENABLE clear). gpu_phy_discover() reads live routing, so
# in that window it CANNOT answer — and its honest -1 is indistinguishable from "this board has no live
# encoder", which is what let the same bug land twice: once in both halves of the M8e transmitter cycle,
# once in M9d's staging call. The flag does not change the answer; it changes the LOG, from a generic
# "phyid undeterminable" into a named instruction to the caller. A wrong answer you can read is a bug you
# fix once instead of three times.
var gpu_phy_routing_torn = 0;
# HDMI_AUDIO_SWEEP: when 1, gpu_hdmi_audio_enable() suppresses its status prints + the CRC probe so the
# sweep harness can re-run it as a quiet baseline reset between fix-profiles. 0 = normal verbose boot enable.
var gpu_audio_quiet   = 0;
# P3b: the live pixel clock in 100 Hz units — THE value the HDMI audio DTO's MODULE field takes (and what the
# ACR CTS is computed from). 0 = not derived (then P3b must not program the DTO). Derived, not read: the
# DCCG's DP_DTO_PHASE register only holds the pixel clock on a DP-driven pipe, and this link is HDMI.
var gpu_pixclk_100hz  = 0;
# The live raster totals, kept from gpu_pixclk_discover so the AVI InfoFrame can describe the actual link
# rather than hardcoding one panel's numbers. amdgpu's AVI on this iron carries bottom-bar = v_total+1 and
# right-bar = h_total+1 (1482 / 2721 against a 2720x1481 link) — measured, not derived from a spec.
var gpu_h_total       = 0;
var gpu_v_total       = 0;
var gpu_h_active      = 0;    # link active width — for HDMI_AUDIO_PACKETS_PER_LINE (data-island budget)
var gpu_v_active      = 0;    # link active height — computed alongside gpu_h_active; surfaced in #93 caps
# P3b-ii pre-flight: 1 = every precondition for the DVI->HDMI DIG_MODE flip is verified clear on the live
# encoder. 0 = do NOT flip (a hazard is armed, or the link/encoder isn't ours to touch). Read-only result.
var gpu_hdmi_flip_ok  = 0;
# P3b-iii: 1 = the display side of the audio path is programmed (link in HDMI signalling, DTO fed the live
# pixel clock, endpoint enabled, AFMT tap open). This is the half the 1.53.5 HDA work was missing.
var gpu_hdmi_audio_on = 0;

# Read a 32-bit GPU register given its IP base segment + DWORD offset. Absolute
# DWORD index = base + off; MMIO byte offset = index * 4 into the BAR5 aperture.
# Direct path only (every F0 register has index*4 < GPU_RMMIO_SIZE); the
# indirect PCIE_INDEX2/DATA2 (SMN) path is a later bite. Pure load — no state
# change, so calling it does not perturb scanout or any engine.
fn gpu_reg32(base_seg, off) {
    return load32(gpu_mmio + (base_seg + off) * 4);
}

# MMIO register WRITE (UC, readback-flush) — the write twin of gpu_reg32. The
# readback pushes the store past any posted-write reordering (the nvme/hda idiom).
# Used by C1's PSP mailbox handshake. Do NOT call before F0 mapped BAR5.
fn gpu_reg32_write(base_seg, off, val) {
    var a = gpu_mmio + (base_seg + off) * 4;
    store32(a, val);
    var flush = load32(a);
    return 0;
}

# Busy-spin >= us microseconds via rdtsc (the hda_udelay idiom; agnos has no
# udelay). The PSP handshake needs ~20 ms settles between ring ops.
#
# === CYCLES-PER-MICROSECOND: MEASURED WHEN POSSIBLE, ESTIMATED WHEN NOT ===================================
#
# This file used to hardcode `gpu_tsc_per_us() = 3000` with a comment explaining that it could not be
# calibrated, because GPU init runs BEFORE `sti` and the 100 Hz tick is the only other time source. That
# was true of GPU INIT. It was never true of the ring-3 dispatch path, which runs long after
# tsc_calibrate() has measured the real number against live ticks — and on archaemenid the real number is
# 3194, not 3000. The consequence was a "100 ms" dispatch watchdog that actually expired at ~93.9 ms.
#
# So the number is no longer a constant, it is a QUERY. gpu_tsc_per_us() returns the calibrated value once
# one exists and the estimate before that. The split falls exactly on the sti boundary for free: callers
# during GPU init see tsc_per_us == 0 and get the estimate; every syscall-driven caller gets the truth.
#
# ⚠ THE ESTIMATE IS STILL AN ESTIMATE. It is only reachable before calibration, where nothing measures
# anything — it just has to be close enough that the PSP settles are long enough. It is set to the
# archaemenid measurement because a measured number from the one box we boot on beats a round one.
#
# ⭐ WHY THIS IS SAFE TO CHANGE ON A PROVEN TIMING PATH: every use of this value is a multiply into a
# timeout/delay or a divide into a report. A LARGER value makes every delay longer, every timeout longer,
# and every reported duration smaller (more accurate). There is no site anywhere in this file where a
# larger cycles-per-us shortens something. 3000 -> 3194 therefore moves every timing path in the direction
# of more patience, never less. That asymmetry is why this could be one bite instead of a burn.
var GPU_TSC_PER_US_FALLBACK = 3194;   # pre-calibration estimate ONLY — call gpu_tsc_per_us(), never this

fn gpu_tsc_per_us() {
    # tsc_per_us is declared in arch/x86_64/boot_data.cyr (parsed at agnos.cyr:8, long before this file)
    # and set by tsc_calibrate() in main.cyr right after `sti`. 0 means calibration has not run or refused.
    if (tsc_per_us != 0) { return tsc_per_us; }
    return GPU_TSC_PER_US_FALLBACK;
}

#ifdef TSC_SELFTEST
# gpu_tsc_selftest — does the retune actually reach the timing paths? Called from main.cyr under
# TSC_SELFTEST, immediately after tsc_calibrate(), because arm C has no meaning before then.
#
# ⚠ ARMS A AND C ARE ECHO TESTS and are scored as such: they write a value and read it back through the
# accessor, which proves the branch selects but proves nothing about the delay it feeds. Arm D is the
# answer register — it measures a real gpu_udelay() against timer_ticks, a clock with no shared mechanism
# with the TSC at all. A pass on A+C with a fail on D would mean the accessor is correct and the delay
# path still is not. ([[feedback_echo_vs_answer_registers]])
fn gpu_tsc_selftest() {
    var pass = 0;
    var save = tsc_per_us;

    # A: the pre-calibration branch. Forced, because by here the real one can never be taken again.
    tsc_per_us = 0;
    if (gpu_tsc_per_us() == GPU_TSC_PER_US_FALLBACK) { pass = pass + 1; }
    tsc_per_us = save;

    # B: the fallback is sane. A zero here would multiply every timeout to zero and every dispatch would
    # "time out" instantly on the first read; a garbage-large one would hang the box past any watchdog.
    # This arm exists because that failure is silent, catastrophic, and one typo away.
    if (GPU_TSC_PER_US_FALLBACK > 100) {
        if (GPU_TSC_PER_US_FALLBACK < 10000) { pass = pass + 1; }
    }

    # C: the calibrated branch — THE POINT OF THE RETUNE. Before this change the timing paths used a
    # hardcoded 3000 no matter what calibration found.
    #
    # ⭐ TESTED WITH AN INJECTED SENTINEL, NOT THE LIVE VALUE, and that choice is the difference between a
    # gate and a coincidence. Mutation-testing this bite (accessor forced back to "always the constant")
    # showed the live-value form only caught it because this box calibrates to 3193 while the fallback is
    # 3194 — a margin of ONE. On a box that happened to calibrate to exactly the fallback, comparing the
    # accessor against the live value would have passed the mutant, because both sides would read 3194.
    # A sentinel no real clock can produce removes the hardware from the test entirely.
    tsc_per_us = 4242;
    if (gpu_tsc_per_us() == 4242) { pass = pass + 1; }
    tsc_per_us = save;

    # D: ⭐ independent oracle. Ask for 50 ms through the same gpu_udelay() the PSP settles use, and time it
    # on the 100 Hz tick. The band is wide on purpose — this arm is not measuring the clock's accuracy
    # (tsc_calibrate already did, and 100 Hz cannot resolve 6.5% over 50 ms anyway). It is asking whether a
    # delay built from gpu_tsc_per_us() lands in the right ORDER OF MAGNITUDE, which is what catches a unit
    # slip, a zero, or an accessor that silently returns cycles-per-second.
    var t0 = timer_ticks;
    gpu_udelay(50000);
    var dt = timer_ticks - t0;
    if (dt > 2) {
        if (dt < 10) { pass = pass + 1; }
    }

    kprint("gpu-tsc: ", 9); kprint_num(pass); kprint("/4 arms; per_us ", 16);
    kprint_num(gpu_tsc_per_us());
    kprint(" (fallback ", 11); kprint_num(GPU_TSC_PER_US_FALLBACK);
    kprint("), 50 ms udelay measured ", 25); kprint_num(dt); kprintln(" ticks", 6);
    # ⛔ A BARE "0 ticks" READS AS "the delay did not happen", and that is the wrong diagnosis: it means the
    # ORACLE stopped, not the delay. Say so, because the two failures have nothing in common and the first
    # instinct on seeing this line will be to go and read gpu_udelay.
    if (dt == 0) {
        kprintln("gpu-tsc: arm D oracle is FROZEN -- timer_ticks did not advance at all, so this says", 83);
        kprintln("gpu-tsc:   nothing about gpu_udelay. Check IF, and check what ran before this point.", 84);
    }
    if (pass == 4) { kprintln("gpu-tsc: PASS", 13); }
    if (pass != 4) { kprintln("gpu-tsc: FAIL", 13); }
    return pass;
}
#endif

var gpu_last_wait_us = 0;    # wall time the most recent gpu_wait_done actually spent, for the S12 measurement

# gpu_wait_done — spin until `done_phys` reads `expect`, bounded by timeout_us of wall time. Returns 1/0.
#
# ⚠ THIS REPLACES a `while (i < 1000) { ...; gpu_udelay(100) }` idiom that quantised EVERY dispatch to a
# multiple of 100 us. The first load32 in that loop always misses — the CP has not retired the fence yet at
# the instant the CPU arrives — so the loop then slept a full 100 us quantum unconditionally. Measured at
# ~113 us per op, of which ~88% was that sleep rather than the GPU.
#
# ⚠ WHY IT HAD TO BE FIXED BEFORE plan-S12, NOT AFTER: a batch pays ONE quantum instead of N. Measuring
# batching against the untightened baseline would have credited the batch with ~5x that it did not earn, and
# S12's stated deliverable — "a batched frame that is NOT faster means the fence was never the wall, and
# that finding is the deliverable" — would have been unfalsifiable.
#
# Records the elapsed wall time in gpu_last_wait_us so the caller can print a real number rather than a
# comment. The final re-check after the bound closes the race where the marker lands in the last few cycles.
# ============================================================================================
# RUNG 4 (3D arc) — THE BRACKET. agnos has had NO GPU hang forensics of any kind until now.
# ============================================================================================
# ⛔ THE PROBLEM THIS SOLVES. Today a wedged GPU is a dead box with no log — and that is already
# true for #82, #83 and #92, which SHIP. A 100 ms timeout returns 0 and the caller guesses.
# There is no way to ask "which packet?" because nothing records where the CP got to.
#
# THE BRACKET is two numbers that together pin the hang:
#     breadcrumb  <=  hung_packet  <=  rptr
#   * breadcrumb — the last seq the CP *executed* a WRITE_DATA for. ⭐ THE CP WRITES IT, so it
#     is an ANSWER, not an echo of a CPU store ([[feedback_echo_vs_answer_registers]]).
#   * rptr       — how far the CP's *fetcher* got. An upper bound: fetch runs ahead of execute.
# Everything strictly between them is the candidate set, and it is usually one packet.
var gpu_breadcrumb_seq = 0;

# Emit a breadcrumb packet into the ring. WRITE_DATA DST_SEL=5 (memory) | WR_CONFIRM — the same
# packet shape as the done fence, which is already iron-proven, so this adds no new packet class.
fn gpu_ring_breadcrumb(seq) {
    var mc = gpu_arena_mc + GPU_BREADCRUMB_SUBOFF;
    gpu_ring_put(GPU_PM4_WRITE_DATA_HDR);
    gpu_ring_put(GPU_PM4_WRITE_DATA_CTL);
    gpu_ring_put(mc & 0xFFFFFFFF);
    gpu_ring_put((mc >> 32) & 0xFFFFFFFF);
    gpu_ring_put(GPU_BREADCRUMB_BASE | (seq & 0xFFFF));
    return 0;
}

# The forensic block. Captured on EVERY gpu_wait_done timeout, then spilled — because the
# console is exactly what a GPU hang is most likely to take with it, so the log must reach the
# disk before anything else is attempted ([[feedback_klug_text_burn_capture]]).
# ⚠ Every value here is READ FROM HARDWARE. None is a readback of something agnos just wrote.
fn gpu_forensic_dump(done_phys, expect) {
    kprintln("gpu: ---- FORENSIC BLOCK (wait timed out) ----", 46);
    # ⛔ THE HQD REGISTERS ARE BEHIND A MUX. CP_HQD_* is per-queue and only readable while
    # GRBM_GFX_CNTL selects that queue — read them unselected and you get another queue's state,
    # which is worse than no forensics because it looks like data. Matches the select/deselect
    # idiom already used at gpu.cyr:1064/1092.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    var rptr   = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR) & 0xFFFFFFFF;
    var wptr   = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO) & 0xFFFFFFFF;
    var active = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_ACTIVE) & 0xFFFFFFFF;
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
    var st1 = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS) & 0xFFFFFFFF;
    var st2 = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS2) & 0xFFFFFFFF;
    var cps = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_STAT) & 0xFFFFFFFF;
    var crumb = load32(gpu_arena_phys + GPU_BREADCRUMB_SUBOFF) & 0xFFFFFFFF;
    var seen  = load32(done_phys) & 0xFFFFFFFF;

    kprint("gpu: rptr ", 10); kprint_num(rptr);
    kprint(" wptr ", 6); kprint_num(wptr);
    kprint(" hqd_active ", 12); kprint_num(active & 1); kprintln("", 0);
    kprint("gpu: grbm_status ", 17); kprint_hex(st1);
    kprint(" grbm_status2 ", 14); kprint_hex(st2);
    kprint(" cp_stat ", 9); kprint_hex(cps); kprintln("", 0);
    kprint("gpu: fence expected ", 20); kprint_hex(expect);
    kprint(" saw ", 5); kprint_hex(seen); kprintln("", 0);

    # ⛔ THE BRACKET ITSELF. A breadcrumb that never advanced past its base means the CP never
    # executed a single packet — a different failure from one that stopped midway, and the
    # distinction decides whether to suspect submission or a specific packet.
    # ⛔ THE RACE THAT MADE THIS INSTRUMENT LIE ONCE (iron, 2026-07-25, rung 5 arm A).
    # The first version reported "the CP executed no packet at all" whenever the breadcrumb was
    # unwritten. On the rung-5 burn that fired with `rptr 529 wptr 529` — the CP had simply NOT
    # FETCHED YET; the dump raced the submission. Moments later, during arm C, the SAME hang read
    # `rptr 534 wptr 614` and `breadcrumb seq 1`, which is the correct bracket.
    # An unwritten breadcrumb has TWO causes demanding OPPOSITE investigations:
    #     rptr == wptr -> submitted but NOT YET FETCHED. Suspect the doorbell / wptr update.
    #     rptr <  wptr -> the CP IS fetching and executed nothing. Suspect the first packet.
    # Collapsing them sent the first reading of this arc's most important burn the wrong way.
    # ⚠ SETTLE, THEN RE-READ: the CP may be mid-fetch at the instant of the timeout, and a
    # bounded settle costs nothing on a path that has already waited its full timeout.
    if ((crumb & 0xFFFF0000) != GPU_BREADCRUMB_BASE) {
        gpu_udelay(2000);
        crumb = load32(gpu_arena_phys + GPU_BREADCRUMB_SUBOFF) & 0xFFFFFFFF;
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
        var rptr2 = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR) & 0xFFFFFFFF;
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
        if ((crumb & 0xFFFF0000) == GPU_BREADCRUMB_BASE) {
            kprint("gpu: breadcrumb appeared after settle -- seq ", 45);
            kprint_num(crumb & 0xFFFF);
            kprintln(" (the dump had raced the CP)", 28);
        }
        if ((crumb & 0xFFFF0000) != GPU_BREADCRUMB_BASE) {
            if (rptr2 == wptr) {
                kprintln("gpu: breadcrumb unwritten, rptr == wptr -- SUBMITTED BUT NOT FETCHED", 68);
                kprintln("gpu: suspect the doorbell / wptr update, NOT the packet stream", 62);
            }
            if (rptr2 != wptr) {
                kprintln("gpu: breadcrumb unwritten, rptr < wptr -- the CP IS fetching and", 64);
                kprintln("gpu: executed nothing. Suspect the FIRST packet in the block", 60);
            }
        }
    }
    if ((crumb & 0xFFFF0000) == GPU_BREADCRUMB_BASE) {
        kprint("gpu: breadcrumb seq ", 20); kprint_num(crumb & 0xFFFF);
        kprint(" of ", 4); kprint_num(gpu_breadcrumb_seq);
        kprintln("  -- the hang is AFTER this packet block", 40);
    }

    # The 16 ring dwords at rptr — the packets the CP was fetching when it stopped. Decoded
    # host-side by name (tests/gpu/pm4lint.cyr knows the framing).
    kprintln("gpu: ring dwords at rptr:", 25);
    var i = 0;
    while (i < 16) {
        var idx = ((rptr / 4) + i) & GPU_RING_DW_MASK;
        kprint("gpu:   [", 8); kprint_num(i);
        # ⚠ The PQ ring base IS gpu_arena_phys + 0 — see gpu_ring_put, which stores at exactly
        # that address. Reading it anywhere else would print 16 dwords of an unrelated slot and
        # look like a decoded packet stream, which is worse than printing nothing.
        kprint("] ", 2); kprint_hex(load32(gpu_arena_phys + idx * 4) & 0xFFFFFFFF);
        kprintln("", 0);
        i = i + 1;
    }
    kprintln("gpu: ---- END FORENSIC BLOCK ----", 33);
    # ⚠ SPILL NOW. The console may not survive what comes next.
    klug_spill();
    return 0;
}

# ============================================================================================
# RUNG 5 (3D arc) — THE RECOVERY LADDER. The largest item in the arc, done first.
# ============================================================================================
# ⛔ WHY THIS EARNS ITS BURN INDEPENDENT OF 3D. A runaway tentib ternary matmul through #82, or
# a malformed #92 batch from aethersafha, currently kills the box with NO LOG. Those consumers
# ship TODAY. Every safety property agnos has bounds how long the CPU WAITS, not what the GPU
# DOES — nothing has ever asked the GPU to stop.
#
# ⛔⛔ NO GRBM_SOFT_RESET, EVER. gpu.cyr's own C1d note states it verbatim: a soft reset "would
# wipe PSP-loaded ucode", and agnos re-loads that ucode only at boot. A reset would turn a
# recoverable hang into a dead GPU until reboot — strictly worse than the hang.
#
# THE LADDER, least to most destructive. Each rung is tried only if the one before it failed.
var gpu_wedged = 0;          # 1 = the GPU is given up on; every GPU syscall returns a distinct errno
var gpu_recover_rung = 0;    # how far the last escalation had to climb (0 = never needed)

# R-2: ask the CP to unmap the queue, then WAIT FOR THE HARDWARE TO SAY IT DID.
# ⭐ CP_HQD_ACTIVE is cleared BY THE HARDWARE, so polling it is an answer, not an echo of our own
# DEQUEUE_REQUEST write ([[feedback_echo_vs_answer_registers]]). This is the one place in the
# ladder where we get a real acknowledgement rather than an inference.
fn gpu_recover_dequeue() {
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_DEQUEUE_REQUEST, GPU_CP_HQD_DEQUEUE_DRAIN);
    var t0 = rdtsc();
    var limit = 100000 * gpu_tsc_per_us();      # 100 ms — generous; the CP normally drains in µs
    var cleared = 0;
    while ((rdtsc() - t0) < limit) {
        if ((gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_ACTIVE) & 1) == 0) { cleared = 1; }
        if (cleared == 1) { break; }
    }
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
    if (cleared == 1) { kprintln("gpu: recover R-2 -- CP_HQD_ACTIVE cleared by hardware", 53); }
    if (cleared == 0) { kprintln("gpu: recover R-2 FAILED -- CP_HQD_ACTIVE stuck at 1", 51); }
    return cleared;
}

# R-3: halt the MEC, then un-halt. Heavier than a dequeue and it takes every queue on the engine
# down with it, which is why it is only reached when R-2 could not clear ACTIVE.
fn gpu_recover_mec_cycle() {
    var cur = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL) & 0xFFFFFFFF;
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL, cur | 0x50000000);   # MEC1+MEC2 halt
    gpu_udelay(1000);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL, cur);
    gpu_udelay(1000);
    kprintln("gpu: recover R-3 -- MEC halt/un-halt cycled", 43);
    return 1;
}

# The escalation itself. Returns 1 if the GPU is usable again, 0 if it has been given up on.
# ⚠ Called ONLY from a deliberate recovery path, never speculatively: every rung here disturbs
# live hardware, and running them on a GPU that was merely slow would manufacture the very hang
# they exist to clear.
fn gpu_recover_escalate() {
    if (gpu_present == 0) { return 0; }
    kprintln("gpu: ---- RECOVERY LADDER ----", 30);
    gpu_recover_rung = 2;
    if (gpu_recover_dequeue() == 1) {
        # Re-map the queue and re-arm the ring cursor. gpu_queue_setup() re-zeroes the MQD,
        # rptr-report page and EOP buffer and re-pushes the whole HQD image, so it is a genuine
        # re-map rather than a poke.
        gpu_ring_wptr = 0;
        gpu_queue_setup();
        gpu_recover_rung = 2;
        kprintln("gpu: recover -- queue re-mapped at R-2, GPU usable", 50);
        return 1;
    }
    gpu_recover_rung = 3;
    gpu_recover_mec_cycle();
    if (gpu_recover_dequeue() == 1) {
        gpu_ring_wptr = 0;
        gpu_queue_setup();
        kprintln("gpu: recover -- queue re-mapped after R-3, GPU usable", 53);
        return 1;
    }
    # R-4: give up, but keep the BOX alive. ⛔ This is the branch that matters most to a user:
    # the console and the shell must survive a dead GPU. The compositor degrades to the kernel's
    # CPU store32 blit, which touches no ring and cannot be wedged.
    gpu_recover_rung = 4;
    gpu_wedged = 1;
    kprintln("gpu: recover R-4 -- GIVING UP. gpu_wedged=1; GPU syscalls will refuse.", 70);
    kprintln("gpu: the console and shell remain alive on the CPU blit path.", 61);
    return 0;
}

#ifdef GPU_RECOVER
# ============================================================================================
# RUNG 5 ARM A — THE CONTROLLED WEDGE. ⛔ BEHIND A FLAG, AND IT MUST STAY THERE.
# ============================================================================================
# A kernel that can be ASKED to hang its own GPU must never ship that way. Under GPU_RECOVER
# only, this submits a WAIT_REG_MEM that polls a carveout dword for a value nothing will ever
# write. The CP blocks forever, the wait times out, and rung 4's bracket must NAME THIS PACKET.
#
# ⭐ THE PRIMARY ORACLE IS THE BRACKET, NOT THE RECOVERY. Arm A passes if the forensic block
# localises the hang — even if every recovery rung then fails. That separation is deliberate:
# "we can see the hang" and "we can clear the hang" are different claims with different
# consequences, and collapsing them would let a failed recovery hide a working instrument.
#
# WAIT_REG_MEM (PKT3 op 0x3C, count 5 -> 7 dwords):
#   dw1 = engine/mem/function:  mem-space(1<<4) | func=EQUAL(3)
#   dw2 = poll address LO, dw3 = HI, dw4 = reference, dw5 = mask, dw6 = poll interval
fn gpu_submit_wedge() {
    var poll_mc = gpu_arena_mc + GPU_BREADCRUMB_SUBOFF + 0x100;   # its own dword, never written
    store32(gpu_arena_phys + GPU_BREADCRUMB_SUBOFF + 0x100, 0);
    gpu_mfence();
    kprintln("gpu: ARM A -- submitting a WAIT_REG_MEM that can never be satisfied", 67);
    gpu_ring_breadcrumb(1);                      # before the trap: this MUST be seen
    gpu_ring_put(0xC0053C00);                    # PACKET3(WAIT_REG_MEM, count=5)
    gpu_ring_put(0x00000013);                    # mem space | function = EQUAL
    gpu_ring_put(poll_mc & 0xFFFFFFFF);
    gpu_ring_put((poll_mc >> 32) & 0xFFFFFFFF);
    gpu_ring_put(0xDEADBEEF);                    # reference the dword will never hold
    gpu_ring_put(0xFFFFFFFF);                    # mask
    gpu_ring_put(0x00000010);                    # poll interval
    gpu_ring_breadcrumb(2);                      # after the trap: this must NEVER be seen
    return 0;
}
#endif

# ============================================================================================
# RUNG 6 — arena-audit. READ-ONLY. Is the proposed region genuinely unclaimed?
# ============================================================================================
# ⛔ WHY THIS IS NOT PAPERWORK. With VM_CONTEXT0 disabled agnos has NO GPU page tables, so an
# out-of-bounds store does not fault — it lands somewhere REAL. The two places it must never
# land are the console framebuffer (offset 0) and the PSP TMR, and agnos re-loads PSP ucode only
# at boot, so corrupting the TMR is not recoverable without a reboot.
# ⚠ Rung 5's arm E deliberately fires an UNGUARDED write. It may only do that at an address this
# audit has PROVEN unclaimed — otherwise the control arm becomes the accident.
# Returns 1 = the sacrificial slot is provably free, 0 = refuse.
fn gpu_arena_audit() {
    if (gpu_present == 0) { return 0; }
    kprintln("gpu: ---- ARENA AUDIT (read-only) ----", 38);
    var fboff = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_OFFSET) & 0xFFFFFFFF;
    kprint("gpu: MC_VM_FB_OFFSET raw ", 25); kprint_hex(fboff);
    kprint("  => carveout phys base ", 24); kprint_hex((fboff & 0xFFFFFF) << 24);
    kprintln("", 0);
    kprint("gpu: arena phys ", 16); kprint_hex(gpu_arena_phys);
    kprint(" mc ", 4); kprint_hex(gpu_arena_mc);
    kprint(" size ", 6); kprint_hex(GPU_ARENA_SIZE); kprintln("", 0);
    kprint("gpu: highest published slot ", 28); kprint_hex(GPU_HIGHEST_PUBLISHED_SLOT);
    kprint("  sacrificial slot ", 19); kprint_hex(GPU_SACRIFICIAL_SUBOFF);
    kprintln("", 0);

    # THE THREE CONDITIONS, all required. Each is a different way the slot could be unsafe.
    var ok = 1;
    if (GPU_SACRIFICIAL_SUBOFF <= GPU_HIGHEST_PUBLISHED_SLOT) {
        kprintln("gpu: AUDIT FAIL -- sacrificial slot is at or below a published slot", 67);
        ok = 0;
    }
    if (GPU_SACRIFICIAL_SUBOFF + 4096 > GPU_ARENA_SIZE) {
        kprintln("gpu: AUDIT FAIL -- sacrificial slot runs past the end of the arena", 66);
        ok = 0;
    }
    if (gpu_arena_phys == 0) {
        kprintln("gpu: AUDIT FAIL -- no arena mapped", 34);
        ok = 0;
    }
    # ⛔ ASSERT CONTAINMENT — DO NOT MERELY PRINT IT. The first cut printed the carveout base and
    # the arena address and left a human to compare them, which is a data dump that happens to be
    # checkable, not an audit. On the 2026-07-25 burn the numbers did agree (arena 0xFF0000000
    # inside carveout [0xF70000000, 0x1030000000)) — but they agreed by inspection, with nothing
    # in the code that would have refused had they not.
    # ⚠ FREE CROSS-CHECK worth keeping: carveout_base + VRAM should land on the top of RAM the
    # boot path independently reported (0x1030000000 on this iron, and it does). Two unrelated
    # sources agreeing is what makes the MC_VM_FB_OFFSET decode trustworthy rather than plausible.
    var vram_mb    = gpu_reg32(GPU_BASE_NBIO_2, GPU_R_CONFIG_MEMSIZE) & 0xFFFFFFFF;
    var carve_base = (fboff & 0xFFFFFF) << 24;
    var carve_top  = carve_base + vram_mb * 1024 * 1024;
    kprint("gpu: carveout window ", 21); kprint_hex(carve_base);
    kprint(" .. ", 4); kprint_hex(carve_top);
    kprint("  vram ", 7); kprint_num(vram_mb); kprintln(" MB", 3);
    if (gpu_arena_phys < carve_base) {
        kprintln("gpu: AUDIT FAIL -- the arena is BELOW the carveout base", 55);
        ok = 0;
    }
    if (gpu_arena_phys + GPU_ARENA_SIZE > carve_top) {
        kprintln("gpu: AUDIT FAIL -- the arena runs past the carveout top", 55);
        ok = 0;
    }
    # ⚠ A LIVE READ, not just arithmetic: a region the slot map calls free but that already holds
    # a sentinel would mean the map is stale. Reads only; writes nothing.
    if (ok == 1) {
        var cur = load32(gpu_arena_phys + GPU_SACRIFICIAL_SUBOFF) & 0xFFFFFFFF;
        kprint("gpu: sacrificial slot currently reads ", 38); kprint_hex(cur); kprintln("", 0);
        if (cur == GPU_SACRIFICIAL_SENTINEL) {
            kprintln("gpu: NOTE slot already holds our sentinel -- a prior run left it", 64);
        }
    }
    if (ok == 1) { kprintln("gpu: ARENA AUDIT PASS -- the region is provably unclaimed", 57); }
    if (ok == 0) { kprintln("gpu: ARENA AUDIT REFUSED -- arm E must NOT fire", 47); }
    kprintln("gpu: ---- END ARENA AUDIT ----", 30);
    klug_spill();
    return ok;
}

# gpu_rt_overlaps — do [a, a+la) and [b, b+lb) intersect? Written out rather than inlined because it
# is used three times below and an off-by-one in ONE of them would produce a PASS on a claimed region.
fn gpu_rt_overlaps(a, la, b, lb) {
    if (a >= b + lb) { return 0; }
    if (b >= a + la) { return 0; }
    return 1;
}

# gpu_rt_arena_audit — RUNG 6 of the 3D arc. Prove TD-3's render-target region is genuinely unclaimed
# BEFORE anything stores into it. READ-ONLY: this function writes no memory and no register.
#
# ⛔ WHY THIS RUNG EXISTS AT ALL. With VM_CONTEXT0 disabled there are NO PAGE TABLES, so an
# out-of-bounds store does not fault — it lands somewhere REAL. The two places it must never land are
# the console framebuffer at carveout offset 0 and the PSP TMR at 0x60000000, whose ucode agnos
# re-loads only at boot; corrupting it is not recoverable without a reboot. "Free" therefore has to be
# MEASURED, not asserted from a comment.
#
# ⚠ WHY IT SURFACED ONLY AT RUNG 17, six rungs after it was scheduled. Its own plan row warns that a
# failure "stalls Phase II at rung 11" — yet rungs 11-16 all shipped without it, because coverage
# masks and prep records fit the 2 MB command arena. Rung 17's depth buffer is the FIRST buffer that
# does not: 800x600 needs 960 KB at 16-bit and the arena has 48 KB + 60 KB free. The dependency was
# real the whole time and simply had no consumer until now.
#
# ⭐⭐ THE LAST CHECK IS THE ONLY ONE THAT CAN SEE A STALE MAP, AND THAT IS THE POINT.
# Checks 1-6 compare the proposed region against agnos's OWN declared slot map. If that map is wrong —
# if firmware, the PSP, or the display engine claimed this window without agnos knowing — every one of
# them passes, because they are all downstream of the same premise. That is precisely the failure
# rung 15 shipped to iron: four implementations agreeing with each other about a convention that was
# wrong. Check 7 reads the address the DISPLAY ENGINE IS ACTUALLY SCANNING OUT FROM, out of hardware,
# and refuses if it lands inside the region. It is the one witness here that agnos did not write.
# [[feedback_oracle_must_test_external_invariant]]
#
# Returns 1 = provably unclaimed, 0 = refuse. A refusal is a SUCCESSFUL audit; it is the outcome that
# saves the TMR.
fn gpu_rt_arena_audit() {
    if (gpu_present == 0) { return 0; }
    kprintln("gpu: ---- RENDER-TARGET REGION AUDIT (read-only) ----", 53);

    # Geometry from the HARDWARE, never from a constant. fb_off is the CPU-physical carveout base and
    # fb_base the MC-aperture base; they are DIFFERENT domains on this APU and conflating them would
    # make every bound below compare two unrelated numbers.
    var r_off  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_OFFSET)   & GPU_FB_LOC_MASK;
    var r_base = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE) & GPU_FB_LOC_MASK;
    var fb_off  = r_off  << 24;
    var fb_base = r_base << 24;
    var vram_mb = gpu_reg32(GPU_BASE_NBIO_2, GPU_R_CONFIG_MEMSIZE) & 0xFFFFFFFF;
    var carve_bytes = vram_mb * 1024 * 1024;

    var rt_end  = GPU_RT_REGION_OFF + GPU_RT_REGION_SIZE;
    var rt_phys = fb_off  + GPU_RT_REGION_OFF;
    var rt_mc   = fb_base + GPU_RT_REGION_OFF;
    # ⚠ Cached for the handle table, but DELIBERATELY NOT a licence to use them: gpu_rt_handle_mc
    # refuses unless gpu_rt_audited is 1, which only happens if this function RETURNS 1 below.
    # Setting them here rather than at the end keeps the arithmetic in one place; the gate is the flag.
    gpu_rt_base_mc   = rt_mc;
    gpu_rt_base_phys = rt_phys;

    kprint("gpu: carveout phys base ", 24); kprint_hex(fb_off);
    kprint("  mc base ", 10); kprint_hex(fb_base);
    kprint("  vram ", 7); kprint_num(vram_mb); kprintln(" MB", 3);
    kprint("gpu: rt region offset ", 22); kprint_hex(GPU_RT_REGION_OFF);
    kprint(" size ", 6); kprint_hex(GPU_RT_REGION_SIZE);
    kprint(" ends ", 6); kprint_hex(rt_end); kprintln("", 0);
    kprint("gpu: rt phys ", 13); kprint_hex(rt_phys);
    kprint("  mc ", 5); kprint_hex(rt_mc); kprintln("", 0);

    var ok = 1;

    # 1 -- it must fit inside the carveout at all.
    if (rt_end > carve_bytes) {
        kprintln("gpu: AUDIT FAIL -- the region runs past the end of VRAM", 55);
        ok = 0;
    }
    # 2 -- and it must end EXACTLY at the top. This is not tidiness: ending at the top is the whole
    # reason an overrun is survivable, because it runs off into the fault net instead of down into
    # the framebuffer or the TMR. If VRAM is a size that breaks it, the safety argument is void.
    if (rt_end != carve_bytes) {
        kprintln("gpu: AUDIT FAIL -- the region does NOT end at the carveout top", 62);
        kprintln("gpu:   an overrun would land in real memory, not the fault net", 62);
        ok = 0;
    }
    # 3 -- clear of the console framebuffer and the back-buffer window that starts at offset 0.
    if (gpu_rt_overlaps(GPU_RT_REGION_OFF, GPU_RT_REGION_SIZE, 0, GPU_FB_BACK_LIMIT) == 1) {
        kprintln("gpu: AUDIT FAIL -- overlaps the framebuffer / back-buffer window", 64);
        ok = 0;
    }
    # 4 -- clear of the PSP TMR. The unrecoverable one: agnos re-loads that ucode only at boot.
    if (gpu_rt_overlaps(GPU_RT_REGION_OFF, GPU_RT_REGION_SIZE, GPU_PSP_TMR_OFF, GPU_PSP_TMR_SIZE) == 1) {
        kprintln("gpu: AUDIT FAIL -- overlaps the PSP TMR (needs a reboot to recover)", 67);
        ok = 0;
    }
    # 5 -- clear of the 2 MB command arena (rings, MQD, shaders, scratch).
    if (gpu_rt_overlaps(GPU_RT_REGION_OFF, GPU_RT_REGION_SIZE, GPU_VM_ARENA_OFF, GPU_ARENA_SIZE) == 1) {
        kprintln("gpu: AUDIT FAIL -- overlaps the command arena", 45);
        ok = 0;
    }
    # 6 -- the handle table must tile the region exactly. A short table silently strands memory; a
    # long one hands out a handle whose last byte is outside the audited window, which is the very
    # thing this function exists to prevent.
    if (GPU_RT_HANDLES * GPU_RT_HANDLE_SIZE != GPU_RT_REGION_SIZE) {
        kprintln("gpu: AUDIT FAIL -- handles x handle size does not equal the region", 66);
        ok = 0;
    }

    # 7 -- ⭐ THE EXTERNAL WITNESS. Everything above is agnos checking agnos. This reads the address
    # the display engine is ACTUALLY fetching from, out of DCN, and refuses if it is inside the
    # region. It is the only check here that can catch a slot map that is simply wrong.
    var slo = GPU_R_HUBP_SURF_ADDR    + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    var shi = GPU_R_HUBP_SURF_ADDR_HI + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    var s_lo = gpu_reg32(GPU_BASE_DCN_2, slo) & 0xFFFFFFFF;
    var s_hi = gpu_reg32(GPU_BASE_DCN_2, shi) & 0xFFFF;
    var scan_mc = (s_hi << 32) | s_lo;
    kprint("gpu: live scanout mc ", 21); kprint_hex(scan_mc); kprintln("", 0);
    if (scan_mc >= rt_mc) {
        if (scan_mc < rt_mc + GPU_RT_REGION_SIZE) {
            kprintln("gpu: AUDIT FAIL -- the DISPLAY is scanning out from inside the region", 69);
            ok = 0;
        }
    }
    # ⚠ A zero scanout address means DCN told us nothing, so check 7 proved nothing. Say so rather
    # than letting a silent no-op read as a pass -- that is the vacuous-green shape this tree has
    # already paid for more than once.
    if (scan_mc == 0) {
        kprintln("gpu: AUDIT NOTE -- scanout address reads 0; check 7 proved NOTHING", 66);
    }

    if (ok == 1) { kprintln("gpu: RT AUDIT PASS -- the region is provably unclaimed", 54); }
    if (ok == 0) { kprintln("gpu: RT AUDIT REFUSED -- TD-3 must NOT be built here", 52); }
    kprintln("gpu: ---- END RENDER-TARGET REGION AUDIT ----", 45);
    klug_spill();
    return ok;
}

# ============================================================================================
# ⭐ TD-3's HANDLE TABLE — rung 6's audit is its ARMING PRECONDITION, not a suggestion.
# ============================================================================================
# ⛔ NOTHING MAY STORE INTO THE RENDER-TARGET REGION UNTIL THE AUDIT HAS PASSED **ON THIS BOOT**.
# That is the whole point of rung 6, and making it a runtime gate rather than a comment is what makes
# it hold: with VM_CONTEXT0 disabled there are no page tables, so a store into a region that turned
# out to be claimed lands in the console framebuffer or the PSP TMR — and agnos re-loads PSP ucode
# only at boot, so that one is not recoverable without a reboot.
# ⭐ This also keeps the ABI honest in the sense 1.56.24 established: op 0x0D is ACCEPTED by the
# validator because it is implemented, and its worker REFUSES with GPO_E_ARM where the region is not
# provably free — exactly how gpu_tex_arm refuses where there is no GPU. Accepted == proven, with the
# proof evaluated per boot instead of assumed at build time.
var gpu_rt_audited   = 0;    # 1 = gpu_rt_arena_audit() returned 1 this boot
var gpu_rt_base_mc   = 0;    # MC-side base of the region (valid only when gpu_rt_audited == 1)
var gpu_rt_base_phys = 0;    # CPU-side base ditto

fn gpu_rt_arm() {
    if (gpu_rt_audited == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_rt_arena_audit() != 1) { return 0; }
    gpu_rt_audited = 1;
    return 1;
}

# gpu_rt_handle_mc — resolve an opaque handle to its MC base, or 0 if it is not usable.
# ⚠ Returns 0 for an out-of-range handle AND for an unaudited region, and every caller must treat 0
# as a refusal. Ring 3 never sees this number; it passes the handle INDEX and nothing else, which is
# the property TD-3 chose handles over multi-page #86 slots to keep.
fn gpu_rt_handle_mc(h) {
    if (gpu_rt_audited == 0) { return 0; }
    if (h < 0) { return 0; }
    if (h >= GPU_RT_HANDLES) { return 0; }
    return gpu_rt_base_mc + h * GPU_RT_HANDLE_SIZE;
}

# gpu_depth_clear — op 0x0D's worker. Clears a w x h 32-bit depth buffer in handle `zh` to `value`.
#
# ⭐ IT REUSES gpu_cp_dma_fill_rect, WHICH IS ALREADY IRON-PROVEN (gpu_cp_dma_fill_test). Rung 17's
# first op does not need a new shader, a new ring, or a new packet class — a depth clear is a fill,
# and the fill path exists and works. "Redesign, don't reinvent" applies to our own tree first.
# ⚠ 32-bit Z, not 16: cp_dma fills DWORDS, so a 16-bit format would need the value pre-duplicated and
# would buy nothing here — a 32 MB handle holds 800x600x4 (1.92 MB) with room to spare, and rung 17's
# tile loop keeps depth in VGPRs anyway. The width is a per-op record field, so this is not a wall.
# Returns 1 / 0.
fn gpu_depth_clear(zh, w, h, value) {
    if (gpu_rt_arm() != 1) { return 0; }
    var mc = gpu_rt_handle_mc(zh);
    if (mc == 0) { return 0; }
    var bytes = w * 4 * h;
    # ⛔ BOUND THE WRITE AGAINST THE HANDLE, NOT AGAINST THE REGION. A w*h that fits the 256 MB region
    # but overruns this 32 MB handle would silently scribble on the NEXT handle -- a corruption whose
    # symptom appears in an unrelated buffer. The validator checks this too; this is the second gate,
    # because the worker is what actually issues the DMA.
    if (bytes > GPU_RT_HANDLE_SIZE) { return 0; }
    # ⛔⛔ ONE LINEAR FILL, NOT gpu_cp_dma_fill_rect. THE FIRST VERSION USED THE RECT PATH AND THE
    # 1.56.30 BURN MEASURED THE COST: that helper issues ONE CP-DMA PACKET PER ROW, each with its own
    # fence wait, so an 800x600 clear submitted 600 packets and took **89 ms** -- about 21 MB/s,
    # against the 3748 MB/s gputex measures for far harder work. A two-point fit over the burn's two
    # rects isolates it exactly: 91.5 us PER ROW, which is dispatch-shaped, not bandwidth-shaped.
    # ⭐ A depth buffer is CONTIGUOUS -- stride == row_bytes by construction here -- so the rect helper
    # was decomposing a single linear range into `rows` adjacent pieces for no reason. One packet
    # covers it. ⚠ And the whole 32 MB handle fits: CP-DMA's BYTE_COUNT field is 26 bits (~64 MiB).
    # ⛔ THAT LIMIT IS MASKED, NOT CHECKED, at gpu_cpdma_submit (`bytes & GPU_CPDMA_MAX`), so a count
    # past 64 MiB would silently TRUNCATE and report success. The handle bound above is what keeps
    # this path away from that edge; if GPU_RT_HANDLE_SIZE ever exceeds 64 MiB, this call must split.
    return gpu_cp_dma_fill(mc, value, bytes);
}

fn gpu_wait_done(done_phys, expect, timeout_us) {
    var t0 = rdtsc();
    var limit = timeout_us * gpu_tsc_per_us();
    var el = 0;
    while (el < limit) {
        if ((load32(done_phys) & 0xFFFFFFFF) == expect) {
            gpu_last_wait_us = el / gpu_tsc_per_us();
            return 1;
        }
        el = rdtsc() - t0;
    }
    gpu_last_wait_us = el / gpu_tsc_per_us();
    if ((load32(done_phys) & 0xFFFFFFFF) == expect) { return 1; }
    # ⛔ RUNG 4: A TIMEOUT NOW CAPTURES INSTEAD OF GUESSING.
    # Every caller of this function has, until now, learned exactly one bit — "it did not
    # finish" — and every GPU hang in agnos's history was diagnosed by re-running with more
    # kprints. The forensic block is unconditional here on purpose: a timeout is rare, the
    # capture is cheap, and the one time it matters the console may already be gone.
    # ⚠ Under GPU_FORENSIC the block also spills to /klug.txt. Without the flag it still prints,
    # so a production kernel that wedges is not silent either.
    gpu_forensic_dump(done_phys, expect);
    return 0;
}

fn gpu_udelay(us) {
    var t0 = rdtsc();
    var target = us * gpu_tsc_per_us();
    while ((rdtsc() - t0) < target) { }
    return 0;
}

# mfence (0F AE F0) — drain the store buffer before the doorbell so the PSP sees the
# RB-frame/cmd writes before it observes the wptr bump. HDP flush is a NO-OP on this
# APU (amdgpu skips it for AMD_IS_APU), so the fence + UC buffers ARE the coherence.
fn gpu_mfence() {
    asm { 0x0F; 0xAE; 0xF0; }
    return 0;
}

# Submit the command in cmd_phys over the GPCOM ring, ring the doorbell (C2PMSG_67
# wptr), wait for the PSP to write the fence word, and return resp.status (cmd+0x360;
# 0 = OK). Buffers are UC (strongly ordered) + an mfence drains stores before the
# doorbell. RB-frame layout + wptr math (DWORDs, +16 per 64-byte frame) + fence-poll
# per psp_v12_0.c `psp_ring_cmd_submit` / `psp_cmd_submit_buf`. Reused by C1b-2.
fn gpu_psp_submit(ring_phys, cmd_phys, fence_phys) {
    gpu_psp_fctr = gpu_psp_fctr + 1;
    var idx = gpu_psp_fctr;
    store32(fence_phys, 0);                              # pre-zero the fence word
    var wptr  = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_67);   # wptr in DWORDs
    var frame = ring_phys + wptr * 4;                   # 64-byte frame at wptr_dw * 4
    var i = 0;
    while (i < 8) { store64(frame + i * 8, 0); i = i + 1; }       # zero the 64-byte frame
    store32(frame + 0,  cmd_phys & 0xFFFFFFFF);         # cmd_buf_addr_lo
    store32(frame + 4,  (cmd_phys >> 32) & 0xFFFFFFFF); # cmd_buf_addr_hi
    store32(frame + 8,  0x1000);                        # cmd_buf_size
    store32(frame + 12, fence_phys & 0xFFFFFFFF);       # fence_addr_lo
    store32(frame + 16, (fence_phys >> 32) & 0xFFFFFFFF);# fence_addr_hi
    store32(frame + 20, idx);                           # fence_value
    gpu_mfence();
    var nw = (wptr + 16) & GPU_PSP_RING_DW_MASK;        # +1 frame (16 dw), wrap
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_67, nw);     # doorbell
    var t = 0;
    while (t < 20000) {                                 # ~2 s budget (20000 x 100 us)
        if (load32(fence_phys) == idx) { break; }
        gpu_udelay(100);
        t = t + 1;
    }
    return load32(cmd_phys + GPU_PSP_RESP_STATUS);
}

# Locate the iGPU: exact Cezanne id first, then the other known gfx9-APU ids,
# then an AMD display-class fallback (guards against matching QEMU's non-AMD
# VGA). Returns the pci_devs index, or -1.
fn gpu_find() {
    var idx = pci_find(GPU_VENDOR_AMD, GPU_DEV_CEZANNE);
    if (idx >= 0) { return idx; }
    idx = pci_find(GPU_VENDOR_AMD, GPU_DEV_RENOIR);
    if (idx >= 0) { return idx; }
    idx = pci_find(GPU_VENDOR_AMD, GPU_DEV_BARCELO);
    if (idx >= 0) { return idx; }
    idx = pci_find(GPU_VENDOR_AMD, GPU_DEV_LUCIENNE);
    if (idx >= 0) { return idx; }
    idx = pci_find_by_class(GPU_CLASS_DISPLAY, GPU_SUBCLASS_VGA, GPU_PROGIF_VGA);
    if (idx >= 0) {
        if (pci_vendor(idx) == GPU_VENDOR_AMD) { return idx; }
    }
    return 0 - 1;
}

# F0 — probe + ID dump. Returns 1 if the GPU was bound + aperture read, else 0.
# gpu_sentinels_init — assign the -1 sentinels EXPLICITLY, because their declarations never execute.
#
# ⚠ A MODULE-GLOBAL INITIALISER THAT IS AN EXPRESSION DOES NOT RUN DURING BOOT IN THIS KERNEL. cyrius emits
# kmode gvar inits in EMIT_GVAR_INITS, which runs AFTER PARSE_PROG — and PARSE_PROG is the whole boot,
# main.cyr through boot_finish.cyr, which ends in arch_halt(). So `var gpu_scanout_pid = 0 - 1;` leaves the
# variable at its BSS zero for the entire life of the boot. A plain literal (`var x = 3000;`) is folded into
# the data section and is fine; `0 - 1` is not folded, and that is the whole difference.
#
# MEASURED, not inferred (QEMU, 2026-07-23): at gpu_probe entry `gpu_scanout_pid` reads 0 while a literal
# `0 - 8` prints -8 on the same line, so this is the initialiser and not the printer.
#
# WHY IT MATTERS RATHER THAN BEING COSMETIC: `gpu_release_pid(pid)` matches on `gpu_scanout_pid != pid`, and
# the exec path really does hand out pid 0 — so the FIRST `run /bin/<tool>` of a boot matched a scanout
# owner it never claimed, and re-pointed the scanout on its way out. Harmless in practice today only
# because it re-writes the address already programmed. It also made every `gpu_scanout_pid < 0`
# "the console owns the screen" test read FALSE for the whole boot.
#
# Twelve more of these live across fatfs / exfat / ext2 / ahci / hda / gpu — several of them cache-tag
# sentinels where 0 is a VALID value, so the tag can false-hit on the first access of a boot. Filed as
# docs/development/issues/2026-07-23-kernel-expression-gvar-initialisers-never-run.md; only the ones the
# display path depends on are corrected here, because changing a sentinel changes behaviour and each one
# needs its own reasoning.
fn gpu_sentinels_init() {
    gpu_pci_idx      = 0 - 1;
    gpu_display_pipe = 0 - 1;
    gpu_scanout_pid  = 0 - 1;
    gpu_audio_dp     = 0 - 1;
    gpu_audio_dig    = 0 - 1;
    return 0;
}

fn gpu_probe() {
    gpu_sentinels_init();
    var idx = gpu_find();
    if (idx < 0) {
        kprintln("gpu: no AMD GPU found", 21);
        return 0;
    }

    # BAR5 = the 512 KB MMIO register aperture.
    var bar = pci_bar_64(idx, GPU_BAR_MMIO);
    if (bar == 0) {
        kprintln("gpu: no MMIO aperture (BAR5)", 28);
        return 0;
    }

    # Read-only probe: enable PCI Memory-Space (so BAR reads resolve) but NOT
    # bus-master — F0 arms no DMA. A GOP-lit iGPU already has Memory-Space set;
    # this makes the probe self-sufficient on a cold function.
    pci_enable_mem_space_idx(idx);

    # Register file is uncacheable (the hda/ahci/nvme BAR-map idiom).
    vmm_remap_uc_2mb(bar);

    gpu_present = 1;
    gpu_pci_idx = idx;
    gpu_mmio    = bar;

    kprint("gpu: found ", 11);
    kprint_hex(pci_vendor(idx));
    kprint(":", 1);
    kprint_hex(pci_device(idx));
    kprint(" [AMD gfx90c/DCN2.1] BAR5=0x", 28);
    kprint_hex(bar & 0xFFFFFFFF);
    kprintln(" UC", 3);

    # NBIO/RCC — always-on bus interface. CONFIG_MEMSIZE is a real UMA-size read
    # (the aperture-correctness anchor). STRAP0's device-id mirror reads 0x0 on
    # Cezanne (an EPF0-strap MMIO-alias quirk — amdgpu reads it the same direct
    # way; iron 2026-07-11), so device identity comes authoritatively from PCI
    # config, not this register; strap0 is printed raw as a diagnostic only.
    var memsize = gpu_reg32(GPU_BASE_NBIO_2, GPU_R_CONFIG_MEMSIZE);

    kprint("gpu: ", 5);
    kprint_num(memsize);
    kprintln("MB VRAM", 7);

    # GC — powered pre-driver; proves the graphics-core bus responds, not just
    # NBIO. (A power-gated GC reads 0 without meaning a mapping failure — STRAP0
    # above is the aperture-correctness anchor; these are informational.)
    var gbcfg = gpu_reg32(GPU_BASE_GC_0, GPU_R_GB_ADDR_CONFIG);
    var grbm  = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);


    # F0 pass gate: the aperture reads REAL values (a sane VRAM size + a structured
    # GB_ADDR_CONFIG, both non-0 / non-0xFFFFFFFF). This replaced the STRAP0 anchor
    # (which reads 0x0 on Cezanne — see above), iron-corrected 2026-07-11.
    var live = 0;
    if (memsize != 0 && memsize != 0xFFFFFFFF && gbcfg != 0 && gbcfg != 0xFFFFFFFF) { live = 1; }
    if (live != 0) {
        kprintln("gpu: register aperture mapped", 29);
        # P4 FIX (1.55.28, DEFAULT-ON): match the console to the real (scaled) surface AS EARLY AS POSSIBLE — the
        # aperture is up, so the HW viewport is readable now, long before the display probe. This renders the
        # rest of the boot log at the correct geometry instead of banding it. Idempotent + guarded → safe; the
        # late fallback in main.cyr catches it if the viewport isn't valid yet.
        gpu_scanout_matchgeom();
        return 1;
    }
    kprintln("gpu: warning: aperture reads dead", 33);
    return 1;
}

# === C0 — firmware-reality check (the arc's honest hard gate) ================
# Read-only dump of the CP/MEC/RLC firmware-state registers + the PSP sign-of-
# life, to decide whether the CP/MEC/RLC microcode is resident + running from
# BIOS/PSP (Case A → the compute rings can proceed) or NOT loaded (Case B → agnos
# must drive the PSP firmware-load handshake first — a substantial sub-arc that
# reshapes the compute ladder). On a GOP-lit APU the expected answer is Case B:
# the BIOS lit the DISPLAY via GOP but did not bring up the GFX/compute engine.
#
# All registers are DIRECT in BAR5. ⚠ BASE_IDX: CP_STAT/CP_ME_CNTL/CP_MEC_CNTL/
# MEC_HEADER are GC seg[0] (0x2000); RLC_* are GC seg[1] (0xA000); the PSP mailbox
# is MP0 seg[0] (0x16000). Gating caveat: a GFXOFF-gated GC reads 0 (looks
# "unloaded") — F0 proved GC ungated this boot (gb_addr_config real), and RLC
# stays powered even when the CP is gated, so read RLC before trusting CP zeros.
# Derived from Linux gfx_v9_0.c (halt-bit polarity) + psp_v12_0.c (mailbox). NO
# device-state writes — pure reads (the PSP load itself is a later bite).

# Is CP_MEC_ME1_HEADER a REAL ucode header, or the dump-FIFO sentinel? The register
# reads a 0xdefN_defN sentinel FAMILY when there is nothing real to dump — both 16-bit
# halves equal, top-3-nibbles 0xdef, low nibble a per-read counter (iron-observed on
# archaemenid at C1d: def0 → def1 → def2 across successive reads; the PSP DMA load path
# does not repopulate this reg, as the C1d derivation predicted). Returns 1 only for a
# value NOT of that family (a genuine header), else 0. Used as a BONUS positive — never
# a hard gate (the reliable running-proof is halts-clear + RLC-on + GRBM idle).
fn gpu_mec_hdr_is_real(hdr) {
    var h = hdr & 0xFFFFFFFF;
    if (h == 0) { return 0; }
    var hi = (h >> 16) & 0xFFFF;
    var lo = h & 0xFFFF;
    var base = GPU_MEC_HDR_NONE & 0xFFFF;         # 0xdef0
    if (hi == lo && (lo & 0xFFF0) == base) { return 0; }   # 0xdefX_defX sentinel family
    return 1;
}

fn gpu_fw_probe() {
    if (gpu_present == 0) { return 0; }

    # PSP sign-of-life (MP0) + RLC state / GFXOFF discriminator (GC seg[1]).
    var psp_sol  = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_81);
    var rlc_cntl = gpu_reg32(GPU_BASE_GC_1, GPU_R_RLC_CNTL);
    var rlc_gpm  = gpu_reg32(GPU_BASE_GC_1, GPU_R_RLC_GPM_STAT);
    # CP graphics + MEC compute engine state (GC seg[0]).
    var cp_me_cntl = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_ME_CNTL);
    var mec_cntl   = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL);
    var mec_hdr    = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_ME1_HEADER);
    var cp_stat    = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_STAT);



    # Verdict — halt bits SET = engine halted; RLC_CNTL bit0 = RLC running w/ ucode;
    # MEC header nonzero = MEC1 fetched its ucode. Case A needs all four positive.
    var rlc_on     = rlc_cntl & GPU_RLC_ENABLE_F32;
    var gfx_halted = cp_me_cntl & GPU_CP_GFX_HALT_MASK;
    var mec_halted = mec_cntl & GPU_CP_MEC_ME1_HALT;
    # Reliable Case-A = RLC running + gfx/MEC un-halted. The MEC1 header (a real value
    # vs the 0xdef0def0 sentinel) is a BONUS ucode-fetch confirmation — the PSP DMA path
    # may not repopulate the header-dump reg, so it does NOT gate the verdict (C1d fix:
    # the old `mec_hdr != 0` clause both let the 0xdef0def0 sentinel through AND risked a
    # false CASE B when a genuinely-running MEC left the header at the sentinel).
    if (rlc_on != 0 && gfx_halted == 0 && mec_halted == 0) {
        if (gpu_mec_hdr_is_real(mec_hdr) != 0) {
            kprintln("gpu: firmware already resident (engines running)", 48);
        }
        if (gpu_mec_hdr_is_real(mec_hdr) == 0) {
            kprintln("gpu: firmware already resident (engines running)", 48);
        }
        return 1;
    }
    kprintln("gpu: firmware not resident, loading via PSP", 43);
    return 1;
}

# === C1a — PSP GPCOM ring-create + memory-domain probe ======================
# The first bite of the C1 firmware-load sub-arc (C0 = CASE B: the microcode is
# NOT resident, so agnos must drive the PSP to load it). C1a stands up the OS<->PSP
# GPCOM command ring the firmware-load (C1b) submits LOAD_IP_FW frames over. This
# bite is REGISTER-BASED only (DESTROY_RINGS + program the ring phys + INIT_GPCOM_
# RING via C2PMSG_64) — it does NOT yet DMA the ring, so a WB kernel buffer is fine;
# the ring/cmd/fence DMA + coherence is C1b's problem. It is the FIRST write to the
# PSP (F0/C0 were read-only) — but this is exactly amdgpu's own per-boot init and
# only sets up an inert command ring (display stays GOP-lit, no compute touched).
#
# Pass signal (iron): C2PMSG_64 reads back bit31 (RESPONSE) with low-16 status == 0
# after INIT_GPCOM_RING ⟹ the PSP accepted the ring — the OS<->PSP channel is up.
# A timeout ⟹ wrong C2PMSG offset OR the PSP won't accept this ring address (the
# memory-domain question C1a0 flags). Iron-only; no-op off an AMD GPU.
# Derived from Linux psp_v12_0.c (ring_create) + psp_gfx_if.h. NO firmware yet.
fn gpu_psp_ring_create() {
    if (gpu_present == 0) { return 0; }
    # PSP must be alive (C0 read psp=0x698e82); a 0 SOL means no sOS to talk to.
    var sol = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_81);
    if (sol == 0) {
        kprintln("gpu: PSP not responding, skipping firmware load", 47);
        return 0;
    }

    # Page-align the ring base within the slack buffer; zero the 32 KB ring.
    var ring_phys = (&gpu_psp_ring + 0xFFF) & 0xFFFFFFFFFFFFF000;
    var i = 0;
    while (i < 4096) { store64(ring_phys + i * 8, 0); i = i + 1; }   # 32 KB = 4096 x u64

    # DESTROY any stale KM ring first (amdgpu always does; benign / tolerated on a
    # virgin OS ring), settle, then program the ring phys lo/hi/size + INIT the ring.
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64, GPU_PSP_DESTROY_RINGS);
    gpu_udelay(20000);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_69, ring_phys & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_70, (ring_phys >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_71, GPU_PSP_RING_SIZE);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64, GPU_PSP_INIT_GPCOM_RING);

    # Poll C2PMSG_64 for the RESPONSE bit (~1 s budget: 50 x 20 ms).
    var resp = 0;
    i = 0;
    while (i < 50) {
        resp = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64);
        if ((resp & GPU_PSP_FLAG_RESPONSE) != 0) { break; }
        gpu_udelay(20000);
        i = i + 1;
    }
    var status = resp & GPU_PSP_STATUS_MASK;


    if ((resp & GPU_PSP_FLAG_RESPONSE) != 0 && status == 0) {
        kprintln("gpu: PSP command ring initialized", 33);
        return 1;
    }
    if ((resp & GPU_PSP_FLAG_RESPONSE) != 0) {
        kprintln("gpu: PSP command ring init failed", 33);
        return 1;
    }
    kprintln("gpu: PSP command ring init timed out", 36);
    return 1;
}

# === C1b-1 — SETUP_TMR round-trip (ring/coherence/addressing probe) ==========
# C1a proved the register-based ring-create; C1b does the first REAL ring command:
# a full RB-frame submit + DMA + fence round-trip. SETUP_TMR needs no firmware, so
# it isolates the ring/coherence/addressing mechanism from the firmware parse — and
# is a hard prerequisite for LOAD_IP_FW (the PSP DMA-writes decrypted ucode into the
# TMR). It also DOUBLES as the physical-addressing probe: SETUP_TMR is the one command
# that passes an explicit system-physical address, so status==0 proves the PSP
# DMA-read our cmd buffer, DMA-wrote our fence, AND accepted a raw-phys TMR — the C1a0
# memory-domain question. Buffers are UC (the DMA ring needs it — C1a's static ring
# was WB, fine for register-INIT but not DMA), so C1b re-creates the ring in a fresh
# 2 MB UC region. TMR = 4 MB via pmm_alloc_2mb_run(2). Derived from psp_v12_0.c
# (psp_tmr_load / psp_prep_tmr_cmd_buf) + psp_gfx_if.h. NO firmware yet (that's C1b-2).
fn gpu_psp_setup() {
    if (gpu_present == 0) { return 0; }
    var sol = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_81);
    if (sol == 0) {
        kprintln("gpu: PSP not responding, skipping secure region", 47);
        return 0;
    }

    # 2 MB UC region for ring(32 KB)+cmd(4 KB)+fence, and a 4 MB UC TMR.
    var region = pmm_alloc_2mb();
    if (region == 0) {
        kprintln("gpu: secure region allocation failed", 36);
        return 0;
    }
    vmm_remap_uc_2mb(region);
    iommu_register_dma(region);
    # The 4 MB TMR must live in the GPU's VRAM/UMA carveout, NOT plain system RAM
    # (1.54.3 sent phys 0x0f800000 → TEE_ERROR_BAD_PARAMETERS). Read the carveout
    # physical base (FB_OFFSET) + MC-aperture base/top (FB_LOCATION_BASE/TOP) from the
    # GFXHUB regs and place the TMR at the MIDDLE of the carveout (far from the low
    # scanout FB + any top-of-carveout firmware). buf_phy_addr = MC addr (FB_BASE+k);
    # system_phy_addr = true phys (FB_OFF+k). The CPU never touches the TMR (PSP-only
    # scratch), so no alloc/map — just compute + pass its address.
    var r_off  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_OFFSET)   & GPU_FB_LOC_MASK;
    var r_base = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE) & GPU_FB_LOC_MASK;
    var r_top  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_TOP)  & GPU_FB_LOC_MASK;
    var fb_off  = r_off << 24;
    var fb_base = r_base << 24;
    var fb_top  = r_top << 24;
    var carveout = fb_top - fb_base + 0x1000000;             # inclusive top, 16 MB granule
    var k = (carveout >> 1) & 0xFFFFFFFFFFC00000;            # middle, 4 MB-aligned
    var tmr_mc   = fb_base + k;
    var tmr_phys = fb_off + k;

    var ring  = region;
    var cmd   = region + 0x8000;   # 4 KB-aligned (region is 2 MB-aligned)
    var fence = region + 0x9000;
    gpu_psp_ring2 = ring;
    gpu_psp_cmd   = cmd;
    gpu_psp_fence = fence;
    var i = 0;
    while (i < 4096) { store64(ring + i * 8, 0); i = i + 1; }   # zero the 32 KB ring

    # Re-create the GPCOM ring in the UC region (DESTROY → program → INIT → poll) —
    # the C1a-validated sequence, now pointing the PSP at the UC ring for DMA.
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64, GPU_PSP_DESTROY_RINGS);
    gpu_udelay(20000);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_69, ring & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_70, (ring >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_71, GPU_PSP_RING_SIZE);
    gpu_reg32_write(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64, GPU_PSP_INIT_GPCOM_RING);
    gpu_udelay(20000);
    var rr = 0;
    i = 0;
    while (i < 50) {
        rr = gpu_reg32(GPU_BASE_MP0_0, GPU_R_MP0_C2PMSG_64);
        if ((rr & GPU_PSP_FLAG_RESPONSE) != 0) { break; }
        gpu_udelay(20000);
        i = i + 1;
    }
    if ((rr & GPU_PSP_FLAG_RESPONSE) == 0 || (rr & GPU_PSP_STATUS_MASK) != 0) {
        return 0;
    }

    # SETUP_TMR: cmd_id=0x5 @ +8; buf_phy_addr @ +28/+32 = TMR; buf_size @ +36 = 4 MB;
    # tmr_flags @ +40 = 0x2 (virt_phy_addr); system_phy_addr @ +44/+48 = TMR (raw phys).
    i = 0;
    while (i < 512) { store64(cmd + i * 8, 0); i = i + 1; }     # zero the 4 KB cmd buffer
    store32(cmd + 8,  GPU_PSP_CMD_SETUP_TMR);
    store32(cmd + 28, tmr_mc & 0xFFFFFFFF);              # buf_phy_addr_lo = MC/aperture addr
    store32(cmd + 32, (tmr_mc >> 32) & 0xFFFFFFFF);      # buf_phy_addr_hi
    store32(cmd + 36, GPU_PSP_TMR_SIZE);
    store32(cmd + 40, GPU_PSP_TMR_FLAGS);
    store32(cmd + 44, tmr_phys & 0xFFFFFFFF);            # system_phy_addr_lo = true physical
    store32(cmd + 48, (tmr_phys >> 32) & 0xFFFFFFFF);    # system_phy_addr_hi
    var status = gpu_psp_submit(ring, cmd, fence);


    if (load32(fence) == gpu_psp_fctr && status == 0) {
        kprintln("gpu: PSP secure memory region ready", 35);
        return 1;
    }
    kprintln("gpu: PSP secure region setup failed", 35);
    return 1;
}

# === C1b-2 — LOAD_IP_FW (RLC_G): the first real firmware into the GPU ========
# The finale of the C1 firmware-load sub-arc. C1b-1 established the ring + TMR
# (iron-proven, status 0); C1b-2 submits a REAL AMD-signed microcode blob over
# the same, now-proven ring: the PSP validates AMD's RSA signature, decrypts, and
# DMAs the plaintext ucode into the TMR. Reads `renoir_rlc.bin` (staged into the
# agnos-fs at /fw/rlc.bin, the AMD compute subset the firmware-provenance ledger
# tracks): parses the amdgpu common_firmware_header (ucode_size_bytes @ +0x14,
# ucode_array_offset_bytes @ +0x18), reads the payload slice into the low-phys UC
# buffer past ring/cmd/fence (low phys is PSP-DMA-reachable, proven at 1.54.4), and
# submits GFX_CMD_ID_LOAD_IP_FW (fw_type RLC_G=8). Runs AFTER the FS mount (needs
# vfs_read_file_at), reusing gpu_psp_ring2/cmd/fence set up early by gpu_psp_setup.
# Derived from amdgpu_ucode.c (payload range) + psp_gfx_if.h. status 0 = the PSP
# validated the signature + loaded RLC_G — the first sovereign firmware on the GPU.
fn gpu_fw_load() {
    if (gpu_present == 0) { return 0; }
    if (gpu_psp_ring2 == 0) { return 0; }   # gpu_psp_setup must have run (ring + TMR up)

    var ring    = gpu_psp_ring2;
    var cmd     = gpu_psp_cmd;
    var fence   = gpu_psp_fence;
    var payload = ring + 0xA000;   # UC, 4 KB-aligned, in the setup region past ring/cmd/fence

    # Read the RLC blob's common_firmware_header (first 32 B) to locate its payload.
    var hdr[32];                   # function-local var X[N] = N BYTES → 32 B
    var rc = vfs_read_file_at("/fw/rlc.bin", 11, 0, &hdr, 32);
    if (rc <= 0) {
        kprintln("gpu: RLC firmware not found (/fw/rlc.bin)", 41);
        return 0;
    }
    var uc_size = load32(&hdr + 0x14) & 0xFFFFFFFF;   # ucode_size_bytes
    var uc_off  = load32(&hdr + 0x18) & 0xFFFFFFFF;   # ucode_array_offset_bytes
    if (uc_size == 0 || uc_size > 0x100000) {
        return 0;
    }

    # Read the payload [uc_off, uc_off+uc_size) straight into the UC payload buffer.
    rc = vfs_read_file_at("/fw/rlc.bin", 11, uc_off, payload, uc_size);
    if (rc <= 0) {
        kprintln("gpu: RLC firmware read failed", 29);
        return 0;
    }

    # LOAD_IP_FW: cmd_id=0x6 @ +8; fw_phy_addr @ +28/+32 = payload; fw_size @ +36;
    # fw_type=RLC_G(8) @ +40. Reuse the proven submit + the established TMR.
    var i = 0;
    while (i < 512) { store64(cmd + i * 8, 0); i = i + 1; }   # zero the 4 KB cmd buffer
    store32(cmd + 8,  GPU_PSP_CMD_LOAD_IP_FW);
    store32(cmd + 28, payload & 0xFFFFFFFF);
    store32(cmd + 32, (payload >> 32) & 0xFFFFFFFF);
    store32(cmd + 36, uc_size);
    store32(cmd + 40, GPU_FW_TYPE_RLC_G);
    var status = gpu_psp_submit(ring, cmd, fence);


    if (load32(fence) == gpu_psp_fctr && status == 0) {
        kprintln("gpu: RLC firmware loaded (PSP-validated)", 40);
        return 1;
    }
    kprintln("gpu: RLC firmware load failed", 29);
    return 1;
}

# ── C1c — the rest of the CP/MEC firmware set ─────────────────────────────────
# General single-firmware LOAD_IP_FW over the iron-proven ring/TMR/submit (C1b).
# kind: 0 = whole body [uc_off, +uc_size); 1 = body-minus-JT (MEC body, strip the
# trailing jump-table); 2 = JT slice [uc_off + jt_off*4, +jt_size*4). Reads the
# gfx_firmware_header_v1_0 (ucode_size@0x14, ucode_array_off@0x18, jt_offset@0x24,
# jt_size@0x28 — the last two in DWORDs). Returns 1 on PSP-accept (status 0), else 0.
fn gpu_fw_load_one(path, path_len, fw_type, kind) {
    if (gpu_psp_ring2 == 0) { return 0; }
    var ring    = gpu_psp_ring2;
    var cmd     = gpu_psp_cmd;
    var fence   = gpu_psp_fence;
    var payload = ring + 0xA000;   # same UC buffer C1b-2 proved DMA-reachable

    var hdr[48];                   # function-local var X[N] = N BYTES; header spans to 0x2C
    var rc = vfs_read_file_at(path, path_len, 0, &hdr, 48);
    if (rc <= 0) {
        return 0;
    }
    var uc_size = load32(&hdr + 0x14) & 0xFFFFFFFF;   # ucode_size_bytes
    var uc_off  = load32(&hdr + 0x18) & 0xFFFFFFFF;   # ucode_array_offset_bytes
    var jt_off  = load32(&hdr + 0x24) & 0xFFFFFFFF;   # jt_offset (DWORDs)
    var jt_sz   = load32(&hdr + 0x28) & 0xFFFFFFFF;   # jt_size   (DWORDs)

    var poff  = uc_off;
    var psize = uc_size;
    if (kind == 1) {                                  # MEC body: strip trailing JT
        psize = uc_size - jt_sz * 4;
    }
    if (kind == 2) {                                  # MEC JT slice
        poff  = uc_off + jt_off * 4;
        psize = jt_sz * 4;
    }
    if (psize == 0 || psize > 0x100000) {
        return 0;
    }

    # DMA-read the payload slice straight into the UC buffer.
    rc = vfs_read_file_at(path, path_len, poff, payload, psize);
    if (rc <= 0) {
        return 0;
    }

    # LOAD_IP_FW: cmd_id @ +8; fw_phy_addr @ +28/+32; fw_size @ +36; fw_type @ +40.
    var i = 0;
    while (i < 512) { store64(cmd + i * 8, 0); i = i + 1; }
    store32(cmd + 8,  GPU_PSP_CMD_LOAD_IP_FW);
    store32(cmd + 28, payload & 0xFFFFFFFF);
    store32(cmd + 32, (payload >> 32) & 0xFFFFFFFF);
    store32(cmd + 36, psize);
    store32(cmd + 40, fw_type);
    var status = gpu_psp_submit(ring, cmd, fence);

    if (load32(fence) == gpu_psp_fctr && status == 0) {
        return 1;
    }
    return 0;
}

# C1c driver — load the rest of the CP/MEC set. RLC_G already loaded (C1b-2). Renoir/
# gfx9.3.0 loads NO MEC2 (gfx_v9_0_load_mec2_fw_bin_support()=false — the single MEC
# ucode serves both pipes); RLC restore-lists (GFXOFF) deferred. CE/PFP/ME load WHOLE;
# MEC = body (CP_MEC) + jump-table (CP_MEC_ME1). Order is functionally free except the
# MEC body must precede its JT. Derived + adversarially verified vs amdgpu amdgpu_ucode.c
# / psp_gfx_if.h (2026-07-12); the MEC body-minus-JT signature-validation is the one
# genuinely-new thing this bite proves on iron (C1b-2 only proved a whole-body blob).
fn gpu_fw_load_set() {
    if (gpu_present == 0) { return 0; }
    if (gpu_psp_ring2 == 0) { return 0; }
    kprintln("gpu: loading CP/MEC firmware...", 31);
    var ok = 0;
    ok = ok + gpu_fw_load_one("/fw/ce.bin",  10, GPU_FW_TYPE_CP_CE,      0);
    ok = ok + gpu_fw_load_one("/fw/pfp.bin", 11, GPU_FW_TYPE_CP_PFP,     0);
    ok = ok + gpu_fw_load_one("/fw/me.bin",  10, GPU_FW_TYPE_CP_ME,      0);
    ok = ok + gpu_fw_load_one("/fw/mec.bin", 11, GPU_FW_TYPE_CP_MEC,     1);
    ok = ok + gpu_fw_load_one("/fw/mec.bin", 11, GPU_FW_TYPE_CP_MEC_ME1, 2);
    if (ok == 5) {
        kprintln("gpu: CP/MEC firmware loaded (5/5, PSP-validated)", 48);
        return 1;
    }
    return 0;
}

# ── C1d — start the engines (Case-B → Case-A flip) ────────────────────────────
# The firmware is resident (C1c) but the engines are halted. C1d releases them:
# RLC F32 (RLC_CNTL bit0) → CP-gfx un-halt (CP_ME_CNTL clear ME|PFP|CE) → CP-MEC1
# un-halt (CP_MEC_CNTL=0). Order is load-bearing: RLC must run before the CP
# un-halts (CP depends on RLC for clock/CSB state). Each write is followed by a
# readback-guard — if a CNTL reads back unchanged the GC is clock/GFXOFF-gated and
# we ABORT rather than un-halt into a gated pipe. Bare un-halt with NO rings/GPUVM/
# HQD is safe (rptr==wptr==0 ⟹ no fetch ⟹ no VM walk ⟹ no CPU wedge — proven vs
# gfx_v9_0 by the C1d derivation + 2-lens adversarial verify). No SOFT_RESET (it
# would wipe PSP-loaded ucode); no init_csb / GFX-PG (deferred — GFXOFF stays off).
# The reliable running-proof is halts-clear + RLC-on + GRBM idle; the MEC1 header
# 0xdef0def0→real transition is a BONUS (the PSP DMA path may not repopulate the
# header-dump reg, so it does NOT gate the verdict).
fn gpu_engine_start() {
    if (gpu_present == 0) { return 0; }
    if (gpu_psp_ring2 == 0) { return 0; }   # firmware-load path ran (ring/TMR up)
    kprintln("gpu: starting compute engines...", 32);

    # 1) RLC: set RLC_ENABLE_F32 (bit0) via RMW. MUST precede the CP un-halts.
    var rlc0 = gpu_reg32(GPU_BASE_GC_1, GPU_R_RLC_CNTL);
    gpu_reg32_write(GPU_BASE_GC_1, GPU_R_RLC_CNTL, rlc0 | GPU_RLC_ENABLE_F32);
    gpu_udelay(50);
    var rlc1 = gpu_reg32(GPU_BASE_GC_1, GPU_R_RLC_CNTL);
    if ((rlc1 & GPU_RLC_ENABLE_F32) == 0) {
        kprintln("gpu: engine start failed: RLC power-gated", 41);
        return 0;
    }

    # 2) CP-gfx un-halt: clear ME|PFP|CE halts (0x15000000) via RMW. Gated on RLC up.
    var me0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_ME_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_ME_CNTL, me0 & 0xEAFFFFFF);
    gpu_udelay(50);
    var me1 = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_ME_CNTL);

    # 3) CP-compute (MEC1 crown) un-halt: write 0 (amdgpu parity; MEC2 fused-absent
    #    on gfx9.3.0 so clearing MEC_ME2_HALT is a no-op).
    var mec0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL, 0);
    gpu_udelay(50);
    var mec1 = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_CNTL);

    # 4) MEC1 header — poll ~1 ms for the ucode-fetch transition. BONUS positive only.
    var hdr = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_ME1_HEADER);
    var t = 0;
    while (t < 20) {
        if (gpu_mec_hdr_is_real(hdr) != 0) { t = 20; }
        else { gpu_udelay(50); hdr = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_MEC_ME1_HEADER); t = t + 1; }
    }

    # 5) Reliable verdict: RLC on + gfx/mec halts clear + GRBM idle (GUI_ACTIVE=0).
    var grbm = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);
    var gfx_halt = me1 & GPU_CP_GFX_HALT_MASK;
    var mec_halt = mec1 & GPU_CP_MEC_ME1_HALT;
    var gui_busy = grbm & GPU_GRBM_GUI_ACTIVE;
    if (gfx_halt == 0 && mec_halt == 0 && gui_busy == 0) {
        kprintln("gpu: compute engines online (idle)", 34);
    }
    if (gfx_halt != 0 || mec_halt != 0 || gui_busy != 0) {
        kprintln("gpu: compute engines failed to start", 36);
    }

    # 6) Formal C0 re-read — expect the CASE B → CASE A flip.
    gpu_fw_probe();
    return 1;
}
# ── the GMC/VM state probe — GMC/GFXHUB VM-state probe (the reuse-vs-build decider) ───────────────
# READ-ONLY (F0/C0 discipline — zero device writes): dumps the GFXHUB VM/aperture
# state so the FB-aperture arena setup knows the memory design. Derived+verified verdict (gfxhub_v1_0.c): NO
# reusable GART exists pre-amdgpu — the design is to place compute scratch in the UMA
# carveout + address it through the BIOS-set FB aperture with ZERO page tables (the
# VM-fault-storm wedge designed OUT), NOT to build page tables. Reports: GART
# present/absent, translate-pipe (L1/L2) live/off, FB-aperture bounds, latched-fault
# baseline, BAR2 doorbell presence. All GFXHUB regs are GC seg0 (proven by the adjacent
# MC_VM_FB_* reads). Iron-only; no-op off an AMD GPU.
fn gpu_gpuvm_probe() {
    if (gpu_present == 0) { return 0; }
    var l1    = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_MX_L1_TLB_CNTL);
    var l2    = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_CNTL);
    var ctx0  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_CONTEXT0_CNTL);
    var ptlo  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_CTX0_PT_BASE_LO);
    var pthi  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_CTX0_PT_BASE_HI);
    var fbb   = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE);
    var fbt   = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_TOP);
    var agpb  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_AGP_BOT);
    var agpt  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_AGP_TOP);
    var salo  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_SYS_APERTURE_LOW);
    var sahi  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_SYS_APERTURE_HIGH);
    var fault = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);
    var bar2  = pci_bar_64(gpu_pci_idx, 2);

    kprintln("gpu: probing memory controller...", 33);

    var ptb = 0;
    if ((ptlo | pthi) != 0) { ptb = 1; }
    if ((ctx0 & 0x1) != 0 && ptb != 0) {
        kprintln("gpu: GART present (stale)", 25);
    }
    if ((ctx0 & 0x1) == 0 || ptb == 0) {
        kprintln("gpu: no GART page tables", 24);
    }
    if ((l1 & 0x1) != 0 && (l2 & 0x1) != 0) {
        kprintln("gpu: framebuffer aperture reachable", 35);
    }
    if ((l1 & 0x1) == 0 || (l2 & 0x1) == 0) {
        kprintln("gpu: memory pipe disabled (enabling caches)", 43);
    }
    kprintln("gpu: memory: UMA carveout via framebuffer aperture", 50);
    return 1;
}
# ── the FB-aperture arena setup — GFXHUB GMC setup for FB-aperture compute (first GMC write) ───────────
# The MEC is running (Case A) but has no addressable memory. the FB-aperture arena setup arms the GMC so a
# compute arena in the UMA carveout is reachable via the FB aperture — with ZERO page
# tables, so the VM-fault-storm CPU-wedge is designed OUT (VM_CONTEXT0 stays DISABLED).
# Minimal, all-confirmed-offset set (the L1-reprogram/MTYPE_UC + system-aperture default
# page are DEFERRED — medium-confidence; coherence handled by PM4 cache ops at the compute-queue HQD setup/d).
# Derived + adversarially verified vs gmc_v9_0.c / gfxhub_v1_0.c; the hang-risk lens
# caught + fixed the fault-CNTL mask (0x1FFC = bits[2:12] serve-default, no-int, no-crash).
# the FB-aperture arena setup writes GMC config only — no engine fetch — so it cannot itself wedge (verified).
fn gpu_vm_setup() {
    if (gpu_present == 0) { return 0; }
    if (gpu_psp_ring2 == 0) { return 0; }

    # Carveout geometry (same FB regs as the C1b-1 TMR math). fb_off = CPU-physical base;
    # fb_base = MC (GPU/FB-aperture) base — distinct domains on this APU.
    var r_off  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_OFFSET)   & GPU_FB_LOC_MASK;
    var r_base = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE) & GPU_FB_LOC_MASK;
    var fb_off  = r_off << 24;
    var fb_base = r_base << 24;
    var arena_mc   = fb_base + GPU_VM_ARENA_OFF;   # MEC side (pq_base = mc>>8)
    var arena_phys = fb_off  + GPU_VM_ARENA_OFF;   # CPU side (UC-mapped)
    var dummy_phys = arena_phys + GPU_VM_DUMMY_SUBOFF;
    gpu_arena_mc   = arena_mc;
    gpu_arena_phys = arena_phys;

    # UC-map the arena (CPU side). Probe CPU access to the carveout DRAM: write a
    # sentinel at the ring base + read it back (the compute-queue HQD setup/d write the ring/MQD here, so this
    # premise is load-bearing). Then zero the dummy fault-sink page.
    vmm_remap_uc_2mb(arena_phys);
    store32(arena_phys, 0xC2B0C2B0);
    var chk = load32(arena_phys) & 0xFFFFFFFF;
    store32(arena_phys, 0);
    var i = 0;
    while (i < 512) { store64(dummy_phys + i * 8, 0); i = i + 1; }

    # --- Fault-storm net (armed BEFORE enabling L2) ---
    # Out-of-window (L2 range) fault → the dummy page; no IRQ, no pipe-crash, latch first.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_DEF_LO, (dummy_phys >> 12) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_DEF_HI, (dummy_phys >> 44) & 0xF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, GPU_VM_FAULT_CNTL_ARM);

    # Keep VMID0 paging DISABLED — the structural fault-storm design-out (no PT walk).
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_CONTEXT0_CNTL, 0);

    # THE load-bearing write: enable the L2/UTCL2 datapath (RMW — preserve BIOS bits).
    var l2 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_CNTL, l2 | GPU_VM_L2_ENABLE_CACHE);

    # GFXHUB TLB flush (no semaphore on GFXHUB); BOUNDED ACK poll — never spin.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_INVALIDATE_ENG0_REQ, GPU_VM_INVALIDATE_REQ_ALL);
    var dd = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_INVALIDATE_ENG0_REQ);   # fast-GRBM false-ACK workaround
    var t = 0;
    var acked = 0;
    while (t < 1000) {
        if ((gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_INVALIDATE_ENG0_ACK) & 0x1) != 0) { acked = 1; t = 1000; }
        else { gpu_udelay(10); t = t + 1; }
    }

    # Readback-verify.
    var l2v  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_CNTL);
    var ctxv = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_CONTEXT0_CNTL);
    var fcv  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL);
    var flt  = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);
    var grbm = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);


    var l2_on   = l2v & GPU_VM_L2_ENABLE_CACHE;
    var ctx_off = ctxv & 0x1;
    var gui     = grbm & GPU_GRBM_GUI_ACTIVE;
    if (l2_on != 0 && ctx_off == 0 && flt == 0 && gui == 0 && chk == 0xC2B0C2B0) {
        kprintln("gpu: memory controller ready (L2 on, idle)", 42);
        return 1;
    }
    kprintln("gpu: memory controller setup incomplete", 39);
    return 0;
}
# ── the compute-queue HQD setup — map an EMPTY compute queue (MEC1/pipe0/queue0) ──────────────────────
# The MEC is running (Case A) + the GMC is armed (the FB-aperture arena setup). the compute-queue HQD setup maps a compute queue via
# DIRECT (non-HWS) HQD register programming: GRBM-select the slot, push the ~20 CP_HQD_*
# registers from the CPU (ACTIVE written LAST), deselect. The ring stays EMPTY (wptr==
# rptr==0) so the MEC makes ZERO memory accesses — this isolates the HQD-register recipe
# from VM/fetch correctness (the first PM4 fetch rings the doorbell + does the first fetch). Offsets are
# gfx9 gc_9_0_offset.h, anchor-validated against the iron-confirmed CP_MEC_CNTL/CP_ME_CNTL;
# all base_idx 0. MQD/RPTR-report use FULL byte addrs; PQ/EOP bases are MC>>8. Doorbell is
# ASSIGNED (DOORBELL_EN) but not rung. Derived + adversarially verified vs kfd_mqd_manager_v9
# / gfx_v9_0.c; the queue is left in the carveout (FB-aperture, no page tables). Low hang-
# risk: an active empty queue never dereferences the MQD or fetches the ring.
fn gpu_queue_setup() {
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }   # the FB-aperture arena setup armed the arena

    var ring_mc = gpu_arena_mc + GPU_VM_RING_SUBOFF;
    var mqd_mc  = gpu_arena_mc + GPU_VM_MQD_SUBOFF;
    var rptr_mc = gpu_arena_mc + GPU_VM_RPTR_SUBOFF;
    var eop_mc  = gpu_arena_mc + GPU_VM_EOP_SUBOFF;
    var mqd_phys  = gpu_arena_phys + GPU_VM_MQD_SUBOFF;
    var rptr_phys = gpu_arena_phys + GPU_VM_RPTR_SUBOFF;
    var eop_phys  = gpu_arena_phys + GPU_VM_EOP_SUBOFF;

    # Zero the MQD save-area, rptr-report page, and EOP buffer (carveout, CPU UC).
    var i = 0;
    while (i < 512) { store64(mqd_phys  + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < 512) { store64(rptr_phys + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < 512) { store64(eop_phys  + i * 8, 0); i = i + 1; }
    gpu_mfence();

    # Precondition: clear the global CP wptr DMA-poll enable (so the CP never DMA-reads a
    # memory wptr); then GRBM-select MEC1/pipe0/queue0/vmid0. The select..program..deselect
    # must be one uninterrupted sequence (agnos is single-threaded; no lock needed).
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_PQ_WPTR_POLL_CNTL, 0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);

    # 20 ordered HQD writes, CP_HQD_ACTIVE LAST.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_EOP_BASE_ADDR,    (eop_mc >> 8) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_EOP_BASE_ADDR_HI, ((eop_mc >> 8) >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_EOP_CONTROL,      GPU_CP_HQD_EOP_CONTROL_VAL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MQD_BASE_ADDR,        mqd_mc & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MQD_BASE_ADDR_HI,     (mqd_mc >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MQD_CONTROL,          GPU_CP_MQD_CONTROL_VAL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_BASE,          (ring_mc >> 8) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_BASE_HI,       ((ring_mc >> 8) >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_CONTROL,       GPU_CP_HQD_PQ_CONTROL_VAL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR_REPORT_ADDR,    rptr_mc & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR_REPORT_ADDR_HI, (rptr_mc >> 32) & 0xFFFFFFFF);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_POLL_ADDR,      0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_POLL_ADDR_HI,   0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_DOORBELL_CONTROL,    GPU_CP_HQD_DOORBELL_VAL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR,   0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO, 0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_HI, 0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_VMID,      0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PERSISTENT_STATE, GPU_CP_HQD_PERSISTENT_VAL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_ACTIVE,   0x1);   # ACTIVE — LAST

    # Pass-signal readbacks WHILE selected, then deselect + read the global GRBM_STATUS.
    var active = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_ACTIVE);
    var rptr   = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR);
    var db     = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_DOORBELL_CONTROL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
    var grbm = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);


    var act = active & 0x1;
    var gui = grbm & GPU_GRBM_GUI_ACTIVE;
    if (act != 0 && rptr == 0 && gui == 0) {
        gpu_queue_active = 1;
        kprintln("gpu: compute queue ready (MEC1)", 31);
        return 1;
    }
    kprintln("gpu: compute queue setup incomplete", 35);
    return 0;
}
# ── the first PM4 fetch — first PM4 packet: the VM-fetch gate ─────────────────────────────────
# The queue is mapped + active + EMPTY (the compute-queue HQD setup). the first PM4 fetch writes ONE 8-dword PACKET3_NOP into
# the ring, rings the doorbell, and watches the MEC fetch+consume it — the FIRST time
# the MEC translates a GPUVA (the ring base) through the the FB-aperture arena setup FB aperture (no page
# tables). THE make-or-break VM-fetch gate. CPU-wedge-SAFE (adversarially verified):
# every CPU access hits a decoded address (carveout DRAM / BAR5 / BAR2 doorbell); the
# doorbell is a POSTED PCIe write the CPU can't block on; the the FB-aperture arena setup fault-net (0x1FFC:
# serve-dummy-page, no-IRQ, no-crash — CONTIGUOUS bits[2:12], ground-truth-confirmed)
# bounds any fault to GPU-side; the ONLY wedge vector is an unbounded spin, eliminated
# by the bounded watchdog. Derived + 2-lens adversarially verified vs PM4/gfx_v9_0.
fn gpu_ring_kick() {
    if (gpu_present == 0) { return 0; }
    if (gpu_queue_active == 0) { return 0; }   # the compute-queue HQD setup mapped the queue
    if (gpu_arena_mc == 0) { return 0; }
    var ring_mc = gpu_arena_mc;                 # ring at arena suboffset 0

    # Pre-flight: the ring MC MUST be inside the FB aperture, else the MEC fetch faults.
    var r_base = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE) & GPU_FB_LOC_MASK;
    var r_top  = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_TOP)  & GPU_FB_LOC_MASK;
    var fb_base = r_base << 24;
    var fb_top  = (r_top << 24) + 0x1000000;
    if (ring_mc < fb_base || ring_mc >= fb_top) {
        kprintln("gpu: command ring address out of range", 38);
        return 0;
    }

    # Program the MEC doorbell range so the CP honors our doorbell byte 0x18 (the compute-queue HQD setup left
    # it unset). Global CP regs (no GRBM select). LOWER=0, UPPER=0xE8 covers [0,0xE8].
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MEC_DOORBELL_RANGE_LOWER, 0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_MEC_DOORBELL_RANGE_UPPER, GPU_DOORBELL_RANGE_UPPER_VAL);

    # UC-map BAR2 + the doorbell 8-byte slot (index 0x06 -> byte 0x18).
    var bar2 = pci_bar_64(gpu_pci_idx, 2);
    if (bar2 == 0) { kprintln("gpu: no doorbell aperture (BAR2)", 32); return 0; }
    vmm_remap_uc_2mb(bar2);
    var db_slot = bar2 + 0x18;

    # Clear any stale (sticky) VM_L2_PROTECTION_FAULT_STATUS so a post-kick fault!=0
    # unambiguously means a the first PM4 fetch fetch fault (not a leftover from an earlier probe).
    # Pulse CLEAR (bit0) then re-arm to the exact prior CNTL value (0x1FFC fault-net).
    var fc0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0 | 0x1);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0);

    # Write one 8-dword PACKET3_NOP into the ring (CPU UC), then fence BEFORE the kick.
    store32(gpu_arena_phys + 0x00, GPU_PM4_NOP8_HDR);   # PACKET3(NOP, count=6) = 0xC0061000
    store32(gpu_arena_phys + 0x04, 0);
    store32(gpu_arena_phys + 0x08, 0);
    store32(gpu_arena_phys + 0x0C, 0);
    store32(gpu_arena_phys + 0x10, 0);
    store32(gpu_arena_phys + 0x14, 0);
    store32(gpu_arena_phys + 0x18, 0);
    store32(gpu_arena_phys + 0x1C, 0);                  # dwords 1..7 = zero body
    gpu_mfence();

    # KICK: single 64-bit POSTED doorbell write = wptr in DWORDS (8, no shift). Fence.
    store64(db_slot, 8);
    gpu_mfence();

    # BOUNDED watchdog (NEVER spin): poll the memory rptr-report for rptr==8, 100 ms cap.
    var i = 0;
    var ok = 0;
    var rmem = 0;
    while (i < 1000) {
        # ⚠ GPU_VM_RPTR_SUBOFF, not a literal 0x11000. This read is the rptr-report page, and it was
        # hardcoded — so moving that slot would have left this pointing at whatever landed there next,
        # silently. Exactly the failure the 1.56.19 arena work was about: the collision that shipped was
        # a slot overlap, and a hardcoded copy of an address is the same bug with the names removed.
        rmem = load32(gpu_arena_phys + GPU_VM_RPTR_SUBOFF) & 0xFFFFFFFF;
        if (rmem == 8) { ok = 1; i = 1000; }
        else { gpu_udelay(100); i = i + 1; }
    }

    # Cross-check: the AUTHORITATIVE CP_HQD_PQ_RPTR (via GRBM-select), fault, GRBM idle.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    var rreg = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
    var fault = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);
    var grbm  = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);
    var gui   = grbm & GPU_GRBM_GUI_ACTIVE;


    # Isolation fallback (only on a clean no-fetch): a direct register wptr write bypasses
    # the doorbell route — if THAT advances rptr, the doorbell routing was the gap (not VM).
    if (rmem == 0 && (rreg & 0xFFFFFFFF) == 0 && fault == 0) {
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO, 8);
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_HI, 0);
        var j = 0;
        while (j < 200) {
            if ((gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR) & 0xFFFFFFFF) == 8) { rreg = 8; j = 200; }
            else { gpu_udelay(100); j = j + 1; }
        }
        gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);
    }

    var fetched = 0;
    if (ok != 0) { fetched = 1; }
    if ((rreg & 0xFFFFFFFF) == 8) { fetched = 1; }
    if (fault != 0) {
        kprintln("gpu: command ring fetch faulted", 31);
        return 0;
    }
    if (fetched != 0 && gui == 0) {
        gpu_ring_fetched = 1;
        gpu_ring_wptr = 8;   # canonical ring cursor after the 8-dword NOP kick; the WRITE_DATA fence appends here
        kprintln("gpu: command ring active", 24);
        # ⭐ THE EDGE CAP, REPORTED BY THE KERNEL ITSELF. EDGE_CAP_PROBE swaps ONE CONSTANT, so
        # the probe kernel is byte-identical in size to the shipped one and `strings` cannot tell
        # them apart — the ATOM_DRY shape exactly. This line is the OBSERVABLE: the kernel states
        # the cap it is actually running with, so burn-prep and the operator can both check the
        # flag LANDED rather than assuming it did. An answer, not an echo.
        kprint("gpu: edge rasteriser cap ", 25); kprint_num(GPU_EDGE_CAP);
        kprintln(" edges", 6);
        return 1;
    }
    kprintln("gpu: command ring not responding", 32);
    return 0;
}
# ── the WRITE_DATA fence — WRITE_DATA fence: the MEC executes + a CPU-visible write ─────────────
# the first PM4 fetch proved the MEC FETCHES (rptr 0->8) but left two ambiguities: did it EXECUTE
# (vs skip a NOP), and is a MEC memory write CPU-VISIBLE (the first PM4 fetch's memory rptr-report
# read 0 from the CPU even as the register rptr read 8). the WRITE_DATA fence resolves both with ONE
# UNCONDITIONAL PACKET3_WRITE_DATA that writes a known sentinel to a carveout slot the
# CPU reads back. DST_SEL=5 (memory async-direct) targets DRAM, bypassing the GL2 path
# that would strand the write — so "rptr advanced but sentinel stale" can ONLY mean a
# coherence gap (retro-explaining the first PM4 fetch's rmem=0). NO ACQUIRE_MEM flush on this burn: it
# would collapse the executed-vs-coherent disambiguation (the row-2 follow-up).
# WEDGE-SAFE (same envelope as the first PM4 fetch): bounded watchdog only; every CPU access hits
# decoded carveout DRAM / BAR5 regs; the MEC write targets OUR carveout (bus-master off
# => it cannot reach system RAM); faults bounded by the 0x1FFC dummy-page net.
# Derived + 2-lens adversarially verified vs PM4/soc15d.h — all refuted=False.
fn gpu_fence() {
    if (gpu_present == 0) { return 0; }
    if (gpu_ring_fetched == 0) {
        kprintln("gpu: skipping coherence check (ring inactive)", 45);
        return 0;
    }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }

    var sent_mc   = gpu_arena_mc   + GPU_VM_SENT_SUBOFF;   # MEC-side MC addr (FB aperture)
    var sent_phys = gpu_arena_phys + GPU_VM_SENT_SUBOFF;   # CPU-side UC phys (same DRAM)

    # Pre-seed a NOT-YET marker (!= sentinel AND != 0) so a stale/zero read can't false-pass.
    store32(sent_phys, GPU_C2E_NOTYET);
    gpu_mfence();

    # Clear sticky VM fault-status (pulse CLEAR bit0, re-arm to the prior 0x1FFC net) so a
    # post-kick fault!=0 unambiguously blames THIS WRITE_DATA.
    var fc0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0 | 0x1);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0);

    # Append the 5-dword WRITE_DATA packet at the tracked cursor (cursor is DWORDS -> *4).
    #
    # ✅ FIXED 1.56.24 — PER-DWORD MASKED, gpu_ring_put's shape.
    # ⛔ THE HISTORY IS THE POINT, because the obvious fix is the wrong one. This append used to read
    # `var base = gpu_arena_phys + (gpu_ring_wptr << 2)` with NO mask, while gpu_ring_put masks every
    # store with `& GPU_RING_DW_MASK` (the ring is 16384 dwords; the CURSOR stays monotonic — that is
    # what the CP's wptr register expects — and the STORE wraps). So if gpu_ring_wptr ever reached
    # 16384 these five dwords landed past the ring's 0x10000 end, directly on the MQD save area, with
    # no page tables to stop it.
    # ⛔ DO NOT COLLAPSE THIS BACK TO A MASKED `base`. The packet is five dwords from one base, so a
    # masked base still runs off the end whenever the cursor sits within five dwords of the wrap — it
    # would look corrected and fail ONLY at the boundary, which is worse than the original bug because
    # it also looks fixed. Each dword masks its OWN index; that is the whole content of this fix.
    # ⚠ It was never reachable in a shipped boot (cursor starts at 8, +5 per call ⇒ ~3275 fences in one
    # boot), and that is exactly why it survived: unreachable is not the same as correct, and the risk
    # register in gpu.md asserted the mask was already here. Recorded 2026-07-26 by the arena-extent
    # survey, fixed 1.56.24. Behaviour below 16384 dwords is byte-identical to the old code.
    var rb = gpu_arena_phys;
    var w0 = gpu_ring_wptr;
    store32(rb + (((w0 + 0) & GPU_RING_DW_MASK) << 2), GPU_PM4_WRITE_DATA_HDR);        # PACKET3(WRITE_DATA, count=3)
    store32(rb + (((w0 + 1) & GPU_RING_DW_MASK) << 2), GPU_PM4_WRITE_DATA_CTL);        # DST_SEL=5 (memory) | WR_CONFIRM
    store32(rb + (((w0 + 2) & GPU_RING_DW_MASK) << 2), sent_mc & 0xFFFFFFFF);          # DST_ADDR_LO (MC/aperture, no PTs)
    store32(rb + (((w0 + 3) & GPU_RING_DW_MASK) << 2), (sent_mc >> 32) & 0xFFFFFFFF);  # DST_ADDR_HI
    store32(rb + (((w0 + 4) & GPU_RING_DW_MASK) << 2), GPU_C2E_SENTINEL);              # DATA = sentinel to write
    gpu_mfence();                                        # ring bytes visible before the kick

    var new_wptr = gpu_ring_wptr + 5;                    # header + 4 body = 5 dwords

    # Submit via the PROVEN register-wptr path (the first PM4 fetch: doorbell did NOT advance wptr; a direct
    # CP_HQD_PQ_WPTR_LO write DID). GRBM-select the HQD, write wptr.
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO, new_wptr);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_HI, 0);

    # BOUNDED watchdog (NEVER spin): poll BOTH the register rptr AND the sentinel, 100 ms cap.
    var i = 0;
    var rptr_ok = 0;
    var sent_ok = 0;
    var rreg = 0;
    var sval = 0;
    while (i < 1000) {
        rreg = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR) & 0xFFFFFFFF;
        sval = load32(sent_phys) & 0xFFFFFFFF;
        if (rreg == new_wptr) { rptr_ok = 1; }
        if (sval == GPU_C2E_SENTINEL) { sent_ok = 1; }
        if (rptr_ok != 0 && sent_ok != 0) { i = 1000; }
        else { gpu_udelay(100); i = i + 1; }
    }
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);   # deselect

    # Force UC-CPU / MC-async-write ordering before the authoritative read.
    gpu_mfence();
    var dummy = load32(sent_phys);                      # throwaway ordering read

    var fault = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);
    var grbm  = gpu_reg32(GPU_BASE_GC_0, GPU_R_GRBM_STATUS);
    var gui   = grbm & GPU_GRBM_GUI_ACTIVE;
    sval = load32(sent_phys) & 0xFFFFFFFF;              # final authoritative readback


    gpu_ring_wptr = new_wptr;                           # advance cursor -> a re-run appends cleanly

    if (fault != 0) {
        kprintln("gpu: coherence check faulted", 28);
        return 0;
    }
    if (rptr_ok != 0 && sent_ok != 0 && gui == 0) {
        gpu_fence_ok = 1;
        kprintln("gpu: GPU-to-CPU coherence verified", 34);
        return 1;
    }
    if (rptr_ok != 0 && sent_ok == 0) {
        kprintln("gpu: GPU write not CPU-visible", 30);
        return 0;
    }
    kprintln("gpu: coherence check did not run", 32);
    return 0;
}
# ── the first shader dispatch — first hand-assembled gfx90c compute shader (DISPATCH_DIRECT) ─────────
# The FIRST arbitrary ISA on the shader cores. A minimal single-thread (1x1x1) shader
# writes constant 0xC2F0C2F0 to a carveout slot via global_store_dword (GLC=1), and the
# CPU reads it back. Every ISA/PM4 byte is adversarially confirmed (incl. reconstructing
# LLVM D40493's global_store_dwordx2=0xDC748000 to the bit); scalar SMEM stores don't
# exist on gfx9 so we use a VECTOR store, which reuses the the FB-aperture arena setup-proven L2/UTCL2 datapath.
# A shader store lands in GL2 (unlike the WRITE_DATA fence's CP WRITE_DATA straight to MC), so the ring
# program appends CS_PARTIAL_FLUSH (drain waves) + ACQUIRE_MEM (TC write-back GL2->DRAM)
# BEFORE the the WRITE_DATA fence-proven WRITE_DATA done-marker — so a visible done-marker means
# "waves retired AND L2 flushed". Submit via the proven register-wptr path.
# WEDGE-SAFE: our ~6-instr straight-line shader (no loops, ends s_endpgm) on OUR carveout;
# cores reach only the FB aperture (bus-master off => no system RAM); a bad store faults
# into the 0x1FFC dummy-page net; the CPU only ever runs a BOUNDED watchdog on the marker.
# gpu_ring_put appends one dword at the tracked cursor and advances it.
fn gpu_ring_put(val) {
    # WRAP the RING-BUFFER index to the 64 KB PQ (QUEUE_SIZE 0xD = 16384 dwords). `gpu_ring_wptr` itself stays
    # MONOTONIC — that is what the CP's wptr register expects (amdgpu's model: monotonic wptr, masked buffer
    # index), and it is what every proven boot path already writes, so this mask is a NO-OP below 16384 dwords
    # (byte-identical behaviour for the first PM4 fetch/the WRITE_DATA fence/the first shader dispatch and the dispatches). Without it, a repeatedly-called ring
    # producer — e.g. the #85 fill syscall a compositor runs EVERY FRAME (12 dw each ⇒ ~23 s at 60 fps) — walks
    # the write cursor past the end of the ring and scribbles the rptr-report/EOP slots that follow it in the
    # arena. Peer of the PSP ring's `& GPU_PSP_RING_DW_MASK`.
    store32(gpu_arena_phys + ((gpu_ring_wptr & GPU_RING_DW_MASK) << 2), val & 0xFFFFFFFF);
    gpu_ring_wptr = gpu_ring_wptr + 1;
    return 0;
}
fn gpu_shader_dispatch() {
    gpu_shader_ok = 0;
    if (gpu_present == 0) { return 0; }
    if (gpu_fence_ok == 0) {
        kprintln("gpu: skipping shader test (coherence unverified)", 48);
        return 0;
    }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }

    var shader_phys = gpu_arena_phys + GPU_SHADER_SUBOFF;
    var out_phys    = gpu_arena_phys + GPU_SHADER_OUT_SUBOFF;
    var done_phys   = gpu_arena_phys + GPU_SHADER_DONE_SUBOFF;
    var shader_mc   = gpu_arena_mc   + GPU_SHADER_SUBOFF;       # COMPUTE_PGM src
    var out_mc      = gpu_arena_mc   + GPU_SHADER_OUT_SUBOFF;   # what the shader stores to
    var done_mc     = gpu_arena_mc   + GPU_SHADER_DONE_SUBOFF;  # WRITE_DATA marker dst

    # 1. Write the 10-dword shader blob at arena+0x14000. The store-target address (v0/v1)
    #    is COMPUTED from arena_mc, not hardcoded, so it tracks the real FB base.
    store32(shader_phys + 0x00, 0x7E0002FF);              # v_mov_b32 v0, lit
    store32(shader_phys + 0x04, out_mc & 0xFFFFFFFF);     #   = out addr lo
    store32(shader_phys + 0x08, 0x7E0202FF);              # v_mov_b32 v1, lit
    store32(shader_phys + 0x0C, (out_mc >> 32) & 0xFFFFFFFF); # = out addr hi
    store32(shader_phys + 0x10, 0x7E0402FF);              # v_mov_b32 v2, lit
    store32(shader_phys + 0x14, GPU_C2F_CONST);           #   = 0xC2F0C2F0
    store32(shader_phys + 0x18, 0xDC718000);              # global_store_dword v[0:1],v2,off glc
    store32(shader_phys + 0x1C, 0x007F0200);              #   (VADDR=v0, VDATA=v2, SADDR=off=0x7F)
    store32(shader_phys + 0x20, 0xBF8C0F70);              # s_waitcnt vmcnt(0)
    store32(shader_phys + 0x24, 0xBF810000);              # s_endpgm

    # 2. Pre-seed out + done with a NOT-YET marker (!= const/done AND != 0) so a stale/zero
    #    read cannot false-pass.
    store32(out_phys,  0xDEADBEEF);
    store32(done_phys, 0xDEADBEEF);
    gpu_mfence();

    # 3. Pulse-clear + re-arm the fault-net so a post-dispatch fault!=0 blames the first shader dispatch.
    var fc0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0 | 0x1);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0);

    # 4. Append the 39-dword the first shader dispatch ring program at gpu_ring_wptr (== 13).
    var pgm_lo = (shader_mc >> 8)  & 0xFFFFFFFF;
    var pgm_hi = (shader_mc >> 40) & 0xFF;
    # SET_SH COMPUTE_PGM_LO/HI
    # PRE-dispatch I$/K$ invalidate (mabda-proven, MANDATORY on gfx9) — the shader is rewritten in place at
    # a FIXED VA (0x14000) every dispatch, so without this the SQ runs a STALE cached shader (a prior
    # dispatch's baked store-address) => the store lands in the wrong slot. THE fix for the the first 64-thread dispatch
    # intermittent-launch bug (burns 1-8): the first shader dispatch worked only by cold-cache luck; every later dispatch ran stale.
    gpu_ring_put(GPU_PM4_ACQUIRE_MEM_HDR); gpu_ring_put(GPU_CP_COHER_CNTL_INV);
    gpu_ring_put(GPU_ACQUIRE_COHER_SIZE); gpu_ring_put(GPU_ACQUIRE_COHER_SIZE_HI);
    gpu_ring_put(0); gpu_ring_put(0); gpu_ring_put(GPU_ACQUIRE_POLL);
    gpu_ring_put(GPU_PM4_SET_SH_REG_N2); gpu_ring_put(GPU_SH_COMPUTE_PGM_LO); gpu_ring_put(pgm_lo); gpu_ring_put(pgm_hi);
    # SET_SH COMPUTE_PGM_RSRC1/2
    gpu_ring_put(GPU_PM4_SET_SH_REG_N2); gpu_ring_put(GPU_SH_COMPUTE_PGM_RSRC1); gpu_ring_put(GPU_COMPUTE_PGM_RSRC1_MIN); gpu_ring_put(0);
    # SET_SH COMPUTE_NUM_THREAD_X/Y/Z = 1,1,1
    gpu_ring_put(GPU_PM4_SET_SH_REG_N3); gpu_ring_put(GPU_SH_COMPUTE_NUM_THREAD_X); gpu_ring_put(1); gpu_ring_put(1); gpu_ring_put(1);
    # SET_SH COMPUTE_STATIC_THREAD_MGMT_SE0/SE1 = all-CUs (else zero waves launch)
    gpu_ring_put(GPU_PM4_SET_SH_REG_N2); gpu_ring_put(GPU_SH_COMPUTE_STATIC_SE0); gpu_ring_put(GPU_CU_MASK_ALL); gpu_ring_put(0);
    gpu_ring_put(GPU_PM4_SET_SH_REG_N2); gpu_ring_put(GPU_SH_COMPUTE_STATIC_SE2); gpu_ring_put(0); gpu_ring_put(0);
    # SET_SH COMPUTE_RESOURCE_LIMITS = 0 (no caps)
    gpu_ring_put(GPU_PM4_SET_SH_REG_N1); gpu_ring_put(GPU_SH_COMPUTE_RESOURCE_LIMITS); gpu_ring_put(GPU_COMPUTE_RESLIM);
    # DISPATCH_DIRECT 1x1x1
    gpu_ring_put(GPU_PM4_DISPATCH_DIRECT_HDR); gpu_ring_put(1); gpu_ring_put(1); gpu_ring_put(1); gpu_ring_put(GPU_DISPATCH_INITIATOR);
    # EVENT_WRITE CS_PARTIAL_FLUSH (drain the compute waves before the flush)
    gpu_ring_put(GPU_PM4_EVENT_WRITE_HDR); gpu_ring_put(GPU_EVENT_CS_PARTIAL_FLUSH);
    # ACQUIRE_MEM whole-cache TC write-back (GL2 -> DRAM, so the CPU UC read sees the store)
    gpu_ring_put(GPU_PM4_ACQUIRE_MEM_HDR); gpu_ring_put(GPU_CP_COHER_CNTL_TCWB);
    gpu_ring_put(GPU_ACQUIRE_COHER_SIZE); gpu_ring_put(GPU_ACQUIRE_COHER_SIZE_HI);
    gpu_ring_put(0); gpu_ring_put(0); gpu_ring_put(GPU_ACQUIRE_POLL);
    # WRITE_DATA done-marker (the WRITE_DATA fence-proven DST_SEL=5 path -> CPU-visible completion signal)
    gpu_ring_put(GPU_PM4_WRITE_DATA_HDR); gpu_ring_put(GPU_PM4_WRITE_DATA_CTL);
    gpu_ring_put(done_mc & 0xFFFFFFFF); gpu_ring_put((done_mc >> 32) & 0xFFFFFFFF); gpu_ring_put(GPU_C2F_DONE);
    gpu_mfence();

    # 5. Register-wptr submit (proven the first PM4 fetch/the WRITE_DATA fence path). new_wptr == 52.
    var new_wptr = gpu_ring_wptr;
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO, new_wptr);   # LO FIRST — matches the
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_HI, 0);          # proven the first PM4 fetch/the WRITE_DATA fence order; the CP
    #   latches the 64-bit wptr on the HI write, sampling the LO already set (the first shader dispatch burn 2 wrote HI first
    #   -> latched the stale LO=13 -> wptr stuck at 13, queue never advanced).
    gpu_mfence();

    # 6. BOUNDED watchdog on the done-marker (100 ms cap; NEVER an unbounded spin).
    # plan-S12a: tight spin, not a 100 us sleep quantum. See gpu_wait_done.
    var ok = gpu_wait_done(done_phys, GPU_C2F_DONE, 100000);
    # Read the per-queue state WHILE STILL GRBM-SELECTED — rptr/wptr/active read the
    # DEFAULT queue once deselected (that was the the first shader dispatch-first-burn rptr=0x0 artifact). rptr
    # localizes WHERE the ring stalled (13=start..0x34=all consumed); wptr confirms the
    # submit landed (0x34); active confirms the queue wasn't dequeued.
    var rreg    = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_RPTR)    & 0xFFFFFFFF;
    var wptr_rb = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO) & 0xFFFFFFFF;
    var active  = gpu_reg32(GPU_BASE_GC_0, GPU_R_CP_HQD_ACTIVE)     & 0xFFFFFFFF;
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);   # deselect
    gpu_mfence();

    # 7. Readback (memory + non-queue regs) + classify.
    var outv  = load32(out_phys) & 0xFFFFFFFF;
    var donev = load32(done_phys) & 0xFFFFFFFF;
    var fault = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);


    gpu_ring_wptr = new_wptr;   # cursor authoritative for any re-run

    if (fault != 0) {
        gpu_shader_ok = 0 - 3;
        kprintln("gpu: shader store faulted", 25);
        return 0;
    }
    if (ok != 0) {
        if (outv == GPU_C2F_CONST) {
            gpu_shader_ok = 1;
            kprintln("gpu: compute shader executed", 28);
            return 1;
        }
        gpu_shader_ok = 0 - 2;
        kprintln("gpu: shader store not CPU-visible", 33);
        return 0;
    }
    gpu_shader_ok = 0 - 1;
    kprintln("gpu: shader dispatch did not complete", 37);
    return 0;
}
# ── CP-DMA — hardware 2D memory copy on the PROVEN compute ring (the 2D-acceleration bite, pivoted off SDMA) ────────
# The FIRST hardware 2D on sovereign agnos. A PM4 DMA_DATA (CP-DMA, op 0x50) packet on the MEC
# compute ring that the first PM4 fetch/the WRITE_DATA fence already proved FETCHES + EXECUTES + lands CPU-visible writes — NO SDMA,
# NO doorbell, NO new firmware. CP_SYNC=1 holds the ME until the copy's writes ACK to DRAM;
# SRC_SEL/DST_SEL=0 = MC-direct (bypass GL2 — the same domain the the WRITE_DATA fence WRITE_DATA is already
# CPU-visible through), so NO ACQUIRE_MEM is needed. A the WRITE_DATA fence-proven WRITE_DATA done-marker (DST_SEL=5)
# follows as the CPU-pollable completion gate: CP_SYNC orders it AFTER the copy, so marker-visible
# ⟹ the 4 KB committed to DRAM. byte_count is RAW bytes (4096), NOT byte_count-1 (that's the SDMA
# convention). ENGINE=ME (bit0=0) — the MEC has no PFP. Submit via the proven register-wptr kick
# (LO then HI; the CP latches the 64-bit wptr on the HI write). Reuses the arena scratch slots (the
# SDMA copy-test is parked). Gated #ifdef CP_DMA_COPY; needs the ring coherence-proven (gpu_fence_ok).
# WEDGE-SAFE: bounded watchdog only; MC addrs in OUR carveout (bus-master off ⇒ no system RAM); a bad
# addr faults into the 0x1FFC dummy-page net (fault!=0).
fn gpu_cpdma_submit(ctl, slo, shi, dst_mc, bytes) {
    if (gpu_present == 0) { return 0; }
    if (gpu_fence_ok == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }

    var fence_mc   = gpu_arena_mc + GPU_SDMA_FENCE_SUBOFF;
    var fence_phys = gpu_arena_phys + GPU_SDMA_FENCE_SUBOFF;

    store32(fence_phys, GPU_C2E_NOTYET);                 # arm the done marker
    gpu_mfence();

    # Clear sticky VM fault-status (pulse CLEAR bit0, re-arm) so a post-kick fault!=0 blames THIS packet.
    var fc0 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0 | 0x1);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_CNTL, fc0);

    # DMA_DATA (7 dw) + WRITE_DATA done-marker (5 dw) at the tracked cursor. ctl/slo/shi select the variant:
    #   COPY: ctl=CTL_COPY, slo/shi = src_mc lo/hi (SRC_SEL=0, read from MC).
    #   FILL: ctl=CTL_FILL, slo = the 32-bit value, shi = 0 (SRC_SEL=2 DATA, dw2 IS the literal). dst_mc = MC, NOT phys.
    gpu_ring_put(GPU_PM4_DMA_DATA_HDR);                  # PACKET3(DMA_DATA=0x50, count=5)
    gpu_ring_put(ctl);                                   # CONTROL: CP_SYNC | SRC_SEL(copy=0/fill=2) | DST_SEL=0(MC) | ME
    gpu_ring_put(slo & 0xFFFFFFFF);                      # SRC_ADDR_LO  (or the fill DATA constant)
    gpu_ring_put(shi & 0xFFFFFFFF);                      # SRC_ADDR_HI  (0 for a 32-bit fill constant)
    gpu_ring_put(dst_mc & 0xFFFFFFFF);                   # DST_ADDR_LO
    gpu_ring_put((dst_mc >> 32) & 0xFFFFFFFF);           # DST_ADDR_HI
    gpu_ring_put(bytes & GPU_CPDMA_MAX);                 # COMMAND: BYTE_COUNT (26-bit raw), WR_CONFIRM on (b31=0)
    gpu_ring_put(GPU_PM4_WRITE_DATA_HDR);                # PACKET3(WRITE_DATA=0x37, count=3)
    gpu_ring_put(GPU_PM4_WRITE_DATA_CTL);                # DST_SEL=5 memory-async | WR_CONFIRM | ME
    gpu_ring_put(fence_mc & 0xFFFFFFFF);                 # marker DST_ADDR_LO
    gpu_ring_put((fence_mc >> 32) & 0xFFFFFFFF);         # marker DST_ADDR_HI
    gpu_ring_put(GPU_CPDMA_DONE);                        # done sentinel the MEC writes
    gpu_mfence();

    var new_wptr = gpu_ring_wptr;

    # KICK via the proven register-wptr path: GRBM-select the HQD, wptr LO then HI (CP latches on HI).
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_LO, new_wptr);
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_CP_HQD_PQ_WPTR_HI, 0);

    # Bounded watchdog on the done sentinel (CP_SYNC orders it after the op), 100 ms cap.
    var s = 0;
    var done = 0;
    while (s < 1000) {
        if ((load32(fence_phys) & 0xFFFFFFFF) == GPU_CPDMA_DONE) { done = 1; s = 1000; }
        else { gpu_udelay(100); s = s + 1; }
    }
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);   # deselect
    gpu_mfence();

    var fault = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_PROT_FAULT_STATUS);
    if (fault != 0) { return 0; }
    if (done != 1) { return 0; }
    return 1;
}
# gpu_cp_dma — hardware COPY `bytes` from src_mc to dst_mc (both GPU MC addresses, dword-aligned). 1 ok / 0 fail.
fn gpu_cp_dma(dst_mc, src_mc, bytes) {
    return gpu_cpdma_submit(GPU_CPDMA_CTL_COPY, src_mc & 0xFFFFFFFF, (src_mc >> 32) & 0xFFFFFFFF, dst_mc, bytes);
}
# gpu_cp_dma_fill — hardware FILL: write the 32-bit `val` across `bytes` at dst_mc (SRC_SEL=2 DATA; dw2=val,
# dw3=0). No source read; ideal for framebuffer clears. MC-direct ⇒ scanout/CPU-visible. 1 ok / 0 fail.
fn gpu_cp_dma_fill(dst_mc, val, bytes) {
    return gpu_cpdma_submit(GPU_CPDMA_CTL_FILL, val & 0xFFFFFFFF, 0, dst_mc, bytes);
}
# ── S1 (1.56.x SHADER arc) — READ-ONLY compute-state probe. The P0 analog: decode what the compute pipe
# ACTUALLY holds before the arc mutates any of it. Pure MMIO reads, no ring traffic, no writes, no hang risk.
# Self-validating: the decoded fields must match the constants this codebase believes it writes (RSRC1
# 0x002C0043 ⇒ VGPRS=3; RSRC2 0x0C ⇒ USER_SGPR=6, TGID all off) — if the decode disagrees, either the field
# layout or the MMIO base is wrong and every later bite is built on sand.
# ★ THE FAIL THAT MATTERS: COMPUTE_TMPRING_SIZE non-zero. agnos has NEVER written it, so a non-zero value
# means a stale scratch-ring base is live — and register spilling would then not be slow, it would be WRONG,
# scribbling into whatever that stale base points at. Gated #ifdef SHADER_PROBE.
fn gpu_shader_state_probe() {
    if (gpu_present == 0) { return 0; }
    # ⚠ THE COMPUTE_* SH REGISTERS ARE GRBM-INDEXED. Burn 1 read them deselected and got the DEFAULT context
    # (rsrc1=0xDD, rsrc2=0, threads=0) instead of what agnos actually writes (rsrc1=0x002C0043, rsrc2=0x0C) —
    # the same trap gpu_fence already documents for CP_HQD_* ("deselected reads return the default queue").
    # So read BOTH ways: the deselected value is kept only as the negative control that PROVES the select is
    # required. VM_L2_CNTL is a GC global, not context-indexed, so it is read outside the selection.
    var l2 = gpu_reg32(GPU_BASE_GC_0, GPU_R_VM_L2_CNTL) & 0xFFFFFFFF;
    var r1_d = gpu_reg32(GPU_BASE_GC_0, GPU_SH_REG_MMIO_BASE + GPU_SH_COMPUTE_PGM_RSRC1) & 0xFFFFFFFF;

    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, GPU_GRBM_SEL_MEC1_P0_Q0);
    var r1 = gpu_reg32(GPU_BASE_GC_0, GPU_SH_REG_MMIO_BASE + GPU_SH_COMPUTE_PGM_RSRC1) & 0xFFFFFFFF;
    var r2 = gpu_reg32(GPU_BASE_GC_0, GPU_SH_REG_MMIO_BASE + GPU_SH_COMPUTE_PGM_RSRC2) & 0xFFFFFFFF;
    var tm = gpu_reg32(GPU_BASE_GC_0, GPU_SH_REG_MMIO_BASE + GPU_SH_COMPUTE_TMPRING_SIZE) & 0xFFFFFFFF;
    var nx = gpu_reg32(GPU_BASE_GC_0, GPU_SH_REG_MMIO_BASE + GPU_SH_COMPUTE_NUM_THREAD_X) & 0xFFFFFFFF;
    gpu_reg32_write(GPU_BASE_GC_0, GPU_R_GRBM_GFX_CNTL, 0);   # deselect

    # RSRC1: VGPRS [5:0] · SGPRS [9:6] · FLOAT_MODE [19:12].  RSRC2: USER_SGPR [5:1] · TGID_X/Y/Z [7]/[8]/[9].
    var vgpr = r1 & 0x3F;
    var sgpr = (r1 >> 6) & 0xF;
    var usgp = (r2 >> 1) & 0x1F;
    var tgx  = (r2 >> 7) & 0x1;
    var tgy  = (r2 >> 8) & 0x1;

    kprint("gpu: shader state rsrc1 ", 24);  kprint_num(r1);
    kprint(" vgpr ", 6);                     kprint_num(vgpr);
    kprint(" sgpr ", 6);                     kprint_num(sgpr);
    kprintln("", 0);
    kprint("gpu: shader state rsrc2 ", 24);  kprint_num(r2);
    kprint(" usersgpr ", 10);                kprint_num(usgp);
    kprint(" tgid_x ", 8);                   kprint_num(tgx);
    kprint(" tgid_y ", 8);                   kprint_num(tgy);
    kprintln("", 0);
    kprint("gpu: shader state threads ", 26); kprint_num(nx);
    kprint(" l2cntl ", 8);                    kprint_num(l2);
    kprintln("", 0);
    kprint("gpu: shader state scratch ring ", 31); kprint_num(tm);
    kprint(" rsrc1 deselected ", 18);               kprint_num(r1_d);
    kprintln("", 0);

    # GATE. The selected read must match what this codebase actually writes, or the MMIO base / field layout
    # is wrong and every later bite is built on sand. agnos writes RSRC1 0x002C0043 (VGPRS=3) for the f64
    # kernel and RSRC2 0x0C (USER_SGPR=6, TGID all off). The DESELECTED value is the negative control: it
    # must DIFFER, which is what proves the GRBM selection is load-bearing rather than decorative.
    # ★ SETTLED NEGATIVE RESULT (two iron burns, 1.56.0): the COMPUTE_* SH registers are NOT a readable
    # configuration store. Selected and deselected reads are IDENTICAL (both 0xDD), and RSRC2/NUM_THREAD_X
    # read 0 while agnos demonstrably writes 0x0C/64 on every dispatch. They are consumed by the CP at
    # dispatch time; GRBM selection does not change that. So this probe REPORTS, it does not gate — asserting
    # on values the hardware does not retain would be a permanently red light that means nothing.
    #
    # The question this probe was built to answer — "is a stale scratch ring live, so a spilling kernel would
    # corrupt memory?" — MOVES TO BUILD TIME, where the answer is stronger: kernels are authored in .s and
    # sized from `.amdhsa_next_free_vgpr` in the reference .s. We GUARANTEE no
    # spilling by construction instead of hoping to observe its absence through a register we cannot read.
    # The one value here that IS trustworthy is l2cntl — VM_L2_CNTL is a GC global, not context state.
    if ((l2 & GPU_VM_L2_ENABLE_CACHE) == 0) {
        kprintln("gpu: shader state L2 CACHE OFF (compute datapath gated)", 55);
        return 0;
    }
    kprintln("gpu: shader state reported (SH regs not readable; L2 on)", 56);
    return 1;
}
# ── D0 (1.56.x, D lane) — READ-ONLY DCN MPC / HUBPRET probe. Anchors the blender's register base BEFORE any
# write, exactly the discipline P4 had to learn the hard way. The point is not the values themselves but the
# CONSTRAINT GATE: several independent registers must simultaneously agree with what a single-plane, pipe-0
# scanout MUST look like. Positive constraints (the live blender) plus negative controls (the five unused
# MPCC instances) cannot all agree by accident — so agreement anchors the base, and ANY disagreement means
# the offsets are wrong and D1/D2 must not proceed.
# ⚠ Reads are progressive and each group prints before the next, so if a read into a gated clock domain hangs
# the bus, the LAST CONSOLE LINE localises it (klug would be lost in a hang; the screen would not).
fn gpu_mpc_probe() {
    if (gpu_present == 0) { return 0; }
    if (gpu_display_ok != 1) { kprintln("gpu: mpc probe skipped (no pipe)", 32); return 0; }

    var top = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_TOP_SEL)  & 0xFFFFFFFF;
    var bot = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_BOT_SEL)  & 0xFFFFFFFF;
    var opp = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_OPP_ID)   & 0xFFFFFFFF;
    kprint("gpu: mpc mpcc0 top ", 19); kprint_num(top);
    kprint(" bot ", 5);                kprint_num(bot);
    kprint(" opp ", 5);                kprint_num(opp);
    kprintln("", 0);

    var ctl = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_CONTROL) & 0xFFFFFFFF;
    var sta = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_STATUS)  & 0xFFFFFFFF;
    var mux = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPC_OUT0_MUX)  & 0xFFFFFFFF;
    kprint("gpu: mpc mpcc0 control ", 23); kprint_num(ctl);
    kprint(" status ", 8);                 kprint_num(sta);
    kprint(" out0mux ", 9);                kprint_num(mux);
    kprintln("", 0);

    var ret = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBPRET0_CONTROL) & 0xFFFFFFFF;
    var unf = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW)  & 0xFFFFFFFF;
    kprint("gpu: mpc hubpret0 ", 18); kprint_num(ret);
    kprint(" underflow ", 11);        kprint_num((unf >> 10) & 0x1);
    kprintln("", 0);

    # Other MPCC instances, REPORTED not asserted. Burn 1's gate demanded all of MPCC1..5 read 0xF and failed
    # 0-of-5 — but 0xF is a SENTINEL the Linux driver writes in mpc1_mpc_init, NOT a power-on value, so a
    # GOP-initialised pipe has no reason to show it. Renoir/Cezanne also has num_opp = 4, not 6 (the 6 in
    # amdgpu's dcn21_mpc_create is a Navi10 copy-paste that dcn30 fixed), so MPCC4/5 are meaningless here.
    var i = 1;
    while (i < 4) {
        var t = gpu_reg32(GPU_BASE_DCN_2, GPU_R_MPCC0_TOP_SEL + i * GPU_DCN_MPCC_STRIDE) & 0xF;
        kprint("gpu: mpc mpcc", 13); kprint_num(i);
        kprint(" top ", 5);          kprint_num(t);
        kprintln("", 0);
        i = i + 1;
    }

    # THE GATE — six independent constraints for a single-plane pipe-0 scanout.
    # THE GATE, corrected. Burn 1 failed on two constraints that were MY errors, not hardware disagreement:
    #   · `bot == 0xF` — this "correction" was ITSELF WRONG, and the D-lane burns paid for it.
    #     dcn10_mpc.c:215 writes BOT_SEL = 0xF for nothing-below; it does NOT write self. The observed
    #     bot == 0 is an UNPROGRAMMED DON'T-CARE, because the GOP leaves MPCC_MODE = 1 (passthrough) where
    #     the bottom mux is irrelevant. So this row asserts almost nothing: top==0 / bot==top / mux==0 are
    #     all satisfiable by power-on values (the ascending self-index ladder mpcc0 top 0 / mpcc1 top 1 ...).
    #     Treat "5 of 5 constraints agree" as ~1 informative constraint, not five.
    #   · `idle == 5` — WRONG. 0xF is a sentinel mpc1_mpc_init writes; it is not a POR value.
    # What remains are constraints a single-plane pipe-0 scanout genuinely must satisfy.
    var ok = 1;
    if ((top & 0xF) != 0) { ok = 0; }                      # DPP0 feeds the blender
    if ((opp & 0xF) != 0) { ok = 0; }                      # ...and it drives OPP0
    if ((bot & 0xF) != (top & 0xF)) { ok = 0; }            # bot_sel == self ⇒ nothing below (single plane)
    if ((mux & 0xF) != 0) { ok = 0; }                      # MPCC0 drives output 0
    if ((sta & 0x4) != 0) { ok = 0; }                      # MPCC_DISABLED[2] must be clear on the live pipe
    if (ok == 1) {
        kprintln("gpu: mpc probe ok (5 of 5 constraints agree, base anchored)", 59);
        return 1;
    }
    kprintln("gpu: mpc probe DISAGREES (offsets unproven, D1/D2 blocked)", 58);
    return 0;
}
# blend_premul — iron-proven gfx90c ISA. Human-readable reference: kernel/shaders/blend_premul.s (documentation only).
# ⚠ These bytes ARE the shader — iron-proven on archaemenid, committed hex, the authority. AGNOS ships
#   no assembler and its build requires no llvm and no C/C++. The sovereign gfx90c assembler in the
#   ecosystem is mabda's Cyrius gfx9 encoder (mabda/src/gfx9_encode.cyr, HW-proven on Cezanne).
