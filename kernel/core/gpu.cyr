# grad_ref_px — integer reference for the gradient, in the standard lerp form
#   sc = (c0*(den-y) + c1*y + den/2) / den
# which keeps every intermediate NON-NEGATIVE. The obvious `c0 + (c1-c0)*y/den` form has a negative
# numerator whenever the gradient descends, and Cyrius integer division truncates toward zero — so it would
# round the descending half in the opposite direction from the ascending half. That asymmetry is exactly
# the kind of bug a tolerance-based test hides.
fn grad_ref_px(c0, c1, y, den, dst) {
    var a0 = (c0 >> 24) & 0xFF;
    var a1 = (c1 >> 24) & 0xFF;
    var sa = (a0 * (den - y) + a1 * y + den / 2) / den;
    var ia = 255 - sa;
    var out = 0;
    var ch = 0;
    while (ch < 4) {
        var sh = ch * 8;
        var e0 = (c0 >> sh) & 0xFF;
        var e1 = (c1 >> sh) & 0xFF;
        var sc = (e0 * (den - y) + e1 * y + den / 2) / den;
        var dc = (dst >> sh) & 0xFF;
        var q = (sc * 255 + dc * ia + 127) / 255;
        if (q > 255) { q = 255; }
        out = out | (q << sh);
        ch = ch + 1;
    }
    return out;
}

# gpu_shader_grad_test — S9: vertical linear gradient, generated with NO source buffer, composited src-over.
#
# Both endpoint colours are SGPRs and the varying quantity is the row index the SPI already provides, so a
# full-screen gradient reads ZERO source bytes. On the CPU this is the worst primitive of the set: per-pixel
# interpolate AND per-pixel blend, with no memcpy-shaped loop to lean on.
#
# The ramp runs opaque magenta -> fully transparent over a dark/light split underlay, so BOTH ramps are
# visible at once: the colour fading and the underlay returning. A gradient that lerped straight-alpha
# instead of premultiplied colour would darken through the middle — visible against the light half.
#
# ⚠ Row 0 is asserted BIT-EXACT (t is exactly 0.0 and alpha0 is 255, so the row must be exactly C0).
# Elsewhere the bound is 2, not blend_cov's 1, because t comes from v_rcp_f32 — a hardware reciprocal
# APPROXIMATION, since GFX9 has neither an integer divide nor an exact f32 divide. The observed maximum is
# reported so the looser bound stays a measured fact rather than a convenient one.
fn gpu_shader_grad_test() {
    if (gpu_present == 0) { return 0; }
    if (gpu_matmul_ok != 1) { kprintln("gpu: skipping gradient (dispatch envelope unproven)", 51); return 0; }
    if (gpu_blit_arm() != 1) { kprintln("gpu: skipping gradient (no back buffer)", 39); return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    var pitch = gpu_bb_pitch;
    if (pitch < (GPU_GRD_X + GPU_GRD_W) * 4) { kprintln("gpu: skipping gradient (surface too narrow)", 43); return 0; }

    var bb_phys = gpu_bb_a_phys;
    var bb_mc   = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { bb_phys = gpu_bb_b_phys; bb_mc = gpu_bb_b_mc; }

    var sh_phys = gpu_arena_phys + GPU_GRAD_SHADER_SUBOFF;
    var sh_mc   = gpu_arena_mc   + GPU_GRAD_SHADER_SUBOFF;
    var dn_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;
    var dn_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    grad_linear_write(sh_phys);

    var half = GPU_GRD_W / 2;
    var g_mc   = bb_mc   + GPU_GRD_Y * pitch + GPU_GRD_X * 4;
    var g_phys = bb_phys + GPU_GRD_Y * pitch + GPU_GRD_X * 4;
    if (gpu_cp_dma_fill_rect(g_mc, pitch, GPU_GRD_L, half * 4, GPU_GRD_H) != 1) {
        kprintln("gpu: gradient underlay fill failed", 34); return 0;
    }
    if (gpu_cp_dma_fill_rect(g_mc + half * 4, pitch, GPU_GRD_R, half * 4, GPU_GRD_H) != 1) {
        kprintln("gpu: gradient underlay fill failed", 34); return 0;
    }

    var gx = (GPU_GRD_W + 63) / 64;
    if (gpu_grid7_run(sh_mc,
    g_mc & 0xFFFFFFFF, (g_mc >> 32) & 0xFFFFFFFF,
    pitch, GPU_GRD_W, GPU_GRD_H, GPU_GRD_C0, GPU_GRD_C1,
    GPU_COMPUTE_PGM_RSRC1_GRAD, gx, GPU_GRD_H, dn_mc, dn_phys) != 1) {
        kprintln("gpu: gradient dispatch did not complete", 39);
        return 0;
    }

    var den = GPU_GRD_H - 1;
    var row0_bad = 0; var maxdev = 0; var bx = 0; var by = 0;
    var vy = 0;
    while (vy < GPU_GRD_H) {
        var vx = 0;
        while (vx < GPU_GRD_W) {
            var od = GPU_GRD_L;
            if (vx >= half) { od = GPU_GRD_R; }
            var got = load32(g_phys + vy * pitch + (vx << 2)) & 0xFFFFFFFF;
            var ref = grad_ref_px(GPU_GRD_C0, GPU_GRD_C1, vy, den, od) & 0xFFFFFFFF;
            if (got != ref) {
                if (vy == 0) { if (row0_bad == 0) { bx = vx; by = vy; } row0_bad = row0_bad + 1; }
                var ch = 0;
                while (ch < 4) {
                    var sh8 = ch * 8;
                    var d = ((got >> sh8) & 0xFF) - ((ref >> sh8) & 0xFF);
                    if (d < 0) { d = 0 - d; }
                    if (d > maxdev) { maxdev = d; }
                    ch = ch + 1;
                }
            }
            vx = vx + 1;
        }
        vy = vy + 1;
    }
    if (row0_bad != 0) {
        kprint("gpu: gradient ROW 0 NOT EXACT ", 30); kprint_num(row0_bad);
        kprint(" px, first at x=", 16); kprint_num(bx);
        kprintln("", 0);
        return 0;
    }
    if (maxdev > 2) {
        kprint("gpu: gradient DEVIATION too large, max ", 39); kprint_num(maxdev);
        kprintln("", 0);
        return 0;
    }

    var prev_back = gpu_bb_back;
    gpu_blit_present(0);
    var dh = 0;
    while (dh < 30000) { gpu_udelay(100); dh = dh + 1; }
    var slo = GPU_R_HUBP_SURF_ADDR    + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    var shi = GPU_R_HUBP_SURF_ADDR_HI + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    gpu_reg32_write(GPU_BASE_DCN_2, shi, (gpu_display_surf >> 32) & 0xFFFF);
    gpu_reg32_write(GPU_BASE_DCN_2, slo, gpu_display_surf & 0xFFFFFFFF);
    gpu_mfence();
    gpu_display_wait_vblank(gpu_display_pipe);
    gpu_bb_back = prev_back;

    gpu_grad_ok = 1;
    kprint("gpu: shader gradient online (row 0 exact, max dev ", 50); kprint_num(maxdev);
    kprintln(")", 1);
    return 1;
}

# gpu_glyph_arm / gpu_glyph_surface — the #94 runtime path. Same lazy-upload, own-slot discipline as
# gpu_blend_arm / gpu_cov_arm.
fn gpu_glyph_arm() {
    if (gpu_glyph_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    glyph_1bpp_write(gpu_arena_phys + GPU_GLYPH_SHADER_SUBOFF);
    gpu_mfence();
    gpu_glyph_armed = 1;
    return 1;
}

fn gpu_glyph_surface(bmp_mc, w, h, dx, dy, color) {
    if (gpu_glyph_arm() != 1) { return 0; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var dst_mc = tgt + dy * gpu_bb_pitch + dx * 4;
    var gx = (w + 63) / 64;
    var stride = (w + 7) / 8;                      # 1bpp: 8 px per byte, rows byte-aligned
    return gpu_blend_cov_run(gpu_arena_mc + GPU_GLYPH_SHADER_SUBOFF, bmp_mc, dst_mc,
    stride, gpu_bb_pitch, w, color, GPU_COMPUTE_PGM_RSRC1_GLYPH, gx, h,
    gpu_arena_mc + GPU_BLEND_DONE_SUBOFF,
    gpu_arena_phys + GPU_BLEND_DONE_SUBOFF);
}

# gpu_shader_glyph_test — S8: expand a 1bpp bitmap to 32bpp with a transparent background.
#
# The bitmap is composed from kashi's real CP437 8x16 font, so the on-screen result is READABLE TEXT. That
# is deliberate and not decoration: the failure mode this kernel is most prone to — reading the bit order
# LSB-first instead of MSB-first — mirrors every glyph horizontally. A numeric test would still pass if the
# reference made the same mistake; mirrored words do not survive a glance.
#
# ⚠ This test asserts BIT-EXACTNESS with no tolerance, unlike the coverage test. There is no arithmetic on
# colour here: a pixel either becomes the colour or is untouched. Any deviation at all is a real bug.
fn gpu_shader_glyph_test() {
    if (gpu_present == 0) { return 0; }
    if (gpu_matmul_ok != 1) { kprintln("gpu: skipping glyph (dispatch envelope unproven)", 48); return 0; }
    if (gpu_blit_arm() != 1) { kprintln("gpu: skipping glyph (no back buffer)", 36); return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    var pitch = gpu_bb_pitch;
    if (pitch < (GPU_GLY_X + GPU_GLY_W) * 4) { kprintln("gpu: skipping glyph (surface too narrow)", 40); return 0; }

    var bb_phys = gpu_bb_a_phys;
    var bb_mc   = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { bb_phys = gpu_bb_b_phys; bb_mc = gpu_bb_b_mc; }

    var sh_phys = gpu_arena_phys + GPU_GLYPH_SHADER_SUBOFF;
    var sh_mc   = gpu_arena_mc   + GPU_GLYPH_SHADER_SUBOFF;
    var bm_phys = gpu_arena_phys + GPU_GLYPH_BMP_SUBOFF;
    var bm_mc   = gpu_arena_mc   + GPU_GLYPH_BMP_SUBOFF;
    var dn_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;
    var dn_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    glyph_1bpp_write(sh_phys);

    # Compose the 1bpp bitmap straight out of kashi's font: one row byte per character per scanline, so a
    # 16-character line is exactly 16 bytes per row — 4 store32s, no bit shuffling at all. The font's
    # native layout IS the kernel's input format, which is the whole point of a 1bpp path.
    var msg = "AGNOS SHADER GPU";
    var r = 0;
    while (r < GPU_GLY_H) {
        var d = 0;
        while (d < 4) {
            var word = 0;
            var k = 0;
            while (k < 4) {
                var ch = load8(msg + d * 4 + k);
                word = word | ((kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, r) & 0xFF) << (k * 8));
                k = k + 1;
            }
            store32(bm_phys + r * GPU_GLY_STRIDE + d * 4, word);
            d = d + 1;
        }
        r = r + 1;
    }
    gpu_mfence();

    var t_mc   = bb_mc   + GPU_GLY_Y * pitch + GPU_GLY_X * 4;
    var t_phys = bb_phys + GPU_GLY_Y * pitch + GPU_GLY_X * 4;
    if (gpu_cp_dma_fill_rect(t_mc, pitch, GPU_GLY_BG, GPU_GLY_W * 4, GPU_GLY_H) != 1) {
        kprintln("gpu: glyph underlay fill failed", 31); return 0;
    }
    var gx = (GPU_GLY_W + 63) / 64;
    if (gpu_blend_cov_run(sh_mc, bm_mc, t_mc, GPU_GLY_STRIDE, pitch, GPU_GLY_W, GPU_GLY_FG,
    GPU_COMPUTE_PGM_RSRC1_GLYPH, gx, GPU_GLY_H, dn_mc, dn_phys) != 1) {
        kprintln("gpu: glyph dispatch did not complete", 36);
        return 0;
    }

    # Verify exactly. `lit` counts pixels that were actually SET — a kernel whose EXEC mask killed every
    # lane would leave the underlay everywhere and still match on the background pixels, so "no mismatches"
    # alone is not evidence the glyphs drew (the 1.54.17-19 lesson, in its bitmap form).
    var bad = 0; var lit = 0; var bx = 0; var by = 0;
    var vy = 0;
    while (vy < GPU_GLY_H) {
        var vx = 0;
        while (vx < GPU_GLY_W) {
            var byt = load8(bm_phys + vy * GPU_GLY_STRIDE + (vx >> 3)) & 0xFF;
            var bit = (byt >> (7 - (vx & 7))) & 1;
            var want = GPU_GLY_BG;
            if (bit == 1) { want = GPU_GLY_FG; lit = lit + 1; }
            var got = load32(t_phys + vy * pitch + (vx << 2)) & 0xFFFFFFFF;
            if (got != (want & 0xFFFFFFFF)) {
                if (bad == 0) { bx = vx; by = vy; }
                bad = bad + 1;
            }
            vx = vx + 1;
        }
        vy = vy + 1;
    }
    if (bad != 0) {
        kprint("gpu: glyph MISMATCH ", 20); kprint_num(bad);
        kprint(" px, first at x=", 16); kprint_num(bx);
        kprint(" y=", 3); kprint_num(by);
        kprintln("", 0);
        return 0;
    }
    if (lit < 1) { kprintln("gpu: glyph NO PIXELS SET (empty font or exec mask?)", 51); return 0; }

    var prev_back = gpu_bb_back;
    gpu_blit_present(0);
    var dh = 0;
    while (dh < 30000) { gpu_udelay(100); dh = dh + 1; }
    var slo = GPU_R_HUBP_SURF_ADDR    + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    var shi = GPU_R_HUBP_SURF_ADDR_HI + gpu_display_pipe * GPU_DCN_HUBP_STRIDE;
    gpu_reg32_write(GPU_BASE_DCN_2, shi, (gpu_display_surf >> 32) & 0xFFFF);
    gpu_reg32_write(GPU_BASE_DCN_2, slo, gpu_display_surf & 0xFFFFFFFF);
    gpu_mfence();
    gpu_display_wait_vblank(gpu_display_pipe);
    gpu_bb_back = prev_back;

    gpu_glyph_ok = 1;
    kprint("gpu: shader glyph expand online (1bpp text, bit-exact, ", 55); kprint_num(lit);
    kprintln(" px set)", 8);
    return 1;
}

# gpu_cov_arm — make blend_cov resident for the RUNTIME (#93) path. Idempotent; own arena slot, so #93
# works in a kernel built without SHADER_COV and depends on no boot-time ordering. Peer of gpu_blend_arm.

# ============================================================================================
# ATTRIBUTE INTERPOLATION — the CPU prologue and residency (3D arc rung 11)
# ============================================================================================
var gpu_tri_armed = 0;

fn gpu_tri_arm() {
    if (gpu_tri_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    tri_rgba_write(gpu_arena_phys + GPU_TRI_SHADER_SUBOFF);
    gpu_mfence();
    gpu_tri_armed = 1;
    return 1;
}

# tri_u32 / tri_clz32 / tri_recip32 — the integer-divide primitives the prologue needs.
#
# ⛔ THESE ARE A SECOND COPY, AND THAT IS A KNOWN, WATCHED SEAM. The identical routines live in
# tests/gpu/refraster.cyr, shared by the reference and the shader model. The kernel cannot include a
# host tool, so the code exists twice — and Cyrius shadows duplicate `fn`s SILENTLY, so nothing here
# would complain if the two drifted.
# ⚠ WHAT WATCHES IT: the prep-record diff. The kernel prints the 128-byte record it computed and
# /bin/gputri prints the record IT computed from the same inputs in the same boot; a divergence in
# either copy shows up as a differing field. That diff is the ONLY thing standing between these two
# implementations, so it must never be weakened into a kernel read-back of its own write — that is
# echo, not answer.
fn tri_u32(x) { return x & 0xFFFFFFFF; }

fn tri_clz32(x) {
    if (x == 0) { return 32; }
    var v = tri_u32(x);
    var n = 0;
    while ((v & 0x80000000) == 0) { v = tri_u32(v << 1); n = n + 1; }
    return n;
}

# V = floor((2^63 - 1) / dp) by a 32-iteration integer RESTORING division. Exact BY CONSTRUCTION.
# ⛔ NO v_rcp_f32 ANYWHERE. The float reciprocal is an APPROXIMATION the ISA is allowed to perturb by
# an ULP, and op 0x04 already demonstrates the consequence: its own self-test tolerates a deviation
# of 2. Hoisted once per record, this loop costs nothing amortised.
fn tri_recip32(dp) {
    var r = 0x7FFFFFFF;
    var v = 0;
    var k = 0;
    while (k < 32) {
        var top = (r >> 31) & 1;
        r = tri_u32(tri_u32(r << 1) | 1);
        var ge = 0;
        if (top == 1) { ge = 1; }
        if (top != 1) { if (r >= dp) { ge = 1; } }
        if (ge == 1) { r = tri_u32(r - dp); }
        v = tri_u32(tri_u32(v << 1) | ge);
        k = k + 1;
    }
    return v;
}

fn tri_bitlen64(x) {
    var n = 0;
    var v = x;
    while (v != 0) { v = v >> 1; n = n + 1; }
    return n;
}

# gpu_tri_prep — build the 128-byte TRI-PREP record the shader reads.
#
# Vertices arrive in 16.16 (the #92 record's units). ⚠ THE CROSS PRODUCT IS TAKEN IN PIXELS and only
# 2A and the constant terms carry the << 16, because kx/ky already multiply a 16.16 sample point.
# Cross-multiplying two 16.16 values would put 2A at cross << 32 and every derived bound off by 2^16.
# Returns 1, or 0 if the frame is degenerate (the validator should already have refused it).
fn gpu_tri_prep(rec_phys, cov_mc, vx0, vy0, vx1, vy1, vx2, vy2, ca, cb, cc) {
    var ax = vx0 >>> 16;  var ay = vy0 >>> 16;
    var bx = vx1 >>> 16;  var by = vy1 >>> 16;
    var cx = vx2 >>> 16;  var cy = vy2 >>> 16;

    var cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
    if (cross == 0) { return 0; }
    var sgn = 1;
    if (cross < 0) { sgn = 0 - 1; cross = 0 - cross; }
    var a2 = cross << 16;

    var kxb = sgn * (cy - ay);
    var kyb = sgn * (ax - cx);
    var k0b = sgn * ((ay * cx - ax * cy) << 16);
    var kxc = sgn * (ay - by);
    var kyc = sgn * (bx - ax);
    var k0c = sgn * ((ax * by - ay * bx) << 16);

    var d255 = 255 * a2;
    var t = tri_bitlen64(d255) - 30;
    if (t < 0) { t = 0; }                        # d255 already fits 30 bits: nothing to normalise
    var dh = (d255 >> t) + 1;                    # +1 makes the shader's correction ONE-SIDED
    var l = tri_clz32(dh);
    var dn = tri_u32(dh << l);
    if (dn < 2147483648) { return 0; }           # outside recip32's domain -- refuse, never guess
    var v = tri_recip32(dn);

    var q = 0;
    while (q < 32) { store32(rec_phys + q * 4, 0); q = q + 1; }   # Q6/Q7 stay ZERO: the extension point

    store32(rec_phys +  0, cov_mc & 0xFFFFFFFF);
    store32(rec_phys +  4, (cov_mc >> 32) & 0xFFFFFFFF);
    store32(rec_phys +  8, t);
    store32(rec_phys + 12, 32 - t);
    store32(rec_phys + 16, dh);
    store32(rec_phys + 20, v);
    store32(rec_phys + 24, l);
    store32(rec_phys + 32, a2 & 0xFFFFFFFF);
    store32(rec_phys + 36, (a2 >> 32) & 0xFFFFFFFF);
    store32(rec_phys + 40, d255 & 0xFFFFFFFF);
    store32(rec_phys + 44, (d255 >> 32) & 0xFFFFFFFF);
    store32(rec_phys + 48, kxb & 0xFFFFFFFF);
    store32(rec_phys + 52, kyb & 0xFFFFFFFF);
    store32(rec_phys + 56, k0b & 0xFFFFFFFF);
    store32(rec_phys + 60, (k0b >> 32) & 0xFFFFFFFF);
    store32(rec_phys + 64, kxc & 0xFFFFFFFF);
    store32(rec_phys + 68, kyc & 0xFFFFFFFF);
    store32(rec_phys + 72, k0c & 0xFFFFFFFF);
    store32(rec_phys + 76, (k0c >> 32) & 0xFFFFFFFF);
    store32(rec_phys + 80, ca & 0xFFFFFFFF);
    store32(rec_phys + 84, cb & 0xFFFFFFFF);
    store32(rec_phys + 88, cc & 0xFFFFFFFF);
    gpu_mfence();
    return 1;
}

# Print the record so it can be diffed against the ring-3 tool's own computation of the same thing.
# ⚠ NOT A READ-BACK ORACLE. This prints what the kernel COMPUTED so an independently-computed record
# can contradict it. A kernel that read back its own store and declared agreement would be echoing.
fn gpu_tri_prep_dump(rec_phys) {
    kprint("tri-prep:", 9);
    var i = 0;
    while (i < 23) {
        kprint(" ", 1);
        kprint_num(load32(rec_phys + i * 4) & 0xFFFFFFFF);
        i = i + 1;
    }
    kprintln("", 0);
    return 0;
}



# gpu_tri_dispatch — issue the interpolation pass through the SHIPPED dispatcher, unmodified.
#
# ⭐ NO NEW DISPATCH PATH. gpu_blend_cov_run's eight USER_DATA dwords land on exactly the SGPRs
# tri_rgba expects, so the shipped envelope carries this kernel with no PM4 edit. That is the
# concrete payoff of RSRC2 being byte-identical (0x190) — it was harvested from the assembled
# descriptor rather than hoped for.
#
# ⚠ THE PARAMETER NAMES LIE, AND THE MAPPING IS WRITTEN OUT SO NOBODY HAS TO INFER IT:
#     gpu_blend_cov_run arg     SGPR      tri_rgba reads it as
#     mask_mc                   s[0:1]    the TRI-PREP record pointer
#     dst_mc                    s[2:3]    the back-buffer base
#     mask_pitch                s4        the destination pitch in BYTES
#     dst_pitch                 s5        unused
#     width                     s6        w
#     color                     s7        h
# Renaming the shared function's parameters to suit one caller would be worse: they are correct for
# the coverage kernel that has shipped for releases, and this comment costs nothing.
fn gpu_tri_dispatch(rec_phys, w, h, dx, dy) {
    var rec_mc    = gpu_arena_mc + GPU_TRI_PREP_SUBOFF;
    var shader_mc = gpu_arena_mc + GPU_TRI_SHADER_SUBOFF;
    var done_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    var done_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;

    # ⚠ THE BACK BUFFER IS WHICHEVER OF THE PAIR IS NOT ON SCREEN. gpu_cov_surface picks it the
    # same way; writing to gpu_bb_a_mc unconditionally would draw into the FRONT buffer half the
    # time and produce a tear that looks like a raster bug.
    if (gpu_blit_arm() != 1) { return 0; }
    var bb_mc = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { bb_mc = gpu_bb_b_mc; }
    var pitch = gpu_bb_pitch;
    if (pitch == 0) { return 0; }
    var dst_mc = bb_mc + dy * pitch + dx * 4;

    # One workgroup of 64 lanes per 64 pixels of width, one row per workgroup in y.
    var gx = (w + 63) / 64;
    var gy = h;

    var r1 = GPU_COMPUTE_PGM_RSRC1_TRI;
    return gpu_blend_cov_run(shader_mc, rec_mc, dst_mc, pitch, 0, w, h, r1, gx, gy, done_mc, done_phys);
}


# gpu_tri_list — draw N triangles from one vertex slot into one destination rect.
#
# ⭐ THE BATCH WIN IS AT THE ABI AND THE VALIDATOR, NOT YET AT THE DISPATCH. One record, one
# validation pass over the whole batch, one arming check, one present. The per-triangle loop below
# still issues a coverage pass and an interpolation pass each, which is honest: fusing N triangles
# into a single dispatch needs the shader to walk a triangle list, and that is a separate change.
# Stated here rather than implied so nobody reads "batched" as "one dispatch" before it is.
#
# ⛔ THE WHOLE BATCH IS VALIDATED BEFORE THIS RUNS. gpo_validate_trilist checks every triangle, so a
# mid-batch refusal is impossible and the framebuffer can never be left half-drawn by a reject.
# ⚠ Caller owns bounds checking. Returns 1 / 0.
# tex_rgba_write — the RUNG 13 texturing blob, 442 dwords, emitted by scripts/check/shader-blob.sh from
# kernel/shaders/tex_rgba.s. ⚠ NEVER hand-edit: `sh scripts/check/shader-blob.sh check kernel/shaders/
# tex_rgba.s tex_rgba` diffs this table against the assembled source and is the gate that stops the
# table and the .s drifting apart silently.
# RSRC1 = 0x00AC0207 (32 VGPRs, 72 SGPRs) · RSRC2 = 0x00000190 — byte-identical to the coverage
# kernel's, which is what lets the shipped dispatcher issue this blob with no PM4 change.
# tex_list_write — RUNG 14's fused-list blob, 458 dwords.
#
# ⛔ GENERATED, NEVER HAND-EDITED. `sh scripts/check/shader-blob.sh check kernel/shaders/tex_list.s
# tex_list` re-assembles the source and diffs it against this table; check.sh runs it every build.
# A dword edited here to "fix" something on iron would pass no gate and fail as a wedged queue.
#
# ⭐ THE THREE NUMBERS, CORRECTED 1.56.24 — they were conflated, and the conflation hid which one the
# gate actually proves. `sh scripts/check/texl-body-identity.sh` prints all three:
#     tex_rgba = 442 dwords total  =  25-dword prologue + 417 SHARED
#     tex_list = 458 dwords total  =  41-dword prologue + 417 SHARED
# So the shared, character-identical body is **417**, and the 16-dword total delta is the difference
# between the two PROLOGUES (41 − 25), not a "16-instruction prologue bolted onto 442". Three comments
# in this tree called the shared body "442" — it is tex_rgba's TOTAL, which happens to be a number the
# gate never asserts. Quote 417 when you mean the gated body and 442/458 only for whole-blob sizes.
fn tex_list_write(dst_phys) {
    store32(dst_phys + 0,    0xbefe01c1);
    store32(dst_phys + 4,    0x8f0e0608);
    store32(dst_phys + 8,    0x8e0f060e);
    store32(dst_phys + 12,   0x808f0f08);
    store32(dst_phys + 16,   0x920aff0e);
    store32(dst_phys + 20,   0x000000a0);
    store32(dst_phys + 24,   0x80000a00);
    store32(dst_phys + 28,   0x82018001);
    store32(dst_phys + 32,   0xc00a0600);
    store32(dst_phys + 36,   0x00000000);
    store32(dst_phys + 40,   0xc00a0700);
    store32(dst_phys + 44,   0x00000010);
    store32(dst_phys + 48,   0xc00a0800);
    store32(dst_phys + 52,   0x00000020);
    store32(dst_phys + 56,   0xc00a0900);
    store32(dst_phys + 60,   0x00000030);
    store32(dst_phys + 64,   0xc00a0a00);
    store32(dst_phys + 68,   0x00000040);
    store32(dst_phys + 72,   0xc00a0b00);
    store32(dst_phys + 76,   0x00000050);
    store32(dst_phys + 80,   0xc00a0c00);
    store32(dst_phys + 84,   0x00000060);
    store32(dst_phys + 88,   0xc00a0d00);
    store32(dst_phys + 92,   0x00000070);
    store32(dst_phys + 96,   0xc00a0e00);
    store32(dst_phys + 100,  0x00000080);
    store32(dst_phys + 104,  0xc00a0400);
    store32(dst_phys + 108,  0x00000090);
    store32(dst_phys + 112,  0xbf8cc07f);
    store32(dst_phys + 116,  0x8606ff11);
    store32(dst_phys + 120,  0x0000ffff);
    store32(dst_phys + 124,  0x8f079011);
    store32(dst_phys + 128,  0xbf090709);
    store32(dst_phys + 132,  0xbf8501a7);
    store32(dst_phys + 136,  0x8e0a860f);
    store32(dst_phys + 140,  0x6802000a);
    store32(dst_phys + 144,  0x7d980206);
    store32(dst_phys + 148,  0xbe94206a);
    store32(dst_phys + 152,  0xbf8801a2);
    store32(dst_phys + 156,  0x80021002);
    store32(dst_phys + 160,  0x82038003);
    store32(dst_phys + 164,  0x860d821f);
    store32(dst_phys + 168,  0xbf06820d);
    store32(dst_phys + 172,  0xbf85000e);
    store32(dst_phys + 176,  0x920b0609);
    store32(dst_phys + 180,  0x680e020b);
    store32(dst_phys + 184,  0x7e1c0218);
    store32(dst_phys + 188,  0x7e1e0219);
    store32(dst_phys + 192,  0x321c0f0e);
    store32(dst_phys + 196,  0xd11c6a0f);
    store32(dst_phys + 200,  0x01a9010f);
    store32(dst_phys + 204,  0xdc408000);
    store32(dst_phys + 208,  0x047f000e);
    store32(dst_phys + 212,  0xbf8c0f70);
    store32(dst_phys + 216,  0x7d9a0880);
    store32(dst_phys + 220,  0xbe96206a);
    store32(dst_phys + 224,  0xbf880190);
    store32(dst_phys + 228,  0xbf820002);
    store32(dst_phys + 232,  0x7e0802ff);
    store32(dst_phys + 236,  0x000000ff);
    store32(dst_phys + 240,  0x240a0290);
    store32(dst_phys + 244,  0x680a0aff);
    store32(dst_phys + 248,  0x00008000);
    store32(dst_phys + 252,  0x8e0c9009);
    store32(dst_phys + 256,  0x810cff0c);
    store32(dst_phys + 260,  0x00008000);
    store32(dst_phys + 264,  0x7e0c020c);
    store32(dst_phys + 268,  0xd2850008);
    store32(dst_phys + 272,  0x00020a24);
    store32(dst_phys + 276,  0xd2860009);
    store32(dst_phys + 280,  0x00020a24);
    store32(dst_phys + 284,  0x900d9f24);
