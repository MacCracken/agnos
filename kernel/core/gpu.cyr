    store32(dst_phys + 340,  0x261c1c25);
    store32(dst_phys + 344,  0x6a161d0b);
    store32(dst_phys + 348,  0x32101508);
    store32(dst_phys + 352,  0x38121709);
    store32(dst_phys + 356,  0x7e1c0226);
    store32(dst_phys + 360,  0x7e1e0227);
    store32(dst_phys + 364,  0x32101d08);
    store32(dst_phys + 368,  0x38121f09);
    store32(dst_phys + 372,  0xd285000a);
    store32(dst_phys + 376,  0x00020a28);
    store32(dst_phys + 380,  0xd286000b);
    store32(dst_phys + 384,  0x00020a28);
    store32(dst_phys + 388,  0x900d9f28);
    store32(dst_phys + 392,  0x261c0a0d);
    store32(dst_phys + 396,  0x6a161d0b);
    store32(dst_phys + 400,  0x221c0a9f);
    store32(dst_phys + 404,  0x261c1c28);
    store32(dst_phys + 408,  0x6a161d0b);
    store32(dst_phys + 412,  0xd285000c);
    store32(dst_phys + 416,  0x00020c29);
