    store32(dst_phys + 180, 0x0426050a);
    store32(dst_phys + 184, 0x7e142503);
    store32(dst_phys + 188, 0xd1cb0009);
    store32(dst_phys + 192, 0x0426110a);
    store32(dst_phys + 196, 0xd1dd000d);
    store32(dst_phys + 200, 0x04350309);
    store32(dst_phys + 204, 0x7e122605);
    store32(dst_phys + 208, 0x7e142606);
