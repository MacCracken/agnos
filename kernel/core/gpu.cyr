# gpu_tex_prep — RUNG 13's CPU prologue. Builds the 160-byte record the texturing shader reads.
#
# ⭐ THE MIN-BIAS AND BOTH LIMITS ARE COMPUTED HERE, NOT IN THE SHADER, and that is the whole design.
# texmodel proved that `n_madd` needs non-negative multiplicands, which the bias
# `m = min(u0,u1,u2)` guarantees via the identity E_A + E_B + E_C == 2A. Hoisting the bias, the
# three deltas and the two comparison limits onto the CPU means the per-pixel path never computes a
# minimum, never forms a 64-bit limit, and never divides — it accumulates, compares twice, funnels
# and corrects. Everything constant per triangle belongs here.
#
# ⚠ RECORD IS 160 B, TEN QUADS — larger than rung 11's 128 because UV needs two axes of deltas plus
# their limits. The layout is fixed here and the shader indexes it; a mismatch is a wrong picture
# with no pointer back, so the field offsets are written out beside the stores.
#   Q0 +0    cov_lo cov_hi t 32-t
#   Q1 +16   Dh V L fmt              (fmt: 0 = RGBA8, 1 = IDX8 + LUT)
#   Q2 +32   A2_lo A2_hi tw th
#   Q3 +48   kxB kyB k0B_lo k0B_hi
#   Q4 +64   kxC kyC k0C_lo k0C_hi
#   Q5 +80   tex_lo tex_hi lut_lo lut_hi
#   Q6 +96   du0 du1 du2 mu          (deltas already biased by mu = min(u0,u1,u2))
#   Q7 +112  dv0 dv1 dv2 mv
#   Q8 +128  limU_lo limU_hi limV_lo limV_hi
#   Q9 +144  reserved, MUST be zero  -- the extension point, as on every other record
# Returns 1 / 0.
# gpu_pack2(lo, hi) — two 32-bit record fields as ONE 64-bit store. Both halves are masked to 32 bits
# BEFORE combining: a negative field (several of these are signed) would otherwise sign-extend across
# the whole word and corrupt the neighbouring field. Used only by gpu_tex_prep's record write.
fn gpu_pack2(lo, hi) { return (lo & 0xFFFFFFFF) | ((hi & 0xFFFFFFFF) << 32); }

fn gpu_tex_prep(rec_phys, cov_mc, tex_mc, lut_mc, tw, th, fmt,
vx0, vy0, vx1, vy1, vx2, vy2, u0, v0, u1, v1, u2, v2) {
    var ax = vx0 >>> 16;  var ay = vy0 >>> 16;
    var bx = vx1 >>> 16;  var by = vy1 >>> 16;
    var cx = vx2 >>> 16;  var cy = vy2 >>> 16;

    var cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
    if (cross == 0) { return 0; }
    var sgn = 1;
    if (cross < 0) { sgn = 0 - 1; cross = 0 - cross; }
    var a2 = cross << 16;

    var kxb = sgn * (cy - ay);
    var kyb = sgn * (ax - cx);
    var k0b = sgn * ((ay * cx - ax * cy) << 16);
    var kxc = sgn * (ay - by);
    var kyc = sgn * (bx - ax);
    var k0c = sgn * ((ax * by - ay * bx) << 16);

    # ⛔ THE RECIPROCAL IS FOR 2A, NOT D255. Rung 11 divides its colour numerator by 255*2A; the UV
    # numerator is divided by 2A itself. Reusing rung 11's constants here would divide by 255x too
    # much and produce a texture compressed into its first row — a plausible picture, wrongly.
    var t = tri_bitlen64(a2) - 30;
    if (t < 0) { t = 0; }
    var dh = (a2 >> t) + 1;                      # +1 makes the shader's correction ONE-SIDED
    var l = tri_clz32(dh);
    var dn = tri_u32(dh << l);
    if (dn < 2147483648) { return 0; }           # outside recip32's domain -- refuse, never guess
    var rv = tri_recip32(dn);

    var mu = u0;
    if (u1 < mu) { mu = u1; }
    if (u2 < mu) { mu = u2; }
    var mv = v0;
    if (v1 < mv) { mv = v1; }
    if (v2 < mv) { mv = v2; }

    # u >= tw  <=>  N >= (tw*65536 - mu) * 2A, the bias folded in. A negative limit means the whole
    # axis is already past the last texel, which the shader answers directly.
    var limu = (tw * 65536 - mu) * a2;
    var limv = (th * 65536 - mv) * a2;

    # ⭐⭐ 1.56.27 — ZERO ONLY WHAT STAYS ZERO. This loop used to run `q < 40`, writing all forty words
    # and then having thirty-six of them overwritten by the stores immediately below. That was ~47% of
    # this function's entire cost, and the reason is WHERE it writes, not how much:
    #
    #   `rec_phys` is in the GPU arena, which is **UC-mapped** (uncached — see gpu_arena_phys at the top
    #   of this file and the arena setup). An uncached 32-bit store is not store-buffered; it goes to
    #   DRAM and waits. Measured on iron 2026-07-28 (cut 1.56.26): the BUILD phase costs **7.29 µs per
    #   primitive**, and this function issues **76** UC stores per primitive (40 fill + 36 explicit)
    #   ⇒ **96 ns per store**, which is exactly the right order for UC. The "22,000 cycles to prepare an
    #   affine frame" was never arithmetic — it was 76 serialised memory round-trips.
    #
    # ⛔ The explicit stores below cover words 0..35 CONTIGUOUSLY, with no gaps — so only words 36..39
    # are genuinely left zero, and those are the Q9 extension point. ⚠ They DO still need zeroing: the
    # prep table at GPU_TEXL_PREP_SUBOFF is ONE fixed 512-record region reused across calls, so a stale
    # Q9 from a previous frame would otherwise survive into this one.
    # ⚠ Safe because nothing observes the record in between: there is no call, fence or dispatch between
    # this fill and the stores, and gpu_texl_build finishes every record before gpu_tex_list dispatches.
    # ⚠ If a future field lands in words 36..39, WIDEN THIS FILL — do not assume the tail is dead.
    # ⭐⭐⭐ 1.56.28 — 64-BIT STORES: 40 UC TRANSACTIONS -> 20. The record is written with `store64`
    # pairs instead of `store32` singles. Same 160 bytes, same values, HALF the bus transactions.
    #
    # ⛔ WHY NOT THE "CACHED SCRATCH + BULK COPY" THIS WAS ORIGINALLY SCOPED AS. Building the record in
    # cached memory and `memcpy`ing it here buys NOTHING: `memcpy` (klib/kstring.cyr) copies its aligned
    # bulk with `store64`, so the destination still sees exactly these 20 UC transactions — plus an extra
    # build-and-read-back pass. **The bottleneck is the COUNT of uncached transactions, not where the
    # bytes come from.** The only way past 20 would be 128-bit stores, and the production kernel is
    # deliberately FP-free (two sanctioned XMM leaf sites), so that is not on the table. Pairing directly
    # is therefore not a cheaper version of the scratch-buffer idea — it is strictly better than it.
    #
    # ⚠ EVERY PAIR IS 8-BYTE ALIGNED because the record is 160-byte aligned and the fields are laid out
    # in 32-bit slots; pairs start at word indices 0,2,4,... If a field is ever inserted or reordered,
    # RE-CHECK THE PAIRING — a mis-paired store writes the right bytes to the wrong offsets and the
    # shader reads garbage that still looks structurally valid.
    # ⚠ Seven pairs are a single 64-bit quantity split lo/hi in the old code (cov_mc, a2, k0b, k0c,
    # tex_mc, lut_mc, limu, limv) and are now stored whole — that is exact, not an approximation.
    # Measured basis: 85.6 ns per UC store + 0.79 µs of real arithmetic (iron, 1.56.26 + 1.56.27).
    store64(rec_phys +   0, cov_mc);
    store64(rec_phys +   8, gpu_pack2(t, 32 - t));
    store64(rec_phys +  16, gpu_pack2(dh, rv));
    store64(rec_phys +  24, gpu_pack2(l, fmt));
    store64(rec_phys +  32, a2);
    store64(rec_phys +  40, gpu_pack2(tw, th));
    store64(rec_phys +  48, gpu_pack2(kxb, kyb));
    store64(rec_phys +  56, k0b);
    store64(rec_phys +  64, gpu_pack2(kxc, kyc));
    store64(rec_phys +  72, k0c);
    store64(rec_phys +  80, tex_mc);
    store64(rec_phys +  88, lut_mc);
    store64(rec_phys +  96, gpu_pack2(u0 - mu, u1 - mu));
    store64(rec_phys + 104, gpu_pack2(u2 - mu, mu));
    store64(rec_phys + 112, gpu_pack2(v0 - mv, v1 - mv));
    store64(rec_phys + 120, gpu_pack2(v2 - mv, mv));
    store64(rec_phys + 128, limu);
    store64(rec_phys + 136, limv);
    # The Q9 extension tail (words 36..39). Still zeroed for the same reason as before — the prep table
    # is one fixed region reused across calls — now as two stores instead of four.
    store64(rec_phys + 144, 0);
    store64(rec_phys + 152, 0);
    # +144/+148 stay ZERO here and are filled ONLY by the list builder — see gpu_texl_build. Op 0x0B
    # takes its origin and size from the dispatch (user data + grid), op 0x0C from the record,
    # because a fused dispatch has one grid and N origins. The zeroing loop above already cleared
    # them, so a single-primitive record cannot accidentally carry a stale list origin.
    gpu_mfence();
    return 1;
}

# ---------------------------------------------------------------------------------------------
# RUNG 14 — op 0x0C GPU_OP_TEX_LIST: N textured primitives, ONE dispatch.
#
# ⭐ WHY THIS EXISTS, measured not assumed. Rung 13 measured the dispatch chain at a FIXED 52.7 us
# regardless of size, and FULLCOV cut it to ~27.9 us by removing two of the three dispatches. A DOOM
# frame is ~640 wall columns; at one dispatch each that is 640 x 27.9 us = 17.9 ms of pure OVERHEAD
# in a 28.6 ms frame, before a single pixel is shaded. Fusing them pays the fixed cost ONCE.
#
# ⛔ AND IT MUST BE BY DISPATCH, NOT BY GEOMETRY. `tests/gpu/doomwall.cyr` measured the alternative —
# merging a run of columns into one affine quad — and refuted it: at a 1.5x depth ratio across the
# seg, 4096 of 4096 pixels differ, because ty_step = 1/depth is a hyperbola in screen x and an
# affine quad interpolates it linearly. That is exactly `rw_scale += rw_scalestep`, the swim
# cyrius-doom removed at render.cyr:1275. One quad per column stays bit-exact (doomcol: 7/7 EXACT);
# only the DISPATCH count may be collapsed.
#
# THE GRID MAPPING: gx = n_prims, gy = max(ph). Workgroup (i, y) shades primitive i, row y; lane j
# takes rect-local column j, looping j += 64 for rects wider than a wavefront. tgid_x indexes the
# record array directly, so the per-pixel cost is O(1) with no search and no requirement that the
# primitives be adjacent, uniform, or sorted.
#
# ⛔ FULLCOV IS REQUIRED (gpo_validate_texlist enforces it), and that requirement is what makes the
# op safe. Rung 12's tri-list corrupted every triangle but the last because N primitives SHARED
# three fixed arena slots while the batch was open. Here each primitive owns a 160-byte record in an
# array and there is no coverage stage to share — WITHIN ONE OP the failure mode is not guarded
# against, it is unrepresentable.
#
# ⛔⛔ AND THE SCOPE OF THAT CLAIM WAS WRONG — READ THIS BEFORE TRUSTING THE SENTENCE ABOVE.
# "Unrepresentable" holds per-op and FAILS ACROSS OPS. GPU_TEXL_PREP_SUBOFF is ONE
# fixed prep slot, so two op 0x0C records in one batched #92 array both rebuild it from the top and
# the second build overwrites records the first dispatch has not read yet — rung 12's bug at the
# op-to-op seam instead of the primitive-to-primitive one. Per-primitive records solved the inner
# sharing and did nothing for the outer. gpu_tex_list now suspends gpu_batch_active around its
# dispatch for exactly this reason; the argument for why lives there, next to the code that acts on
# it. ⚠ A DOOM frame is ~640 columns against a GPU_TEX_LIST_MAX of 512, so the workload this rung
# exists to serve is PHYSICALLY two ops — this was never going to stay theoretical.

# gpu_texl_build — fill the record array from the caller's primitive array. Returns max(ph), or 0.
# ⚠ Every field has already been validated by gpo_validate_texlist; this function does NO checking
# and must not be reached by any other path.
fn gpu_texl_build(pkva, n_prims, pitch) {
    var base = gpu_arena_phys + GPU_TEXL_PREP_SUBOFF;
    var maxh = 0;
    gpu_texl_maxw = 0;
    gpu_texl_maxh = 0;
    gpu_texl_colmajor = 0;
    # ⚠ -1 until primitive 0 sets it. The validator already refuses a mixed list, so this pass agreeing
    # with it is belt-and-braces — but the belt is load-bearing: gpo_execute reaches the dispatch with
    # no gpo_validate in front of it on at least one shipping in-tree path, and a driver that sampled
    # only primitive 0 would silently DISCARD a later primitive's flag rather than refuse.
    var lcm = 0 - 1;
    var i = 0;
    while (i < n_prims) {
        var b   = pkva + i * GPU_TEX_PRIM_BYTES;
        var rec = base + i * 160;

        var pwh = load32(b + 0) & 0xFFFFFFFF;
        var pw  = pwh & 0xFFFF;
        var ph  = (pwh >> 16) & 0xFFFF;
        var pxy = load32(b + 4) & 0xFFFFFFFF;
        var px  = pxy & 0xFFFF;
        var py  = (pxy >> 16) & 0xFFFF;
        if (ph > maxh) { maxh = ph; }
        if (pw > gpu_texl_maxw) { gpu_texl_maxw = pw; }
        if (ph > gpu_texl_maxh) { gpu_texl_maxh = ph; }

        var tid = load32(b +  8) & 0xFFFFFFFF;
        var lid = load32(b + 12) & 0xFFFFFFFF;
        var twh = load32(b + 16) & 0xFFFFFFFF;
        var pfl = load32(b + 20) & 0xFFFFFFFF;

        # rung 14b: latch the lane axis from primitive 0 and REFUSE if any successor disagrees.
        var pcm = 0;
        if ((pfl & GPU_TEX_FLAG_COLMAJOR) != 0) { pcm = 1; }
        if (lcm < 0) { lcm = pcm; gpu_texl_colmajor = pcm; }
        if (pcm != lcm) { return 0; }

        var tex_mc = gpu_shm_mc(tid);
        var lut_mc = 0;
        if (lid != 0) { lut_mc = gpu_shm_mc(lid); }
        if (tex_mc == 0) { return 0; }
        if (lid != 0) { if (lut_mc == 0) { return 0; } }

        # ⭐ RUNG 14b — THE FRAME IS EXPRESSED IN LANE-AXIS COORDINATES, so COLMAJOR must transpose it.
        # The shader multiplies its PER-LANE value by the x-coefficients and its WAVE-UNIFORM value by
        # the y-coefficients. Row-major feeds those from (px, py); col-major feeds them from (py, px).
        # Without a transpose the same record would sample a DIFFERENT texel at the same screen pixel.
        #
        # ⭐ AND IT IS NOT A NEW TRANSFORM — feeding gpu_tex_prep the vertices with x/y SWAPPED *is*
        # the transpose, so no second copy of the affine maths ships. Re-derived from the function
        # above, not assumed: cross' = -cross, hence sgn' = -sgn and a2' = |cross|<<16 is UNCHANGED;
        # kxb' = kyb, kyb' = kxb, kxc' = kyc, kyc' = kxc; k0b' and k0c' are invariant (the sign flip
        # cancels the term swap). Exactly FOUR record dwords move: +48/+52 and +64/+68.
        #
        # ⛔ The check that this is right: E_B' = kxb'*py + kyb'*px + k0b' = kxb*px + kyb*py + k0b =
        # E_B. Same edge value at the same physical pixel, so E_A = 2A - E_B - E_C is preserved and the
        # barycentric weights still pair with vertex B. The winding flip does NOT permute them.
        var tvx0 = gpo_i32(b + 24); var tvy0 = gpo_i32(b + 28);
        var tvx1 = gpo_i32(b + 32); var tvy1 = gpo_i32(b + 36);
        var tvx2 = gpo_i32(b + 40); var tvy2 = gpo_i32(b + 44);
        var sw = 0;
        if (pcm == 1) {
            sw = tvx0; tvx0 = tvy0; tvy0 = sw;
            sw = tvx1; tvx1 = tvy1; tvy1 = sw;
            sw = tvx2; tvx2 = tvy2; tvy2 = sw;
        }

        # ⚠ cov_mc is passed as 0: FULLCOV is mandatory here, so the shader never loads a mask byte.
        # Passing the real scratch address would be a live pointer to a buffer this path never
        # writes — harmless today, a stale-mask bug the moment someone relaxes the FULLCOV rule.
        #
        # ⚠ `pfl & 7` STAYS AT 7 — COLMAJOR (0x08) is deliberately NOT propagated into the record.
        # The mode selects WHICH BLOB is dispatched, not a branch inside one, so a copy of the bit
        # here would be payload no lane ever tests: the accepted-and-ignored shape the flags
        # vocabulary exists to prevent. The record's col-major-ness is carried by the transposed
        # frame above, which every lane does read.
        if (gpu_tex_prep(rec, 0, tex_mc, lut_mc, twh & 0xFFFF, (twh >> 16) & 0xFFFF, pfl & 7,
        tvx0, tvy0, tvx1, tvy1, tvx2, tvy2,
        gpo_i32(b + 48), gpo_i32(b + 52), gpo_i32(b + 56),
        gpo_i32(b + 60), gpo_i32(b + 64), gpo_i32(b + 68)) != 1) { return 0; }

        # the two list-only fields, in the record's declared spare
        # ⚠ A BYTE OFFSET from the back-buffer base, not an absolute address: the record then does
        # not encode WHICH buffer it was built for, so a front/back flip between build and dispatch
        # cannot make it point at the visible frame.
        store32(rec + 144, (py * pitch + px * 4) & 0xFFFFFFFF);
        store32(rec + 148, ((ph << 16) | pw) & 0xFFFFFFFF);
        i = i + 1;
    }
    gpu_mfence();
    return maxh;
}

fn gpu_tex_list(pkva, n_prims, uw, uh, udx, udy) {
    if (gpu_texl_arm() != 1) { return 0; }
    if (gpu_blit_arm() != 1) { return 0; }

    var pitch = gpu_bb_pitch;
    if (pitch == 0) { return 0; }
    var bb_mc = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { bb_mc = gpu_bb_b_mc; }

    var maxh = gpu_texl_build(pkva, n_prims, pitch);
    if (maxh < 1) { return 0; }

    # ⭐ RUNG 14b — THE LANE AXIS IS THE ONE tile_shift COMES FROM, and the other axis is the row
    # count. Row-major: lanes on X, so tiles from max(pw) and rows = max(ph). Col-major: lanes on Y,
    # so tiles from max(ph) and rows = max(pw). Everything downstream is axis-agnostic.
    var laxis = gpu_texl_maxw;
    var lrows = maxh;
    if (gpu_texl_colmajor == 1) { laxis = gpu_texl_maxh; lrows = gpu_texl_maxw; }

    # tile_shift = ceil(log2(ceil(lane_axis / 64))) — the shader splits tgid_x into (primitive, slice)
    # with a SHIFT, so the slice count must be a power of two. Rounding UP is what keeps the split
    # exact; a shift one too small would alias two primitives onto the same records.
    # ⚠ DOOM columns are 1 px wide, so ROW-MAJOR this is 0 and the grid is exactly n_prims — but that
    # is the trap, not the win: it also means 200 rows launch 200 waves each shading ONE lane.
    # COL-MAJOR the same column gives ceil(200/64) = 4 tiles of a 1-row grid: 4 waves, 50x fewer.
    var tiles = (laxis + 63) / 64;
    var tshift = 0;
    while ((1 << tshift) < tiles) { tshift = tshift + 1; }

    # ⛔ BOUND THE GRID *THIS FUNCTION* IS ABOUT TO LAUNCH, not the one another file predicted.
    # gpo_validate_texlist checks the same quantity, and duplicating a safety bound across two files
    # with a "keep these in step" comment is not a guarantee — it is a request. Two ways the request
    # goes unmet: an edit lands in one file only, or the validator never runs at all (gpo_execute
    # reaches the dispatch with no gpo_validate in front of it on at least one shipping in-tree
    # path). The consequence is not a wrong picture, it is a grid up to 64x over the cap, which on
    # this silicon is a wedged queue with no pointer back. Checking the numbers actually going into
    # the packet makes the validator an early reject with an attributable code, rather than the only
    # thing standing between a malformed list and a hung GPU.
    if ((n_prims << tshift) * lrows > GPU_TEXL_MAX_WAVES) { return 0; }

    var rec_mc    = gpu_arena_mc   + GPU_TEXL_PREP_SUBOFF;
    # ⭐ THE MODE SELECTS THE BLOB. Two resident shaders, one dispatch each — never one shader with a
    # runtime branch, because both blobs must carry rung 13's 417-dword body CHARACTER-IDENTICALLY and
    # a branch inside the body is an edit to it. 4 KB of arena buys keeping the 17/17 iron proof.
    var shader_mc = gpu_arena_mc   + GPU_TEXL_SHADER_SUBOFF;
    if (gpu_texl_colmajor == 1) {
        # ⚠ ARMED HERE, NOT AT THE TOP — the mode is not known until gpu_texl_build has read the
        # primitives. Refusing after the records are built costs one wasted build and nothing else;
        # dispatching against an unwritten arena slot costs the machine.
        if (gpu_texl_cm_arm() != 1) { return 0; }
        shader_mc = gpu_arena_mc + GPU_TEXL_CM_SHADER_SUBOFF;
    }
    var done_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    var done_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;

    # user data: s[0:1]=record array  s[2:3]=back-buffer base  s4=pitch  s5=n_prims  s6/s7 reserved.
    # ⚠ The union rect (uw/uh/udx/udy) does NOT reach the shader — each primitive carries its own
    # origin and size. It is validated and kept in the ABI as the caller's damage declaration for
    # the present that follows, which is the only thing it is good for.
    # ⚠ gy is `lrows`, NOT `maxh` — under COLMAJOR the row axis is the WIDTH. Passing maxh here would
    # launch a correctly-shaped grid for the wrong orientation: the picture would be right only for
    # square primitives, which is the shape every quick test happens to use.
    #
    # ⛔⛔ THIS DISPATCH MUST NOT STAY INSIDE THE OUTER BATCH — the 1.56.21 invariant, second op.
    #
    # gpu_tri_list carries this suspend already and the comment above it records what it cost. The
    # reason it applies HERE TOO is narrower and was mis-stated by rung 14's own header note, which
    # claimed the failure mode is "unrepresentable" for op 0x0C. That is true WITHIN one op — each
    # primitive owns its own 160-byte record in the array, which is exactly what rung 12 lacked — and
    # FALSE ACROSS TWO OPS, because GPU_TEXL_PREP_SUBOFF is ONE fixed prep slot and every op 0x0C in
    # the array rebuilds it from the top:
    #     gpo_execute_all sets gpu_batch_active for the whole #92 array (syscall.cyr)
    #     gpu_blend_cov_run then only QUEUES dwords and returns — no tail, no fence, no wait
    #     the next op 0x0C's gpu_texl_build overwrites all 512 records the first is still to read
    # So a two-op array does not draw two lists; it draws the SECOND list twice, in the first list's
    # grid. Per-primitive records made the failure unrepresentable per-op and did nothing at all for
    # the op-to-op seam.
    #
    # ⭐ AND THE TARGET WORKLOAD IS PHYSICALLY TWO OPS. GPU_TEX_LIST_MAX is 512 and a DOOM frame is
    # ~640 wall columns, so the frame rung 14b just made feasible CANNOT be expressed as one op. This
    # is latent only for as long as nobody draws the thing the rung was built for.
    #
    # Suspending makes this dispatch emit its own tail and WAIT, so the prep slot is free the moment
    # the call returns. It gives back the batching win for this op only — the real answer is a
    # per-op record region (there is room: [0xBE000,0xC0000) spare, 51 more records) or a ring-side
    # fence, and neither is a fence patch's job.
    var saved_batch = gpu_batch_active;
    gpu_batch_active = 0;
    var rc = gpu_blend_cov_run(shader_mc, rec_mc, bb_mc, pitch, n_prims, tshift, 0,
    GPU_COMPUTE_PGM_RSRC1_TEX, n_prims << tshift, lrows, done_mc, done_phys);
    gpu_batch_active = saved_batch;

    # ⚠ SUSPEND LATE, RESTORE ONCE. Everything above this point is CPU-only work that does not care
    # about the flag, so wrapping only the dispatch leaves exactly ONE restore site and no early
    # return that can leak a cleared flag into the rest of the array. gpu_tri_list needs its restore
    # duplicated on a failure path because its suspend spans a loop; this one must not grow that
    # shape.
    #
    # ⚠ Re-arm the shared fence slot, same reason as gpu_tri_list: the dispatch above already fenced
    # and drained, so the slot now reads DONE, and the outer batch tail would sail through its wait
    # believing a program it has not yet emitted has finished.
    if (saved_batch != 0) {
        store32(gpu_arena_phys + GPU_BLEND_DONE_SUBOFF, GPU_MT_NOTYET);
        gpu_mfence();
    }
    return rc;
}

# Print the texture prep record so a ring-3 tool computing the same thing INDEPENDENTLY can
# contradict it, field by field. ⚠ Not a read-back: this prints what the kernel COMPUTED.
fn gpu_tex_prep_dump(rec_phys) {
    kprint("tex-prep:", 9);
    var i = 0;
    while (i < 36) {
        kprint(" ", 1);
        kprint_num(load32(rec_phys + i * 4) & 0xFFFFFFFF);
        i = i + 1;
    }
    kprint("\n", 1);
    return 0;
}

# gpu_tex_arm — RUNG 13a's residency hook.
#
# ⛔ RETURNS 0 ON PURPOSE, exactly as gpu_edge_arm did through rung 9a. 13a's whole claim is that
# op 0x0B's ABI — every field, every reject, both texture formats, the bidirectional LUT rule — is
# provable in QEMU at ZERO BURNS before one instruction of the texturing shader exists. Returning 1
# here to "make the op work" would fabricate a pass: the dispatch would run a blob that is not
# resident and the failure would surface on iron as a wedged queue with no pointer back to here.
# 13b replaces this body with the real residency check and nothing else in the tree changes.
# gpu_texl_arm — RUNG 14's residency hook. Returns 0 until the fused-list blob exists, by the same
# doctrine that governed gpu_edge_arm through 9a and gpu_tex_arm through 13a: an op whose shader is
# absent must REFUSE, not dispatch a blob that is not resident. On this silicon that mistake is a
# wedged queue with no pointer back to here.
fn gpu_texl_arm() {
    if (gpu_texl_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    tex_list_write(gpu_arena_phys + GPU_TEXL_SHADER_SUBOFF);
    gpu_mfence();
    gpu_texl_armed = 1;
    return 1;
}

# gpu_texl_cm_arm — RUNG 14b's residency hook for the COL-MAJOR blob, same doctrine as above: a mode
# whose shader is absent must REFUSE rather than dispatch a slot that was never written. On this
# silicon that mistake is a wedged queue with no pointer back here.
#
# ⚠ SEPARATE FROM gpu_texl_arm ON PURPOSE. A row-major-only workload never pays the 1832-byte write,
# and — more importantly — a col-major dispatch that somehow reached an unarmed slot would run
# whatever the arena last held there, which is a far worse failure than a refusal.
fn gpu_texl_cm_arm() {
    if (gpu_texl_cm_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    tex_list_cm_write(gpu_arena_phys + GPU_TEXL_CM_SHADER_SUBOFF);
    gpu_mfence();
    gpu_texl_cm_armed = 1;
    return 1;
}

fn gpu_tex_arm() {
    if (gpu_tex_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    tex_rgba_write(gpu_arena_phys + GPU_TEX_SHADER_SUBOFF);
    gpu_mfence();
    gpu_tex_armed = 1;
    return 1;
}

# gpu_texbi_arm — RUNG 15's residency hook. Same doctrine as gpu_texl_cm_arm: a mode whose shader is
# absent must REFUSE rather than dispatch a slot that was never written, because on this silicon that
# mistake is a wedged queue with no pointer back here.
#
# ⚠ SEPARATE FROM gpu_tex_arm ON PURPOSE, and the cost is paid only by the caller who asks for it: a
# nearest-neighbour workload never writes these 2336 bytes, and — the part that actually matters — a
# nearest primitive can never accidentally run the 48-VGPR blob, nor a bilinear one the 32-VGPR blob,
# because each arms its own slot and gpu_tex_dispatch reads the slot and the RSRC1 descriptor from the
# same flag.
fn gpu_texbi_arm() {
    if (gpu_texbi_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    tex_bilin_write(gpu_arena_phys + GPU_TEXBI_SHADER_SUBOFF);
    gpu_mfence();
    gpu_texbi_armed = 1;
    return 1;
}

# gpu_tri_tex — RUNG 13's worker. Coverage first through the UNMODIFIED edge rasteriser, then a
# nearest-neighbour affine texture fetch over the mask it produced — the same two-stage shape
# gpu_tri_rgba uses, so the proven half stays proven.
#
# ⚠ Caller owns all bounds checking; gpo_validate_tritex has already refused anything out of range.
# Returns 1 / 0.
fn gpu_tri_tex(edge_mc, vtx_kva, tex_mc, lut_mc, texwh, flags, w, h, dx, dy, n_edges, rule) {
    if (gpu_cov_arm() != 1) { return 0; }

    # The 48-byte vertex/UV record: 6 screen coords then 6 texel coords, all i32 16.16.
    var vx0 = gpo_i32(vtx_kva +  0); var vy0 = gpo_i32(vtx_kva +  4);
    var vx1 = gpo_i32(vtx_kva +  8); var vy1 = gpo_i32(vtx_kva + 12);
    var vx2 = gpo_i32(vtx_kva + 16); var vy2 = gpo_i32(vtx_kva + 20);
    var u0  = gpo_i32(vtx_kva + 24); var v0  = gpo_i32(vtx_kva + 28);
    var u1  = gpo_i32(vtx_kva + 32); var v1  = gpo_i32(vtx_kva + 36);
    var u2  = gpo_i32(vtx_kva + 40); var v2  = gpo_i32(vtx_kva + 44);

    var cov_mc   = gpu_arena_mc   + GPU_TRI_COV_SUBOFF;
    var rec_phys = gpu_arena_phys + GPU_TEX_PREP_SUBOFF;

    # 1. coverage into the scratch mask, via the UNMODIFIED edge rasteriser.
    # ⭐ SKIPPED ENTIRELY UNDER FULLCOV — this is the whole point of the flag. Two of op 0x0B's three
    # dispatches live here, and for a primitive that fills its rect they compute a mask that is
    # uniformly 255. Rung 13 measured the chain at 52.7 us fixed; dropping to one dispatch is what
    # makes rung 14's per-frame primitive count feasible at all.
    if ((flags & 2) == 0) {
        if (gpu_edge_cov(edge_mc, cov_mc, w, h, n_edges, rule) != 1) { return 0; }
    }

    # 2. the CPU prologue — the bias, the deltas, both limits and one exact reciprocal, hoisted
    # ⚠ The record's format word carries BOTH flags; the shader branches on bit 1 to decide whether
    # to load a coverage byte at all. Passing only the IDX8 bit would leave it loading from a mask
    # this path never wrote.
    var fmt = flags & 7;                         # IDX8 | FULLCOV | WRAP all reach the shader
    if (gpu_tex_prep(rec_phys, cov_mc, tex_mc, lut_mc, texwh & 0xFFFF, (texwh >> 16) & 0xFFFF, fmt,
    vx0, vy0, vx1, vy1, vx2, vy2, u0, v0, u1, v1, u2, v2) != 1) { return 0; }

    # ⛔ THE PROLOGUE RUNS BEFORE THE ARMING CHECK, ON PURPOSE. 13b's claim is that the CPU side is
    # complete and diffable against the host model while the shader is still absent; building the
    # record and THEN refusing is what lets gpu_tex_prep_dump be compared field-by-field in QEMU at
    # zero burns. 13c replaces gpu_tex_arm's body and this function needs no further edit.
    #
    # ⭐ RUNG 15: the filter picks the BLOB, not a branch inside one. The prep record is byte-identical
    # either way — bilinear's fraction is already present in the 16.16 coordinate rung 13 computes and
    # then discards — so gpu_tex_prep above is untouched and this rung adds ZERO uncached stores to the
    # per-primitive CPU cost that 1.56.27/28 just cut 4x. That is why the flag can be read this late.
    var bilin = 0;
    if ((flags & GPU_TEX_FLAG_BILINEAR) != 0) { bilin = 1; }
    if (bilin == 0) { if (gpu_tex_arm()   != 1) { return 0; } }
    if (bilin == 1) { if (gpu_texbi_arm() != 1) { return 0; } }

    # 3. the texturing pass
    return gpu_tex_dispatch(rec_phys, w, h, dx, dy, bilin);
}

# gpu_tex_dispatch — issue the texturing kernel over the destination rect.
# ⚠ Mirrors gpu_tri_dispatch exactly, including the back-buffer choice: writing gpu_bb_a_mc
# unconditionally would draw into the FRONT buffer half the time and read as a raster bug.
fn gpu_tex_dispatch(rec_phys, w, h, dx, dy, bilin) {
    var rec_mc    = gpu_arena_mc + GPU_TEX_PREP_SUBOFF;
    var shader_mc = gpu_arena_mc + GPU_TEX_SHADER_SUBOFF;
    var rsrc1     = GPU_COMPUTE_PGM_RSRC1_TEX;
    # ⛔⛔ THE SLOT AND THE DESCRIPTOR MOVE TOGETHER, IN ONE BLOCK, FROM ONE FLAG. Splitting them into
    # two `if`s — or selecting the slot here and the RSRC1 at the call below — is how they drift apart,
    # and the failure mode is the worst one available on this silicon: a 48-VGPR kernel dispatched
    # under a 32-VGPR declaration does NOT fault. It silently aliases the high VGPRs across waves and
    # paints a wrong picture, which is unattributable without a burn. Keep them adjacent.
    if (bilin == 1) {
        shader_mc = gpu_arena_mc + GPU_TEXBI_SHADER_SUBOFF;
        rsrc1     = GPU_COMPUTE_PGM_RSRC1_TEXBI;
    }
    var done_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    var done_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;

    if (gpu_blit_arm() != 1) { return 0; }
    var bb_mc = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { bb_mc = gpu_bb_b_mc; }
    var pitch = gpu_bb_pitch;
    if (pitch == 0) { return 0; }
    var dst_mc = bb_mc + dy * pitch + dx * 4;

    var gx = (w + 63) / 64;
    var gy = h;
    return gpu_blend_cov_run(shader_mc, rec_mc, dst_mc, pitch, 0, w, h,
    rsrc1, gx, gy, done_mc, done_phys);
}

fn gpu_tri_list(vtx_kva, n_tris, w, h, dx, dy) {
    if (gpu_tri_arm() != 1) { return 0; }
    if (gpu_cov_arm() != 1) { return 0; }

    # ⛔⛔ THIS LOOP MUST NOT RUN INSIDE THE OUTER BATCH, AND THAT COST FOUR IRON BURNS.
    #
    # gpo_execute_all sets gpu_batch_active for the whole #92 op array, so gpu_blend_cov_run only
    # QUEUES dwords and returns — no fence, no wait, one tail for everything. That is correct when
    # each op writes its own buffers. It is fatal here, because every triangle in this loop reuses
    # the SAME THREE FIXED ARENA SLOTS:
    #     GPU_TRI_EDGE_SUBOFF   the CPU rewrites the edges below, per triangle
    #     GPU_TRI_PREP_SUBOFF   gpu_tri_prep rewrites the 128-byte record, per triangle
    #     GPU_TRI_COV_SUBOFF    gpu_edge_cov rewrites the coverage mask, per triangle
    # Batched, all 3N dispatches are queued FIRST and the CPU overwrites those slots long before the
    # GPU executes any of them — so every dispatch ends up reading the LAST triangle's edges, prep
    # record and coverage mask. The earlier triangles are not "lost" to a cache fault; they were
    # never drawn with their own data.
    #
    # ⭐ This is exactly what the burn-9/10 probes measured, before the cause was known:
    #   * six SEPARATE op 0x0A calls composite perfectly — each call has its own tail and wait
    #   * one call with n=2 destroys triangle 0 EVEN WHEN triangle 1 covers nothing — triangle 0's
    #     dispatch reads triangle 1's EMPTY coverage mask and therefore draws nothing at all
    #   * a bare op 0x08 after a rendered rect harms nothing — different syscall, already drained
    #   * every triangle is byte-exact ALONE — one triangle never races itself
    #
    # Suspending the batch makes each gpu_blend_cov_run emit its own tail and WAIT, which is what
    # makes reusing one slot per triangle safe. It gives back the batching win for this op only;
    # fusing N triangles into one dispatch (so the slots stop being shared at all) is the real
    # answer and is rung 12's own work, not a fence patch.
    var saved_batch = gpu_batch_active;
    gpu_batch_active = 0;

    var i = 0;
    while (i < n_tris) {
        var b = vtx_kva + i * GPU_TRI_VTX_BYTES;
        var vx0 = gpo_i32(b +  0); var vy0 = gpo_i32(b +  4);
        var vx1 = gpo_i32(b +  8); var vy1 = gpo_i32(b + 12);
        var vx2 = gpo_i32(b + 16); var vy2 = gpo_i32(b + 20);
        var ca  = load32(b + 24) & 0xFFFFFFFF;
        var cb  = load32(b + 28) & 0xFFFFFFFF;
        var cc  = load32(b + 32) & 0xFFFFFFFF;

        # ⚠ The frame's own three edges are the coverage shape here — a triangle list is a list of
        # triangles, so shape and attribute frame coincide. That is a SPECIAL CASE of op 0x09's
        # decoupling, not a contradiction of it.
        var e = gpu_arena_phys + GPU_TRI_EDGE_SUBOFF;
        store32(e +  0, vx0); store32(e +  4, vy0); store32(e +  8, vx1); store32(e + 12, vy1);
        store32(e + 16, vx1); store32(e + 20, vy1); store32(e + 24, vx2); store32(e + 28, vy2);
        store32(e + 32, vx2); store32(e + 36, vy2); store32(e + 40, vx0); store32(e + 44, vy0);
        gpu_mfence();

        var edge_mc = gpu_arena_mc + GPU_TRI_EDGE_SUBOFF;
        if (gpu_tri_rgba(edge_mc, w, h, dx, dy, 3, GPU_RULE_NONZERO,
        vx0, vy0, vx1, vy1, vx2, vy2, ca, cb, cc) != 1) {
            gpu_batch_active = saved_batch;    # ⚠ restore on the FAILURE path too
            return 0;
        }
        i = i + 1;
    }

    gpu_batch_active = saved_batch;
    # ⚠ Every dispatch above already fenced and drained, so the work is complete — but the shared
    # fence slot now reads DONE, and the outer batch tail would sail straight through its wait
    # believing a program it has not yet emitted has finished. Re-arm it so the caller's tail waits
    # on its own work rather than on ours.
    if (saved_batch != 0) {
        store32(gpu_arena_phys + GPU_BLEND_DONE_SUBOFF, GPU_MT_NOTYET);
        gpu_mfence();
    }
    return 1;
}

# gpu_tri_rgba — the attribute-interpolation worker. Coverage first (the shipped edge rasteriser,
# UNCHANGED), then the interpolation pass over the mask it produced.
#
# ⛔ edge_setup.s AND edge_cov.s ARE DISPATCHED AS THE SHIPPED, IRON-PROVEN BINARIES. Not a variant,
# not a recompile — the same blobs, through the same dispatcher, because their RSRC2 (0x190) is
# byte-identical to this kernel's. That is what makes rung 11 additive to a proven rasteriser rather
# than a change to it.
#
# ⚠ Caller owns all bounds checking; gpo_validate_tri has already refused anything out of range.
# Returns 1 / 0.
fn gpu_tri_rgba(edge_mc, w, h, dx, dy, n_edges, rule, vx0, vy0, vx1, vy1, vx2, vy2, ca, cb, cc) {
    if (gpu_tri_arm() != 1) { return 0; }
    if (gpu_cov_arm() != 1) { return 0; }

    var cov_phys = gpu_arena_phys + GPU_TRI_COV_SUBOFF;
    var cov_mc   = gpu_arena_mc   + GPU_TRI_COV_SUBOFF;
    var rec_phys = gpu_arena_phys + GPU_TRI_PREP_SUBOFF;

    # 1. coverage into the scratch mask, via the UNMODIFIED edge rasteriser
    if (gpu_edge_cov(edge_mc, cov_mc, w, h, n_edges, rule) != 1) { return 0; }

    # 2. the CPU prologue — one exact reciprocal, hoisted per record
    if (gpu_tri_prep(rec_phys, cov_mc, vx0, vy0, vx1, vy1, vx2, vy2, ca, cb, cc) != 1) { return 0; }

    # 3. the interpolation pass
    return gpu_tri_dispatch(rec_phys, w, h, dx, dy);
}

fn gpu_cov_arm() {
    if (gpu_cov_armed == 1) { return 1; }
    if (gpu_present == 0) { return 0; }
    if (gpu_arena_mc == 0) { return 0; }
    if (gpu_ring_wptr == 0) { return 0; }
    if (gpu_matmul_ok != 1) { return 0; }
    blend_cov_write(gpu_arena_phys + GPU_COV_SHADER_SUBOFF);
    gpu_mfence();
    gpu_cov_armed = 1;
    return 1;
}

# gpu_cov_surface — composite a uniform colour through an 8bpp coverage mask onto the back buffer.
# Kernel-side worker behind gpu_blend_cov_shm#93. Returns 1 / 0. Caller owns all bounds checking.
fn gpu_cov_surface(mask_mc, w, h, dx, dy, color) {
    if (gpu_cov_arm() != 1) { return 0; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var dst_mc = tgt + dy * gpu_bb_pitch + dx * 4;
    var gx = (w + 63) / 64;
    return gpu_blend_cov_run(gpu_arena_mc + GPU_COV_SHADER_SUBOFF, mask_mc, dst_mc,
    w, gpu_bb_pitch, w, color, GPU_COMPUTE_PGM_RSRC1_COV, gx, h,
    gpu_arena_mc + GPU_BLEND_DONE_SUBOFF,
    gpu_arena_phys + GPU_BLEND_DONE_SUBOFF);
}

# perm — iron-proven gfx90c ISA. Human-readable reference: kernel/shaders/perm.s (documentation only).
# ⚠ These bytes ARE the shader — iron-proven on archaemenid, committed hex, the authority. AGNOS ships
#   no assembler and its build requires no llvm and no C/C++. The sovereign gfx90c assembler in the
#   ecosystem is mabda's Cyrius gfx9 encoder (mabda/src/gfx9_encode.cyr, HW-proven on Cezanne).
fn perm_write(dst_phys) {
    store32(dst_phys + 0,   0x24020082);
    store32(dst_phys + 4,   0x7e060200);
    store32(dst_phys + 8,   0x7e080201);
    store32(dst_phys + 12,  0x32060303);
    store32(dst_phys + 16,  0x38080880);
    store32(dst_phys + 20,  0xdc508000);
    store32(dst_phys + 24,  0x027f0003);
    store32(dst_phys + 28,  0x240e0084);
    store32(dst_phys + 32,  0x7e0a0202);
    store32(dst_phys + 36,  0x7e0c0203);
    store32(dst_phys + 40,  0x320a0f05);
    store32(dst_phys + 44,  0x380c0c80);
    store32(dst_phys + 48,  0xbe8600ff);
    store32(dst_phys + 52,  0x0c010c00);
    store32(dst_phys + 56,  0xbe8700ff);
    store32(dst_phys + 60,  0x0c030c02);
    store32(dst_phys + 64,  0xbe8800ff);
    store32(dst_phys + 68,  0x06040200);
    store32(dst_phys + 72,  0xbf8c0f70);
    store32(dst_phys + 76,  0xd1ed0008);
    store32(dst_phys + 80,  0x00120480);
    store32(dst_phys + 84,  0xd1ed0009);
    store32(dst_phys + 88,  0x00121080);
    store32(dst_phys + 92,  0xd1ed0003);
    store32(dst_phys + 96,  0x001a0480);
    store32(dst_phys + 100, 0xd1ed0004);
    store32(dst_phys + 104, 0x001e0480);
    store32(dst_phys + 108, 0xd1ed000a);
    store32(dst_phys + 112, 0x00220704);
    store32(dst_phys + 116, 0x7e160302);
    store32(dst_phys + 120, 0xdc7d8000);
    store32(dst_phys + 124, 0x007f0805);
    store32(dst_phys + 128, 0xbf8c0f70);
    store32(dst_phys + 132, 0xbf810000);
    return 34;
}

# blend_pk — iron-proven gfx90c ISA. Human-readable reference: kernel/shaders/blend_pk.s (documentation only).
# ⚠ These bytes ARE the shader — iron-proven on archaemenid, committed hex, the authority. AGNOS ships
#   no assembler and its build requires no llvm and no C/C++. The sovereign gfx90c assembler in the
