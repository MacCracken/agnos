    store32(dst_phys + 24,  0x38040480);
    store32(dst_phys + 28,  0x7e060202);
    store32(dst_phys + 32,  0x7e080203);
    store32(dst_phys + 36,  0x32061303);
    store32(dst_phys + 40,  0x38080880);
    store32(dst_phys + 44,  0x7e100280);
    store32(dst_phys + 48,  0xb0060004);
    store32(dst_phys + 52,  0xdc508000);
    store32(dst_phys + 56,  0x057f0001);
    store32(dst_phys + 60,  0xdc508000);
    store32(dst_phys + 64,  0x067f0003);
    store32(dst_phys + 68,  0xbf8c0f70);
    store32(dst_phys + 72,  0xd2850007);
    store32(dst_phys + 76,  0x00020d05);
    store32(dst_phys + 80,  0x68100f08);
    store32(dst_phys + 84,  0xd1196a01);
    store32(dst_phys + 88,  0x00010901);
    store32(dst_phys + 92,  0x38040480);
    store32(dst_phys + 96,  0xd1196a03);
    store32(dst_phys + 100, 0x00010903);
    store32(dst_phys + 104, 0x38080880);
    store32(dst_phys + 108, 0x81868106);
    store32(dst_phys + 112, 0xbf018006);
    store32(dst_phys + 116, 0xbf85ffef);
    store32(dst_phys + 120, 0x7e020204);
    store32(dst_phys + 124, 0x7e040205);
    store32(dst_phys + 128, 0x32021501);
    store32(dst_phys + 132, 0x38040480);
    store32(dst_phys + 136, 0xdc718000);
    store32(dst_phys + 140, 0x007f0801);
    store32(dst_phys + 144, 0xbf8c0f70);
    store32(dst_phys + 148, 0xbf810000);
