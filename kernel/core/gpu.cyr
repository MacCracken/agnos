    store32(dst_phys + 32,  0x820d8001);
    store32(dst_phys + 36,  0x24020082);
    store32(dst_phys + 40,  0x7e0c020c);
    store32(dst_phys + 44,  0x7e0e020d);
    store32(dst_phys + 48,  0x320c0306);
