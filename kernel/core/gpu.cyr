    store32(dst_phys + 304,  0x6a121d09);
    store32(dst_phys + 308,  0xd285000a);
    store32(dst_phys + 312,  0x00020c25);
    store32(dst_phys + 316,  0xd286000b);
    store32(dst_phys + 320,  0x00020c25);
    store32(dst_phys + 324,  0x900d9f25);
    store32(dst_phys + 328,  0x261c0c0d);
