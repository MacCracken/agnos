    store32(dst_phys + 216, 0xd1cb0009);
    store32(dst_phys + 220, 0x0426050a);
    store32(dst_phys + 224, 0x7e142703);
    store32(dst_phys + 228, 0xd1cb0009);
    store32(dst_phys + 232, 0x0426110a);
    store32(dst_phys + 236, 0xd1dd000d);
    store32(dst_phys + 240, 0x04350509);
    store32(dst_phys + 244, 0x7e142903);
    store32(dst_phys + 248, 0xd1cb0009);
    store32(dst_phys + 252, 0x042e110a);
    store32(dst_phys + 256, 0xd1dd000d);
    store32(dst_phys + 260, 0x04350709);
    store32(dst_phys + 264, 0xdc718000);
    store32(dst_phys + 268, 0x007f0d06);
    store32(dst_phys + 272, 0xbf8c0f70);
    store32(dst_phys + 276, 0xbf810000);
