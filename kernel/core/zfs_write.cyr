# B11's early ops, right after B7's early ones (before B5's, whose last on agnoswr exhausts the metaslabs agnos
# allocates in): UTF-8 names on agnoswr's utf8only `utf8` (u8_validate, zfs_wenc.cyr zfs_u8_valid) — a 4-byte character
# (U+1F600) is created; an overlong '/', a UTF-16 surrogate, a code point past U+10FFFF, a lead byte past 0xF4 and a
# truncated sequence are refused by name, each with u8_validate's class (EILSEQ 1, ERANGE 2, EINVAL 3).
# (B11 review, finding 1) THE MULTI-TXG RACE, deterministic: zfs_wf_yield calls zfs_wt_yhook once fs_lock is back —
# armed (zfs_wt_yfd), the FIRST yield writes 4,096 bytes of agnos-gen-1 "b11/race2" through that fd, policy B, and
# leaves them PENDING: exactly what a write#1 on another CPU does while a multi-txg write#1 has the lock released.
var zfs_wt_yfd = 0;          # the armed fd base (0: off)
var zfs_wt_yok = 0;          # what the hook's write#1 returned (0: it never ran)
fn zfs_wt_yhook() {
    if (zfs_wt_yfd == 0) { return 0; }
    var b = zfs_wt_yfd;
    zfs_wt_yfd = 0;
    var m = zfs_wf_mode;
    var s = zfs_wf_seed;
    zfs_wf_mode = 1;
    zfs_wf_seed = zfs_gen_seed("b11/race2", 9);
    zfs_wt_yok = zfs_fd_write(b, 0, 4096);
    zfs_wf_mode = m;
    zfs_wf_seed = s;
    return 0;
}
# The race op: path rewritten whole by ONE write#1 of 4.5 MiB through fd X — more than a txg's 4 MiB data arena, so it
# commits a txg, releases fs_lock (zfs_wf_yield) and goes on — while the hook writes other [0, 4096) through fd Y in that
# gap. X's next txg must COMMIT Y's pending txg first (zfs_wf_write's re-check after the yield; zfs_wp_own in
# zfs_wf_begin), never drop it with a "dirty set not empty" refusal: X whole, Y's bytes read back through a third fd
# after X's close. Before the fix X's write ended short and Y's close committed an empty dirty set — its data gone, the
# close answering 0. r.
fn zfs_wt_race(path, other) {
