# Save (sv 1) or restore (sv 0) every MOS chain block's slot — in the walk order, at most ZWK_CSNMAX bytes (the caller
# measured) — into / from the snapshot ZWA_CSN. 0.
fn zfs_wc_cpy(n, sv) {
    var p = zfs_wmem + ZWA_CSN;
    var un = 1 << zfs_ashift;
    var k = 0;
    while (k < n) {
        var x = zfs_dirty_at(k);
        var d = zfs_dent(x);
        if (load64(d) == 0 && (load64(d + 56) & ZWD_CHAIN) != 0) {
            var sz = (load64(d + 32) + un - 1) & (0 - un);
            if (sv == 1) { memcpy(p, zfs_dirty_buf(x), sz); } else { memcpy(zfs_dirty_buf(x), p, sz); }
            p = p + sz;
        }
        k = k + 1;
    }
    return 0;
}
# The chain's snapshot (k.25) over the walk order of n blocks: every chain block's bytes, the rootbp and the MOS's
# space — when the chain fits ZWK_CSNMAX (zfs_wc_snap 1), else none (0). 0.
fn zfs_wc_snapset(n) {
    var un = 1 << zfs_ashift;
    var tot = 0;
    var k = 0;
    while (k < n) {
        var d = zfs_dent(zfs_dirty_at(k));
        if (load64(d) == 0 && (load64(d + 56) & ZWD_CHAIN) != 0) { tot = tot + ((load64(d + 32) + un - 1) & (0 - un)); }
        k = k + 1;
    }
