            return zfs_wno("a chain block outgrew an unreserved plan");
        }
        if (r == 1 && a >= ZWK_RPLMAX) { return zfs_wno("a chain block outgrew an unreserved plan"); }
        if (r == 3 && hg >= 8) { return zfs_wno("the histogram set still grew after 8 chain re-plans"); }
        if (zfs_wxl_undo(m2) != 0) { return zfs_wno("undo of a chain plan failed"); }
        zfs_wc_cpy(n, 0);
