    return 0;
}
# After step (1) — the dataset phase's allocations and every non-chain MOS block's made — the HISTOGRAM SET of txg T:
# every metaslab T allocated in whose stored histogram would now claim more than its space holds, each one's space map
# dnode into the chain (zfs_wh_grow). Most txgs add none. 0 / -1 named.
fn zfs_wh_plan() {
    var hit[256];
    zfs_wh_hits(&hit);
    var i = 0;
    while (i < zfs_ms_count) {
        if (zfs_wh_bit(&hit, i) == 1) {
            var r = zfs_wh_need(i);
            if (r < 0) { return 0 - 1; }
            if (r == 1 || (r == 2 && (zfs_wh_force & 1) != 0)) {
                zfs_wh_set1(&zfs_wh_set, i);
                zfs_wh_set1(&zfs_wh_pend, i);
