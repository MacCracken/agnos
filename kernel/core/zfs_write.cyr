    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: write begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprintln(" off=0 len=4718592 seed=b11/race", 32);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wno("open#7 refused");
