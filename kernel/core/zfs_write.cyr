        }
        i = i + 1;
    }
    return zfs_wh_grow();
}
# After the chain's allocations: a metaslab T allocated in that is not in the set yet and whose stored histogram now
# claims more than its space holds — a chain block took it there — joins the set. If its space map's dnode is already
# in a chain block (allocated with this attempt) nothing else is needed; otherwise it waits in zfs_wh_pend and the
# attempt is re-planned (zfs_wc_chrun: the snapshot restored, zfs_wh_grow, the walk order and the snapshot rebuilt).
# The set only grows, so the re-plans end. 0 · 3 re-plan · -1 named.
fn zfs_wh_check() {
    var per = load16(zfs_dirty_buf(zfs_wmos_os()) + 8);
    var hit[256];
    zfs_wh_hits(&hit);
    var grow = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        if (zfs_wh_bit(&hit, i) == 1) {
            if (zfs_wh_bit(&zfs_wh_set, i) == 0) {
                var r = zfs_wh_need(i);
                if (r < 0) { return 0 - 1; }
                if (r == 1 || (r == 2 && (zfs_wh_force & 2) != 0)) {
                    zfs_wh_set1(&zfs_wh_set, i);
                    var e = zfs_dirty_find(0, 0, 0, load64(zfs_msent(i)) / per);
