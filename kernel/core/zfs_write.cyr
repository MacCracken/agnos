# /boot/cmdline on the ESP (gnoboot's \boot\cmdline — the FAT mount the zfs-write-smoke disk boots from) — `zfs_cut=N`
# or `zfs_cut=CLASS:N` (CLASS data / dsmeta / mos / chain / ub) arms the cut lane's list. Read before fs_lock (vfs takes
# it). 1 = a cut lane / 0.
fn zfs_wt_cmdline() {
    var b[136];
    memset(&b, 0, 136);
    var n = vfs_read_file("/boot/cmdline", 13, &b, 128);
    if (n <= 0) { return 0; }
    var i = 0;
    while (i + 8 <= n && memeq(&b + i, "zfs_cut=", 8) == 0) { i = i + 1; }
    if (i + 8 > n) { return 0; }
    i = i + 8;
    var c = 0;
    var k = 0;
    while (k < 5) {
        var w = "data:";
        var wl = 5;
        if (k == 1) {
            w = "dsmeta:";
            wl = 7;
        } elif (k == 2) {
            w = "mos:";
            wl = 4;
        } elif (k == 3) {
            w = "chain:";
            wl = 6;
        } elif (k == 4) {
            w = "ub:";
            wl = 3;
        }
        if (i + wl <= n && memeq(&b + i, w, wl) == 1) {
            c = k + 1;
            i = i + wl;
        }
        k = k + 1;
    }
    var v = 0;
    var d = 0;
    while (i < n && load8(&b + i) >= 48 && load8(&b + i) <= 57) {
        v = v * 10 + load8(&b + i) - 48;
        i = i + 1;
        d = d + 1;
    }
    if (d == 0) { return 0; }
    zfs_wt_cut = v;
    zfs_wt_cutc = c;
    return 1;
}
# The BP of level-0 block bid of the file at path as the READER sees it into out — an observation of the object, so a
# pending policy-B txg of it commits first (zfs_wp_obs). 0 / -1.
fn zfs_wt_bp(path, bid, out) {
    var ref = zfs_resolve(path, strlen(path), 0);
    if (ref < 0 || zfs_res_type != 1) { return 0 - 1; }
    if (zfs_wp_obs(ref) != 0) { return 0 - 1; }
    var dn = zfs_dnslot(3);
    if (zfs_ref_dn(ref, dn) != 0) { return 0 - 1; }
    if (zfs_wf_bp(dn, load64(zfs_ds(zfs_ref_di(ref)) + 840), ref & ZK_MASK48, bid, out) != 1) { return 0 - 1; }
    return 0;
}
fn zfs_wt_dva(bp) { return (load64(bp + 8) & ZWK_OFF63) << 9; }
# A write through ONE fd: open path with flags, k write#1s of n bytes each at off, off + n, ... (agnos-gen-1 of seed, by
# file offset), the fd CLOSED — policy B (or A under zfs_wp_pol 0). want_t: the txgs it must commit (0: any). The op's
# lines are zfs_wt_w's (op `write`); `zfs-wtest: b11 <tag> <path>: <k> x <n> through one fd, <t> txg(s), committed by
# <hook>` with the policy and the hook. r.
fn zfs_wt_fdw(tag, path, flags, off, k, n, seed, want_t) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: write begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" off=", 5);
    kprint_num(off);
    kprint(" len=", 5);
    kprint_num(k * n);
    kprint(" seed=", 6);
    kprintln(seed, strlen(seed));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wno("open#7 refused");
    var r = 0 - 1;
    var pend = 0;
    var tw = 0;
    var fd = 0 - 1;
    if (rw == 0) { zfs_wno("pool read-only"); }                # as zfs_wt_w: a file the list would have created first
    else { fd = zfs_open(path, strlen(path), flags); }
    if (fd >= 0) {
        var base = vfs_fd_table() + fd * 32;
        kpayload_set(base, 0, off);
        zfs_wf_mode = 1;
        zfs_wf_seed = zfs_gen_seed(seed, strlen(seed));
        r = 0;
        var i = 0;
        while (i < k) {
            var w = zfs_fd_write(base, 0, n);
            if (w != n) {
                r = 0 - 1;
                break;
            }
            r = r + w;
            i = i + 1;
        }
        zfs_wf_mode = 0;
        if (zfs_wp_ref != 0) { pend = 1; }
        tw = zfs_txg - t0;
        if (vfs_close_inner(fd) != 0) { r = 0 - 1; }
