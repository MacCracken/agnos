    kprint(" (", 2);
    kprint_num(xa);
    kprint(" B) freed in txg ", 17);
    kprint_num(tp);
    kprint("; txg ", 6);
    kprint_num(tp + 2);
    kprint("'s block at ", 12);
    kprint_num(y2);
    kprint(" (deferred), txg ", 17);
    kprint_num(tp + 3);
    kprint("'s at ", 6);
    kprint_num(y3);
