            }
            d = d + 1;
        }
        zfs_wh_ndem = zfs_wh_ndem + 1;
        var u = zfs_bp_dsize(pbp);
        zfs_wc_du = zfs_wc_du - u;
        zfs_wc_dc = zfs_wc_dc - ((((load64(pbp + 48) >> 16) & 0xFFFF) + 1) << 9);
