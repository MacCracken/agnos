    }
    return 0;
}
# One attempt at steps (2)-(4): (2) every chain block allocated (zfs_wc_calloc — an indirect into its reservation),
# its predecessor freed; the U rule (k.24: after the first commit's preset no metaslab with U 0 can get an entry —
# 2 if one did); (3) the MOS's space up the dsl_dirs, log T encoded; (4) the chain filled bottom-up and written.
# 0 · 1 an indirect outgrew its reservation (re-plan) · 2 · -1 / -2.
fn zfs_wc_try(t, n, a) {
    var k = 0;
    while (k < n) {
        var x = zfs_dirty_at(k);
        var d = zfs_dent(x);
        if (load64(d) == 0 && (load64(d + 56) & ZWD_CHAIN) != 0) {
            var r = zfs_wc_calloc(x, t, a);
            if (r != 0) { return r; }
        }
        k = k + 1;
    }
    k = 0;
    while (k < zfs_xl_n) {
        var i = (load64(zfs_xl(k)) & ZWK_OFF63) >> zfs_ms_shift;
        if (load64(zfs_msent(i) + 8) == 0 && ((load64(&zfs_wc_pre + (i >> 6) * 8) >> (i & 63)) & 1) == 0) { return 2; }
        k = k + 1;
    }
    var hr = zfs_wh_check();
    if (hr != 0) { return hr; }
    if (zfs_wdd_use(zfs_w_mdd, zfs_wc_du, zfs_wc_du, zfs_wc_dc, zfs_wc_dc) != 0 || zfs_wc_log(t) != 0) { return 0 - 1; }
    if (zfs_wh_fill() != 0) { return 0 - 1; }
    k = 0;
    while (k < n) {
        var y = zfs_dirty_at(k);
        var dy = zfs_dent(y);
        if (load64(dy) == 0 && (load64(dy + 56) & ZWD_CHAIN) != 0) {
            var r2 = zfs_wc_cfin(y);
            if (r2 != 0) { return r2; }
        }
        k = k + 1;
    }
    return 0;
}
# Every DVA of bp written from va (asize bytes each — a slot or ZLE output, zero-padded to the allocation unit). 0 / -1.
fn zfs_wc_wr(bp, va) {
    var d = 0;
    while (d < 3) {
        var w0 = load64(bp + d * 16);
        var w1 = load64(bp + d * 16 + 8);
        if (w0 != 0 || w1 != 0) {
            if (zfs_wr(((w1 & ZWK_OFF63) << 9) + ZK_DATA0, (w0 & 0xFFFFFF) << 9, va) != 0) { return zfs_wnon("device write at DVA ", d); }
        }
        d = d + 1;
    }
    return 0;
}
# (1) A non-chain MOS block: its fill (a dnode block's allocated dnodes, an indirect's children's), zfs_bp_build —
# ZLE, 3 copies (the MOS's, D6), fletcher4 (the MOS's checksum) — every copy written now, the BP stored in the
# parent's copy, the predecessor killed. 0 / -1 / -2.
fn zfs_wc_final(x) {
    var d = zfs_dent(x);
    var obj = load64(d + 8);
    var lv = load64(d + 24);
    var ls = load64(d + 32);
    var pbp = zfs_wpbp(x);
    var dn = zfs_wobj_dn(0, obj);
    if (pbp == 0 || dn == 0) { return 0 - 1; }
    var src = zfs_dirty_buf(x);
    var fill = 1;
    if (lv > 0) { fill = zfs_ind_ready(src, ls); }
    elif (obj == 0) { fill = zfs_fill_dnodes(src, ls); }
    var old[128];
    memcpy(&old, pbp, 128);
    var nb[128];
    var r = zfs_bp_build(src, ls, ((load64(d + 56) >> 8) & 0xFF) | (lv << 8) | (7 << 16) | (3 << 24) | ZWP_ZLE, fill, &old, &nb);
    if (r < 0) { return r; }
    if (r == 1) {
        zfs_wr_cls = 3;
        if (zfs_wc_wr(&nb, zfs_bpb_va) != 0) { return 0 - 1; }
        zfs_wc_born(dn, &nb);
    }
    r = zfs_wc_kill(dn, &old);
    if (r != 0) { return r; }
    memcpy(pbp, &nb, 128);
    return 0;
}
# (2) A chain MOS block: 3 DVAs, the BP — fill and checksum still 0 — in the parent's copy, the predecessor killed.
# psize is lsize (compression OFF) but for an INDIRECT while a snapshot backs the plan and attempt a has not run out
# (k.25): ZLE into the reservation zfs_wc_rsv picks (a multiple of the allocation unit below lsize). 0 / -1 / -2.
fn zfs_wc_calloc(x, t, a) {
    var d = zfs_dent(x);
    var obj = load64(d + 8);
    var lv = load64(d + 24);
    var ls = load64(d + 32);
    var pbp = zfs_wpbp(x);
    if (pbp == 0) { return 0 - 1; }
    var dn = 0;
    if (obj != ZWO_OSB) {
        dn = zfs_wobj_dn(0, obj);
        if (dn == 0) { return 0 - 1; }
    }
    var ps = ls;
    var comp = 2;
    if (lv > 0 && zfs_wc_snap == 1 && a < ZWK_RPLMAX) {
        var rv = zfs_wc_rsv(x, a);
        if (rv > 0 && rv < ls) {
            ps = rv;
            comp = ZE_ZLE;
        }
    }
    var prop = zfs_bp_prop(ls, ps, comp, 7, (load64(d + 56) >> 8) & 0xFF, lv);
    if (prop == (0 - 1)) { return zfs_wnon("block pointer not encodable: object ", obj); }
    var old[128];
    memcpy(&old, pbp, 128);
    var nb[128];
    var r = zfs_walloc_bp(&nb, ps, 3, 0);
    if (r != 0) { return r; }
    var z[32];
    memset(&z, 0, 32);
    zfs_bp_fin(&nb, prop, t, 0, &z);
    zfs_wc_born(dn, &nb);
    r = zfs_wc_kill(dn, &old);
    if (r != 0) { return r; }
    memcpy(pbp, &nb, 128);
    return 0;
}
# The re-plan table (ZWA_RSV): +0 a MOS chain indirect's key (level << 56 | blkid; every chain indirect is the
# meta-dnode's, object 0) + 1 · +8 the bytes a re-plan found it needs. Its slot (-1 none).
fn zfs_wc_rsvk(x) {
    var d = zfs_dent(x);
    var key = ((load64(d + 24) << 56) | load64(d + 16)) + 1;
    var k = 0;
    while (k < zfs_wc_nrsv) {
        if (load64(zfs_wmem + ZWA_RSV + k * 16) == key) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# The psize to reserve for MOS chain indirect x at attempt a (k.25): its ZLE size NOW — its non-chain children final,
# its chain children allocated but their fill and checksum still 0 — plus 128 bytes per such child (40 of its bytes
# are still to change, and a changed byte costs ZLE at most 3 output bytes: a zero run split by a literal) plus 64 (a
# literal run starts only with 64 bytes of room, zfs_zle_compress), at least what a re-plan of this txg found it
# needs, rounded up to the allocation unit. 0 = OFF (it would not beat lsize). ⚠ The op list's knob (zfs_wc_tight,
# ZFS_WRITE_OPS) reserves 512 B at attempt 0 — always too small for the MOS's L1 — so the re-plan runs on disk.
fn zfs_wc_rsv(x, a) {
    var d = zfs_dent(x);
    var ls = load64(d + 32);
    var src = zfs_dirty_buf(x);
    if (zfs_wc_tight == 1 && a == 0) { return 512; }
    var c = zfs_zle_compress(src, ls, zfs_wmem + ZWA_CMP, ls, ZE_ZLEN);
    if (c < 0) { return 0; }
    var kids = 0;
    var i = 0;
    while (i < ls) {
        var bp = src + i;
        if (zfs_bp_hole(bp) == 0 && load64(bp + 96) == 0 && load64(bp + 104) == 0 && load64(bp + 112) == 0 && load64(bp + 120) == 0) { kids = kids + 1; }
        i = i + 128;
    }
    var est = c + 128 * kids + 64;
    var k = zfs_wc_rsvk(x);
    if (k >= 0 && est < load64(zfs_wmem + ZWA_RSV + k * 16 + 8)) { est = load64(zfs_wmem + ZWA_RSV + k * 16 + 8); }
    var un = 1 << zfs_ashift;
    est = (est + un - 1) & (0 - un);
    if (est >= ls) { return 0; }
    return est;
}
# (4) A chain MOS block, its content final: the fill (dbuf_write_ready; the objset_phys's = Σ its meta-dnode's
# top-level fills, dmu_objset_write_ready), the physical bytes — the block itself (OFF) or, for a reserved indirect, its
# ZLE output zero-padded to the reservation — fletcher4 over them, both into the BP; every copy written. A ZLE output
# that does not fit its reservation records what it needs (its size + 256: the next attempt's content differs a little
# — new DVAs, new checksums) and returns 1: the caller re-plans (zfs_wc_chrun). 0 / 1 / -1.
fn zfs_wc_cfin(x) {
    var d = zfs_dent(x);
    var obj = load64(d + 8);
    var lv = load64(d + 24);
    var ls = load64(d + 32);
    var src = zfs_dirty_buf(x);
    var pbp = zfs_wpbp(x);
    if (pbp == 0) { return 0 - 1; }
    var fill = 1;
    if (obj == ZWO_OSB) {
        fill = 0;
        var i = 0;
        while (i < load8(src + 3)) {
            fill = fill + load64(src + 64 + i * 128 + 88);
            i = i + 1;
        }
    } elif (lv > 0) {
        fill = zfs_ind_ready(src, ls);
        if (fill == 0) { return zfs_wnon("a chain indirect lost every child: object ", obj); }
    } elif (obj == 0) { fill = zfs_fill_dnodes(src, ls); }
    var pr = load64(pbp + 48);
    var ps = (((pr >> 16) & 0xFFFF) + 1) << 9;
    var phys = src;
    if (((pr >> 32) & 0x7F) == ZE_ZLE) {
        var cmp = zfs_wmem + ZWA_CMP;
        var c = zfs_zle_compress(src, ls, cmp, ps, ZE_ZLEN);
        if (c < 0) {
            var need = zfs_zle_compress(src, ls, cmp, ls, ZE_ZLEN);
            if (need < 0) { need = ls; } else { need = need + 256; }
            var k = zfs_wc_rsvk(x);
            if (k < 0) {
                if (zfs_wc_nrsv >= ZWK_MAXRSV) { return zfs_wno("chain re-plan table full"); }
                k = zfs_wc_nrsv;
                zfs_wc_nrsv = zfs_wc_nrsv + 1;
                store64(zfs_wmem + ZWA_RSV + k * 16, ((lv << 56) | load64(d + 16)) + 1);
                store64(zfs_wmem + ZWA_RSV + k * 16 + 8, 0);
            }
            if (load64(zfs_wmem + ZWA_RSV + k * 16 + 8) < need) { store64(zfs_wmem + ZWA_RSV + k * 16 + 8, need); }
            return 1;
        }
        var un = 1 << zfs_ashift;
        memset(cmp + c, 0, ((ps + un - 1) & (0 - un)) - c);
        phys = cmp;
    }
    var ck[32];
    if (zfs_cksum_words(7, phys, ps, &ck) != 0) { return zfs_wno("checksum failed"); }
    store64(pbp + 88, fill);
    memcpy(pbp + 96, &ck, 32);
    zfs_wr_cls = 4;
    return zfs_wc_wr(pbp, phys);
}
# The txg's extents in log order: metaslab, then ALLOC before FREE, then offset. a < b? 1 / 0.
fn zfs_xl_lt(a, b) {
    var ka = (((a & ZWK_OFF63) >> zfs_ms_shift) << 1) | (a >> 63);
    var kb = (((b & ZWK_OFF63) >> zfs_ms_shift) << 1) | (b >> 63);
    if (ka != kb) {
        if (ka < kb) { return 1; }
        return 0;
    }
    if ((a & ZWK_OFF63) < (b & ZWK_OFF63)) { return 1; }
    return 0;
}
# (3) Log space map T (design § c.4; metaslab_sync -> space_map_write per metaslab): the txg's extents sorted
# (zfs_xl_lt) and adjacent ones coalesced, as a range tree holds them; per metaslab, ascending: dbg(ALLOC, pass 1, T)
# and its two-word entries, then dbg(FREE, 1, T) and its own — a type with no entry writes no debug word either
# (space_map_write returns on an empty tree, space_map.c) — offsets and runs in 512-byte units, vdev = the top-level
# id, a pad word before an entry that would straddle a block (zfs_sm_seg). The bonus (space_map_phys_t): smp_object,
# smp_length, smp_alloc = ALLOC - FREE bytes; the histogram stays 0 (OpenZFS keeps none for a log).
# B4: the list is sorted as a COPY (ZWA_XLS), so a chain re-plan (k.25) can still undo the list by position. 0 / -1.
fn zfs_wc_log(t) {
    var e = zfs_dirty_find(0, zfs_wc_lo, 0, 0);
    var ldn = zfs_wmos_dn(zfs_wc_lo);
    if (e < 0 || ldn == 0) { return zfs_wno("log space map not planned"); }
    var buf = zfs_dirty_buf(e);
    var cap = load64(zfs_dent(e) + 32);
    var xs = zfs_wmem + ZWA_XLS;
    memcpy(xs, zfs_wmem + ZWA_XL, zfs_xl_n * 16);
    var k = 1;
    while (k < zfs_xl_n) {
        var a0 = load64(xs + k * 16);
        var a1 = load64(xs + k * 16 + 8);
        var j = k;
        while (j > 0 && zfs_xl_lt(a0, load64(xs + (j - 1) * 16)) == 1) {
            memcpy(xs + j * 16, xs + (j - 1) * 16, 16);
            j = j - 1;
        }
        store64(xs + j * 16, a0);
        store64(xs + j * 16 + 8, a1);
        k = k + 1;
    }
    var len = 0;
    var net = 0;
    var gk = 0 - 1;
    var i = 0;
    while (i < zfs_xl_n) {
        var w = load64(xs + i * 16);
        var ty = w >> 63;
        var off = w & ZWK_OFF63;
        var ms = off >> zfs_ms_shift;
        var sz = zfs_xl_asz(xs + i * 16);
        if (((ms << 1) | ty) != gk) {
            gk = (ms << 1) | ty;
            len = zfs_sm_put(buf, len, cap, zfs_sm_dbg(ty, 1, t));
            if (len < 0) { return zfs_wno("log space map over its planned size"); }
        }
        var j2 = i + 1;
        while (j2 < zfs_xl_n && load64(xs + j2 * 16) == ((ty << 63) | (off + sz)) && ((off + sz) >> zfs_ms_shift) == ms) {
            sz = sz + zfs_xl_asz(xs + j2 * 16);
            j2 = j2 + 1;
        }
        len = zfs_sm_seg(buf, len, cap, cap, ty, off >> 9, sz >> 9, zfs_top_id, 2);
        if (len < 0) { return zfs_wno("log space map over its planned size"); }
        if (ty == 0) { net = net + sz; } else { net = net - sz; }
        i = j2;
    }
    var b = zfs_bonus(ldn);
    store64(b, zfs_wc_lo);
    store64(b + 8, len);
    store64(b + 16, net);
    return 0;
}
# The commit's new state, published once uberblock T is durable (design § d.6): the reader's MOS meta-dnode, statfs's
# used (the root dsl_dir's), and the writer's tables exactly as a mount would load them from T (design § k.18) — log T
# appended to the log list, U[i] = T where it was preset, spacemap_histogram's refcount + 1, the pool's allocated bytes
# + ALLOC - FREE, and log T's entries summed into each metaslab's unflushed count and net by the MOUNT's own scan
# (zfs_wsm_walk over log T read back from the device, checksum verified). B4: every dataset of the txg gets its new
# objset's meta-dnode into the reader's slot (zfs_ds(di) + 0 — the reader then sees T's blocks), and the first-commit
# preset is spent. Then the dirty set and the extent list go. 0 / -1 (the pool is then read-only: T is durable, the
# writer's tables are not).
fn zfs_wc_pub(t) {
    var oe = zfs_wmos_os();
    var rd = zfs_wmos_dn(zfs_w_rdd);
    var ldn = zfs_wmos_dn(zfs_wc_lo);
    if (oe < 0 || rd == 0 || ldn == 0) { return zfs_wfail(t, "publish: the plan is gone", 0 - 1); }
    memcpy(zfs_mem + ZR_MOS, zfs_dirty_buf(oe), 512);
    zfs_used = load64(zfs_bonus(rd) + 40);
    var j = 0;
    while (j < zfs_wd_n) {
        var dse = zfs_dse(j);
        var de = zfs_dirty_find(load64(dse), ZWO_OSB, 0, 0);
        if (de < 0) { return zfs_wfail(t, "publish: a dataset's objset is gone", 0 - 1); }
        memcpy(zfs_ds(load64(dse + 16)), zfs_dirty_buf(de), 512);
        j = j + 1;
    }
    zfs_wc_first = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        if (((load64(&zfs_wc_pre + (i >> 6) * 8) >> (i & 63)) & 1) == 1) { store64(zfs_msent(i) + 8, t); }
        # (B10) a flushed metaslab's space map holds its unflushed net now; log T's entries are summed in below
        if (zfs_wh_bit(&zfs_wl_fl, i) == 1) {
            var fe = zfs_msent(i);
            store64(fe + 16, load64(fe + 16) + load64(fe + 56));
            store64(fe + 48, 0);
            store64(fe + 56, 0);
        }
        i = i + 1;
    }
    # (B10) the destroyed logs leave the (ascending) list — its first zfs_wl_nd — and spacemap_histogram's refcount
    if (zfs_wl_nd > 0) {
        var q = 0;
        while (q + zfs_wl_nd < zfs_nlogs) {
            memcpy(zfs_wmem + ZWA_LOG + q * 16, zfs_wmem + ZWA_LOG + (q + zfs_wl_nd) * 16, 16);
            q = q + 1;
        }
        zfs_nlogs = zfs_nlogs - zfs_wl_nd;
        zfs_w_smh = zfs_w_smh - zfs_wl_nd;
    }
    var lg = zfs_wmem + ZWA_LOG + zfs_nlogs * 16;
    store64(lg, t);
    store64(lg + 8, zfs_wc_lo);
    zfs_nlogs = zfs_nlogs + 1;
    zfs_w_alloc = zfs_w_alloc + zfs_tx_alloc - zfs_tx_free;
    zfs_w_defer = zfs_w_defer + zfs_tx_free;
    zfs_w_smh = zfs_w_smh + 1;
    zfs_w_ebr = zfs_w_ebr - zfs_wdl_nm;
    zfs_ws_ms = 0 - 1;
    zfs_ws_log = 1;
    zfs_ws_lt = t;
    if (zfs_wsm_walk(ldn) != 0) { return zfs_wfail(t, "log space map unreadable after the commit", 0 - 1); }
    zfs_wc_mark();                                    # (B11) the hold pauses here: the op list's plan line is console time
    zfs_wt_stats(t, ldn);
    zfs_dirty_reset();
    # (B11) T is durable: the frees of T - 2 leave the window — and (the merge, k.133 (a)) every ghost they leave with is
    # retired. (B11 review) A release that fails leaves the pool read-only (zfs_wfail, named) but the commit answers 0 —
    # T's writes ARE on disk: no EIO for them (zfs_wp_eref). Then (B10 review, k.119) hygiene's minimum for the next txg.
    # (The merge, k.133 (b)) Both read the device under fs_lock — the release walks every log and ghost leaving the
    # window, hygiene's dry flush may load a metaslab (its space map and every log >= U): they belong to the hold, and
    # get its interrupt windows, as the commit before them (zfs_wc_tail)
    zfs_wc_tail(t);
    return 0;
}
# (The merge, k.133 (b)) The publish's tail, timed and windowed like the commit (the B11 section): windows reopened, the
# release and hygiene's minimum run, the stretch added to zfs_wc_hold, the longest gap and the windows merged into the
# b11 line's figures. Without it B11's hold stopped at zfs_wc_mark and B10's dry flush ran after, uncounted, IF=0 and no
# window — the longer commits B10 brought hid their tail. 0.
fn zfs_wc_tail(t) {
    var t1 = klog_uptime_us();
    var im = zfs_wc_imax;
    var iw = zfs_wc_iwin;
    kirqw_begin(zfs_wirq_on());
    zfs_wdef_rel(t);
    zfs_wl_hres(t + 1);
    kirqw_end();
    zfs_wc_hold = zfs_wc_hold + (klog_uptime_us() - t1);
    if (kirqw_max > im) { im = kirqw_max; }
    zfs_wc_imax = im;
    zfs_wc_iwin = iw + kirqw_n;
    return 0;
}
# ⭐ THE COMMIT of txg T = zfs_txg + 1 (design § d). The caller holds fs_spin_lock; this never takes it (it does not
# nest, design § b.3). The DATASET phase (zfs_wd_phase, B4: every dirty dataset turned into its new objset and ds_bp,
# its accounting up the dsl_dirs), the MOS phase (zfs_wc_plan: log T, the refcount, the log ZAP, U[], the MOS's space,
# the chain — re-planned when a reserved indirect overflows, k.25), then zfs_commit_ubw: FLUSH (every block of T
# durable), uberblock T naming the new rootbp in all four labels, FLUSH; then zfs_wc_pub. ⭐ NOTHING THE READER USES
# MOVES BEFORE UBERBLOCK T IS DURABLE: the plan works on private copies in the writer area, so a failure anywhere
# before leaves the reader at T - 1, every block of which is still on disk (nothing T - 1 references is ever written,
# no free is reused before it leaves the deferral window — T - 3 and older, k.125) — zfs_wfail drops the writer's state with the writer area and the pool is read-only
# until reboot. ⭐ k.24: the first commit after the mount presets U = T for every metaslab with a space map and U 0, so
# no txg needs a second round (which would have to replay a finalised dataset phase); a metaslab with U 0 that still
# gets an entry fails the commit by name. Refused (nothing done): a read-only pool, extents or dirty MOS blocks before
# the commit (only dataset blocks may wait for it — zfs_wd_dirty's), the log list full. 0 / -1 named.
# (B7 review, k.70) zfs_wc_in marks the commit's own dirtying (its dataset-phase COWs go through zfs_wblk): their
# deferred predecessors ride on zfs_wfb_meta's ZWF_CRSV margin, never on an admission that could refuse them.
# (B11) Whoever commits the open txg commits a pending policy-B write in it (zfs_wp_ref cleared first); the commit's hold
# is timed and its interrupt windows opened (kirqw, the B11 section: live only with the scheduler running, on NVMe / AHCI).
var zfs_wc_in = 0;
fn zfs_commit() {
    zfs_wp_ref = 0;
    zfs_wp_owed = 0;
    zfs_wc_in = 1;
    zfs_wc_t0 = klog_uptime_us();
    kirqw_begin(zfs_wirq_on());
    var r = zfs_commit1();
    if (kirqw_cpu != 0) { zfs_wc_mark(); }
    zfs_wc_in = 0;
    zfs_wt_b11line(r);                                # (B11) the op list's b11 line (ZFS_WRITE_OPS; a no-op twin otherwise)
    return r;
}
fn zfs_commit1() {
    if (zfs_rw != 1) { return zfs_wno("pool read-only"); }
    if (zfs_xl_n != 0) { return zfs_wno("extents before the commit"); }
    var k = 0;
    while (k < zfs_dx_n) {
        if (load64(zfs_dent(k)) == 0) { return zfs_wno("MOS blocks dirty before the commit"); }
        k = k + 1;
    }
    # (B10 review, k.119) at the log limit the commit still runs when its hygiene can destroy a log — judged after the
    # plan (below); refused here, nothing done, only when the ghost table makes hygiene skip (zfs_wl_plan's skip 2)
    if (zfs_nlogs >= ZWK_MAXLOG && zfs_ngho + zfs_nlogs > ZWL_MAXGHO) { return zfs_wnon("log space maps at the limit and the ghost table full ", ZWK_MAXLOG); }
    var t = zfs_txg + 1;
    memset(&zfs_wc_pre, 0, 256);
    memset(&zfs_wh_set, 0, 256);
    memset(&zfs_wh_pend, 0, 256);
    zfs_wh_n = 0;
    if (zfs_wc_first == 1) {
        var i = 0;
        while (i < zfs_ms_count) {
            var me = zfs_msent(i);
            if (load64(me) != 0 && load64(me + 8) == 0) {
                var pw = &zfs_wc_pre + (i >> 6) * 8;
                store64(pw, load64(pw) | (1 << (i & 63)));
            }
            i = i + 1;
        }
    }
    zfs_wc_rnd = 1;
    zfs_wc_rpl = 0;
    zfs_wc_nrsv = 0;
    zfs_wc_du = 0;
    zfs_wc_dc = 0;
    memcpy(&zfs_wc_rbp, zfs_mem + ZR_UB + 40, 128);
    # (B10) log hygiene first — nothing of T is allocated or freed before it (design § c.5; zfs_wl_plan)
    var r = zfs_wl_plan(t);
    if (r == 0) { r = zfs_wd_phase(t); }
    if (r == 0) { r = zfs_wc_plan(t); }
    if (r == 2) {
        zfs_wno("U[] preset incomplete: an entry for a metaslab whose U is 0");
        r = 0 - 1;
    }
    # (B10 review, k.119) the log table holds ZWK_MAXLOG: at the limit, a txg whose hygiene destroyed none fails by name
    # before its uberblock (T - 1 stays the pool's)
    if (r == 0 && zfs_nlogs - zfs_wl_nd >= ZWK_MAXLOG) {
        zfs_wnon("log space maps at the limit: hygiene destroyed none in txg ", t);
        r = 0 - 1;
    }
    if (r != 0) { return zfs_wfail_now(t); }
    if (zfs_commit_ubw(&zfs_wc_rbp) != 0) { return 0 - 1; }
    return zfs_wc_pub(t);
}

# --- B4: the DATASET phase of zfs_commit (design § d.1, § e; WPA § 5, § 7, § 8) -----------------------------------
# A dataset's dirty blocks — dirtied through zfs_wd_dirty / zfs_wblk, keyed by the dataset's MOS object — become
# dataset T before the MOS phase plans, in zfs_dirty_plan's order inside each objset (zfs_wd_phase):
#   (a) every ordinary object's blocks, level by level — data OFF (ZWP_HOLE where compression is on: zeros become a
#       hole), metadata ZLE (D4) — each built (zfs_bp_build), written, its BP stored in its parent's copy, BORN into
#       the dataset (zfs_wd_born) and its predecessor KILLED (zfs_wd_kill), each object's dn_used moved by both;
#   (b) user / group / project accounting (zfs_wd_uacct): every dnode whose bytes changed against T - 1 gets
#       DNODE_FLAG_USERUSED_ACCOUNTED (+ USEROBJUSED) and its exact deltas, applied to the special ZAPs;
#   (c) those ZAPs, the meta-dnode's dnode blocks (fill = allocated dnodes) and its indirect chain (six levels on every
#       OpenZFS ZPL objset), the objset_phys (fill = Σ the meta-dnode's top-level fills; ZIL header, os_type, os_flags,
#       MACs, lsize preserved) — its BP into ds_bp, then the dataset's born-minus-killed into its dsl_dataset_phys and up
#       its dsl_dir chain with parent_delta (zfs_wd_dsdelta; D13).
# Nothing here depends on the MOS phase or on another dataset — every block's content is final before it is built —
# so there is no chain, no reservation and no re-plan: every psize is exact. Policy per block (dmu_write_policy,
# dmu.c:2356-2559 — D5 / D6): data = the dnode's checksum, else the dataset's (fletcher4 / sha256 / sha512 where the
# dataset has it active, else fletcher4) and its copies; metadata = the dataset's metadata checksum and copies + 1 under
# redundant_metadata (zfs_md_copies). Kills are dsl_dataset_block_kill's branch A (birth > ds_prev_snap_txg: FREED —
# zfs_wfree_bp, deferred 2 txgs — k.125) or an embedded predecessor's accounting — or (B7) DEFERRED to free_bpobj for a
# gang, dedup or possibly-cloned predecessor (zfs_wd_defer / zfs_wfb_add) — or (B9) branch B, DEADLISTED, for one a
# snapshot owns (zfs_wdl_add); an encrypted one is refused when the block is DIRTIED (zfs_wd_okbp), never here.
fn zfs_dse(k) { return zfs_wmem + ZWA_DSX + k * 128; }
# The open txg's entry of the dataset whose MOS object is os, or 0.
fn zfs_wds_find(os) {
    var k = 0;
    while (k < zfs_wd_n) {
        if (load64(zfs_dse(k)) == os) { return zfs_dse(k); }
        k = k + 1;
    }
    return 0;
}
# Property pname of dsl_dir dobj at THAT dir only — a non-inheritable property (refreservation, refquota):
# dsl_prop_get_dd stops after the first dir for them (dsl_prop.c:149-151). The value, 0 unset, -2 unreadable.
fn zfs_wpropl(dobj, pname) {
    var dd = zfs_wdn(2);
    var zd = zfs_wdn(3);
    if (zfs_dnode(zfs_mem + ZR_MOS, dobj, dd) != 0) { return 0 - 2; }
    var pz = load64(zfs_bonus(dd) + 80);
    if (pz == 0) { return 0; }
    if (zfs_dnode(zfs_mem + ZR_MOS, pz, zd) != 0) { return 0 - 2; }
    var v = 0;
    var r = zfs_prop_find(zd, pname, 8, 1, &v);
    if (r == 1) { return v; }
    if (r == (0 - 2)) { return 0; }
    return 0 - 2;
}
# The checksum a DATA block gets (zio_checksum_select, dmu.c:2466-2469): c = the dnode's dn_checksum, 0 inheriting the
# dataset's resolved one (dse +64); on (1) and anything agnos does not write (off, fletcher2, noparity) -> fletcher4 —
# legal, the checksum is per BP (D5) — and sha512 only where the dataset has it active (dse +104 bit 3: no per-dataset
# feature activation, WPA § 4 MUST NOT).
fn zfs_wdck(c, dse) {
    if (c == 0) { return load64(dse + 64); }
    if (c == 7 || c == 8) { return c; }
    if (c == 11 && (load64(dse + 104) & 8) != 0) { return 11; }
    return 7;
}
# Open grafted dataset slot di for write in the open txg (design § a.2, § e): its entry, created on first use —
#   +0 the dataset's MOS object · +8 its dsl_dir · +16 the slot · +24 / +32 / +40 the txg's dsize / psize / ucsize born
#   minus killed · +48 refreservation (ds_reserved) · +56 ds_prev_snap_txg · +64 the data checksum · +72 the metadata
#   checksum · +80 copies · +88 redundant_metadata · +96 compression · +104 flags: 1 user/group accounting, 2 object
#   accounting, 4 project accounting, 8 sha512 active on the dataset, 16 / 32 os_flags' USEROBJACCOUNTING_COMPLETE /
#   PROJECTQUOTA_COMPLETE (OpenZFS enforces object / project quotas only then — zfs_wd_idq3; B6 review), 64 an
#   objset_phys OpenZFS grows IN MEMORY at open (< 2 KiB, or < 4 KiB on a project_quota pool — dmu_objset.c:520-537:
#   its creates would carry PROJID and make the projectused ZAP, so zfs_wc1 refuses them) · +112 refquota · +120 the
#   NEW keys every accounting microzap can still take this txg (its free chunks + 8 per 512 B it may grow to 128 KiB,
#   the least of them; zfs_wd_dirty1 reserves from it)
# — its objset_phys dirtied (zfs_wos_os), which decides the accounting: dmu_objset_userused_enabled (an objset_phys of
# >= 2 KiB, OBJSET_PHYS_SIZE_V2 — the user / group-used dnodes must exist, OpenZFS would create them), object counts
# where userobj_accounting is enabled, project where project_quota is enabled and the objset_phys is 4 KiB on disk
# (dmu_objset.c:1797-1818; a 2 KiB objset keeps its size, design § e.3); their ZAPs microzaps of one block or (B8) fat
# ones, each top-level BP one the commit can kill (zfs_wd_okbp — the commit dirties their blocks, zfs_wd_uqapply, so they
# are judged HERE, B4 review; a fat ZAP's deeper blocks when an op's zfs_wz_urs dirties them) and, a snapshot's,
# counted for its deadlist entry HERE too (zfs_wdl_q — B9 review, k.100: uncounted, a txg whose only snapshot-owned
# kills they were loaded its deadlist INSIDE the commit, where every refusal fails the pool; a fat ZAP's deeper blocks
# are counted by zfs_wblk when zfs_wz_urs dirties them, k.107). +120 (B8): 16 bits per ZAP — a microzap's room for NEW
# keys (free chunks + 8 per 512 B of growth to 128 KiB), 0xFFFF a fat one (zfs_wz_ucap).
# Refused: a read-only pool or dataset (B7: block_cloning active no longer — every kill is a free_bpobj append,
# zfs_wd_defer), more than ZK_MAXDS datasets, unreadable properties, an accounting microzap of more than one block — or
# (B8 review) a normalised one, or a fat one zfs_wz_kind refuses: the commit's zap_increment would refuse it —, a BP the
# commit could not kill. The entry, or 0 named (the caller truncates the dirty set, zfs_wd_dirty).
fn zfs_wds_open(di) {
    if (zfs_rw != 1) {
        zfs_wno("pool read-only");
        return 0;
    }
    if (di < 0 || di >= zfs_nds) {
        zfs_wnon("no dataset slot ", di);
        return 0;
    }
    var ds = zfs_ds(di);
    var os = load64(ds + 840);
    var e = zfs_wds_find(os);
    if (e != 0) { return e; }
    if (load64(ds + 1016) != 1) {
        zfs_wno("dataset read-only");
        return 0;
    }
    if (zfs_wd_n >= ZK_MAXDS) {
        zfs_wnon("datasets per txg over ", ZK_MAXDS);
        return 0;
    }
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, os, dn) != 0) {
        zfs_wno("dataset unreadable");
        return 0;
    }
    var bon = zfs_bonus(dn);
    var dir = load64(bon);
    var pst = load64(bon + 16);
    var fl = 0;
    if (load8(dn) == ZWK_ZAPMD) {
        var v = 0;
        var zr = zfs_zap_lookup(dn, "org.illumos:sha512", 18, 8, 1, &v);
        if (zr >= 0) { fl = 8; }
        elif (zr != (0 - 2)) {
            zfs_wno("unreadable: org.illumos:sha512");
            return 0;
        }
    }
    var ck = zfs_wprop(dir, "checksum", 1);
    var cm = zfs_wprop(dir, "compression", 1);
    var cp = zfs_wprop(dir, "copies", 1);
    var rm = zfs_wprop(dir, "redundant_metadata", 0);
    var rr = zfs_wpropl(dir, "refreservation");
    var rq = zfs_wpropl(dir, "refquota");
    if (ck < 0 || cm < 0 || cp < 0 || rm < 0 || rr < 0 || rq < 0) {
        zfs_wno("properties unreadable");
        return 0;
    }
    if (cp < 1 || cp > 3 || rm > 3) {
        zfs_wno("copies / redundant_metadata out of range");
        return 0;
    }
    var mck = zfs_wmdck(ck);
    if (mck == 11 && (fl & 8) == 0) { mck = 7; }
    if (mck != 7 && mck != 8 && mck != 11) {
        zfs_wnon("metadata checksum ", mck);
        return 0;
    }
    e = zfs_dse(zfs_wd_n);
    memset(e, 0, 128);
    store64(e, os);
    store64(e + 8, dir);
    store64(e + 16, di);
    store64(e + 48, rr);
    store64(e + 56, pst);
    store64(e + 72, mck);
    store64(e + 80, cp);
    store64(e + 88, rm);
    store64(e + 96, cm);
    store64(e + 104, fl);
    store64(e + 112, rq);
    store64(e + 64, 7);                          # the dataset's own (inherit / on: fletcher4), zfs_wdck's fallback
    store64(e + 64, zfs_wdck(ck, e));
    if (zfs_wdl_open(zfs_wd_n, os, bon) != 0) { return 0; }
    zfs_wd_n = zfs_wd_n + 1;
    var oe = zfs_wos_os(os);
    if (oe < 0) { return 0; }
    var osb = zfs_dirty_buf(oe);
    var osl = load64(zfs_dent(oe) + 32);
    var osf = load64(osb + 712);                 # os_flags: after the meta-dnode (512) and the ZIL header (192), os_type
    if ((osf & 2) != 0) { fl = fl | 16; }
    if ((osf & 4) != 0) { fl = fl | 32; }
    if (osl < 2048 || (osl < 4096 && (zfs_w_feat & 64) != 0)) { fl = fl | 64; }
    if (osl >= 2048) {
        if (load8(osb + 1024) != 39 || load8(osb + 1536) != 39) {
            zfs_wno("user accounting objects not created");
            return 0;
        }
        fl = fl | 1;
        if ((zfs_w_feat & 32) != 0) { fl = fl | 2; }
        if (osl >= 4096 && (zfs_w_feat & 64) != 0) {
            if (load8(osb + 2048) != 39) {
                zfs_wno("project accounting object not created");
                return 0;
            }
            fl = fl | 4;
        }
        var cap = 0;
        var k = 0;
        while (k < 2 + ((fl >> 2) & 1)) {
            var sd = osb + 1024 + k * 512;
            var t = 0;
            while (t < load8(sd + 3)) {
                var tb = sd + 64 + t * 128;
                if (zfs_wd_okbp(e, tb) != 0) { return 0; }
                # (B9 review, k.100) the commit COWs this block (zfs_wd_uqapply) with zfs_wc_in set, where zfs_wblk counts
                # nothing: a snapshot's predecessor is DEADLISTED there, so its append is counted HERE, as the objset_phys's
                # is (zfs_wos_os) — the deadlist's load and every refusal of it at the admission, never inside the commit.
                # (merge, k.107) Every top-level BP: a fat ZAP's (B8) as a microzap's
                if (zfs_wc_in == 0 && zfs_bp_hole(tb) == 0 && zfs_wugt(zfs_bp_birth(tb), pst) == 0 && zfs_wdl_q(e, tb, 0) != 0) { return 0; }
                t = t + 1;
            }

            var b = zfs_obj_blk(sd, 0, 1);
            if (b == 0) {
                zfs_wno("user accounting ZAP unreadable");
                return 0;
            }
            if (load64(b) == ((1 << 63) | 3) && (load64(sd + 16) != 0 || load8(sd + 2) != 1)) {
                zfs_wno("user accounting microzap of more than one block");
                return 0;
            }
            # (B8 review) the shape the commit's zap_increment writes, judged here and never inside the commit (the B4
            # review's rule): a microzap not normalised (zfs_wz_op refuses its add), else a fat ZAP the writer's code
            # takes (zfs_wz_kind: the magic, no zap_flags, a power-of-two block)
            if (load64(b) == ((1 << 63) | 3)) {
                if (load64(b + 16) != 0) {
                    zfs_wno("a normalised user accounting microzap (u8_textprep not built)");
                    return 0;
                }
            } else {
                zfs_wz_open(os, ZWO_USER + k, sd);
                if (zfs_wz_kind() != 1) {
                    if (zfs_wr_lit == 0) { zfs_wno("user accounting ZAP unreadable"); }
                    return 0;
                }
            }
            cap = cap | (zfs_wz_ucap(sd, b) << (16 * k));
            k = k + 1;
        }
        store64(e + 120, cap);
    }
    store64(e + 104, fl);
    return e;
}
# May the commit kill the BP at bp, replaced in dataset dse (dsl_dataset_block_kill, dsl_dataset.c:254-376)? A hole or
# an embedded block (accounting only), a normal block born after ds_prev_snap_txg (BP_GET_BIRTH — the physical birth
# under blk_prop2's rewrite flag, zfs_bp_birth): FREED, branch A — or (B9) one born at or before it: a snapshot's (a
# clone's origin's), DEADLISTED, branch B (zfs_wdl_add; the gate opened the dataset only with a deadlist agnos
# writes). Refused: one with the crypt bit. (B7) A gang or dedup block, or any block while block_cloning / fast_dedup is
# active, is killable — branch A DEFERS it to free_bpobj (zfs_wd_defer) — unless the pool has no free_bpobj / $FREE.
# 0 / -1 named.
fn zfs_wd_okbp(dse, bp) {
    var pr = load64(bp + 48);
    if (((pr >> 39) & 1) == 1 || zfs_bp_hole(bp) == 1) { return 0; }
    if (((pr >> 61) & 1) == 1) { return zfs_wno("rewrite of an encrypted block"); }
    if (zfs_wugt(zfs_bp_birth(bp), load64(dse + 56)) == 0) { return 0; }
    if (zfs_wd_defer(bp) == 1 && (zfs_w_fbo == 0 || zfs_w_fdd == 0)) { return zfs_wno("a gang, dedup or clone kill needs the pool's free_bpobj and $FREE"); }
    return 0;
}
# (B7 review, design k.70) The metadata-arena bytes the commit's free_bpobj appends will dirty for q deferred kills and
# ZWF_FBM more — the commit's own (the accounting ZAPs it dirties: their predecessors defer too while block_cloning is
# active) and the few a write or a walk counts between two admissions (zfs_wblk): the L0 blocks from bpo_num_blkptrs to
# its new end, and at every indirect level that end needs (zfs_wfb_add -> zfs_wf_levels) the blocks its path spans.
# B7 as built never counted them: a truncation txg of ~5,000 deferred kills (block_cloning active) ran the commit out of
# the arena — `dirty metadata full`, the pool read-only. 0 while nothing defers. Every admission adds it (zfs_wf_mfit).
fn zfs_wfb_meta(q) {
    if (zfs_w_fbo == 0 || (q <= 0 && (zfs_w_feat & 144) == 0)) { return 0; }
    if (zfs_wfb_c < 0) {
        var d[512];
        if (zfs_dnode(zfs_mem + ZR_MOS, zfs_w_fbo, &d) != 0) { return ZWK_MARENA; }
        zfs_wfb_c = load64(zfs_bonus(&d));
        zfs_wfb_bs = load16(&d + 8) << 9;
        zfs_wfb_ib = 1 << load8(&d + 1);
        zfs_wfb_np = load8(&d + 3);
    }
    return zfs_wbpo_meta(zfs_wfb_c, q + ZWF_FBM, zfs_wfb_bs, zfs_wfb_ib, zfs_wfb_np);
}
# The bytes q appends to a bpobj dirty — num BPs committed, blocks of bs bytes, indirect blocks of ib, np blkptrs: the
# L0 blocks from num's to the new end's and, at every indirect level that end needs (zfs_wbpo_add -> zfs_wf_levels),
# the blocks its path spans. free_bpobj's (zfs_wfb_meta) and every deadlist entry's (zfs_wdl_meta).
fn zfs_wbpo_meta(num, q, bs, ib, np) {
    var epb = bs / 128;
    var b0 = num / epb;
    var bl = (num + q - 1) / epb;
    var by = (bl - b0 + 1) * bs;
    var ie = ib / 128;
    var dv = 1;
    var cap = np;
    while (bl >= cap) {
        dv = dv * ie;
        by = by + (bl / dv - b0 / dv + 1) * ib;
        cap = cap * ie;
    }
    return by;
}
# (B10 review, k.119) The metadata arena an admission may fill: all but ZWF_MRSV (the blocks the commit dirties itself)
# and ZWL_HAR, HYGIENE'S OWN — the arena grew by it, so every admission's limit is the pre-review one (no op, no pinned
# txg count changes) and a txg its admissions filled to the bound still holds its first flush and every live log's
# destruction (zfs_wl_plan, inside the commit, sees the whole arena less ZWF_MRSV).
fn zfs_wf_alim() {
    if (zfs_wc_in == 1) { return ZWK_MARENA - ZWF_MRSV; }
    return ZWK_MARENA - ZWF_MRSV - ZWL_HAR;
}
# Does the open txg's metadata, nm more bytes, its deferred kills' free_bpobj appends (zfs_wfb_meta), (B8) the fat
# accounting ZAPs' growth reserved for the commit (zfs_wz_mres, zfs_wz_urs) and (B9) its snapshot-owned kills' deadlist
# appends (zfs_wdl_meta: each counted when its block was dirtied or its kill listed — a write or a truncation predicts a
# block's whole path first, zfs_wdl_path; no reserve since the B9 review, k.100) stay within the arena less what the
# commit dirties itself (ZWF_MRSV)? 1 / 0.
fn zfs_wf_mfit(nm) {
    if (zfs_dx_meta + nm + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + zfs_wdl_meta() <= zfs_wf_alim()) { return 1; }
    return 0;
}
# (B9 review, k.99) The most bytes q appends to a bpobj can dirty in ONE txg for any committed count from n0 to n1 (its
# blocks bs, indirect blocks ib, np blkptrs) — zfs_wbpo_meta's maximum over the range: the L0 window spans two blocks
# when a count in the range puts q across a block's end, and each indirect level the end needs two where the range
# crosses one of its blocks. A truncation's bound on a LATER txg's first step (zfs_wf_dlscan).
fn zfs_wbpo_mx(n0, n1, q, bs, ib, np) {
    var epb = bs / 128;
    var by = bs;
    if ((n0 % epb) + (n1 - n0) + q - 1 >= epb) { by = bs * 2; }
    var b0 = n0 / epb;
    var bl = (n1 + q - 1) / epb;
    var ie = ib / 128;
    var dv = 1;
    var cap = np;
    while (bl >= cap) {
        dv = dv * ie;
        if (b0 / dv != bl / dv) { by = by + ib * 2; } else { by = by + ib; }
        cap = cap * ie;
    }
    return by;
}
# ⭐ B7 (design § e.2, D15; dsl_dataset.c:298-331): is the kill of bp DEFERRED — appended to the pool's free_bpobj and
# charged to $FREE instead of freed? A gang block (any DVA's gang bit: its tree is the async destroy's to walk), a dedup
# block (BP_GET_DEDUP: the DDT holds its references), or ANY block while block_cloning or fast_dedup is active (agnos
# reads no BRT: brt_maybe_exists' superset). 1 / 0.
fn zfs_wd_defer(bp) {
    if ((zfs_w_feat & 144) != 0) { return 1; }
    if (((load64(bp + 48) >> 62) & 1) == 1) { return 1; }
    var d = 0;
    while (d < 3) {
        if ((load64(bp + d * 16 + 8) >> 63) != 0) { return 1; }
        d = d + 1;
    }
    return 0;
}
# bpobj_enqueue (bpobj.c:872-941) into bpobj object obj, the kill of bp: the BP stored at index bpo_num_blkptrs (byte
# n x 128 of the object; its block dirtied in the MOS, a new one past dn_maxblkid — the dnode's levels grown where they
# must) with its checksum zeroed unless dedup, an embedded BP reduced to blk_prop + logical birth (B9: a deadlist takes
# them — they carry an UCSIZE), and fill 0 (BP_SET_FREE 0, bp_freed B_FALSE); the header's bpo_num_blkptrs + 1,
# bpo_bytes + u (dsize) and — a bonus of >= 32 bytes (bpo_havecomp) — bpo_comp / bpo_uncomp + c / uc (PSIZE / UCSIZE).
# Dataset phase only: MOS blocks it dirties are planned by the MOS phase after. 0 / -1.
fn zfs_wbpo_add(obj, bp, u, c, uc) {
    var dn = zfs_wmos_dn(obj);
    if (dn == 0) { return 0 - 1; }
    var bon = zfs_bonus(dn);
    var n = load64(bon);
    var epb = (load16(dn + 8) << 9) / 128;
    var bid = n / epb;
    if (bid > load64(dn + 16)) {
        if (zfs_wf_levels(dn, 0, obj, bid) != 0) { return 0 - 1; }
        store64(dn + 16, bid);
    }
    var e = zfs_wblk(dn, 0, obj, 0, bid);
    if (e < 0) { return 0 - 1; }
    var p = zfs_dirty_buf(e) + (n % epb) * 128;
    var pr = load64(bp + 48);
    memcpy(p, bp, 128);
    if (((pr >> 39) & 1) == 1) {
        memset(p, 0, 128);
        store64(p + 48, pr);
        store64(p + 80, load64(bp + 80));
    } elif (((pr >> 62) & 1) == 0) { memset(p + 96, 0, 32); }
    store64(p + 88, 0);
    store64(bon, n + 1);
    store64(bon + 8, load64(bon + 8) + u);
    if (load16(dn + 10) >= 32) {
        store64(bon + 16, load64(bon + 16) + c);
        store64(bon + 24, load64(bon + 24) + uc);
    }
    return 0;
}
# The kill of bp appended to the pool's free_bpobj (zfs_wbpo_add; never an embedded BP: zfs_wd_kill accounts those
# itself), its dsize / PSIZE / UCSIZE summed for $FREE (zfs_wfb_charge: dsl_dir_diduse_space(dp_free_dir, HEAD, ...),
# dsl_dataset.c:327-331, applied once per txg — linear). 0 / -1.
fn zfs_wfb_add(bp) {
    var u = zfs_bp_dsize(bp);
    var c = (((load64(bp + 48) >> 16) & 0xFFFF) + 1) << 9;
    var uc = zfs_bp_ucsize(bp);
    if (zfs_wbpo_add(zfs_w_fbo, bp, u, c, uc) != 0) { return 0 - 1; }
    zfs_wfb_du = zfs_wfb_du + u;
    zfs_wfb_dc = zfs_wfb_dc + c;
    zfs_wfb_duc = zfs_wfb_duc + uc;
    zfs_wfb_n = zfs_wfb_n + 1;
    return 0;
}

# --- B9: SNAPSHOTTED DATASETS (design § e.2 branch B, § h B9; WPA § 7.3-7.4) ------------------------------------------
# dsl_dataset_block_kill's branch B (dsl_dataset.c:333-362): a block born at or before ds_prev_snap_txg still belongs to
# the previous snapshot — or, in a clone, to its origin — and MUST NOT be freed. It goes to the head's DEADLIST
# (dsl_deadlist_insert, dsl_deadlist.c:463-503): the entry whose mintxg is the largest key below the block's birth (an
# exact match takes the one before; none is zfs_panic_recover's — refused here), its bpobj appended to exactly as
# free_bpobj is (zfs_wbpo_add); an entry still naming the pool's shared empty_bpobj gets a bpobj of its own first
# (dle_enqueue -> bpobj_alloc, bpobj_decr_empty: zfs_wdl_mat); the deadlist header's dl_used / dl_comp / dl_uncomp
# += dsize / PSIZE / UCSIZE. An OLD-format deadlist (one BPOBJ, pools older than SPA_VERSION_DEADLISTS) is appended to
# directly. Then: the previous snapshot's ds_unique_bytes += dsize when the head is its ds_next_snap_obj and the block
# was born after ITS previous snapshot; the head dir's breakdown HEAD -> SNAP when the block was born after the dir's
# dd_origin_txg (dsl_dir_transfer_space, dsl_dir.c:1592-1613 — dd_used_bytes and every parent unchanged); and, as for
# any kill, ds_referenced / compressed / uncompressed down (branch C). ds_unique_bytes and the dirs' used / compressed /
# uncompressed do NOT move. An embedded block is deadlisted too (its UCSIZE), a gang, dedup or cloned one like any
# other (free_bpobj's deferral is branch A's). Summed per txg in the dataset's snapshot side (zfs_dsb), applied once
# with its own delta (zfs_wd_dsdelta). What the appends dirty is METADATA inside the commit, budgeted like k.70's
# free_bpobj: counted for its entry by the admission that dirties the block or lists the kill (zfs_wdl_q — the commit's
# own COWs by zfs_wds_open), predicted for a block's whole path before a write or a truncation dirties it
# (zfs_wdl_path), resolved for a whole truncation before its first txg (zfs_wf_okscan, zfs_wf_dlscan) — B9 review,
# k.99 / k.100: every load and refusal of a deadlist is an op's, never the commit's. A clone with a LIVELIST is refused
# at the gate.
fn zfs_dsb(k) { return zfs_wmem + ZWA_DSB + k * 128; }
fn zfs_dle(x) { return zfs_wmem + ZWA_DLE + x * 128; }
fn zfs_dsk(dse) {
    var d = dse - zfs_dse(0);
    if (d < 0 || d >= ZK_MAXDS * 128) { return ZK_MAXDS; }
    return d / 128;
}
# Is the object whose dnode is at dn a deadlist agnos writes — a DEADLIST (50) ZAP with a DEADLIST_HDR (51) bonus of
# >= 24 bytes, or the old format, a BPOBJ (5) with its BPOBJ_HDR (6)? 1 / 0.
fn zfs_wdl_ok(dn) {
    if (load8(dn) == 50 && load8(dn + 4) == 51 && load16(dn + 10) >= 24) { return 1; }
    if (load8(dn) == 5 && load8(dn + 4) == 6 && load16(dn + 10) >= 16) { return 1; }
    return 0;
}
# The snapshot side of the open txg's dataset entry k (zfs_dsb(k)), from its dsl_dataset_phys at bon (the dataset's MOS
# object os): +0 ds_deadlist_obj · +8 1 = the old format · +16 ds_prev_snap_obj · +24 that one's ds_prev_snap_txg ·
# +32 1 = its ds_next_snap_obj is this head · +40 dd_origin_txg — a clone's origin's ds_creation_txg, 0 otherwise
# (dsl_dir_hold_obj sets it for a clone only, dsl_dir.c:254-271) · +48 1 = its kills can be snapshot-owned (B9 review,
# k.101: ds_prev_snap_txg >= TXG_INITIAL — never under $ORIGIN@$ORIGIN, born in txg 1) · +56 / +64 / +72 the txg's
# branch-B kills: Σ dsize / PSIZE / UCSIZE · +80 their Σ dsize born after dd_origin_txg (HEAD -> SNAP) · +88 their Σ
# dsize the previous snapshot now holds alone (its ds_unique_bytes) · +96 its entries in ZWA_DLE, first << 32 | count +
# 1 (0 = not loaded yet) · +104 the deadlist ZAP's block size (0 for the old format). 0 / -1 named.
fn zfs_wdl_open(k, os, bon) {
    var sb = zfs_dsb(k);
    memset(sb, 0, 128);
    store64(sb, load64(bon + 64));
    var pv = load64(bon + 8);
    store64(sb + 16, pv);
    if (pv == 0 || zfs_wugt(ZWK_TXGI, load64(bon + 16)) == 1) { return 0; }
    store64(sb + 48, 1);
    var d[512];
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(sb), &d) != 0 || zfs_wdl_ok(&d) == 0) { return zfs_wno("deadlist unreadable"); }
    if (load8(&d) == 5) { store64(sb + 8, 1); } else { store64(sb + 104, load16(&d + 8) << 9); }
    if (zfs_dnode(zfs_mem + ZR_MOS, pv, &d) != 0) { return zfs_wno("previous snapshot unreadable"); }
    store64(sb + 24, load64(zfs_bonus(&d) + 16));
    if (load64(zfs_bonus(&d) + 24) == os) { store64(sb + 32, 1); }
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(bon), &d) != 0) { return zfs_wno("dsl_dir unreadable"); }
    var org = load64(zfs_bonus(&d) + 24);
    if (org != 0 && org != zfs_origin) {
        if (zfs_dnode(zfs_mem + ZR_MOS, org, &d) != 0) { return zfs_wno("clone origin unreadable"); }
        store64(sb + 40, load64(zfs_bonus(&d) + 56));
    }
    return 0;
}
# "%llx" back: the value of the l lowercase hex digits at p, or -1.
fn zfs_whexp(p, l) {
    if (l < 1 || l > 15) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < l) {
        var c = load8(p + i);
        if (c >= 48 && c <= 57) { v = (v << 4) | (c - 48); }
        elif (c >= 97 && c <= 102) { v = (v << 4) | (c - 87); }
        else { return 0 - 1; }
        i = i + 1;
    }
    return v;
}
# One deadlist entry of dataset entry k into ZWA_DLE (zfs_wdl_load): +0 k · +8 its mintxg · +16 its bpobj (the pool's
# empty_bpobj until zfs_wdl_mat) · +24 the kills the open txg counted for it (zfs_wdl_q) · +32 the bpobj's committed
# bpo_num_blkptrs · +40 its block size · +48 its indirect block size · +56 its dn_nblkptr — an empty_bpobj entry's the
# bpobj bpobj_alloc will make: 0, 128 KiB, 128 KiB, 3 · (B9 review) +64 the kills a truncation's scan found for it
# over its whole range (zfs_wf_okbps, k.99) · +72 +24 as zfs_wu_free found it, for its rollback (k.102). The table holds
# EVERY key of each deadlist loaded: past ZWK_MAXDLE (zfs_wt_dlmax under the op list) refused by name (k.104). 0 / -1
# named.
fn zfs_wdl_put(k, key, bo) {
    var mx = ZWK_MAXDLE;
    if (zfs_wt_dlmax > 0) { mx = zfs_wt_dlmax; }
    if (zfs_wdl_n >= mx) { return zfs_wnon("deadlist entries in one txg over ", mx); }
    var x = zfs_dle(zfs_wdl_n);
    memset(x, 0, 128);
    store64(x, k);
    store64(x + 8, key);
    store64(x + 16, bo);
    store64(x + 40, 0x20000);
    store64(x + 48, 0x20000);
    store64(x + 56, 3);
    if (bo == 0 || bo != zfs_w_ebo) {
        var d[512];
        if (zfs_dnode(zfs_mem + ZR_MOS, bo, &d) != 0 || load8(&d) != 5 || load8(&d + 4) != 6 || load16(&d + 10) < 16) { return zfs_wnon("deadlist bpobj unreadable: object ", bo); }
        store64(x + 32, load64(zfs_bonus(&d)));
        store64(x + 40, load16(&d + 8) << 9);
        store64(x + 48, 1 << load8(&d + 1));
        store64(x + 56, load8(&d + 3));
    }
    zfs_wdl_n = zfs_wdl_n + 1;
    return 0;
}
# The deadlist entries of dataset entry k, once per txg, from its COMMITTED deadlist (the reader's MOS: this txg's
# materialisations are kept in the table, nothing else changes a key) — every "%llx" key with its bpobj; the old
# format as one entry, key 0, the deadlist itself. 0 / -1 named.
fn zfs_wdl_load(k) {
    var sb = zfs_dsb(k);
    if (load64(sb + 96) != 0) { return 0; }
    var x0 = zfs_wdl_n;
    if (load64(sb + 8) == 1) {
        if (zfs_wdl_put(k, 0, load64(sb)) != 0) { return 0 - 1; }
    } else {
        var d[512];
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(sb), &d) != 0) { return zfs_wno("deadlist unreadable"); }
        var cur = 0;
        var r = zfs_zap_next(&d, &cur);
        while (r == 1) {
            var key = zfs_whexp(zfs_mem + ZR_NAME, zfs_it_nlen);
            if (key < 0 || zfs_it_vil != 8) { return zfs_wno("deadlist entry unreadable"); }
            if (zfs_wdl_put(k, key, zfs_it_val) != 0) { return 0 - 1; }
            r = zfs_zap_next(&d, &cur);
        }
        if (r < 0) { return zfs_wno("deadlist unreadable"); }
    }
    store64(sb + 96, (x0 << 32) | (zfs_wdl_n - x0 + 1));
    return 0;
}
# The entry of dataset entry k a block born in txg b goes to (dsl_deadlist_insert: the largest mintxg below b). Its
# ZWA_DLE index, or -1 named.
fn zfs_wdl_ent(k, b) {
    if (zfs_wdl_load(k) != 0) { return 0 - 1; }
    var ld = load64(zfs_dsb(k) + 96);
    var x = ld >> 32;
    var e = x + (ld & 0xFFFFFFFF) - 1;
    var best = 0 - 1;
    while (x < e) {
        var key = load64(zfs_dle(x) + 8);
        if (zfs_wugt(b, key) == 1 && (best < 0 || zfs_wugt(key, load64(zfs_dle(best) + 8)) == 1)) { best = x; }
        x = x + 1;
    }
    if (best < 0) { return zfs_wnon("a snapshot-owned block born before every deadlist entry: birth ", b); }
    return best;
}
# The metadata arena the open txg's branch-B kills will dirty inside the commit (k.70's rule, B9): for every entry with
# counted kills its bpobj's appends (zfs_wbpo_meta, ZWF_FBM more) and, while it still names the empty_bpobj, the new
# bpobj's dnode block and the deadlist ZAP block; for every open dataset whose kills can be snapshot-owned the
# deadlist's and the previous snapshot's dnode blocks. (B9 review, k.100) No reserve for an entry nothing counted yet —
# B9 kept one entry's (ZWK_DLMAT), which a walk reaching two new entries outran: every kill is counted when its block
# is dirtied or listed (zfs_wdl_q), and a write or a truncation predicts a block's whole path first (zfs_wdl_path).
# 0 when none.
fn zfs_wdl_meta() {
    var by = 0;
    var k = 0;
    while (k < zfs_wd_n) {
        if (load64(zfs_dsb(k) + 48) == 1) { by = by + 0x8000; }
        k = k + 1;
    }
    var x = 0;
    while (x < zfs_wdl_n) {
        var de = zfs_dle(x);
        if (load64(de + 24) > 0) {
            by = by + zfs_wbpo_meta(load64(de + 32), load64(de + 24) + ZWF_FBM, load64(de + 40), load64(de + 48), load64(de + 56));
            if (load64(de + 16) == zfs_w_ebo) { by = by + 0x4000 + load64(zfs_dsb(load64(de)) + 104); }
        }
        x = x + 1;
    }
    return by;
}
# Is the deadlist of the dataset whose snapshot side is sb a MICROZAP of one block — the committed one: no key changes
# in agnos's txgs (B9 review, k.100: a materialisation's value update in a FAT leaf is B8's — a deadlist outgrows its
# microzap at ~2,047 keys and OpenZFS never shrinks it back, so one pruned below ZWK_MAXDLE can still be fat)?
# zfs_wt_dlfat (the op list's knob) reads every one as fat. 0 / -1 named.
fn zfs_wdl_fatok(sb) {
    var d[512];
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(sb), &d) != 0) { return zfs_wno("deadlist unreadable"); }
    var b = zfs_obj_blk(&d, 0, 1);
    if (b == 0) { return zfs_wno("deadlist unreadable"); }
    if (zfs_wt_dlfat != 0 || load64(&d + 16) != 0 || load8(&d + 2) != 1 || load64(b) != ((1 << 63) | 3)) { return zfs_wno("deadlist is a fat ZAP (B8)"); }
    return 0;
}
# (B9 review, k.100) May entry x of the ZWA_DLE table — still naming the shared empty_bpobj, its FIRST kill being counted
# — be materialised by the commit (zfs_wdl_mat, whose refusals would fail the commit and the pool with it)? Judged at
# the admission: the empty_bpobj's LAST reference (zfs_w_ebr less every entry the txg will materialise, this one
# included — bpobj_decr_empty at 0 removes a MOS-directory key and frees the object, k.93) and a fat deadlist ZAP
# (zfs_wdl_fatok). zfs_wdl_mat keeps both checks as its backstop. sb: the dataset's snapshot side. 0 / -1 named.
fn zfs_wdl_matok(sb, x) {
    var n = 1;
    var i = 0;
    while (i < zfs_wdl_n) {
        if (i != x && load64(zfs_dle(i) + 24) > 0 && load64(zfs_dle(i) + 16) == zfs_w_ebo) { n = n + 1; }
        i = i + 1;
    }
    if (zfs_w_ebr - n <= 0) { return zfs_wno("empty_bpobj's last reference (its removal is not built)"); }
    return zfs_wdl_fatok(sb);
}
# Count one branch-B kill, of bp in dataset entry dse, for the commit's deadlist appends — at an admission, outside the
# commit. chk 0: count · 1 (zfs_wblk: a block an admitted op dirties) when it reaches an entry no kill reached yet, only
# if the txg still holds it · 2 (a kill-list entry, which can wait for the next txg) only if the txg still holds it.
# (B9 review, k.100) No reserve: a write or a truncation predicts a block's path before dirtying it (zfs_wdl_path), so
# 1 refuses only what an op's own txg cannot hold; and the FIRST kill counted for an entry still naming the empty_bpobj
# — one the commit will materialise — is judged here (zfs_wdl_matok): an op's refusal, never the commit's. 0 counted ·
# 1 does not fit, nothing counted · -1 named, nothing counted.
fn zfs_wdl_q(dse, bp, chk) {
    var k = zfs_dsk(dse);
    var x = zfs_wdl_ent(k, zfs_bp_birth(bp));
    if (x < 0) { return 0 - 1; }
    var de = zfs_dle(x);
    var q = load64(de + 24);
    if (q == 0 && load64(de + 16) == zfs_w_ebo && zfs_wdl_matok(zfs_dsb(k), x) != 0) { return 0 - 1; }
    store64(de + 24, q + 1);
    if ((chk == 1 && q == 0) || chk == 2) {
        if (zfs_dx_meta + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + zfs_wdl_meta() > zfs_wf_alim()) {
            store64(de + 24, q);
            return 1;
        }
    }
    return 0;
}
# (B9 review, k.100) The deadlist bytes the open txg will hold (zfs_wdl_meta) once block (lv, bid) of object obj — its
# DIRTY dnode dn, objset os, dataset entry dse — is dirtied with every indirect above it: each BP on its path from the
# top down to level lv that zfs_wblk will count (not dirty yet, not a hole, a snapshot's: zfs_wdl_q chk 1) counted for
# its entry, then uncounted again — read DIRTY-FIRST down the path as zfs_wf_bp reads it: a dirty block's predecessor
# is counted already, a hole has none and nothing under it has. Also zfs_wdl_pn = the entries the txg would then hold
# counted kills for, and zfs_wdl_pm = the metadata bytes of the path's indirects not dirty yet (level lv's own when lv
# > 0). So a write or a truncation admits a block with EVERY entry its walk reaches budgeted, and one that does not fit
# ends its txg before anything of it is dirtied. A first count of an entry still naming the empty_bpobj is judged as
# zfs_wdl_q judges it (zfs_wdl_matok). The bytes, or -1 named (zfs_wdl_ent's / zfs_wdl_matok's refusals, an
# unreadable indirect).
var zfs_wdl_pn = 0;
var zfs_wdl_pm = 0;
fn zfs_wdl_path(dse, dn, os, obj, lv, bid) {
    var k = zfs_dsk(dse);
    var epbs = load8(dn + 1) - 7;
    var un = 1 << zfs_ashift;
    var iba = ((1 << load8(dn + 1)) + un - 1) & (0 - un);
    var l = load8(dn + 2) - 1;
    if (l < 0 || l > 8) { return zfs_wnon("bad block address: object ", obj); }
    var bp[128];
    var xs[80];
    var nx = 0;
    var r = 0;
    var dead = 0;
    zfs_wdl_pm = 0;
    var top = zfs_shr(bid, epbs * (l - lv));
    if (l < lv || top >= load8(dn + 3)) { dead = 1; }            # past the tree: new holes all the way down
    else { memcpy(&bp, dn + 64 + top * 128, 128); }
    while (l >= lv && r == 0) {
        var e = zfs_dirty_find(os, obj, l, zfs_shr(bid, epbs * (l - lv)));
        var src = 0;
        if (e >= 0) {
            src = zfs_dirty_buf(e);
            dead = 0;
        } else {
            if (l > 0) { zfs_wdl_pm = zfs_wdl_pm + iba; }
            if (dead == 0 && zfs_bp_hole(&bp) == 1) { dead = 1; }
            if (dead == 0) {
                if (zfs_wugt(zfs_bp_birth(&bp), load64(dse + 56)) == 0) {
                    var x = zfs_wdl_ent(k, zfs_bp_birth(&bp));
                    if (x < 0) { r = 0 - 1; }
                    elif (load64(zfs_dle(x) + 24) == 0 && load64(zfs_dle(x) + 16) == zfs_w_ebo && zfs_wdl_matok(zfs_dsb(k), x) != 0) { r = 0 - 1; }
                    else {
                        store64(zfs_dle(x) + 24, load64(zfs_dle(x) + 24) + 1);
                        store64(&xs + nx * 8, x);
                        nx = nx + 1;
                    }
                }
                if (l > lv && r == 0) {
                    src = zfs_mc_get(&bp);
                    if (src == 0) { r = zfs_wnon("indirect unreadable: object ", obj); }
                }
            }
        }
        if (l > lv && r == 0) {
            if (src != 0) { memcpy(&bp, src + (zfs_shr(bid, epbs * (l - 1 - lv)) & ((1 << epbs) - 1)) * 128, 128); }
            else { dead = 1; }
        }
        l = l - 1;
    }
    if (r == 0) { r = zfs_wdl_meta(); }
    zfs_wdl_pn = 0;
    var i = 0;
    while (i < zfs_wdl_n) {
        if (load64(zfs_dle(i) + 24) > 0) { zfs_wdl_pn = zfs_wdl_pn + 1; }
        i = i + 1;
    }
    while (nx > 0) {
        nx = nx - 1;
        var y = load64(&xs + nx * 8);
        store64(zfs_dle(y) + 24, load64(zfs_dle(y) + 24) - 1);
    }
    return r;
}
# dle_enqueue's materialisation (dsl_deadlist.c:417-432): deadlist entry de of the dataset whose snapshot side is sb
# still names the pool's shared empty_bpobj, so it gets a bpobj of its own — bpobj_alloc (bpobj.c:78-95): a new MOS
# object (zfs_wmos_free) of DMU_OT_BPOBJ, 128 KiB blocks (SPA_OLD_MAXBLOCKSIZE), dmu_object_alloc's indirect shift 17,
# 1 + (320 - bonus) / 128 = 3 blkptrs, checksum / compression inherited, a DMU_OT_BPOBJ_HDR bonus of 48 bytes
# (BPOBJ_SIZE_V2) — 56 while livelist is active — then the entry's value in the deadlist microzap set to it in place
# (zap_update_int_key) and empty_bpobj's refcount in features_for_write - 1 (bpobj_decr_empty). The refcount's last
# reference would also remove the MOS directory's key and free the object, a fat-ZAP removal: refused — and so is a fat
# deadlist ZAP — at the ADMISSION since the B9 review (zfs_wdl_matok, k.100); the checks here are its backstop,
# unreached while every append the commit makes was counted (the op list's dlx=0). The new object, or -1 named.
fn zfs_wdl_mat(sb, de) {
    if (zfs_w_ebr - zfs_wdl_nm <= 1) { return zfs_wno("empty_bpobj's last reference (its removal is not built)"); }
    var dn = zfs_wmos_dn(load64(sb));
    if (dn == 0) { return 0 - 1; }
    if (load64(dn + 16) != 0 || load8(dn + 2) != 1) { return zfs_wno("deadlist is a fat ZAP (B8)"); }
    var e = zfs_wblk(dn, 0, load64(sb), 0, 0);
    if (e < 0) { return 0 - 1; }
    var zb = zfs_dirty_buf(e);
    if (load64(zb) != ((1 << 63) | 3)) { return zfs_wno("deadlist is a fat ZAP (B8)"); }
    var key[24];
    var kl = zfs_whex(load64(de + 8), &key);
    var p = zfs_mz_find(zb, load64(zfs_dent(e) + 32), &key, kl);
    if (p == 0 || load64(p) != zfs_w_ebo) { return zfs_wnon("deadlist entry not the empty_bpobj: mintxg ", load64(de + 8)); }
    var fd = zfs_wmos_dn(zfs_w_ffw);
    if (fd == 0) { return 0 - 1; }
    e = zfs_wblk(fd, 0, zfs_w_ffw, 0, 0);
    if (e < 0) { return 0 - 1; }
    var f = zfs_mz_find(zfs_dirty_buf(e), load64(zfs_dent(e) + 32), "com.delphix:empty_bpobj", 23);
    if (f == 0) { return zfs_wno("features_for_write has no empty_bpobj"); }
    var no = zfs_wmos_free();
    if (no < 0) { return 0 - 1; }
    var nd = zfs_wmos_dn(no);
    if (nd == 0) { return 0 - 1; }
    memset(nd, 0, 512);
    store8(nd, 5);
    store8(nd + 1, 17);
    store8(nd + 2, 1);
    store8(nd + 3, 3);
    store8(nd + 4, 6);
    store16(nd + 8, 256);
    store16(nd + 10, 48);
    if ((zfs_w_feat & 256) != 0) { store16(nd + 10, 56); }
    store64(p, no);
    store64(f, load64(f) - 1);
    store64(de + 16, no);
    zfs_wdl_nm = zfs_wdl_nm + 1;
    return no;
}
# dsl_deadlist_insert of the kill of bp (dsize u, PSIZE c, UCSIZE uc) into dataset entry dse's deadlist (the section
# header): its entry (zfs_wdl_ent) — materialised first (zfs_wdl_mat) — the BP appended (zfs_wbpo_add), the header's
# dl_used / dl_comp / dl_uncomp; an old-format deadlist takes the BP itself, no header. Dataset phase only. 0 / -1.
fn zfs_wdl_add(dse, bp, u, c, uc) {
    var sb = zfs_dsb(zfs_dsk(dse));
    var x = zfs_wdl_ent(zfs_dsk(dse), zfs_bp_birth(bp));
    if (x < 0) { return 0 - 1; }
    var de = zfs_dle(x);
    if (load64(de + 24) == 0) { zfs_wdl_ux = zfs_wdl_ux + 1; }      # (B9 review, k.100) no admission counted it: dlx=
    var bo = load64(de + 16);
    if (load64(sb + 8) == 0) {
        if (bo == zfs_w_ebo) { bo = zfs_wdl_mat(sb, de); }
        if (bo < 0) { return 0 - 1; }
        var dn = zfs_wmos_dn(load64(sb));
        if (dn == 0) { return 0 - 1; }
        var h = zfs_bonus(dn);
        store64(h, load64(h) + u);
        store64(h + 8, load64(h + 8) + c);
        store64(h + 16, load64(h + 16) + uc);
    }
    zfs_wdl_app = zfs_wdl_app + 1;
    zfs_wdl_du = zfs_wdl_du + u;
    return zfs_wbpo_add(bo, bp, u, c, uc);
}
# A block born in T into dataset dse (dsl_dataset_block_born, dsl_dataset.c:139-210: dsize, PSIZE, UCSIZE — summed per
# txg, zfs_wd_dsdelta applies them: parent_delta telescopes) and the dn_used of the object whose block it is (dn 0: the
# objset_phys, charged to no dnode). bp is not a hole. 0.
fn zfs_wd_born(dse, dn, bp) {
    var u = zfs_bp_dsize(bp);
    store64(dse + 24, load64(dse + 24) + u);
    store64(dse + 32, load64(dse + 32) + ((((load64(bp + 48) >> 16) & 0xFFFF) + 1) << 9));
    store64(dse + 40, load64(dse + 40) + zfs_bp_ucsize(bp));
    return zfs_wdn_used(dn, u);
}
# The block bp, killed in T in dataset dse (dsl_dataset_block_kill): a hole kills nothing; (B9) one born at or before
# ds_prev_snap_txg — an embedded one too — is DEADLISTED, branch B (zfs_wdl_add; its sums into the snapshot side);
# else an embedded block moves only its UCSIZE (lsize for a data type, 0 for metadata — zfs_bp_ucsize; dsize and PSIZE
# are 0) and any other is FREED (zfs_wfree_bp: cleared, deferred 2 txgs (k.125), in log T) — or (B7) DEFERRED to
# free_bpobj when it is a gang, dedup or possibly-cloned block (zfs_wd_defer, zfs_wfb_add: branch A's other half,
# $FREE charged); either way its dsize / PSIZE / UCSIZE leave the dataset's referenced bytes (branch C) and the object's
# dn_used (dn 0: the object is freed in this txg). 0 / -1 / -2.
fn zfs_wd_kill(dse, dn, bp) {
    var pr = load64(bp + 48);
    if (zfs_bp_hole(bp) == 1) { return 0; }
    var u = zfs_bp_dsize(bp);
    var c = 0;
    if (((pr >> 39) & 1) == 0) { c = (((pr >> 16) & 0xFFFF) + 1) << 9; }
    var uc = zfs_bp_ucsize(bp);
    var b = zfs_bp_birth(bp);
    var r = 0;
    if (zfs_wugt(b, load64(dse + 56)) == 0) {
        r = zfs_wdl_add(dse, bp, u, c, uc);
        if (r != 0) { return r; }
        var sb = zfs_dsb(zfs_dsk(dse));
        store64(sb + 56, load64(sb + 56) + u);
        store64(sb + 64, load64(sb + 64) + c);
        store64(sb + 72, load64(sb + 72) + uc);
        if (zfs_wugt(b, load64(sb + 40)) == 1) { store64(sb + 80, load64(sb + 80) + u); }
        if (load64(sb + 32) == 1 && zfs_wugt(b, load64(sb + 24)) == 1) { store64(sb + 88, load64(sb + 88) + u); }
    } elif (((pr >> 39) & 1) == 0) {
        if (zfs_wd_okbp(dse, bp) != 0) { return 0 - 1; }
        if (zfs_wd_defer(bp) == 1) { r = zfs_wfb_add(bp); } else { r = zfs_wfree_bp(bp); }
        if (r != 0) { return r; }
    }
    store64(dse + 24, load64(dse + 24) - u);
    store64(dse + 32, load64(dse + 32) - c);
    store64(dse + 40, load64(dse + 40) - uc);
    return zfs_wdn_used(dn, 0 - u);
}
# Finalise dirty dataset entry x (step (a) or (c) above): its fill (data 1; an indirect Σ its children's, zeroed when
# all are holes — zfs_ind_ready; a dnode block its allocated dnodes; the objset_phys Σ its meta-dnode's top-level
# fills, dmu_objset_write_ready), its policy, zfs_bp_build, every copy written, the BP into its parent's copy, born and
# killed. The objset_phys finalised = the dataset done: zfs_wd_dsdelta. 0 / -1 / -2.
fn zfs_wd_final(x) {
    var d = zfs_dent(x);
    var os = load64(d);
    var obj = load64(d + 8);
    var lv = load64(d + 24);
    var ls = load64(d + 32);
    var fl = load64(d + 56);
    var ty = (fl >> 8) & 0xFF;
    var dse = zfs_wds_find(os);
    var pbp = zfs_wpbp(x);
    if (dse == 0 || pbp == 0) { return 0 - 1; }
    var dn = 0;
    if (obj != ZWO_OSB) {
        dn = zfs_wobj_dn(os, obj);
        if (dn == 0) { return 0 - 1; }
    }
    var src = zfs_dirty_buf(x);
    var fill = 1;
    if (lv > 0) { fill = zfs_ind_ready(src, ls); }
    elif (obj == 0) { fill = zfs_fill_dnodes(src, ls); }
    elif (obj == ZWO_OSB) {
        fill = 0;
        var i = 0;
        while (i < load8(src + 3)) {
            fill = fill + load64(src + 64 + i * 128 + 88);
            i = i + 1;
        }
    }
    var pol = ty | (lv << 8);
    if ((fl & ZWD_DATA) != 0) {
        pol = pol | (zfs_wdck(load8(dn + 5), dse) << 16) | (load64(dse + 80) << 24) | ZWP_USER;
        var cm = load8(dn + 6);
        if (cm == 0) { cm = load64(dse + 96); }
        if (cm != 2) { pol = pol | ZWP_HOLE; }
    } else {
        pol = pol | (load64(dse + 72) << 16) | (zfs_md_copies(load64(dse + 80), load64(dse + 88), ty, lv) << 24) | ZWP_ZLE;
    }
    var old[128];
    memcpy(&old, pbp, 128);
    var nb[128];
    var r = zfs_bp_build(src, ls, pol, fill, &old, &nb);
    if (r < 0) { return r; }
    if (r == 1) {
        zfs_wr_cls = 2;
        if ((fl & ZWD_DATA) != 0) { zfs_wr_cls = 1; }
        if (zfs_wc_wr(&nb, zfs_bpb_va) != 0) { return 0 - 1; }
        zfs_wd_born(dse, dn, &nb);
        if ((fl & ZWD_DATA) != 0) { zfs_wf_ud = zfs_wf_ud + zfs_bp_dsize(&nb); }
    }
    r = zfs_wd_kill(dse, dn, &old);
    if (r != 0) { return r; }
    memcpy(pbp, &nb, 128);
    store64(d + 56, fl | ZWD_DONE);
    if (obj == ZWO_OSB) { return zfs_wd_dsdelta(dse); }
    return 0;
}
# The dataset's txg into the MOS (dsl_dataset_block_born / _kill summed — every term is linear and parent_delta
# telescopes, so one application equals OpenZFS's block-by-block one): ds_referenced_bytes @72 += dsize,
# ds_compressed_bytes @80 += PSIZE, ds_uncompressed_bytes @88 += UCSIZE — born minus every kill (branch C) — and
# ds_unique_bytes @96 += dsize born minus branch A's (B9: a deadlisted block stays the snapshot's); then the dsl_dir
# chain with born minus branch A (parent_delta(ds, that dsize) — its refreservation's, against ds_unique_bytes
# before — PSIZE, UCSIZE, tonew = the full dsize: REFRSRV -> HEAD at its own dir, CHILD_RSRV -> CHILD above it;
# zfs_wdd_use). (B9) Branch B's own moves (zfs_dsb +80 / +88): the dir's breakdown HEAD -> SNAP (dsl_dir_transfer_space,
# only with DD_FLAG_USED_BREAKDOWN — no used, no parent) and the previous snapshot's ds_unique_bytes. 0 / -1.
fn zfs_wd_dsdelta(dse) {
    var dn = zfs_wmos_dn(load64(dse));
    if (dn == 0) { return 0 - 1; }
    var b = zfs_bonus(dn);
    var sb = zfs_dsb(zfs_dsk(dse));
    var du = load64(dse + 24);
    var dc = load64(dse + 32);
    var duc = load64(dse + 40);
    var ua = du + load64(sb + 56);
    var delta = zfs_pdelta(load64(b + 96), ua, load64(dse + 48));
    store64(b + 72, load64(b + 72) + du);
    store64(b + 80, load64(b + 80) + dc);
    store64(b + 88, load64(b + 88) + duc);
    store64(b + 96, load64(b + 96) + ua);
    var dd = load64(dse + 8);
    if (zfs_wdd_use(dd, delta, ua, dc + load64(sb + 64), duc + load64(sb + 72)) != 0) { return 0 - 1; }
    var s = load64(sb + 80);
    if (s != 0) {
        var ddn = zfs_wmos_dn(dd);
        if (ddn == 0) { return 0 - 1; }
        var db = zfs_bonus(ddn);
        if ((load64(db + 96) & 1) != 0) {
            store64(db + 104, load64(db + 104) - s);
            store64(db + 112, load64(db + 112) + s);
        }
    }
    s = load64(sb + 88);
    if (s != 0) {
        var pd = zfs_wmos_dn(load64(sb + 16));
        if (pd == 0) { return 0 - 1; }
        store64(zfs_bonus(pd) + 96, load64(zfs_bonus(pd) + 96) + s);
    }
    return 0;
}
# DN_USED_BYTES of the dnode at dn (a sector count before DNODE_FLAG_USED_BYTES).
fn zfs_wdn_bytes(dn) {
    var u = load64(dn + 24);
    if ((load8(dn + 7) & 1) == 0) { u = u << 9; }
    return u;
}
# The ids the dnode at dn is charged to (zfs_sa_ids over its bonus — or, when the SA is spill-held (bonuslen 0, SA
# bonus type, a spill BP), over its spill block, as dmu_objset_userquota_get_ids reads it, dmu_objset.c:2228-2245).
# out 3 x u64. 0 / 1 not an accounted object / -1 unreadable.
fn zfs_wd_ids(dn, out) {
    var bt = load8(dn + 4);
    var bl = load16(dn + 10);
    if (bl != 0) { return zfs_sa_ids(bt, zfs_bonus(dn), bl, out); }
    if (bt != 44 || (load8(dn + 7) & 4) == 0) { return zfs_sa_ids(0, dn, 0, out); }
    var sp = dn + (load8(dn + 12) + 1) * 512 - 128;
    var sb = zfs_mc_get(sp);
    if (sb == 0) { return 0 - 1; }
    return zfs_sa_ids(bt, sb, zfs_bp_lsize(sp), out);
}
# One user / group / project delta of dataset os into the table (userquota_update_cache: one entry per key, the deltas
# summed — dmu_objset.c:1899-1918): kind 0 user · 1 group · 2 project, + 256 for the "obj-" count. 0 / -1 named.
fn zfs_wq_add(os, kind, id, delta) {
    var k = 0;
    while (k < zfs_wq_n) {
        var q = zfs_wmem + ZWA_UQ + k * 32;
        if (load64(q) == os && load64(q + 8) == kind && load64(q + 16) == id) {
            store64(q + 24, load64(q + 24) + delta);
            return 0;
        }
        k = k + 1;
    }
    if (zfs_wq_n >= ZWK_MAXUQ) { return zfs_wnon("user accounting deltas over ", ZWK_MAXUQ); }
    var p = zfs_wmem + ZWA_UQ + zfs_wq_n * 32;
    store64(p, os);
    store64(p + 8, kind);
    store64(p + 16, id);
    store64(p + 24, delta);
    zfs_wq_n = zfs_wq_n + 1;
    return 0;
}
# One side of one dnode (do_userquota_update + do_userobjquota_update, dmu_objset.c:1920-1975): sign -1 the old side,
# +1 the new; DNODE_MIN_SIZE + DN_USED_BYTES under the side's DNODE_FLAG_USERUSED_ACCOUNTED (bit 1) to "%llx" of the
# uid, the gid and — project quota enabled — the project id; 1 under USEROBJUSED_ACCOUNTED (bit 3) to "obj-%llx". 0 / -1.
fn zfs_wd_uq(dse, ids, used, dfl, sign) {
    var os = load64(dse);
    var pj = (load64(dse + 104) >> 2) & 1;
    if ((dfl & 2) != 0) {
        var dv = sign * (512 + used);
        if (zfs_wq_add(os, 0, load64(ids), dv) != 0 || zfs_wq_add(os, 1, load64(ids + 8), dv) != 0) { return 0 - 1; }
        if (pj == 1 && zfs_wq_add(os, 2, load64(ids + 16), dv) != 0) { return 0 - 1; }
    }
    if ((dfl & 8) != 0) {
        if (zfs_wq_add(os, 256, load64(ids), sign) != 0 || zfs_wq_add(os, 257, load64(ids + 8), sign) != 0) { return 0 - 1; }
        if (pj == 1 && zfs_wq_add(os, 258, load64(ids + 16), sign) != 0) { return 0 - 1; }
    }
    return 0;
}
# ⭐ User / group / project accounting of dataset dse for T (design § e.3, D3: exact deltas; dnode_sync.c:700-713,
# dmu_objset.c:1920-2025): every dnode of a dirty dnode block whose bytes differ from T - 1's (the reader's slot holds
# T - 1's meta-dnode until the publish) is a SYNCED dnode: the old side (T - 1's dnode, its flags and DN_USED_BYTES,
# its ids) is subtracted, DNODE_FLAG_USERUSED_ACCOUNTED (and USEROBJUSED_ACCOUNTED with userobj_accounting enabled) is
# set on the new one, and the new side (its final dn_used — step (a) moved it) is added. Ids come only from SA / znode
# bonuses (zfs_wd_ids — the master node, SA registry / layouts and other ZAPs get the bits, no delta). Then the summed
# deltas into the special ZAPs (zfs_wd_uqapply). Runs after step (a), before the dnode blocks are built. 0 / -1 named.
fn zfs_wd_uacct(dse) {
    var fl = load64(dse + 104);
    if ((fl & 1) == 0) { return 0; }
    var os = load64(dse);
    var cm = zfs_ds(load64(dse + 16));
    var set = 2;
    if ((fl & 2) != 0) { set = 10; }
    var ob = zfs_wmem + ZWA_CMP;                 # T - 1's dnode block (ZWA_CMP is free between two builds)
    var ids[24];
    var k = 0;
    while (k < zfs_dx_n) {
        var d = zfs_dent(k);
        if (load64(d) == os && load64(d + 8) == 0 && load64(d + 24) == 0) {
            var ls = load64(d + 32);
            var nb = zfs_dirty_buf(k);
            var cb = zfs_obj_blk(cm, load64(d + 16), 1);
            if (cb == 0 || ls > ZK_METAMAX) { return zfs_wno("committed dnode block unreadable"); }
            memcpy(ob, cb, ls);
            var s = 0;
            while (s < ls) {
                var n = nb + s;
                var o = ob + s;
                var sp = 512;
                if (load8(n) != 0) { sp = (load8(n + 12) + 1) * 512; }
                elif (load8(o) != 0) { sp = (load8(o + 12) + 1) * 512; }
                if (s + sp > ls) { return zfs_wno("a dnode crosses its block"); }
                if (memeq(n, o, sp) != 1) {
                    if (load8(o) != 0) {
                        var r = zfs_wd_ids(o, &ids);
                        if (r < 0) { return zfs_wno("dnode ids unreadable"); }
                        if (r == 0 && zfs_wd_uq(dse, &ids, zfs_wdn_bytes(o), load8(o + 7), 0 - 1) != 0) { return 0 - 1; }
                    }
                    if (load8(n) != 0) {
                        store8(n + 7, load8(n + 7) | set);
                        var r2 = zfs_wd_ids(n, &ids);
                        if (r2 < 0) { return zfs_wno("dnode ids unreadable"); }
                        if (r2 == 0 && zfs_wd_uq(dse, &ids, zfs_wdn_bytes(n), load8(n + 7), 1) != 0) { return 0 - 1; }
                    }
                }
                s = s + sp;
            }
        }
        k = k + 1;
    }
    return zfs_wd_uqapply(dse);
}
# The summed deltas of dataset dse into its special ZAPs — zap_increment (zap.c:1274-1291) per key whose delta is not
# 0: zap_lookup, value + delta, then zap_remove when that is 0 (a microzap's chunk zeroed; a fat ZAP's entry freed) or
# zap_update (a microzap entry's value in place, or a new chunk growing the block by 512 B when full; a fat ZAP's
# value array re-created, or a new entry — a leaf split as needed) — the ZAP's blocks dirtied on first use (the commit's
# phase 1). (B8) A microzap these keys would overflow was upgraded and every fat ZAP's leaves for them dirtied when
# the op was admitted (zfs_wz_urs), so only a new key's split dirties anything new here — inside the reserve. 0 / -1.
fn zfs_wd_uqapply(dse) {
    var os = load64(dse);
    var nm[24];
    var cur[8];
    var k = 0;
    while (k < zfs_wq_n) {
        var q = zfs_wmem + ZWA_UQ + k * 32;
        if (load64(q) == os && load64(q + 24) != 0) {
            var kind = load64(q + 8);
            var nl = 0;
            if ((kind >> 8) == 1) {
                memcpy(&nm, "obj-", 4);
                nl = 4;
            }
            nl = nl + zfs_whex(load64(q + 16), &nm + nl);
            var so = ZWO_USER + (kind & 3);
            var sd = zfs_wobj_dn(os, so);
            if (sd == 0) { return 0 - 1; }
            zfs_wz_open(os, so, sd);
            store64(&cur, 0);
            var g = zfs_wz_get(&nm, nl, &cur);
            if (g < 0) { return 0 - 1; }
            var v = load64(&cur) + load64(q + 24);
            if (v == 0) {
                if (zfs_wz_op(2, &nm, nl, 8, 1, &cur) != 0) { return 0 - 1; }
            } else {
                store64(&cur, v);
                if (zfs_wz_op(1, &nm, nl, 8, 1, &cur) != 0) { return 0 - 1; }
            }
        }
        k = k + 1;
    }
    return 0;
}
# The dataset phase (the section header's (a)-(c)), after B5's deferred kills: every BP a truncation freed in the
# open context (zfs_wf_kl — its slot in the parent's copy is a hole now) is killed here, inside the commit, as
# free_blocks does at the sync (dnode_sync.c:140-178: dsl_dataset_block_kill, the object's dn_used) — (B7) and every BP of
# an object freed in this txg (ZWU_FREED: its dnode is gone, no dn_used moves). Last, $FREE's charge for the txg's
# kills deferred to free_bpobj (zfs_wfb_charge). 0 / -1 / -2.
fn zfs_wd_phase(t) {
    if (zfs_wd_n == 0) { return 0; }
    var f = 0;
    while (f < zfs_wfr_n) {
        var fe = zfs_wmem + ZWA_OS + ZWF_FRL + f * 144;
        var fdse = zfs_wds_find(load64(fe));
        var fdn = 0;
        if ((load64(fe + 8) & ZWU_FREED) == 0) {
            fdn = zfs_wobj_dn(load64(fe), load64(fe + 8));
            if (fdn == 0) { return zfs_wno("a freed block's object is gone"); }
        }
        if (fdse == 0) { return zfs_wno("a freed block's dataset is gone"); }
        var fr = zfs_wd_kill(fdse, fdn, fe + 16);
        if (fr != 0) { return fr; }
        f = f + 1;
    }
    var pass = 0;
    while (pass < 2) {
        var n = zfs_dirty_plan();
        var k = 0;
        while (k < n) {
            var x = zfs_dirty_at(k);
            var d = zfs_dent(x);
            if (load64(d) != 0 && (load64(d + 56) & ZWD_DONE) == 0) {
                if (pass == 1 || (zfs_dirty_rank(x) >> 8) == 0) {
                    var r = zfs_wd_final(x);
                    if (r != 0) { return r; }
                }
            }
            k = k + 1;
        }
        if (pass == 0) {
            var j = 0;
            while (j < zfs_wd_n) {
                if (zfs_wd_uacct(zfs_dse(j)) != 0) { return 0 - 1; }
                j = j + 1;
            }
        }
        pass = pass + 1;
    }
    return zfs_wfb_charge();
}
# $FREE's charge for the txg's deferred kills (dsl_dir_diduse_space(dp_free_dir, DD_USED_HEAD, used, comp, uncomp) per
# block, dsl_dataset.c:327-331 — summed: linear): its dd_used / compressed / uncompressed and HEAD, then up to the root
# (CHILD) with parent_delta ($FREE has no reservation) — zfs_wdd_use, before the MOS phase plans. 0 / -1.
fn zfs_wfb_charge() {
    if (zfs_wfb_n == 0) { return 0; }
    return zfs_wdd_use(zfs_w_fdd, zfs_wfb_du, zfs_wfb_du, zfs_wfb_dc, zfs_wfb_duc);
}
# Would OpenZFS let a write of bytes into dataset dse through (design D13: dsl_dir_tempreserve_space, dsl_dir.c:1290-
# 1415, with dsl_dataset_check_quota, dsl_dataset.c:4397-4444, nothing else in flight)? ⭐ A predicate on the CURRENT
# usage — "they get one free hit" — not on the request: the dataset's refquota (referenced >= refquota: EDQUOT); then
# every dsl_dir up for as long as the reservation-aware share of the worst-case request (bytes x spa_asize_inflation,
# 24) still reaches it (parent_delta): its quota (dd_used — at the first, less the unused refreservation — >= quota:
# EDQUOT) and at the root the pool's unreserved space (zfs_wroomz: the normal class - slop - the deferred frees,
# dsl_pool_unreserved_space: ENOSPC). Plus agnos's allocation rule (zfs_walloc_bp's): allocated + the open txg's
# allocations + bytes x copies past zfs_wroom (zfs_wd_aroom: OpenZFS's figure, and the metaslabs agnos allocates in —
# B5 review): ENOSPC — so the txg's user data cannot fail its commit on space, and its
# metadata has the whole slop, as in OpenZFS's syncing context (k.17; a contiguous run is another matter, k.25).
# ⭐ B5 (design § k.36): IN-FLIGHT bytes count. infl = the request bytes the open txg already reserved for this dataset
# (Σ bytes x 24 of the blocks it dirtied: dsl_dir's est_inflight = dd_tempreserved + towrite), inflr = their raw
# allocation (Σ asize x copies). A predicate that trips only because of them is OpenZFS's ERESTART (1): the caller
# commits what is in flight and asks again with none — then the committed usage decides (EDQUOT / ENOSPC) — exactly
# dmu_tx_assign's wait-and-retry (dsl_dataset_check_quota, dsl_dataset.c:4415-4428; dsl_dir_tempreserve_impl, dsl_dir.c:
# 1290-1415, the in-flight path past quota + quota/32). 0 / 1 / -1 named.
fn zfs_wd_space(dse, bytes, infl, inflr) {
    var ar = zfs_wd_aroom(dse, bytes, inflr);
    if (ar != 0) { return ar; }
    var room = zfs_wroomz();
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(dse), dn) != 0) { return zfs_wno("dataset unreadable"); }
    var b = zfs_bonus(dn);
    var uq = load64(b + 96);
    var rr = load64(dse + 48);
    var req = bytes * 24;
    var adj = 0;
    var rsv = 0;
    if (rr > uq) {
        adj = rr - uq;
        var pd = zfs_pdelta(uq, req + infl, rr);
        if (pd > req) { pd = req; }
        rsv = req - pd;
    }
    if (load64(dse + 112) != 0 && load64(b + 72) + infl >= load64(dse + 112)) {
        if (infl > 0) { return 1; }
        return zfs_wno("over refquota (EDQUOT)");
    }
    var need = req - rsv;
    var dd = load64(dse + 8);
    var first = 1;
    while (dd != 0) {
        if (zfs_dnode(zfs_mem + ZR_MOS, dd, dn) != 0) { return zfs_wno("dsl_dir unreadable"); }
        b = zfs_bonus(dn);
        var used = load64(b + 40);
        if (first == 1) { used = used - adj; }
        var q = load64(b + 64);
        var lim = q;
        var why = "over quota (EDQUOT)";
        if (load64(b + 16) == 0 && (q == 0 || room <= q)) {
            lim = room;
            why = "no space: the pool is at its slop";
        }
        if (lim != 0 || load64(b + 16) == 0) {
            if (used >= lim) { return zfs_wno(why); }
            if (used + infl >= lim + (lim >> 5)) { return 1; }
        }
        need = zfs_pdelta(used + infl, need, load64(b + 72));
        if (need == 0) { return 0; }
        dd = load64(b + 16);
        first = 0;
    }
    return 0;
}
# agnos's allocation rule alone (zfs_walloc_bp's, B5 review: shared with the rewrite a truncation makes of its boundary
# block, which no quota may refuse — a free): the pool's allocated + the open txg's allocations + inflr + bytes x copies
# within zfs_wroom, named by the bound that refused — OpenZFS's slop, or the metaslabs agnos can allocate in
# (zfs_wphys). 0 · 1 only the in-flight bytes put it past (ERESTART) · -1 named (ENOSPC).
fn zfs_wd_aroom(dse, bytes, inflr) {
    var un = 1 << zfs_ashift;
    var need = zfs_w_alloc + zfs_tx_alloc + inflr + ((bytes + un - 1) & (0 - un)) * load64(dse + 80);
    if (need > zfs_wroom()) {
        if (inflr > 0) { return 1; }
        if (need > zfs_wphys()) { return zfs_wno("no space: the metaslabs with a space map are full"); }
        return zfs_wno("no space: the pool is at its slop");
    }
    return 0;
}
# ⭐ (B5 review) User / group / project quotas — zfs_write checks zfs_id_overblockquota before each chunk (each txg
# here; zfs_vnops.c:798-805, zfs_quota.c:459-505): for the file's uid, its gid and — project accounting present — its
# projid when not 0, the quota is the id's "%llx" key in the ZAP the master node names "userquota@" / "groupquota@" /
# "projectquota@", else the master node's "defaultuserquota" / "defaultgroupquota" / "defaultprojectquota" (absent:
# none — zfs_get_zplprop's store); the usage is the key in the COMMITTED user / group / project-used ZAP (absent:
# none); used >= quota is EDQUOT — one free hit, as OpenZFS (a write that starts under it may cross it). The ids are the
# accounting's (zfs_wd_ids: SA bonus or spill). 0 · 1 EDQUOT (named) · -1 named.
fn zfs_wd_idq(dse, dn) {
    var ids[24];
    var r = zfs_wd_ids(dn, &ids);
    if (r < 0) { return zfs_wno("dnode ids unreadable"); }
    if (r == 1) { return 0; }
    return zfs_wd_idq3(dse, &ids, 0);
}
# The quotas of the ids at ids (uid, gid, projid — the project only with project accounting and an id that is not 0) in
# dataset dse: kobj 0 the BYTE quotas above (zfs_id_overblockquota: `userquota@` ..., the usage "%llx" in the
# user / group / project-used ZAP) · 1 the OBJECT quotas (B6, zfs_id_overobjquota, zfs_quota.c: `userobjquota@` /
# `groupobjquota@` / `projectobjquota@`, else `default…objquota`, the usage "obj-%llx"). A create checks both
# (zfs_acl_ids_overquota). As OpenZFS (zfs_quota.c zfs_id_overobjquota / _overblockquota; B6 review): the OBJECT quotas
# only once the objset's OBJSET_FLAG_USEROBJACCOUNTING_COMPLETE is set, the PROJECT ones (bytes and objects) only once
# OBJSET_FLAG_PROJECTQUOTA_COMPLETE is — before that "not over quota" (OpenZFS then starts its upgrade; agnos runs none)
# — dse +104 bits 16 / 32. 0 · 1 EDQUOT (named) · -1 named.
fn zfs_wd_idq3(dse, ids, kobj) {
    var fl = load64(dse + 104);
    if (kobj == 1 && (fl & 18) != 18) { return 0; }
    var di = load64(dse + 16);
    var mn = zfs_wdn(2);
    if (zfs_dnode(zfs_ds(di), 1, mn) != 0) { return zfs_wno("master node unreadable"); }
    var key[24];
    var uk[32];
    var k = 0;
    while (k < 3) {
        var id = load64(ids + k * 8);
        if (k < 2 || ((fl & 36) == 36 && id != 0)) {
            var qn = zfs_wtoki("userquota@ groupquota@ projectquota@ userobjquota@ groupobjquota@ projectobjquota@", kobj * 3 + k);
            var ql = zfs_wtk_l;
            var dq = zfs_wtoki("defaultuserquota defaultgroupquota defaultprojectquota defaultuserobjquota defaultgroupobjquota defaultprojectobjquota", kobj * 3 + k);
            var dl = zfs_wtk_l;
            var kl = zfs_whex(id, &key);
            var q = 0;
            var qo = 0;
            var lr = zfs_zap_lookup(mn, qn, ql, 8, 1, &qo);
            if (lr < 0 && lr != (0 - 2)) { return zfs_wnos("unreadable: ", qn, ql); }
            if (lr >= 0 && qo != 0) {
                var qd = zfs_wdn(3);
                if (zfs_dnode(zfs_ds(di), qo, qd) != 0) { return zfs_wnos("unreadable: ", qn, ql); }
                lr = zfs_zap_lookup(qd, &key, kl, 8, 1, &q);
                if (lr < 0) {
                    if (lr != (0 - 2)) { return zfs_wnos("unreadable: ", qn, ql); }
                    q = 0;
                }
            }
            if (q == 0) {
                lr = zfs_zap_lookup(mn, dq, dl, 8, 1, &q);
                if (lr < 0) {
                    if (lr != (0 - 2)) { return zfs_wnos("unreadable: ", dq, dl); }
                    q = 0;
                }
            }
            if (q != 0) {
                var ud = zfs_wobj_dn(load64(dse), ZWO_USER + k);
                if (ud == 0) { return 0 - 1; }
                var ul = 0;
                if (kobj == 1) {
                    memcpy(&uk, "obj-", 4);
                    ul = 4;
                }
                ul = ul + zfs_whex(id, &uk + ul);
                var used = 0;
                lr = zfs_zap_lookup(ud, &uk, ul, 8, 1, &used);
                if (lr < 0 && lr != (0 - 2)) { return zfs_wno("user accounting ZAP unreadable"); }
                if (lr >= 0 && zfs_wugt(q, used) == 0) {
                    zfs_wnos("over quota (EDQUOT): ", qn, ql);
                    return 1;
                }
            }
        }
        k = k + 1;
    }
    return 0;
}
# Undo the dirty set back to n entries and wd datasets — the entries a refused operation added, newest first: each is
# the head of its hash chain and the end of its arena then (slots are taken in order; only a commit grows one), so the
# set is exactly what it was. 0.
fn zfs_dirty_trunc(n, wd) {
    while (zfs_dx_n > n) {
        zfs_dx_n = zfs_dx_n - 1;
        var d = zfs_dent(zfs_dx_n);
        var h = zfs_wmem + ZWA_DHT + zfs_dhash(load64(d), load64(d + 8), load64(d + 24), load64(d + 16)) * 4;
        store32(h, load64(d + 48));
        if ((load64(d + 56) & ZWD_DATA) != 0) { zfs_dx_data = load64(d + 40) - ZWA_OS; } else { zfs_dx_meta = load64(d + 40) - ZWA_META; }
    }
    zfs_wd_n = wd;
    return 0;
}
# ⭐ THE DATASET COW's entry point (design § h B4; B5's writes build on it): level-0 block bid of object obj of grafted
# dataset slot di dirtied in the open txg — the dataset opened for write (zfs_wds_open), the object's dnode in its
# dirty dnode block (the meta-dnode chain above it dirty too), the block and every indirect above it, each a private
# copy of T - 1's, every BP they replace killable (zfs_wd_okbp), the write allowed by the space and quota predicates
# (zfs_wd_space), and what the commit's accounting step will add for it reserved (B4 review): the object's dnode is
# synced there (zfs_wd_uacct) — at most 6 entries of the txg's delta table (user / group / project, bytes and objects:
# B4's verb keeps the ids, so both sides share their keys) and, where T - 1's dnode lacks the accounting flags (an
# upgraded pool), up to 2 NEW keys per accounting microzap (dse +120). The caller edits the copy (B4's op list leaves
# it as it is: a rewrite with identical content) and commits. The entry, or -1 named with the dirty set and the
# reservations exactly as they were (zfs_dirty_trunc; nothing is allocated before a commit, so nothing else moved).
fn zfs_wd_dirty(di, obj, bid) {
    var n0 = zfs_dx_n;
    var w0 = zfs_wd_n;
    var r = zfs_wd_dirty1(di, obj, bid);
    if (r < 0) { zfs_dirty_trunc(n0, w0); }
    return r;
}
fn zfs_wd_dirty1(di, obj, bid) {
    if (zfs_xl_n != 0) { return zfs_wno("extents outside a commit"); }
    var dse = zfs_wds_open(di);
    if (dse == 0) { return 0 - 1; }
    var os = load64(dse);
    var dn = zfs_wos_dn(os, obj);
    if (dn == 0) { return 0 - 1; }
    if (load8(dn) == 0) { return zfs_wnon("no such object ", obj); }
    if (bid < 0 || bid > load64(dn + 16)) { return zfs_wnon("block past the object's end: ", bid); }
    if (zfs_wd_space(dse, load16(dn + 8) << 9, 0, 0) != 0) { return 0 - 1; }
    var e = zfs_wblk(dn, os, obj, 0, bid);
    if (e < 0) { return e; }
    var un = 1 << zfs_ashift;
    zfs_wf_inflr = zfs_wf_inflr + (((load16(dn + 8) << 9) + un - 1) & (0 - un)) * load64(dse + 80);
    if (zfs_wd_urs1(dse, dn) != 0) { return 0 - 1; }
    return e;
}
# What the commit's user accounting will do for the synced dnode dn (its dirty copy, its flags still T - 1's), reserved
# now (B4 review; B8: zfs_wz_urs) — its ids, and where T - 1's dnode lacks the accounting flags (an upgraded pool) 2 new
# keys per accounting ZAP (B4's verbs keep the ids, so an accounted dnode adds none). 0 / -1 named.
fn zfs_wd_urs1(dse, dn) {
    var fl = load64(dse + 104);
    if ((fl & 1) == 0) { return 0; }
    var set = 2;
    if ((fl & 2) != 0) { set = 10; }
    var nk = 0;
    if ((load8(dn + 7) & set) != set) { nk = 2; }
    var ids[24];
    var r = zfs_wd_ids(dn, &ids);
    if (r < 0) { return zfs_wno("dnode ids unreadable"); }
    if (r == 1) { return zfs_wz_urs(dse, 0, nk); }
    return zfs_wz_urs(dse, &ids, nk);
}

# --- B5: FILE DATA (design § a.1 write / truncate, § b.2 policy A, § f.3, § f.4; WPA § 5, § 7.5, § 10) ---------------
# write#1 on a writable fd (zfs_fd_write -> zfs_wf_write) and AO_TRUNC at open (zfs_open -> zfs_wtrunc), each through
# the B4 dataset phase: the object's data blocks, indirects and dnode dirtied in the open txg, then zfs_commit. POLICY A
# (D1, ruled (b) and built as (a) until B11): ONE txg per write#1 and per truncating open — a write the open txg cannot
# hold (ZWF_TXGBLK dirty blocks, the arenas less what the commit dirties itself, ZWF_MRSV; the in-flight space
# predicates) is cut into several, each durable when it commits. What OpenZFS's ZPL + DMU do, rule for rule:
#   · block size (zfs_wf_grow): while a file is ONE block its block grows to MIN(recordsize, P2ROUNDUP(end, 512)) —
#     a non-power-of-two size only then — and never again once it has two (zfs_write, zfs_rangelock_cb,
#     zfs_grow_blocksize, dnode_set_blksz); recordsize > 128 KiB only where large_blocks is active on the dataset
#   · levels (zfs_wf_levels): a block past what dn_nlevels addresses adds a top indirect holding the old dn_blkptr[]
#     (dnode_new_blkid, dnode_increase_indirection); nlevels never shrinks
#   · a partially written block is READ (the reader's decompressors — zstd and skein / edonr / blake3 refused by
#     name, zfs_wblk) and rewritten whole, OFF (D4); a block written whole is not read; an all-zero block of a dataset
#     that compresses becomes a hole — with birth T when it replaced a born block (zfs_bp_build, zio.c:2097-2104)
#   · truncation (zfs_wf_free): the tail of the boundary block zeroed as a COW (dnode_partial_zero — a hole is left
#     alone), every whole block past it a hole of birth T (free_blocks, dnode_sync.c:140-178; hole_birth active), each
#     freed BP killed INSIDE the commit (the kill list, zfs_wd_phase), an indirect left all holes a hole itself
#     (zfs_ind_ready), dn_maxblkid the last kept block; the first and last L1 dirtied even when holes (dnode_dirty_l1)
#   · the ZPL (zfs_wf_attrs, zfs_wf_touch): SIZE = MAX(SIZE, the write's end) / the new length, MTIME = CTIME = now,
#     FLAGS |= ZFS_ARCHIVE | ZFS_AV_MODIFIED (zfs_tstamp_update_setup, CONTENT_MODIFIED), a truncation to 0 clears
#     ZFS_SPARSE (zfs_trunc) — each a fixed-size SA attribute updated IN PLACE in the bonus (sa.c:378-385)
# Refused by name (design § a.3): a read-only pool / dataset / fd; not a plain file; a pre-SA object; an SA attribute
# outside the bonus (spill update is not built); ZFS_IMMUTABLE / ZFS_APPENDONLY (AO_APPEND is not honoured) /
# ZFS_READONLY files; a partial overwrite of a zstd / skein / edonr / blake3 block; a data block over 1 MiB; and every
# B4 refusal of a block the op replaces or frees (zfs_wd_okbp: an encrypted BP — (B7) a gang, dedup or possibly-cloned
# one is not refused, the commit defers its kill to free_bpobj, zfs_wd_defer, so gang/gang.bin truncates; (B9) nor a
# snapshot-owned one: deadlisted). Space: zfs_wd_space with the txg's in-flight bytes (k.36): ERESTART -> commit,
# ask again; EDQUOT / ENOSPC with nothing in flight -> a SHORT write (or -1 when nothing was written).
enum ZfsWF {
    ZWF_TXGBLK  = 512;                  # dirty blocks a write / truncation lets one txg reach before it commits:
    #   k.28's log bound (zfs_wc_plan: 8 x (12 N + 2 min(ms, 6 N) + ...) <= 128 KiB, true to 2,048 metaslabs near 600)
    #   and the extent list (<= 6 extents a block); the rest of ZWK_MAXDIRTY is what the commit dirties itself
    ZWF_MRSV    = 0x80000;              # metadata-arena bytes kept for the blocks the commit dirties itself (the
    #   accounting ZAPs, U[], the log ZAP, the MOS chain: k.37) — a write stops dirtying below it
    ZWF_FRL     = 0x200000;             # the txg's kill list: 144-byte entries (+0 objset · +8 object · +16 the BP) in the
    ZWF_FRMAX   = 4096;                 #   data arena's upper half [ZWA_OS + 2 MiB, + 4 MiB) — zfs_dx_lim() halves it;
    #   ZWK_MAXXL entries at most (B5 review: each kill frees >= 1 DVA, a FREE extent of log T — zfs_wf_xfit binds first)
    ZWF_FBM     = 32;                   # (B7 review, k.70) deferred kills zfs_wfb_meta reserves beyond those counted:
    #   the commit's own (its accounting ZAPs, <= 6) and what a write's or a walk's dirtying counts between two
    #   admissions (one block and the indirects above it, <= 10)
    ZWF_CRSV    = 96;                   # dirty blocks a truncation txg may still add past its walk (zfs_wf_xfit): the
    #   commit's own — the accounting ZAPs, the dsl_dataset and dsl_dirs, U[] (<= 32 blocks at 2,048 metaslabs), the log
    #   ZAP, log T, the MOS chain; a B5 txg holds 17-22 blocks in all — and dnode_dirty_l1 / the boundary block's paths
    ZWF_ARCHIVE = 0x800000000;          # znode_phys flags (zfs_znode.h): ZFS_ARCHIVE · ZFS_AV_MODIFIED · ZFS_READONLY ·
    ZWF_AVMOD   = 0x40000000000;        #   ZFS_IMMUTABLE · ZFS_APPENDONLY · ZFS_SPARSE
    ZWF_RO      = 0x100000000;
    ZWF_IMMUT   = 0x1000000000;
    ZWF_APPEND  = 0x4000000000;
    ZWF_SPARSE  = 0x200000000000;
}
var zfs_wf_sz = 0;           # the SA offsets in the object's bonus (zfs_wf_attrs): SIZE · MTIME · CTIME · FLAGS
var zfs_wf_mt = 0;
var zfs_wf_ct = 0;
var zfs_wf_fl = 0;
var zfs_wf_dse = 0;          # the open txg's dataset entry (zfs_wf_begin; its in-flight bytes: zfs_wf_infl / _inflr)
var zfs_wf_lo = 0;           # zfs_wf_freeblks: the lowest block freed so far (every block from it up to the range's top
var zfs_wf_stop = 0;         #   is freed) · 1 = this txg is full, the rest goes to the next

# The writer's per-object refusals for the dnode at dn of dataset slot di (the section header's list) — at open
# (zfs_wopen, the committed dnode) and in each txg (zfs_wf_begin, the dirty one). Leaves the SA offsets of SIZE /
# MTIME / CTIME / FLAGS in the bonus in zfs_wf_sz / _mt / _ct / _fl. 0 / -1 named.
fn zfs_wf_attrs(di, dn) {
    if (zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    var ds = zfs_ds(di);
    if (load64(ds + 1016) != 1) { return zfs_wno("dataset read-only"); }
    if (load8(dn) != 19) { return zfs_wnon("not a plain file: type ", load8(dn)); }
    if (load8(dn + 4) != 44 || load64(ds + 520) != 1) { return zfs_wno("pre-SA object (ZPL < 5)"); }
    var bon = zfs_bonus(dn);
    var bl = load16(dn + 10);
    var v[16];
    var k = 0;
    while (k < 4) {
        var num = load64(ds + 552);
        var want = 8;
        if (k == 1) {
            num = load64(ds + 560);
            want = 16;
        } elif (k == 2) {
            num = load64(ds + 1000);
            want = 16;
        } elif (k == 3) { num = load64(ds + 1008); }
        if (num < 0 || zfs_sa_find(di, ds, bon, bl, num, &v, 16) != want) { return zfs_wnon("SA attribute not in the bonus (spill update not built): ", num); }
        if (k == 0) { zfs_wf_sz = zfs_sa_at; }
        elif (k == 1) { zfs_wf_mt = zfs_sa_at; }
        elif (k == 2) { zfs_wf_ct = zfs_sa_at; }
        else { zfs_wf_fl = zfs_sa_at; }
        k = k + 1;
    }
    var fl = load64(bon + zfs_wf_fl);
    if ((fl & ZWF_IMMUT) != 0) { return zfs_wno("immutable file (EPERM)"); }
    if ((fl & ZWF_APPEND) != 0) { return zfs_wno("append-only file (AO_APPEND is not honoured)"); }
    if ((fl & ZWF_RO) != 0) { return zfs_wno("read-only file attribute (EPERM)"); }
    return 0;
}
# open#7's write check (zfs_open: AO_WRONLY / AO_RDWR / AO_TRUNC) on the committed dnode of ref. 0 / -1 named.
fn zfs_wopen(ref) {
    var di = zfs_ref_di(ref);
    if (di < 0 || di >= zfs_nds) { return zfs_wno("not a dataset object"); }
    var dn = zfs_dnslot(4);
    if (zfs_ref_dn(ref, dn) != 0) { return zfs_wno("object unreadable"); }
    return zfs_wf_attrs(di, dn);
}
# Drop a txg that will not commit: nothing was allocated (no extent exists before a commit), so the dirty set simply
# goes — unless a failed commit already returned the writer area (zfs_wfail_now). 0.
fn zfs_wf_drop() {
    # (B11 review) never SILENTLY: a pending policy-B txg in the dirty set holds writes write#1 already answered — they
    # go with it, named, and its object's next close / sync answers -1 (zfs_wp_eref, EIO). zfs_wp_own commits a pending
    # txg before any op opens a txg of its own, so this is the backstop only
    if (zfs_wp_ref != 0) {
        zfs_wp_eref = zfs_wp_ref;
        zfs_wp_ref = 0;
        kprintln("zfs: a pending txg was dropped - its writes are lost (EIO at close)", 67);
    }
    if (zfs_wmem != 0) { zfs_dirty_reset(); }
    return 0;
}
# Open object obj of dataset slot di for ONE txg of a write or a truncation: the dataset (zfs_wds_open), the object's
# dnode in its dirty dnode block, zfs_wf_attrs on THAT copy, and what the accounting step will add for it reserved —
# zfs_wd_dirty1's rule: the dnode is synced in this txg (6 delta entries; 2 new keys per accounting microzap where
# T - 1's dnode lacks the accounting flags). The dirty dnode, or 0 named (the caller drops the txg).
# (B11, policy B) With zfs_wp_c set by zfs_wf_write, the PENDING txg of this very object CONTINUES: its dirty blocks, its
# in-flight bytes (zfs_wf_infl / _inflr, k.36) and its accounting reservation (zfs_wd_urs1 — one per synced dnode, taken
# by the write that opened it) stay; zfs_wf_cont says so to the caller. (B11 review) A pending txg it does NOT continue —
# another object's, or one a write#1 of another CPU left while fs_lock was released (zfs_wf_yield) — commits first
# (zfs_wp_own): the caller's refusal path (zfs_wf_drop) would otherwise throw its acknowledged writes away.
var zfs_wf_cont = 0;
fn zfs_wf_begin(di, obj) {
    zfs_wf_cont = 0;
    if (zfs_rw != 1 || zfs_wmem == 0) {
        zfs_wno("pool read-only");
        return 0;
    }
    if (zfs_wp_c == 1 && zfs_wp_ref == (((di + 1) << 48) | obj) && zfs_dx_n != 0 && zfs_xl_n == 0) { zfs_wf_cont = 1; }
    if (zfs_wf_cont == 0 && zfs_wp_own() != 0) { return 0; }
    if (zfs_wf_cont == 0 && (zfs_dx_n != 0 || zfs_xl_n != 0)) {
        zfs_wno("dirty set not empty (one op per txg: policy A)");
        return 0;
    }
    # B5 review: a txg opens only while the metaslabs agnos allocates in keep ZWK_MDRES for its commit's metadata
    # (zfs_wphys) — a truncation's too — or the commit could fail on space, the pool then read-only until reboot
    if (zfs_w_alloc > zfs_wphys()) {
        zfs_wno("no space: the metaslabs with a space map are full");
        return 0;
    }
    var dse = zfs_wds_open(di);
    if (dse == 0) { return 0; }
    var dn = zfs_wos_dn(load64(dse), obj);
    if (dn == 0) { return 0; }
    if (load8(dn) == 0) {
        zfs_wnon("no such object ", obj);
        return 0;
    }
    if (zfs_wf_attrs(di, dn) != 0) { return 0; }
    zfs_wf_dse = dse;
    if (zfs_wf_cont == 1) { return dn; }
    if (zfs_wd_urs1(dse, dn) != 0) { return 0; }
    zfs_wf_infl = 0;
    zfs_wf_inflr = 0;
    return dn;
}
# The BP of level-0 block bid of the object whose (dirty) dnode is dn, read DIRTY-FIRST down the tree into out: 1 a
# block · 0 a hole (or under one) · 2 the block is dirty in the open txg · -1 named.
fn zfs_wf_bp(dn, os, obj, bid, out) {
    if (zfs_dirty_find(os, obj, 0, bid) >= 0) { return 2; }
    var nl = load8(dn + 2);
    var epbs = load8(dn + 1) - 7;
    var top = zfs_shr(bid, epbs * (nl - 1));
    memset(out, 0, 128);
    if (top >= load8(dn + 3)) { return 0; }
    memcpy(out, dn + 64 + top * 128, 128);
    var lv = nl - 1;
    while (lv > 0) {
        var ib = 0;
        var pe = zfs_dirty_find(os, obj, lv, zfs_shr(bid, epbs * lv));
        if (pe >= 0) { ib = zfs_dirty_buf(pe); }
        else {
            if (zfs_bp_hole(out) == 1) { return 0; }
            ib = zfs_mc_get(out);
            if (ib == 0) { return zfs_wnon("indirect unreadable: object ", obj); }
        }
        lv = lv - 1;
        memcpy(out, ib + (zfs_shr(bid, epbs * lv) & ((1 << epbs) - 1)) * 128, 128);
    }
    return 1 - zfs_bp_hole(out);
}
# Is large_blocks active ON the dataset whose MOS object is os (dsl_dataset_activate_feature's key in a zapified
# dataset)? 1 / 0 / -1 unreadable.
fn zfs_wf_lb(os) {
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, os, dn) != 0) { return 0 - 1; }
    if (load8(dn) != ZWK_ZAPMD) { return 0; }
    var v = 0;
    var r = zfs_zap_lookup(dn, "org.open-zfs:large_blocks", 25, 8, 1, &v);
    if (r >= 0) { return 1; }
    if (r == (0 - 2)) { return 0; }
    return 0 - 1;
}
# The single-block growth of a write whose end is end (the section header; zfs_write's blksz, zfs_rangelock_cb,
# zfs_grow_blocksize -> dnode_set_blksz -> dbuf_new_size): the file's block size afterwards, or -1 named. zfs_wf_gsz
# (B11 review) is the decision alone — the size it gives, bs when none — nothing changed (zfs_wf_write1 judges and
# charges a continued txg's growth before it is applied).
fn zfs_wf_gsz(dse, dn, os, size, end) {
    var bs = load16(dn + 8) << 9;
    var mx = zfs_wprop(load64(dse + 8), "recordsize", 0x20000);
    if (mx < 512) { return zfs_wno("properties unreadable"); }
    if (mx > 0x20000) {
        var lb = zfs_wf_lb(os);
        if (lb < 0) { return zfs_wno("unreadable: org.open-zfs:large_blocks"); }
        if (lb == 0) { mx = 0x20000; }
    }
    var p2 = 0;
    if ((bs & (bs - 1)) == 0) { p2 = 1; }
    var es = end;
    if (es < size) { es = size; }
    if (size > bs || es <= bs || (p2 == 1 && bs >= mx)) { return bs; }
    var nb = mx;
    if (bs > mx && p2 == 0) {
        nb = 1;                                  # 1 << highbit64(bs): the next power of two above it
        var x = bs;
        while (x != 0) {
            nb = nb << 1;
            x = x >> 1;
        }
    }
    var re = (es + 511) & (0 - 512);
    if (re < nb) { nb = re; }
    if (nb < bs) { nb = bs; }
    if (nb <= bs || load64(dn + 16) != 0) { return bs; }
    if (nb > ZK_DATAMAX) { return zfs_wnon("block size over 1 MiB: ", nb); }
    return nb;
}
fn zfs_wf_grow(dse, dn, os, obj, size, end) {
    var bs = load16(dn + 8) << 9;
    var nb = zfs_wf_gsz(dse, dn, os, size, end);
    if (nb < 512 || nb == bs) { return nb; }
    var bp[128];
    var h = zfs_wf_bp(dn, os, obj, 0, &bp);
    if (h < 0) { return 0 - 1; }
    if (h == 1) {
        var e = zfs_wblk(dn, os, obj, 0, 0);
        if (e < 0 || zfs_dirty_grow(e, nb) != 0) { return 0 - 1; }
    } elif (h == 2) {
        # (B11) block 0 already dirty in the pending txg (policy B: an earlier write#1 of this txg): its copy grows —
        # dbuf_new_size on a dirty dbuf
        if (zfs_dirty_grow(zfs_dirty_find(os, obj, 0, 0), nb) != 0) { return 0 - 1; }
    }
    store16(dn + 8, nb >> 9);
    return nb;
}
# The levels a maxblkid of bid needs (dnode_new_blkid: while nblkptr << (epbs x (levels - 1)) <= bid), and the
# growth to them (dnode_increase_indirection, dnode_sync.c:43-132): a new indirect at level old nlevels, blkid 0,
# takes the old dn_blkptr[] as its first entries; dn_blkptr[] is zeroed (its [0] gets the new top's BP at the commit,
# killing nothing); the levels between are dirtied as holes above it. 0 / -1 named.
fn zfs_wf_nlev(dn, bid) {
    var epbs = load8(dn + 1) - 7;
    var nbp = load8(dn + 3);
    var nn = 1;
    var sz = nbp;
    while (sz <= bid && sz >= nbp && nn < 9) {
        nn = nn + 1;
        sz = sz << epbs;
    }
    if (nn < load8(dn + 2)) { nn = load8(dn + 2); }
    return nn;
}
fn zfs_wf_levels(dn, os, obj, bid) {
    var nl = load8(dn + 2);
    var nbp = load8(dn + 3);
    var nn = zfs_wf_nlev(dn, bid);
    if (nn <= nl) { return 0; }
    if (zfs_dirty_find(os, obj, nl, 0) >= 0) { return zfs_wnon("level growth over a dirty indirect: object ", obj); }
    var e = zfs_dirty_add(os, obj, nl, 0, 1 << load8(dn + 1), load8(dn) << 8, 0);
    if (e < 0) { return 0 - 1; }
    memcpy(zfs_dirty_buf(e), dn + 64, nbp * 128);
    memset(dn + 64, 0, nbp * 128);
    store8(dn + 2, nn);
    if (nn > nl + 1 && zfs_wblk(dn, os, obj, nl + 1, 0) < 0) { return 0 - 1; }
    return 0;
}
# The ZPL's content-modified stamp in the bonus (zfs_tstamp_update_setup, CONTENT_MODIFIED): MTIME = CTIME = {now, 0}
# (zfs_wf_now), FLAGS |= ZFS_ARCHIVE | ZFS_AV_MODIFIED (z_use_fuids: every ZPL >= 3). 0.
fn zfs_wf_touch(bon) {
    var now = zfs_wf_now();
    store64(bon + zfs_wf_mt, now);
    store64(bon + zfs_wf_mt + 8, 0);
    store64(bon + zfs_wf_ct, now);
    store64(bon + zfs_wf_ct + 8, 0);
    store64(bon + zfs_wf_fl, load64(bon + zfs_wf_fl) | ZWF_ARCHIVE | ZWF_AVMOD);
    return 0;
}
# ONE txg of a write (the caller loops): bytes [pos, pos + n) of object obj of dataset slot di, the source at src
# (zfs_wf_copy; byte i of the txg at src + i), as many as the txg holds — then zfs_commit (pol 0, policy A; or a write
# the txg could not hold whole), or (pol 1, B11 — policy B) the txg is left OPEN, pending (zfs_wp_ref): the next write#1
# of the same object continues it (zfs_wf_begin), and close / sync / any other ZFS entry that could observe it commits
# it (the B11 section). grow = 1 in the write#1's first txg (zfs_wf_grow, decided from end, the write#1's end). The bytes
# committed or placed in the pending txg (> 0) · 0 the space or quota predicates refused with nothing in flight (named:
# EDQUOT / ENOSPC) · -1 named (nothing of this txg written; a failed commit leaves the pool read-only) · -2 (B11) a
# CONTINUED txg could not take this write's first byte (full, ERESTART, a level growth, a refusal): the caller commits
# the pending txg and asks again in a fresh one — the pending writes are never dropped.
fn zfs_wf_write1(di, obj, pos, src, n, end, grow, pol) {
    var dn = zfs_wf_begin(di, obj);
    if (dn == 0) {
        if (zfs_wf_cont == 1) { return 0 - 2; }
        zfs_wf_drop();
        return 0 - 1;
    }
    var cont = zfs_wf_cont;
    var dse = zfs_wf_dse;
    var os = load64(dse);
    var bon = zfs_bonus(dn);
    var size = load64(bon + zfs_wf_sz);
    # B5 review: the owner's user / group / project quotas, checked as zfs_write checks them before each chunk (here each
    # txg): EDQUOT
    if (zfs_wd_idq(dse, dn) != 0) {
        if (cont == 1) { return 0 - 2; }
        zfs_wf_drop();
        return 0;
    }
    var bs0 = load16(dn + 8) << 9;
    var bs = bs0;
    var un = 1 << zfs_ashift;
    # (B11 review) a CONTINUED txg's block-0 growth is decided (zfs_wf_gsz), judged — the level growth below, the space
    # predicates — and CHARGED at its new size BEFORE it is applied: a -2 after it would commit the pending txg with block
    # 0 grown but charged at its old size. The earlier, smaller charge stays (an over-charge, never an under-charge).
    var gch = 0;
    if (grow == 1 && cont == 1) {
        var gb = zfs_wf_gsz(dse, dn, os, size, end);
        if (gb < 512) { return 0 - 2; }
        if (gb != bs0) {
            if ((gb & (gb - 1)) == 0 && zfs_wf_nlev(dn, (pos + n - 1) / gb) > load8(dn + 2) + 1) { return 0 - 2; }
            if (zfs_wd_space(dse, gb, zfs_wf_infl, zfs_wf_inflr) != 0) { return 0 - 2; }
            zfs_wf_infl = zfs_wf_infl + gb * 24;
            zfs_wf_inflr = zfs_wf_inflr + ((gb + un - 1) & (0 - un)) * load64(dse + 80);
            gch = 1;
        }
    }
    if (grow == 1) { bs = zfs_wf_grow(dse, dn, os, obj, size, end); }
    if (bs < 512) {
        if (cont == 1) { return 0 - 2; }
        zfs_wf_drop();
        return 0 - 1;
    }
    var p2 = 0;
    if ((bs & (bs - 1)) == 0) { p2 = 1; }
    # (B11) a continued txg grows its levels by ONE as policy A's single write does (dnode_increase_indirection: the new
    # top takes the dirty dnode's dn_blkptr[], the children dirtied earlier in the txg find it as their parent); a growth
    # of two or more, whose middle levels zfs_wf_levels must still dirty after the dnode changed, commits first and the
    # write starts a fresh txg — so a failure there can only drop a txg of its own
    if (cont == 1 && p2 == 1 && zfs_wf_nlev(dn, (pos + n - 1) / bs) > load8(dn + 2) + 1) { return 0 - 2; }
    # (B11) block 0 grown: in a continued txg charged above at its new size (gch — ZWD_CHG set); in a fresh one ZWD_CHG
    # cleared, so the loop or the s0 check below charges it at its new size
    var eg = zfs_dirty_find(os, obj, 0, 0);
    if (bs != bs0 && eg >= 0) {
        if (gch == 1) { store64(zfs_dent(eg) + 56, load64(zfs_dent(eg) + 56) | ZWD_CHG); }
        else { store64(zfs_dent(eg) + 56, load64(zfs_dent(eg) + 56) & ~ZWD_CHG); }
    }
    var bsa = (bs + un - 1) & (0 - un);
    # B5 review: block 0 grown — so rewritten — in this txg while the write starts past it: user data the commit
    # allocates, charged like any block of the write (zfs_wd_space) — the loop below never reaches it. (B11) Charged
    # once a txg (ZWD_CHG) and added to what the pending txg already holds in flight.
    var e0 = zfs_dirty_find(os, obj, 0, 0);
    if (grow == 1 && gch == 0 && bs != bs0 && pos >= bs && e0 >= 0) {
        var s0 = zfs_wd_space(dse, bs, zfs_wf_infl, zfs_wf_inflr);
        if (s0 != 0) {
            if (cont == 1) { return 0 - 2; }
            zfs_wf_drop();
            return 0;
        }
        zfs_wf_infl = zfs_wf_infl + bs * 24;
        zfs_wf_inflr = zfs_wf_inflr + bsa * load64(dse + 80);
        store64(zfs_dent(e0) + 56, load64(zfs_dent(e0) + 56) | ZWD_CHG);
    }
    var ibs = 1 << load8(dn + 1);
    var iba = (ibs + un - 1) & (0 - un);
    var epbs = load8(dn + 1) - 7;
    var maxb = load64(dn + 16);
    var done = 0;
    var rc = 0;
    while (done < n && rc == 0) {
        var off = pos + done;
        var bid = 0;
        var bo = off;
        if (p2 == 1) {
            bid = off / bs;
            bo = off - bid * bs;
        } elif (off >= bs) {
            zfs_wnon("write past a single block of size ", bs);
            rc = 0 - 1;
            break;
        }
        var ch = bs - bo;
        if (ch > n - done) { ch = n - done; }
        # what dirtying this block costs: its slot, every indirect above it not dirty yet — after a level growth too,
        # whose moved top (old nlevels, blkid 0) may lie off the block's path
        var nl = load8(dn + 2);
        var nn = nl;
        if (bid > maxb) { nn = zfs_wf_nlev(dn, bid); }
        var nm = 0;
        var ne = 1;
        var lv = 1;
        while (lv < nn) {
            if (zfs_dirty_find(os, obj, lv, zfs_shr(bid, epbs * lv)) < 0) {
                nm = nm + iba;
                ne = ne + 1;
            }
            lv = lv + 1;
        }
        if (nn > nl && zfs_shr(bid, epbs * nl) != 0) {
            nm = nm + iba;
            ne = ne + 1;
        }
        # (B9 review, k.100) the deadlist entries this block's path reaches, PREDICTED (zfs_wdl_path) and budgeted
        # exactly: a block that does not fit ends the txg BEFORE it is dirtied (the next txg goes on with it), and only
        # a block no txg can hold — this one, first in its txg — is refused, by name
        var dlb = zfs_wdl_path(dse, dn, os, obj, 0, bid);
        if (dlb < 0) {
            if (done > 0) { break; }
            rc = 0 - 1;
            break;
        }
        var mb = zfs_dx_meta + nm + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres;
        # (B11) a block an earlier write of this txg dirtied takes no new slot and was charged already (ZWD_CHG)
        var pe = zfs_dirty_find(os, obj, 0, bid);
        var chg = 0;
        if (pe >= 0 && (load64(zfs_dent(pe) + 56) & ZWD_CHG) != 0) { chg = 1; }
        var nd = bsa;
        if (pe >= 0) { nd = 0; }
        if (zfs_dx_n + ne > ZWF_TXGBLK || mb + dlb > zfs_wf_alim() || zfs_dx_data + nd > zfs_dx_lim()) {
            if (done > 0) { break; }
            if (zfs_dx_n + ne <= ZWF_TXGBLK && mb + zfs_wdl_meta() <= zfs_wf_alim() && zfs_dx_data + nd <= zfs_dx_lim()) {
                zfs_wnon("one block does not fit a txg: the snapshot intervals its path reaches, ", zfs_wdl_pn);
            } else { zfs_wno("one block does not fit a txg"); }
            rc = 0 - 1;
            break;
        }
        var sr = 0;
        if (chg == 0) { sr = zfs_wd_space(dse, bs, zfs_wf_infl, zfs_wf_inflr); }
        if (sr == 1) { break; }
        if (sr < 0) {
            if (done > 0) { break; }
            if (cont == 1) { return 0 - 2; }
            zfs_wf_drop();
            return 0;
        }
        if (bid > maxb && zfs_wf_levels(dn, os, obj, bid) != 0) {
            rc = 0 - 1;
            break;
        }
        if ((bo == 0 && ch == bs) || bid > maxb) { zfs_wblk_nr = 1; }
        zfs_wdl_full = 0;
        var e = zfs_wblk(dn, os, obj, 0, bid);
        zfs_wblk_nr = 0;
        if (e < 0) {
            # (B9 review, k.100) the txg's size (zfs_wblk's deadlist refusal — the prediction above makes it a backstop)
            # ENDS the txg: the bytes already placed in it commit, the next txg goes on
            if (done > 0 && zfs_wdl_full == 1) { break; }
            rc = 0 - 1;
            break;
        }
        zfs_wf_copy(zfs_dirty_buf(e) + bo, src + done, off, ch);
        if (bid > maxb) {
            maxb = bid;
            store64(dn + 16, bid);
        }
        if (chg == 0) {
            zfs_wf_infl = zfs_wf_infl + bs * 24;
            zfs_wf_inflr = zfs_wf_inflr + bsa * load64(dse + 80);
            store64(zfs_dent(e) + 56, load64(zfs_dent(e) + 56) | ZWD_CHG);
        }
        done = done + ch;
    }
    if (rc != 0 || done == 0) {
        # (B11) a CONTINUED txg is never dropped: nothing placed — the caller commits it and asks again (-2); bytes placed
        # before the refusal — they commit with it, a SHORT write (every block dirtied so far is a whole COW copy).
        # (B11, a B5 defect found on the way) A FRESH txg whose first block met ERESTART (sr 1) holds what the write's
        # block-0 growth dirtied and charged above: it commits that growth and asks again (-2) — B5 dropped it and
        # answered -1, refusing near the slop a write the next txg would have taken
        if (cont == 0 && (rc != 0 || zfs_dx_n == 0)) {
            zfs_wf_drop();
            return 0 - 1;
        }
        if (done == 0) { return 0 - 2; }
    }
    if (pos + done > size) { store64(bon + zfs_wf_sz, pos + done); }
    zfs_wf_touch(bon);
    # (B11) POLICY B: the whole write is in the txg — leave it open, pending (zfs_wp_*); a write the txg could not hold
    # whole (the arenas — the 4 MiB data / ≈ 1.4 MiB metadata thresholds, ZWF_TXGBLK, ERESTART) commits here and goes on
    # in the next, as policy A's
    if (pol == 1 && rc == 0 && done == n) {
        if (zfs_wp_ref == 0) { zfs_wp_t = zfs_wp_now(); }
        zfs_wp_ref = ((di + 1) << 48) | obj;
        return done;
    }
    if (zfs_commit() != 0) { return 0 - 1; }
    return done;
}
# Between two txgs of ONE write#1 or truncation: fs_lock released and taken again (B5 review), so a request that needs
# many txgs holds the lock for ONE commit at a time (≈ 0.6 s on QEMU/KVM, design § k.8), never for all of them — a
# 1 GiB write is ≈ 250 txgs. The caller re-checks what another CPU may have changed meanwhile. The calling CPU stays
# IF=0 throughout, as in every syscall (SFMASK), so no other process runs on it; nothing here sleeps.
fn zfs_wf_yield() {
    fs_spin_unlock();
    fs_spin_lock();
    zfs_wt_yhook();          # (B11 review) ZFS_WRITE_OPS: the op list's stand-in for another CPU's write#1 here; a no-op twin
    return 0;
}
# ⭐ write#1 of n bytes at pos into ref: txg after txg (policy A — one, unless the open txg cannot hold the write),
# fs_lock released between them (zfs_wf_yield). base: the fd (0 = the op list) — after each release it must still be
# the same writable fd of the same object (its tag, object and generation: zfs_fd_size, D11) at the position this
# write left it at, else the write ends there; its position moves with each txg. The bytes written — SHORT when a
# predicate refused with nothing in flight (EDQUOT / ENOSPC), a later txg failed or the fd changed — or -1 named when
# none were. Caller holds fs_spin_lock.
# (B11) policy B for a write through an fd (base != 0, zfs_wp_pol 1): its txg stays open after it (zfs_wf_write1, pol 1)
# — a pending txg of ANOTHER object, or one older than the age bound, is committed first; the op list's direct writes
# (base 0) stay policy A.
fn zfs_wf_write(ref, base, pos, src, n) {
    if (n <= 0) { return 0; }
    var di = zfs_ref_di(ref);
    var obj = ref & ZK_MASK48;
    if (di < 0 || di >= zfs_nds) { return zfs_wno("not a dataset object"); }
    if (pos < 0 || pos + n < pos || pos + n > 0x7FFFFFFFFFFFFF) { return zfs_wno("offset out of range"); }
    var pol = 0;
    if (base != 0 && zfs_wp_pol == 1) { pol = 1; }
    if (zfs_wp_ref != 0 && (zfs_wp_ref != ref || pol == 0 || zfs_wp_aged() == 1)) {
        if (zfs_wp_flush() != 0) { return 0 - 1; }
    }
    var done = 0;
    var again = 0;
    while (done < n) {
        if (done > 0 && again == 0) {
            zfs_wf_yield();
            if (base != 0) {
                if (ktag(base) != VFS_ZFS_FILE || kpayload(base, 2) != ref || (kpayload(base, 1) & ZK_FDW) == 0) { break; }
                if (kpayload(base, 0) != pos + done || zfs_fd_size(base) < 0) { break; }
            }
            # (B11 review) a write#1 of another CPU may have left a pending txg in the gap: the rule at entry, again
            if (zfs_wp_ref != 0 && (zfs_wp_ref != ref || pol == 0 || zfs_wp_aged() == 1)) {
                if (zfs_wp_flush_why("yield") != 0) { break; }
            }
        }
        var was = again;
        again = 0;
        zfs_wp_c = 1;
        var r = zfs_wf_write1(di, obj, pos + done, src + done, n - done, pos + n, (done == 0), pol);
        zfs_wp_c = 0;
        if (r == (0 - 2)) {
            # (B11) the open txg — the pending one, or a fresh one holding only a block-0 growth — could not take this
            # write's first byte: commit it, then the same bytes in a fresh txg — once: (B11 review) a fresh txg's second
            # -2 (ERESTART again after that commit) holds nothing of the write (its dnode; a block-0 growth the first
            # commit published) and is DROPPED, so no dirty set outlives the op with no pending ref to commit it
            if (was == 1) {
                zfs_wf_drop();
                break;
            }
            if (zfs_wf_txflush() != 0) { break; }
            again = 1;
            continue;
        }
        if (r <= 0) { break; }
        done = done + r;
        if (base != 0) { kpayload_set(base, 0, pos + done); }
    }
    if (done == 0) { return 0 - 1; }
    return done;
}
# write#1 of a VFS_ZFS_FILE fd (vfs_write's ZFS arm, fs_lock held): a writable fd (ZK_FDW) whose object is still the
# one it opened (zfs_fd_size: the generation, D11), at its position, which moves with each txg. Bytes / -1. (B11) Policy
# B: the bytes stay in the open txg — durable at close / sync (the B11 section), not at return.
fn zfs_fd_write(base, buf, count) {
    if (count == 0) { return 0; }
    if (count < 0) { return zfs_wno("negative count"); }
    if ((kpayload(base, 1) & ZK_FDW) == 0) { return zfs_wno("fd not open for writing"); }
    if (zfs_fd_size(base) < 0) { return zfs_wno("the fd's object is gone or is another one (generation, D11)"); }
    return zfs_wf_write(kpayload(base, 2), base, kpayload(base, 0), buf, count);
}

# --- B11: POLICY B — per-fd write coalescing and its commit hooks (design § b.2 D1 (b), § b.3; ABI § 3.6) --------------
# The engine (§ b.1) stays policy-free: zfs_wf_write1 dirties, zfs_commit commits. POLICY B is this layer: a write#1
# through an fd leaves its txg OPEN — PENDING, zfs_wp_ref names its object — and the next write#1 of the same object
# continues it (zfs_wf_begin), so a `cp` of 64 KiB writes is ONE txg per file. The pending txg commits (zfs_wp_flush):
#   · at close#6 of an fd of its object (vfs_close_inner); at a process's DEATH, before it is published (B11 review:
#     zfs_release_pid — from the timer ISR owed to the next B1, zfs_wp_owed); at its fd table's teardown (reap)
#   · at sync#12 (zfs_wp_sync) and at power_flush / shutdown (power.cyr) — durable when they return
#   · at the thresholds: a write the txg cannot hold whole commits it and goes on in the next (the 4 MiB data arena, the
#     metadata arena less ZWF_MRSV, ZWF_TXGBLK blocks — the log bound — and OpenZFS's ERESTART, k.36: zfs_wf_write1)
#   · at the age bound: a pending txg older than ZWP_AGE (5 s, zfs_txg_timeout) when any ZFS entry sees it (zfs_wp_obs,
#     zfs_wf_write) — agnos has no sync thread (policy C), so an idle pending txg waits for the next entry or close
#   · COMMIT-BEFORE-OBSERVE, the narrower rule (design § k.124 (B11) proves it): the reader never consults the dirty set,
#     and the pending txg changes, as the ABI can see it, ONLY its object's content and attributes and the pool's space;
#     so it commits before any entry that reads THAT object — read#5 (zfs_fd_read), SEEK_END (lseek's arm), stat /
#     lstat (zfs_stat_ref), the exec / kernel readers (zfs_file_size), open#7 of it — before statfs#103 (zfs_fill_statfs),
#     before EVERY mutation (create / mkdir / symlink / unlink / rmdir / rename / link / AO_TRUNC — they need the dirty
#     set to themselves) and before a write#1 of ANOTHER object; a read of another file, getdents / readdir (names
#     only), readlink, never — so a cp from ZFS to ZFS stays one txg per file
# A commit that FAILS here leaves the pool read-only (zfs_wfail) and the writes it held are lost: their object is
# remembered (zfs_wp_eref) and the next close of a writable fd of it, or sync#12, answers -1 — POSIX's deferred EIO.
# Caller holds fs_spin_lock for every function below (the arms, vfs_close_inner, proc_destroy_fd_table, power_flush).
enum ZfsWP2 {
    ZWP_AGE = 5000000;                  # µs: zfs_txg_timeout (5 s, txg.c) — the pending txg's age bound
}
var zfs_wp_ref = 0;          # the ref (dataset slot + 1 << 48 | object) whose write#1s the open txg holds uncommitted; 0 none
var zfs_wp_t = 0;            # klog_uptime_us when it opened (zfs_wp_now)
var zfs_wp_c = 0;            # 1 while zfs_wf_write asks zfs_wf_write1 to CONTINUE a pending txg of its object
var zfs_wp_pol = 1;          # 1 = policy B for fd writes (D1 (b)); 0 = policy A everywhere (the op list's comparisons)
var zfs_wp_eref = 0;         # the ref whose pending txg's commit FAILED (its writes lost; reported at close / sync)
var zfs_wp_n = 0;            # pending txgs committed by a hook (the op list's b11 line)
var zfs_wp_why = 0;          # what committed the last one (a literal: close, sync, observe, ...) — the op list prints it
var zfs_wp_owed = 0;         # (B11 review) 1: its writer died in an interrupt handler — the commit is owed to the next B1
fn zfs_wp_now() { return klog_uptime_us(); }
# Is the pending txg past the age bound? 1 / 0. ZFS_WRITE_OPS: only its knob ages it (zfs_wt_age), so the op list's
# txg boundaries — and its images — do not depend on how fast a lane's device is.
#ifdef ZFS_WRITE_OPS
var zfs_wt_age = 0;
fn zfs_wp_aged() {
    if (zfs_wp_ref != 0 && (zfs_wt_age == 1 || zfs_wp_owed == 1)) { return 1; }
    return 0;
}
#endif
#ifndef ZFS_WRITE_OPS
fn zfs_wp_aged() {
    if (zfs_wp_ref != 0 && (zfs_wp_owed == 1 || zfs_wp_now() - zfs_wp_t >= ZWP_AGE)) { return 1; }
    return 0;
}
#endif
# Commit the pending txg, if there is one (why: the hook's name, a literal). 0 / -1 (the pool is read-only now and the
# writes it held are lost — zfs_wp_eref).
fn zfs_wp_flush_why(why) {
    if (zfs_wp_ref == 0) { return 0; }
    var ref = zfs_wp_ref;
    zfs_wp_why = why;
    zfs_wp_n = zfs_wp_n + 1;
    if (zfs_commit() != 0) {
        zfs_wp_eref = ref;
        return 0 - 1;
    }
    return 0;
}
fn zfs_wp_flush() { return zfs_wp_flush_why("observe"); }
# (B11 review) An op that opens a txg of its OWN (zfs_wf_begin uncontinued, zfs_wc1, zfs_wu_begin) takes the dirty set to
# itself: a pending txg — another CPU's write#1 that ran while a multi-txg write#1 or truncation had fs_lock released
# (zfs_wf_yield) — COMMITS first ("begin"), never goes with the op's refusal (zfs_wf_drop). 0 / -1 (that commit failed:
# the pool is read-only, zfs_wp_eref).
fn zfs_wp_own() {
    if (zfs_wp_ref == 0) { return 0; }
    return zfs_wp_flush_why("begin");
}
# zfs_wf_write's -2: commit whatever the open txg holds — the pending one, or a block-0 growth (zfs_wf_write1). 0 / -1.
fn zfs_wf_txflush() {
    if (zfs_wp_ref != 0) { return zfs_wp_flush_why("full"); }
    if (zfs_dx_n == 0) { return 0; }
    return zfs_commit();
}
# Commit-before-observe for an entry that reads object ref (the section header), or that a pending txg past the age
# bound meets. 0 / -1.
fn zfs_wp_obs(ref) {
    if (zfs_wp_ref == 0) { return 0; }
    if (ref == zfs_wp_ref) { return zfs_wp_flush_why("observe"); }
    if (zfs_wp_aged() == 1) { return zfs_wp_flush_why("age"); }
    return 0;
}
# close#6 of an fd / the teardown of a process's table (vfs.cyr): a ZFS file fd of the pending object commits it; a
# writable fd of an object whose pending commit failed answers -1 (once). 0 / -1.
fn zfs_wp_close(base) {
    if (ktag(base) != VFS_ZFS_FILE) { return 0; }
    var ref = kpayload(base, 2);
    if (zfs_wp_ref != 0 && zfs_wp_ref == ref) {
        # (B11 review) never inside an interrupt handler — the timer ISR's death chain reaches an orphan's fd-table
        # teardown (IF=0, its vector in service, the EOI not sent): the commit is OWED (zfs_release_pid's deferral)
        if (apic_in_service() == 1) {
            zfs_wp_owed = 1;
            return 0;
        }
        if (zfs_wp_flush_why("close") != 0) { return 0 - 1; }
    }
    if (zfs_wp_eref != 0 && zfs_wp_eref == ref && (kpayload(base, 1) & ZK_FDW) != 0) {
        zfs_wp_eref = 0;
        return 0 - 1;
    }
    return 0;
}
# sync#12 and power_flush: the pending txg committed — every commit flushes the device twice, so nothing ZFS holds is
# volatile after it. -1 when it failed, or an earlier hook's commit did (zfs_wp_eref, reported once).
fn zfs_wp_sync() {
    if (zfs_active == 0) { return 0; }
    if (zfs_wp_flush_why("sync") != 0) {
        zfs_wp_eref = 0;
        return 0 - 1;
    }
    if (zfs_wp_eref != 0) {
        zfs_wp_eref = 0;
        return 0 - 1;
    }
    return 0;
}
# (B11 review) THE EXIT HOOK (syscall.cyr proc_death_release — every death: exit#0, a fault, a kill at B1, a claim, a
# wait's ABORT, the tick): a pending txg one of the dying process's ZFS fds names commits ("exit") BEFORE the death is
# published — not when a parent reaps it, which a parent that never waits never does. Inside an interrupt handler (isr
# 1: VIA_TICK, D-34 — IF=0, the timer vector in service; or wherever apic_in_service says so) nothing commits: the
# commit is OWED (zfs_wp_owed) to the next B1 of any process (sched.cyr proc_b1, as klug_spill_owed) and ages the
# pending txg for every ZFS entry meanwhile (zfs_wp_aged); sync#12 / power_flush commit it as ever. Takes fs_lock — no
# caller holds it (proc_destroy_fd_table's contract, which the orphan's reap runs from the same paths). 0.
fn zfs_release_pid(pid, isr) {
    var t = proc_fd_base_get(pid);
    if (t == 0 || zfs_active == 0) { return 0; }
    if (isr == 1 || apic_in_service() == 1) {
        # no lock in the handler: a racy look — a stale zfs_wp_ref can only make the owed commit an early one
        var k = 0;
        while (k < 32) {
            var b = t + k * 32;
            if (ktag(b) == VFS_ZFS_FILE && zfs_wp_ref != 0 && kpayload(b, 2) == zfs_wp_ref) { zfs_wp_owed = 1; }
            k = k + 1;
        }
        return 0;
    }
    preempt_disable();
    fs_spin_lock();
    var i = 0;
    while (i < 32) {
        var base = t + i * 32;
        if (ktag(base) == VFS_ZFS_FILE && zfs_wp_ref != 0 && kpayload(base, 2) == zfs_wp_ref) { zfs_wp_flush_why("exit"); }
        i = i + 1;
    }
    fs_spin_unlock();
    preempt_enable();
    return 0;
}
# The owed commit, at the next B1 of any process (sched.cyr proc_b1): syscall context, no lock held. 0.
fn zfs_wp_owed_run() {
    preempt_disable();
    fs_spin_lock();
    if (zfs_wp_owed == 1) {
        zfs_wp_owed = 0;
        zfs_wp_flush_why("exit");
    }
    fs_spin_unlock();
    preempt_enable();
    return 0;
}

# --- B11: the commit's hold, and interrupt windows inside it (design § b.3 "Hold time", k.8; k.126 (B11)) -----------
# The commit runs under fs_lock — preemption off (a plain spinlock, smp.cyr) — and, inside a syscall, with IF=0 (SFMASK):
# ≈ 15-500 ms a txg on QEMU/KVM NVMe as B11 measures it (k.126; k.8's 0.2-0.9 s had the op list's console inside),
# during which this CPU took no timer tick, no keyboard or NIC interrupt. OpenZFS's
# txg_sync_thread runs with interrupts on; Linux and FreeBSD never hold a spinlock across device I/O. What fits agnos now
# (the measurable part): INTERRUPT WINDOWS at every point the commit holds no lock but fs_lock — between its device
# writes (zfs_wr), around its flushes, and inside the NVMe / AHCI completion polls it is waiting in (io.cyr kirqw_point,
# opted in for THIS CPU only while the commit runs): `clac; sti; nop; cli` bracketed by pushfq / popfq, so a pending
# interrupt is taken and the caller's IF and AC come back exactly. Safe because preempt_count > 0 for the whole commit
# (fs_lock), so the timer ISR never switches it out (do_context_switch refuses), and no interrupt handler takes fs_lock,
# a block-device lock or console_lock from the kernel frame a window interrupts (timer_handler: net / hid / hda / wq /
# sched — pic.cyr; NVMe and AHCI are polled, no ISR; the tick's death chain, which reaches proc_destroy_fd_table and so
# fs_lock, acts only on a CPL3 frame with preempt_count 0 — sched.cyr INV-L2). Not on USB mass storage (its xHCI event ring is shared with hid_poll, which the timer ISR runs) nor virtio.
# Windows OPEN only once the scheduler is live (sched_active): the boot-time op list measures where they would be.
# ⚠ What it does NOT fix: another CPU that wants fs_lock still spins for the whole commit — an ownership lock that lets
# ext2 / FAT run beside a ZFS commit is the rest, recorded with its numbers in design k.126 (B11).
var zfs_wc_t0 = 0;           # the commit's start (klog_uptime_us) · its hold (µs) · the longest stretch with no window
var zfs_wc_hold = 0;         #   (µs) · the windows opened — the op list's b11 line
var zfs_wc_imax = 0;
var zfs_wc_iwin = 0;
var zfs_wr_cls = 0;          # the class of the device write zfs_wr does next (the cut knob's map): 1 data · 2 dataset
#   metadata · 3 MOS · 4 the MOS chain · 5 + l the uberblock slot of label l
# The commit's hold and windows recorded, the windows withdrawn — at the publish, before the op list's plan line (≈ 0.4 s
# of console rendering on QEMU that no production commit prints, k.49), or at a failure. 0.
fn zfs_wc_mark() {
    zfs_wc_hold = klog_uptime_us() - zfs_wc_t0;
    kirqw_end();
    zfs_wc_imax = kirqw_max;
    zfs_wc_iwin = kirqw_n;
    return 0;
}
var zfs_wirq_no = 0;         # (B11 review) 1 = never open windows: power_flush's final commit (power_stop_final's IF=0 teardown)
fn zfs_wirq_on() {
    if (zfs_wirq_no == 1) { return 0; }
    if (zfs_backend != BLK_NVME && zfs_backend != BLK_AHCI) { return 0; }
    if (sched_active == 1) { return 1; }
    return 0;
}
# Room in the open txg's extent list (ZWK_MAXXL) for nk more killed DVAs once nb more blocks are dirty (B5 review: a
# truncation's kill list was never measured against it — 4,096 freed 4 KiB L0s of one 20 MiB file overflowed it inside
# the commit, the pool then read-only until reboot): every dirty block, and the ZWF_CRSV the commit and the walk's
# dnode_dirty_l1 / boundary-block paths may still add, allocates <= 3 DVAs and kills <= 3; each killed DVA of the kill
# list is one FREE. Kept, it also keeps log T inside its one block (zfs_wc_plan). 1 fits / 0.
fn zfs_wf_xfit(nb, nk) {
    var hb = 0;
    var hx = 0;
    if (zfs_wc_in == 0) {                            # (B10 review, k.119) hygiene's minimum (zfs_wl_hres)
        hb = zfs_wl_hb;
        hx = zfs_wl_hx;
    }
    if (zfs_wfr_x + nk + hx + 6 * (zfs_dx_n + nb + hb + ZWF_CRSV) <= ZWK_MAXXL) { return 1; }
    return 0;
}
# Kill the non-hole level-0 BP at bp of object obj in the open txg (free_blocks, dnode_sync.c:140-178): judged killable
# (zfs_wd_okbp — an encrypted one is refused by name; (B7) a gang / dedup / possibly-cloned one is killed by the commit
# through free_bpobj, zfs_wd_defer; (B9) a snapshot-owned one through the deadlist, its append budgeted: zfs_wdl_q),
# copied to the kill list (ZWF_FRL; zfs_wd_phase
# kills it inside the commit) and replaced by a hole of birth t (0: all zero — no hole_birth) keeping its LSIZE and
# TYPE. 0 · 1 the txg is full — the kill list, or the extent list for its DVAs (zfs_wf_xfit): nothing changed · -1 named.
fn zfs_wf_kill(dse, os, obj, bp, t) {
    var sk = 0;                                      # (B9) a snapshot's block: deadlisted, no FREE extent
    if (zfs_wugt(zfs_bp_birth(bp), load64(dse + 56)) == 0) { sk = 1; }
    var nd = 0;
    if (sk == 0 && ((load64(bp + 48) >> 39) & 1) == 0) {
        var k = 0;
        while (k < 3) {
            if (load64(bp + k * 16) != 0 || load64(bp + k * 16 + 8) != 0) { nd = nd + 1; }
            k = k + 1;
        }
    }
    if (zfs_wfr_n >= ZWF_FRMAX || zfs_wf_xfit(0, nd) == 0) { return 1; }
    if (zfs_wt_ftight > 0 && zfs_wfr_n >= zfs_wt_ftight) { return 1; }      # the op list's knob (ZFS_WRITE_OPS only)
    var df = 0;                                      # (B7 review, k.70) a deferred kill's append, budgeted
    if (nd > 0 && zfs_wd_defer(bp) == 1) { df = 1; }
    if (df == 1 && zfs_dx_meta + zfs_wfb_meta(zfs_wfb_q + 1) + zfs_wdl_meta() > zfs_wf_alim()) { return 1; }
    if (zfs_wd_okbp(dse, bp) != 0) { return 0 - 1; }
    if (sk == 1) {                                   # (B9) a deadlist append, budgeted the same way
        var qr = zfs_wdl_q(dse, bp, 2);
        if (qr != 0) { return qr; }
    }
    var fe = zfs_wmem + ZWA_OS + ZWF_FRL + zfs_wfr_n * 144;
    store64(fe, os);
    store64(fe + 8, obj);
    memcpy(fe + 16, bp, 128);
    zfs_wfr_n = zfs_wfr_n + 1;
    zfs_wfr_x = zfs_wfr_x + nd;
    zfs_wfb_q = zfs_wfb_q + df;
    if (zfs_bp_mkhole(bp, zfs_bp_lsize(fe + 16), (load64(fe + 64) >> 48) & 0xFF, 0, t) != 0) { return zfs_wnon("hole not encodable: object ", obj); }
    return 0;
}
# Free level-0 blocks [first, last] under the non-hole indirect (lv, bid) of object obj, HIGHEST FIRST, dirtying the
# indirect and every child indirect with blocks in range (free_children, dnode_sync.c:248-347): each non-hole L0 BP in
# range killed (zfs_wf_kill: the kill list, a hole of birth T — free_blocks' LSIZE, TYPE, LEVEL, BP_SET_BIRTH(T, 0)
# under hole_birth, else all zero); holes stay as they are. When the txg is full (ZWF_TXGBLK, the metadata arena, the
# kill list, the extent list: zfs_wf_xfit) it stops with zfs_wf_stop = 1; zfs_wf_lo is the lowest block whose whole
# range up to last is freed. 0 / -1 named.
fn zfs_wf_walk(dse, dn, os, obj, lv, bid, first, last) {
    if (zfs_dirty_find(os, obj, lv, bid) < 0) {
        # (B9 review, k.100) the indirect's own predecessor predicted (zfs_wdl_path — its parent is dirty): exact, no
        # reserve; one that does not fit ends the txg here
        var dlb = zfs_wdl_path(dse, dn, os, obj, lv, bid);
        if (dlb < 0) { return 0 - 1; }
        if (zfs_dx_n + 1 > ZWF_TXGBLK || zfs_dx_meta + zfs_wdl_pm + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + dlb > zfs_wf_alim() || zfs_wf_xfit(1, 0) == 0) {
            zfs_wf_stop = 1;
            return 0;
        }
    }
    var e = zfs_wblk(dn, os, obj, lv, bid);
    if (e < 0) { return 0 - 1; }
    var buf = zfs_dirty_buf(e);
    var epbs = load8(dn + 1) - 7;
    var csh = epbs * (lv - 1);
    var t = zfs_txg + 1;
    if ((zfs_w_feat & 8) == 0) { t = 0; }
    var j = (1 << epbs) - 1;
    while (j >= 0 && zfs_wf_stop == 0) {
        var cf = ((bid << epbs) + j) << csh;
        var cl = cf + (1 << csh) - 1;
        if (cf <= last && cl >= first) {
            var cbp = buf + j * 128;
            if (zfs_bp_hole(cbp) == 0) {
                if (lv == 1) {
                    var kr = zfs_wf_kill(dse, os, obj, cbp, t);
                    if (kr < 0) { return 0 - 1; }
                    if (kr == 1) {
                        zfs_wf_stop = 1;
                        return 0;
                    }
                } else {
                    if (zfs_wf_walk(dse, dn, os, obj, lv - 1, (bid << epbs) + j, first, last) != 0) { return 0 - 1; }
                    if (zfs_wf_stop == 1) { return 0; }
                }
            }
            if (cf > first) { zfs_wf_lo = cf; } else { zfs_wf_lo = first; }
        }
        j = j - 1;
    }
    return 0;
}
# Free level-0 blocks [first, last] of object obj (dnode_sync_free_range_impl), highest first, as far as this txg holds
# — the first and last L1 dirtied even when holes (dnode_free_range's dnode_dirty_l1). The lowest block freed: every
# block from it to last is a hole now (first = all done), or -1 named.
fn zfs_wf_freeblks(dse, dn, os, obj, first, last) {
    zfs_wf_lo = last + 1;
    zfs_wf_stop = 0;
    var nl = load8(dn + 2);
    var nbp = load8(dn + 3);
    var epbs = load8(dn + 1) - 7;
    var t = zfs_txg + 1;
    if ((zfs_w_feat & 8) == 0) { t = 0; }
    if (nl == 1) {
        var b = last;
        if (b >= nbp) { b = nbp - 1; }
        while (b >= first) {
            var bp = dn + 64 + b * 128;
            if (zfs_bp_hole(bp) == 0) {
                var kr = zfs_wf_kill(dse, os, obj, bp, t);
                if (kr < 0) { return 0 - 1; }
                if (kr == 1) { return b + 1; }
            }
            b = b - 1;
        }
        return first;
    }
    # (B9 review, k.99 / k.100) the last L1's path predicted first (zfs_wdl_path): a txg that cannot hold it frees nothing
    # (last + 1) — refused by name, which zfs_wf_dlscan's bound keeps to the FIRST txg, before anything is freed
    var dlb = zfs_wdl_path(dse, dn, os, obj, 1, last >> epbs);
    if (dlb < 0) { return 0 - 1; }
    if (zfs_dx_meta + zfs_wdl_pm + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + dlb > zfs_wf_alim()) { return last + 1; }
    if (zfs_wblk(dn, os, obj, 1, last >> epbs) < 0) { return 0 - 1; }
    var sh = epbs * (nl - 1);
    var top = zfs_shr(last, sh);
    if (top >= nbp) { top = nbp - 1; }
    while (top >= 0 && zfs_wf_stop == 0) {
        var tf = top << sh;
        if (tf + (1 << sh) - 1 < first) { break; }
        if (zfs_bp_hole(dn + 64 + top * 128) == 0) {
            if (zfs_wf_walk(dse, dn, os, obj, nl - 1, top, first, last) != 0) { return 0 - 1; }
        }
        if (zfs_wf_stop == 0) {
            if (tf > first) { zfs_wf_lo = tf; } else { zfs_wf_lo = first; }
        }
        top = top - 1;
    }
    # the first L1 at the end (dnode_dirty_l1): every non-hole block on its path inside the range the walk dirtied
    # already, so it reaches no deadlist entry (B9 review) — only hole indirects, re-materialised
    if (zfs_wf_lo == first && zfs_wblk(dn, os, obj, 1, first >> epbs) < 0) { return 0 - 1; }
    return zfs_wf_lo;
}
# (B5 review) May every block a truncation of level-0 range [first, last] frees or rewrites be killed? zfs_wd_okbp over
# each non-hole BP whose subtree meets the range — the indirects the walk dirties, the L0s it frees, the boundary block
# — READ-ONLY through the reader, before the first txg (zfs_wf_okscan): a block low in the file the commit cannot kill
# (an encrypted one) would otherwise be refused in a LATER txg, after the earlier ones had freed the range above it.
# (B9 review, k.99) B7 made gang / dedup blocks killable and B9 snapshot-owned ones, but a snapshot's block can still
# be refused by its DEADLIST — so its entry is resolved here too (zfs_wdl_ent: the deadlist loaded, past ZWK_MAXDLE
# keys, a bpobj or an entry unreadable, a birth before every entry — refused while nothing is freed) and counted in
# the entry's scan total (+64) for zfs_wf_dlscan. bp is a stable copy; the reader's cache may evict a parent while a
# child is read, so the indirect is fetched again per child. 0 / -1 named.
fn zfs_wf_okbps(dse, bp, lv, bid, epbs, first, last) {
    if (zfs_bp_hole(bp) == 1) { return 0; }
    if (zfs_wd_okbp(dse, bp) != 0) { return 0 - 1; }
    if (zfs_wugt(zfs_bp_birth(bp), load64(dse + 56)) == 0) {
        var x = zfs_wdl_ent(zfs_dsk(dse), zfs_bp_birth(bp));
        if (x < 0) { return 0 - 1; }
        store64(zfs_dle(x) + 64, load64(zfs_dle(x) + 64) + 1);
    }
    if (lv == 0 || ((load64(bp + 48) >> 39) & 1) == 1) { return 0; }
    var c[128];
    var csh = epbs * (lv - 1);
    var j = 0;
    while (j < (1 << epbs)) {
        var cb = (bid << epbs) + j;
        if (zfs_shr(last, csh) < cb) { return 0; }
        if (zfs_shr(first, csh) <= cb) {
            var ib = zfs_mc_get(bp);
            if (ib == 0) { return zfs_wno("indirect unreadable"); }
            memcpy(&c, ib + j * 128, 128);
            if (zfs_wf_okbps(dse, &c, lv - 1, cb, epbs, first, last) != 0) { return 0 - 1; }
        }
        j = j + 1;
    }
    return 0;
}
fn zfs_wf_okscan(dse, dn, first, last) {
    var nl = load8(dn + 2);
    var epbs = load8(dn + 1) - 7;
    var sh = epbs * (nl - 1);
    var c[128];
    var i = 0;
    while (i < load8(dn + 3)) {
        if (zfs_shr(last, sh) < i) { return 0; }
        if (zfs_shr(first, sh) <= i) {
            memcpy(&c, dn + 64 + i * 128, 128);
            if (zfs_wf_okbps(dse, &c, nl - 1, i, epbs, first, last) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    return 0;
}
# (B9 review, k.99) After a truncation's scan (zfs_wf_okscan), before its first txg dirties a block of the walk:
#   (1) every entry its kills reach that still names the empty_bpobj will be MATERIALISED in some txg of it — the
#       empty_bpobj's last reference and a fat deadlist (zfs_wdl_matok's rules) are refused NOW, for all of them;
#   (2) zfs_wf_tb = 1 when a LATER txg might not hold its first step — the blocks every txg of it dirties (what
#       zfs_wf_begin dirtied: zfs_dx_meta now), the walk's indirect path ((nlevels - 1) x the indirect size), each
#       open dataset's deadlist blocks, free_bpobj's share, the entries of the accounting ZAPs a later admission counts
#       again if txg 1 does not rewrite them (zfs_wds_open), and the nlevels entries whose first appends cost most
#       (zfs_wf_dlx). A later txg's first step — the last L1's path and its first kill, or the boundary block —
#       reaches no more than nlevels entries, and what txg 1 rewrote (the objset, the meta-dnode's chain, the dnode
#       block) is branch A there. zfs_wf_trunc1 refuses a truncation that needs a second txg while zfs_wf_tb is 1 —
#       before txg 1 commits. 0 / -1 named.
var zfs_wf_tb = 0;
fn zfs_wf_dlscan(dse, dn) {
    zfs_wf_tb = 0;
    var k = zfs_dsk(dse);
    var n = 0;
    var x = 0;
    while (x < zfs_wdl_n) {
        if (load64(zfs_dle(x) + 16) == zfs_w_ebo && (load64(zfs_dle(x) + 24) > 0 || load64(zfs_dle(x) + 64) > 0)) { n = n + 1; }
        x = x + 1;
    }
    if (n > 0) {
        if (zfs_w_ebr - n <= 0) { return zfs_wno("empty_bpobj's last reference (its removal is not built)"); }
        if (zfs_wdl_fatok(zfs_dsb(k)) != 0) { return 0 - 1; }
    }
    var nl = load8(dn + 2);
    var un = 1 << zfs_ashift;
    var need = zfs_dx_meta + (nl - 1) * (((1 << load8(dn + 1)) + un - 1) & (0 - un)) + zfs_wfb_meta(nl);
    var j = 0;
    while (j < zfs_wd_n) {
        if (load64(zfs_dsb(j) + 48) == 1) { need = need + 0x8000; }
        j = j + 1;
    }
    var pk[256];
    memset(&pk, 0, 256);
    var oe = zfs_dirty_find(load64(dse), ZWO_OSB, 0, 0);
    var fl = load64(dse + 104);
    if (oe >= 0 && (fl & 1) != 0) {
        j = 0;
        while (j < 2 + ((fl >> 2) & 1)) {
            var sd = zfs_dirty_buf(oe) + 1024 + j * 512;
            # (merge, k.107) a FAT accounting ZAP (B8): the blocks a later txg's admission dirties in it lie below its
            # top-level BPs, their entries not bounded here — a truncation that needs a second txg is refused at txg 1
            if (((load64(dse + 120) >> (16 * j)) & 0xFFFF) == 0xFFFF && load64(zfs_dsb(k) + 48) == 1) { zfs_wf_tb = 1; }
            if (zfs_bp_hole(sd + 64) == 0 && zfs_wugt(zfs_bp_birth(sd + 64), load64(dse + 56)) == 0) {
                x = zfs_wdl_ent(k, zfs_bp_birth(sd + 64));
                if (x < 0) { return 0 - 1; }
                if (load8(&pk + x) == 0) {
                    store8(&pk + x, 1);
                    need = need + zfs_wf_dlx(x, nl);
                }
            }
            j = j + 1;
        }
    }
    var t = 0;
    while (t < nl) {
        var best = 0 - 1;
        var bb = 0;
        x = 0;
        while (x < zfs_wdl_n) {
            if (load8(&pk + x) == 0 && load64(zfs_dle(x) + 64) > 0) {
                var c = zfs_wf_dlx(x, nl);
                if (c > bb) {
                    bb = c;
                    best = x;
                }
            }
            x = x + 1;
        }
        if (best >= 0) {
            store8(&pk + best, 1);
            need = need + bb;
        }
        t = t + 1;
    }
    if (need > zfs_wf_alim()) { zfs_wf_tb = 1; }
    return 0;
}
# The most entry x of ZWA_DLE can dirty at a later txg's first step of a truncation of an nl-level object (zfs_wf_dlscan):
# its first appends (<= nl path BPs and 3 accounting ZAPs, ZWF_FBM more) at any committed count the truncation can leave
# it at — from its count now to that plus every kill counted (+24) and scanned (+64) for it (zfs_wbpo_mx) — and, while
# it still names the empty_bpobj, its materialisation (the new bpobj's dnode block, the deadlist ZAP block).
fn zfs_wf_dlx(x, nl) {
    var de = zfs_dle(x);
    var c = zfs_wbpo_mx(load64(de + 32), load64(de + 32) + load64(de + 24) + load64(de + 64), nl + 3 + ZWF_FBM, load64(de + 40), load64(de + 48), load64(de + 56));
    if (load64(de + 16) == zfs_w_ebo) { c = c + 0x4000 + load64(zfs_dsb(load64(de)) + 104); }
    return c;
}
# Zero bytes [from, to) of level-0 block bid as a copy on write (dnode_partial_zero): only a block that is on disk or
# dirty — a hole stays a hole. A block on disk is rewritten: user data the commit allocates, so agnos's allocation rule
# first (zfs_wd_aroom — no quota: a truncation frees) and the block charged as in flight (B5 review). 0 / -1 named.
fn zfs_wf_pzero(dse, dn, os, obj, bid, from, to) {
    var bp[128];
    var h = zfs_wf_bp(dn, os, obj, bid, &bp);
    if (h < 0) { return 0 - 1; }
    if (h == 0) { return 0; }
    if (h == 1) {
        var un = 1 << zfs_ashift;
        var bs = load16(dn + 8) << 9;
        if (zfs_wd_aroom(dse, bs, zfs_wf_inflr) != 0) { return 0 - 1; }
        zfs_wf_inflr = zfs_wf_inflr + ((bs + un - 1) & (0 - un)) * load64(dse + 80);
    }
    var e = zfs_wblk(dn, os, obj, 0, bid);
    if (e < 0) { return 0 - 1; }
    memset(zfs_dirty_buf(e) + from, 0, to - from);
    return 0;
}
# ONE txg of a truncation of object obj of dataset slot di to len bytes (zfs_trunc -> dmu_free_long_range ->
# dnode_free_range, then zfs_freesp's stamp): the whole blocks past len freed from the top as far as the txg holds
# (zfs_wf_freeblks; dn_maxblkid = the block below the lowest freed, dnode_sync_free_range_impl); in the LAST txg the
# boundary block's tail zeroed (zfs_wf_pzero), SIZE = len (only when it shrinks: zfs_trunc returns at once otherwise),
# ZFS_SPARSE cleared at 0, the content-modified stamp. scan = 1 (the first txg): every block the whole truncation
# frees or rewrites judged first (zfs_wf_okscan). 0 done · 1 more txgs needed · -1 named.
fn zfs_wf_trunc1(di, obj, len, scan) {
    var dn = zfs_wf_begin(di, obj);
    if (dn == 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    var dse = zfs_wf_dse;
    var os = load64(dse);
    var bon = zfs_bonus(dn);
    var size = load64(bon + zfs_wf_sz);
    zfs_dx_dmax = ZWF_FRL;
    var more = 0;
    var r = 0;
    if (len < size) {
        var bs = load16(dn + 8) << 9;
        var maxb = load64(dn + 16);
        var pb = 0 - 1;
        var pf = 0;
        var first = 0;
        if ((bs & (bs - 1)) != 0) {
            if (maxb != 0) { r = zfs_wnon("several blocks of a non-power-of-two size: object ", obj); }
            elif (len >= bs) { first = 1; }
            elif (len > 0) {
                pb = 0;
                pf = len;
                first = 1;
            }
        } else {
            first = len / bs;
            if (len - first * bs != 0) {
                pb = first;
                pf = len - first * bs;
                first = first + 1;
            }
        }
        if (r == 0 && scan == 1) {
            var sf = first;
            if (pb >= 0) { sf = pb; }
            if (sf <= maxb && zfs_wf_okscan(dse, dn, sf, maxb) != 0) { r = 0 - 1; }
            elif (zfs_wf_dlscan(dse, dn) != 0) { r = 0 - 1; }
        }
        var fr = 0;
        if (r == 0 && first <= maxb) {
            var lo = zfs_wf_freeblks(dse, dn, os, obj, first, maxb);
            if (lo < 0) { r = 0 - 1; }
            elif (lo > maxb) { r = zfs_wno("truncation: not one block's free fits a txg"); }
            else {
                if (lo == 0) { store64(dn + 16, 0); } else { store64(dn + 16, lo - 1); }
                if (lo > first) { more = 1; }
                fr = 1;
            }
        }
        # (B9 review, k.99) the boundary block's rewrite predicted like a write's block (zfs_wdl_path): one that does not
        # fit after this txg freed blocks waits for the next txg — which starts with it (dn_maxblkid is its block now);
        # one that fits no txg is refused by name, before txg 1 (zfs_wf_dlscan's bound covers its path for a later one)
        if (r == 0 && more == 0 && pb >= 0 && pb <= maxb) {
            var pdl = zfs_wdl_path(dse, dn, os, obj, 0, pb);
            if (pdl < 0) { r = 0 - 1; }
            elif (zfs_dx_meta + zfs_wdl_pm + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + pdl > zfs_wf_alim()) {
                if (fr == 1) { more = 1; }
                else { r = zfs_wno("truncation: the boundary block's rewrite does not fit a txg"); }
            } else { r = zfs_wf_pzero(dse, dn, os, obj, pb, pf, bs); }
        }
        # (B9 review, k.99) a truncation that needs a second txg while a later one might not hold its first step
        # (zfs_wf_dlscan) is refused HERE — txg 1 dropped, nothing freed
        if (r == 0 && more == 1 && scan == 1 && zfs_wf_tb == 1) { r = zfs_wno("truncation: a later txg might not hold one block's deadlist appends"); }
    }
    if (r != 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    if (more == 0) {
        if (len < size) {
            store64(bon + zfs_wf_sz, len);
            if (len == 0) { store64(bon + zfs_wf_fl, load64(bon + zfs_wf_fl) & (0 - 1 - ZWF_SPARSE)); }
        }
        zfs_wf_touch(bon);
    }
    if (zfs_commit() != 0) { return 0 - 1; }
    return more;
}
# ⭐ Truncate ref to len bytes (open#7's AO_TRUNC: len 0 — design § a.1; any length, so an ftruncate is glue only):
# txg after txg while the frees do not fit one, fs_lock released between them (zfs_wf_yield, B5 review) and the object
# required to be the same one after each release (D11's zfs_fd_live: its generation and — B7 review — not lazily
# unlinked onto the DELETE_QUEUE by another CPU meanwhile, LINKS 0). Every block the truncation frees or rewrites
# is judged BEFORE the first txg (zfs_wf_okscan, B5 review) — (B9 review, k.99) a snapshot's with its deadlist entry
# resolved and every entry's materialisation judged (zfs_wf_dlscan), and a truncation that needs more than one txg
# refused there unless every later txg can hold its first step — so a refusal by name changes nothing. 0 / -1 named —
# a LATER txg that fails (ENOSPC for its commit's metadata, the object gone, an I/O error) leaves the txgs already
# committed: the file reads zeros past what they freed, SIZE unchanged — OpenZFS's own dmu_free_long_range state
# between its chunks. fs_lock held.
fn zfs_wtrunc(ref, len) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    var di = zfs_ref_di(ref);
    if (di < 0 || di >= zfs_nds) { return zfs_wno("not a dataset object"); }
    if (len < 0) { return zfs_wno("negative length"); }
    var dn = zfs_dnslot(4);
    if (zfs_ref_dn(ref, dn) != 0) { return zfs_wno("object unreadable"); }
    var g = zfs_fd_gen(di, dn);
    if (g < 0) { return zfs_wno("object generation unreadable"); }
    var r = zfs_wf_trunc1(di, ref & ZK_MASK48, len, 1);
    while (r == 1) {
        zfs_wf_yield();
        if (zfs_wp_flush_why("yield") != 0) { return 0 - 1; }   # (B11 review) a pending txg left in the gap commits first
        if (zfs_ref_dn(ref, dn) != 0 || zfs_fd_live(di, dn, g) == 0) { return zfs_wno("the file changed between two txgs of its truncation"); }
        r = zfs_wf_trunc1(di, ref & ZK_MASK48, len, 0);
    }
    return r;
}
# --- B6: CREATE / MKDIR / SYMLINK in microzap parents — (B8) and fat ones (design § a.1, § a.3, § f.1-f.3; WPA § 5, 9, 10)
# open#7's AO_CREAT (zfs_open -> zfs_wcreate), mkdir#9 (zfs_wmkdir) and symlink#63 (zfs_wsymlink): ONE txg each (policy
# A, § f.3) through the B4 dataset phase. What FreeBSD's zfs_create / zfs_mkdir / zfs_symlink do, rule for rule
# (zfs_vnops_os.c; zfs_mknode, zfs_znode_os.c:556-842; zfs_acl_ids_create, zfs_acl.c; zfs_link_create, zfs_dir.c:580-671):
#   · the object (zfs_wc_slot): the FIRST free 512-byte slot of the dataset's meta-dnode — dn_type 0, all zero, not
#     inside a multi-slot dnode — its dnode blocks scanned dirty-first, a block whose fill says full not read, a hole
#     read as free (placement is free: dmu_object_alloc_impl's cursor is in memory, WPA § 5); with none free, the block
#     after dn_maxblkid, which grows (dn_nlevels with it where it must: zfs_wf_levels). ONE slot always (D14).
#   · the dnode (dnode_allocate, dnode.c:722-809): PLAIN_FILE_CONTENTS (19) for a file or a symlink, DIRECTORY_CONTENTS
#     (20) for a directory; indirect shift 17, one level, one blkptr (an SA bonus), 512-byte blocks, checksum and
#     compress INHERIT (0), flags 0 — USED_BYTES comes with a born block (dnode_diduse_space; FreeBSD's empty files and
#     symlinks carry 0xa, k.2), the accounting bits with the commit's user accounting (zfs_wd_uacct: the new dnode's
#     old side is a zero slot, its new side +1 object and 512 + dn_used bytes, design § e.3)
#   · a directory's block 0: a 512-byte microzap — ZBT_MICRO, an odd non-zero salt, normflags 0 (mzap_create_impl)
#   · the SA bonus (sa_replace_all_by_template): zfs_mknode's bulk order MODE SIZE GEN UID GID PARENT FLAGS ATIME MTIME
#     CTIME CRTIME LINKS [PROJID] DACL_COUNT DACL_ACES, a symlink's SYMLINK last (zfs_symlink's sa_update adds it) — the
#     numbers by NAME from the dataset's REGISTRY (zfs_wc_regs: one not registered is refused, a REGISTRY add is not
#     built), the layout the dataset's LAYOUTS already holds for exactly that array — (B8) or a NEW one registered in the
#     same txg (zfs_wc_layout: sa_add_layout_entry's count + 2, a fat-ZAP add). Values: MODE 0100644 / 040755 / 0120755 (no mode argument in the ABI — FreeBSD's
#     defaults under umask 022, the fixtures' own objects), SIZE 0 / 2 / the target's length, GEN = T (D11), UID 0, GID
#     the parent's (zfs_acl_ids_create), PARENT, FLAGS = ARCHIVE | AV_MODIFIED | the ACL hints (TRIVIAL, + AUTO_INHERIT
#     for a directory, + NO_EXECS_DENIED when every class may execute — zfs_mode_compute) | PROJID where project quota
#     is enabled (files and directories) | PROJINHERIT from the parent; the four times {now, 0}; LINKS 1 / 2 / 1 (mknode
#     0 / 1, then zfs_link_create + 1); PROJID the parent's under PROJINHERIT, else 0; the trivial ACL zfs_acl_chmod
#     gives the mode (zfs_wc_aces: owner@ / group@ / everyone@ ALLOW, 3 ACEs, 24 bytes) — bytes equal to the fixtures'
#     own FreeBSD objects of the same kind (design § k.2; scripts/smoke/lib/zfs-sa-check.py holds every new object to
#     such a twin)
#   · the entry (zfs_link_create): name -> obj | DT << 60 in the parent's ZAP (zfs_wz_op, B8: a microzap's 64-byte chunk —
#     the lowest unused cd, + 512 B growth up to 128 KiB — or, past that or for a name of 50+ bytes, the microzap
#     UPGRADED, mzap_upgrade; a fat ZAP's leaf entry, a leaf split as needed); the parent's SIZE + 1, LINKS + 1 for a directory, MTIME = CTIME =
#     now, FLAGS | ARCHIVE | AV_MODIFIED (zfs_tstamp_update_setup, CONTENT_MODIFIED)
# Refused by name (design § a.3): a read-only pool or dataset; an empty name, ".", "..", one with a NUL, one that
# EXISTS (EEXIST — a final symlink is never followed, dangling or not); 256+ bytes (longname); an add to a microzap
# already past 128 KiB (large_microzap — the reader's block cache cannot hold it, so this is judged on the parent's dnode
# BEFORE the name is looked up; B6 review; k.57); a normalised parent ZAP; a parent that is not a directory, is virtual (no dataset holds it), pre-SA, keeps an
# attribute outside its bonus, has inheritable ACEs (ZFS_INHERIT_ACE: inheritance not built), is an xattr directory or
# immutable (EPERM); a group id that is a FUID (the FUID table is not written); a non-ASCII name on a utf8only dataset
# (UTF-8 validation not built); a symlink target of 0 or 145+ bytes (spill creation not built) or holding a NUL byte (a
# C string to FreeBSD's symlink(2): OpenZFS never writes one; B6 review); a dataset whose objset_phys OpenZFS grows in
# memory (dse +104 bit 64: a 2 KiB objset on a project_quota pool — FreeBSD's create would carry PROJID and make the
# projectused ZAP; B6 review); a mode whose trivial ACL needs zfs_acl_chmod's allow0 / deny entries (zfs_wc_trivok —
# unreachable while the ABI has no mode argument); no layout; and the predicates: EDQUOT (the dataset's quotas,
# zfs_wd_space; the owner's user / group / project BYTE and OBJECT quotas, zfs_acl_ids_overquota — zfs_wd_idq3) and
# ENOSPC.
enum ZfsWC {
    ZWC_NA     = 17;                    # the attributes a create may write (zfs_wc_names: zfs_mknode's bulk order) + B7's
    #   ZPL_XATTR, which only a removal reads (zfs_wu_drop)
    ZWC_FILE   = 0x81A4;                # S_IFREG | 0644 \
    ZWC_DIR    = 0x41ED;                # S_IFDIR | 0755  } the modes agnos creates (no mode argument in the ABI)
    ZWC_LNK    = 0xA1ED;                # S_IFLNK | 0755 /
    ZWC_TRIV   = 4;                     # znode flags (zfs_znode.h, zfs_acl.h): ZFS_ACL_TRIVIAL · ZFS_ACL_AUTO_INHERIT ·
    ZWC_AUTOI  = 0x40;                  #   ZFS_NO_EXECS_DENIED · ZFS_INHERIT_ACE · ZFS_XATTR · ZFS_PROJINHERIT · ZFS_PROJID
    ZWC_NOEXD  = 0x100;
    ZWC_INHACE = 2;
    ZWC_XATTR  = 1;
    ZWC_PROJI  = 0x400000000000;
    ZWC_PROJID = 0x800000000000;
    ZWC_SYMMAX = 144;                   # a symlink's SA is 176 B + its target (no PROJID: VLNK); one slot's bonus 320 B
}
var zfs_wc_an[17];           # the dataset's REGISTRY number of each of zfs_wc_names() (-1: not registered)
var zfs_wc_m = 0;            # the new object's MODE · SIZE · GID · PARENT · FLAGS · LINKS · PROJID · time (seconds) ·
var zfs_wc_sz = 0;           #   the symlink target and its length (0: not a symlink) — zfs_wc_sa's values
var zfs_wc_gid = 0;
var zfs_wc_par = 0;
var zfs_wc_fl = 0;
var zfs_wc_ln = 0;
var zfs_wc_pid = 0;
var zfs_wc_now = 0;
var zfs_wc_tg = 0;
var zfs_wc_tl = 0;
var zfs_wc_obj = 0;          # the last object created (the op list prints where it went)

fn zfs_wc_names() { return "ZPL_MODE ZPL_SIZE ZPL_GEN ZPL_UID ZPL_GID ZPL_PARENT ZPL_FLAGS ZPL_ATIME ZPL_MTIME ZPL_CTIME ZPL_CRTIME ZPL_LINKS ZPL_PROJID ZPL_DACL_COUNT ZPL_DACL_ACES ZPL_SYMLINK ZPL_XATTR"; }
# The index of attribute name n (l bytes) in zfs_wc_names(), or -1.
fn zfs_wc_aidx(n, l) {
    var k = 0;
    while (k < ZWC_NA) {
        var p = zfs_wtoki(zfs_wc_names(), k);
        if (p != 0 && zfs_wtk_l == l && memeq(p, n, l) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# zfs_wc_an from dataset slot di's REGISTRY (master node SA_ATTRS -> REGISTRY: name -> number | bswap << 16 | length
# << 24, sa.c's ATTR_NUM / ATTR_LENGTH), each length checked against the ZPL's (8; 16 for the times; 0 = variable for
# DACL_ACES and SYMLINK). Writer slot 2. 0 / -1 named.
fn zfs_wc_regs(di) {
    var k = 0;
    while (k < ZWC_NA) {
        store64(&zfs_wc_an + k * 8, 0 - 1);
        k = k + 1;
    }
    var ds = zfs_ds(di);
    var rd = zfs_wdn(2);
    var sa = 0;
    var reg = 0;
    if (zfs_dnode(ds, 1, rd) != 0 || zfs_wzu64(rd, "SA_ATTRS", &sa) != 1) { return zfs_wno("SA registry unreadable"); }
    if (zfs_dnode(ds, sa, rd) != 0 || zfs_wzu64(rd, "REGISTRY", &reg) != 1 || zfs_dnode(ds, reg, rd) != 0) { return zfs_wno("SA registry unreadable"); }
    var cur = 0;
    var r = zfs_zap_next(rd, &cur);
    while (r == 1) {
        var i = zfs_wc_aidx(zfs_mem + ZR_NAME, zfs_it_nlen);
        if (i >= 0) {
            var want = 8;
            if (i >= 7 && i <= 10) { want = 16; }
            elif (i == 14 || i == 15) { want = 0; }
            if (((zfs_it_val >> 24) & 0xFFFF) != want) { return zfs_wnos("SA registry: an unexpected length for ", zfs_mem + ZR_NAME, zfs_it_nlen); }
            store64(&zfs_wc_an + i * 8, zfs_it_val & 0xFFFF);
        }
        r = zfs_zap_next(rd, &cur);
    }
    if (r < 0) { return zfs_wno("SA registry unreadable"); }
    return 0;
}
# The LAYOUTS entry of dataset slot di whose attribute array is exactly the n u16 numbers at want (sa_find_layout:
# reuse an identical one, sa.c:463-490) — its number. (B8) None: a NEW layout, registered in the open txg as
# sa_add_layout_entry does (sa.c:406-447) — number avl_numnodes = the LAYOUTS ZAP's count + the two built-in ZPL layouts
# (0 and 1, sa_setup — never in the ZAP), zap_update of its decimal string -> the n attribute numbers as u16 integers
# (a value that is not one u64: a fat-ZAP entry — a microzap is upgraded first). The op list notes it (zfs_wc_lnote).
# Writer slot 3. -1 named (a normalised LAYOUTS ZAP, the 10-bit number space, a number already taken).
fn zfs_wc_layout(di, want, n) {
    var ds = zfs_ds(di);
    var ld = zfs_wdn(3);
    if (zfs_dnode(ds, load64(ds + 528), ld) != 0) { return zfs_wno("SA layouts unreadable"); }
    var nm[24];
    var arr[128];
    var cur = 0;
    var r = zfs_zap_next(ld, &cur);
    while (r == 1) {
        var nl = zfs_it_nlen;
        if (nl >= 1 && nl <= 20) {
            memcpy(&nm, zfs_mem + ZR_NAME, nl);
            if (zfs_zap_lookup(ld, &nm, nl, 2, 64, &arr) == n) {
                var i = 0;
                while (i < n && load16(&arr + i * 2) == load16(want + i * 2)) { i = i + 1; }
                var v = 0;
                var j = 0;
                while (j < nl && load8(&nm + j) >= 48 && load8(&nm + j) <= 57) {
                    v = v * 10 + load8(&nm + j) - 48;
                    j = j + 1;
                }
                if (i == n && j == nl && v >= 2 && v < 1024) { return v; }
            }
        }
        r = zfs_zap_next(ld, &cur);
    }
    if (r < 0) { return zfs_wno("SA layouts unreadable"); }
    var os = load64(ds + 840);
    var lobj = load64(ds + 528);
    var ldn = zfs_wos_dn(os, lobj);
    if (ldn == 0) { return 0 - 1; }
    zfs_wz_open(os, lobj, ldn);
    var zk = zfs_wz_kind();
    if (zk < 0) { return 0 - 1; }
    var b = zfs_zf_rblk(0);
    if (b == 0) { return 0 - 1; }
    var cnt = 0;
    var nf = 0;
    if (zk == 1) {
        cnt = load64(b + 72);
        nf = load64(b + 88);
    } else {
        nf = load64(b + 16);
        var k = 64;
        while (k < (load16(ldn + 8) << 9)) {
            if (load8(b + k + 14) != 0) { cnt = cnt + 1; }
            k = k + 64;
        }
    }
    if (nf != 0) { return zfs_wno("a normalised SA LAYOUTS ZAP"); }
    var num = cnt + 2;
    if (num >= 1024) { return zfs_wnon("SA layout numbers exhausted (10 bits): ", num); }
    var kl = fmt_int_buf(num, &nm);
    var ev[8];
    var g = zfs_wz_get(&nm, kl, &ev);
    if (g < 0) { return 0 - 1; }
    if (g == 1) { return zfs_wnon("the next SA layout number is taken (LAYOUTS not dense): ", num); }
    if (zfs_wz_op(1, &nm, kl, 2, n, want) != 0) { return 0 - 1; }
    zfs_wc_lnote(num);
    return num;
}
# The offset in the bonus of SA dnode dn (dataset slot di) of attribute zfs_wc_names()[k], which must be want bytes
# there — or -1 (not registered, not in this layout, in a spill block, another size).
fn zfs_wc_pat(di, dn, k, want) {
    var num = load64(&zfs_wc_an + k * 8);
    var v[16];
    if (num < 0) { return 0 - 1; }
    if (zfs_sa_find(di, zfs_ds(di), zfs_bonus(dn), load16(dn + 10), num, &v, 16) != want) { return 0 - 1; }
    return zfs_sa_at;
}
# The first free object of the dataset of entry dse (the section header): its number, its dnode block dirtied
# (zfs_wos_dn) and the 512 bytes verified zero; -1 named.
fn zfs_wc_slot(dse) {
    var os = load64(dse);
    var oe = zfs_wos_os(os);
    if (oe < 0) { return 0 - 1; }
    var mdn = zfs_dirty_buf(oe);
    var per = load16(mdn + 8);
    var mb = load64(mdn + 16);
    if (per < 1 || per > 256) { return zfs_wnon("meta-dnode blocks of dnodes: ", per); }
    var bp[128];
    var obj = 0 - 1;
    var b = 0;
    while (b <= mb + 1 && obj < 0) {
        var p = zfs_mem + ZR_ZERO;
        if (b <= mb) {
            var e = zfs_dirty_find(os, 0, 0, b);
            if (e >= 0) { p = zfs_dirty_buf(e); }
            else {
                var h = zfs_wf_bp(mdn, os, 0, b, &bp);
                if (h < 0) { return 0 - 1; }
                if (h == 1) {
                    p = 0;
                    if (load64(&bp + 88) < per) {
                        p = zfs_mc_get(&bp);
                        if (p == 0) { return zfs_wno("meta-dnode block unreadable"); }
                    }
                }
            }
        }
        if (p != 0) {
            var s = 0;
            while (s < per && obj < 0) {
                if (load8(p + s * 512) != 0) { s = s + 1 + load8(p + s * 512 + 12); }
                else {
                    if ((b > 0 || s > 0) && zfs_wzero(p + s * 512, 512) == 1) { obj = b * per + s; }
                    s = s + 1;
                }
            }
        }
        b = b + 1;
    }
    if (obj < 1 || obj > ZK_MASK48) { return zfs_wno("no free object number"); }
    var bid = obj / per;
    if (bid > mb) {
        if (zfs_wf_levels(mdn, os, 0, bid) != 0) { return 0 - 1; }
        store64(mdn + 16, bid);
    }
    var dn = zfs_wos_dn(os, obj);
    if (dn == 0) { return 0 - 1; }
    if (zfs_wzero(dn, 512) != 1) { return zfs_wnon("object slot not free: ", obj); }
    return obj;
}
# The ALLOW mask acl_trivial_access_masks gives a class with bits rwx (acl_common.c:1543-1600, zfs_acl_chmod's source):
# every class READ_ACL | READ_ATTRIBUTES | READ_NAMED_ATTRS | SYNCHRONIZE (0x120088); the owner also WRITE_ATTRIBUTES |
# WRITE_OWNER | WRITE_ACL | WRITE_NAMED_ATTRS (0xC0110: base 0x1E0198, whatever its bits); + READ_DATA (r), WRITE_DATA |
# APPEND_DATA (w, 0x6 for every class), EXECUTE (x) — 0x1e019f / 0x120089 for 0644, 0x1e01bf / 0x1200a9 for 0755, the
# fixtures' own FreeBSD objects (design § k.2). (B6 review: this was WRITE_NAMED_ATTRS with w only, and for every class:
# right for 0644 / 0755 alone.)
fn zfs_wc_mask(rwx, own) {
    var m = 0x120088;
    if (own == 1) { m = m | 0xC0110; }
    if ((rwx & 4) != 0) { m = m | 1; }
    if ((rwx & 2) != 0) { m = m | 6; }
    if ((rwx & 1) != 0) { m = m | 0x20; }
    return m;
}
# Is perm's trivial ACL the three ALLOW entries alone? zfs_acl_chmod puts allow0 (owner@ ALLOW), deny1 (owner@ DENY) and
# deny2 (group@ DENY) first whenever a class holds a bit the class before it lacks — other's over group's, or either's
# over the owner's (acl_trivial_access_masks) — which zfs_wc_aces does not build: every bit of group within owner's,
# every bit of other within group's. 0644 / 0755 qualify; a mode argument or chmod (k.55) would not always. 0 / -1 named.
fn zfs_wc_trivok(perm) {
    var u = (perm >> 6) & 7;
    var g = (perm >> 3) & 7;
    var o = perm & 7;
    if ((g & (7 - u)) != 0 || (o & (7 - g)) != 0) { return zfs_wnon("a mode whose ACL needs DENY entries (zfs_acl_chmod's full form not built): ", u * 100 + g * 10 + o); }
    return 0;
}
# The trivial ACL of permission bits perm at p (24 bytes; zfs_wc_trivok passed): three zfs_ace_hdr_t {u16 type, u16
# flags, u32 mask}, type ALLOW (0) — owner@ (ACE_OWNER 0x1000), group@ (ACE_GROUP | ACE_IDENTIFIER_GROUP 0x2040),
# everyone@ (ACE_EVERYONE 0x4000). 0.
fn zfs_wc_aces(p, perm) {
    memset(p, 0, 24);
    store16(p + 2, 0x1000);
    store32(p + 4, zfs_wc_mask((perm >> 6) & 7, 1));
    store16(p + 10, 0x2040);
    store32(p + 12, zfs_wc_mask((perm >> 3) & 7, 0));
    store16(p + 18, 0x4000);
    store32(p + 20, zfs_wc_mask(perm & 7, 0));
    return 0;
}
fn zfs_wc_val(k) {
    if (k == 0) { return zfs_wc_m; }
    if (k == 1) { return zfs_wc_sz; }
    if (k == 2) { return zfs_txg + 1; }
    if (k == 4) { return zfs_wc_gid; }
    if (k == 5) { return zfs_wc_par; }
    if (k == 6) { return zfs_wc_fl; }
    if (k == 11) { return zfs_wc_ln; }
    if (k == 12) { return zfs_wc_pid; }
    if (k == 13) { return 3; }
    return 0;                                    # UID: agnos has no other user (crgetuid)
}
# The SA bonus of a new object at b (zeroed) in layout lay over the n attribute indices at kix (u64 each): the header —
# SA_MAGIC, layout | (header bytes / 8) << 10, the variable lengths in layout order (DACL_ACES 24, then SYMLINK's) —
# then each attribute 8-aligned (sa_build_layouts). Returns the bonus length: the last attribute's end, unrounded
# (FreeBSD's symlink "hello.txt" is 176 + 9 = 185 bytes).
fn zfs_wc_sa(b, lay, kix, n) {
    var hs = 8;
    if (zfs_wc_tl > 0) { hs = 16; }
    store32(b, ZK_SAMAGIC);
    store16(b + 4, lay | ((hs >> 3) << 10));
    store16(b + 6, 24);
    if (zfs_wc_tl > 0) { store16(b + 8, zfs_wc_tl); }
    var off = hs;
    var end = hs;
    var i = 0;
    while (i < n) {
        var k = load64(kix + i * 8);
        var sz = 8;
        if (k >= 7 && k <= 10) {
            sz = 16;
            store64(b + off, zfs_wc_now);
        } elif (k == 14) {
            sz = 24;
            zfs_wc_aces(b + off, zfs_wc_m & 0x1FF);
        } elif (k == 15) {
            sz = zfs_wc_tl;
            memcpy(b + off, zfs_wc_tg, sz);
        } else { store64(b + off, zfs_wc_val(k)); }
        end = off + sz;
        off = (end + 7) & (0 - 8);
        i = i + 1;
    }
    return end;
}
# A new directory's microzap salt: zfs_wc_salt (B8 review: the op list's derived one and production's unpredictable one,
# each in its own build — after zfs_wf_now below).
# The bytes of a NEW name nm (nl bytes) in dataset slot di — a create's (zfs_wc1) and a link's or rename's (zfs_wu_make,
# B7 review: B7 checked neither): no NUL — the chunk keeps a C string, so OpenZFS's mzap_open hashes "e04\0x" as "e04"
# beside a real e04 (two equal hash | cd keys: zfs_btree_add's VERIFY) and a name starting with NUL reads as a FREE chunk
# (the object orphaned, the parent's SIZE counting a ghost); and (B11) on a utf8only dataset a name u8_validate accepts
# — FreeBSD answers EILSEQ for any other in zfs_lookup / zfs_create / zfs_rename / zfs_link (u8_validate), so such a name
# could never be looked up or removed there (zfs_wenc.cyr zfs_u8_valid: well-formed UTF-8, no overlong form, no
# surrogate, nothing past U+10FFFF); on a NORMALISED dataset (formC / formD / ... — read-only at its gate anyway, § a.2)
# any non-ASCII byte is still refused: the name's normal form needs the Unicode tables (design § a.3, k.55). 0 / -1 named.
fn zfs_wname(di, nm, nl) {
    var mn = zfs_wdn(2);
    var u8 = 0;
    var nf = 0;
    if (zfs_dnode(zfs_ds(di), 1, mn) != 0 || zfs_wzu64(mn, "utf8only", &u8) < 0 || zfs_wzu64(mn, "normalization", &nf) < 0) { return zfs_wno("master node unreadable"); }
    var hi = 0;
    var i = 0;
    while (i < nl) {
        if (load8(nm + i) == 0) { return zfs_wno("name holds a NUL byte"); }
        if (load8(nm + i) >= 128) { hi = 1; }
        i = i + 1;
    }
    if (hi == 1 && nf != 0) { return zfs_wno("non-ASCII name on a normalised dataset (the Unicode normalization tables are not built)"); }
    if (hi == 1 && u8 != 0) {
        var e = zfs_u8_valid(nm, nl);
        if (e != 0) { return zfs_wnon("name is not valid UTF-8 on a utf8only dataset (EILSEQ): u8_validate class ", e); }
    }
    return 0;
}
# The create of kind (0 a file · 1 a directory · 2 a symlink, its target in zfs_wc_tg / zfs_wc_tl) named nm (nl bytes) in
# directory object pobj of dataset slot di, DIRTIED in the open txg (the section header) — the caller commits, or drops
# the txg on -1 (named).
fn zfs_wc1(di, pobj, nm, nl, kind) {
    zfs_wc_lnote(0);
    if (zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    if (zfs_wp_own() != 0) { return 0 - 1; }         # (B11 review) a pending txg commits first, never dropped with a refusal
    if (zfs_dx_n != 0 || zfs_xl_n != 0) { return zfs_wno("dirty set not empty (one op per txg: policy A)"); }
    if (zfs_w_alloc > zfs_wphys()) { return zfs_wno("no space: the metaslabs with a space map are full"); }
    var dse = zfs_wds_open(di);
    if (dse == 0) { return 0 - 1; }
    var os = load64(dse);
    var fl = load64(dse + 104);
    # B6 review: OpenZFS grows such an objset_phys at open (dmu_objset_open_impl), so dmu_objset_projectquota_enabled
    # holds and zfs_mknode gives a file / directory PROJID + ZFS_PROJID — and its sync makes the projectused ZAP
    if ((fl & 64) != 0) { return zfs_wno("create on a dataset whose objset_phys OpenZFS grows in memory (2 KiB on a project_quota pool: PROJID and the projectused ZAP not modelled)"); }
    if (zfs_wc_regs(di) != 0 || zfs_wname(di, nm, nl) != 0) { return 0 - 1; }
    # --- the parent: a microzap ZPL directory whose attributes are all in its bonus ---
    var pdn = zfs_wos_dn(os, pobj);
    if (pdn == 0) { return 0 - 1; }
    if (load8(pdn) != 20) { return zfs_wnon("parent is not a ZPL directory: type ", load8(pdn)); }
    if (load8(pdn + 4) != 44) { return zfs_wno("pre-SA parent (ZPL < 5)"); }
    var o_md = zfs_wc_pat(di, pdn, 0, 8);
    var o_sz = zfs_wc_pat(di, pdn, 1, 8);
    var o_gid = zfs_wc_pat(di, pdn, 4, 8);
    var o_fl = zfs_wc_pat(di, pdn, 6, 8);
    var o_mt = zfs_wc_pat(di, pdn, 8, 16);
    var o_ct = zfs_wc_pat(di, pdn, 9, 16);
    var o_ln = zfs_wc_pat(di, pdn, 11, 8);
    if (o_md < 0 || o_sz < 0 || o_gid < 0 || o_fl < 0 || o_mt < 0 || o_ct < 0 || o_ln < 0) { return zfs_wno("a parent attribute is not in its bonus (spill update not built)"); }
    var pb = zfs_bonus(pdn);
    var pf = load64(pb + o_fl);
    if ((pf & ZWC_INHACE) != 0) { return zfs_wno("parent has inheritable ACEs (ACL inheritance not built)"); }
    if ((pf & ZWC_XATTR) != 0) { return zfs_wno("parent is an extended-attribute directory"); }
    if ((pf & ZWF_IMMUT) != 0) { return zfs_wno("immutable parent (EPERM)"); }
    var gid = load64(pb + o_gid);
    if ((gid >> 31) != 0) { return zfs_wnon("parent's group is a FUID (the FUID table is not written): ", gid); }
    var pid = 0;
    if (kind != 2 && (pf & ZWC_PROJI) != 0) {
        var o_pid = zfs_wc_pat(di, pdn, 12, 8);
        if ((pf & ZWC_PROJID) != 0) {
            if (o_pid < 0) { return zfs_wno("a parent attribute is not in its bonus (spill update not built)"); }
            pid = load64(pb + o_pid);
        }
    }
    # (B8) the parent's ZAP of any shape — a microzap, or a fat ZAP (zfs_wz_*): only a normalised one is refused
    zfs_wz_open(os, pobj, pdn);
    var nf = zfs_wz_norm();
    if (nf < 0) { return 0 - 1; }
    if (nf != 0) { return zfs_wno("normalized parent directory ZAP"); }
    var ev[8];
    var g = zfs_wz_get(nm, nl, &ev);
    if (g < 0) { return 0 - 1; }
    if (g == 1) { return zfs_wno("name exists (EEXIST)"); }
    # --- the predicates (zfs_create: dmu_tx_assign's EDQUOT / ENOSPC, zfs_acl_ids_overquota) and what the commit's
    # accounting will add: the new dnode's ids may be new keys (2 per accounting microzap: bytes and obj-), the parent's
    # where T - 1's dnode lacks the accounting flags (zfs_wd_dirty1's rule); 6 delta entries for each ---
    if (zfs_wd_space(dse, 512, 0, 0) != 0) { return 0 - 1; }
    var ids[24];
    store64(&ids, 0);
    store64(&ids + 8, gid);
    store64(&ids + 16, pid);
    if (zfs_wd_idq3(dse, &ids, 0) != 0 || zfs_wd_idq3(dse, &ids, 1) != 0) { return 0 - 1; }
    if (zfs_wz_urs(dse, &ids, 2) != 0 || zfs_wd_urs1(dse, pdn) != 0) { return 0 - 1; }
    # --- the attribute list and its layout ---
    var kix[128];
    var want[32];
    var n = 0;
    var k = 0;
    while (k < 16) {
        var inc = 1;
        if (k == 12 && (kind == 2 || ((fl >> 2) & 1) == 0)) { inc = 0; }
        if (k == 15 && kind != 2) { inc = 0; }
        if (inc == 1) {
            var num = load64(&zfs_wc_an + k * 8);
            if (num < 0) {
                var an = zfs_wtoki(zfs_wc_names(), k);
                return zfs_wnos("SA attribute not registered (REGISTRY add not built): ", an, zfs_wtk_l);
            }
            store64(&kix + n * 8, k);
            store16(&want + n * 2, num);
            n = n + 1;
        }
        k = k + 1;
    }
    var lay = zfs_wc_layout(di, &want, n);
    if (lay < 0) { return 0 - 1; }
    # --- the values ---
    zfs_wc_m = ZWC_FILE;
    zfs_wc_sz = 0;
    zfs_wc_ln = 1;
    var dt = 8;
    if (kind == 1) {
        zfs_wc_m = ZWC_DIR | (load64(pb + o_md) & 0x400);       # S_ISGID from the parent (zfs_acl_ids_create)
        zfs_wc_sz = 2;
        zfs_wc_ln = 2;
        dt = 4;
    } elif (kind == 2) {
        zfs_wc_m = ZWC_LNK;
        zfs_wc_sz = zfs_wc_tl;
        dt = 10;
    }
    if (zfs_wc_trivok(zfs_wc_m & 0x1FF) != 0) { return 0 - 1; }
    zfs_wc_gid = gid;
    zfs_wc_par = pobj;
    zfs_wc_pid = pid;
    zfs_wc_now = zfs_wf_now();
    zfs_wc_fl = ZWF_ARCHIVE | ZWF_AVMOD | ZWC_TRIV;
    if (kind == 1) { zfs_wc_fl = zfs_wc_fl | ZWC_AUTOI; }
    if ((zfs_wc_m & 0x49) == 0x49) { zfs_wc_fl = zfs_wc_fl | ZWC_NOEXD; }
    if (kind != 2) {
        if (((fl >> 2) & 1) == 1) { zfs_wc_fl = zfs_wc_fl | ZWC_PROJID; }
        if ((pf & ZWC_PROJI) != 0) { zfs_wc_fl = zfs_wc_fl | ZWC_PROJI; }
    }
    # --- the object ---
    var obj = zfs_wc_slot(dse);
    if (obj < 0) { return 0 - 1; }
    var dn = zfs_wos_dn(os, obj);
    if (dn == 0) { return 0 - 1; }
    store8(dn, 19);
    if (kind == 1) { store8(dn, 20); }
    store8(dn + 1, 17);
    store8(dn + 2, 1);
    store8(dn + 3, 1);
    store8(dn + 4, 44);
    store16(dn + 8, 1);
    store16(dn + 10, zfs_wc_sa(zfs_bonus(dn), lay, &kix, n));
    if (kind == 1) {
        var de = zfs_dirty_add(os, obj, 0, 0, 512, 20 << 8, 0);
        if (de < 0) { return 0 - 1; }
        store64(zfs_dirty_buf(de), (1 << 63) | 3);
        store64(zfs_dirty_buf(de) + 8, zfs_wc_salt(os, obj));
    }
    # --- the entry and the parent ---
    var dv[8];
    store64(&dv, (dt << 60) | obj);
    zfs_wz_open(os, pobj, pdn);
    if (zfs_wz_op(0, nm, nl, 8, 1, &dv) != 0) { return 0 - 1; }
    store64(pb + o_sz, load64(pb + o_sz) + 1);
    if (kind == 1) { store64(pb + o_ln, load64(pb + o_ln) + 1); }
    store64(pb + o_mt, zfs_wc_now);
    store64(pb + o_mt + 8, 0);
    store64(pb + o_ct, zfs_wc_now);
    store64(pb + o_ct + 8, 0);
    store64(pb + o_fl, pf | ZWF_ARCHIVE | ZWF_AVMOD);
    if (zfs_wf_mfit(0) == 0) { return zfs_wnon("a create does not fit a txg: dirty metadata bytes ", zfs_dx_meta); }
    zfs_wc_obj = obj;
    return 0;
}
# ⭐ CREATE / MKDIR / SYMLINK at path (ZFS-relative, len bytes — the syscall arm's zfs_reloff; trailing '/' ignored):
# kind 0 a file · 1 a directory · 2 a symlink to the tl bytes at tgt (copied first: it may be user memory) — ONE txg.
# The final component is never followed: a name that resolves at all (a dangling symlink, a graft) EXISTS — and nothing
# is created unless this no-follow lookup says ABSENT (zfs_open sends every failed AO_CREAT lookup here for its name).
# 0 / -1 named (nothing written, or a commit that failed: the pool then read-only, zfs_wfail). Caller holds
# fs_spin_lock.
fn zfs_wcreate(path, len, kind, tgt, tl) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    if (zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    path = zfs_upath(0, path, len);                  # read once (B7 review): every check and lookup below on the copy
    if (path == 0) { return zfs_wnon("path unresolvable: ", 36); }
    while (len > 0 && load8(path + len - 1) == 47) { len = len - 1; }
    var i = len;
    while (i > 0 && load8(path + i - 1) != 47) { i = i - 1; }
    var nl = len - i;
    if (nl < 1) { return zfs_wno("no name to create (the namespace root)"); }
    if ((nl == 1 && load8(path + i) == 46) || (nl == 2 && load8(path + i) == 46 && load8(path + i + 1) == 46)) { return zfs_wno("name exists (EEXIST)"); }
    if (nl > 255) { return zfs_wnon("name of 256+ bytes (longname, ENAMETOOLONG): ", nl); }
    if (kind == 2 && (tl < 1 || tl > ZWC_SYMMAX)) { return zfs_wnon("symlink target empty or over 144 bytes (spill creation not built): ", tl); }
    var nm[256];
    memcpy(&nm, path + i, nl);
    var tb[160];
    zfs_wc_tl = 0;
    if (kind == 2) {
        memcpy(&tb, tgt, tl);
        var j = 0;
        while (j < tl) {
            if (load8(&tb + j) == 0) { return zfs_wno("symlink target holds a NUL byte"); }
            j = j + 1;
        }
        zfs_wc_tl = tl;
    }
    zfs_wc_tg = &tb;
    # the parent FIRST (B6 review): a microzap past 128 KiB (large_microzap) is refused by its own § a.3 name before the
    # lookup of the name in it, which the reader's block cache (ZK_METAMAX) cannot serve — it read "path unresolvable"
    var pr = zfs_resolve(path, i, 1);
    var pt = zfs_res_type;
    if (pr >= 0 && pt == 2) {
        var pd = zfs_wdn(2);
        if (zfs_ref_dn(pr, pd) == 0 && load8(pd) == 20 && (load16(pd + 8) << 9) > ZK_METAMAX) { return zfs_wnon("add to a microzap over 128 KiB (large_microzap: not built), its block bytes ", load16(pd + 8) << 9); }
    }
    var ex = zfs_resolve(path, len, 0);
    if (ex >= 0) { return zfs_wno("name exists (EEXIST)"); }
    if (ex != (0 - 2)) { return zfs_wnon("path unresolvable: ", 0 - ex); }
    if (pr < 0) { return zfs_wno("parent directory not found"); }
    if (pt != 2) { return zfs_wno("parent is not a directory"); }
    var di = zfs_ref_di(pr);
    if (di < 0 || di >= zfs_nds) { return zfs_wno("parent is a virtual directory (no dataset holds it)"); }
    if (zfs_wc1(di, pr & ZK_MASK48, &nm, nl, kind) != 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    if (zfs_commit() != 0) { return 0 - 1; }
    return 0;
}
# mkdir#9 on the ZFS mount (the arm holds fs_lock): 0 / -1.
fn zfs_wmkdir(path, len) {
    if (zfs_active == 0) { return 0 - 1; }
    if (zfs_wcreate(path, len, 1, 0, 0) != 0) { return 0 - 1; }
    return 0;
}
# symlink#63 on the ZFS mount: the link at path whose text is the tl bytes at tgt (the arm validated the user range).
fn zfs_wsymlink(tgt, tl, path, len) {
    if (zfs_active == 0) { return 0 - 1; }
    if (zfs_wcreate(path, len, 2, tgt, tl) != 0) { return 0 - 1; }
    return 0;
}
# --- B7: UNLINK / RMDIR / RENAME / LINK in microzap parents — (B8) and fat ones (design § a.1, § a.3, § e.2, § f.2-f.5)
# unlink#30 (zfs_wunlink), rmdir#10 (zfs_wrmdir), rename#31 (zfs_wrename), link#32 (zfs_wlink): ONE txg each (policy A)
# through the B4 dataset phase. What FreeBSD's zfs_remove_ / zfs_rmdir_ / zfs_do_rename_impl / zfs_link do
# (zfs_vnops_os.c), with zfs_link_destroy / zfs_link_create (zfs_dir.c:580-809), rule for rule:
#   · link_destroy (zfs_wu_drop): the name out of the parent's ZAP (a microzap: mzap_remove, its 64-byte chunk zeroed —
#     a microzap never shrinks; (B8) a fat one: fzap_remove, zfs_wz_op); the parent's SIZE - 1, LINKS - 1 for a
#     directory, MTIME = CTIME = now, FLAGS | ARCHIVE | AV_MODIFIED (CONTENT_MODIFIED); unless renaming the object loses
#     a link — while others remain LINKS - 1, CTIME = now, FLAGS | ARCHIVE (STATE_CHANGED,
#     zfs_tstamp_update_setup_ext); at its last one (a directory: SIZE == 2,
#     zfs_dirempty) it is FREED in the same txg (zfs_wu_free: dmu_object_free — every BP of its tree, every level, and its
#     spill killed through zfs_wd_kill, so a gang / dedup / clone block goes to free_bpobj, design § e.2; its 1 +
#     dn_extra_slots slots zeroed, dnode_sync_free) — or, when that does not fit one txg (the kill list, the extent list)
#     or it holds an extended-attribute DIRECTORY (ZPL_XATTR: zfs_rmnode purges it), the LAZY way (zfs_wu_lazy, design
#     § f.5): LINKS 0 and "%llx"(obj) -> obj in the dataset's DELETE_QUEUE, which OpenZFS's next read-write mount drains
#     (zfs_unlinked_drain -> zfs_rmnode; zdb says "on delete queue"). FreeBSD's own unlink ALWAYS takes that route
#     (zfs_remove_ -> zfs_unlinked_add, the free at the vnode's last release); the same-txg free is the equally valid
#     one (WPA § 10)
#   · link_create (zfs_wu_make): name -> obj | DT << 60 into the parent's ZAP (zfs_wz_op — micro or fat, B8); unless
#     renaming the object's LINKS + 1; its PARENT := the directory — on EVERY link and rename: what a later unlink of that
#     name leaves stale is OpenZFS's own state (design § k.15) — CTIME = now, FLAGS | ARCHIVE; the directory's SIZE + 1,
#     LINKS + 1 for a directory, MTIME = CTIME = now, FLAGS | ARCHIVE | AV_MODIFIED
#   · rename: the target, if any, link_destroy'd first (the same kind; a directory only when empty), then link_create
#     (renaming) and FLAGS | AV_MODIFIED on the object, then link_destroy of the source name (renaming); a directory's
#     PARENT moves with it and it may not move under itself (zfs_rename_check: EINVAL); two names of ONE object: nothing
#     to do (POSIX). link: never a directory (EPERM).
# Refused by name (design § a.3): a read-only pool or dataset; a name absent (ENOENT) or present (EEXIST, link's); ".",
# "..", the namespace root; a name of 256+ bytes; a parent that is virtual (no dataset holds it), a microzap past 128 KiB
# (large_microzap, judged on its dnode before the
# lookup — k.57), normalised, pre-SA, an xattr directory, immutable or append-only; a mount point (a graft) as source or
# target, or a directory with a dataset mounted below it (EBUSY); another dataset (EXDEV: one ZAP cannot name another
# objset's object); an object that is immutable, no-unlink or append-only (EPERM — link: append-only, immutable or
# read-only), pre-SA, or keeps an attribute this verb writes outside its bonus (spill update not built); unlink of a
# directory (EPERM: rmdir#10), rmdir of a non-directory (ENOTDIR) or of a non-empty one (ENOTEMPTY: SIZE != 2), a
# directory whose LINKS is not 2; rename across kinds (ENOTDIR / EISDIR), over a non-empty directory, of a directory
# under itself (EINVAL), into a PROJINHERIT directory of another project (EXDEV — link too); a normalised parent ZAP or
# DELETE_QUEUE; ENOSPC (the commit's metadata, zfs_wphys) and — link and
# rename add an entry — the dataset's quotas (zfs_wd_space).
enum ZfsWU {
    ZWU_FREED  = 0x4000000000000000;    # kill-list +8: the object is FREED in this txg (no dnode — no dn_used to move)
    ZWU_NOUNL  = 0x2000000000;          # znode flags: ZFS_NOUNLINK (ZFS_IMMUTABLE / _APPENDONLY / _READONLY: ZWF_*)
    ZWU_DEPTH  = 4096;                  # rename's PARENT walk (zfs_rename_check): deeper is refused by name
}
# Two operands — 0 the source / the name, 1 the target — 16 u64 each (zfs_wu): 0 dataset slot · 1 the parent
# directory's object · 2 the object (0: the name is absent) · 3 its dirent (obj | DT << 60) · 4 1 = a directory ·
# 5 the name's length (the name at zfs_wu_n) · 6 1 = a dataset is mounted below it · 7 the parent's dirty dnode · 8
# unused (B7's microzap entry: B8 reaches the ZAP through zfs_wz_*) · 9 the object's dirty dnode · 10 the parent's ref
var zfs_wu_s[32];
var zfs_wu_nm[64];           # 2 x 256 B: the names (B8: up to 255 bytes — a fat-ZAP entry from 50)
var zfs_wu_ao[24];           # attribute offsets in the bonus, 4 dnodes x 6 (SIZE FLAGS MTIME CTIME LINKS PARENT; -1
#   absent): 2k = operand k's parent, 2k + 1 its object
var zfs_wu_now = 0;          # the op's time (seconds)
var zfs_wu_lz = 0;           # the objects the last op put on the DELETE_QUEUE (the lazy path) · freed
var zfs_wu_fr = 0;
var zfs_wu_n0 = 0;           # zfs_wu_free: the kill list's length when it began · the entries / DVAs it had collected
var zfs_wu_kn = 0;           #   when the txg could hold no more (the lazy decision's figures, the op list's probe)
var zfs_wu_kx = 0;
var zfs_wu_tight = 0;        # the op list's knob (ZFS_WRITE_OPS only — zfs_wc_tight's pattern): > 0 = an object's free
#   is "too big" at its zfs_wu_tight-th kill entry, so a small object takes the lazy path ON DISK (B7 review: 1 sends
#   even an empty directory, one microzap block, there); 0 in production
fn zfs_wu(k, f) { return load64(&zfs_wu_s + (k * 16 + f) * 8); }
fn zfs_wu_set(k, f, v) { store64(&zfs_wu_s + (k * 16 + f) * 8, v); return 0; }
fn zfs_wu_n(k) { return &zfs_wu_nm + k * 256; }
fn zfs_wu_a(g, i) { return load64(&zfs_wu_ao + (g * 6 + i) * 8); }
# Is a dataset grafted strictly below the canonical path c (cl bytes)? 1 / 0.
fn zfs_wu_under(c, cl) {
    var i = 0;
    while (i < zfs_ngr) {
        var e = zfs_gr(i);
        if (load64(e + 24) > cl && load8(e + 40 + cl) == 47 && memeq(e + 40, c, cl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}
# Operand k from path (len bytes, ZFS-relative; trailing '/' allowed on a directory) — copied ONCE first (zfs_upath, B7
# review: the name's checks, its lookups and the copy kept at zfs_wu_n all read one buffer) —: its parent directory
# (followed, as every path prefix is), then the name looked up WITHOUT following it. 0 (the name may be absent:
# zfs_wu(k, 2) 0) / -1 named.
fn zfs_wu_arg(k, path, len) {
    path = zfs_upath(k, path, len);
    if (path == 0) { return zfs_wnon("path unresolvable: ", 36); }
    var tr = 0;
    while (len > 0 && load8(path + len - 1) == 47) {
        len = len - 1;
        tr = 1;
    }
    var i = len;
    while (i > 0 && load8(path + i - 1) != 47) { i = i - 1; }
    var nl = len - i;
    if (nl < 1) { return zfs_wno("the namespace root (EBUSY)"); }
    if ((nl == 1 && load8(path + i) == 46) || (nl == 2 && load8(path + i) == 46 && load8(path + i + 1) == 46)) { return zfs_wno("a name of . or .. (EINVAL)"); }
    if (nl > 255) { return zfs_wnon("name of 256+ bytes (longname, ENAMETOOLONG): ", nl); }
    var pr = zfs_resolve(path, i, 1);
    if (pr < 0) { return zfs_wno("parent directory not found"); }
    if (zfs_res_type != 2) { return zfs_wno("parent is not a directory"); }
    var di = zfs_ref_di(pr);
    if (di < 0 || di >= zfs_nds) { return zfs_wno("parent is a virtual directory (no dataset holds it)"); }
    var pd = zfs_wdn(2);
    if (zfs_ref_dn(pr, pd) != 0) { return zfs_wno("parent unreadable"); }
    if (load8(pd) == 20 && (load16(pd + 8) << 9) > ZK_METAMAX) { return zfs_wnon("a microzap over 128 KiB (large_microzap: not built), its block bytes ", load16(pd + 8) << 9); }
    memset(&zfs_wu_s + k * 128, 0, 128);
    zfs_wu_set(k, 0, di);
    zfs_wu_set(k, 1, pr & ZK_MASK48);
    zfs_wu_set(k, 5, nl);
    zfs_wu_set(k, 10, pr);
    memcpy(zfs_wu_n(k), path + i, nl);
    var r = zfs_resolve(path, len, 0);
    if (r == (0 - 2)) {
        if (tr == 1) { return zfs_wno("a trailing slash on a name that does not exist (ENOENT)"); }
        return 0;
    }
    if (r < 0) { return zfs_wnon("path unresolvable: ", 0 - r); }
    var ty = zfs_res_type;
    if (zfs_ref_di(r) != di || zfs_gr_find(zfs_mem + ZR_PC, zfs_res_cl) >= 0 || (r & ZK_MASK48) == load64(zfs_ds(di) + 512)) { return zfs_wno("a mount point or another dataset's object (EBUSY / EXDEV)"); }
    if (ty == 2) { zfs_wu_set(k, 6, zfs_wu_under(zfs_mem + ZR_PC, zfs_res_cl)); }
    var de = zfs_dir_lookup(pr, path + i, nl);
    if (de == (0 - 1) || de == (0 - 2) || (de & ZK_MASK48) != (r & ZK_MASK48)) { return zfs_wno("the directory entry is not the object the name resolves to"); }
    if (tr == 1 && ty != 2) { return zfs_wno("a trailing slash on a name that is not a directory (ENOTDIR)"); }
    zfs_wu_set(k, 2, r & ZK_MASK48);
    zfs_wu_set(k, 3, de);
    if (ty == 2) { zfs_wu_set(k, 4, 1); }
    return 0;
}
# The bonus offsets of SIZE, FLAGS, MTIME, CTIME, LINKS and PARENT of SA dnode dn (dataset slot di; zfs_wc_regs ran) into
# group g of zfs_wu_ao; need: a bit per attribute (1 SIZE · 2 FLAGS · 4 MTIME · 8 CTIME · 16 LINKS · 32 PARENT) that must
# be in the bonus (spill update not built). 0 / -1 named.
fn zfs_wu_at(di, dn, g, need) {
    var p = &zfs_wu_ao + g * 48;
    store64(p, zfs_wc_pat(di, dn, 1, 8));
    store64(p + 8, zfs_wc_pat(di, dn, 6, 8));
    store64(p + 16, zfs_wc_pat(di, dn, 8, 16));
    store64(p + 24, zfs_wc_pat(di, dn, 9, 16));
    store64(p + 32, zfs_wc_pat(di, dn, 11, 8));
    store64(p + 40, zfs_wc_pat(di, dn, 5, 8));
    var i = 0;
    while (i < 6) {
        if (((need >> i) & 1) == 1 && load64(p + i * 8) < 0) { return zfs_wno("an attribute this verb writes is not in the bonus (spill update not built)"); }
        i = i + 1;
    }
    return 0;
}
# Reserve what the commit's user accounting adds for dnode dn (the dirty copy, its flags still T - 1's): 6 delta entries,
# and 2 NEW keys per accounting microzap when it lacks the accounting flags (zfs_wd_dirty1's rule). 0 / -1 named.
fn zfs_wu_rsv(dse, dn) { return zfs_wd_urs1(dse, dn); }
# Operand k in the open txg of dataset entry dse: with par 1 its parent directory dirtied as B7 edits it — a ZPL
# directory (20) with an SA bonus, its ZAP micro or fat (B8) and not normalised, SIZE / FLAGS / MTIME / CTIME / LINKS in its
# bonus, not an xattr directory, immutable or append-only; with obj 1 the object's dnode (an SA znode — file, symlink
# (19) or directory (20) — whose attributes in need are in its bonus); what the commit's accounting adds for each
# reserved (zfs_wu_rsv). 0 / -1 named.
fn zfs_wu_open(dse, k, par, obj, need) {
    var os = load64(dse);
    var di = zfs_wu(k, 0);
    if (par == 0) { return zfs_wu_obj(dse, k, obj, need); }
    var pdn = zfs_wos_dn(os, zfs_wu(k, 1));
    if (pdn == 0) { return 0 - 1; }
    if (load8(pdn) != 20) { return zfs_wnon("parent is not a ZPL directory: type ", load8(pdn)); }
    if (load8(pdn + 4) != 44) { return zfs_wno("pre-SA parent (ZPL < 5)"); }
    if (zfs_wu_at(di, pdn, 2 * k, 31) != 0) { return 0 - 1; }
    var pf = load64(zfs_bonus(pdn) + zfs_wu_a(2 * k, 1));
    if ((pf & ZWC_XATTR) != 0) { return zfs_wno("parent is an extended-attribute directory"); }
    if ((pf & (ZWF_IMMUT | ZWF_APPEND)) != 0) { return zfs_wno("immutable or append-only parent (EPERM)"); }
    zfs_wz_open(os, zfs_wu(k, 1), pdn);
    var nf = zfs_wz_norm();
    if (nf < 0) { return 0 - 1; }
    if (nf != 0) { return zfs_wno("normalized parent directory ZAP"); }
    zfs_wu_set(k, 7, pdn);
    if (zfs_wu_rsv(dse, pdn) != 0) { return 0 - 1; }
    return zfs_wu_obj(dse, k, obj, need);
}
fn zfs_wu_obj(dse, k, obj, need) {
    if (obj == 0 || zfs_wu(k, 2) == 0) { return 0; }
    var di = zfs_wu(k, 0);
    var dn = zfs_wos_dn(load64(dse), zfs_wu(k, 2));
    if (dn == 0) { return 0 - 1; }
    if ((load8(dn) != 19 && load8(dn) != 20) || load8(dn + 4) != 44) { return zfs_wnon("not an SA file, symlink or directory: type ", load8(dn)); }
    if (zfs_wu_at(di, dn, 2 * k + 1, need) != 0) { return 0 - 1; }
    zfs_wu_set(k, 9, dn);
    return zfs_wu_rsv(dse, dn);
}
# The parent of operand k gained (+1) or lost (-1) an entry, sd of them directories: SIZE + d, LINKS + sd, MTIME = CTIME
# = {now, 0}, FLAGS | ARCHIVE | AV_MODIFIED (zfs_link_create / zfs_link_destroy, CONTENT_MODIFIED). 0.
fn zfs_wu_pstamp(k, d, sd) {
    var b = zfs_bonus(zfs_wu(k, 7));
    var g = 2 * k;
    store64(b + zfs_wu_a(g, 0), load64(b + zfs_wu_a(g, 0)) + d);
    store64(b + zfs_wu_a(g, 4), load64(b + zfs_wu_a(g, 4)) + sd);
    store64(b + zfs_wu_a(g, 2), zfs_wu_now);
    store64(b + zfs_wu_a(g, 2) + 8, 0);
    store64(b + zfs_wu_a(g, 3), zfs_wu_now);
    store64(b + zfs_wu_a(g, 3) + 8, 0);
    store64(b + zfs_wu_a(g, 1), load64(b + zfs_wu_a(g, 1)) | ZWF_ARCHIVE | ZWF_AVMOD);
    return 0;
}
# The object at dn (offset group g) changed state (STATE_CHANGED): LINKS + dl, PARENT := par when par > 0, CTIME =
# {now, 0}, FLAGS | fl. 0.
fn zfs_wu_ostamp(dn, g, dl, par, fl) {
    var b = zfs_bonus(dn);
    store64(b + zfs_wu_a(g, 4), load64(b + zfs_wu_a(g, 4)) + dl);
    if (par > 0) { store64(b + zfs_wu_a(g, 5), par); }
    store64(b + zfs_wu_a(g, 3), zfs_wu_now);
    store64(b + zfs_wu_a(g, 3) + 8, 0);
    store64(b + zfs_wu_a(g, 1), load64(b + zfs_wu_a(g, 1)) | fl);
    return 0;
}
# Every BP of the tree under bp (a STABLE copy: level lv of object obj; the reader's cache may evict an indirect while a
# child is read, so it is fetched again per child) onto the kill list — children first, the block itself last
# (dnode_sync_free_range's free_children / free_blocks over the whole object) — each entry flagged ZWU_FREED: the
# object's dnode goes in this txg, so no dn_used moves (zfs_wd_phase). 0 · 1 the txg cannot hold it (ZWF_FRMAX, the
# extent list: zfs_wf_xfit) · -1 named (zfs_wd_okbp: a block the commit could not kill).
fn zfs_wu_kbp(dse, obj, bp, lv) {
    if (zfs_bp_hole(bp) == 1) { return 0; }
    var pr = load64(bp + 48);
    var emb = (pr >> 39) & 1;
    if (lv > 0 && emb == 0) {
        var c[128];
        var n = zfs_bp_lsize(bp) / 128;
        var j = 0;
        while (j < n) {
            var ib = zfs_mc_get(bp);
            if (ib == 0) { return zfs_wnon("indirect unreadable: object ", obj); }
            memcpy(&c, ib + j * 128, 128);
            var r = zfs_wu_kbp(dse, obj, &c, lv - 1);
            if (r != 0) { return r; }
            j = j + 1;
        }
    }
    var sk = 0;                                      # (B9) a snapshot's block: deadlisted, no FREE extent
    if (zfs_wugt(zfs_bp_birth(bp), load64(dse + 56)) == 0) { sk = 1; }
    var nd = 0;
    if (sk == 0 && emb == 0 && zfs_wd_defer(bp) == 0) {   # a deferred kill records no FREE extent
        var d = 0;
        while (d < 3) {
            if (load64(bp + d * 16) != 0 || load64(bp + d * 16 + 8) != 0) { nd = nd + 1; }
            d = d + 1;
        }
    }
    if (zfs_wfr_n >= ZWF_FRMAX || zfs_wf_xfit(0, nd) == 0) { return 1; }
    if (zfs_wu_tight > 0 && zfs_wfr_n - zfs_wu_n0 + 1 >= zfs_wu_tight) { return 1; }
    var df = 0;                                      # (B7 review, k.70) a deferred kill's append, budgeted: too big
    if (sk == 0 && emb == 0 && zfs_wd_defer(bp) == 1) { df = 1; }
    if (df == 1 && zfs_dx_meta + zfs_wfb_meta(zfs_wfb_q + 1) + zfs_wdl_meta() > zfs_wf_alim()) { return 1; }
    if (zfs_wd_okbp(dse, bp) != 0) { return 0 - 1; }
    if (sk == 1) {                                   # (B9) a deadlist append, budgeted the same way
        var qr = zfs_wdl_q(dse, bp, 2);
        if (qr != 0) { return qr; }
    }
    var fe = zfs_wmem + ZWA_OS + ZWF_FRL + zfs_wfr_n * 144;
    store64(fe, load64(dse));
    store64(fe + 8, obj | ZWU_FREED);
    memcpy(fe + 16, bp, 128);
    zfs_wfr_n = zfs_wfr_n + 1;
    zfs_wfr_x = zfs_wfr_x + nd;
    zfs_wfb_q = zfs_wfb_q + df;
    return 0;
}
# FREE object obj, its dirty dnode at dn, in the open txg (dmu_object_free -> dnode_free_range + dnode_free): every BP of
# its tree and its spill onto the kill list (zfs_wu_kbp), then its 1 + dn_extra_slots slots zeroed (dnode_sync_free) —
# the commit's user accounting subtracts its old side (zfs_wd_uacct: a zeroed new side), its dnode block's fill drops.
# 0 · 1 too big for one txg — the kill list as it was, nothing changed (the caller takes the lazy path) · -1 named.
fn zfs_wu_free(dse, obj, dn) {
    var n0 = zfs_wfr_n;
    var x0 = zfs_wfr_x;
    var q0 = zfs_wfb_q;
    var d0 = zfs_wdl_n;                              # (B9 review, k.102) and every deadlist count, saved in +72
    var s = 0;
    while (s < d0) {
        store64(zfs_dle(s) + 72, load64(zfs_dle(s) + 24));
        s = s + 1;
    }
    zfs_wu_n0 = n0;
    var c[128];
    var r = 0;
    var i = 0;
    while (i < load8(dn + 3) && r == 0) {
        memcpy(&c, dn + 64 + i * 128, 128);
        r = zfs_wu_kbp(dse, obj, &c, load8(dn + 2) - 1);
        i = i + 1;
    }
    if (r == 0 && (load8(dn + 7) & 4) != 0) {
        memcpy(&c, dn + (load8(dn + 12) + 1) * 512 - 128, 128);
        r = zfs_wu_kbp(dse, obj, &c, 0);
    }
    if (r != 0) {
        zfs_wu_kn = zfs_wfr_n - n0;
        zfs_wu_kx = zfs_wfr_x - x0;
        zfs_wfr_n = n0;
        zfs_wfr_x = x0;
        zfs_wfb_q = q0;
        # (B9 review, k.102) the deadlist counts of the kills just dropped go too — the lazy path, and every later
        # admission of the txg, would otherwise be judged against appends that never happen (an entry this free
        # loaded keeps no count)
        s = 0;
        while (s < zfs_wdl_n) {
            if (s < d0) { store64(zfs_dle(s) + 24, load64(zfs_dle(s) + 72)); } else { store64(zfs_dle(s) + 24, 0); }
            s = s + 1;
        }
        return r;
    }
    memset(dn, 0, (load8(dn + 12) + 1) * 512);
    zfs_wu_fr = zfs_wu_fr + 1;
    return 0;
}
# The LAZY free (design § f.5; zfs_unlinked_add): object obj (dirty dnode dn, its LINKS at offset lo of the bonus) stays
# allocated with LINKS 0 and "%llx"(obj) -> obj goes into the dataset's DELETE_QUEUE (the master node's entry: an
# UNLINKED_SET (22) ZAP: a microzap, upgraded past 128 KiB, or fat — B8's zfs_wz_op), which OpenZFS drains at its next
# read-write mount. 0 /
# -1 named.
fn zfs_wu_lazy(dse, di, obj, dn, lo) {
    var os = load64(dse);
    var mn = zfs_wdn(2);
    var dq = 0;
    if (zfs_dnode(zfs_ds(di), 1, mn) != 0 || zfs_wzu64(mn, "DELETE_QUEUE", &dq) != 1 || dq < 1) { return zfs_wno("no DELETE_QUEUE for the lazy free"); }
    var qd = zfs_wos_dn(os, dq);
    if (qd == 0) { return 0 - 1; }
    if (load8(qd) != 22) { return zfs_wnon("DELETE_QUEUE is not an UNLINKED_SET: type ", load8(qd)); }
    zfs_wz_open(os, dq, qd);
    var nf = zfs_wz_norm();
    if (nf < 0) { return 0 - 1; }
    if (nf != 0) { return zfs_wno("a normalised DELETE_QUEUE"); }
    var key[24];
    var kl = zfs_whex(obj, &key);
    var v[8];
    store64(&v, obj);
    if (zfs_wz_op(0, &key, kl, 8, 1, &v) != 0) { return 0 - 1; }
    store64(zfs_bonus(dn) + lo, 0);
    zfs_wu_lz = zfs_wu_lz + 1;
    zfs_wq_lzo = obj;                                # (B10, k.63) the op drains it after its own txg (zfs_wu_end)
    zfs_wq_lzd = di;
    return 0;
}
# link_destroy (zfs_dir.c:725-809) of operand k's name: its chunk zeroed (mzap_remove), the parent stamped (SIZE - 1,
# LINKS - is_dir); unless ren, the object loses its link — LINKS - 1, CTIME, FLAGS | ARCHIVE while others remain, else
# freed (zfs_wu_free) or, too big for the txg or holding an xattr directory (ZPL_XATTR, zfs_rmnode), the lazy way
# (zfs_wu_lazy). 0 / -1 named.
fn zfs_wu_drop(dse, k, ren) {
    zfs_wz_open(load64(dse), zfs_wu(k, 1), zfs_wu(k, 7));
    var ev[8];
    var gq = zfs_wz_get(zfs_wu_n(k), zfs_wu(k, 5), &ev);
    if (gq < 0) { return 0 - 1; }
    if (gq != 1 || load64(&ev) != zfs_wu(k, 3)) { return zfs_wno("the directory entry changed (lookup vs the ZAP)"); }
    if (zfs_wz_op(2, zfs_wu_n(k), zfs_wu(k, 5), 8, 1, &ev) != 0) { return 0 - 1; }
    var dir = zfs_wu(k, 4);
    zfs_wu_pstamp(k, 0 - 1, 0 - dir);
    if (ren == 1) { return 0; }
    var dn = zfs_wu(k, 9);
    var g = 2 * k + 1;
    var b = zfs_bonus(dn);
    var ln = load64(b + zfs_wu_a(g, 4));
    if (ln <= dir) { return zfs_wnon("a link count below its floor (zfs_panic_recover): ", ln); }
    if (ln - 1 > dir) { return zfs_wu_ostamp(dn, g, 0 - 1, 0, ZWF_ARCHIVE); }
    var xa = 0;
    var v[16];
    var num = load64(&zfs_wc_an + 16 * 8);
    if (num >= 0) {
        var xr = zfs_sa_attr(zfs_wu(k, 0), dn, num, &v, 16);
        if (xr == 8) { xa = load64(&v); }
        elif (xr != (0 - 2)) { return zfs_wno("ZPL_XATTR unreadable"); }
    }
    var r = 1;
    if (xa == 0) { r = zfs_wu_free(dse, zfs_wu(k, 2), dn); }
    if (r < 0) { return 0 - 1; }
    if (r == 1) { return zfs_wu_lazy(dse, zfs_wu(k, 0), zfs_wu(k, 2), dn, zfs_wu_a(g, 4)); }
    return 0;
}
# link_create (zfs_dir.c:580-671) of the object of operand s (dirent val; its dirty dnode, offset group 2s + 1) under
# operand t's name — its bytes judged first (zfs_wname: no NUL; ASCII on a utf8only dataset) —: the entry
# (zfs_wz_op: micro or fat, B8), the parent stamped (SIZE + 1, LINKS + is_dir); the object's PARENT := that directory,
# CTIME, FLAGS | ARCHIVE, and unless ren LINKS + 1. 0 / -1 named.
fn zfs_wu_make(t, s, ren) {
    var nl = zfs_wu(t, 5);
    if (zfs_wname(zfs_wu(t, 0), zfs_wu_n(t), nl) != 0) { return 0 - 1; }
    zfs_wz_open(load64(zfs_ds(zfs_wu(t, 0)) + 840), zfs_wu(t, 1), zfs_wu(t, 7));
    var ev[8];
    var g = zfs_wz_get(zfs_wu_n(t), nl, &ev);
    if (g < 0) { return 0 - 1; }
    if (g == 1) { return zfs_wno("name exists (EEXIST)"); }
    store64(&ev, zfs_wu(s, 3));
    if (zfs_wz_op(0, zfs_wu_n(t), nl, 8, 1, &ev) != 0) { return 0 - 1; }
    zfs_wu_pstamp(t, 1, zfs_wu(s, 4));
    var dl = 1;
    if (ren == 1) { dl = 0; }
    return zfs_wu_ostamp(zfs_wu(s, 9), 2 * s + 1, dl, zfs_wu(t, 1), ZWF_ARCHIVE);
}
# The flags rule of an object a verb unlinks or renames (zfs_zaccess_delete: IMMUTABLE | NOUNLINK -> EPERM; design § a.3:
# APPENDONLY too) — mode 1 — or links (zfs_link: APPENDONLY | IMMUTABLE | READONLY) — mode 2; operand k. 0 / -1 named.
fn zfs_wu_flags(k, mode) {
    var f = load64(zfs_bonus(zfs_wu(k, 9)) + zfs_wu_a(2 * k + 1, 1));
    if (mode == 1 && (f & (ZWF_IMMUT | ZWU_NOUNL | ZWF_APPEND)) != 0) { return zfs_wno("immutable, no-unlink or append-only (EPERM)"); }
    if (mode == 2 && (f & (ZWF_IMMUT | ZWF_APPEND | ZWF_RO)) != 0) { return zfs_wno("immutable, append-only or read-only file (EPERM)"); }
    return 0;
}
# zfs_link / zfs_do_rename_impl's project rule: into a PROJINHERIT directory (operand t's parent) only an object of its
# project (operand s's) — EXDEV. 0 / -1 named.
fn zfs_wu_proj(t, s) {
    var pb = zfs_bonus(zfs_wu(t, 7));
    if ((load64(pb + zfs_wu_a(2 * t, 1)) & ZWC_PROJI) == 0) { return 0; }
    var di = zfs_wu(t, 0);
    var a = 0;
    var b = 0;
    var o = zfs_wc_pat(di, zfs_wu(t, 7), 12, 8);
    if (o >= 0) { a = load64(pb + o); }
    o = zfs_wc_pat(di, zfs_wu(s, 9), 12, 8);
    if (o >= 0) { b = load64(zfs_bonus(zfs_wu(s, 9)) + o); }
    if (a != b) { return zfs_wno("into a PROJINHERIT directory of another project (EXDEV)"); }
    return 0;
}
# The txg's start for operand 0's dataset (zfs_wc1's): a writable pool, nothing dirty, room for the commit's metadata
# (zfs_wphys), the dataset open for write, its REGISTRY numbers, the kill list's half of the data arena. The entry / 0.
fn zfs_wu_begin() {
    zfs_wu_lz = 0;
    zfs_wu_fr = 0;
    zfs_wq_lzo = 0;
    if (zfs_rw != 1 || zfs_wmem == 0) {
        zfs_wno("pool read-only");
        return 0;
    }
    if (zfs_wp_own() != 0) { return 0; }             # (B11 review) a pending txg commits first, never dropped with a refusal
    if (zfs_dx_n != 0 || zfs_xl_n != 0) {
        zfs_wno("dirty set not empty (one op per txg: policy A)");
        return 0;
    }
    if (zfs_w_alloc > zfs_wphys()) {
        zfs_wno("no space: the metaslabs with a space map are full");
        return 0;
    }
    var di = zfs_wu(0, 0);
    var dse = zfs_wds_open(di);
    if (dse == 0) { return 0; }
    if (zfs_wc_regs(di) != 0) { return 0; }
    zfs_dx_dmax = ZWF_FRL;
    zfs_wu_now = zfs_wf_now();
    return dse;
}
# The txg's end: the dirty set within its arena (ZWF_MRSV), then the commit — or a refusal, the txg dropped (nothing was
# allocated before the commit). (B10, k.63) An op that put an object on the DELETE_QUEUE then DRAINS it in the txgs
# after its own (zfs_wq_obj: zfs_rmnode's shape) — its success stands whatever the drain meets (a refused drain leaves
# the object queued: OpenZFS's next writable mount drains it). 0 / -1 named.
fn zfs_wu_end(r) {
    if (r == 0 && zfs_wf_mfit(0) == 0) { r = zfs_wnon("the op does not fit a txg: dirty metadata bytes ", zfs_dx_meta); }
    if (r != 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    var cr = zfs_commit();
    if (cr == 0 && zfs_wq_lzo != 0 && zfs_wq_auto == 1) {
        var lo = zfs_wq_lzo;
        zfs_wq_lzo = 0;
        zfs_wq_obj(zfs_wq_lzd, lo);
    }
    return cr;
}
# ⭐ unlink#30 of path (ZFS-relative, len bytes): ONE txg — the name out of its parent, the object losing a link (freed
# at its last; lazily when too big — the section header). 0 / -1 named. Caller holds fs_spin_lock.
fn zfs_wunlink(path, len) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    if (zfs_active == 0 || zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    if (zfs_wu_arg(0, path, len) != 0) { return 0 - 1; }
    if (zfs_wu(0, 2) == 0) { return zfs_wno("no such name (ENOENT)"); }
    if (zfs_wu(0, 4) == 1) { return zfs_wno("unlink of a directory (EPERM: rmdir)"); }
    var dse = zfs_wu_begin();
    var r = 0 - 1;
    if (dse != 0 && zfs_wu_open(dse, 0, 1, 1, 26) == 0 && zfs_wu_flags(0, 1) == 0) { r = zfs_wu_drop(dse, 0, 0); }
    return zfs_wu_end(r);
}
# ⭐ rmdir#10: ONE txg — an EMPTY directory (SIZE == 2, zfs_dirempty; LINKS 2) out of its parent, its microzap killed and
# its slot freed. 0 / -1 named.
fn zfs_wrmdir(path, len) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    if (zfs_active == 0 || zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    if (zfs_wu_arg(0, path, len) != 0) { return 0 - 1; }
    if (zfs_wu(0, 2) == 0) { return zfs_wno("no such name (ENOENT)"); }
    if (zfs_wu(0, 4) == 0) { return zfs_wno("rmdir of a non-directory (ENOTDIR)"); }
    if (zfs_wu(0, 6) == 1) { return zfs_wno("a dataset is mounted below it (EBUSY)"); }
    var dse = zfs_wu_begin();
    var r = 0 - 1;
    if (dse != 0 && zfs_wu_open(dse, 0, 1, 1, 27) == 0 && zfs_wu_flags(0, 1) == 0) {
        var b = zfs_bonus(zfs_wu(0, 9));
        if (load64(b + zfs_wu_a(1, 0)) != 2) { r = zfs_wnon("directory not empty (ENOTEMPTY): SIZE ", load64(b + zfs_wu_a(1, 0))); }
        elif (load64(b + zfs_wu_a(1, 4)) != 2) { r = zfs_wnon("an empty directory whose LINKS is not 2: ", load64(b + zfs_wu_a(1, 4))); }
        else { r = zfs_wu_drop(dse, 0, 0); }
    }
    return zfs_wu_end(r);
}
# ⭐ link#32: the object at sp (not followed — a symlink is linked itself; never a directory) under the NEW name tp, in
# the SAME dataset — ONE txg. 0 / -1 named.
fn zfs_wlink(sp, sl, tp, tl) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    if (zfs_active == 0 || zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    if (zfs_wu_arg(0, sp, sl) != 0) { return 0 - 1; }
    if (zfs_wu(0, 2) == 0) { return zfs_wno("no such name (ENOENT)"); }
    if (zfs_wu(0, 4) == 1) { return zfs_wno("link of a directory (EPERM)"); }
    if (zfs_wu_arg(1, tp, tl) != 0) { return 0 - 1; }
    if (zfs_wu(1, 2) != 0) { return zfs_wno("name exists (EEXIST)"); }
    if (zfs_wu(1, 0) != zfs_wu(0, 0)) { return zfs_wno("link across datasets (EXDEV)"); }
    var dse = zfs_wu_begin();
    var r = 0 - 1;
    if (dse != 0 && zfs_wu_open(dse, 0, 0, 1, 58) == 0 && zfs_wu_open(dse, 1, 1, 0, 0) == 0 && zfs_wu_flags(0, 2) == 0 && zfs_wu_proj(1, 0) == 0) {
        r = zfs_wd_space(dse, 512, 0, 0);
        if (r == 0) { r = zfs_wu_make(1, 0, 0); }
    }
    return zfs_wu_end(r);
}
# Does directory td (dataset slot di; root = the dataset's ROOT) lie at or under object so? zfs_rename_check's walk up
# the PARENT attributes (committed: nothing the txg dirties moves a PARENT before the check). 1 yes / 0 no / -1 named.
fn zfs_wu_cycle(di, td, so) {
    var root = load64(zfs_ds(di) + 512);
    var num = load64(&zfs_wc_an + 5 * 8);
    var d = zfs_wdn(3);
    var v[16];
    var x = td;
    var n = 0;
    while (n < ZWU_DEPTH) {
        if (x == so) { return 1; }
        if (x == root) { return 0; }
        if (zfs_dnode(zfs_ds(di), x, d) != 0 || zfs_sa_attr(di, d, num, &v, 16) != 8) { return zfs_wnon("PARENT unreadable: object ", x); }
        x = load64(&v);
        n = n + 1;
    }
    return zfs_wno("directory tree deeper than the PARENT walk's bound");
}
# ⭐ rename#31 of sp to tp in ONE dataset — ONE txg (the section header): the target replaced (link_destroy), the new
# name made (link_create, renaming: PARENT moves, FLAGS | AV_MODIFIED), the old name dropped (renaming). 0 / -1 named.
fn zfs_wrename(sp, sl, tp, tl) {
    if (zfs_wp_flush() != 0) { return 0 - 1; }       # (B11) a mutation: a pending policy-B txg commits first
    if (zfs_active == 0 || zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    if (zfs_wu_arg(0, sp, sl) != 0) { return 0 - 1; }
    if (zfs_wu(0, 2) == 0) { return zfs_wno("no such name (ENOENT)"); }
    if (zfs_wu_arg(1, tp, tl) != 0) { return 0 - 1; }
    if (zfs_wu(1, 0) != zfs_wu(0, 0)) { return zfs_wno("rename across datasets (EXDEV)"); }
    var sd = zfs_wu(0, 4);
    if (zfs_wu(1, 2) != 0) {
        if (zfs_wu(1, 2) == zfs_wu(0, 2)) { return 0; }
        if (sd == 1 && zfs_wu(1, 4) == 0) { return zfs_wno("rename of a directory over a non-directory (ENOTDIR)"); }
        if (sd == 0 && zfs_wu(1, 4) == 1) { return zfs_wno("rename of a non-directory over a directory (EISDIR)"); }
        if (zfs_wu(1, 6) == 1) { return zfs_wno("a dataset is mounted below the target (EBUSY)"); }
    }
    var dse = zfs_wu_begin();
    var r = 0 - 1;
    if (dse != 0) {
        r = 0;
        if (sd == 1) {
            if (zfs_wu(0, 6) == 1) { r = zfs_wno("a dataset is mounted below it (EBUSY)"); }
            else {
                var cy = zfs_wu_cycle(zfs_wu(0, 0), zfs_wu(1, 1), zfs_wu(0, 2));
                if (cy == 1) { r = zfs_wno("a directory into its own subtree (EINVAL)"); }
                elif (cy < 0) { r = 0 - 1; }
            }
        }
        if (r == 0 && (zfs_wu_open(dse, 0, 1, 1, 58) != 0 || zfs_wu_open(dse, 1, 1, 1, 26) != 0 || zfs_wu_flags(0, 1) != 0 || zfs_wu_proj(1, 0) != 0)) { r = 0 - 1; }
        if (r == 0 && zfs_wu(1, 2) != 0) {
            if (zfs_wu_flags(1, 1) != 0) { r = 0 - 1; }
            elif (zfs_wu(1, 4) == 1) {
                var tb = zfs_bonus(zfs_wu(1, 9));
                if (zfs_wu_at(zfs_wu(1, 0), zfs_wu(1, 9), 3, 17) != 0) { r = 0 - 1; }
                elif (load64(tb + zfs_wu_a(3, 0)) != 2) { r = zfs_wnon("rename over a non-empty directory (ENOTEMPTY): SIZE ", load64(tb + zfs_wu_a(3, 0))); }
            }
            if (r == 0) { r = zfs_wd_space(dse, 512, 0, 0); }
            if (r == 0) { r = zfs_wu_drop(dse, 1, 0); }
        } elif (r == 0) { r = zfs_wd_space(dse, 512, 0, 0); }
        if (r == 0) { r = zfs_wu_make(1, 0, 1); }
        if (r == 0) {
            var ob = zfs_bonus(zfs_wu(0, 9));
            store64(ob + zfs_wu_a(1, 1), load64(ob + zfs_wu_a(1, 1)) | ZWF_AVMOD);
            r = zfs_wu_drop(dse, 0, 1);
        }
    }
    return zfs_wu_end(r);
}
# --- B8: ZAPs of every shape in the dirty set — micro, the micro -> fat upgrade, fat (design § f.2, § e.3, § f.1, § f.5;
# WPA § 9; zap.c / zap_leaf.c / zap_micro.c) ---------------------------------------------------------------------------
# ONE ZAP object at a time (zfs_wz_open: its objset — 0 the MOS —, its number, its DIRTY dnode). zap_add / zap_update /
# zap_remove / zap_lookup exactly as OpenZFS takes them:
#   · a MICROZAP (one block, mzap_phys_t): an entry in a 64-byte chunk — the first free one, the lowest cd its 28-bit
#     hash leaves unused — growing by 512 B when full (zfs_mz_add); removed: its chunk zeroed. It is UPGRADED
#     (mzap_upgrade: zfs_wz_upgrade) when an add or update names a value that is not one u64 (SA LAYOUTS' u16 arrays),
#     a name of 50+ bytes (MZAP_NAME_LEN), a hash that already has too many entries for one fat leaf
#     (mze_canfit_fzap_leaf), or the block is full at 128 KiB (zap_micro_max_size: large_microzap is never activated)
#   · a FAT ZAP: zfs_wenc.cyr's zfs_zf_op / zfs_zf_get — OpenZFS 2.4.2's fat-ZAP code proven on the host against
#     OpenZFS's own blocks (check.sh gate 37) — over its blocks as the three resolvers below give them: dirtied
#     (zfs_wblk; a block past dn_maxblkid makes the object grow — zfs_wf_levels adds the levels it needs), read
#     dirty-first, freed (zfs_zf_kill: dmu_free_range of the old pointer table at zap_table_grow's switch — (B8
#     review) through B5's kill list, a hole of birth T in the dirtied L1, killed inside the commit; one dirty in the
#     txg zeroed, which the commit makes a hole of birth T, design § d.1)
# Refused by name: zap_flags (HASH64 / UINT64_KEY / PRE_HASHED_KEY — never on a ZAP the writer touches), a name with
# a byte >= 128 in a normalised ZAP (u8_textprep's tables are not built), block sizes outside 512 B .. 128 KiB, an
# inconsistent block (zfs_zf_bad), a pointer table at zt_shift 26 (zap_grow_ptrtbl's ENOSPC), an external pointer
# table DOUBLING inside the commit (an accounting ZAP's — not budgeted; refused at admission, zfs_wz_urs), and (B8
# review) a pointer-table growth of EITHER kind in a MOS ZAP (zfs_zf_gok: before anything changes; the write gate
# refuses a log ZAP whose table is already external or mid-grow).
var zfs_wz_os = 0;           # the open ZAP: objset (0 the MOS) · object · its dirty dnode
var zfs_wz_obj = 0;
var zfs_wz_dn = 0;
var zfs_wz_mres = 0;         # metadata-arena bytes the open txg reserves for the commit's own fat accounting-ZAP growth
#   (zfs_wz_urs; zfs_wf_mfit counts it) — reset with the dirty set
fn zfs_wz_open(os, obj, dn) {
    zfs_wz_os = os;
    zfs_wz_obj = obj;
    zfs_wz_dn = dn;
    return 0;
}
# Block k of the open ZAP for WRITING — dirtied (zfs_wblk: a copy of T - 1's, a hole read as zeros); past dn_maxblkid
# the object grows to it (dnode_new_blkid: the levels it needs, zfs_wf_levels). Its address, or 0 named.
fn zfs_zf_blk(k) {
    var dn = zfs_wz_dn;
    if (k < 0 || k > ZK_MASK48) {
        zfs_wnon("ZAP block out of range: ", k);
        return 0;
    }
    if (k > load64(dn + 16)) {
        if (zfs_wf_levels(dn, zfs_wz_os, zfs_wz_obj, k) != 0) { return 0; }
        store64(dn + 16, k);
    }
    var e = zfs_wblk(dn, zfs_wz_os, zfs_wz_obj, 0, k);
    if (e < 0) { return 0; }
    return zfs_dirty_buf(e);
}
# Block k for READING, dirty-first: its dirty copy, else the reader's (the cache slot — good until the next block is
# read), zeros for a hole or past the end. 0 named.
fn zfs_zf_rblk(k) {
    var e = zfs_dirty_find(zfs_wz_os, zfs_wz_obj, 0, k);
    if (e >= 0) { return zfs_dirty_buf(e); }
    if (k < 0 || k > load64(zfs_wz_dn + 16)) { return zfs_mem + ZR_ZERO; }
    var bp[128];
    var h = zfs_wf_bp(zfs_wz_dn, zfs_wz_os, zfs_wz_obj, k, &bp);
    if (h < 0) { return 0; }
    if (h == 0) { return zfs_mem + ZR_ZERO; }
    var b = zfs_mc_get(&bp);
    if (b == 0) { zfs_wnon("ZAP block unreadable: object ", zfs_wz_obj); }
    return b;
}
# (B8 review) May the open ZAP's pointer table grow (zap_grow_ptrtbl, either kind)? Not in a MOS ZAP: a doubling there
# frees MOS blocks inside the commit, which the commit's own MOS kill path does not do — so neither kind begins there:
# zfs_zf_grow answers ZZ_NOGROW before it changes anything (the log ZAP's maybe-growth is skipped; a split that needs a
# growth fails the commit by name). The write gate refuses a log ZAP whose table is already external or mid-grow
# (zfs_wgate_zap); an embedded table grows only past ≈ 10^5 entries. 0 / 1.
fn zfs_zf_gok() {
    if (zfs_wz_os == 0) { return 1; }
    return 0;
}
# dmu_free_range of the n blocks from k of the open ZAP (zap_table_grow's old pointer table, at its switch) as
# free_blocks does it (dnode_sync.c:140-178) — every block, or -1 named and the op failed (its txg dropped):
#   · one dirty in the open txg (zap_table_store wrote it): zeroed in place — the commit makes an all-zero metadata
#     block a hole of birth T and kills its predecessor (design § d.1)
#   · any other: its BP killed through B5's kill list (zfs_wf_kill — judged killable, a hole of birth T in the dirtied
#     L1 above it, killed inside the commit by zfs_wd_phase): no metadata-arena slot and no read per block. (B8 review:
#     dirtying each one took 16 KiB of the arena, so the switch of a 64-block table never fit a txg and the ZAP stayed
#     mid-grow for agnos.) Its bound is the kill list's and the extent list's (zfs_wf_xfit): ≈ 1,600 two-copy blocks
#   · inside the commit (an accounting ZAP's growth, whose external table admission refuses — k.77) the first way
#     for every block: the kill list was drained before the commit's ZAP writes
fn zfs_zf_kill(k, n) {
    var os = zfs_wz_os;
    var obj = zfs_wz_obj;
    var dn = zfs_wz_dn;
    if (os == 0) { return zfs_wno("a pointer-table doubling in a MOS ZAP (not built)"); }
    var dse = zfs_wds_find(os);
    if (dse == 0) { return zfs_wnon("dataset not opened for write: ", os); }
    var t = zfs_txg + 1;
    if ((zfs_w_feat & 8) == 0) { t = 0; }
    var nl = load8(dn + 2);
    var epbs = load8(dn + 1) - 7;
    var i = 0;
    while (i < n) {
        var bid = k + i;
        var e = zfs_dirty_find(os, obj, 0, bid);
        if (e < 0 && zfs_wc_in != 0 && bid <= load64(dn + 16)) {
            e = zfs_wblk(dn, os, obj, 0, bid);
            if (e < 0) { return 0 - 1; }
        }
        if (e >= 0) { memset(zfs_dirty_buf(e), 0, 1 << zfs_zf_bs); }
        elif (bid <= load64(dn + 16)) {
            var bp = dn + 64 + bid * 128;
            if (nl > 1) {
                var pe = zfs_wblk(dn, os, obj, 1, bid >> epbs);
                if (pe < 0) { return 0 - 1; }
                bp = zfs_dirty_buf(pe) + (bid & ((1 << epbs) - 1)) * 128;
            }
            if (zfs_bp_hole(bp) == 0) {
                if (zfs_dx_dmax == 0) {
                    if (zfs_dx_data > ZWF_FRL) { return zfs_wno("txg full: the kill list's half of the data arena is in use"); }
                    zfs_dx_dmax = ZWF_FRL;
                }
                var kr = zfs_wf_kill(dse, os, obj, bp, t);
                if (kr < 0) { return 0 - 1; }
                if (kr == 1) { return zfs_wnon("txg full: a pointer table's old blocks (the kill list / extent list): ", n); }
            }
        }
        i = i + 1;
    }
    return 0;
}
# A ZZ_* result as the writer's refusal (ZZ_IO: the resolver named it already). -1.
fn zfs_wz_err(r) {
    if (r == ZZ_NOENT) { return zfs_wnon("no such ZAP entry: object ", zfs_wz_obj); }
    if (r == ZZ_EXIST) { return zfs_wno("name exists (EEXIST)"); }
    if (r == ZZ_CORRUPT) { return zfs_wnon("fat ZAP inconsistent: object ", zfs_wz_obj); }
    if (r == ZZ_NOSPC) { return zfs_wnon("fat ZAP pointer table at its limit (zt_shift 26): object ", zfs_wz_obj); }
    if (r == ZZ_2BIG) { return zfs_wno("a ZAP entry larger than a leaf (E2BIG)"); }
    if (r == ZZ_NOTSUP) { return zfs_wno("a non-ASCII name in a normalised ZAP (u8_textprep not built)"); }
    if (r == ZZ_NOGROW) { return zfs_wnon("a pointer-table growth in a MOS ZAP (not built): object ", zfs_wz_obj); }
    if (zfs_wr_lit == 0) { zfs_wnon("fat ZAP block unavailable: object ", zfs_wz_obj); }
    return 0 - 1;
}
# The open ZAP's shape, dirty-first: 3 a microzap (one block) · 1 a fat ZAP this code writes (zfs_zf_bs set) · -1 named.
fn zfs_wz_kind() {
    var b = zfs_zf_rblk(0);
    if (b == 0) { return 0 - 1; }
    var bsz = load16(zfs_wz_dn + 8) << 9;
    var t = load64(b);
    if (t == ((1 << 63) | 3)) {
        if (load64(zfs_wz_dn + 16) != 0 || bsz < 512 || bsz > ZK_METAMAX) { return zfs_wnon("a microzap of more than one block or of bytes ", bsz); }
        return 3;
    }
    if (t != ((1 << 63) | 1) || load64(b + 8) != ZZ_MAGIC) { return zfs_wnon("ZAP block 0 is neither micro nor fat: object ", zfs_wz_obj); }
    if (load64(b + 96) != 0) { return zfs_wnon("a fat ZAP with zap_flags (HASH64 / UINT64_KEY: not built): ", load64(b + 96)); }
    var bs = 9;
    while (bs < 17 && (1 << bs) < bsz) { bs = bs + 1; }
    if ((1 << bs) != bsz) { return zfs_wnon("a fat ZAP of block bytes ", bsz); }
    zfs_zf_bs = bs;
    return 1;
}
# Its normalisation flags (mz_normflags / zap_normflags), or -1 named.
fn zfs_wz_norm() {
    var k = zfs_wz_kind();
    if (k < 0) { return 0 - 1; }
    var b = zfs_zf_rblk(0);
    if (b == 0) { return 0 - 1; }
    if (k == 3) { return load64(b + 16); }
    return load64(b + 88);
}
# mze_canfit_fzap_leaf for name n (l bytes) in the microzap block b of bsz bytes: (the entries sharing its 28-bit hash +
# 1) x MZAP_ENT_CHUNKS (5) < ZAP_LEAF_NUMCHUNKS_DEF (638). 1 / 0.
fn zfs_wz_canfit(b, bsz, n, l) {
    var h = zfs_zap_hash(load64(b + 8), n, l);
    var same = 0;
    var k = 64;
    while (k < bsz) {
        if (load8(b + k + 14) != 0) {
            var jl = 0;
            while (jl < 50 && load8(b + k + 14 + jl) != 0) { jl = jl + 1; }
            if (zfs_zap_hash(load64(b + 8), b + k + 14, jl) == h) { same = same + 1; }
        }
        k = k + 64;
    }
    if ((same + 1) * 5 < 638) { return 1; }
    return 0;
}
# Has the microzap block b of bsz bytes a free chunk? 1 / 0.
fn zfs_wz_mfree(b, bsz) {
    var k = 64;
    while (k < bsz) {
        if (load8(b + k + 14) == 0) { return 1; }
        k = k + 64;
    }
    return 0;
}
# mzap_upgrade of the open microzap: its block snapshotted (ZWA_CMP: free outside a block's build), block 0 resized to
# 16 KiB (dmu_object_set_blocksize to fzap_default_block_shift — dbuf_new_size: grown in place or into a new slot,
# shrunk in place), then zfs_zf_upgrade (fzap_upgrade: the header, block 1 the first leaf; every entry re-added in
# chunk order with its own cd). 0 / -1 named.
fn zfs_wz_upgrade() {
    var dn = zfs_wz_dn;
    var e = zfs_wblk(dn, zfs_wz_os, zfs_wz_obj, 0, 0);
    if (e < 0) { return 0 - 1; }
    var msz = load64(zfs_dent(e) + 32);
    if (msz > ZK_METAMAX) { return zfs_wnon("an upgrade of a microzap over 128 KiB: bytes ", msz); }
    memcpy(zfs_wmem + ZWA_CMP, zfs_dirty_buf(e), msz);
    if (msz < 16384) {
        if (zfs_dirty_grow(e, 16384) != 0) { return 0 - 1; }
    } else { store64(zfs_dent(e) + 32, 16384); }
    store16(dn + 8, 32);
    zfs_zf_bs = 14;
    var r = zfs_zf_upgrade(zfs_dirty_buf(e), zfs_wmem + ZWA_CMP, msz);
    if (r != 0) { return zfs_wz_err(r); }
    zfs_wz_upn();
    return 0;
}
# zap_lookup of name n (l bytes) in the open ZAP, dirty-first: 1 and its first u64 at out · 0 absent · -1 named.
fn zfs_wz_get(n, l, out) {
    var k = zfs_wz_kind();
    if (k < 0) { return 0 - 1; }
    var b = zfs_zf_rblk(0);
    if (b == 0) { return 0 - 1; }
    if (k == 3) {
        if (l < 1 || l > 49) { return 0; }
        var p = zfs_mz_find(b, load16(zfs_wz_dn + 8) << 9, n, l);
        if (p == 0) { return 0; }
        store64(out, load64(p));
        return 1;
    }
    var h = zfs_zf_hash(b, n, l);
    if (zfs_zf_ns != 0) { return zfs_wz_err(ZZ_NOTSUP); }
    var r = zfs_zf_get(b, h, n, l, 8, 1, out);
    if (r == ZZ_NOENT) { return 0; }
    if (r < 0) { return zfs_wz_err(r); }
    return 1;
}
# zap_add (op 0) / zap_update (op 1) / zap_remove (op 2) of name n (l bytes) -> cnt integers of isz bytes at p in the
# open ZAP (the section header's rules). 0 / -1 named (ZZ_EXIST / ZZ_NOENT too).
fn zfs_wz_op(op, n, l, isz, cnt, p) {
    var k = zfs_wz_kind();
    if (k < 0) { return 0 - 1; }
    if (k == 3) {
        var e = zfs_wblk(zfs_wz_dn, zfs_wz_os, zfs_wz_obj, 0, 0);
        if (e < 0) { return 0 - 1; }
        var b = zfs_dirty_buf(e);
        var bsz = load64(zfs_dent(e) + 32);
        if (load64(b + 16) != 0) { return zfs_wno("a normalised microzap (u8_textprep not built)"); }
        var q = 0;
        if (l >= 1 && l <= 49) { q = zfs_mz_find(b, bsz, n, l); }
        if (op == 2) {
            if (q == 0) { return zfs_wz_err(ZZ_NOENT); }
            memset(q, 0, 64);
            return 0;
        }
        var micro = 1;
        if (isz != 8 || cnt != 1 || l < 1 || l > 49) { micro = 0; }
        elif (q != 0) {
            if (op == 0) { return zfs_wz_err(ZZ_EXIST); }
            store64(q, load64(p));
            return 0;
        } elif (op == 0 && zfs_wz_canfit(b, bsz, n, l) == 0) { micro = 0; }
        elif (zfs_wz_mfree(b, bsz) == 0 && bsz + 512 > ZK_METAMAX) { micro = 0; }
        if (micro == 1) { return zfs_mz_add(zfs_wz_dn, e, n, l, load64(p)); }
        if (zfs_wz_upgrade() != 0) { return 0 - 1; }
    }
    var hdr = zfs_zf_blk(0);
    if (hdr == 0) { return 0 - 1; }
    var h = zfs_zf_hash(hdr, n, l);
    if (zfs_zf_ns != 0) { return zfs_wz_err(ZZ_NOTSUP); }
    var r = zfs_zf_op(hdr, op, h, n, l, isz, cnt, p, 0 - 1);
    if (r != 0) { return zfs_wz_err(r); }
    return 0;
}
# Accounting-ZAP capacity at zfs_wds_open (dse +120): 16 bits per ZAP (bits 0-15 user, 16-31 group, 32-47 project) —
# the NEW keys a microzap can still take (free chunks + 8 per 512 B of growth to 128 KiB: <= 2,047), 0xFFFF a fat one.
fn zfs_wz_ucap(sd, b) {
    var bsz = load16(sd + 8) << 9;
    if (load64(b) != ((1 << 63) | 3)) { return 0xFFFF; }
    var c = ((ZK_METAMAX - bsz) >> 9) * 8;
    var j = 64;
    while (j < bsz) {
        if (load8(b + j + 14) == 0) { c = c + 1; }
        j = j + 64;
    }
    if (c > 0xFFFE) { c = 0xFFFE; }
    return c;
}
# ⭐ What the commit's user / group / project accounting (zfs_wd_uacct -> zfs_wd_uqapply) will do for ONE synced dnode
# whose ids are at ids (uid, gid, projid — 0: unknown), reserved NOW (the B4 review's rule: nothing the commit dirties
# may refuse it): 6 delta entries; and per accounting ZAP, nk NEW keys at most —
#   · a MICROZAP takes them from its capacity (dse +120); one that cannot is UPGRADED now (zfs_wz_upgrade — what
#     OpenZFS does inside that sync's zap_increment; the blocks dirtied here are measured like any admission's)
#   · a FAT ZAP: its header and the leaves its keys hash to ("%llx" and "obj-%llx" of each id) dirtied now — the commit
#     then updates and removes inside blocks already counted — and, for the nk new keys' splits inside the commit,
#     nk x (a new leaf + a pointer-table block) reserved, + the indirects when those blocks need ones not yet dirty
#     (zfs_wz_mres, zfs_wf_mfit). Refused by name: an
#     external pointer table (its doubling would allocate inside the commit, unbudgeted — ~10^5 ids); (B8 review) a
#     shape zfs_wz_kind refuses — HERE, at admission (it fell through to "nothing to reserve", and the commit's
#     zap_increment then refused it inside the commit: the pool read-only)
# 0 / -1 named.
fn zfs_wz_urs(dse, ids, nk) {
    var fl = load64(dse + 104);
    if ((fl & 1) == 0) { return 0; }
    if (zfs_wq_rsv + 6 > ZWK_MAXUQ) { return zfs_wnon("user accounting deltas over ", ZWK_MAXUQ); }
    zfs_wq_rsv = zfs_wq_rsv + 6;
    var os = load64(dse);
    var nz = 2 + ((fl >> 2) & 1);
    var key[24];
    var k = 0;
    while (k < nz) {
        var so = ZWO_USER + k;
        var sd = zfs_wobj_dn(os, so);
        if (sd == 0) { return 0 - 1; }
        zfs_wz_open(os, so, sd);
        var cap = (load64(dse + 120) >> (16 * k)) & 0xFFFF;
        if (cap != 0xFFFF) {
            if (nk <= cap) { cap = cap - nk; }
            else {
                if (zfs_wz_upgrade() != 0) { return 0 - 1; }
                cap = 0xFFFF;
            }
            store64(dse + 120, (load64(dse + 120) & ~(0xFFFF << (16 * k))) | (cap << (16 * k)));
        }
        var zk = 0;
        if (cap == 0xFFFF) { zk = zfs_wz_kind(); }
        if (zk < 0) { return 0 - 1; }
        if (zk == 1) {
            var hdr = zfs_zf_blk(0);
            if (hdr == 0) { return 0 - 1; }
            if (load64(hdr + 24) != 0) { return zfs_wno("a user accounting ZAP with an external pointer table (its doubling inside the commit is not budgeted)"); }
            if (ids != 0) {
                var j = 0;
                while (j < 2) {
                    var kl = 0;
                    if (j == 1) {
                        memcpy(&key, "obj-", 4);
                        kl = 4;
                    }
                    kl = kl + zfs_whex(load64(ids + k * 8), &key + kl);
                    var lb = zfs_zf_leafb(hdr, zfs_zf_hash(hdr, &key, kl));
                    if (lb < 0 || zfs_zf_blk(lb) == 0) { return zfs_wz_err(lb); }
                    j = j + 1;
                }
            }
            if (nk > 0) {
                # per new key a split's new leaf and a table block; an indirect chain only when those blocks reach past
                # the L1 the header's own dirtying holds, or past what the levels map (B8 gate: a flat 128 KiB per ZAP
                # put a create in uids — two fat ZAPs — over the arena)
                var ibs = load8(sd + 1);
                var nlv = load8(sd + 2);
                var top = load64(hdr + 56) + 2 * nk;
                var ind = 0;
                if (top > (load8(sd + 3) << ((nlv - 1) * (ibs - 7)))) { ind = nlv * (1 << ibs); }
                elif (nlv >= 2 && ((top - 1) >> (ibs - 7)) != 0) {
                    # (merge, k.107) the commit's new blocks then sit under an indirect no admission dirtied: in a
                    # dataset whose kills can be a snapshot's its predecessor would be deadlisted INSIDE the commit,
                    # uncounted (B9 review's rule, the plan line's dlx=) — refused here, nothing changed
                    if (load64(zfs_dsb(zfs_dsk(dse)) + 48) == 1) { return zfs_wno("a user accounting ZAP growing past its first indirect block in a snapshotted dataset (the commit's deadlist append is not counted)"); }
                    ind = (nlv - 1) * (1 << ibs);
                }
                zfs_wz_mres = zfs_wz_mres + nk * 2 * (1 << zfs_zf_bs) + ind;
            }
        }
        k = k + 1;
    }
    return 0;
}
# --- B10: LOG HYGIENE (design § c.5, D10 (a); WPA § 6.5-6.6; spa_log_spacemap.c / metaslab.c, OpenZFS 2.4.2) -----------
# Every txg leaves a log space map until every metaslab's unflushed txg U has passed it. At the START of txg T —
# before anything of T is allocated or freed, as spa_flush_metaslabs runs before vdev_sync writes T's entries
# (spa.c:10673-10678) — zfs_wl_plan walks the metaslabs in the log system (U != 0) oldest U first, ties by number
# (spa_metaslabs_by_flushed), exactly as spa_flush_metaslabs does (spa_log_spacemap.c:772-866):
#   · a CLEAN one — no entry in a log with txg >= U (the log scan's count, msent +48) — is BUMPED: U = T
#     (metaslab_unflushed_bump, metaslab.c:4044-4077; its space map already holds everything)
#   · a DIRTY one is FLUSHED (metaslab_flush, metaslab.c:4196-4231, zfs_wl_flush): its net unflushed changes — the
#     ALLOCATED (true-state) bitmap against its space map ALONE, replayed strictly into the scratch ZWA_FSB (design
#     § c.5's "which bitmap, and when": no third resident bitmap) — appended to ITS OWN space map as space_map_write
#     writes a range tree (space_map.c:515-760): dbg(ALLOC, pass 1, T) and the ALLOC runs, dbg(FREE, 1, T) and the
#     FREE runs (a type with no run writes no debug word), each run a one-word entry relative to ms_start in ashift
#     units — two words (vdev SM_NO_VDEVID, 0 in its 24 bits) where spacemap_v2 is active and the run passes 2^15
#     units or starts past 2^47 — split at the run maximum, a two-word entry never straddling a block (the pad word);
#     the object grown past dn_maxblkid with the levels it needs (zfs_wf_levels); smp_length; smp_alloc += the net
#     (which must equal the log scan's net, +56); the histogram rewritten EXACTLY from that bitmap (k.68's zfs_wh_exact:
#     the true state before T, which the read-only load of the space map alone sees too — T's own allocations may
#     still LOWER it, zfs_wh_plan judging against this new stored one); then U = T
#   · as many flushes as spa_estimate_metaslabs_to_flush asks (zfs_wl_est — agnos's zfs_unflushed_log_txg_max is
#     ZWL_TXGMAX, the block limit never binds), at least zfs_min_metaslabs_to_flush (1), and past the estimate every
#     metaslab whose U is ZWL_TXGMAX txgs old — so about ZWL_TXGMAX (14) logs outlive a txg, and the design's bound of
#     16 holds across two txgs in a row that cannot flush. A flush the metadata arena (every reservation an admission
#     counts — zfs_wf_mfit — and ZWF_MRSV, the commit's own), the dirty set or the extent list cannot hold waits for a
#     later txg (zfs_wl_skip; OpenZFS's flush is a heuristic too — metaslab_flush returns early while a metaslab
#     loads); what destroying every live log takes is reserved before any U moves (design k.115)
#   · then every log whose txg is below the least U is DESTROYED in T (spa_cleanup_old_sm_logs,
#     spa_log_spacemap.c:911-940 — zfs_wl_kill_logs, called by zfs_wc_plan once log T's object is chosen, so a slot
#     freed in T is not reused in T as dnode_hold's dn_free_txg would refuse it): its blocks freed in log T, its MOS
#     slot zeroed (dnode_sync_free), its log-ZAP entry removed (zap_remove_int — B8's ZAP path), spacemap_histogram
#     - 1 (space_map_free_obj).
# ⭐ A destroyed log's FREEs stay deferred while its txg is inside the deferral window (design § c.2, B11's § b.3: every
# FREE of a log with txg >= zfs_wdef_lo — T0 - 2 at mount, then the last two txgs): such a log becomes a GHOST — its txg,
# its FREE bytes and the dnode bytes that reach its blocks — which zfs_ms_load and zfs_wscan_logs keep reading, so every
# reload — and the op list's read-back — rebuilds the deferred map exactly as before the destruction; zfs_wdef_rel
# releases a ghost's FREEs with its txg's and RETIRES it (the merge, k.133 (a): its blocks, freed in the destroying txg,
# are released two txgs later, after it). B1's rule "a FREE appended to a space map after T0 is deferred" is gone: a
# range allocated and freed between two flushes nets to zero and is in no append (design k.108).
enum ZfsWL {
    ZWL_TXGMAX = 14;                    # agnos's zfs_unflushed_log_txg_max (OpenZFS: 1,000; spa_log_spacemap.c:261): the
    #   design's bound is 16 logs alive (§ c.5), two txgs of slack for a txg too full to flush (k.115)
    ZWL_MAXGHO = 1024;                  # ghost logs (ZWA_GHO); a txg that could not keep its destroyed logs' skips hygiene
    ZWL_GSZ    = 256;                   # a ghost: +0 txg · +8 its FREE bytes · +16 its dnode's first 216 bytes (header,
    #   the one blkptr a log has, the space_map_phys_t's object / length / alloc)
    ZWL_RUN1   = 0x8000;                # SM_RUN_MAX: a one-word entry's longest run, 2^15 units
    ZWL_OFF1   = 0x800000000000;        # 2^47 (SM_OFFSET_BITS): a one-word entry's first offset it cannot hold
    ZWL_RUN2   = 0x1000000000;          # SM2_RUN_MAX: a two-word entry's longest run, 2^36 units
    ZWL_HAR    = 0x60000;               # (B10 review, k.119) HYGIENE'S OWN metadata arena: no admission reaches it
    #   (zfs_wf_alim), so the first flush and every live log's destruction fit whatever the admissions filled — beside
    #   what an op dirties past its last admission check (wr's deferred-kill truncation: 52 KiB) — the arena grew by it
}
var zfs_ngho = 0;            # ghost logs (ZWA_GHO)
var zfs_wl_gmk = 0;          # (the merge, k.133 (a)) ghosts made · ghosts retired by zfs_wdef_rel, since the mount — the op
var zfs_wl_gret = 0;         #   list's `ghost logs:` line holds alive = made - retired <= 3
var zfs_wt_flall = 0;        # (the merge, k.133 (a)) the op list's knob (ZFS_WRITE_OPS only; 0 in production): zfs_wl_plan
#   flushes EVERY dirty metaslab in the log system, so the least U reaches T and logs T - 1 / T - 2 — inside the window —
#   are destroyed: ghosts made and retired on disk (zfs_wtest's last null txg on agnos9)
var zfs_wl_fl[32];           # the open txg's FLUSHED metaslabs, ZWK_MAXMS bits (zfs_wc_pub moves their net into smp_alloc)
var zfs_wl_mu = 0;           # the least U after the walk (0: none in the log system) — logs below it are destroyed
var zfs_wl_nd = 0;           # logs the open txg destroyed: the first zfs_wl_nd of the (ascending) log table
var zfs_wl_nf = 0;           # metaslabs flushed · bumped · flushes whose appended delta was FREEs only · flushes of a
var zfs_wl_nb = 0;           #   metaslab holding a copy of its own space map's appended block · words appended ·
var zfs_wl_fo = 0;           #   1 = a flush did not fit this txg, 2 = the ghost table could not take the logs (the op
var zfs_wl_sf = 0;           #   list's hygiene line prints them)
var zfs_wl_nw = 0;
var zfs_wl_skip = 0;
var zfs_wl_ng = 0;           # (k.27) MOS gang predecessors freed since the mount
var zfs_wl_rb = 0;           # what destroying EVERY live log can take, reserved before any U moves (zfs_wl_plan): dirty
var zfs_wl_rx = 0;           #   blocks (a dnode block each) · FREE extents (their blocks' DVAs) · metadata-arena bytes —
var zfs_wl_rm = 0;           #   so a txg that flushes can always destroy what the flush made obsolete
var zfs_wl_pos = 0;          # the append's cursor (bytes into the space map) · its block · that block's dirty copy · the
var zfs_wl_cb = 0;           #   space map's dirty dnode · its object · its block size
var zfs_wl_buf = 0;
var zfs_wl_dn = 0;
var zfs_wl_so = 0;
var zfs_wl_bsz = 0;

fn zfs_wl_u(i, t) {
    if (zfs_wh_bit(&zfs_wc_pre, i) == 1) { return t; }
    return load64(zfs_msent(i) + 8);
}
# spa_estimate_metaslabs_to_flush (spa_log_spacemap.c:633-716) over agnos's summary — one row per log space map alive
# (lse_txgcount 1, lse_msdcount the DIRTY metaslabs whose U is its txg) — with zfs_unflushed_log_txg_max = ZWL_TXGMAX
# and the incoming rate 0 (an agnos log is one small block; OpenZFS's own `incoming == 0` arm): the most flushes per
# txg any point of the projection needs, at least 1. Called before log T exists (the summary has no row for it yet).
fn zfs_wl_est(t) {
    var avail = ZWL_TXGMAX - zfs_nlogs;
    var fut = 1;
    var tot = 0;
    var mx = 1;
    var k = 0;
    while (k < zfs_nlogs) {
        var lt = load64(zfs_wmem + ZWA_LOG + k * 16);
        if (avail >= 0) {
            var sk = avail + 1;
            avail = avail - sk;
            fut = fut + sk;
        }
        avail = avail + 1;
        var i = 0;
        while (i < zfs_ms_count) {
            var me = zfs_msent(i);
            if (load64(me + 8) == lt && load64(me + 48) != 0 && zfs_wh_bit(&zfs_wc_pre, i) == 0) { tot = tot + 1; }
            i = i + 1;
        }
        var q = (tot + fut - 1) / fut;
        if (q > mx) { mx = q; }
        k = k + 1;
    }
    return mx;
}
# Can the open txg take nb more dirty blocks and nx more extents beside what the commit still adds itself (ZWF_CRSV
# blocks, six extents a block) and the kill list's FREEs (zfs_wfr_x)? 1 / 0.
fn zfs_wl_room(nb, nx) {
    if (zfs_dx_n + nb + ZWF_CRSV > ZWK_MAXDIRTY) { return 0; }
    if (zfs_xl_n + zfs_wfr_x + nx + 6 * (zfs_dx_n + nb + ZWF_CRSV) > ZWK_MAXXL) { return 0; }
    return 1;
}
# zfs_wl_room's question INSIDE zfs_wc_plan (zfs_wl_kill_logs: one more destroyed log, its dnode block dirty and nx FREE
# extents, gx a gang predecessor's excess): the dataset phase is done — its ALLOCs and FREEs, the kill list's among
# them, are in zfs_xl_n — so what remains is the MOS: every MOS block dirty now, log T's own, this log's dnode block and
# the ZWF_CRSV the chain and the U block may still add, <= 3 DVAs allocated and <= 3 freed each (zfs_wc_ne's bound).
# zfs_wl_room there counted the dataset phase's blocks twice — six extents for each, beside the extents they already
# made — and on a 2 MiB write txg refused every destroy while the flushes moved U (design k.117). 1 / 0.
fn zfs_wl_kroom(nx, gx) {
    if (zfs_dx_n + 1 + ZWF_CRSV > ZWK_MAXDIRTY) { return 0; }
    var nmo = 2;
    var q = 0;
    while (q < zfs_dx_n) {
        if (load64(zfs_dent(q)) == 0) { nmo = nmo + 1; }
        q = q + 1;
    }
    if (zfs_xl_n + nx + gx + 6 * (nmo + ZWF_CRSV) > ZWK_MAXXL) { return 0; }
    return 1;
}
# The next unit at or past p that is set in x and clear in y (a delta run's start), or -1.
fn zfs_wl_nxt(x, y, p) {
    while (p < zfs_ms_bits) {
        if ((p & 63) == 0 && p + 64 <= zfs_ms_bits) {
            if ((load64(x + (p >> 3)) & (load64(y + (p >> 3)) ^ (0 - 1))) == 0) {
                p = p + 64;
                continue;
            }
        }
        if (((load8(x + (p >> 3)) >> (p & 7)) & 1) == 1 && ((load8(y + (p >> 3)) >> (p & 7)) & 1) == 0) { return p; }
        p = p + 1;
    }
    return 0 - 1;
}
# The first unit past p that is NOT (set in x and clear in y): the run's end.
fn zfs_wl_end(x, y, p) {
    while (p < zfs_ms_bits) {
        if ((p & 63) == 0 && p + 64 <= zfs_ms_bits) {
            if ((load64(x + (p >> 3)) & (load64(y + (p >> 3)) ^ (0 - 1))) == (0 - 1)) {
                p = p + 64;
                continue;
            }
        }
        if (((load8(x + (p >> 3)) >> (p & 7)) & 1) == 0 || ((load8(y + (p >> 3)) >> (p & 7)) & 1) == 1) { return p; }
        p = p + 1;
    }
    return zfs_ms_bits;
}
# Append the word w at the cursor of the space map being flushed: its block dirtied on first use (zfs_wblk — a copy of
# T - 1's, a block past dn_maxblkid a new one, the levels it needs added, dnode_new_blkid). 0 / -1 named.
fn zfs_wl_put(w) {
    var bi = zfs_wl_pos / zfs_wl_bsz;
    if (bi != zfs_wl_cb) {
        var dn = zfs_wl_dn;
        if (bi > load64(dn + 16)) {
            if (zfs_wf_levels(dn, 0, zfs_wl_so, bi) != 0) { return 0 - 1; }
            store64(dn + 16, bi);
        }
        var e = zfs_wblk(dn, 0, zfs_wl_so, 0, bi);
        if (e < 0) { return 0 - 1; }
        zfs_wl_buf = zfs_dirty_buf(e);
        zfs_wl_cb = bi;
    }
    store64(zfs_wl_buf + zfs_wl_pos % zfs_wl_bsz, w);
    zfs_wl_pos = zfs_wl_pos + 8;
    return 0;
}
# One type of a flush's delta — ty 0 ALLOC: units set in x (the allocated bitmap) and clear in y (the space map alone);
# ty 1 FREE: x, y swapped — as space_map_write_impl writes a range tree (space_map.c:690-748): a debug word, then each
# maximal run as one-word entries, or two-word ones (v2: spacemap_v2 active) when it starts past 2^47 or runs past 2^15
# units. put 0: count the words into zfs_wl_nw (no pad words: the caller's budget adds one a block); 1: append them —
# each run encoded by zfs_wenc.cyr's zfs_sm_seg (space_map_write_seg: split at the entry's run maximum, a two-word entry
# never straddling a block — the pad word — host-proven on gate 37), staged at the cursor's absolute offset so its
# block-end test is the space map's, then copied in (zfs_wl_put). The units of the type, or -1 named.
fn zfs_wl_type(x, y, ty, t, v2, put) {
    var p = zfs_wl_nxt(x, y, 0);
    if (p < 0) { return 0; }
    var units = 0;
    if (put == 1) {
        if (zfs_wl_put(zfs_sm_dbg(ty, 1, t)) != 0) { return 0 - 1; }
    } else { zfs_wl_nw = zfs_wl_nw + 1; }
    while (p >= 0) {
        var q = zfs_wl_end(x, y, p);
        var n = q - p;
        units = units + n;
        var two = 0;
        if (v2 == 1 && (p >= ZWL_OFF1 || n > ZWL_RUN1)) { two = 1; }
        if (put == 0) {
            if (two == 1) { zfs_wl_nw = zfs_wl_nw + 2 * ((n + ZWL_RUN2 - 1) / ZWL_RUN2); }
            else { zfs_wl_nw = zfs_wl_nw + (n + ZWL_RUN1 - 1) / ZWL_RUN1; }
        } else {
            # <= 128 one-word pieces (a run of 2^22 units, the largest bitmap, without spacemap_v2) or a pad + 2 words
            var stg[1040];
            var p0 = zfs_wl_pos;
            var nl = zfs_sm_seg(&stg - p0, p0, p0 + 1040, zfs_wl_bsz, ty, p, n, 0, 1 + two);
            if (nl < p0) { return zfs_wnon("flush: a space map entry it cannot encode, at unit ", p); }
            var o = 0;
            while (o < nl - p0) {
                if (zfs_wl_put(load64(&stg + o)) != 0) { return 0 - 1; }
                o = o + 8;
            }
        }
        p = zfs_wl_nxt(x, y, q);
    }
    return units;
}
# ⭐ metaslab_flush of metaslab i in txg t (the section header): 0 flushed — its delta appended and U = T (an empty
# delta appends nothing, as space_map_write returns on an empty tree) · 1 the txg cannot hold it, nothing changed · -1
# named. ⚠ Loads metaslab i (zfs_ms_load's side effects). dry 1 (zfs_wl_hres): only its cost — zfs_wl_cnb dirty blocks,
# zfs_wl_cneed arena bytes, 0 0 for an empty delta — nothing changed, 0 / -1 named.
fn zfs_wl_flush(i, t, dry) {
    zfs_wl_cnb = 0;
    zfs_wl_cneed = 0;
    var me = zfs_msent(i);
    var so = load64(me);
    var sd[512];
    if (so == 0 || zfs_dnode(zfs_mem + ZR_MOS, so, &sd) != 0) { return zfs_wnon("space map unreadable ms ", i); }
    var bsz = load16(&sd + 8) << 9;
    var len = load64(zfs_bonus(&sd) + 8);
    if (load8(&sd) != ZWK_SM || load8(&sd + 4) != ZWK_SMHDR || load16(&sd + 10) < 24 || bsz < 512 || len < 0 || (len & 7) != 0) { return zfs_wnon("a space map of another shape: ms ", i); }
    var s = zfs_ms_load(i);
    if (s < 0) { return 0 - 1; }
    var x = zfs_bm_a(s);
    var y = zfs_wmem + ZWA_FSB;
    memset(y, 0, zfs_bm_bytes);
    zfs_ws_log = 0;
    zfs_ws_ms = i;
    zfs_ws_abm = y;
    zfs_ws_dbm = y;
    if (zfs_wsm_walk(&sd) != 0) { return zfs_wnon("space map inconsistent ms ", i); }
    var v2 = (zfs_w_feat >> 1) & 1;
    zfs_wl_nw = 0;
    var ua = zfs_wl_type(x, y, 0, t, v2, 0);
    var uf = zfs_wl_type(y, x, 1, t, v2, 0);
    var net = (ua - uf) << zfs_ashift;
    # the bitmap's delta IS the logs' net since U (metaslab_flush writes ms_unflushed_allocs / _frees, which the log
    # replay built from those entries, spa_log_spacemap.c:1110-1122)
    if (net != load64(me + 56)) { return zfs_wnon("flush: the delta differs from the unflushed net, ms ", i); }
    var nw = zfs_wl_nw;
    if (nw > 0) {
        # what the append dirties: every block from the cursor's to the last word's (a pad word per block crossed at
        # worst), the indirect path and any new level, the dnode block — beside the commit's own (ZWF_MRSV)
        var by = nw * 8;
        var b0 = len / bsz;
        var b1 = (len + by + 8 * (by / bsz + 2) - 1) / bsz;
        var un = 1 << zfs_ashift;
        var nb = b1 - b0 + 2;
        var need = (b1 - b0 + 1) * ((bsz + un - 1) & (0 - un)) + 0x4000;
        if (load8(&sd + 2) > 1 || b1 > load64(&sd + 16)) {
            var nl = zfs_wf_nlev(&sd, b1);
            need = need + nl * (1 << load8(&sd + 1));
            nb = nb + nl;
        }
        if (dry == 1) {
            zfs_wl_cnb = nb;
            zfs_wl_cneed = need;
            return 0;
        }
        if (zfs_wf_mfit(need + zfs_wl_rm) == 0 || zfs_wl_room(nb + zfs_wl_rb, zfs_wl_rx) == 0) {
            # (B10 review) why it waits, for the op list's hygiene line: the arena in use, what the flush and the
            # destroys ask, the extent list's room (1 / 0)
            zfs_wl_wu = zfs_dx_meta + zfs_wfb_meta(zfs_wfb_q) + zfs_wz_mres + zfs_wdl_meta();
            zfs_wl_wn = need + zfs_wl_rm;
            zfs_wl_wr = zfs_wl_room(nb + zfs_wl_rb, zfs_wl_rx);
            return 1;
        }
        var dn = zfs_wmos_dn(so);
        if (dn == 0) { return 0 - 1; }
        zfs_wl_dn = dn;
        zfs_wl_so = so;
        zfs_wl_bsz = bsz;
        zfs_wl_pos = len;
        zfs_wl_cb = 0 - 1;
        if (zfs_wl_type(x, y, 0, t, v2, 1) < 0 || zfs_wl_type(y, x, 1, t, v2, 1) < 0) { return 0 - 1; }
        var b = zfs_bonus(dn);
        store64(b, so);
        store64(b + 8, zfs_wl_pos);
        store64(b + 16, load64(b + 16) + net);
        if (load16(dn + 10) >= ZWK_SMV1) {
            var h[256];
            if (zfs_wh_exact(i, &h) != 0) { return 0 - 1; }
            memcpy(b + 64, &h, 256);
        }
        # § c.5's second case: a copy of the block the append starts in lies in metaslab i itself — the COW frees it in
        # log T, which replays for i (U = T), while the delta was taken before
        var e0 = zfs_dirty_find(0, so, 0, b0);
        var pbp = 0;
        if (e0 >= 0) { pbp = zfs_wpbp(e0); }
        if (pbp != 0 && zfs_bp_hole(pbp) == 0) {
            var d = 0;
            var hit = 0;
            while (d < 3) {
                var w1 = load64(pbp + d * 16 + 8);
                if ((load64(pbp + d * 16) != 0 || w1 != 0) && (((w1 & ZWK_OFF63) << 9) >> zfs_ms_shift) == i) { hit = 1; }
                d = d + 1;
            }
            zfs_wl_sf = zfs_wl_sf + hit;
        }
        if (ua == 0) { zfs_wl_fo = zfs_wl_fo + 1; }
        zfs_wl_nw = nw;
    }
    if (dry == 1) { return 0; }
    zfs_wh_set1(&zfs_wl_fl, i);
    zfs_wh_set1(&zfs_wc_pre, i);
    zfs_wl_nf = zfs_wl_nf + 1;
    return 0;
}
# What destroying EVERY live log takes: zfs_wl_rb dirty blocks (a dnode block each, counted once per distinct block) ·
# zfs_wl_rx FREE extents (its blocks' DVAs) · zfs_wl_rm metadata-arena bytes (a dnode block each). 0 / -1 named.
fn zfs_wl_rsv() {
    var per = load16(zfs_mem + ZR_MOS + 8);
    if (per < 1) { return zfs_wno("MOS meta-dnode unreadable"); }
    zfs_wl_rb = 0;
    zfs_wl_rx = 0;
    var k = 0;
    while (k < zfs_nlogs) {
        var lo = load64(zfs_wmem + ZWA_LOG + k * 16 + 8);
        var j = 0;
        var dup = 0;
        while (j < k) {
            if (load64(zfs_wmem + ZWA_LOG + j * 16 + 8) / per == lo / per) { dup = 1; }
            j = j + 1;
        }
        if (dup == 0) { zfs_wl_rb = zfs_wl_rb + 1; }
        var cd[512];
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(zfs_wmem + ZWA_LOG + k * 16 + 8), &cd) != 0 || load8(&cd + 3) != 1) { return zfs_wnon("log space map unreadable, txg ", load64(zfs_wmem + ZWA_LOG + k * 16)); }
        var c[128];
        memcpy(&c, &cd + 64, 128);
        var nx = zfs_wl_ndva(&c, load8(&cd + 2) - 1);
        if (nx < 0) { return 0 - 1; }
        zfs_wl_rx = zfs_wl_rx + nx;
        k = k + 1;
    }
    zfs_wl_rm = zfs_wl_rb * (per << 9);
    return 0;
}
# ⭐ (B10 review, k.119) HYGIENE'S MINIMUM for txg t, held back by every admission of t outside the commit (zfs_wf_alim,
# zfs_wf_xfit), so a txg its admissions fill to a bound (a long truncation, a k.63 drain, a deferred-kill run) still
# moves U: destroying every live log (zfs_wl_rsv) and the FIRST flush zfs_wl_plan tries in t — the dirty metaslab of
# least U < t, the lowest index among equals (a clean one before it is a bump, free; k.24's preset counted) — at its
# exact cost (zfs_wl_flush dry: nothing of t is allocated or freed before its commit, so the delta measured now is the
# one the commit appends). The ARENA side is hygiene's own (ZWL_HAR, no admission reaches it); the EXTENT side is held
# back by every admission (zfs_wf_xfit: 6 x zfs_wl_hb + zfs_wl_hx). A first flush whose arena passes ZWL_HAR (or whose
# extents pass half the list) is not held — it waits for a txg light enough, as before; zfs_wl_hm is reported (rsv=). Called with the reader at t - 1: the rw mount and each
# publish; its load is not the txg's (zfs_ms_nload kept). 0 / -1 named (the minimum then 0: zfs_wl_plan names the same
# failure in the commit).
fn zfs_wl_hres(t) {
    zfs_wl_hb = 0;
    zfs_wl_hx = 0;
    zfs_wl_hm = 0;
    if (zfs_rw != 1) { return 0; }
    if (zfs_wl_rsv() != 0) { return 0 - 1; }
    var best = 0 - 1;
    var bu = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        var me = zfs_msent(i);
        var u = load64(me + 8);
        if (zfs_wc_first == 1 && load64(me) != 0 && u == 0) { u = t; }
        if (u != 0 && zfs_wugt(t, u) == 1 && load64(me + 48) != 0 && (best < 0 || zfs_wugt(bu, u) == 1)) {
            best = i;
            bu = u;
        }
        i = i + 1;
    }
    var nb = 0;
    var nm = 0;
    if (best >= 0) {
        var nl = zfs_ms_nload;
        var r = zfs_wl_flush(best, t, 1);
        zfs_ms_nload = nl;
        if (r != 0) { return 0 - 1; }
        nb = zfs_wl_cnb;
        nm = zfs_wl_cneed;
        if (zfs_wl_rm + nm > ZWL_HAR || 6 * (nb + zfs_wl_rb) + zfs_wl_rx > ZWK_MAXXL / 2) {
            nb = 0;
            nm = 0;
        }
    }
    zfs_wl_hb = zfs_wl_rb + nb;
    zfs_wl_hx = zfs_wl_rx;
    zfs_wl_hm = zfs_wl_rm + nm;
    if (6 * zfs_wl_hb + zfs_wl_hx > ZWK_MAXXL / 2) {
        zfs_wl_hb = 0;
        zfs_wl_hx = ZWK_MAXXL / 2;
    }
    return 0;
}
# ⭐ spa_flush_metaslabs at the start of txg t (the section header): bump / flush in U order, then the least U the logs
# below which zfs_wl_kill_logs destroys. Before the dataset phase: nothing of T is allocated or freed yet (zfs_commit1
# refuses extents before it). 0 / -1 named.
fn zfs_wl_plan(t) {
    zfs_wl_nd = 0;
    zfs_wl_nf = 0;
    zfs_wl_nb = 0;
    zfs_wl_fo = 0;
    zfs_wl_sf = 0;
    zfs_wl_skip = 0;
    zfs_wl_mu = 0;
    zfs_wl_nw = 0;
    zfs_wl_wu = 0;
    zfs_wl_wn = 0;
    zfs_wl_wr = 0;
    var nw = 0;
    memset(&zfs_wl_fl, 0, 256);
    # every log could end destroyed below the new least U: the ghost table must hold the ones that carry deferral
    if (zfs_ngho + zfs_nlogs > ZWL_MAXGHO) {
        zfs_wl_skip = 2;
        return 0;
    }
    # OpenZFS never leaves a log older than every U (spa_cleanup_old_sm_logs runs in the txg the last U passes it): so
    # what destroying every live log takes — its dnode block, its blocks' DVAs as FREE extents — is reserved first, and a
    # txg that cannot hold it moves no U at all (skip 3) — every admission held it back (zfs_wl_hres, k.119)
    if (zfs_wl_rsv() != 0) { return 0 - 1; }
    if (zfs_wf_mfit(zfs_wl_rm) == 0 || zfs_wl_room(zfs_wl_rb, zfs_wl_rx) == 0) {
        zfs_wl_skip = 3;
        return 0;
    }
    var want = zfs_wl_est(t);
    var seen[256];
    memset(&seen, 0, 256);
    while (1 == 1) {
        var best = 0 - 1;
        var bu = 0;
        var i = 0;
        while (i < zfs_ms_count) {
            var u = zfs_wl_u(i, t);
            if (u != 0 && zfs_wugt(t, u) == 1 && zfs_wh_bit(&seen, i) == 0 && (best < 0 || zfs_wugt(bu, u) == 1)) {
                best = i;
                bu = u;
            }
            i = i + 1;
        }
        if (best < 0) { break; }
        if (want == 0 && zfs_wt_flall == 0 && zfs_wugt(bu + ZWL_TXGMAX, t) == 1) { break; }
        zfs_wh_set1(&seen, best);
        if (load64(zfs_msent(best) + 48) == 0) {
            zfs_wh_set1(&zfs_wc_pre, best);
            zfs_wl_nb = zfs_wl_nb + 1;
        } else {
            var r = zfs_wl_flush(best, t, 0);
            if (r < 0) { return 0 - 1; }
            if (r == 1) {
                zfs_wl_skip = 1;
                break;
            }
            nw = nw + zfs_wl_nw;
            if (want > 0) { want = want - 1; }
        }
    }
    zfs_wl_nw = nw;
    var mu = 0;
    var j = 0;
    while (j < zfs_ms_count) {
        var v = zfs_wl_u(j, t);
        if (v != 0 && (mu == 0 || zfs_wugt(mu, v) == 1)) { mu = v; }
        j = j + 1;
    }
    zfs_wl_mu = mu;
    return 0;
}
# The DVAs of the tree under bp (level lv of a MOS object: a log's), indirects read through the reader. Count / -1.
fn zfs_wl_ndva(bp, lv) {
    if (zfs_bp_hole(bp) == 1 || ((load64(bp + 48) >> 39) & 1) == 1) { return 0; }
    var n = 0;
    if ((load64(bp + 8) >> 63) == 1) {
        n = zfs_wgang(bp, 0, 0);
        if (n < 0) { return 0 - 1; }
    } else {
        var d = 0;
        while (d < 3) {
            if (load64(bp + d * 16) != 0 || load64(bp + d * 16 + 8) != 0) { n = n + 1; }
            d = d + 1;
        }
    }
    if (lv > 0) {
        var c[128];
        var k = 0;
        while (k < zfs_bp_lsize(bp) / 128) {
            var ib = zfs_mc_get(bp);
            if (ib == 0) { return zfs_wno("log space map indirect unreadable"); }
            memcpy(&c, ib + k * 128, 128);
            var m = zfs_wl_ndva(&c, lv - 1);
            if (m < 0) { return 0 - 1; }
            n = n + m;
            k = k + 1;
        }
    }
    return n;
}
# Every block of the tree under bp (a STABLE copy, level lv) killed in T — children first (dnode_sync_free_range over the
# whole object) — as the MOS kills (zfs_wc_kill: freed, $MOS debited; no dnode to charge: the object goes). 0 / -1 / -2.
fn zfs_wl_kill(bp, lv) {
    if (zfs_bp_hole(bp) == 1) { return 0; }
    if (lv > 0 && ((load64(bp + 48) >> 39) & 1) == 0) {
        var c[128];
        var k = 0;
        while (k < zfs_bp_lsize(bp) / 128) {
            var ib = zfs_mc_get(bp);
            if (ib == 0) { return zfs_wno("log space map indirect unreadable"); }
            memcpy(&c, ib + k * 128, 128);
            var r = zfs_wl_kill(&c, lv - 1);
            if (r != 0) { return r; }
            k = k + 1;
        }
    }
    return zfs_wc_kill(0, bp);
}
# spa_cleanup_old_sm_logs (spa_log_spacemap.c:911-940) in txg t: every log whose txg is below zfs_wl_mu — the first of
# the ascending log table — DESTROYED (space_map_free_obj + zap_remove_int): a GHOST kept first when its txg is inside
# the deferral window, >= zfs_wdef_lo (the section header; the merge, k.133 (a)), its tree killed in T, its slot zeroed, its log-ZAP entry removed, spacemap_histogram - 1 (its
# bonus is a space_map_phys_t's: space_map_free_obj's doi_bonus_size != SPACE_MAP_SIZE_V0). zfs_wc_plan calls it once
# log T's object is chosen. A log the txg's extent list cannot hold fails the commit by name: zfs_wl_plan reserved its
# destruction before any U moved (B10 review, k.121). 0 / -1 named.
fn zfs_wl_kill_logs(t) {
    if (zfs_wl_mu == 0) { return 0; }
    var gx = zfs_wgang_xs(0);
    if (gx < 0) { return 0 - 1; }
    var ffw = 0;
    while (zfs_wl_nd < zfs_nlogs) {
        var lg = zfs_wmem + ZWA_LOG + zfs_wl_nd * 16;
        var lt = load64(lg);
        var lo = load64(lg + 8);
        if (zfs_wugt(zfs_wl_mu, lt) == 0) { break; }
        var cd[512];
        if (zfs_dnode(zfs_mem + ZR_MOS, lo, &cd) != 0 || load8(&cd) != ZWK_SM || load8(&cd + 4) != ZWK_SMHDR || load16(&cd + 10) != ZWK_SMV1 || load8(&cd + 3) != 1) { return zfs_wnon("log space map unreadable, txg ", lt); }
        var nx = 0;
        var c[128];
        memcpy(&c, &cd + 64, 128);
        nx = zfs_wl_ndva(&c, load8(&cd + 2) - 1);
        if (nx < 0) { return 0 - 1; }
        # zfs_wl_plan reserved every live log's destruction before any U moved (and every admission held it back,
        # zfs_wl_hres): a destroy that does not fit is that reservation failing — named, the commit fails (B10 review,
        # k.121). A log left older than every U would be legal for OpenZFS's import (its first sync's cleanup destroys
        # it), but OpenZFS's own sync never leaves one, and the oracles (zfs-wms-check.py, A3y) hold the image to that
        if (zfs_wl_kroom(nx, gx) == 0) { return zfs_wnon("log destroy: the reserved room did not hold, txg ", lt); }
        if (lt >= zfs_wdef_lo) {                      # (the merge, k.133 (a)) inside B11's window, not T0 - 2's
            if (zfs_ngho >= ZWL_MAXGHO) { return zfs_wno("ghost log table full"); }
            zfs_ws_log = 1;
            zfs_ws_ms = zfs_ms_count;
            zfs_ws_lt = lt;
            zfs_ws_app = 0;
            zfs_ws_def = 0;
            if (zfs_wsm_walk(&cd) != 0) { return zfs_wnon("log space map inconsistent, txg ", lt); }
            var g = zfs_wmem + ZWA_GHO + zfs_ngho * ZWL_GSZ;
            memset(g, 0, ZWL_GSZ);
            store64(g, lt);
            store64(g + 8, zfs_ws_f);
            memcpy(g + 16, &cd, 216);
            zfs_ngho = zfs_ngho + 1;
            zfs_wl_gmk = zfs_wl_gmk + 1;
        }
        var dn = zfs_wmos_dn(lo);
        if (dn == 0) { return 0 - 1; }
        var r = zfs_wl_kill(&c, load8(dn + 2) - 1);
        if (r != 0) { return 0 - 1; }
        ffw = ffw + 1;
        memset(dn, 0, 512);
        var key[24];
        var kl = zfs_whex(lt, &key);
        var lz = zfs_wmos_dn(zfs_w_lzo);
        if (lz == 0) { return 0 - 1; }
        zfs_wz_open(0, zfs_w_lzo, lz);
        var ev[8];
        if (zfs_wz_op(2, &key, kl, 8, 1, &ev) != 0) { return 0 - 1; }
        zfs_wl_nd = zfs_wl_nd + 1;
    }
    if (ffw > 0) {
        var fd = zfs_wmos_dn(zfs_w_ffw);
        if (fd == 0) { return 0 - 1; }
        var e = zfs_wblk(fd, 0, zfs_w_ffw, 0, 0);
        if (e < 0) { return 0 - 1; }
        var p = zfs_mz_find(zfs_dirty_buf(e), load64(zfs_dent(e) + 32), "com.delphix:spacemap_histogram", 30);
        if (p == 0 || load64(p) < ffw) { return zfs_wno("features_for_write has no spacemap_histogram to decrement"); }
        store64(p, load64(p) - ffw);
    }
    return 0;
}

# --- k.27 (B10): a MOS GANG predecessor freed in its txg, tree and all ------------------------------------------------
# OpenZFS frees it in the same sync: dsl_free -> zio_free puts a gang BP on spa_free_bplist (zio.c:1422-1456), which
# spa_sync_iterate_to_convergence drains in the same txg while log_spacemap is active (spa_sync_frees, spa.c:10655 —
# no deferral to the next txg: that is the pre-log_spacemap spa_deferred_bpobj path); zio_free_sync walks the gang tree
# (zio_gang_tree_issue): each header DVA is freed at vdev_gang_header_asize (vdev.h:150 — 512 rounded to the allocation
# unit: 1 << ashift on a disk vdev; metaslab_free_dva, metaslab.c:5801-5803), every child BP's DVAs, a nested header's
# tree. A MOS DEDUP block stays refused (the MOS has none; the DDT would hold its references), so does a tree deeper
# than the reader's own bound (zfs_gang_read: 2). mode 0 checks and counts — every header read and verified (its
# embedded checksum as zfs_gang_read verifies it: ashift-sized, else the legacy 512 B; EVERY copy against DVA[0]'s vdev
# and offset and the physical birth — zio_checksum_gang_verifier's BP_IDENTITY, B10 review k.120), nothing changed; mode 1 frees
# (zfs_wfree_ext / zfs_wfree_bp: each extent allocated, cleared, deferred, a FREE of log T). Extents / -1 named / -2
# inconsistent. Header copies: ZWA_CMP + depth x 64 KiB (free outside a block's build: the commit kills a predecessor
# after its successor is written).
fn zfs_wgang(bp, depth, mode) {
    if (depth >= 2) { return zfs_wno("a gang tree deeper than the reader's bound (2)"); }
    var pr = load64(bp + 48);
    if (((pr >> 62) & 1) == 1) { return zfs_wno("free of a MOS dedup block (the DDT holds it: not built)"); }
    if (((pr >> 61) & 1) == 1) { return zfs_wno("free of an encrypted block"); }
    var pb = load64(bp + 72);
    if (pb == 0) { pb = load64(bp + 80); }
    if (zfs_wugt(zfs_txg + 1, pb) == 0) { return zfs_wnon("free of a block born in the open txg: birth ", pb); }
    var un = 1 << zfs_ashift;
    var hdr = zfs_wmem + ZWA_CMP + depth * 0x10000;
    var gs = 0;
    var n = 0;
    var d = 0;
    while (d < 3) {
        var w0 = load64(bp + d * 16);
        var w1 = load64(bp + d * 16 + 8);
        if (w0 != 0 || w1 != 0) {
            if ((w1 >> 63) == 0) { return zfs_wno("a gang BP with a DVA that is not a gang header"); }
            var off = (w1 & ZWK_OFF63) << 9;
            if (gs == 0) {
                var gt = un;
                while (gt >= 512 && gs == 0) {
                    if (zfs_rd(off + ZK_DATA0, gt, hdr) == 0 && zfs_eck_ok(hdr, gt, load64(bp) >> 32, (load64(bp + 8) & ZWK_OFF63) << 9, pb) == 1) { gs = gt; }
                    if (gt == 512) { gt = 0; } else { gt = 512; }
                }
            }
            if (mode == 1) {
                var r = zfs_wfree_ext(off, un);
                if (r != 0) { return r; }
            }
            n = n + 1;
        }
        d = d + 1;
    }
    if (gs == 0) { return zfs_wno("gang header unreadable"); }
    var k = 0;
    while (k < (gs - 40) / 128) {
        var c[128];
        memcpy(&c, hdr + k * 128, 128);
        if (zfs_bp_hole(&c) == 0) {
            if (((load64(&c + 48) >> 39) & 1) == 1) { return zfs_wno("an embedded gang child"); }
            if ((load64(&c + 8) >> 63) == 1) {
                var m = zfs_wgang(&c, depth + 1, mode);
                if (m < 0) { return m; }
                n = n + m;
            } else {
                if (mode == 1) {
                    var r2 = zfs_wfree_bp(&c);
                    if (r2 != 0) { return r2; }
                }
                var e = 0;
                while (e < 3) {
                    if (load64(&c + e * 16) != 0 || load64(&c + e * 16 + 8) != 0) { n = n + 1; }
                    e = e + 1;
                }
            }
        }
        k = k + 1;
    }
    return n;
}
# One extent [off, off + asz) of the device freed in T — a gang header's (zfs_wgang): zfs_wfree_bp's rule for one DVA
# (inside one metaslab with a space map, every unit allocated; cleared, newly-deferred units counted, a FREE extent).
# 0 · -1 refused, nothing changed · -2 inconsistent.
fn zfs_wfree_ext(off, asz) {
    var i = off >> zfs_ms_shift;
    if (asz <= 0 || ((off | asz) & ((1 << zfs_ashift) - 1)) != 0) { return zfs_wno("free of a malformed extent"); }
    if (i >= zfs_ms_count || off + asz > (i + 1) << zfs_ms_shift) { return zfs_wno("free of an extent outside one metaslab"); }
    if (load64(zfs_msent(i)) == 0) {
        zfs_wnon("free in a metaslab without a space map: ms ", i);
        return 0 - 2;
    }
    if (zfs_xl_n + 1 > ZWK_MAXXL) { return zfs_wnon("txg extent list full: extents ", zfs_xl_n); }
    var s = zfs_ms_load(i);
    if (s < 0) { return 0 - 2; }
    var abm = zfs_bm_a(s);
    var dbm = abm + zfs_bm_bytes;
    var b = (off - (i << zfs_ms_shift)) >> zfs_ashift;
    var n = asz >> zfs_ashift;
    var pre = zfs_bm_cnt(dbm, b, n);
    if (zfs_wxl_add(off, asz, 1, pre) != 0) { return 0 - 1; }
    if (zfs_bm_op(abm, b, n, 0) != 0) {
        zfs_xl_n = zfs_xl_n - 1;
        zfs_wnon("free of unallocated space, ms ", i);
        return 0 - 2;
    }
    zfs_bm_op(dbm, b, n, 2);
    var me = zfs_msent(i);
    store64(me + 24, load64(me + 24) - asz);
    store64(me + 32, load64(me + 32) + ((n - pre) << zfs_ashift));
    zfs_tx_free = zfs_tx_free + asz;
    return 0;
}
# The extents beyond three the kills of the MOS blocks dirty at entries [from, zfs_dx_n) record when a predecessor is a
# GANG tree (zfs_wgang mode 0) — log T's size bound counts three a block (zfs_wc_plan, zfs_wh_grow). Excess / -1 named.
fn zfs_wgang_xs(from) {
    var xs = 0;
    var k = from;
    while (k < zfs_dx_n) {
        if (load64(zfs_dent(k)) == 0) {
            var pbp = zfs_wpbp(k);
            if (pbp == 0) { return 0 - 1; }
            if (zfs_bp_hole(pbp) == 0 && ((load64(pbp + 48) >> 39) & 1) == 0 && (load64(pbp + 8) >> 63) == 1) {
                var n = zfs_wgang(pbp, 0, 0);
                if (n < 0) { return 0 - 1; }
                if (n > 3) { xs = xs + n - 3; }
            }
        }
        k = k + 1;
    }
    return xs;
}

# --- k.63 (B10, DECIDED): agnos DRAINS the objects its own lazy unlinks put on a DELETE_QUEUE --------------------------
# FreeBSD frees every unlinked object through the queue: zfs_remove_ -> zfs_unlinked_add, and at the vnode's last release
# (or zfs_unlinked_drain at the next mount) zfs_rmnode (zfs_dir.c:420-560): dmu_free_long_range over the data — chunk
# after chunk, each its own tx — then ONE tx frees the dnode, removes the queue's entry and (with ZPL_XATTR) queues the
# extended-attribute directory. agnos's lazy path (design § f.5) queues an object whose free does not fit one txg; the
# op that queued it drains it in the txgs after its own (zfs_wu_end -> zfs_wq_obj, fs_lock released between them), one
# txg a step (zfs_wq_one): the object freed whole with its entry removed when that fits (zfs_wu_free), else a bounded
# part of its data from the top (B5's truncation, zfs_wf_trunc1 — zfs_rmnode's dmu_free_long_range; the object stays
# queued) and again. A mount drains nothing (G1: a mount writes not one byte); OpenZFS's next writable mount drains what
# is left (zfs_unlinked_drain). Refused by name, the object staying queued: an object holding an extended-attribute
# directory (zfs_rmnode's purge — FreeBSD queues the directory and purges its entries one tx each — is not built), a
# directory too big for one txg, LINKS != 0 (agnos queues only unlinked objects), a read-only pool or dataset.
var zfs_wq_auto = 1;         # 1 = an op that queued an object drains it after its own txg (production); the op list holds
#   it at 0 around B7's knob-forced lazy unlinks, whose entries OpenZFS's own drain judges in the guest
var zfs_wq_lzo = 0;          # the object the open op put on the DELETE_QUEUE (zfs_wu_lazy) · its dataset slot
var zfs_wq_lzd = 0;
var zfs_wq_nt = 0;           # the txgs of the last zfs_wq_obj · steps that freed a part of the data first
var zfs_wq_np = 0;
var zfs_wq_tight = 0;        # the op list's knob (ZFS_WRITE_OPS only; 0 in production): zfs_wu_tight's value during a
#   drain step's free — 1 sends even a one-block file through the bounded-part path ON DISK
# ONE drain step of object obj of dataset slot di (step 0: the first — a truncation then judges its whole range first,
# zfs_wf_okscan). 0 freed, its entry removed · 1 a part of its data freed (more steps) · -1 named (it stays queued).
fn zfs_wq_one(di, obj, step) {
    if (zfs_rw != 1 || zfs_wmem == 0) { return zfs_wno("pool read-only"); }
    var ds = zfs_ds(di);
    if (load64(ds + 1016) != 1) { return zfs_wno("dataset read-only"); }
    var mn = zfs_wdn(2);
    var dq = 0;
    if (zfs_dnode(ds, 1, mn) != 0 || zfs_wzu64(mn, "DELETE_QUEUE", &dq) != 1 || dq < 1) { return zfs_wno("no DELETE_QUEUE"); }
    var key[24];
    memset(&key, 0, 24);
    var kl = zfs_whex(obj, &key);
    var qn = zfs_wdn(3);
    var v = 0;
    if (zfs_dnode(ds, dq, qn) != 0 || load8(qn) != 22 || zfs_wzu64(qn, &key, &v) != 1 || v != obj) { return zfs_wnon("not on its DELETE_QUEUE: object ", obj); }
    memset(&zfs_wu_s, 0, 128);
    zfs_wu_set(0, 0, di);
    var dse = zfs_wu_begin();
    if (dse == 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    var os = load64(dse);
    var dn = zfs_wos_dn(os, obj);
    if (dn == 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    var ty = load8(dn);
    var r = 0;
    var lo = zfs_wc_pat(di, dn, 11, 8);
    var num = load64(&zfs_wc_an + 16 * 8);
    var xv[16];
    if ((ty != 19 && ty != 20) || load8(dn + 4) != 44) { r = zfs_wnon("not an SA file or directory: type ", ty); }
    elif (lo < 0 || load64(zfs_bonus(dn) + lo) != 0) { r = zfs_wno("a queued object whose LINKS is not 0"); }
    elif (num >= 0 && zfs_sa_attr(di, dn, num, &xv, 16) == 8 && load64(&xv) != 0) { r = zfs_wno("an object holding an extended-attribute directory (zfs_rmnode's purge: not built)"); }
    if (r == 0 && zfs_wu_rsv(dse, dn) != 0) { r = 0 - 1; }
    if (r != 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    var tg = zfs_wu_tight;
    zfs_wu_tight = zfs_wq_tight;
    zfs_wu_n0 = zfs_wfr_n;
    r = zfs_wu_free(dse, obj, dn);
    zfs_wu_tight = tg;
    if (r < 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    if (r == 1) {
        zfs_wf_drop();
        if (ty != 19) { return zfs_wno("a queued directory too big for one txg"); }
        var tr = zfs_wf_trunc1(di, obj, 0, (step == 0));
        if (tr < 0) { return 0 - 1; }
        zfs_wq_np = zfs_wq_np + 1;
        return 1;
    }
    var qd = zfs_wos_dn(os, dq);
    if (qd == 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    zfs_wz_open(os, dq, qd);
    var ev[8];
    if (zfs_wz_op(2, &key, kl, 8, 1, &ev) != 0) {
        zfs_wf_drop();
        return 0 - 1;
    }
    return zfs_wu_end(0);
}
# Drain object obj of dataset slot di (the section header): steps until it is freed, fs_lock released before each
# (zfs_wf_yield — the op's own txg is committed already). 0 freed · -1 named (it stays queued; zfs_wq_nt counts the
# txgs that did commit). The caller holds fs_spin_lock.
fn zfs_wq_obj(di, obj) {
    var t0 = zfs_txg;
    zfs_wq_np = 0;
    var r = 1;
    var n = 0;
    while (r == 1 && n < ZWF_FRMAX) {
        zfs_wf_yield();
        r = zfs_wq_one(di, obj, n);
        n = n + 1;
    }
    zfs_wq_nt = zfs_txg - t0;
    if (r == 0) { return 0; }
    if (r == 1) { return zfs_wno("drain: no end in sight (the step bound)"); }
    return 0 - 1;
}
#ifdef ZFS_WRITE_OPS
var zfs_wf_mode = 0;         # the op list's source: 0 the caller's bytes · 1 agnos-gen-1 of zfs_wf_seed (zfs_wenc.cyr
var zfs_wf_seed = 0;         #   zfs_gen_fill, by FILE offset — any chunking writes the same bytes) · 2 zeros
fn zfs_wf_copy(dst, src, fo, n) {
    if (zfs_wf_mode == 1) { return zfs_gen_fill(zfs_wf_seed, fo, dst, n); }
    if (zfs_wf_mode == 2) {
        memset(dst, 0, n);
        return 0;
    }
    memcpy(dst, src, n);
    return 0;
}
# MTIME / CTIME seconds: the op list's deterministic clock (zfs_wclock's — the images are byte-reproducible).
fn zfs_wf_now() { return zfs_wt_ts0 + zfs_wt_n; }
# A new directory's microzap salt (zfs_wc1): odd and non-zero (mzap_create_impl ORs in 1; zap_micro.c asserts it). The
# op list's is DERIVED from the objset, the object and the txg, so it writes the same bytes on every run — or (B8) its
# knob zfs_wc_fsalt: a salt the list chose names under, so a directory's fat ZAP reaches its pointer-table growth with
# ~400 names (design § h B8, k.75; any odd salt is OpenZFS's own kind of value).
var zfs_wc_fsalt = 0;
fn zfs_wc_salt(os, obj) {
    if (zfs_wc_fsalt != 0) { return zfs_wc_fsalt | 1; }
    var h = os * 0x9E3779B97F4A7C15 + obj * 0xC2B2AE3D27D4EB4F + (zfs_txg + 1) * 0x165667B19E3779F9;
    h = (h ^ (h >> 29)) * 0xBF58476D1CE4E5B9;
    return (h ^ (h >> 32)) | 1;
}
# (B8 review) What the op list's where-line reports, kept in its build only: a new SA layout (zfs_wc_layout) and the
# ZAPs zfs_wz_upgrade upgraded since it last read them.
var zfs_wc_lnew = 0;
var zfs_wz_up = 0;
fn zfs_wc_lnote(num) {
    zfs_wc_lnew = num;
    return 0;
}
fn zfs_wz_upn() {
    zfs_wz_up = zfs_wz_up + 1;
    return 0;
}
#endif
#ifndef ZFS_WRITE_OPS
# The bytes of a write: the caller's (user memory under the syscall's stac, or a kernel buffer).
fn zfs_wf_copy(dst, src, fo, n) {
    memcpy(dst, src, n);
    return 0;
}
# MTIME / CTIME seconds: the agnos clock (ntp_now — the RTC seed or NTP), the mounted uberblock's timestamp when it was
# never set (design § f.1).
fn zfs_wf_now() {
    var t = ntp_now();
    if (t <= 0) { t = load64(zfs_mem + ZR_UB + 32); }
    return t;
}
# A new directory's microzap salt (zfs_wc1): odd and non-zero (mzap_create_impl ORs in 1; zap_micro.c asserts it) and
# UNPREDICTABLE, as OpenZFS's (kernel addresses) is — RDRAND (the TSC where it answers 0) mixed with the objset, the
# object and the txg — so no writer can choose names whose hashes share a prefix and drive a directory's pointer
# table up (B8 review, k.88).
fn zfs_wc_salt(os, obj) {
    var r = rdrand_u64();
    if (r == 0) { r = rdtsc(); }
    var h = r ^ (os * 0x9E3779B97F4A7C15 + obj * 0xC2B2AE3D27D4EB4F + (zfs_txg + 1) * 0x165667B19E3779F9);
    h = (h ^ (h >> 29)) * 0xBF58476D1CE4E5B9;
    return (h ^ (h >> 32)) | 1;
}
fn zfs_wc_lnote(num) { return 0; }
fn zfs_wz_upn() { return 0; }
#endif
# --- B3a's in-memory exercise (ZFS_WRITE_SELFTEST; serial only) ------------------------------------------------------
var zfs_wst_bad = 0;         # 1 = the exercise below failed: the pool is read-only and the op list refuses (zfs_wtest)
#ifdef ZFS_WRITE_SELFTEST
# Run at mount on an rw pool, after the replay dump. It WRITES NOTHING to the device and leaves the allocator exactly as
# it found it — every metaslab's two bitmaps and two counts are digested first and compared after (zfs_wst_dig). The
# read smoke (G1: the pool byte-identical after the boot) and the write smoke boot this kernel:
#   dirty  blocks of the MOS and of a dataset, metadata and data, found again by key; a duplicate refused; the plan
#          puts every dataset block before the MOS and, inside one objset, phases then levels ascending
#   build  a ZLE indirect (3 BPs, then holes; fill from zfs_ind_ready) with 3 copies, a 4 KiB data block with 1, an
#          all-zero indirect replacing a born BP (a hole with birth T under hole_birth) and a never-written one
#          (birth 0) — each BP judged by the READER's code: zfs_ck_ok over the physical bytes, zfs_decomp back to the
#          content, every DVA on this vdev inside a metaslab with a space map and allocated in its bitmap, the 3
#          copies in 3 metaslabs when 3 have room (OpenZFS's ditto rule) — and word 6 field by field (zfs_wst_bpw)
#   free   the new block refused (born in T); the MOS rootbp (born before T) freed with one unit of it ALREADY
#          deferred — what a pool OpenZFS last ran at its slop leaves (zfs_wxl_undo): only the newly deferred units
#          count, the extent records the other — then refused as a free of free space (-2)
#   undo   every extent returned (zfs_wxl_undo) on RESIDENT metaslabs (the one whose FREE met a deferred unit is
#          evicted instead): every metaslab digests as before
#   evict  ONE resident slot (design § c.2's B3a note: nothing is pinned, T's extents are re-applied at every load):
#          the rootbp freed and a unit allocated in the same metaslab X; X evicted by another load and reloaded (its
#          bitmaps and counts byte for byte); a 3-copy allocation in which each DVA's load evicts the metaslab the
#          DVA before it went to, every copy allocated after its reload; that undone with none of the three resident,
#          each reload showing the units free and the counts the undo tracked; then everything undone with no
#          metaslab resident — the tracked counts equal the digests', and every reload digests as before
# Lines: `zfs-wb3: <part> ... ok`, then `zfs-wb3: done ok` — or `zfs-wb3: FAIL <what> ... - pool read-only` and
# nothing after: a failure returns every extent, drops the dirty set and puts the pool READ-ONLY (nothing the exercise
# allocated may reach B3b's first commit), and the op list refuses to run.
# Scratch, all in the data arena past the exercise's one 4 KiB data block: ZWA_OS + 0x200000 the read-back (128 KiB),
# + 0x220000 the digests (ZWK_MAXMS x 48 B), + 0x240000 one metaslab's two bitmaps (<= 1 MiB).
var zfs_wst_slots = 0;       # zfs_bm_slots while the evict stage holds the residency at ONE slot (0 = not held)
fn zfs_wst_evall() { return zfs_ms_evall(); }
fn zfs_wst_uncap() {
    if (zfs_wst_slots == 0) { return 0; }
    zfs_wst_evall();
    zfs_bm_slots = zfs_wst_slots;
    zfs_wst_slots = 0;
    return 0;
}
fn zfs_wst_fail(what) {
    zfs_wxl_undo(0);
    zfs_dirty_reset();
    zfs_wst_uncap();
    zfs_rw = 0;
    var i = 0;
    while (i < zfs_nds) {
        store64(zfs_ds(i) + 1016, 0);
        i = i + 1;
    }
    zfs_wmem_put();
    zfs_wst_bad = 1;
    zfs_wss("zfs-wb3: FAIL ");
    zfs_wss(what);
    if (zfs_wr_lit != 0) {
        zfs_wss(" (");
        zfs_wss(zfs_wr_lit);
        if (zfs_wr_nml > 0) { serial_print(&zfs_wr_nm, zfs_wr_nml); }
        if (zfs_wr_num >= 0) { zfs_wsn(zfs_wr_num); }
        zfs_wss(")");
    }
    zfs_wss(" - pool read-only");
    serial_println("", 0);
    return 0 - 1;
}
# Metaslab i's state as 48 bytes at out: fletcher4 of its two bitmaps (loading it — strict), its allocated and
# deferred counts (+24, +32). 0 / -1.
fn zfs_wst_dig1(i, out) {
    var s = zfs_ms_load(i);
    if (s < 0) { return 0 - 1; }
    zfs_fletcher4(zfs_bm_a(s), zfs_bm_bytes * 2, out);
    store64(out + 32, load64(zfs_msent(i) + 24));
    store64(out + 40, load64(zfs_msent(i) + 32));
    return 0;
}
# Every metaslab digested into the table (put 1) or compared with it (put 0). -1 done / all agree · the first metaslab
# that differs · -2 a load failed.
fn zfs_wst_dig(put) {
    var tab = zfs_wmem + ZWA_OS + 0x220000;
    var d[48];
    var i = 0;
    while (i < zfs_ms_count) {
        if (zfs_wst_dig1(i, &d) != 0) { return 0 - 2; }
        if (put == 1) { memcpy(tab + i * 48, &d, 48); }
        elif (memeq(&d, tab + i * 48, 48) != 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Σ deferred bytes (+32) over every metaslab.
fn zfs_wst_dsum() {
    var d = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        d = d + load64(zfs_msent(i) + 32);
        i = i + 1;
    }
    return d;
}
fn zfs_wst_msof(bp, d) { return ((load64(bp + d * 16 + 8) & ZWK_OFF63) << 9) >> zfs_ms_shift; }
# DVA d of bp in its metaslab's allocated bitmap (loading it): 1 every unit set · 0 every unit clear · -1 mixed / no load.
fn zfs_wst_dvst(bp, d) {
    var off = (load64(bp + d * 16 + 8) & ZWK_OFF63) << 9;
    var i = off >> zfs_ms_shift;
    var n = ((load64(bp + d * 16) & 0xFFFFFF) << 9) >> zfs_ashift;
    var s = zfs_ms_load(i);
    if (s < 0) { return 0 - 1; }
    var c = zfs_bm_cnt(zfs_bm_a(s), (off - (i << zfs_ms_shift)) >> zfs_ashift, n);
    if (c == n) { return 1; }
    if (c == 0) { return 0; }
    return 0 - 1;
}
# Metaslab x (loaded) has exactly the bitmaps at snap and the counts a / dd. 0 / -1.
fn zfs_wst_xsame(x, snap, a, dd) {
    var s = zfs_ms_load(x);
    if (s < 0) { return 0 - 1; }
    if (memeq(zfs_bm_a(s), snap, zfs_bm_bytes * 2) != 1) { return 0 - 1; }
    if (load64(zfs_msent(x) + 24) != a || load64(zfs_msent(x) + 32) != dd) { return 0 - 1; }
    return 0;
}
# Every DVA of bp: this vdev, inside one metaslab with a space map, asize = roundup(psize), allocated in its bitmap
# when resident; returns the metaslab of each DVA packed 16 bits apiece (for the ditto check), or -1.
fn zfs_wst_dvas(bp, nd) {
    var un = 1 << zfs_ashift;
    var psz = (((load64(bp + 48) >> 16) & 0xFFFF) + 1) << 9;
    var asz = (psz + un - 1) & (0 - un);
    var pk = 0;
    var d = 0;
    while (d < 3) {
        var w0 = load64(bp + d * 16);
        var w1 = load64(bp + d * 16 + 8);
        if (d < nd) {
            var off = (w1 & ZWK_OFF63) << 9;
            var i = off >> zfs_ms_shift;
            if ((w0 >> 32) != zfs_top_id || ((w0 & 0xFFFFFF) << 9) != asz || (w1 >> 63) != 0) { return 0 - 1; }
            if (i >= zfs_ms_count || off + asz > (i + 1) << zfs_ms_shift || load64(zfs_msent(i)) == 0) { return 0 - 1; }
            var s = load64(zfs_msent(i) + 40);
            if (s != 0) {
                var b = (off - (i << zfs_ms_shift)) >> zfs_ashift;
                if (zfs_bm_cnt(zfs_bm_a(s - 1), b, asz >> zfs_ashift) != asz >> zfs_ashift) { return 0 - 1; }
            }
            pk = pk | (i << (16 * d));
        } elif (w0 != 0 || w1 != 0) { return 0 - 1; }
        d = d + 1;
    }
    return pk;
}
# Word 6 of a written BP field by field against what it was built from — LSIZE, PSIZE, comp, E 0, checksum, TYPE,
# LEVEL, crypt 0, dedup 0, byteorder 1 — and equal to zfs_bp_prop of the same; words 7-9 (prop2, pad, physical birth)
# zero. The decode here is literal shifts, not zfs_bp_prop's: a policy-word slip in zfs_bp_build shows. 0 / -1.
fn zfs_wst_bpw(bp, lsize, psize, comp, ck, ty, lv) {
    var pr = load64(bp + 48);
    if ((((pr & 0xFFFF) + 1) << 9) != lsize || ((((pr >> 16) & 0xFFFF) + 1) << 9) != psize) { return 0 - 1; }
    if (((pr >> 32) & 0x7F) != comp || ((pr >> 39) & 1) != 0 || ((pr >> 40) & 0xFF) != ck) { return 0 - 1; }
    if (((pr >> 48) & 0xFF) != ty || ((pr >> 56) & 0x1F) != lv || (pr >> 61) != 4) { return 0 - 1; }
    if (pr != zfs_bp_prop(lsize, psize, comp, ck, ty, lv)) { return 0 - 1; }
    if (load64(bp + 56) != 0 || load64(bp + 64) != 0 || load64(bp + 72) != 0) { return 0 - 1; }
    return 0;
}
# The reader's verdict on a built block: its checksum over the physical bytes, and its content back through
# zfs_decomp into scratch. 0 / -1.
fn zfs_wst_reread(bp, src, lsize) {
    var pr = load64(bp + 48);
    var psz = (((pr >> 16) & 0xFFFF) + 1) << 9;
    if (zfs_ck_ok(bp, pr, zfs_bpb_va, psz) != 1) { return 0 - 1; }
    var scr = zfs_wmem + ZWA_OS + 0x200000;
    memset(scr, 0xA5, lsize);
    if (zfs_decomp((pr >> 32) & 0x7F, zfs_bpb_va, psz, scr, lsize) != 0) { return 0 - 1; }
    if (memeq(scr, src, lsize) != 1) { return 0 - 1; }
    return 0;
}
# dirty, build, free, undo — with every metaslab resident when the pool's bitmaps all fit (the fixtures). 0 / -1.
fn zfs_wst_main() {
    var t = zfs_txg + 1;
    var un = 1 << zfs_ashift;
    # --- dirty: keys, lookup, plan ---
    var dsobj = 0;
    if (zfs_nds > 0) { dsobj = load64(zfs_ds(0) + 840); }
    var e0 = zfs_dirty_add(0, ZWO_OSB, 0, 0, 4096, 11 << 8, 0);                    # the MOS objset_phys
    var e1 = zfs_dirty_add(dsobj, 7, 1, 0, 131072, 19 << 8, 0);                      # a dataset file's L1
    var e2 = zfs_dirty_add(dsobj, 7, 0, 3, 4096, ZWD_DATA | (19 << 8), 0);           # ... and one of its L0s
    var e3 = zfs_dirty_add(0, 0, 0, 2, 16384, 10 << 8, 0);                          # a MOS dnode block
    var e4 = zfs_dirty_add(dsobj, 0, 1, 0, 131072, 10 << 8, 0);                      # the dataset's meta-dnode L1
    var e5 = zfs_dirty_add(dsobj, ZWO_USER, 0, 0, 512, 46 << 8, zfs_mem + ZR_UB);    # its userused ZAP (a copy-in)
    if (e0 < 0 || e1 < 0 || e2 < 0 || e3 < 0 || e4 < 0 || e5 < 0) { return zfs_wst_fail("dirty add"); }
    if (zfs_dirty_add(dsobj, 7, 0, 3, 4096, ZWD_DATA, 0) >= 0) { return zfs_wst_fail("a duplicate key was accepted"); }
    zfs_wr_lit = 0;
    if (zfs_dirty_find(dsobj, 7, 0, 3) != e2 || zfs_dirty_find(0, ZWO_OSB, 0, 0) != e0 || zfs_dirty_find(dsobj, 7, 0, 4) != (0 - 1)) { return zfs_wst_fail("dirty find"); }
    if (zfs_dirty_plan() != 6) { return zfs_wst_fail("plan count"); }
    # dataset: L0 (e2), L1 (e1), userused (e5), meta-dnode L1 (e4); MOS: dnode block (e3), objset (e0)
    if (zfs_dirty_at(0) != e2 || zfs_dirty_at(1) != e1 || zfs_dirty_at(2) != e5 || zfs_dirty_at(3) != e4 || zfs_dirty_at(4) != e3 || zfs_dirty_at(5) != e0) { return zfs_wst_fail("plan order"); }
    if (memeq(zfs_dirty_buf(e5), zfs_mem + ZR_UB, 512) != 1 || zfs_wzero(zfs_dirty_buf(e5) + 512, un - 512) != 1) { return zfs_wst_fail("copy-in slot or its zero tail"); }
    zfs_wss("zfs-wb3: dirty 6 blocks, plan ok");
    serial_println("", 0);
    # --- build: a ZLE indirect with 3 copies ---
    var ib = zfs_dirty_buf(e1);
    var k = 0;
    while (k < 3) {
        var c = ib + k * 128;
        store64(c, 8);                                                              # asize 4 KiB
        store64(c + 8, 0x1000 + k * 8);
        store64(c + 48, (1 << 63) | (19 << 48) | (7 << 40) | (2 << 32) | (7 << 16) | 7);
        store64(c + 80, 5);
        store64(c + 88, k + 1);
        store64(c + 96, 0x0123456789ABCDEF * (k + 1));
        k = k + 1;
    }
    var fill = zfs_ind_ready(ib, 131072);
    var bp[128];
    var r = zfs_bp_build(ib, 131072, 19 | (1 << 8) | (7 << 16) | (3 << 24) | ZWP_ZLE, fill, 0, &bp);
    if (r != 1) { return zfs_wst_fail("build ZLE indirect"); }
    var pr = load64(&bp + 48);
    var psz = (((pr >> 16) & 0xFFFF) + 1) << 9;
    if (zfs_wst_bpw(&bp, 131072, psz, ZE_ZLE, 7, 19, 1) != 0 || fill != 6 || load64(&bp + 88) != 6 || load64(&bp + 80) != t) { return zfs_wst_fail("ZLE indirect fields"); }
    if (zfs_wst_reread(&bp, ib, 131072) != 0) { return zfs_wst_fail("ZLE indirect read back"); }
    var pk = zfs_wst_dvas(&bp, 3);
    if (pk < 0) { return zfs_wst_fail("ZLE indirect DVAs"); }
    var m0 = pk & 0xFFFF;
    var m1 = (pk >> 16) & 0xFFFF;
    var m2 = (pk >> 32) & 0xFFFF;
    var nroom = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        if (load64(zfs_msent(i)) != 0 && (1 << zfs_ms_shift) - load64(zfs_msent(i) + 24) - load64(zfs_msent(i) + 32) > 0x10000) { nroom = nroom + 1; }
        i = i + 1;
    }
    if (nroom >= 3 && (m0 == m1 || m1 == m2 || m0 == m2)) { return zfs_wst_fail("ditto copies share a metaslab"); }
    var keepbp[128];
    memcpy(&keepbp, &bp, 128);
    zfs_wss("zfs-wb3: build zle indirect psize=");
    zfs_wsn(psz);
    zfs_wss(" fill=6 dvas=3 ms=");
    zfs_wsn(m0);
    zfs_wss(",");
    zfs_wsn(m1);
    zfs_wss(",");
    zfs_wsn(m2);
    zfs_wss(" ok");
    serial_println("", 0);
    # --- build: a 4 KiB data block, 1 copy, uncompressed ---
    var db = zfs_dirty_buf(e2);
    k = 0;
    while (k < 4096) {
        store64(db + k, (k + 1) * 0x9E3779B97F4A7C15);
        k = k + 8;
    }
    r = zfs_bp_build(db, 4096, 19 | (8 << 16) | (1 << 24) | ZWP_HOLE | ZWP_USER, 1, 0, &bp);
    if (r != 1 || zfs_bpb_va != db || zfs_wst_bpw(&bp, 4096, 4096, 2, 8, 19, 0) != 0 || load64(&bp + 80) != t || load64(&bp + 88) != 1) { return zfs_wst_fail("build data block"); }
    if (zfs_wst_reread(&bp, db, 4096) != 0 || zfs_wst_dvas(&bp, 1) < 0) { return zfs_wst_fail("data block read back"); }
    zfs_wss("zfs-wb3: build data 4096 sha256 dvas=1 ok");
    serial_println("", 0);
    # --- build: holes ---
    var xl = zfs_xl_n;
    var old[128];
    memset(&old, 0, 128);
    store64(&old + 80, 5);
    var zb = zfs_dirty_buf(e4);
    r = zfs_bp_build(zb, 131072, 10 | (1 << 8) | (7 << 16) | (2 << 24) | ZWP_ZLE, zfs_ind_ready(zb, 131072), &old, &bp);
    var hb = 0;
    if ((zfs_w_feat & 8) != 0) { hb = t; }
    if (r != 0 || load64(&bp + 80) != hb || zfs_xl_n != xl || zfs_bpb_va != 0) { return zfs_wst_fail("hole with birth"); }
    if (hb != 0 && load64(&bp + 48) != ((1 << 56) | (10 << 48) | 255)) { return zfs_wst_fail("hole with birth fields"); }
    r = zfs_bp_build(zb, 131072, 10 | (1 << 8) | (7 << 16) | (2 << 24) | ZWP_ZLE, 0, 0, &bp);
    if (r != 0 || memeq(&bp, zfs_mem + ZR_ZERO, 128) != 1) { return zfs_wst_fail("never-written hole"); }
    zfs_wss("zfs-wb3: build holes birth=");
    zfs_wsn(hb);
    zfs_wss(" ok");
    serial_println("", 0);
    # --- free: the rootbp with one unit of DVA 0 already deferred — injected in memory, so only when every metaslab
    # stays resident (a reload would drop the injected bit and the counts below would mean nothing) ---
    if (zfs_wfree_bp(&keepbp) != (0 - 1)) { return zfs_wst_fail("a block born in T was freed"); }
    zfs_wr_lit = 0;
    # the rootbp as a DEDUP block, then as an encrypted one: refused before anything is touched
    var xn = zfs_xl_n;
    memcpy(&old, zfs_mem + ZR_UB + 40, 128);
    store64(&old + 48, load64(&old + 48) | (1 << 62));
    if (zfs_wfree_bp(&old) != (0 - 1)) { return zfs_wst_fail("a dedup block was freed"); }
    zfs_wr_lit = 0;
    store64(&old + 48, load64(&old + 48) ^ (3 << 61));
    if (zfs_wfree_bp(&old) != (0 - 1) || zfs_xl_n != xn) { return zfs_wst_fail("an encrypted block was freed"); }
    zfs_wr_lit = 0;
    var rb[128];
    memcpy(&rb, zfs_mem + ZR_UB + 40, 128);
    var mi = zfs_wst_msof(&rb, 0);
    var ov = 0;
    if (zfs_bm_slots >= zfs_ms_count) {
        var s = zfs_ms_load(mi);
        if (s < 0) { return zfs_wst_fail("load the rootbp's metaslab"); }
        var u0 = (((load64(&rb + 8) & ZWK_OFF63) << 9) - (mi << zfs_ms_shift)) >> zfs_ashift;
        var dbm = zfs_bm_a(s) + zfs_bm_bytes;
        if (zfs_bm_cnt(dbm, u0, 1) != 0) { return zfs_wst_fail("the MOS rootbp is deferred"); }
        zfs_bm_op(dbm, u0, 1, 2);
        store64(zfs_msent(mi) + 32, load64(zfs_msent(mi) + 32) + un);
        ov = 1;
    }
    var x0 = zfs_xl_n;
    var tf = zfs_tx_free;
    var ds0 = zfs_wst_dsum();
    if (zfs_wfree_bp(&rb) != 0) { return zfs_wst_fail("free of the MOS rootbp"); }
    if (zfs_wst_dsum() - ds0 != zfs_tx_free - tf - ov * un) { return zfs_wst_fail("a FREE over a deferred unit counted it again"); }
    if (zfs_xl_pre(zfs_xl(x0)) != ov) { return zfs_wst_fail("a FREE over a deferred unit did not record it"); }
    if (zfs_wfree_bp(&rb) != (0 - 2)) { return zfs_wst_fail("a double free was not caught"); }
    zfs_wr_lit = 0;
    zfs_wss("zfs-wb3: free ok (extents ");
    zfs_wsn(zfs_xl_n);
    zfs_wss(", pre-deferred units ");
    zfs_wsn(ov);
    zfs_wss(")");
    serial_println("", 0);
    # --- undo, on resident metaslabs ---
    if (zfs_wxl_undo(0) != 0 || zfs_tx_alloc != 0 || zfs_tx_free != 0) { return zfs_wst_fail("undo"); }
    if (ov == 1) {
        # evicted, not cleared — and its TRACKED counts are the digest's plus the injected unit, which only a reload drops
        var tab = zfs_wmem + ZWA_OS + 0x220000;
        if (load64(zfs_msent(mi) + 40) != 0) { return zfs_wst_fail("undo of a FREE over a deferred unit kept its metaslab"); }
        if (load64(zfs_msent(mi) + 24) != load64(tab + mi * 48 + 32) || load64(zfs_msent(mi) + 32) != load64(tab + mi * 48 + 40) + un) { return zfs_wst_fail("undo of a FREE over a deferred unit miscounted"); }
    }
    zfs_dirty_reset();
    var m = zfs_wst_dig(0);
    if (m == (0 - 2)) { return zfs_wst_fail("undo: a reload failed"); }
    if (m >= 0) {
        zfs_wnon("metaslab ", m);
        return zfs_wst_fail("undo left the allocator changed");
    }
    zfs_wss("zfs-wb3: undo ok");
    serial_println("", 0);
    return 0;
}
# The no-pin rule through ONE resident slot (see the header). 0 / -1.
fn zfs_wst_evict() {
    if (zfs_ms_count < 4) {
        zfs_wss("zfs-wb3: evict skipped (fewer than 4 metaslabs)");
        serial_println("", 0);
        return 0;
    }
    var un = 1 << zfs_ashift;
    var snap = zfs_wmem + ZWA_OS + 0x240000;
    var tab = zfs_wmem + ZWA_OS + 0x220000;
    zfs_wst_evall();
    zfs_wst_slots = zfs_bm_slots;
    zfs_bm_slots = 1;
    # (1) the MOS rootbp freed: each DVA's load evicts the metaslab of the DVA before
    var rb[128];
    memcpy(&rb, zfs_mem + ZR_UB + 40, 128);
    if (zfs_wfree_bp(&rb) != 0) { return zfs_wst_fail("evict: free of the MOS rootbp"); }
    var nrb = 3;
    while (nrb > 1 && load64(&rb + (nrb - 1) * 16) == 0 && load64(&rb + (nrb - 1) * 16 + 8) == 0) { nrb = nrb - 1; }
    var c = zfs_wst_msof(&rb, nrb - 1);
    if (load64(zfs_msent(c) + 40) == 0) { return zfs_wst_fail("evict: the last freed DVA's metaslab is not resident"); }
    var room = (1 << zfs_ms_shift) - load64(zfs_msent(c) + 24) - load64(zfs_msent(c) + 32);
    # (2) one unit: the RESIDENT metaslab first (zfs_wpick) — so X holds a FREE and an ALLOC of T
    var bp[128];
    if (zfs_walloc_bp(&bp, un, 1, 0) != 0) { return zfs_wst_fail("evict: allocation"); }
    var x = zfs_wst_msof(&bp, 0);
    if (room >= un && x != c) { return zfs_wst_fail("evict: the allocator passed over the resident metaslab"); }
    # (3) X evicted by another load, then reloaded: its replay + T's extents rebuild the bitmaps and counts exactly
    var sx = load64(zfs_msent(x) + 40);
    if (sx == 0) { return zfs_wst_fail("evict: the allocation's metaslab is not resident"); }
    memcpy(snap, zfs_bm_a(sx - 1), zfs_bm_bytes * 2);
    var x24 = load64(zfs_msent(x) + 24);
    var x32 = load64(zfs_msent(x) + 32);
    var y = 0;
    if (x == 0) { y = 1; }
    if (zfs_ms_load(y) < 0 || load64(zfs_msent(x) + 40) != 0) { return zfs_wst_fail("evict: one slot held two metaslabs"); }
    if (zfs_wst_xsame(x, snap, x24, x32) != 0) { return zfs_wst_fail("evict: a reloaded metaslab lost the open txg's extents"); }
    # (4) three copies through one slot: DVA d's load evicts DVA d - 1's metaslab
    var keep = zfs_xl_n;
    var b3[128];
    if (zfs_walloc_bp(&b3, un, 3, 0) != 0) { return zfs_wst_fail("evict: 3-copy allocation"); }
    var m0 = zfs_wst_msof(&b3, 0);
    var m1 = zfs_wst_msof(&b3, 1);
    var m2 = zfs_wst_msof(&b3, 2);
    var ne = 0;
    if (load64(zfs_msent(m0) + 40) == 0) { ne = ne + 1; }
    if (load64(zfs_msent(m1) + 40) == 0) { ne = ne + 1; }
    if (m0 != m1 && m1 != m2 && m0 != m2 && ne != 2) { return zfs_wst_fail("evict: 3 copies in 3 metaslabs did not evict 2"); }
    var d = 0;
    while (d < 3) {
        if (zfs_wst_dvst(&b3, d) != 1) { return zfs_wst_fail("evict: a copy is not allocated after its metaslab's reload"); }
        d = d + 1;
    }
    # (5) undone with none of the three resident; each reload: the units free, the counts what the undo tracked
    zfs_wst_evall();
    if (zfs_wxl_undo(keep) != 0) { return zfs_wst_fail("evict: undo on non-resident metaslabs"); }
    d = 0;
    while (d < 3) {
        var md = zfs_wst_msof(&b3, d);
        var t24 = load64(zfs_msent(md) + 24);
        var t32 = load64(zfs_msent(md) + 32);
        if (zfs_wst_dvst(&b3, d) != 0) { return zfs_wst_fail("evict: an undone copy is allocated after a reload"); }
        if (load64(zfs_msent(md) + 24) != t24 || load64(zfs_msent(md) + 32) != t32) { return zfs_wst_fail("evict: a non-resident undo miscounted"); }
        d = d + 1;
    }
    if (zfs_wst_xsame(x, snap, x24, x32) != 0) { return zfs_wst_fail("evict: the undo of other metaslabs changed X"); }
    # (6) everything undone with NO metaslab resident: the tracked counts must already be the digests'
    zfs_wst_evall();
    if (zfs_wxl_undo(0) != 0 || zfs_tx_alloc != 0 || zfs_tx_free != 0) { return zfs_wst_fail("evict: undo"); }
    var i = 0;
    while (i < zfs_ms_count) {
        if (load64(zfs_msent(i) + 24) != load64(tab + i * 48 + 32) || load64(zfs_msent(i) + 32) != load64(tab + i * 48 + 40)) {
            zfs_wnon("metaslab ", i);
            return zfs_wst_fail("evict: tracked counts after a non-resident undo");
        }
        i = i + 1;
    }
    var m = zfs_wst_dig(0);
    if (m == (0 - 2)) { return zfs_wst_fail("evict: a reload failed"); }
    if (m >= 0) {
        zfs_wnon("metaslab ", m);
        return zfs_wst_fail("evict: a reload digests differently");
    }
    zfs_wst_uncap();
    zfs_wss("zfs-wb3: evict 1 slot: X=");
    zfs_wsn(x);
    zfs_wss(" free+alloc reloaded, 3 copies ms=");
    zfs_wsn(m0);
    zfs_wss(",");
    zfs_wsn(m1);
    zfs_wss(",");
    zfs_wsn(m2);
    zfs_wss(" evicted=");
    zfs_wsn(ne);
    zfs_wss(", undone non-resident ok");
    serial_println("", 0);
    return 0;
}
# --- accounting microzaps (B4 review): the commit's user / group / project step on a REAL dataset, in memory. B4's verb
# never adds or removes an accounting key (both sides of a synced dnode share its ids), so those paths ran nowhere: an
# SA dnode of the first writable dataset with user accounting gets uid / gid 1001 / 1002 in its dirty dnode block (what
# B5+'s chown does), and the delta table as many more user keys as the user ZAP has free chunks + 2; then zfs_wd_uacct
# (the dnode diffed against T - 1: its old side off uid / gid 0, its new side onto NEW keys "3e9" / "obj-3e9" / ...)
# and zfs_wd_uqapply (zfs_mz_add: each new key at the lowest unused cd; the user ZAP GROWS by 512 B). Then every delta
# reversed through zfs_wd_uqapply: each new key REMOVED at 0. Judged on the blocks themselves, apart from the code that
# wrote them (zfs_wst_mzok): the 64-byte header kept, every name NUL-terminated and unique, no two entries with one
# (hash, cd), every entry T - 1's value + the summed deltas (absent at 0) and no other — "3e9" / "obj-3e9" / "3ea" /
# "obj-3ea" by their literal names; after the reversal exactly T - 1's entries, every chunk freed on the way all zero,
# the block still grown (a microzap never shrinks) and every ZAP's dn_datablkszsec its size. Scratch: ZWA_OS + 0x300000
# (T - 1's blocks, 3 x 128 KiB), + 0x360000 (the deltas).
fn zfs_wst_max(a, b) {
    if (a > b) { return a; }
    return b;
}
# The value of the entry named n (l bytes, 1..49) of the microzap block b (bsz bytes) into out: 1 / 0 absent.
fn zfs_wst_mzv(b, bsz, n, l, out) {
    var k = 64;
    while (k < bsz) {
        if (load8(b + k + 14 + l) == 0 && memeq(b + k + 14, n, l) == 1) {
            store64(out, load64(b + k));
            return 1;
        }
        k = k + 64;
    }
    return 0;
}
# The key of delta-table entry q into out ("obj-" for an object count, then "%llx"). Its length.
fn zfs_wst_qname(q, out) {
    var nl = 0;
    if ((load64(q + 8) >> 8) == 1) {
        memcpy(out, "obj-", 4);
        nl = 4;
    }
    return nl + zfs_whex(load64(q + 16), out + nl);
}
# Σ the deltas of dataset os's table entries that name key n (l bytes) of accounting ZAP z.
fn zfs_wst_qsum(os, z, n, l) {
    var nm[24];
    var s = 0;
    var k = 0;
    while (k < zfs_wq_n) {
        var q = zfs_wmem + ZWA_UQ + k * 32;
        if (load64(q) == os && (load64(q + 8) & 3) == z && zfs_wst_qname(q, &nm) == l && memeq(&nm, n, l) == 1) { s = s + load64(q + 24); }
        k = k + 1;
    }
    return s;
}
# Microzap block nb (nsz bytes) of accounting ZAP z of dataset os against T - 1's ob (osz bytes) + the table's summed
# deltas (wd 1) or + nothing (wd 0) — see the section header. 0 / -1.
fn zfs_wst_mzok(z, os, nb, nsz, ob, osz, wd) {
    if (memeq(nb, ob, 64) != 1) { return 0 - 1; }
    var nm[24];
    var v = 0;
    var k = 64;
    while (k < nsz) {
        if (load8(nb + k + 14) != 0) {
            var l = 0;
            while (l < 50 && load8(nb + k + 14 + l) != 0) { l = l + 1; }
            if (l >= 50) { return 0 - 1; }
            var h = zfs_zap_hash(load64(nb + 8), nb + k + 14, l);
            var j = k + 64;
            while (j < nsz) {
                if (load8(nb + j + 14) != 0) {
                    var jl = 0;
                    while (jl < 50 && load8(nb + j + 14 + jl) != 0) { jl = jl + 1; }
                    if (jl == l && memeq(nb + j + 14, nb + k + 14, l) == 1) { return 0 - 1; }
                    if (load32(nb + j + 8) == load32(nb + k + 8) && zfs_zap_hash(load64(nb + 8), nb + j + 14, jl) == h) { return 0 - 1; }
                }
                j = j + 64;
            }
            var w = 0;
            if (zfs_wst_mzv(ob, osz, nb + k + 14, l, &v) == 1) { w = v; }
            if (wd == 1) { w = w + zfs_wst_qsum(os, z, nb + k + 14, l); }
            if (w == 0 || load64(nb + k) != w) { return 0 - 1; }
        } elif (zfs_wzero(nb + k, 64) != 1) {
            # a chunk free here: all zero (never used, or freed — mzap_remove), or T - 1's own free chunk untouched
            if (k >= osz || load8(ob + k + 14) != 0 || memeq(nb + k, ob + k, 64) != 1) { return 0 - 1; }
        }
        k = k + 64;
    }
    k = 64;
    while (k < osz) {
        if (load8(ob + k + 14) != 0) {
            var l2 = 0;
            while (l2 < 50 && load8(ob + k + 14 + l2) != 0) { l2 = l2 + 1; }
            var w2 = load64(ob + k);
            if (wd == 1) { w2 = w2 + zfs_wst_qsum(os, z, ob + k + 14, l2); }
            if (w2 != 0 && (zfs_wst_mzv(nb, nsz, ob + k + 14, l2, &v) != 1 || v != w2)) { return 0 - 1; }
        }
        k = k + 64;
    }
    if (wd == 1) {
        var q = 0;
        while (q < zfs_wq_n) {
            var qe = zfs_wmem + ZWA_UQ + q * 32;
            if (load64(qe) == os && (load64(qe + 8) & 3) == z) {
                var nl = zfs_wst_qname(qe, &nm);
                if (zfs_wst_mzv(ob, osz, &nm, nl, &v) == 0) {
                    var s = zfs_wst_qsum(os, z, &nm, nl);
                    if (s != 0 && (zfs_wst_mzv(nb, nsz, &nm, nl, &v) != 1 || v != s)) { return 0 - 1; }
                }
            }
            q = q + 1;
        }
    }
    return 0;
}
# Every dirty accounting ZAP of dataset os judged (zfs_wst_mzok) against the T - 1 snapshot at snap (sizes at osz),
# its dnode's dn_datablkszsec its size; the user and group ZAPs must be dirty. The user ZAP's size / -1.
fn zfs_wst_zaps(os, nz, snap, osz, wd) {
    var us = 0;
    var z = 0;
    while (z < nz) {
        var e = zfs_dirty_find(os, ZWO_USER + z, 0, 0);
        if (e < 0 && z < 2) { return 0 - 1; }
        if (e >= 0) {
            var ns = load64(zfs_dent(e) + 32);
            var sd = zfs_wobj_dn(os, ZWO_USER + z);
            if (sd == 0 || (load16(sd + 8) << 9) != ns) { return 0 - 1; }
            if (zfs_wst_mzok(z, os, zfs_dirty_buf(e), ns, snap + z * 0x20000, load64(osz + z * 8), wd) != 0) { return 0 - 1; }
            if (z == 0) { us = ns; }
        }
        z = z + 1;
    }
    return us;
}
fn zfs_wst_uacct() {
    var dse = 0;
    var di = 0;
    while (di < zfs_nds && dse == 0) {
        if (load64(zfs_ds(di) + 1016) == 1) {
            dse = zfs_wds_open(di);
            if (dse != 0 && (load64(dse + 104) & 1) == 0) { dse = 0; }
            if (dse == 0) {
                zfs_dirty_reset();
                zfs_wr_lit = 0;
            }
        }
        if (dse == 0) { di = di + 1; }
    }
    if (dse == 0) {
        zfs_wss("zfs-wb3: uacct skipped (no writable dataset with user accounting)");
        serial_println("", 0);
        return 0;
    }
    var os = load64(dse);
    var fl = load64(dse + 104);
    var cm = zfs_ds(di);
    var per = load16(cm + 8);
    var obj = 0;
    var b = 0;
    while (b <= load64(cm + 16) && b < 8 && obj == 0) {
        var p = zfs_obj_blk(cm, b, 1);
        if (p == 0) { return zfs_wst_fail("uacct: a dnode block is unreadable"); }
        var s = 0;
        while (s < per && obj == 0) {
            var q = p + s * 512;
            if (load8(q) != 0) {
                var bo = zfs_bonus(q);
                if (load8(q + 4) == 44 && (load8(q + 7) & 2) != 0 && load16(q + 10) >= 64 && load32(bo) == ZE_SAMAGIC) {
                    var hs0 = ((load16(bo + 4) >> 10) & 0x3F) * 8;
                    if (hs0 >= 8 && hs0 + 56 <= load16(q + 10)) { obj = b * per + s; }
                }
                s = s + 1 + load8(q + 12);
            } else { s = s + 1; }
        }
        b = b + 1;
    }
    if (obj == 0) {
        zfs_dirty_reset();
        zfs_wss("zfs-wb3: uacct skipped (no accounted SA dnode in the first 8 dnode blocks)");
        serial_println("", 0);
        return 0;
    }
    # T - 1's accounting blocks, and the user ZAP's free chunks
    var nz = 2 + ((fl >> 2) & 1);
    var snap = zfs_wmem + ZWA_OS + 0x300000;
    var osz[24];
    var fr = 0;
    var z = 0;
    while (z < nz) {
        var sd = zfs_wobj_dn(os, ZWO_USER + z);
        if (sd == 0) { return zfs_wst_fail("uacct: an accounting dnode"); }
        var zb = zfs_obj_blk(sd, 0, 1);
        var bs = load16(sd + 8) << 9;
        if (zb == 0 || bs > 0x20000) { return zfs_wst_fail("uacct: an accounting ZAP is unreadable"); }
        memcpy(snap + z * 0x20000, zb, bs);
        store64(&osz + z * 8, bs);
        if (z == 0) {
            var c = 64;
            while (c < bs) {
                if (load8(zb + c + 14) == 0) { fr = fr + 1; }
                c = c + 64;
            }
        }
        z = z + 1;
    }
    # the dnode's new owner, and the extra user keys: more new keys than the user ZAP has room for
    var n = zfs_wos_dn(os, obj);
    if (n == 0) { return zfs_wst_fail("uacct: dirty the dnode"); }
    var bon = zfs_bonus(n);
    var hs = ((load16(bon + 4) >> 10) & 0x3F) * 8;
    store64(bon + hs + 24, 0x3E9);
    store64(bon + hs + 32, 0x3EA);
    var nx = fr + 2;
    if (nx > 32) { nx = 32; }
    var j = 0;
    while (j < nx) {
        if (zfs_wq_add(os, 0, 0x7A0 + j, 512 * (j + 1)) != 0) { return zfs_wst_fail("uacct: the delta table"); }
        j = j + 1;
    }
    if (zfs_wd_uacct(dse) != 0) { return zfs_wst_fail("uacct: zfs_wd_uacct"); }
    var us0 = load64(&osz);
    var us1 = zfs_wst_zaps(os, nz, snap, &osz, 1);
    if (us1 < 0) { return zfs_wst_fail("uacct: an accounting ZAP after the deltas"); }
    if (nx == fr + 2 && us1 <= us0) { return zfs_wst_fail("uacct: the user ZAP did not grow"); }
    var used = 512 + zfs_wdn_bytes(n);
    var ue = zfs_dirty_buf(zfs_dirty_find(os, ZWO_USER, 0, 0));
    var ge = zfs_dirty_find(os, ZWO_GROUP, 0, 0);
    var gs = load64(zfs_dent(ge) + 32);
    var gb = zfs_dirty_buf(ge);
    var v = 0;
    if (zfs_wst_mzv(ue, us1, "3e9", 3, &v) != 1 || v != used || zfs_wst_mzv(gb, gs, "3ea", 3, &v) != 1 || v != used) { return zfs_wst_fail("uacct: the new owner's bytes"); }
    if ((fl & 2) != 0 && (zfs_wst_mzv(ue, us1, "obj-3e9", 7, &v) != 1 || v != 1 || zfs_wst_mzv(gb, gs, "obj-3ea", 7, &v) != 1 || v != 1)) { return zfs_wst_fail("uacct: the new owner's objects"); }
    # every delta reversed: the new keys go at 0
    var tab = zfs_wmem + ZWA_OS + 0x360000;
    var tn = zfs_wq_n;
    memcpy(tab, zfs_wmem + ZWA_UQ, tn * 32);
    zfs_wq_n = 0;
    j = 0;
    while (j < tn) {
        var t = tab + j * 32;
        if (load64(t + 24) != 0 && zfs_wq_add(load64(t), load64(t + 8), load64(t + 16), 0 - load64(t + 24)) != 0) { return zfs_wst_fail("uacct: the delta table"); }
        j = j + 1;
    }
    if (zfs_wd_uqapply(dse) != 0) { return zfs_wst_fail("uacct: zfs_wd_uqapply of the reversal"); }
    if (zfs_wst_zaps(os, nz, snap, &osz, 0) != us1) { return zfs_wst_fail("uacct: the accounting ZAPs after the reversal"); }
    zfs_dirty_reset();
    var ds = zfs_ds(di);
    zfs_wss("zfs-wb3: uacct ");
    serial_print(ds + 856, load64(ds + 848));
    zfs_wss(" obj=");
    zfs_wsn(obj);
    zfs_wss(" new keys=");
    zfs_wsn(nx + 2);
    zfs_wss(" user ZAP ");
    zfs_wsn(us0);
    zfs_wss("->");
    zfs_wsn(us1);
    zfs_wss(" B, reversed to T-1 ok");
    serial_println("", 0);
    return 0;
}
# (B8 review, k.86) The commit's FAT accounting ADD, in memory — zfs_wd_uqapply bringing NEW keys into a fat user ZAP,
# reachable in production on an accounted dataset whose dnodes lack DNODE_FLAG_USEROBJUSED_ACCOUNTED (userobj
# accounting enabled, the objset's upgrade incomplete: "obj-%llx" keys) and by no agnos verb on a fixture. On the first
# writable accounted dataset: its user ZAP upgraded as admission does (zfs_wz_upgrade) when it is a microzap; the
# admission's fat step (zfs_wz_urs: the shape, the external-table refusal, the reservation for the new keys); then 220
# new "%llx" keys whose hashes share their top 8 bits — every split of their leaf sends them one way, so it splits down
# to prefix 8 (from a just-upgraded ZAP: blocks past the special dnode's 3 dn_blkptr[], which grows a LEVEL inside the
# objset_phys, zfs_wf_levels) — applied by zfs_wd_uqapply exactly as the commit's dataset phase applies them. Judged:
# every new key's value its delta, every T - 1 entry (the reader's view of the committed dnode, zfs_zap_next) as it
# was, zap_num_entries + 220, more leaves, a level when it began at two blocks, the bytes the adds dirtied within
# zfs_wz_mres; then every delta reversed (the keys removed; an emptied leaf is kept) and judged again. First, a fat
# header with zap_flags must be REFUSED by the admission (zfs_wz_urs; it fell through to the commit). In memory only —
# the dirty set reset; the commit's pass-1 re-plan around such blocks is the real commit's (no fixture: k.86).
# Scratch: ZWA_OS + 0x300000 (the chosen ids).
fn zfs_wst_uaold(cdn) {
    var nm[32];
    var v[8];
    var cur = 0;
    var r = zfs_zap_next(cdn, &cur);
    while (r == 1) {
        var nl = zfs_it_nlen;
        var want = zfs_it_val;
        if (nl < 1 || nl > 31) { return 0 - 1; }
        memcpy(&nm, zfs_mem + ZR_NAME, nl);
        if (zfs_wz_get(&nm, nl, &v) != 1 || load64(&v) != want) { return 0 - 1; }
        r = zfs_zap_next(cdn, &cur);
    }
    if (r < 0) { return 0 - 1; }
    return 0;
}
fn zfs_wst_uafat() {
    var dse = 0;
    var di = 0;
    while (di < zfs_nds && dse == 0) {
        if (load64(zfs_ds(di) + 1016) == 1) {
            dse = zfs_wds_open(di);
            if (dse != 0 && (load64(dse + 104) & 1) == 0) { dse = 0; }
            if (dse == 0) {
                zfs_dirty_reset();
                zfs_wr_lit = 0;
            }
        }
        if (dse == 0) { di = di + 1; }
    }
    if (dse == 0) {
        zfs_wss("zfs-wb3: uafat skipped (no writable dataset with user accounting)");
        serial_println("", 0);
        return 0;
    }
    var os = load64(dse);
    var sd = zfs_wobj_dn(os, ZWO_USER);
    if (sd == 0) { return zfs_wst_fail("uafat: the user accounting dnode"); }
    var cdn[512];
    memcpy(&cdn, sd, 512);
    zfs_wz_open(os, ZWO_USER, sd);
    var k0 = zfs_wz_kind();
    if (k0 < 0) { return zfs_wst_fail("uafat: the user ZAP's shape"); }
    var up = 0;
    if (k0 == 3) {
        if (zfs_wz_upgrade() != 0) { return zfs_wst_fail("uafat: the upgrade"); }
        store64(dse + 120, load64(dse + 120) | 0xFFFF);
        up = 1;
    }
    if (zfs_wz_kind() != 1) { return zfs_wst_fail("uafat: the user ZAP is not fat"); }
    var hdr = zfs_zf_blk(0);
    if (hdr == 0) { return zfs_wst_fail("uafat: the header"); }
    if (load64(hdr + 24) != 0) {
        zfs_dirty_reset();
        zfs_wss("zfs-wb3: uafat skipped (the user ZAP's pointer table is external: refused at admission, k.77)");
        serial_println("", 0);
        return 0;
    }
    # (B8 review) a shape zfs_wz_kind refuses is refused at ADMISSION (zfs_wz_urs), not by the commit: zap_flags set
    store64(hdr + 96, 1);
    var bad = zfs_wz_urs(dse, 0, 1);
    store64(hdr + 96, 0);
    zfs_wr_lit = 0;
    if (bad == 0) { return zfs_wst_fail("uafat: a fat accounting ZAP with zap_flags admitted"); }
    var ne0 = load64(hdr + 72);
    var nlf0 = load64(hdr + 64);
    var nlv0 = load8(sd + 2);
    # 220 absent ids whose "%llx" hashes share their top 8 bits (the first one's)
    var ids = zfs_wmem + ZWA_OS + 0x300000;
    var key[24];
    var v[8];
    var tgt = 0 - 1;
    var n = 0;
    var id = 0x5A170000;
    while (n < 220 && id < 0x5A570000) {
        var kl = zfs_whex(id, &key);
        var h = zfs_zf_hash(hdr, &key, kl);
        if (zfs_zf_ns != 0) { return zfs_wst_fail("uafat: a key's hash"); }
        if (tgt < 0) { tgt = h >> 56; }
        if ((h >> 56) == tgt) {
            var g = zfs_wz_get(&key, kl, &v);
            if (g < 0) { return zfs_wst_fail("uafat: a lookup"); }
            if (g == 0) {
                store64(ids + n * 8, id);
                n = n + 1;
            }
        }
        id = id + 1;
    }
    if (n < 220) { return zfs_wst_fail("uafat: too few ids share a hash prefix"); }
    # the admission's step, then the commit's: the deltas applied
    zfs_wz_mres = 0;
    if (zfs_wz_urs(dse, 0, 220) != 0) { return zfs_wst_fail("uafat: zfs_wz_urs"); }
    zfs_wq_n = 0;
    var j = 0;
    while (j < 220) {
        if (zfs_wq_add(os, 0, load64(ids + j * 8), 512 * (j + 1)) != 0) { return zfs_wst_fail("uafat: the delta table"); }
        j = j + 1;
    }
    var m1 = zfs_dx_meta;
    if (zfs_wd_uqapply(dse) != 0) { return zfs_wst_fail("uafat: zfs_wd_uqapply"); }
    var grown = zfs_dx_meta - m1;
    if (grown > zfs_wz_mres) { return zfs_wst_fail("uafat: the adds dirtied more than zfs_wz_urs reserved"); }
    zfs_wz_open(os, ZWO_USER, sd);
    if (zfs_wz_kind() != 1) { return zfs_wst_fail("uafat: the user ZAP after the adds"); }
    hdr = zfs_zf_blk(0);
    var nlf1 = load64(hdr + 64);
    var nlv1 = load8(sd + 2);
    if (load64(hdr + 72) != ne0 + 220) { return zfs_wst_fail("uafat: zap_num_entries after the adds"); }
    if (nlf1 <= nlf0) { return zfs_wst_fail("uafat: no leaf split"); }
    if (up == 1 && (nlv1 < 2 || load64(sd + 16) < 3)) { return zfs_wst_fail("uafat: the special dnode grew no level"); }
    j = 0;
    while (j < 220) {
        var kl2 = zfs_whex(load64(ids + j * 8), &key);
        if (zfs_wz_get(&key, kl2, &v) != 1 || load64(&v) != 512 * (j + 1)) { return zfs_wst_fail("uafat: a new key's value"); }
        j = j + 1;
    }
    if (zfs_wst_uaold(&cdn) != 0) { return zfs_wst_fail("uafat: a T - 1 entry after the adds"); }
    # every delta reversed: the new keys go
    zfs_wq_n = 0;
    j = 0;
    while (j < 220) {
        if (zfs_wq_add(os, 0, load64(ids + j * 8), 0 - 512 * (j + 1)) != 0) { return zfs_wst_fail("uafat: the delta table"); }
        j = j + 1;
    }
    if (zfs_wd_uqapply(dse) != 0) { return zfs_wst_fail("uafat: zfs_wd_uqapply of the reversal"); }
    zfs_wz_open(os, ZWO_USER, sd);
    if (zfs_wz_kind() != 1) { return zfs_wst_fail("uafat: the user ZAP after the reversal"); }
    hdr = zfs_zf_blk(0);
    if (load64(hdr + 72) != ne0 || load64(hdr + 64) != nlf1) { return zfs_wst_fail("uafat: zap_num_entries / leaves after the reversal"); }
    j = 0;
    while (j < 220) {
        var kl3 = zfs_whex(load64(ids + j * 8), &key);
        if (zfs_wz_get(&key, kl3, &v) != 0) { return zfs_wst_fail("uafat: a reversed key is still there"); }
        j = j + 1;
    }
    if (zfs_wst_uaold(&cdn) != 0) { return zfs_wst_fail("uafat: a T - 1 entry after the reversal"); }
    var res = zfs_wz_mres;
    zfs_dirty_reset();
    var ds = zfs_ds(di);
    zfs_wss("zfs-wb3: uafat ");
    serial_print(ds + 856, load64(ds + 848));
    if (up == 1) { zfs_wss(" user microzap upgraded,"); }
    zfs_wss(" 220 new keys (hash prefix ");
    zfs_wsn(tgt);
    zfs_wss(") committed in memory: leaves ");
    zfs_wsn(nlf0);
    zfs_wss("->");
    zfs_wsn(nlf1);
    zfs_wss(", nlevels ");
    zfs_wsn(nlv0);
    zfs_wss("->");
    zfs_wsn(nlv1);
    zfs_wss(", dirtied ");
    zfs_wsn(grown);
    zfs_wss(" B of ");
    zfs_wsn(res);
    zfs_wss(" reserved, reversed to T-1 ok");
    serial_println("", 0);
    return 0;
}
# --- reservations (B4 review): the dataset phase's space step (zfs_wd_dsdelta -> zfs_pdelta, zfs_wdd_use) on the REAL
# dsl_dir chain of the deepest grafted dataset, in memory: no fixture COW sends a non-zero change into a dir with
# dd_reserved or across a refreservation (wr's resv/r.txt is absorbed whole by its refreservation). Three set-ups, each
# forward (+12 KiB dsize, +4 KiB psize, +8 KiB ucsize) and back: a synthetic refreservation 4 KiB above ds_unique_bytes
# and dd_reserved 4 KiB above the dir's used (the change crosses BOTH: 8 KiB of it past the refreservation, 4 KiB of
# that past the reservation), both 1 MiB above (absorbed at the dataset), both 0 (all of it up to the root). Judged at
# every level by the identities in DELTA form (zfs_wst_rchk), apart from the transfer arithmetic: Δ unique == Δ
# referenced == the dsize; at the dataset's dir Δ used == Δ max(unique, refreservation), Δ HEAD == the dsize, Δ REFRSRV
# == Δ max(0, refreservation - unique); above it Δ used == Δ max(used, dd_reserved) of the child, Δ CHILD == the child's
# Δ used, Δ CHILD_RSRV == Δ max(0, dd_reserved - used) of the child; everywhere Δ used == Δ Σ breakdown with SNAP still,
# compressed / uncompressed by their deltas; and every field back where it started after each round trip. Scratch:
# ZWA_OS + 0x380000 (three snapshots).
# The fields judged into out: the dataset's referenced / compressed / uncompressed / unique, then per dsl_dir from dd up
# (at most 16): used, compressed, uncompressed, reserved, the 5 breakdown slots, flags (80 B). Levels / -1.
fn zfs_wst_rsnap(dsobj, dd, out) {
    var dn = zfs_wmos_dn(dsobj);
    if (dn == 0) { return 0 - 1; }
    var b = zfs_bonus(dn);
    memcpy(out, b + 72, 32);
    var n = 0;
    while (dd != 0 && n < 16) {
        dn = zfs_wmos_dn(dd);
        if (dn == 0) { return 0 - 1; }
        b = zfs_bonus(dn);
        var o = out + 32 + n * 80;
        memcpy(o, b + 40, 24);
        store64(o + 24, load64(b + 72));
        memcpy(o + 32, b + 104, 40);
        store64(o + 72, load64(b + 96));
        dd = load64(b + 16);
        n = n + 1;
    }
    if (dd != 0) { return 0 - 1; }
    return n;
}
# The identities between snapshots a (before) and b (after) of n levels, for a change of x dsize / c psize / u ucsize
# under refreservation r. 0 / the first level that breaks + 1 (1 = the dataset's fields).
fn zfs_wst_rchk(a, b, n, x, c, u, r) {
    var ua = load64(a + 24);
    var ub = load64(b + 24);
    if (load64(b) - load64(a) != x || load64(b + 8) - load64(a + 8) != c || load64(b + 16) - load64(a + 16) != u || ub - ua != x) { return 1; }
    var i = 0;
    while (i < n) {
        var oa = a + 32 + i * 80;
        var ob = b + 32 + i * 80;
        var du = load64(ob) - load64(oa);
        var acc = zfs_wst_max(ub, r) - zfs_wst_max(ua, r);
        var dc = 0;
        var dr = 0;
        if (i > 0) {
            var ca = oa - 80;
            var cb = ob - 80;
            acc = zfs_wst_max(load64(cb), load64(ca + 24)) - zfs_wst_max(load64(ca), load64(ca + 24));
            dc = load64(cb) - load64(ca);
            dr = zfs_wst_max(0, load64(ca + 24) - load64(cb)) - zfs_wst_max(0, load64(ca + 24) - load64(ca));
        }
        if (du != acc || load64(ob + 8) - load64(oa + 8) != c || load64(ob + 16) - load64(oa + 16) != u || load64(ob + 24) != load64(oa + 24)) { return i + 2; }
        if ((load64(oa + 72) & 1) != 0) {
            var d0 = load64(ob + 32) - load64(oa + 32);
            var d1 = load64(ob + 40) - load64(oa + 40);
            var d2 = load64(ob + 48) - load64(oa + 48);
            var d3 = load64(ob + 56) - load64(oa + 56);
            var d4 = load64(ob + 64) - load64(oa + 64);
            if (d0 + d1 + d2 + d3 + d4 != du || d1 != 0) { return i + 2; }
            if (i == 0 && (d0 != x || d2 != 0 || d3 != 0 || d4 != zfs_wst_max(0, r - ub) - zfs_wst_max(0, r - ua))) { return i + 2; }
            if (i > 0 && (d0 != 0 || d4 != 0 || d2 != dc || d3 != dr)) { return i + 2; }
        }
        i = i + 1;
    }
    return 0;
}
fn zfs_wst_resv() {
    var best = 0 - 1;
    var bdep = 0;
    var dn = zfs_wdn(1);
    var i = 0;
    while (i < zfs_nds) {
        var d = 0;
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(zfs_ds(i) + 840), dn) == 0) {
            var dd = load64(zfs_bonus(dn));
            while (dd != 0 && d < 16) {
                if (zfs_dnode(zfs_mem + ZR_MOS, dd, dn) != 0) {
                    dd = 0;
                    d = 0;
                } else {
                    dd = load64(zfs_bonus(dn) + 16);
                    d = d + 1;
                }
            }
            if (dd != 0) { d = 0; }
        }
        if (d > bdep) {
            bdep = d;
            best = i;
        }
        i = i + 1;
    }
    if (best < 0) {
        zfs_wss("zfs-wb3: resv skipped (no readable dataset)");
        serial_println("", 0);
        return 0;
    }
    memcpy(&zfs_wc_rbp, zfs_mem + ZR_UB + 40, 128);
    var dsobj = load64(zfs_ds(best) + 840);
    var ddn = zfs_wmos_dn(dsobj);
    if (ddn == 0) { return zfs_wst_fail("resv: the dataset's dnode"); }
    var dir = load64(zfs_bonus(ddn));
    var dirdn = zfs_wmos_dn(dir);
    if (dirdn == 0) { return zfs_wst_fail("resv: the dsl_dir's dnode"); }
    var db = zfs_bonus(dirdn);
    var sa = zfs_wmem + ZWA_OS + 0x380000;
    var sx[24];
    store64(&sx, sa);
    store64(&sx + 8, sa + 0x800);
    store64(&sx + 16, sa + 0x1000);
    var dse[128];
    var cfg = 0;
    var n = 0;
    while (cfg < 3) {
        memset(&dse, 0, 128);
        store64(&dse, dsobj);
        store64(&dse + 8, dir);
        var r = 0;
        var rd = 0;
        if (cfg == 0) {
            r = load64(zfs_bonus(ddn) + 96) + 4096;
            rd = load64(db + 40) + 4096;
        } elif (cfg == 1) {
            r = load64(zfs_bonus(ddn) + 96) + 0x100000;
            rd = load64(db + 40) + 0x100000;
        }
        store64(&dse + 48, r);
        store64(db + 72, rd);
        n = zfs_wst_rsnap(dsobj, dir, sa);
        if (n < 1) { return zfs_wst_fail("resv: snapshot"); }
        var leg = 0;
        while (leg < 2) {
            var sg = 1;
            if (leg == 1) { sg = 0 - 1; }
            store64(&dse + 24, sg * 12288);
            store64(&dse + 32, sg * 4096);
            store64(&dse + 40, sg * 8192);
            if (zfs_wd_dsdelta(&dse) != 0) { return zfs_wst_fail("resv: zfs_wd_dsdelta"); }
            var to = load64(&sx + (leg + 1) * 8);
            if (zfs_wst_rsnap(dsobj, dir, to) != n) { return zfs_wst_fail("resv: snapshot"); }
            var bad = zfs_wst_rchk(load64(&sx + leg * 8), to, n, sg * 12288, sg * 4096, sg * 8192, r);
            if (bad != 0) {
                zfs_wnon("set-up ", cfg * 100 + leg * 10 + bad - 1);
                return zfs_wst_fail("resv: an identity does not hold (set-up x 100 + leg x 10 + level)");
            }
            leg = leg + 1;
        }
        if (memeq(sa, load64(&sx + 16), 32 + n * 80) != 1) { return zfs_wst_fail("resv: a round trip did not come back"); }
        cfg = cfg + 1;
    }
    zfs_dirty_reset();
    var ds = zfs_ds(best);
    zfs_wss("zfs-wb3: resv ");
    serial_print(ds + 856, load64(ds + 848));
    zfs_wss(" dsl_dirs=");
    zfs_wsn(n);
    zfs_wss(" crossing / absorbed / above, each there and back ok");
    serial_println("", 0);
    return 0;
}
# --- B10's in-memory exercises (ZFS_WRITE_SELFTEST): what no fixture reaches on disk -----------------------------------
# k.27 (zfs_wst_gang, the pools holding agnostank/gang/gang.bin): a MOS gang predecessor's free — zfs_wgang, which
# zfs_wc_kill runs on one — over a REAL gang tree on the device (gang.bin's first gang L0: headers, children): it counts,
# then frees, exactly the extents it counted, every one a FREE (each header at one allocation unit), then all of it
# undone (zfs_wxl_undo) — the exercise's closing digests prove the allocator as found. No fixture's MOS holds a gang block
# (the forced-ganging txg made none), so the commit path's own run waits for a fragmented pool (design k.108).
fn zfs_wst_gang() {
    var p = "/agnostank/gang/gang.bin";
    var ref = zfs_resolve(p, strlen(p), 0);
    if (ref < 0) { return 0; }
    var dn = zfs_dnslot(4);
    if (zfs_ref_dn(ref, dn) != 0 || load8(dn + 2) != 2) { return zfs_wst_fail("gang: gang.bin unreadable or not two levels"); }
    var l1 = zfs_mc_get(dn + 64);
    if (l1 == 0) { return zfs_wst_fail("gang: gang.bin's L1 unreadable"); }
    var bp[128];
    var k = 0;
    var hit = 0 - 1;
    while (k < zfs_bp_lsize(dn + 64) / 128 && hit < 0) {
        if (zfs_bp_hole(l1 + k * 128) == 0 && (load64(l1 + k * 128 + 8) >> 63) == 1) {
            memcpy(&bp, l1 + k * 128, 128);
            hit = k;
        }
        k = k + 1;
    }
    if (hit < 0) { return zfs_wst_fail("gang: gang.bin holds no gang L0"); }
    var mark = zfs_xl_n;
    var n0 = zfs_wgang(&bp, 0, 0);
    if (n0 <= 0) { return zfs_wst_fail("gang: the tree's count"); }
    if (zfs_xl_n != mark) { return zfs_wst_fail("gang: a count recorded an extent"); }
    var n1 = zfs_wgang(&bp, 0, 1);
    if (n1 != n0 || zfs_xl_n - mark != n0) { return zfs_wst_fail("gang: the free recorded other extents than it counted"); }
    var nh = 0;
    var x = mark;
    while (x < zfs_xl_n) {
        var w = load64(zfs_xl(x));
        if ((w >> 63) == 0) { return zfs_wst_fail("gang: an ALLOC among the free's extents"); }
        var d = 0;
        while (d < 3) {
            var w1 = load64(&bp + d * 16 + 8);
            if ((load64(&bp + d * 16) != 0 || w1 != 0) && (w & ZWK_OFF63) == ((w1 & ZWK_OFF63) << 9)) {
                if (zfs_xl_asz(zfs_xl(x)) != (1 << zfs_ashift)) { return zfs_wst_fail("gang: a header freed at another size than one allocation unit"); }
                nh = nh + 1;
            }
            d = d + 1;
        }
        x = x + 1;
    }
    if (nh == 0) { return zfs_wst_fail("gang: no header among the extents"); }
    if (zfs_wxl_undo(mark) != 0) { return zfs_wst_fail("gang: the undo"); }
    # (B10 review, k.120) every header COPY verifies against DVA[0]'s identity — zio_checksum_gang_verifier's
    # BP_IDENTITY, which zfs_gang_read and zfs_wgang now use for each copy — and one at DVA[d >= 1] does NOT against its
    # own vdev and offset (the identity both used before: such a copy was never readable when DVA[0]'s was lost)
    var pb = load64(&bp + 72);
    if (pb == 0) { pb = load64(&bp + 80); }
    var hdr = zfs_wmem + ZWA_CMP;
    var hc = 0;
    var ho = 0;
    var c = 0;
    while (c < 3) {
        var v0 = load64(&bp + c * 16);
        var v1 = load64(&bp + c * 16 + 8);
        if (v0 != 0 || v1 != 0) {
            var o2 = (v1 & ZWK_OFF63) << 9;
            var gt = 1 << zfs_ashift;
            var gs = 0;
            while (gt >= 512 && gs == 0) {
                if (zfs_rd(o2 + ZK_DATA0, gt, hdr) == 0 && zfs_eck_ok(hdr, gt, load64(&bp) >> 32, (load64(&bp + 8) & ZWK_OFF63) << 9, pb) == 1) { gs = gt; }
                if (gt == 512) { gt = 0; } else { gt = 512; }
            }
            if (gs == 0) { return zfs_wst_fail("gang: a header copy fails DVA[0]'s identity"); }
            if (zfs_eck_ok(hdr, gs, v0 >> 32, o2, pb) == 1) { ho = ho + 1; }
            hc = hc + 1;
        }
        c = c + 1;
    }
    zfs_wss("zfs-wb3: gang ");
    zfs_wss(p);
    zfs_wss(" L0 ");
    zfs_wsn(hit);
    zfs_wss(": ");
    zfs_wsn(n0);
    zfs_wss(" extent(s) freed (");
    zfs_wsn(nh);
    zfs_wss(" gang header(s)), undone ok; ");
    zfs_wsn(hc);
    zfs_wss(" header copies verified against DVA[0]'s identity (");
    zfs_wsn(ho);
    zfs_wss(" against their own) ok");
    serial_println("", 0);
    return 0;
}
# B10 (zfs_wst_flgrow, every rw pool): a FLUSH whose delta outgrows its space map's block — no fixture's does (every
# space map is one 128 KiB block holding a few KiB) — so the append's growth runs: blocks past dn_maxblkid, the levels
# zfs_wf_levels adds (one blkptr: 1 -> 2), the cursor across a block. The first metaslab in the log system gets a FAKE true
# state, its space map alone with every odd unit flipped (single-unit ALLOC and FREE runs), zfs_wl_flush appends it, and
# the appended words — read back from the DIRTY blocks — replayed strictly onto the space map alone must give that state
# exactly, smp_length / smp_alloc / maxblkid / nlevels as the append left them; then the dirty set dropped (a flush
# allocates nothing) and the bitmap, the table entry and the txg bits restored. Ashift 9 (32,768 units a 16 MiB
# metaslab) crosses a block; ashift 12 (4,096) cannot — the line says which.
fn zfs_wst_flgrow() {
    var i = 0;
    while (i < zfs_ms_count && (load64(zfs_msent(i)) == 0 || load64(zfs_msent(i) + 8) == 0)) { i = i + 1; }
    if (i >= zfs_ms_count) { return 0; }
    var t = zfs_txg + 1;
    var me = zfs_msent(i);
    var sv[64];
    memcpy(&sv, me, 64);
    var s = zfs_ms_load(i);
    if (s < 0) { return zfs_wst_fail("flush: a load"); }
    var x = zfs_bm_a(s);
    var save = zfs_wmem + ZWA_OS + 0x240000;
    memcpy(save, x, zfs_bm_bytes);
    # the space map alone (zfs_wl_flush computes it again into ZWA_FSB), then the fake state
    var sd[512];
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(me), &sd) != 0) { return zfs_wst_fail("flush: the space map"); }
    var y = zfs_wmem + ZWA_FSB;
    memset(y, 0, zfs_bm_bytes);
    zfs_ws_log = 0;
    zfs_ws_ms = i;
    zfs_ws_abm = y;
    zfs_ws_dbm = y;
    if (zfs_wsm_walk(&sd) != 0) { return zfs_wst_fail("flush: the space map's replay"); }
    var len0 = load64(zfs_bonus(&sd) + 8);
    var sa0 = load64(zfs_bonus(&sd) + 16);
    var bsz = load16(&sd + 8) << 9;
    var u = 0;
    while (u < zfs_ms_bits) {
        var bit = (load8(y + (u >> 3)) >> (u & 7)) & 1;
        if ((u & 1) == 1) { bit = 1 - bit; }
        var ba = x + (u >> 3);
        if (bit == 1) { store8(ba, load8(ba) | (1 << (u & 7))); } else { store8(ba, load8(ba) & (255 - (1 << (u & 7)))); }
        u = u + 1;
    }
    var net = (zfs_popc(x, zfs_bm_bytes) - zfs_popc(y, zfs_bm_bytes)) << zfs_ashift;
    store64(me + 48, 1);
    store64(me + 56, net);
    memcpy(&zfs_wc_rbp, zfs_mem + ZR_UB + 40, 128);
    memset(&zfs_wl_fl, 0, 256);
    memset(&zfs_wc_pre, 0, 256);
    var r = zfs_wl_flush(i, t, 0);
    if (r != 0) { return zfs_wst_fail("flush: zfs_wl_flush"); }
    var so = load64(me);
    var dn = zfs_wmos_dn(so);
    if (dn == 0) { return zfs_wst_fail("flush: the dirty space map dnode"); }
    var len1 = load64(zfs_bonus(dn) + 8);
    var mb = load64(dn + 16);
    var nl = load8(dn + 2);
    if (load64(zfs_bonus(dn) + 16) != sa0 + net || mb != (len1 - 1) / bsz || (mb > 0 && nl < 2)) { return zfs_wst_fail("flush: smp_alloc, dn_maxblkid or the levels"); }
    # the appended words, replayed onto the space map alone (a copy): exactly the fake state
    var z = zfs_wmem + ZWA_OS + 0x2C0000;
    memcpy(z, y, zfs_bm_bytes);
    var pos = len0;
    var act = 0 - 1;
    var nw = 0;
    while (pos < len1) {
        var e = zfs_dirty_find(0, so, 0, pos / bsz);
        if (e < 0) { return zfs_wst_fail("flush: an appended block is not dirty"); }
        var b = zfs_dirty_buf(e);
        var w = load64(b + pos % bsz);
        pos = pos + 8;
        nw = nw + 1;
        if ((w >> 62) == 2) {
            if ((w & ZWK_TXG50) != 0) {
                if ((w & ZWK_TXG50) != t || ((w >> 50) & 0x3FF) != 1) { return zfs_wst_fail("flush: a debug word's txg or pass"); }
                act = (w >> 60) & 3;
            }
            continue;
        }
        var ty = 0;
        var st = 0;
        var n = 0;
        if ((w >> 63) == 0) {
            ty = (w >> 15) & 1;
            st = (w >> 16) & ZWK_OFF47;
            n = (w & 0x7FFF) + 1;
        } else {
            if ((pos % bsz) == 0) { return zfs_wst_fail("flush: a two-word entry straddles a block"); }
            var w2 = load64(b + pos % bsz);
            pos = pos + 8;
            ty = (w2 >> 63) & 1;
            st = w2 & ZWK_OFF63;
            n = ((w >> 24) & ZWK_RUN36) + 1;
        }
        if (ty != act) { return zfs_wst_fail("flush: an entry under a debug word of the other type"); }
        var op = 1;
        if (ty == 1) { op = 0; }
        if (st + n > zfs_ms_bits || zfs_bm_op(z, st, n, op) != 0) { return zfs_wst_fail("flush: an appended entry does not replay strictly"); }
    }
    if (memeq(z, x, zfs_bm_bytes) != 1) { return zfs_wst_fail("flush: the replayed append is not the state it flushed"); }
    zfs_wss("zfs-wb3: flush ms ");
    zfs_wsn(i);
    zfs_wss(": ");
    zfs_wsn(nw);
    zfs_wss(" word(s) appended, space map ");
    zfs_wsn(len0);
    zfs_wss(" -> ");
    zfs_wsn(len1);
    zfs_wss(" B, blocks ");
    zfs_wsn(len0 / bsz);
    zfs_wss("..");
    zfs_wsn(mb);
    zfs_wss(", nlevels ");
    zfs_wsn(nl);
    zfs_wss(", replayed back ok");
    serial_println("", 0);
    zfs_dirty_reset();
    memcpy(x, save, zfs_bm_bytes);
    memcpy(me, &sv, 64);
    memset(&zfs_wl_fl, 0, 256);
    memset(&zfs_wc_pre, 0, 256);
    zfs_wl_nf = 0;
    zfs_wl_fo = 0;
    zfs_wl_sf = 0;
    zfs_wl_nw = 0;
    return 0;
}
fn zfs_wst_b3() {
    zfs_wst_bad = 0;
    zfs_wr_lit = 0;
    zfs_dirty_reset();
    if (zfs_wst_dig(1) != (0 - 1)) { return zfs_wst_fail("digest the metaslabs"); }
    if (zfs_wst_main() != 0) { return 0 - 1; }
    if (zfs_wst_evict() != 0) { return 0 - 1; }
    if (zfs_wst_uacct() != 0 || zfs_wst_uafat() != 0 || zfs_wst_resv() != 0) { return 0 - 1; }
    if (zfs_wst_gang() != 0 || zfs_wst_flgrow() != 0) { return 0 - 1; }
    # back to the pool's own residency: every metaslab reloaded, as the exercise found it
    var m = zfs_wst_dig(0);
    if (m == (0 - 2)) { return zfs_wst_fail("a reload failed"); }
    if (m >= 0) {
        zfs_wnon("metaslab ", m);
        return zfs_wst_fail("the allocator differs after the exercise");
    }
    zfs_wss("zfs-wb3: done ok");
    serial_println("", 0);
    return 0;
}
#endif
#ifndef ZFS_WRITE_SELFTEST
fn zfs_wst_b3() { return 0; }
#endif

# --- the entry --------------------------------------------------------------------------------------------------
# The write gate (design § h B1), once, from zfs_init after the reader mounted the pool. Prints the pool's verdict
# and every refused grafted dataset's; the slot's +1016 word records it (1 = writable). Always 0: a refusal is a
# named read-only line, never a failed mount.
fn zfs_wmount() {
    zfs_rw = 0;
    zfs_t0 = zfs_txg;
    zfs_wdef_lo = zfs_txg - 2;                       # (B11) the mount's deferral window, T0 - 2 .. T0 (zfs_wdef_rel moves it)
    var pool = zfs_mem + ZR_POOL;
    var r = zfs_wgate_label();
    if (r == 0) { r = zfs_wmem_get(); }
    if (r == 0) { r = zfs_wgate_mos(); }
    if (r == 0) { r = zfs_wconfig(); }
    if (r == 0) { r = zfs_wtopzap(); }
    if (r == 0) {
        var rd = zfs_wrootdir();
        if (rd == 0) { r = zfs_wno("no root dsl_dir"); }
        else { r = zfs_wdsl(rd); }
    }
    if (r == 0) { r = zfs_wstate(); }
    if (r == 0) { r = zfs_wgate_objs(); }
    kprint("zfs: ", 5);
    kprint(pool, strlen(pool));
    if (r != 0) {
        zfs_wr_print();
        zfs_wmem_put();
        zfs_wd_done();
        return 0;
    }
    kprintln(" rw", 3);
    zfs_rw = 1;
    zfs_wc_first = 1;
    zfs_dirty_reset();
    zfs_wl_hres(zfs_txg + 1);                        # (B10 review, k.119) hygiene's minimum for the first txg
    zfs_worigin();
    var pl = strlen(pool);
    var i = 0;
    while (i < zfs_nds) {
        var ds = zfs_ds(i);
        store64(ds + 1016, 0);
        if (zfs_wds_gate(i) == 0) { store64(ds + 1016, 1); }
        else {
            var nl = load64(ds + 848);
            kprint("zfs: ", 5);
            kprint(ds + 856, nl);
            if (nl == pl) { kprint("/", 1); }        # the root dataset: zdb's "<pool>/"
            zfs_wr_print();
        }
        zfs_wd_ds(i);
        i = i + 1;
    }
    zfs_wst_b3();
    zfs_wd_done();
    return 0;
}

# --- the op list (ZFS_WRITE_OPS; design § i.1) --------------------------------------------------------------------
#ifdef ZFS_WRITE_OPS
# ⭐ THE WRITER'S OP LIST: main.cyr runs it once, right before the ZFS_SELFTEST walk (which then reads back what it
# wrote), under fs_spin_lock like a syscall arm. Each op prints `zfs-wtest: <op> ok` or `zfs-wtest: <op> FAIL <why>`,
# each commit `zfs-wtest: commit txg N`, and the list ends `zfs-wtest: done txg=N ops=M fails=F`. On a READ-ONLY pool
# every op must be REFUSED with nothing written — `zfs-wtest: <op> ok refused (<why>)` — so the refused lanes of
# scripts/smoke/zfs-write-smoke.sh exercise the refusal and stay byte-identical (h4). The list (B3b, B4):
#   ub-only commit   zfs_commit_ub, then an independent read-back: zfs_ub_load re-reads all four rings from the device
#                    and must select txg T0 + 1 naming T0's rootbp — what the next mount, or OpenZFS, will select
#   dataset cow x N  (B4) one block of a file per op rewritten with identical content in a snapshot-free dataset —
#                    the dataset phase end to end (zfs_wt_cows: the fixture pools' targets), each its own txg; the
#                    first one's MOS chain re-planned on disk (zfs_wc_tight)
#   null txg x 3     zfs_commit with nothing dirty (T0 + 2 .. T0 + 4 — three, so the oracle's rewinds to T - 1 and
#                    T - 2 land on agnos's own txgs), each followed by zfs_wt_rb: the next mount's whole state load,
#                    re-run from the device, must equal what the commit published (x 8 on the `full` fixture, below)
# ⛔ Without ZFS_WRITE_OPS nothing calls a commit: the read smoke's kernel writes not one byte (G1, zfs-smoke.sh).
# ⛔ FIXTURE POOLS ONLY: the list runs on every boot of a ZFS_WRITE_OPS image, so it refuses any pool whose name does
# not start with `agnos` — the fixture recipe's names (scripts/tool/zfs-fixture.sh) — and writes nothing to it
# (`zfs-wtest: skipped (pool <name> is not a fixture pool)`). The design's marker skip (§ i.1: a re-boot of an image
# the list already ran on skips it) needs a file the list creates, so it arrives with the create verb (B6) as the
# list's first op; until then each boot of the same image runs the list again — on a fixture pool only, and the
# smokes rebuild every lane disk from the fixture cache per run.
fn zfs_wt_op(op) { kprint("zfs-wtest: ", 11); kprint(op, strlen(op)); return 0; }
fn zfs_wt_why() {
    kprint(zfs_wr_lit, strlen(zfs_wr_lit));
    if (zfs_wr_nml > 0) { kprint(&zfs_wr_nm, zfs_wr_nml); }
    if (zfs_wr_num >= 0) { kprint_num(zfs_wr_num); }
    return 0;
}
fn zfs_wt_fail(op) {
    zfs_wt_f = zfs_wt_f + 1;
    zfs_wt_op(op);
    kprint(" FAIL ", 6);
    zfs_wt_why();
    kprintln("", 0);
    return 0;
}
fn zfs_wt_ubonly() {
    var op = "ub-only commit";
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    var bp[128];
    memcpy(&bp, zfs_mem + ZR_UB + 40, 128);
    var r = zfs_commit_ub();
    if (rw == 0) {
        zfs_wt_op(op);
        if (r == 0 || zfs_txg != t0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return 0;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return 0;
    }
    if (r != 0) { return zfs_wt_fail(op); }
    kprint("zfs-wtest: commit txg ", 22);
    kprint_num(zfs_txg);
    kprintln("", 0);
    # the read-back: what the device now holds, selected exactly as the next mount selects it
    if (zfs_ub_load() != 0) {
        zfs_wfail(t0 + 1, "read-back: no uberblock verifies", 0 - 1);
        return zfs_wt_fail(op);
    }
    if (zfs_txg != t0 + 1) {
        zfs_wfail(t0 + 1, "read-back selected txg ", zfs_txg);
        return zfs_wt_fail(op);
    }
    if (memeq(zfs_mem + ZR_UB + 40, &bp, 128) != 1) {
        zfs_wfail(t0 + 1, "read-back: the rootbp changed", 0 - 1);
        return zfs_wt_fail(op);
    }
    zfs_wt_op(op);
    kprintln(" ok", 3);
    return 0;
}
var zfs_wt_cap = 0;          # the residency the list holds the pool at (0 = the pool's own; see zfs_wtest)
# One commit's figures (zfs_wc_pub calls this before the dirty set goes; serial + console): `zfs-wtest: txg T plan:
# blocks=N chain=C extents=E alloc=A free=F log=L mos=D ds=S dsu=U rounds=R replans=P loads=M pre=P reapply=Q obj=O
# defer=B` (defer: zfs_w_defer once T is published — the deferred bytes zfs_wroom keeps back, B4 review)
# (ds / dsu: the datasets the txg changed and their summed dsize born - killed, B4; replans: the chain re-plans, k.25)
# (udata / charged — B5 review: the user data the commit allocated, Σ dsize of the data blocks born, and the raw
# allocation the space predicates charged before the txg was dirtied; udata > charged is user data that never passed
# them, which zfs-write-smoke fails on every plan line)
# (loads: the metaslab loads the commit made — design § k.21; pre: the units T's FREEs found ALREADY deferred,
# zfs_xl_pre; reapply: such units zfs_wxl_apply re-applied at a reload — design § c.2's overlap rule on disk)
fn zfs_wt_stats(t, ldn) {
    var nc = 0;
    var k = 0;
    while (k < zfs_dx_n) {
        if ((load64(zfs_dent(k) + 56) & ZWD_CHAIN) != 0) { nc = nc + 1; }
        k = k + 1;
    }
    kprint("zfs-wtest: txg ", 15);
    kprint_num(t);
    kprint(" plan: blocks=", 14);
    kprint_num(zfs_dx_n);
    kprint(" chain=", 7);
    kprint_num(nc);
    kprint(" extents=", 9);
    kprint_num(zfs_xl_n);
    kprint(" alloc=", 7);
    kprint_num(zfs_tx_alloc);
    kprint(" free=", 6);
    kprint_num(zfs_tx_free);
    kprint(" log=", 5);
    kprint_num(load64(zfs_bonus(ldn) + 8));
    kprint(" mos=", 5);
    kprint_num(zfs_wc_du);
    var dsu = 0;
    k = 0;
    while (k < zfs_wd_n) {
        dsu = dsu + load64(zfs_dse(k) + 24);
        k = k + 1;
    }
    kprint(" ds=", 4);
    kprint_num(zfs_wd_n);
    kprint(" dsu=", 5);
    kprint_num(dsu);
    kprint(" rounds=", 8);
    kprint_num(zfs_wc_rnd);
    kprint(" replans=", 9);
    kprint_num(zfs_wc_rpl);
    kprint(" loads=", 7);
    kprint_num(zfs_ms_nload);
    var pre = 0;
    k = 0;
    while (k < zfs_xl_n) {
        pre = pre + zfs_xl_pre(zfs_xl(k));
        k = k + 1;
    }
    kprint(" pre=", 5);
    kprint_num(pre);
    kprint(" reapply=", 9);
    kprint_num(zfs_xl_rap);
    kprint(" obj=", 5);
    kprint_num(zfs_wc_lo);
    kprint(" defer=", 7);
    kprint_num(zfs_w_defer);
    kprint(" udata=", 7);
    kprint_num(zfs_wf_ud);
    kprint(" charged=", 9);
    kprint_num(zfs_wf_inflr);
    kprint(" fbpo=", 6);
    kprint_num(zfs_wfb_du);
    kprint(" hist=", 6);
    kprint_num(zfs_wh_n);
    kprint(" dl=", 4);
    kprint_num(zfs_wdl_app);
    kprint(" dlu=", 5);
    kprint_num(zfs_wdl_du);
    kprint(" mat=", 5);
    kprint_num(zfs_wdl_nm);
    kprint(" dlx=", 5);
    kprint_num(zfs_wdl_ux);
    kprintln("", 0);
    # (B10) the txg's log hygiene: flushed / bumped metaslabs, logs destroyed, logs alive after it, ghosts, the least U,
    # flushes whose delta was FREEs only, flushes of a metaslab holding a copy of its own space map's block, words
    # appended, skip (1 a flush did not fit, 2 the ghost table, 3 the destroy reservation), MOS gang predecessors freed
    # since the mount (k.27), (B10 review, k.119) hygiene's minimum this txg's admissions held back (arena bytes)
    kprint("zfs-wtest: txg ", 15);
    kprint_num(t);
    kprint(" hygiene: flushed=", 18);
    kprint_num(zfs_wl_nf);
    kprint(" bumped=", 8);
    kprint_num(zfs_wl_nb);
    kprint(" destroyed=", 11);
    kprint_num(zfs_wl_nd);
    kprint(" logs=", 6);
    kprint_num(zfs_nlogs);
    kprint(" ghosts=", 8);
    kprint_num(zfs_ngho);
    kprint(" minu=", 6);
    kprint_num(zfs_wl_mu);
    kprint(" fonly=", 7);
    kprint_num(zfs_wl_fo);
    kprint(" self=", 6);
    kprint_num(zfs_wl_sf);
    kprint(" words=", 7);
    kprint_num(zfs_wl_nw);
    kprint(" skip=", 6);
    kprint_num(zfs_wl_skip);
    kprint(" gang=", 6);
    kprint_num(zfs_wl_ng);
    kprint(" rsv=", 5);
    kprint_num(zfs_wl_hm);
    if (zfs_wl_skip == 1) {
        kprint(" wait=", 6);
        kprint_num(zfs_wl_wu);
        kprint("+", 1);
        kprint_num(zfs_wl_wn);
        kprint(" xroom=", 7);
        kprint_num(zfs_wl_wr);
    }
    kprintln("", 0);
    return 0;
}
# The READ-BACK of txg t (after each commit of the list): what the device now holds, re-derived the way the NEXT MOUNT
# derives it, must be exactly what the commit published —
#   · zfs_ub_load selects txg t naming the rootbp the commit wrote, and the MOS objset_phys that rootbp names reads
#     back through the reader's checksum path to the published meta-dnode (ZR_MOS)
#   · the writer's whole state load runs again from disk — zfs_wgate_mos (the feature refcounts), zfs_wstate (U[],
#     the log ZAP, which must list t; every log space map checked and summed per metaslab, smp_alloc included; the
#     space-map headers; spacemap_histogram's refcount == space maps + logs; under ZFS_WRITE_SELFTEST every metaslab
#     replayed strictly), zfs_wgate_objs — and must equal the tables the commit published: the log list, each
#     metaslab's space map, U, smp_alloc, allocated bytes, unflushed entries and net, the pool's allocated bytes
#   · every metaslab reloaded from disk (its space map + every log, t's own included — strict) counts exactly the
#     allocated bytes, and for a metaslab the allocator had loaded the deferred bytes, it tracked through the txg
# 0 / -1 named (the caller fails the pool).
fn zfs_wt_rb(t) {
    var rbp[128];
    var mdn[512];
    memcpy(&rbp, zfs_mem + ZR_UB + 40, 128);
    memcpy(&mdn, zfs_mem + ZR_MOS, 512);
    if (zfs_ub_load() != 0 || zfs_txg != t) { return zfs_wnon("read-back selected txg ", zfs_txg); }
    if (memeq(zfs_mem + ZR_UB + 40, &rbp, 128) != 1) { return zfs_wno("read-back: the uberblock names another rootbp"); }
    var os = zfs_mem + ZR_OS;
    if (zfs_bp_read(&rbp, os, 4096) != 0 || load64(os + 704) != 1 || memeq(os, &mdn, 512) != 1) { return zfs_wno("read-back: the MOS objset differs"); }
    var sv = zfs_wmem + ZWA_OS + 0x300000;
    var nl = zfs_nlogs;
    var al = zfs_w_alloc;
    var df = zfs_w_defer;
    var smh = zfs_w_smh;
    var ebr = zfs_w_ebr;
    memcpy(sv, zfs_wmem + ZWA_MS, zfs_ms_count * 64);
    memcpy(sv + 0x20000, zfs_wmem + ZWA_LOG, nl * 16);
    zfs_ms_evall();
    if (zfs_wgate_mos() != 0 || zfs_wstate() != 0 || zfs_wgate_objs() != 0) { return 0 - 1; }
    if (zfs_nlogs != nl || memeq(zfs_wmem + ZWA_LOG, sv + 0x20000, nl * 16) != 1) { return zfs_wno("read-back: the log list differs"); }
    if (load64(zfs_wmem + ZWA_LOG + (nl - 1) * 16) != t) { return zfs_wnon("read-back: the log ZAP lists no txg ", t); }
    if (zfs_w_alloc != al || zfs_w_smh != smh) { return zfs_wno("read-back: the pool's allocated bytes or spacemap_histogram differ"); }
    if (zfs_w_ebr != ebr) { return zfs_wnon("read-back: the empty_bpobj refcount differs: ", zfs_w_ebr); }
    if (zfs_w_defer != df) { return zfs_wnon("read-back: the deferred bytes differ: ", zfs_w_defer); }
    var i = 0;
    while (i < zfs_ms_count) {
        var me = zfs_msent(i);
        var o = sv + i * 64;
        if (memeq(me, o, 32) != 1 || memeq(me + 48, o + 48, 16) != 1) { return zfs_wnon("read-back: the metaslab table differs at ms ", i); }
        if (load64(me) != 0) {
            if (zfs_ms_load(i) < 0) { return 0 - 1; }
            if (load64(me + 24) != load64(o + 24)) { return zfs_wnon("read-back: a reload counts other allocated bytes, ms ", i); }
            if (load64(o + 40) != 0 && load64(me + 32) != load64(o + 32)) { return zfs_wnon("read-back: a reload counts other deferred bytes, ms ", i); }
        }
        i = i + 1;
    }
    if (zfs_wt_cap > 0) {
        zfs_ms_evall();
        zfs_bm_slots = zfs_wt_cap;
    }
    return 0;
}
# THE NULL TXG (B3b): zfs_commit with nothing dirty — log T, the refcount, the log ZAP, U[], the MOS's space, the MOS
# chain to a new rootbp — then the read-back (zfs_wt_rb). Lines: `zfs-wtest: null txg begin txg=T`, the plan's figures
# (zfs_wt_stats), `zfs-wtest: commit txg T`, `zfs-wtest: null txg ok`; on a read-only pool `zfs-wtest: null txg ok
# refused (<why>)` with nothing written.
fn zfs_wt_null() {
    var op = "null txg";
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: null txg begin txg=", 30);
    kprint_num(t0 + 1);
    kprintln("", 0);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var r = zfs_commit();
    if (rw == 0) {
        zfs_wt_op(op);
        if (r == 0 || zfs_txg != t0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return 0;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return 0;
    }
    if (r != 0) { return zfs_wt_fail(op); }
    kprint("zfs-wtest: commit txg ", 22);
    kprint_num(zfs_txg);
    kprintln("", 0);
    if (zfs_wt_rb(t0 + 1) != 0) {
        zfs_wfail_now(t0 + 1);
        return zfs_wt_fail(op);
    }
    zfs_wt_op(op);
    kprintln(" ok", 3);
    return 0;
}
# SHA-256 of level-0 block bid of file ref as the READER sees it now (its own dnode slot 3: no writer memory — the op
# runs on a pool whose writer area a failed commit returned). 0 / -1 (unreadable, or a hole).
fn zfs_wt_hash(ref, bid, out) {
    var dn = zfs_dnslot(3);
    if (zfs_ref_dn(ref, dn) != 0) { return 0 - 1; }
    var b = zfs_obj_blk(dn, bid, 0);
    if (b == 0 || b == 1) { return 0 - 1; }
    zfs_sha256_words(b, load16(dn + 8) << 9, out);
    return 0;
}
# ⭐ THE DATASET COW (B4, design § h): level-0 block bid of the file at path REWRITTEN with identical content —
# zfs_wd_dirty, then zfs_commit, whose dataset phase copies the file's indirects, its dnode block, the dataset's
# meta-dnode chain and objset_phys on write into a new ds_bp, born and killed into the dataset and its dsl_dirs, with
# the user / group / project deltas; then the MOS phase. Then zfs_wt_rb (the next mount's state load == what was
# published), and through the READER at T: the dataset's objset re-read from its new ds_bp == the published slot, the
# file's top-level BP born in T, and the block byte-identical to what it held (SHA-256 before / after). Lines:
# `zfs-wtest: dataset cow begin txg=T <path> block <b>`, the plan's figures, `zfs-wtest: commit txg T`, `zfs-wtest:
# dataset cow ok`; on a read-only pool `zfs-wtest: dataset cow ok refused (<why>)` with nothing written.
fn zfs_wt_cow(path, bid) {
    var op = "dataset cow";
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: dataset cow begin txg=", 33);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" block ", 7);
    kprint_num(bid);
    kprintln("", 0);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var h0[32];
    var h1[32];
    var r = 0 - 1;
    var ref = zfs_resolve(path, strlen(path), 0);
    if (ref < 0 || zfs_res_type != 1) { zfs_wno("no such file"); }
    elif (zfs_wt_hash(ref, bid, &h0) != 0) { zfs_wno("block unreadable before the rewrite"); }
    else { r = zfs_wd_dirty(zfs_ref_di(ref), ref & ZK_MASK48, bid); }
    if (r >= 0) { r = zfs_commit(); }
    if (rw == 0) {
        zfs_wt_op(op);
        if (r == 0 || zfs_txg != t0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return 0;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return 0;
    }
    if (r != 0) { return zfs_wt_fail(op); }
    kprint("zfs-wtest: commit txg ", 22);
    kprint_num(zfs_txg);
    kprintln("", 0);
    if (zfs_wt_rb(t0 + 1) != 0) {
        zfs_wfail_now(t0 + 1);
        return zfs_wt_fail(op);
    }
    var di = zfs_ref_di(ref);
    var dn = zfs_wdn(1);
    var os = zfs_mem + ZR_OS;
    if (zfs_dnode(zfs_mem + ZR_MOS, load64(zfs_ds(di) + 840), dn) != 0 || zfs_bp_read(zfs_bonus(dn) + 128, os, 4096) != 0 || memeq(os, zfs_ds(di), 512) != 1) {
        zfs_wfail(t0 + 1, "read-back: the dataset's objset differs", 0 - 1);
        return zfs_wt_fail(op);
    }
    var fd = zfs_dnslot(3);
    if (zfs_ref_dn(ref, fd) != 0) {
        zfs_wfail(t0 + 1, "read-back: the file's dnode is unreadable", 0 - 1);
        return zfs_wt_fail(op);
    }
    var top = zfs_shr(bid, (load8(fd + 1) - 7) * (load8(fd + 2) - 1));
    if (load64(fd + 64 + top * 128 + 80) != t0 + 1) {
        zfs_wfail(t0 + 1, "read-back: the file's top-level BP was not born in the txg: birth ", load64(fd + 64 + top * 128 + 80));
        return zfs_wt_fail(op);
    }
    if (zfs_wt_hash(ref, bid, &h1) != 0 || memeq(&h0, &h1, 32) != 1) {
        zfs_wfail(t0 + 1, "read-back: the block's content changed", 0 - 1);
        return zfs_wt_fail(op);
    }
    zfs_wt_op(op);
    kprintln(" ok", 3);
    return 0;
}
# The op list's dataset COWs, per fixture pool (design § h B4) — each a separate txg, each a snapshot-free dataset:
#   agnos9     rand-2m.bin block 0 in the ROOT dataset (a 2-level file; the root dsl_dir is the whole chain)
#   agnoswr    quota/q.bin block 3 (a 2-level file in a child with quota 64M / refquota 32M — the EDQUOT predicates),
#              then resv/r.txt block 0 (reservation 16M + refreservation 8M: parent_delta 0 at the dataset AND at its
#              dir, so the root sees only compressed / uncompressed — D13 — and an EMBEDDED predecessor killed)
#   agnostank  sha256/rand-256k.bin block 1 (checksum=sha256: data, indirects, dnode blocks, objset all sha256 — D5),
#              then coff/kid/kid.txt block 0 (three dsl_dirs: kid -> coff (canmount=off) -> the root; embedded)
#   agnosfull  fill-0.bin block 0 at ONE resident bitmap slot (the list's cap), user data next to the slop
# The FIRST COW of each pool reserves 512 B for the MOS chain's indirects on its first attempt (zfs_wc_tight, as the
# second null txg does): its chain is re-planned ON DISK in a txg whose dataset phase has already finalised its blocks
# and edited MOS dnode blocks (the dsl_dataset_phys, the dsl_dirs) — k.25's restore with those in the snapshot (B4
# review: the re-plan had run only in null txgs); on `full` at its one bitmap slot, so the undo reloads.
# B7 (design k.68): agnoswr's two COWs run with the histogram knob (zfs_wh_force) — the first puts every metaslab it
# allocates in into the set at plan time (on wr@u0 the U preset has dirtied the dnode block that holds the space map
# dnodes, so step (1) wrote it and it is DEMOTED), the second only after the chain (the set grows there and the chain is
# RE-PLANNED, after the first's k.25 re-plan) — then `zfs-wtest: histogram set forced on 2 COWs: <d> step-(1)
# block(s) demoted, <r> chain re-plan(s) ok` (at least one re-plan, or FAIL).
fn zfs_wt_cows(pool) {
    zfs_wc_tight = 1;
    if (memeq(pool, "agnos9", 7) == 1) { zfs_wt_cow("/agnos9/rand-2m.bin", 0); }
    elif (memeq(pool, "agnoswr", 8) == 1) {
        var d0 = zfs_wh_ndem;
        var r0 = zfs_wh_nrp;
        zfs_wh_force = 1;
        zfs_wt_cow("/agnoswr/quota/q.bin", 3);
        zfs_wc_tight = 0;
        zfs_wh_force = 2;
        zfs_wt_cow("/agnoswr/resv/r.txt", 0);
        zfs_wh_force = 0;
        kprint("zfs-wtest: histogram set forced on 2 COWs: ", 43);
        kprint_num(zfs_wh_ndem - d0);
        kprint(" step-(1) block(s) demoted, ", 28);
        kprint_num(zfs_wh_nrp - r0);
        if (zfs_wh_nrp > r0) { kprintln(" chain re-plan(s) ok", 20); }
        else {
            zfs_wt_f = zfs_wt_f + 1;
            kprintln(" chain re-plan(s) FAIL", 22);
        }
    } elif (memeq(pool, "agnostank", 10) == 1) {
        zfs_wt_cow("/agnostank/sha256/rand-256k.bin", 1);
        zfs_wc_tight = 0;
        zfs_wt_cow("/agnostank/coff/kid/kid.txt", 0);
    } elif (memeq(pool, "agnosfull", 10) == 1) { zfs_wt_cow("/agnosfull/fill-0.bin", 0); }
    zfs_wc_tight = 0;
    return 0;
}
# --- B5: the op list's FILE-DATA ops (design § h B5, § i.1) ----------------------------------------------------------
# Each op runs what its syscall runs — zfs_wopen (open#7's write check), then zfs_wf_write (write#1) or zfs_wtrunc
# (AO_TRUNC; any length here: the internal any-length truncation an ftruncate would be glue over) — with its bytes
# from agnos-gen-1 by file offset (zfs_wf_mode 1; mode 2: zeros), so scripts/smoke/lib/zfs-expect.py's op list
# (`write PATH OFF LEN SEED` / `zero` / `truncate`) predicts every byte. Then the read-back of the last txg
# (zfs_wt_rb) and the file as the reader sees it at T: `zfs-wtest: F <path> <size> <sha256>`, which the smoke holds to
# the expected manifest before the guest does.
fn zfs_wt_hex64(v) {
    var hx[16];
    var i = 0;
    while (i < 16) {
        var d = (v >> ((15 - i) * 4)) & 0xF;
        if (d < 10) { store8(&hx + i, 48 + d); } else { store8(&hx + i, 87 + d); }
        i = i + 1;
    }
    kprint(&hx, 16);
    return 0;
}
fn zfs_wt_file(path) {
    kprint("zfs-wtest: F ", 13);
    kprint(path, strlen(path));
    kprint(" ", 1);
    var ref = zfs_resolve(path, strlen(path), 0);
    var dn = zfs_dnslot(4);
    if (ref < 0 || zfs_res_type != 1 || zfs_ref_dn(ref, dn) != 0) {
        kprintln("ERR unresolvable", 16);
        return 0 - 1;
    }
    var size = zfs_attr(zfs_ref_di(ref), dn, 1);
    kprint_num(size);
    zfs_sha256_begin();
    var off = 0;
    while (off < size) {
        var n = size - off;
        if (n > 0x10000) { n = 0x10000; }
        var r = zfs_read_ref(ref, off, zfs_mem + ZR_WBUF, n);
        if (r <= 0) {
            kprintln(" ERR unreadable", 15);
            return 0 - 1;
        }
        zfs_sha256_update(zfs_mem + ZR_WBUF, r);
        off = off + r;
    }
    var h[32];
    zfs_sha256_end(&h);
    kprint(" ", 1);
    var i = 0;
    while (i < 4) {
        zfs_wt_hex64(load64(&h + i * 8));
        i = i + 1;
    }
    kprintln("", 0);
    return 0;
}
# The end of a write / trunc op: one `zfs-wtest: commit txg N` per txg it committed, `zfs-wtest: <op> <path> -> <r>
# txgs=<k>`, the read-back, the F line, the verdict — want: r itself · -1 refused (nothing committed) · -2 SHORT
# (0 < r < n). On a read-only pool every op must be refused with nothing committed. r.
fn zfs_wt_wend(op, path, rw, t0, r, n, want) {
    var t = t0 + 1;
    while (t <= zfs_txg) {
        kprint("zfs-wtest: commit txg ", 22);
        kprint_num(t);
        kprintln("", 0);
        t = t + 1;
    }
    var k = zfs_txg - t0;
    zfs_wt_op(op);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" -> ", 4);
    kprint_num(r);
    kprint(" txgs=", 6);
    kprint_num(k);
    kprintln("", 0);
    if (rw == 0) {
        zfs_wt_op(op);
        if (r >= 0 || k != 0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return r;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return r;
    }
    if (k > 0 && zfs_wt_rb(zfs_txg) != 0) {
        zfs_wfail_now(zfs_txg);
        zfs_wt_fail(op);
        return r;
    }
    zfs_wt_obj(path);
    if (want == (0 - 1)) {
        if (r != (0 - 1) || k != 0) {
            zfs_wno("an op the writer must refuse was accepted");
            zfs_wt_fail(op);
            return r;
        }
        zfs_wt_op(op);
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return r;
    }
    if ((want == (0 - 2) && (r <= 0 || r >= n)) || (want != (0 - 2) && r != want)) {
        if (r >= 0) { zfs_wnon("unexpected result ", r); }
        zfs_wt_fail(op);
        return r;
    }
    zfs_wt_op(op);
    kprintln(" ok", 3);
    return r;
}
# A write op: n bytes at off into path — agnos-gen-1 of seed (mode 1) or zeros (mode 2). Lines: `zfs-wtest: write
# begin txg=T <path> off=<o> len=<n> seed=<s>`, the plan line of each txg, then zfs_wt_wend's. r.
fn zfs_wt_w(path, off, n, seed, mode, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: write begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" off=", 5);
    kprint_num(off);
    kprint(" len=", 5);
    kprint_num(n);
    kprint(" seed=", 6);
    kprintln(seed, strlen(seed));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var r = 0 - 1;
    var ref = zfs_resolve(path, strlen(path), 0);
    if (rw == 0) { zfs_wno("pool read-only"); }                # B6: a file the list would have created first
    elif (ref < 0 || zfs_res_type != 1) { zfs_wno("no such file"); }
    elif (zfs_wopen(ref) == 0) {
        zfs_wf_mode = mode;
        zfs_wf_seed = zfs_gen_seed(seed, strlen(seed));
        r = zfs_wf_write(ref, 0, off, 0, n);
        zfs_wf_mode = 0;
    }
    return zfs_wt_wend("write", path, rw, t0, r, n, want);
}
# An op through the FD path (B5 review: finding 4's gate — the syscall arms' own code): open#7's zfs_open with flags —
# AO_WRONLY (1), | AO_TRUNC (0x200) for a truncating open (several txgs: its fd slot reserved meanwhile) — then, for
# n > 0, write#1's zfs_fd_write of n bytes at off (agnos-gen-1 of seed) on that fd: a write of several txgs releases
# fs_lock between them (zfs_wf_yield) and re-checks the fd; its position must end at off + r. The fd is closed after
# (vfs_close_inner: the list holds fs_lock). Lines as zfs_wt_w's / zfs_wt_t's (op `write`, or `trunc` with `len=0`). r.
fn zfs_wt_ofd(path, flags, off, n, seed, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    var op = "write";
    if (n == 0) { op = "trunc"; }
    zfs_wt_op(op);
    kprint(" begin txg=", 11);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    if (n == 0) { kprintln(" len=0", 6); }
    else {
        kprint(" off=", 5);
        kprint_num(off);
        kprint(" len=", 5);
        kprint_num(n);
        kprint(" seed=", 6);
        kprintln(seed, strlen(seed));
    }
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wno("open#7 refused");
    var r = 0 - 1;
    var fd = zfs_open(path, strlen(path), flags);
    if (fd >= 0) {
        var base = vfs_fd_table() + fd * 32;
        r = 0;
        if (n > 0) {
            kpayload_set(base, 0, off);
            zfs_wf_mode = 1;
            zfs_wf_seed = zfs_gen_seed(seed, strlen(seed));
            r = zfs_fd_write(base, 0, n);
            zfs_wf_mode = 0;
            if (r > 0 && kpayload(base, 0) != off + r) {
                zfs_wnon("the fd's position did not end at the write's end: ", kpayload(base, 0));
                r = 0 - 1;
            }
        }
        vfs_close_inner(fd);
    }
    return zfs_wt_wend(op, path, rw, t0, r, n, want);
}
# A write BURST (B5 review: the gates of findings 2 and 3): count write#1s of n bytes at off, off + n, ... — each its
# own txg (policy A), the bytes agnos-gen-1 of seed by FILE offset, so what landed is one `write PATH off total seed` to
# zfs-expect.py — stopping at the first that does not land whole; then zfs_wt_wend over the total (want: count x n,
# or -2 SHORT). Lines: `zfs-wtest: burst begin txg=T <path> off=<o> len=<n> count=<c> seed=<s>`, each txg's plan
# line, `zfs-wtest: burst stopped at write <k>: <why>` when one was refused, then zfs_wt_wend's with `burst`. r.
fn zfs_wt_wb(path, off, n, count, seed, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: burst begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" off=", 5);
    kprint_num(off);
    kprint(" len=", 5);
    kprint_num(n);
    kprint(" count=", 7);
    kprint_num(count);
    kprint(" seed=", 6);
    kprintln(seed, strlen(seed));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var r = 0 - 1;
    var ref = zfs_resolve(path, strlen(path), 0);
    if (ref < 0 || zfs_res_type != 1) { zfs_wno("no such file"); }
    elif (zfs_wopen(ref) == 0) {
        zfs_wf_mode = 1;
        zfs_wf_seed = zfs_gen_seed(seed, strlen(seed));
        var tot = 0;
        var k = 0;
        while (k < count) {
            var w = zfs_wf_write(ref, 0, off + tot, 0, n);
            if (w > 0) { tot = tot + w; }
            if (w != n) {
                kprint("zfs-wtest: burst stopped at write ", 34);
                kprint_num(k + 1);
                kprint(": ", 2);
                zfs_wt_why();
                kprintln("", 0);
                break;
            }
            k = k + 1;
        }
        zfs_wf_mode = 0;
        if (tot > 0) { r = tot; }
    }
    return zfs_wt_wend("burst", path, rw, t0, r, n * count, want);
}
# A truncation op: path to len bytes (len 0 = AO_TRUNC's). want 0 / -1 refused. Lines as zfs_wt_w's. r.
fn zfs_wt_t(path, len, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: trunc begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" len=", 5);
    kprint_num(len);
    kprintln("", 0);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var r = 0 - 1;
    var ref = zfs_resolve(path, strlen(path), 0);
    if (ref < 0 || zfs_res_type != 1) { zfs_wno("no such file"); }
    elif (zfs_wopen(ref) == 0) { r = zfs_wtrunc(ref, len); }
    return zfs_wt_wend("trunc", path, rw, t0, r, 0, want);
}
# --- B6: the op list's CREATE / MKDIR / SYMLINK ops (design § h B6, § i.1) ------------------------------------------
# Each runs what its syscall runs — open#7's zfs_open with AO_CREAT | AO_EXCL | AO_RDWR (the fd closed after), mkdir#9's
# and symlink#63's zfs_wcreate — then zfs_wt_wend: one `zfs-wtest: commit txg N`, `zfs-wtest: <op> <path> -> <r>
# txgs=<k>`, the read-back of the txg, the object as the reader sees it at T (`zfs-wtest: D <path>` / `F <path> <size>
# <sha256>` / `L <path> <target>` — zfs_wt_obj; the smoke holds each to the expected manifest), the verdict; and where it
# went: `zfs-wtest: <op> <path> object <obj>, dnode block <b> of <n>, parent microzap <bytes> B` (the meta-dnode's growth
# and the parent's microzap growth, on disk). scripts/smoke/zfs-write-smoke.sh carries the same list as zfs-expect.py ops.
fn zfs_wt_obj(path) {
    var ref = zfs_resolve(path, strlen(path), 0);
    if (ref >= 0 && zfs_res_type == 2) {
        kprint("zfs-wtest: D ", 13);
        kprintln(path, strlen(path));
        return 0;
    }
    if (ref >= 0 && zfs_res_type == 3) {
        kprint("zfs-wtest: L ", 13);
        kprint(path, strlen(path));
        kprint(" ", 1);
        var tl = zfs_readlink_ref(ref, zfs_mem + ZR_WBUF, 1023);
        if (tl < 0) {
            kprintln("ERR unreadable", 14);
            return 0 - 1;
        }
        kprintln(zfs_mem + ZR_WBUF, tl);
        return 0;
    }
    return zfs_wt_file(path);
}
fn zfs_wt_where(op, path) {
    var pl = strlen(path);
    var ref = zfs_resolve(path, pl, 0);
    if (ref < 0) { return 0; }
    var ds = zfs_ds(zfs_ref_di(ref));
    var obj = ref & ZK_MASK48;
    var i = pl;
    while (i > 0 && load8(path + i - 1) != 47) { i = i - 1; }
    var pr = zfs_resolve(path, i, 1);
    var pdn = zfs_dnslot(4);
    if (pr < 0 || zfs_ref_dn(pr, pdn) != 0) { store8(pdn, 0); }
    zfs_wt_op(op);
    kprint(" ", 1);
    kprint(path, pl);
    kprint(" object ", 8);
    kprint_num(obj);
    kprint(", dnode block ", 14);
    kprint_num(obj / load16(ds + 8));
    kprint(" of ", 4);
    kprint_num(load64(ds + 16) + 1);
    kprint(", parent ", 9);
    zfs_wt_zdesc(pdn);
    if (zfs_wc_lnew != 0) {
        kprint("; a new SA layout ", 18);
        kprint_num(zfs_wc_lnew);
    }
    if (zfs_wz_up > 0) {
        kprint("; ", 2);
        kprint_num(zfs_wz_up);
        kprint(" ZAP upgrade(s)", 15);
    }
    kprintln("", 0);
    return 0;
}
# (B8) A directory's ZAP as the reader sees it at T (dnode at dn): `microzap <bytes> B` — or `fat ZAP <bytes> B: <L>
# leaf(s), table 2^<shift> embedded | in <N> block(s) at <blk>[ doubling to <nextblk>, <copied> copied], freeblk <F>,
# <E> entries`. 0.
fn zfs_wt_zdesc(dn) {
    var bsz = load16(dn + 8) << 9;
    var b = 0;
    if (load8(dn) != 0) { b = zfs_obj_blk(dn, 0, 1); }
    if (b == 0 || load64(b) != ((1 << 63) | 1)) {
        kprint("microzap ", 9);
        kprint_num(bsz);
        kprint(" B", 2);
        return 0;
    }
    kprint("fat ZAP ", 8);
    kprint_num(bsz);
    kprint(" B: ", 4);
    kprint_num(load64(b + 64));
    kprint(" leaf(s), table 2^", 18);
    kprint_num(load64(b + 32));
    if (load64(b + 24) == 0) { kprint(" embedded", 9); }
    else {
        kprint(" in ", 4);
        kprint_num(load64(b + 24));
        kprint(" block(s) at ", 13);
        kprint_num(load64(b + 16));
        if (load64(b + 40) != 0) {
            kprint(" doubling to ", 13);
            kprint_num(load64(b + 40));
            kprint(", ", 2);
            kprint_num(load64(b + 48));
            kprint(" copied", 7);
        }
    }
    kprint(", freeblk ", 10);
    kprint_num(load64(b + 56));
    kprint(", ", 2);
    kprint_num(load64(b + 72));
    kprint(" entries", 8);
    return 0;
}
# One create op: kind 0 `create` (open#7) · 1 `mkdir` · 2 `symlink` to tgt; want 0 or -1 (refused, nothing committed).
fn zfs_wt_c(kind, path, tgt, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    var op = "create";
    if (kind == 1) { op = "mkdir"; }
    elif (kind == 2) { op = "symlink"; }
    zfs_wt_op(op);
    kprint(" begin txg=", 11);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprintln(path, strlen(path));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wz_up = 0;
    var r = 0 - 1;
    if (kind == 0) {
        zfs_wno("open#7 refused");
        var fd = zfs_open(path, strlen(path), 0x2102);
        if (fd >= 0) {
            vfs_close_inner(fd);
            r = 0;
        }
    } else {
        var tl = 0;
        if (kind == 2) { tl = strlen(tgt); }
        r = zfs_wcreate(path, strlen(path), kind, tgt, tl);
    }
    r = zfs_wt_wend(op, path, rw, t0, r, 0, want);
    if (r == 0 && rw == 1) { zfs_wt_where(op, path); }
    return r;
}
# zfs_wt_c of pre followed by the two decimal digits of i (a batch: f00, f01, ...).
fn zfs_wt_cn(pre, i) {
    var b[96];
    var l = strlen(pre);
    memcpy(&b, pre, l);
    store8(&b + l, 48 + i / 10);
    store8(&b + l + 1, 48 + i % 10);
    store8(&b + l + 2, 0);
    return zfs_wt_c(0, &b, 0, 0);
}
# The op list's create ops, per fixture pool — BEFORE the file-data ops (B5 writes on top of them); each one txg:
#   agnos9     the root dataset: mkdir b6, create b6/new.txt + a 7-byte write (the B5 path on a new file; phase C appends
#              to it), mkdir -p b6/p/q/r + a 200,000-byte file in it (block growth, then nlevels 1 -> 2), symlink
#              b6/link -> new.txt (FreeBSD's layout 4), b6/l144 -> a 144-byte target (B6 review: the bonus exactly full,
#              320 B — sa_find_sizes' last fit), REFUSED: a 145-byte target (spill), AO_EXCL on hello.txt; (B8) a 50-byte
#              name — b6's microzap UPGRADED to a fat ZAP, so every later op in b6 is a fat-ZAP add / remove; mkdir
#              b6empty (phase C's rmdir), mkdir b6/many + 9 files: its microzap 512 -> 1024 B
#   agnoswr    the root: b6, b6/a.txt (+ 10 bytes), the symlink b6/sym; rs4k (a child, PROJID layout, 4 KiB records):
#              b6d/c.bin + 9,000 bytes, (B8) a symlink in rs4k — a NEW SA layout there (the LAYOUTS add) —, fat/x (an
#              add to OpenZFS's fat ZAP); REFUSED: creates in ro (readonly=on), insens (case-insensitive) and formd
#              (normalization); utf8 (utf8only, an ASCII name), dnode (dnodesize=auto: one slot, D14), quota/b6q, b6empty
#   agnostank  REFUSED: mkdir in the ZPL-4 zpl4 (read-only; the snapshotted root was until B9); coff/kid (three
#              dsl_dirs): mkdir b6 + 56 files
#              — its meta-dnode holds 55 free slots in its two blocks, so the last creates go to a NEW dnode block past
#              dn_maxblkid, and b6's microzap grows 512 -> 4,096 B; (B8) a symlink — a NEW SA layout in coff/kid —, a
#              50-byte name — b6's 57-entry microzap UPGRADED; b6e (empty), b6/w.txt + 100 bytes
#   agnosfull  b6, b6/a.txt (+ 10 bytes), b6e — at ONE bitmap slot (B8: its symlink op went with B6's no-layout refusal:
#              the pool holds no FreeBSD symlink, the twin the oracle needs)
#   agnoslogs  the same as agnosfull on OpenZFS's many-logs pool
fn zfs_wt_b6(pool) {
    var i = 0;
    if (memeq(pool, "agnos9", 7) == 1) {
        zfs_wt_c(1, "/agnos9/b6", 0, 0);
        zfs_wt_c(0, "/agnos9/b6/new.txt", 0, 0);
        zfs_wt_w("/agnos9/b6/new.txt", 0, 7, "b6/new", 1, 7);
        zfs_wt_c(1, "/agnos9/b6/p", 0, 0);
        zfs_wt_c(1, "/agnos9/b6/p/q", 0, 0);
        zfs_wt_c(1, "/agnos9/b6/p/q/r", 0, 0);
        zfs_wt_c(0, "/agnos9/b6/p/q/r/deep.bin", 0, 0);
        zfs_wt_w("/agnos9/b6/p/q/r/deep.bin", 0, 200000, "b6/deep", 1, 200000);
        zfs_wt_c(2, "/agnos9/b6/link", "new.txt", 0);
        zfs_wt_c(2, "/agnos9/b6/l144", "a-symlink-target-of-exactly-144-bytes-the-most-a-512-byte-dnode-bonus-holds-with-3-aces-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0);
        zfs_wt_c(2, "/agnos9/b6/long", "a-symlink-target-of-145-bytes-which-needs-a-spill-block-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", 0 - 1);
        zfs_wt_c(0, "/agnos9/hello.txt", 0, 0 - 1);
        zfs_wt_c(0, "/agnos9/b6/a-name-of-fifty-bytes-past-the-microzap-limit-nnnn", 0, 0);
        zfs_wt_c(1, "/agnos9/b6empty", 0, 0);
        zfs_wt_c(1, "/agnos9/b6/many", 0, 0);
        while (i < 9) {
            zfs_wt_cn("/agnos9/b6/many/f", i);
            i = i + 1;
        }
    } elif (memeq(pool, "agnoswr", 8) == 1) {
        zfs_wt_c(1, "/agnoswr/b6", 0, 0);
        zfs_wt_c(0, "/agnoswr/b6/a.txt", 0, 0);
        zfs_wt_w("/agnoswr/b6/a.txt", 0, 10, "b6/a", 1, 10);
        zfs_wt_c(2, "/agnoswr/b6/sym", "a.txt", 0);
        zfs_wt_c(1, "/agnoswr/rs4k/b6d", 0, 0);
        zfs_wt_c(0, "/agnoswr/rs4k/b6d/c.bin", 0, 0);
        zfs_wt_w("/agnoswr/rs4k/b6d/c.bin", 0, 9000, "b6/c", 1, 9000);
        zfs_wt_c(2, "/agnoswr/rs4k/b6d/s", "c.bin", 0);
        zfs_wt_c(0, "/agnoswr/ro/x", 0, 0 - 1);
        zfs_wt_c(0, "/agnoswr/insens/x", 0, 0 - 1);
        zfs_wt_c(1, "/agnoswr/formd/x", 0, 0 - 1);
        zfs_wt_c(0, "/agnoswr/fat/x", 0, 0);
        zfs_wt_c(0, "/agnoswr/utf8/plain.txt", 0, 0);
        zfs_wt_c(0, "/agnoswr/dnode/one.txt", 0, 0);
        zfs_wt_c(1, "/agnoswr/quota/b6q", 0, 0);
        zfs_wt_c(1, "/agnoswr/b6empty", 0, 0);
    } elif (memeq(pool, "agnostank", 10) == 1) {
        zfs_wt_c(1, "/agnostank/zpl4/b6", 0, 0 - 1);
        zfs_wt_c(1, "/agnostank/coff/kid/b6", 0, 0);
        while (i < 56) {
            zfs_wt_cn("/agnostank/coff/kid/b6/f", i);
            i = i + 1;
        }
        zfs_wt_c(2, "/agnostank/coff/kid/b6/s", "f00", 0);
        zfs_wt_c(0, "/agnostank/coff/kid/b6/a-name-of-fifty-bytes-past-the-microzap-limit-nnnn", 0, 0);
        zfs_wt_c(1, "/agnostank/coff/kid/b6e", 0, 0);
        zfs_wt_c(0, "/agnostank/coff/kid/b6/w.txt", 0, 0);
        zfs_wt_w("/agnostank/coff/kid/b6/w.txt", 0, 100, "b6/w", 1, 100);
    } elif (memeq(pool, "agnosfull", 10) == 1 || memeq(pool, "agnoslogs", 10) == 1) {
        var b[64];
        var pl = strlen(pool);
        store8(&b, 47);
        memcpy(&b + 1, pool, pl);
        memcpy(&b + 1 + pl, "/b6", 4);
        zfs_wt_c(1, &b, 0, 0);
        memcpy(&b + 1 + pl, "/b6/a.txt", 10);
        zfs_wt_c(0, &b, 0, 0);
        zfs_wt_w(&b, 0, 10, "b6/a", 1, 10);
        memcpy(&b + 1 + pl, "/b6e", 5);
        zfs_wt_c(1, &b, 0, 0);
    }
    return 0;
}
# The op list's file-data ops, per fixture pool (design § h B5 — scripts/smoke/zfs-write-smoke.sh carries the same list
# as zfs-expect.py ops):
#   agnos9     tiny RMW of an embedded 8-byte file · one whole 128 KiB record of rand-2m.bin (not read) · hello.txt
#              26 B -> 300,000 B (single-block growth 512 -> 128 KiB, then 3 records: nlevels 1 -> 2) · a SPARSE write
#              1 MiB past dir20/e01's end (growth, holes 1..7) · AO_TRUNC of rand-2m.bin (16 L0 freed, its L1 a hole)
#   agnostank  RMW in off (recordsize 4 KiB, compression off: two partial blocks) and big1m (1 MiB records) · big1m
#              truncated to 1,572,987 B (the boundary block's tail zeroed, block 2 freed) · an append across gz's last
#              gzip block (RMW: decompress, rewrite OFF) · a partial lzjb block · a zstd partial overwrite (REFUSED) ·
#              128 KiB of zeros over sha256/rand-256k.bin block 1 (a hole of birth T) · gang/gang.bin truncated to 1 MiB
#              (B7: its 8 freed GANG L0s deferred to free_bpobj — refused until B7; the other 8 go with B7's unlink, so
#              both kill paths defer on disk) · AO_TRUNC of sha512/text-64k.txt · (B5 review, finding 2) a
#              BURST of 180 one-block appends to off/rand-200k.bin, each its own txg — so each block sits apart on disk,
#              between its txg's metadata — then the truncation back to 200 KiB that frees all 180: >= 180 FREE extents
#              that do not coalesce in a txg of ~20 dirty blocks (log T, sized from those alone, overflowed it). (B10)
#              250 until B10: every txg's flush now COWs a space map block, its dnode block and the U block too
#              (≈ 45 KB more deferred for the boot a txg — design k.113), and main's list ran out at the slop at its 224th
#              append; k.40's release of deferred frees (bite B11) gives the room back
#   agnoswr    the 0-byte `empty` written (a hole block 0: 512 -> 1,024 B, not dirtied by the growth) · copies=2 RMW ·
#              rs4k (4 KiB records) written at block 1024: nlevels 2 -> 3 · quota/q.bin (refquota 32M) in quota ·
#              (B5 review, finding 1) 20 MiB more of rs4k past 8 MiB — 5,120 blocks, five full L1s, ~10 txgs — and then
#              AO_TRUNC: 5,137 kills, more DVAs than one txg's extent list holds, so >= 2 txgs (k.43 on disk); both
#              through the FD path, as the syscalls run them (zfs_wt_ofd: finding 4's fs_lock release between txgs,
#              the fd re-checked, its position moved per txg; the truncating open's reserved slot) · (finding 3) a
#              BURST of one-block appends at 8 MiB, each its own txg, until
#              the metaslabs agnos allocates in are full (4 of wr's 15 have a space map; every txg defers ~0.27 MB for
#              the boot): SHORT, refused by the write's predicate (ENOSPC, named) — never by a commit
#   agnosfull  fill-5.bin extended by 4 MiB at ONE bitmap slot: SHORT at the slop (the in-flight predicate cuts the
#              txgs, k.36), then 128 KiB more: REFUSED (ENOSPC)
fn zfs_wt_b5(pool) {
    if (memeq(pool, "agnos9", 7) == 1) {
        zfs_wt_w("/agnos9/dir20/e00", 3, 10, "b5/tiny", 1, 10);
        zfs_wt_w("/agnos9/rand-2m.bin", 393216, 131072, "b5/rec", 1, 131072);
        zfs_wt_w("/agnos9/hello.txt", 0, 300000, "b5/multi", 1, 300000);
        zfs_wt_w("/agnos9/dir20/e01", 1048581, 777, "b5/sparse", 1, 777);
        zfs_wt_t("/agnos9/rand-2m.bin", 0, 0);
    } elif (memeq(pool, "agnostank", 10) == 1) {
        zfs_wt_w("/agnostank/off/rand-200k.bin", 29672, 6000, "b5/off", 1, 6000);
        zfs_wt_w("/agnostank/big1m/rand-3m.bin", 1052897, 10000, "b5/big1m", 1, 10000);
        zfs_wt_t("/agnostank/big1m/rand-3m.bin", 1572987, 0);
        zfs_wt_w("/agnostank/gz/text-1m.txt", 1047576, 5000, "b5/gz", 1, 5000);
        zfs_wt_w("/agnostank/lzjb/text-1m.txt", 500000, 100, "b5/lzjb", 1, 100);
        zfs_wt_w("/agnostank/zstd/text-1m.txt", 100, 10, "b5/zstd", 1, 0 - 1);
        zfs_wt_w("/agnostank/sha256/rand-256k.bin", 131072, 131072, "zeros", 2, 131072);
        zfs_wt_t("/agnostank/gang/gang.bin", 1048576, 0);
        zfs_wt_t("/agnostank/sha512/text-64k.txt", 0, 0);
        zfs_wt_wb("/agnostank/off/rand-200k.bin", 204800, 4096, 180, "b5/burst", 737280);
        zfs_wt_t("/agnostank/off/rand-200k.bin", 204800, 0);
    } elif (memeq(pool, "agnoswr", 8) == 1) {
        zfs_wt_w("/agnoswr/empty", 0, 1000, "b5/empty", 1, 1000);
        zfs_wt_w("/agnoswr/copies2/c512k.bin", 100, 50, "b5/c2", 1, 50);
        zfs_wt_w("/agnoswr/rs4k/r64k.bin", 4194404, 100, "b5/rs4k", 1, 100);
        zfs_wt_w("/agnoswr/quota/q.bin", 524288, 4096, "b5/q", 1, 4096);
        zfs_wt_ofd("/agnoswr/rs4k/r64k.bin", 1, 8388608, 20971520, "b5/l1s", 20971520);
        zfs_wt_lazyprobe("/agnoswr/rs4k/r64k.bin");
        # (B7 review, finding 3) the truncation's txgs as on a pool with block_cloning ACTIVE (D15, zfs_wd_defer): every
        # kill — 5,137 L0s and their L1s — DEFERRED to free_bpobj, which grows past its first block and, past
        # dn_nblkptr (3) x 1,024 BPs, a level (zfs_wfb_add -> zfs_wf_levels on a MOS object); OpenZFS frees them at import
        var sf = zfs_w_feat;
        zfs_w_feat = sf | 16;
        zfs_wt_ofd("/agnoswr/rs4k/r64k.bin", 0x201, 0, 0, "", 0);
        zfs_w_feat = sf;
        zfs_wt_fbo();
        # (B11, design k.125) 1 MiB appends: since the deferred frees are released after two txgs a one-block (4 KiB)
        # append grows the pool by its data and its log alone, and 250 of them no longer reach the room's end — measured
        # on B11's first run, all 250 landed. 1 MiB a txg exhausts it, refused by the write's predicate as before
        zfs_wt_wb("/agnoswr/rs4k/r64k.bin", 8388608, 1048576, 250, "b5/exhaust", 0 - 2);
    } elif (memeq(pool, "agnosfull", 10) == 1) {
        var fr = zfs_wt_w("/agnosfull/fill-5.bin", 917504, 4194304, "b5/fill", 1, 0 - 2);
        if (fr > 0) { zfs_wt_w("/agnosfull/fill-5.bin", 917504 + fr, 131072, "b5/fill", 1, 0 - 1); }
    }
    return 0;
}
# --- B7: the op list's UNLINK / RMDIR / RENAME / LINK ops (design § h B7, § i.1) -------------------------------------------
# Each runs what its syscall runs (zfs_wunlink / zfs_wrmdir / zfs_wrename / zfs_wlink), then: `zfs-wtest: commit txg N`,
# `zfs-wtest: <op> <path> -> <r> txgs=<k>`, the read-back of the txg, where the object went — `zfs-wtest: <op> <path>
# object <obj>: freed | on the DELETE_QUEUE | <n> link(s) left | moved` — and the namespace as the reader sees it at T:
# `zfs-wtest: X <path>` for a name that is gone (the smoke drops the earlier D / F / L lines of it and of everything
# under it), the D / F / L line of a new name (zfs_wt_obj); then the verdict. scripts/smoke/zfs-write-smoke.sh carries
# the same list as zfs-expect.py ops (b7_ops).
fn zfs_wt_x(path) {
    if (zfs_resolve(path, strlen(path), 0) >= 0) {
        kprint("zfs-wtest: X ", 13);
        kprint(path, strlen(path));
        kprintln(" FAIL: the name is still there", 30);
        return 0 - 1;
    }
    kprint("zfs-wtest: X ", 13);
    kprintln(path, strlen(path));
    return 0;
}
# One op: kind 0 `unlink` a · 1 `rmdir` a · 2 `rename` a b · 3 `link` a b; want 0 (it must land) / -1 (refused by name,
# nothing committed). r.
fn zfs_wt_u(kind, a, b, want) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    var op = "unlink";
    if (kind == 1) { op = "rmdir"; }
    elif (kind == 2) { op = "rename"; }
    elif (kind == 3) { op = "link"; }
    zfs_wt_op(op);
    kprint(" begin txg=", 11);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(a, strlen(a));
    if (kind >= 2) {
        kprint(" ", 1);
        kprint(b, strlen(b));
    }
    kprintln("", 0);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var ref = zfs_resolve(a, strlen(a), 0);
    var obj = ref & ZK_MASK48;
    var tg = 0 - 2;                              # a rename's target, if it has one (its object goes in the where-line)
    if (kind == 2) { tg = zfs_resolve(b, strlen(b), 0); }
    var ek = 1;                                  # the txgs it must commit: none for a rename onto its own object
    if (kind == 2 && ref >= 0 && tg == ref) { ek = 0; }
    zfs_wno("refused");
    var r = 0 - 1;
    if (kind == 0) { r = zfs_wunlink(a, strlen(a)); }
    elif (kind == 1) { r = zfs_wrmdir(a, strlen(a)); }
    elif (kind == 2) { r = zfs_wrename(a, strlen(a), b, strlen(b)); }
    else { r = zfs_wlink(a, strlen(a), b, strlen(b)); }
    var t = t0 + 1;
    while (t <= zfs_txg) {
        kprint("zfs-wtest: commit txg ", 22);
        kprint_num(t);
        kprintln("", 0);
        t = t + 1;
    }
    var k = zfs_txg - t0;
    zfs_wt_op(op);
    kprint(" ", 1);
    kprint(a, strlen(a));
    kprint(" -> ", 4);
    kprint_num(r);
    kprint(" txgs=", 6);
    kprint_num(k);
    kprintln("", 0);
    if (rw == 0 || want == (0 - 1)) {
        zfs_wt_op(op);
        if (r == 0 || k != 0) {
            if (rw == 0) { kprintln(" FAIL a read-only pool committed", 32); }
            else { kprintln(" FAIL an op the writer must refuse was accepted", 47); }
            zfs_wt_f = zfs_wt_f + 1;
            return r;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return r;
    }
    if (r != 0) {
        zfs_wt_fail(op);
        return r;
    }
    if (k > 0 && zfs_wt_rb(zfs_txg) != 0) {
        zfs_wfail_now(zfs_txg);
        zfs_wt_fail(op);
        return r;
    }
    zfs_wt_op(op);
    kprint(" ", 1);
    kprint(a, strlen(a));
    kprint(" object ", 8);
    kprint_num(obj);
    if (ek == 0) { kprintln(": nothing to do (one object)", 28); }
    elif (kind == 2) {
        kprint(": moved", 7);
        if (zfs_wu_fr + zfs_wu_lz > 0) {
            kprint(" (the target object ", 20);
            kprint_num(tg & ZK_MASK48);
            if (zfs_wu_fr > 0) { kprint(" freed)", 7); } else { kprint(" on the DELETE_QUEUE)", 21); }
        }
        kprintln("", 0);
    } elif (zfs_wu_fr > 0) { kprintln(": freed", 7); }
    elif (zfs_wu_lz > 0) { kprintln(": on the DELETE_QUEUE", 21); }
    else {
        var dn = zfs_dnslot(4);
        kprint(": ", 2);
        if (zfs_ref_dn(ref, dn) == 0) { kprint_num(zfs_attr(zfs_ref_di(ref), dn, 3)); }
        kprintln(" link(s)", 8);
    }
    var bad = 0;
    if (k != ek) { bad = 1; }
    if (ek == 0) {
        if (zfs_wt_obj(a) != 0) { bad = 1; }
    } elif (kind <= 1) {
        if (zfs_wt_x(a) != 0) { bad = 1; }
    } elif (kind == 2) {
        if (zfs_wt_x(a) != 0 || zfs_wt_obj(b) != 0) { bad = 1; }
    } elif (zfs_wt_obj(a) != 0 || zfs_wt_obj(b) != 0) { bad = 1; }
    zfs_wt_op(op);
    if (bad == 1) {
        zfs_wt_f = zfs_wt_f + 1;
        kprintln(" FAIL the namespace after it is not the op's", 44);
        return 0 - 1;
    }
    kprintln(" ok", 3);
    return r;
}
# D11 on disk (design § k.41, k.50): an fd open across the removal of its object, then across the reuse of the object's
# number. kind 0: a file — an AO_RDWR fd on a, then `unlink` a (zfs_wt_u), then read#5 / write#1 / SEEK_END's size must
# each answer -1 (the object is gone: zfs_fd_size); with b, `create` b (zfs_wt_c — first fit takes the freed number,
# which must be a's) and the three must still answer -1 (another object, another ZPL_GEN). kind 1: a directory — an
# AO_DIRECTORY fd on a, `rmdir` a, getdents#29 -1; with b, `mkdir` b into the freed number, getdents still -1. kind 2:
# a file the unlink puts on the DELETE_QUEUE (no b): LINKS 0 — the fd answers -1 as well. kind 3 (B7 review): a
# DIRECTORY the rmdir puts there (no b) — getdents -1 although its generation still matches (zfs_fd_live). Lines:
# `zfs-wtest: fd <a> object <o> after its removal: size <s> read <r> write <w> ok|FAIL` (a directory: getdents <g>) and
# `... reused by <b> object <o2>: ...`.
fn zfs_wt_fdck(base, kind) {
    var buf[16];
    if (kind == 1) {
        var g = zfs_getdents(base, &buf, 16);
        kprint(" getdents ", 10);
        kprint_num(g);
        if (g != (0 - 1)) { return 0 - 1; }
        return 0;
    }
    var s = zfs_fd_size(base);
    var rd = zfs_fd_read(base, &buf, 1);
    var wr = zfs_fd_write(base, &buf, 1);
    kprint(" size ", 6);
    kprint_num(s);
    kprint(" read ", 6);
    kprint_num(rd);
    kprint(" write ", 7);
    kprint_num(wr);
    if (s != (0 - 1) || rd != (0 - 1) || wr != (0 - 1)) { return 0 - 1; }
    return 0;
}
fn zfs_wt_fd(kind, a, b) {
    var uk = kind & 1;                           # 1 / 3: a directory (rmdir) · 0 / 2: a file (unlink)
    if (zfs_rw == 0) {
        # a read-only pool: the same ops, each refused (the list's op count does not depend on the pool's state)
        zfs_wt_u(uk, a, 0, 0);
        if (b != 0) { zfs_wt_c(kind, b, 0, 0); }
        return 0;
    }
    var fl = 2;
    if (uk == 1) { fl = 0x800; }
    var fd = zfs_open(a, strlen(a), fl);
    var ref = zfs_resolve(a, strlen(a), 0);
    var obj = ref & ZK_MASK48;
    if (fd < 0) {
        zfs_wt_fail("fd open");
        return 0 - 1;
    }
    var base = vfs_fd_table() + fd * 32;
    if (zfs_wt_u(uk, a, 0, 0) != 0) {
        vfs_close_inner(fd);
        return 0 - 1;
    }
    kprint("zfs-wtest: fd ", 14);
    kprint(a, strlen(a));
    kprint(" object ", 8);
    kprint_num(obj);
    kprint(" after its removal:", 19);
    var bad = zfs_wt_fdck(base, uk);
    if (bad == 0) { kprintln(" ok", 3); }
    else {
        zfs_wt_f = zfs_wt_f + 1;
        kprintln(" FAIL", 5);
    }
    if (b != 0) {
        if (zfs_wt_c(kind, b, 0, 0) == 0) {
            var nr = zfs_resolve(b, strlen(b), 0);
            kprint("zfs-wtest: fd ", 14);
            kprint(a, strlen(a));
            kprint(" object ", 8);
            kprint_num(obj);
            kprint(" reused by ", 11);
            kprint(b, strlen(b));
            kprint(" object ", 8);
            kprint_num(nr & ZK_MASK48);
            kprint(":", 1);
            bad = zfs_wt_fdck(base, uk);
            if (nr < 0 || (nr & ZK_MASK48) != obj) { bad = 1; }
            if (bad == 0) { kprintln(" ok", 3); }
            else {
                zfs_wt_f = zfs_wt_f + 1;
                kprintln(" FAIL", 5);
            }
        }
    }
    vfs_close_inner(fd);
    return 0;
}
# The op list's B7 ops, per fixture pool — zfs_wt_b7pre right after the B6 ops, before B5's (whose last on agnoswr
# exhausts the metaslabs agnos allocates in and on agnostank leaves its boot-long deferral above the room — measured: a
# rename after them refused, `no space: the pool is at its slop`, k.40), zfs_wt_b7 after them (agnos9's; agnostank's
# unlinks of what B5 wrote — the truncation of gang/gang.bin to 1 MiB — which charge no space: a removal frees; and
# agnosfull's, AFTER B5's fill took the pool to its slop: every txg before the fill deferred its frees for the boot (until B11's release, k.125), so
# B7 ops there left the fill nothing — measured — and at the slop the removals still commit, the rename is refused):
#   agnos9     D11: an fd across the unlink of b6/many/f03 and the create (r03) that reuses its number (first fit: a B6
#              object, so no lower slot is free — measured: dir20/e06's 134 went to 24); unlink a B6 file
#              (b6/many/f00), a FreeBSD file (dir20/e02), a B6 symlink (b6/link) — FreeBSD's `sym` stays: phase B's B-acl
#              holds every created symlink to a FreeBSD twin in its dataset, and it is agnos9's only one; rmdir b6empty;
#              REFUSED rmdir of the non-empty b6/many (ENOTEMPTY); rename in one directory (f01 -> g01), across (f02 ->
#              b6/f02), over an existing file (dir20/e03 -> e04: e04 freed), a DIRECTORY with a subtree across (b6/p ->
#              b6/many/p: its PARENT, both parents' LINKS); REFUSED a directory under itself (EINVAL); link dir20/e05 ->
#              b6/e05 (LINKS 2); the k.15 pair link dir20/e07 -> b6/e07 + unlink b6/e07 (e07's PARENT left on b6); a rename
#              of a name onto itself (no txg); (B7 review, finding 3) the LAZY route for a rename's target (rs.txt over the
#              8 KiB lz2.bin) and for a DIRECTORY under an AO_DIRECTORY fd (lzd: getdents -1 — finding 4), the knob
#              zfs_wu_tight at 1; an empty directory renamed over another across parents (b7s -> b6/b7t: the target
#              freed); unlink of xd.txt, whose xattr lives in an xattr DIRECTORY (RECIPE 6) — LAZY by ZPL_XATTR; REFUSED
#              unlink of a directory (EPERM), rmdir of a file (ENOTDIR), link of a directory (EPERM), rename of a file over
#              a directory (EISDIR)
#   agnoswr    D11 for a DIRECTORY fd: rmdir b6empty, mkdir b6e2 into its number; unlink the HARD LINK hello-link.txt
#              (hello.txt LINKS 2 -> 1), the FreeBSD symlink sym-long (its target in a SPILL block; sym-short stays, the
#              B-acl twin of b6/sym);
#              rename b6/a.txt -> a2.txt, micro/m00 -> b6/m00, the directory deep/a/b (with c/leaf.txt) -> b6/b; rmdir the
#              now empty FreeBSD directory deep/a; link micro/m01 -> m01-link; the k.15 pair micro/m02 -> b6/m02 +
#              unlink; (B8) in OpenZFS's fat ZAP `fat`: unlink f0, rename f1 to a 54-byte name, link micro/m03 into it;
#              REFUSED rename across datasets (EXDEV) and of a mount point, unlink in the read-only `ro`, link of a
#              directory, link across datasets, (B7 review, finding 1) a link and a
#              rename to a non-ASCII name in the utf8only `utf8`; and (zfs_wt_b5, between its 20 MiB write and the
#              truncation) the LAZY bound on a real object: zfs_wt_lazyprobe
#   agnostank  (pre) in coff/kid: unlink b6/f00, rmdir b6e, rename b6/f01 -> f01 (across), b6/w.txt -> b6/w2.txt;
#              REFUSED unlink in the read-only zpl4 (the snapshotted root until B9), rename across datasets; the LAZY path ON DISK
#              (design § f.5): off/lazy.bin created, 64 KiB of 4 KiB records written, then unlinked under an open fd with
#              the knob zfs_wu_tight at 8 (its 16 L0s + L1 "too big" at the 8th kill entry) — LINKS 0, on the DELETE_QUEUE, the fd
#              -1 (a REAL object past the bound, 16 MiB of 4 KiB records, needs room only a fresh pool has: wr's and
#              main's lists left none — measured; the bound itself is zfs_wt_lazyprobe's); (after B5) unlink
#              gang/gang.bin — what B5's truncation left (8 GANG L0s and its L1) is killed through the unlink: the gang
#              blocks DEFERRED to free_bpobj with $FREE charged (design § e.2); unlink dnode/n00 (SA xattrs in a spill,
#              a 2-slot dnode)
#   agnosfull  (after B5's fill, at ONE bitmap slot) unlink b6/a.txt, rmdir b6e — netfree, as OpenZFS's zfs_remove /
#              zfs_rmdir (dmu_tx_mark_netfree): they commit at the slop; REFUSED rename dir/s1.txt -> b6/s1.txt (`no
#              space: the pool is at its slop` — a rename is not netfree)
#   agnoslogs  unlink churn/c000-0 (a FreeBSD file on OpenZFS's many-logs pool), rmdir b6e
# The lazy bound on a REAL object, in memory (B7, design k.10): a txg opened on path's dataset and the object's free
# collected (zfs_wu_free) — it must answer "too big for one txg" with what it held at that point — then the txg
# DROPPED: nothing is committed, the kill list and the dirty set go, and no op is counted (the list's clock does not
# move). `zfs-wtest: lazy probe <path> object <o>: too big for one txg at <n> kill entries / <x> DVAs (kill list
# <ZWF_FRMAX>, extent list <ZWK_MAXXL>) ok`.
fn zfs_wt_lazyprobe(path) {
    if (zfs_rw == 0) { return 0; }
    var ref = zfs_resolve(path, strlen(path), 0);
    var obj = ref & ZK_MASK48;
    zfs_wu_set(0, 0, zfs_ref_di(ref));
    var dse = zfs_wu_begin();
    var r = 0 - 1;
    if (ref >= 0 && dse != 0) {
        var dn = zfs_wos_dn(load64(dse), obj);
        if (dn != 0) { r = zfs_wu_free(dse, obj, dn); }
    }
    zfs_wf_drop();
    kprint("zfs-wtest: lazy probe ", 22);
    kprint(path, strlen(path));
    kprint(" object ", 8);
    kprint_num(obj);
    if (r != 1) {
        zfs_wt_f = zfs_wt_f + 1;
        kprint(": FAIL the free fit one txg (r ", 31);
        kprint_num(r);
        kprintln(")", 1);
        return 0;
    }
    kprint(": too big for one txg at ", 25);
    kprint_num(zfs_wu_kn);
    kprint(" kill entries / ", 16);
    kprint_num(zfs_wu_kx);
    kprint(" DVAs (kill list ", 17);
    kprint_num(ZWF_FRMAX);
    kprint(", extent list ", 14);
    kprint_num(ZWK_MAXXL);
    kprintln(") ok", 4);
    return 0;
}
# (B7 review, finding 3) free_bpobj as the committed MOS holds it: `zfs-wtest: free_bpobj <n> BPs, <b> block(s),
# nlevels <l>` (bpo_num_blkptrs, dn_maxblkid + 1, dn_nlevels).
fn zfs_wt_fbo() {
    var d = zfs_wdn(1);
    if (zfs_w_fbo == 0 || zfs_dnode(zfs_mem + ZR_MOS, zfs_w_fbo, d) != 0) {
        zfs_wt_f = zfs_wt_f + 1;
        kprintln("zfs-wtest: free_bpobj FAIL unreadable", 37);
        return 0 - 1;
    }
    kprint("zfs-wtest: free_bpobj ", 22);
    kprint_num(load64(zfs_bonus(d)));
    kprint(" BPs, ", 6);
    kprint_num(load64(d + 16) + 1);
    kprint(" block(s), nlevels ", 19);
    kprint_num(load8(d + 2));
    kprintln("", 0);
    return 0;
}
