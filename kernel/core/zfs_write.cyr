    if (tot <= ZWK_CSNMAX) {
        zfs_wc_snap = 1;
        zfs_wc_cpy(n, 1);
        memcpy(&zfs_wc_srbp, &zfs_wc_rbp, 128);
        zfs_wc_sdu = zfs_wc_du;
        zfs_wc_sdc = zfs_wc_dc;
    }
    return 0;
}
# Steps (2)-(4) of the MOS chain, re-planned (k.25): the snapshot first — every chain block's bytes, the rootbp and the
# MOS's space, which is all (2)-(4) change (the dn_used of the objects whose blocks are in the chain lives in chain
# blocks: the log's dnode block, the objset_phys) — then attempts until one fits: a reserved indirect whose ZLE output
# outgrew its reservation (zfs_wc_cfin: 1) undoes the attempt's extents (zfs_wxl_undo to the mark: the chain's
# ALLOCs and its predecessors' FREEs — log T was encoded from a sorted COPY, so the list still undoes by position),
# restores the snapshot and plans again with the reservation raised; the attempt after ZWK_RPLMAX re-plans writes
# every chain block OFF. A chain over ZWK_CSNMAX bytes takes no snapshot and goes out OFF at once. B7 (k.68): an
# attempt whose chain took a metaslab below its stored histogram, with that metaslab's space map dnode not in the
# chain yet (zfs_wh_check: 3), is re-planned the same way after zfs_wh_grow puts it there — the walk order, the
# snapshot and the mark rebuilt (a demoted step-(1) block takes its extents out from under the mark) — at most 8
