# Log T's block size for at most ne extents (zfs_wc_plan's bound, below): a two-word entry each — never more than the
# list holds (ZWK_MAXXL) — a debug word per metaslab and type, a pad word per block boundary; the smallest power of
# two >= that and the allocation unit. bs / -1 named.
fn zfs_wc_lbs(ne) {
    if (ne > ZWK_MAXXL) { ne = ZWK_MAXXL; }
    var nd = ne;
    if (nd > zfs_ms_count) { nd = zfs_ms_count; }
    var w = 2 * ne + 2 * nd + 1;
    var bs = 512;
    while (bs < (1 << zfs_ashift) || 8 * (w + (8 * w) / bs + 1) > bs) { bs = bs * 2; }
    if (bs > ZK_METAMAX) { return zfs_wnon("log space map over 128 KiB: bytes ", 8 * w); }
    return bs;
}
# The MOS phase of txg t (the section header's steps (0)-(4)). The dataset phase is done (zfs_wd_phase): every dirty
# dataset block is final and the MOS blocks it dirtied — a dsl_dataset_phys and its dsl_dirs — are in the dirty set
# like any MOS block. 0 · 2 a metaslab whose U is 0 got an entry (k.24: the commit fails by name) · -1 / -2 failed.
fn zfs_wc_plan(t) {
