    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" off=", 5);
    kprint_num(off);
    kprint(" len=", 5);
    kprint_num(n);
    kprint(" seed=", 6);
    kprintln(seed, strlen(seed));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wno("open#7 refused");
    var r = 0 - 1;
    var fd = 0 - 1;
