    if (rw == 1 && r == k * n) {
        kprint("zfs-wtest: b11 ", 15);
        kprint(tag, strlen(tag));
        kprint(" ", 1);
        kprint(path, strlen(path));
        kprint(": ", 2);
        kprint_num(k);
        kprint(" x ", 3);
        kprint_num(n);
        kprint(" through one fd, policy ", 24);
        if (zfs_wp_pol == 1) { kprint("B", 1); } else { kprint("A", 1); }
        kprint(", ", 2);
        kprint_num(zfs_txg - t0);
        kprint(" txg(s): ", 9);
        kprint_num(tw);
        kprint(" during the writes, pending at close ", 37);
        kprint_num(pend);
        kprintln("", 0);
        if (want_t > 0 && zfs_txg - t0 != want_t) {
            zfs_wnon("txgs committed by a write through one fd: ", zfs_txg - t0);
            r = 0 - 1;
        }
    }
    return zfs_wt_wend("write", path, rw, t0, r, k * n, k * n);
}
# B11's COMMIT-BEFORE-OBSERVE op on path (a file of >= 4,000 bytes) and other (another file): 3,000 bytes at 1,000
# written through fd A — pending, no txg; other read through its own fd — still pending; path read through fd B — the
# pending txg COMMITTED first and the read sees the new bytes; stat sees the size. One txg. r.
fn zfs_wt_obsv(path, other) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    kprint("zfs-wtest: write begin txg=", 27);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprintln(" off=1000 len=3000 seed=b11/obs", 31);
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    zfs_wno("open#7 refused");
    var r = 0 - 1;
    var fa = 0 - 1;
    var fo = 0 - 1;
    var fb = 0 - 1;
    if (rw == 0) { zfs_wno("pool read-only"); }                # as zfs_wt_w: a file the list would have created first
    else {
        fa = zfs_open(path, strlen(path), 2);
        fo = zfs_open(other, strlen(other), 0);
        fb = zfs_open(path, strlen(path), 0);
    }
    if (fa >= 0 && fo >= 0 && fb >= 0) {
        var ba = vfs_fd_table() + fa * 32;
        var bo = vfs_fd_table() + fo * 32;
        var bb = vfs_fd_table() + fb * 32;
        var buf = zfs_mem + ZR_WBUF;
        var ex = buf + 0x8000;
        kpayload_set(ba, 0, 1000);
        zfs_wf_mode = 1;
        zfs_wf_seed = zfs_gen_seed("b11/obs", 7);
        var w = zfs_fd_write(ba, 0, 3000);
        zfs_wf_mode = 0;
        var ok = 1;
        var t1 = zfs_txg;
        var p1 = zfs_wp_ref;
