        return 0 - 1;
    }
    var x = zfs_wt_dva(&bp);
    var xa = (load64(&bp) & 0xFFFFFF) << 9;
    var ms = x >> zfs_ms_shift;
    var tp = zfs_txg + 1;
    zfs_wt_fdw("rel-free", path, 1, 0, 1, 131072, "b11/r0", 1);
    zfs_wt_fdw("rel-next", other, 1, 0, 1, 10, "b11/r1", 1);
