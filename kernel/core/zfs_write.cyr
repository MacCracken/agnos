# === ZFS write — agnos 1.57.12, bites B1-B4: the write gate, the read-write state load, the commit of a txg ===
# The writer's half of core/zfs.cyr. B1 decides once, at mount, whether the pool and each grafted dataset may be
# written, and loads the allocator's state the way OpenZFS's own writable import does (spa_ld_log_spacemaps).
# B2 is the first write: zfs_wr (the device write), zfs_eck_set, the flush and zfs_commit_ub (uberblock T0 + 1 naming
# T0's rootbp, all four labels, between two flushes). B3a is the engine — the dirty set, the allocator, frees, the BP
# builder (core/zfs_wenc.cyr) — and B3b the commit of a txg, zfs_commit: the NULL txg, every piece of MOS bookkeeping
# a txg carries (log space map T, the refcount, the log ZAP, U[], the MOS's space, the MOS COWed to a new rootbp;
# the B3b section below). B4 adds the DATASET phase in front of the MOS's (the B4 section): a dirty block of a dataset
# copies its whole chain on write — its indirects, its dnode block, the dataset's meta-dnode chain, its objset_phys —
# into a new ds_bp, born and killed exactly as dsl_dataset_block_born / _kill, the dsl_dir chain moved up to the root
# with parent_delta, user/group/project accounting kept as exact deltas. NOTHING CALLS A COMMIT but the ZFS_WRITE_OPS
# op list (zfs_wtest; scripts/smoke/
# zfs-write-smoke.sh), so a mount still writes NOT ONE BYTE: gate G1 (scripts/smoke/zfs-smoke.sh) compares every
# lane's pool image with the fixture after the boot. The ruled
# design is agnos docs/development/proposals/2026-10-09-zfs-write.md ("design § x"); the on-disk rules, with OpenZFS
# 2.4.2 citations, are agnosticos docs/development/prior-art/zfs-write-prior-art.md ("WPA § n").
#
# zfs_wmount runs from zfs_init right after the reader mounted the pool: boot, one CPU, nobody holds fs_lock yet.
# Every later writer entry point runs under fs_spin_lock like the reader's (zfs.md § 1), so the module
# scratch below (the refusal, the space-map walker's mode) is single-walker state.
# Output: `zfs: <pool> rw` or `zfs: <pool> read-only (<why>)`, then `zfs: <pool>/<ds> read-only (<why>)` for each
# grafted dataset that is refused (the root dataset prints as `<pool>/`, zdb's spelling, so it can never read as the
# pool line). A mount reads each log space map once and each metaslab's space-map HEADER; bitmaps load lazily, on
# first use (zfs_ms_load — OpenZFS's metaslab_load). ZFS_WRITE_SELFTEST replays EVERY metaslab strictly at mount and
# adds a SERIAL-ONLY dump (zfs-wms / zfs-wlog / zfs-wpool / zfs-wzil / zfs-wds) that scripts/smoke/lib/
# zfs-wms-check.py diffs against an independent host replay of the same image.
# ⛔ NO LARGE .bss (the image wall): the writer's state is a second, lazy 10 MiB direct-mapped area (design § g),
# allocated only once the label-level gate has passed and freed again when the pool ends read-only.
# ⛔ AN UNREADABLE KEY IS NEVER "ABSENT" here (zfs_wzu64 / zfs_wzno / zfs_wprop): the reader may fall back to a
# default, but a gate that did would pass a checkpoint, a redacted dataset or readonly=on it could not read.

enum ZfsWA {
    ZWA_OS   = 0x000000;   # [0, 4 MiB) dirty DATA blocks (B3a, zfs_dirty_add). At mount it is scratch: 4 KiB objset_phys,
    ZWA_STK  = 0x001000;   #   the DSL walk's stack (ZWK_DSLMAX x 16 B),
    ZWA_ZIL  = 0x010000;   #   a ZIL head block (raw, <= 1 MiB),
    ZWA_CFG  = 0x200000;   #   the MOS config packed nvlist (<= 1 MiB)
    ZWA_META = 0x400000;   # 2.25 MiB dirty METADATA blocks (B3a, zfs_dirty_add; + 384 KiB, the B10 review: ZWL_HAR) ...
    ZWA_CMP  = 0x640000;   # 128 KiB ... and the compression output (zfs_bp_build's ZLE, zfs_wcomp; <= ZK_METAMAX)
    #   [0x660000, 0x700000) 640 KiB free (the bitmaps' old home, B10 review)
    ZWA_XLS  = 0x700000;   # 64 KiB  B4: the extent list SORTED for log T's encoding (zfs_wc_log) — a copy, so a chain
    #   re-plan (k.25, zfs_wc_chain) can still undo the list by position
    ZWA_CSN  = 0x710000;   # 448 KiB B4: the MOS chain blocks' contents before step (2), restored by a re-plan (k.25)
    ZWA_DN   = 0x780000;   # 4 x 16 KiB writer dnode slots (zfs_wdn; a dnode is up to 32 x 512 B with large_dnode)
    ZWA_MS   = 0x790000;   # 2048 x 64 B per metaslab (zfs_msent): +0 space map object · +8 U, the unflushed txg ·
    # +16 smp_alloc · +24 allocated bytes (smp_alloc + the unflushed net at mount; the bitmap's count once loaded) ·
    # +32 deferred bytes (once loaded) · +40 resident slot + 1 (0 = not resident) · +48 log entries with txg >= U ·
    # +56 their net bytes, ALLOC - FREE (both from the one log scan)
    ZWA_LOG  = 0x7B0000;   # 1024 x 16 B log space maps, ascending txg: +0 txg · +8 object
    ZWA_RES  = 0x7B4000;   # 2048 x 8 B resident bitmap slot -> metaslab + 1 (0 = free)
    ZWA_UBS  = 0x7B8000;   # 8 KiB  the uberblock slot being committed (B2; a slot is <= 8 KiB, VDEV_UBERBLOCK_SHIFT)
    ZWA_DIX  = 0x7BA000;   # 64 KiB the dirty index (B3a): ZWK_MAXDIRTY x 64 B entries (zfs_dent)
    ZWA_DHT  = 0x7CA000;   # 4 KiB  its hash: ZWK_DHASH x u32 (entry + 1, 0 = empty), chained through entry +48
    ZWA_ORD  = 0x7CB000;   # 4 KiB  the commit's walk order: ZWK_MAXDIRTY x u32 entry indices (zfs_dirty_plan)
    ZWA_XL   = 0x7CC000;   # 64 KiB the open txg's extents for log T: ZWK_MAXXL x 16 B (+0 offset | FREE << 63, +8 asize
    #   | for a FREE, the units it found already deferred << 40 — zfs_xl_asz / zfs_xl_pre)
    ZWA_MSX  = 0x7DC000;   # 16 KiB per metaslab (ZWK_MAXMS x 8 B): its first-fit cursor, in allocation units
    ZWA_LDN  = 0x7E0000;   # 2 x 16 KiB the metaslab loader's OWN dnode slots (zfs_wldn): a load can run inside any
    #   allocation or free, so it never touches the zfs_wdn slots a caller may hold
    ZWA_DSX  = 0x7E8000;   # 4 KiB  B4: the open txg's datasets, ZK_MAXDS x 128 B (zfs_dse; layout at zfs_wds_open)
    ZWA_UQ   = 0x7E9000;   # 32 KiB B4: user / group / project deltas, ZWK_MAXUQ x 32 B (zfs_wq_add)
    ZWA_RSV  = 0x7F1000;   # 4 KiB  B4: chain reservations a re-plan raised, ZWK_MAXRSV x 16 B (zfs_wc_rsv)
    ZWA_DSB  = 0x7F2000;   # 4 KiB + 128 B  B9: the open txg's datasets' SNAPSHOT side, ZK_MAXDS x 128 B, indexed like
    #   ZWA_DSX (zfs_dsb; layout at zfs_wdl_open), then one slot that stays ZERO: a dataset entry built outside ZWA_DSX
    #   (the ZFS_WRITE_SELFTEST resv stage's) has no snapshot side (zfs_dsk)
    ZWA_DLE  = 0x7F3200;   # 32 KiB B9: the deadlist entries the open txg reaches, ZWK_MAXDLE x 128 B (zfs_dle; zfs_wdl_load
    #   — 128 B since the B9 review: a truncation scan's counts and zfs_wu_free's saved ones, k.99 / k.102)
    ZWA_TNL  = 0x7FB200;   # 16 KiB (the merge, k.107) the op list's name list (zfs_wt_small_leaf; ZFS_WRITE_OPS) — it
    #   used the free tail at 0x7F2000 in B8's track, where B9's ZWA_DSB / ZWA_DLE live now
    ZWA_GHO  = 0x800000;   # 256 KiB (B10) ghost logs, ZWL_MAXGHO x ZWL_GSZ: a destroyed log's deferral (zfs_wl_kill_logs)
    ZWA_FSB  = 0x840000;   # 512 KiB (B10) a flushed metaslab's space map ALONE as a bitmap (zfs_wl_flush; <= ZWK_BMCAP)
    ZWA_BM   = 0x8C0000;   # 1 MiB  metaslab bitmaps: slot s = allocated (zfs_bm_bytes) then deferred (zfs_bm_bytes)
    #   (moved from 0x600000 by the B10 review, k.119: the metadata arena grew into its place)
    ZWA_END  = 0xA00000;   # (B10) 10 MiB, ZWK_WRUNS 2 MiB runs: [0x9C0000, END) 256 KiB, [0x660000, 0x700000) 640 KiB and
    #   [0x7FF200, 0x800000) 3.5 KiB free
}

enum ZfsWK {
    ZWK_WRUNS   = 5;                    # (B10) the writer area's 2 MiB runs (pmm_alloc_2mb_run): 10 MiB — ZWA_GHO / ZWA_FSB
    ZWK_MAXMS   = 2048;                 # metaslabs: ~200 per vdev up to 3 TB, then one per 16 GiB (vdev.c:2969-3011),
    # so 2048 = a 32 TiB vdev; more refuses by name
    ZWK_MAXLOG  = 1024;                 # log space maps: an export flushes all but the last (spa.c:2058-2094) unless
    # zfs_keep_log_spacemaps_at_export is set (spa.c:2073 — then every log stays); B10 <= 16
    ZWK_DSLMAX  = 1024;                 # DSL depth: OpenZFS nests 50 by default (a tunable, zfs_namecheck.c:56) + %recv
    ZWK_BMCAP   = 0x80000;              # the largest bitmap ever loaded: 512 KiB = a 16 GiB metaslab at ashift 12
    ZWK_BMAREA  = 0x100000;             # 1 MiB of bitmaps (ZWA_BM)
    ZWK_MMP     = 0xA11CEA11;           # ub_mmp_magic
    ZWK_TXG50   = 0x3FFFFFFFFFFFF;      # debug entry: txg, bits 0-49
    ZWK_OFF47   = 0x7FFFFFFFFFFF;       # one-word entry: offset, bits 16-62
    ZWK_RUN36   = 0xFFFFFFFFF;          # two-word entry: run - 1, bits 24-59 of word 0
    ZWK_OFF63   = 0x7FFFFFFFFFFFFFFF;   # two-word entry: offset, bits 0-62 of word 1
    ZWK_SM      = 8;                    # DMU_OT_SPACE_MAP
    ZWK_SMHDR   = 7;                    # DMU_OT_SPACE_MAP_HEADER (the bonus)
    ZWK_SMV1    = 320;                  # sizeof (space_map_phys_t): the bonus spacemap_histogram counts
    ZWK_ZAPMD   = 0xC4;                 # DMU_OTN_ZAP_METADATA: a zapified dataset / dsl_dir (dsl_dataset_is_zapified)
    ZWK_MAXDIRTY = 1024;                # dirty blocks per txg (B3a); full -> the policy commits first (design § b.2)
    ZWK_DHASH   = 1024;                 # dirty-index hash buckets (a power of two: zfs_dhash keeps 10 bits)
    ZWK_MAXXL   = 4096;                 # ALLOC + FREE extents per txg (= ZWK_MAXDIRTY x 3 DVAs + room for frees)
    ZWK_DARENA  = 0x400000;             # the data arena, [ZWA_OS, ZWA_META): the 4 MiB dirty-data bound (design § g)
    ZWK_MARENA  = 0x240000;             # the metadata arena, [ZWA_META, ZWA_CMP): 1.875 MiB + ZWL_HAR (B10 review)
    ZWK_MDRES   = 0x5A0000;             # B5 review: one commit's metadata at worst — the metadata arena x 3 copies (its
    #   slots are asize-rounded; nothing else a commit allocates is metadata) — which no user data may take (zfs_wroom)
    ZWK_SPECIAL = 0x1000000000000;      # 2^48, the first key past every object number (DN_MAX_OBJECT_SHIFT 48)
    ZWK_XLASZ   = 0xFFFFFFFFFF;         # an extent's asize, bits 0-39 of +8 (a DVA's asize is < 2^33)
    ZWK_MAXUQ   = 1024;                 # user/group/project delta entries per txg (B4)
    ZWK_MAXRSV  = 256;                  # chain blocks whose reservation a re-plan raised (B4, k.25)
    ZWK_CSNMAX  = 0x70000;              # the chain snapshot (ZWA_CSN); a bigger chain goes out OFF, unreserved
    ZWK_RPLMAX  = 3;                    # re-plans per txg; the last attempt writes every chain block OFF
    ZWK_MAXDLE  = 256;                  # B9: deadlist entries (snapshot intervals) the open txg's datasets hold in all —
    #   every key of each deadlist it loads, so a head or clone with 256+ keys is refused by name (design § a.3, k.104)
    ZWK_TXGI    = 4;                    # TXG_INITIAL (txg.h): the pool's first txg — no block is born before it (k.101)
}

# The dirty set's keys (design § b.1): (objset, object, level, blkid). objset 0 = the MOS, else the dataset's MOS
# object number. object 1 .. 2^48 - 1 = itself; 0 = the meta-dnode (DMU_META_DNODE_OBJECT); the special dnodes
# that live in objset_phys and OpenZFS numbers -1 / -2 / -3 (DMU_USERUSED / GROUPUSED / PROJECTUSED_OBJECT,
# dmu.h) are 2^48 + 1 / + 2 / + 3 here — kmode initializers cannot be negative and the walk's rank must order
# them; 2^48 is the objset_phys block itself (no dbuf in OpenZFS: os_phys_buf), so it can be dirtied and planned
# like any block. Entry flags (+56): ZWD_DATA a data block (the 4 MiB data arena; else metadata) · ZWD_CHAIN a MOS
# chain block (design § d.2.2: planned after every non-chain block) · ZWD_DONE (B4) a dataset block already finalised
# · bits 8-15 the DMU type its BP carries. (A k.25 chain reservation lives in the PSIZE of the BP zfs_wc_calloc put in
# the parent's copy, and a re-plan's raised one in ZWA_RSV — never in these flags.)
enum ZfsWD {
    ZWD_DATA  = 1;
    ZWD_CHAIN = 2;
    ZWD_DONE  = 4;                      # B4: a dataset block the dataset phase finalised (the MOS phase skips it)
    ZWD_CHG   = 8;                      # B11: a data block a write already charged to the space predicates in this txg
    #   (zfs_wf_write1) — policy B rewrites a block several times in one txg and charges it once
    ZWO_OSB   = 0x1000000000000;        # the objset_phys block
    ZWO_USER  = 0x1000000000001;        # DMU_USERUSED_OBJECT
    ZWO_GROUP = 0x1000000000002;        # DMU_GROUPUSED_OBJECT
    ZWO_PROJ  = 0x1000000000003;        # DMU_PROJECTUSED_OBJECT
}

# zfs_bp_build's policy word: type bits 0-7 · level 8-12 · checksum 16-23 · copies (DVAs) 24-27 · the flags below.
enum ZfsWP {
    ZWP_ZLE  = 0x10000000;              # metadata: zio_write_compress with ZLE (zfs_wcomp) — zeros become a hole
    ZWP_HOLE = 0x20000000;              # without ZWP_ZLE: an all-zero block still becomes a hole (see zfs_bp_build)
    ZWP_USER = 0x40000000;              # user data: its DVAs may not take the pool into its slop (zfs_walloc_bp)
}

var zfs_rw = 0;              # 1 = the pool passed the write gate and no commit has failed since (zfs_wfail)
var zfs_t0 = 0;              # T0, the txg the pool was mounted at — zfs_txg moves with every commit, the rules
# keyed on T0 (design § c.2's deferral) must not
var zfs_wmem = 0;            # direct-map VA of the 10 MiB writer area (0 = none; 8 MiB until B10)
var zfs_wmem_phys = 0;
var zfs_vzap_top = 0;        # MOS object: the top-level vdev's ZAP (MOS config com.delphix:vdev_zap_top)
var zfs_dtl_obj = 0;         # MOS object: the leaf's DTL space map (MOS config DTL; 0 = none — never scrubbed)
var zfs_unfl_obj = 0;        # MOS object: u64 per metaslab = its unflushed txg U[i] (0 = none: every U is 0)
var zfs_ms_array = 0;        # MOS object: u64 per metaslab = its space map object (0 = never synced, all free)
var zfs_ms_shift = 0;
var zfs_ms_count = 0;        # asize >> ms_shift (truncated, vdev.c:1620)
var zfs_ms_bits = 0;         # bitmap bits per metaslab = 1 << (ms_shift - ashift)
var zfs_bm_bytes = 0;
var zfs_bm_slots = 0;        # resident metaslabs: 1 MiB / (2 x bitmap), >= 1 (design § c.2 residency)
var zfs_bm_next = 0;         # round-robin eviction cursor
var zfs_nlogs = 0;
var zfs_w_alloc = 0;         # pool allocated = Σ smp_alloc + Σ unflushed net: the slop baseline (design § c.1)
var zfs_w_defer = 0;         # bytes no allocation may take yet that no space map counts allocated: the FREEs of every
# log with txg >= zfs_wdef_lo — the mount's deferral window, then (B11) the last TXG_DEFER_SIZE = 2 txgs committed
# (zfs_wscan_logs, zfs_wc_pub, zfs_wdef_rel) — dsl_pool_unreserved_space's "deferred" (zfs_wroom; B4 review)
var zfs_wdef_lo = 0;         # (B11, design § b.3, k.40) the deferral window's low txg: the FREEs of every log with txg >= it
# are deferred (never allocated) — T0 - 2 at mount (the mount's window), t - 1 once txg t is durable (zfs_wdef_rel:
# metaslab_sync_done's ms_defer rotation — a free of txg T is allocatable from txg T + 3)
var zfs_wdef_rl = 0;         # (B11) the bytes the last commit's release returned (zfs_wdef_rel; the op list's b11 line)
var zfs_wrel_ev = 0;         # (B11) 1 = the log being released is the mount's (<= T0): its metaslabs are evicted, not cleared
var zfs_origin = 0;          # $ORIGIN@$ORIGIN: every non-clone filesystem's origin and first ds_prev_snap_obj
var zfs_w_feat = 0;          # active: bit 0 log_spacemap · bit 1 spacemap_v2 · bit 2 spacemap_histogram · bit 3 hole_birth
# · bit 4 block_cloning (every kill a free_bpobj append — B7, D15) · ENABLED (refcount entry present, any value —
# spa_feature_is_enabled): bit 5 userobj_accounting · bit 6 project_quota (design § e.3) · ACTIVE again: bit 7 fast_dedup
# (B7: every kill deferred too, design § a.2) · bit 8 livelist (B9: a bpobj allocated now gets the 56-byte bonus,
# bpobj_alloc)
var zfs_w_smh = 0;           # their refcounts: spacemap_histogram (one per space map with a 320-byte bonus),
var zfs_w_lsm = 0;           #   log_spacemap (1 from the log ZAP's creation on, spa_log_spacemap.c:966-976) ·
var zfs_w_ebr = 0;           #   (B9) empty_bpobj: the deadlist entries naming the pool's shared empty bpobj (bpobj.c:38-76)
var zfs_w_unl = 0;           # length of the first active feature NOT on the writer list (name in zfs_wr_nm), 0 = none
var zfs_w_unver = 0;         # 1 = the last objset zfs_wos_read returned was read without a checksum (skein/edonr/blake3)
var zfs_wr_lit = 0;          # the refusal: a reason literal, then an optional name, then an optional number
var zfs_wr_num = 0;
var zfs_wr_nml = 0;
var zfs_wr_nm[8];            # 64 B: the name (a feature guid, a vdev type, a ZAP key)
var zfs_ws_log = 0;          # space-map walker mode: 1 = a log (absolute 512 B units, two-word entries, our vdev)
var zfs_ws_ms = 0;           # the metaslab being loaded; -1 = the one log scan (checks, counts, sums per metaslab)
var zfs_ws_lt = 0;           # the scanned log's txg
var zfs_ws_abm = 0;          # its allocated bitmap, its deferred bitmap
var zfs_ws_dbm = 0;
var zfs_ws_app = 0;          # 1 = this log's entries of zfs_ws_ms are applied (log txg >= U)
var zfs_ws_def = 0;          # 1 = this log's FREEs of zfs_ws_ms are deferred (log txg >= zfs_wdef_lo — B11; T0 - 2 at mount)
var zfs_ms_nload = 0;        # metaslab loads (zfs_ms_load that replayed a space map; the op list prints them per txg)
var zfs_ws_n = 0;            # entries walked · ALLOC bytes · FREE bytes
var zfs_ws_a = 0;
var zfs_ws_f = 0;

# --- the refusal (every reason is named) --------------------------------------------------------------------------
fn zfs_wno(lit) { zfs_wr_lit = lit; zfs_wr_num = 0 - 1; zfs_wr_nml = 0; return 0 - 1; }
fn zfs_wnon(lit, n) { zfs_wno(lit); zfs_wr_num = n; return 0 - 1; }
fn zfs_wnos(lit, s, l) {
    zfs_wno(lit);
    if (l > 63) { l = 63; }
    if (l > 0) { memcpy(&zfs_wr_nm, s, l); zfs_wr_nml = l; }
    return 0 - 1;
}
# A refused ZFS mutation syscall on the kernel log (B6 review, finding 7(3)): `zfs: <verb> refused (<why>)` — what the
# ring-3 gate (scripts/harness/zfs-ring3-test.py) holds each zfsx refusal to, by name and in order. The arms clear
# zfs_wr_lit before the verb runs and print under fs_lock; a -1 that named nothing prints "unnamed". The path is NOT
# printed: it is the caller's bytes.
fn zfs_wr_say(verb) {
    kprint("zfs: ", 5);
    kprint(verb, strlen(verb));
    kprint(" refused (", 10);
    if (zfs_wr_lit == 0) { kprint("unnamed", 7); }
    else {
        kprint(zfs_wr_lit, strlen(zfs_wr_lit));
        if (zfs_wr_nml > 0) { kprint(&zfs_wr_nm, zfs_wr_nml); }
        if (zfs_wr_num >= 0) { kprint_num(zfs_wr_num); }
    }
    kprintln(")", 1);
    return 0;
}
fn zfs_wr_print() {
    kprint(" read-only (", 12);
    kprint(zfs_wr_lit, strlen(zfs_wr_lit));
    if (zfs_wr_nml > 0) { kprint(&zfs_wr_nm, zfs_wr_nml); }
    if (zfs_wr_num >= 0) { kprint_num(zfs_wr_num); }
    kprintln(")", 1);
    return 0;
}

# --- small helpers ------------------------------------------------------------------------------------------------
fn zfs_wdn(k) { return zfs_wmem + ZWA_DN + k * 0x4000; }
fn zfs_wldn(k) { return zfs_wmem + ZWA_LDN + k * 0x4000; }
fn zfs_msent(i) { return zfs_wmem + ZWA_MS + i * 64; }
fn zfs_bm_a(s) { return zfs_wmem + ZWA_BM + s * 2 * zfs_bm_bytes; }
# a > b as u64 (Cyrius compares are signed; >> is logical).
fn zfs_wugt(a, b) {
    if ((a >> 1) > (b >> 1)) { return 1; }
    if ((a >> 1) == (b >> 1) && (a & 1) > (b & 1)) { return 1; }
    return 0;
}
# u64 number i of the object at dn (a hole reads 0). -1 when the block cannot be read or the value has bit 63 set.
fn zfs_wobj_u64(dn, i) {
    var bsz = load16(dn + 8) << 9;
    if (bsz < 512) { return 0 - 1; }
    var per = bsz / 8;
    var b = zfs_obj_blk(dn, i / per, 1);
    if (b == 0) { return 0 - 1; }
    return load64(b + (i % per) * 8);
}
# zfs_zap_u64 under the writer's rule. 1 found · 0 absent · -1 refused (`unreadable: <key>`).
fn zfs_wzu64(dn, name, out) {
    var r = zfs_zap_u64(dn, name, out);
    if (r == 1) { return 1; }
    if (r == (0 - 2)) { return 0; }
    return zfs_wnos("unreadable: ", name, strlen(name));
}
# Refuse with why when name is in the ZAP at dn — present with ANY value, even a u64 array or zero integers (a
# per-dataset feature, dsl_dataset.c:1124-1151). 0 absent / -1 refused.
fn zfs_wzno(dn, name, why) {
    var v = 0;
    var r = zfs_zap_lookup(dn, name, strlen(name), 8, 1, &v);
    if (r == (0 - 2)) { return 0; }
    if (r >= 0) { return zfs_wno(why); }
    return zfs_wnos("unreadable: ", name, strlen(name));
}
# Is n/l one of the space-separated names in list?
fn zfs_wtok(n, l, list) {
    var p = list;
    while (load8(p) != 0) {
        var q = p;
        while (load8(q) != 0 && load8(q) != 32) { q = q + 1; }
        if (q - p == l) { if (memeq(p, n, l) == 1) { return 1; } }
        if (load8(q) == 0) { return 0; }
        p = q + 1;
    }
    return 0;
}
var zfs_wtk_l = 0;           # zfs_wtoki's token length (B6)
# The k-th space-separated token of list: its address (zfs_wtk_l = its length), or 0.
fn zfs_wtoki(list, k) {
    var p = list;
    while (load8(p) != 0) {
        var q = p;
        while (load8(q) != 0 && load8(q) != 32) { q = q + 1; }
        if (k == 0) {
            zfs_wtk_l = q - p;
            return p;
        }
        if (load8(q) == 0) { return 0; }
        p = q + 1;
        k = k - 1;
    }
    return 0;
}
# The writer's feature list (design § a.2): ACTIVE is fine for every one of these — their obligations are met, or
# the datasets/blocks that use them are refused by name. block_cloning_endian only fixes the BRT ZAP's byte order and
# goes active WITH block_cloning on a 2.4 pool (brt.c:482-494); agnos never touches the BRT (every clone kill is
# deferred to free_bpobj, design § e.2). Anything else active (device_removal, obsolete_counts, zpool_checkpoint,
# allocation_classes, resilver_defer, device_rebuild, draid, raidz_expansion, multi_vdev_crash_dump, an unknown
# guid) leaves the pool read-only.
fn zfs_wfeat_listed(n, l) {
    if (zfs_wtok(n, l, "com.delphix:async_destroy com.delphix:empty_bpobj org.illumos:lz4_compress com.delphix:enabled_txg") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.delphix:spacemap_histogram com.delphix:spacemap_v2 com.delphix:log_spacemap com.delphix:hole_birth") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.delphix:extensible_dataset com.delphix:embedded_data com.joyent:filesystem_limits") == 1) { return 1; }
    if (zfs_wtok(n, l, "org.open-zfs:large_blocks org.zfsonlinux:large_dnode org.illumos:sha512 org.illumos:skein") == 1) { return 1; }
    if (zfs_wtok(n, l, "org.illumos:edonr org.openzfs:blake3 org.zfsonlinux:userobj_accounting com.datto:encryption") == 1) { return 1; }
    if (zfs_wtok(n, l, "org.zfsonlinux:project_quota org.freebsd:zstd_compress org.openzfs:zilsaxattr com.delphix:head_errlog") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.klarasystems:vdev_zaps_v2 com.klarasystems:dynamic_gang_header com.delphix:bookmarks") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.datto:bookmark_v2 com.delphix:bookmark_written com.delphix:livelist org.zfsonlinux:longname") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.klarasystems:large_microzap com.truenas:physical_rewrite com.fudosecurity:block_cloning") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.truenas:block_cloning_endian com.klarasystems:fast_dedup com.delphix:redaction_bookmarks") == 1) { return 1; }
    if (zfs_wtok(n, l, "com.delphix:redaction_list_spill com.delphix:redacted_datasets") == 1) { return 1; }
    return 0;
}

# --- bitmaps (design § c.2) ---------------------------------------------------------------------------------------
# Bits [b, b+n) of the bitmap at m. op 1: set, every bit must be clear (an ALLOC) · op 0: clear, every bit must be
# set (a FREE) · op 2: set, unchecked (the deferred map). 0 / -1 at the first bit that breaks the rule — OpenZFS's
# "overlapping" / "removing nonexistent segment" (range_tree.c:351,497,534), a kernel panic at its next import.
fn zfs_bm_op(m, b, n, op) {
    while (n > 0) {
        if ((b & 63) == 0 && n >= 64) {
            var wa = m + (b >> 6) * 8;
            var w = load64(wa);
            if (op == 1) {
                if (w != 0) { return 0 - 1; }
                store64(wa, 0 - 1);
            } elif (op == 0) {
                if (w != (0 - 1)) { return 0 - 1; }
                store64(wa, 0);
            } else { store64(wa, 0 - 1); }
            b = b + 64;
            n = n - 64;
        } else {
            var ba = m + (b >> 3);
            var bit = 1 << (b & 7);
            var v = load8(ba);
            if (op == 1) {
                if ((v & bit) != 0) { return 0 - 1; }
                store8(ba, v | bit);
            } elif (op == 0) {
                if ((v & bit) == 0) { return 0 - 1; }
                store8(ba, v & (255 - bit));
            } else { store8(ba, v | bit); }
            b = b + 1;
            n = n - 1;
        }
    }
    return 0;
}
# Set bits in the nb bytes at m (nb a multiple of 8).
fn zfs_popc(m, nb) {
    var c = 0;
    var i = 0;
    while (i < nb) {
        var x = load64(m + i);
        if (x != 0) {
            x = x - ((x >> 1) & 0x5555555555555555);
            x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333);
            x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F;
            c = c + ((x * 0x0101010101010101) >> 56);
        }
        i = i + 8;
    }
    return c;
}

# Set bits in [b, b+n) of the bitmap at m.
fn zfs_bm_cnt(m, b, n) {
    var c = 0;
    while (n > 0) {
        if ((b & 63) == 0 && n >= 64) {
            c = c + zfs_popc(m + (b >> 3), 8);
            b = b + 64;
            n = n - 64;
        } else {
            c = c + ((load8(m + (b >> 3)) >> (b & 7)) & 1);
            b = b + 1;
            n = n - 1;
        }
    }
    return c;
}

# --- the selftest dump (ZFS_WRITE_SELFTEST): serial only, the reader's zfs_w rule ---------------------------------
#ifdef ZFS_WRITE_SELFTEST
fn zfs_wss(s) { serial_print(s, strlen(s)); return 0; }
fn zfs_wsn(n) { var nb[24]; var l = fmt_int_buf(n, &nb); serial_print(&nb, l); return 0; }
fn zfs_wd_ms(i) {
    var me = zfs_msent(i);
    zfs_wss("zfs-wms: ");
    zfs_wsn(i);
    zfs_wss(" sm=");
    zfs_wsn(load64(me));
    zfs_wss(" alloc=");
    zfs_wsn(load64(me + 24));
    zfs_wss(" U=");
    zfs_wsn(load64(me + 8));
    serial_println("", 0);
    return 0;
}
fn zfs_wd_log(k) {
    var lg = zfs_wmem + ZWA_LOG + k * 16;
    zfs_wss("zfs-wlog: txg=");
    zfs_wsn(load64(lg));
    zfs_wss(" obj=");
    zfs_wsn(load64(lg + 8));
    zfs_wss(" entries=");
    zfs_wsn(zfs_ws_n);
    zfs_wss(" alloc=");
    zfs_wsn(zfs_ws_a);
    zfs_wss(" free=");
    zfs_wsn(zfs_ws_f);
    serial_println("", 0);
    return 0;
}
fn zfs_wd_pool(sm, al, de, un) {
    zfs_wss("zfs-wpool: metaslabs=");
    zfs_wsn(zfs_ms_count);
    zfs_wss(" unflushed_ms=");
    zfs_wsn(un);
    zfs_wss(" logs=");
    zfs_wsn(zfs_nlogs);
    zfs_wss(" sm_alloc=");
    zfs_wsn(sm);
    zfs_wss(" unflushed=");
    zfs_wsn(al - sm);
    zfs_wss(" allocated=");
    zfs_wsn(al);
    zfs_wss(" deferred=");
    zfs_wsn(de);
    zfs_wss(" bitmap=");
    zfs_wsn(zfs_bm_bytes);
    zfs_wss(" resident=");
    zfs_wsn(zfs_bm_slots);
    zfs_wss(" smh=");
    zfs_wsn(zfs_w_smh);
    serial_println("", 0);
    return 0;
}
fn zfs_wd_zil(dsobj, c) {
    zfs_wss("zfs-wzil: ds=");
    zfs_wsn(dsobj);
    zfs_wss(" ");
    if (c == 0) { zfs_wss("empty"); }
    elif (c == 1) { zfs_wss("replay-needed"); }
    elif (c == 2) { zfs_wss("claimed"); }
    elif (c == 3) { zfs_wss("one-allocated-unwritten-block"); }
    elif (c == 4) { zfs_wss("LIVE"); }
    elif (c == 5) { zfs_wss("DANGLING"); }
    else { zfs_wss("UNREADABLE"); }
    if (zfs_w_unver == 1) { zfs_wss(" (objset read unverified)"); }
    serial_println("", 0);
    return 0;
}
fn zfs_wd_ds(di) {
    var ds = zfs_ds(di);
    zfs_wss("zfs-wds: ");
    serial_print(ds + 856, load64(ds + 848));
    if (load64(ds + 1016) == 1) { zfs_wss(" rw"); }
    else {
        zfs_wss(" read-only ");
        zfs_wss(zfs_wr_lit);
        if (zfs_wr_nml > 0) { serial_print(&zfs_wr_nm, zfs_wr_nml); }
        if (zfs_wr_num >= 0) { zfs_wsn(zfs_wr_num); }
    }
    serial_println("", 0);
    return 0;
}
fn zfs_wd_done() { zfs_wss("zfs-wgate: done rw="); zfs_wsn(zfs_rw); serial_println("", 0); return 0; }
#endif
#ifndef ZFS_WRITE_SELFTEST
fn zfs_wd_log(k) { return 0; }
fn zfs_wd_zil(dsobj, c) { return 0; }
fn zfs_wd_ds(di) { return 0; }
fn zfs_wd_done() { return 0; }
#endif

# --- the pool gate: label and uberblock (design § a.2) ------------------------------------------------------------
# A slot OpenZFS's own selection scores with a txg above the chosen one would win over every txg agnos writes — they
# would silently vanish. OpenZFS scores a slot whose read verified its embedded SHA-256 (io_error 0) and whose magic
# is right in either byte order, at any version (vdev_uberblock_load_done, vdev_label.c:1546; uberblock_verify,
# uberblock.c:33-42). So a NATIVE slot counts only when its eck verifies: a copy torn part-way through a commit —
# agnos's own included, its first sector new and its eck stale — is skipped by OpenZFS and here alike, and leaves the
# pool writable at T0 (B2 review: counting it locked the pool read-only until another OS synced past it). A
# BYTE-SWAPPED slot counts on its magic alone: OpenZFS can verify it (zio_checksum_error_impl byteswaps the
# verifier), this reader cannot, so it fails closed. And every verifying copy of T0 must be zero from byte 216 —
# sizeof (uberblock_t) in 2.4.2 — to its eck, as vdev_uberblock_sync writes it: a newer OpenZFS whose uberblock_t
# grew would have fields there that zfs_commit_ub, which copies 216 bytes, would silently drop. 0 / -1.
fn zfs_wub_scan() {
    var sh = zfs_ashift;
    if (sh < 10) { sh = 10; }
    if (sh > 13) { sh = 13; }
    var ss = 1 << sh;
    var ns = ZK_UBRING / ss;
    var ring = zfs_mem + ZR_RAW;
    var l = 0;
    while (l < 4) {
        var ro = zfs_label_off(l) + ZK_UBOFF;
        if (zfs_rd(ro, ZK_UBRING, ring) != 0) { return zfs_wnon("uberblock ring unreadable, label ", l); }
        var i = 0;
        while (i < ns) {
            var s = ring + i * ss;
            var mg = load64(s);
            var tx = 0;
            if (mg == ZK_UBMAGIC) {
                if (zfs_eck_ok(s, ss, ro + i * ss, 0, 0) == 1) {
                    tx = load64(s + 16);
                    if (tx == zfs_txg && memeq(s + 216, zfs_mem + ZR_ZERO, ss - 256) != 1) { return zfs_wno("uberblock has fields past 216 bytes"); }
                }
            } elif (mg == ZK_UBMAGIC_X) { tx = zfs_cx_bswap64(load64(s + 16)); }
            if (zfs_wugt(tx, zfs_txg) == 1) { return zfs_wnon("an uberblock outranks the chosen one: txg ", tx); }
            i = i + 1;
        }
        l = l + 1;
    }
    return 0;
}
fn zfs_wgate_label() {
    var p = zfs_mem + ZR_LBL + 12;
    var end = zfs_mem + ZR_LBL + ZK_NVSIZE - 40;
    var ub = zfs_mem + ZR_UB;
    var st = zfs_nv_u64(p, end, "state");
    if (zfs_nv_ok == 0) { return zfs_wno("label has no state"); }
    if (st != 1) { return zfs_wnon("not exported: label state ", st); }   # EXPORTED only (D7 a)
    if (load64(ub + 8) != 5000) { return zfs_wnon("pool version ", load64(ub + 8)); }
    if (load64(ub) != ZK_UBMAGIC) { return zfs_wno("big-endian pool"); }
    var vt = zfs_nv_find(p, end, "vdev_tree", 19);
    if (vt == 0) { return zfs_wno("label has no vdev_tree"); }
    var ty = zfs_nv_find(vt + 8, end, "type", 9);
    if (ty == 0) { return zfs_wno("label has no vdev type"); }
    var tl = zfs_be32(ty);
    if (zfs_is(ty + 4, tl, "disk") == 0 && zfs_is(ty + 4, tl, "file") == 0) { return zfs_wnos("vdev type ", ty + 4, tl); }
    # MMP: uberblock_update writes delay/config only under multihost (uberblock.c:63-70)
    if (load64(ub + 176) == ZWK_MMP && (load64(ub + 184) != 0 || load64(ub + 192) != 0)) { return zfs_wno("multihost (MMP)"); }
    if (load64(ub + 200) != 0) { return zfs_wno("pool checkpoint"); }
    if ((1 << zfs_ashift) < zfs_lbsz) { return zfs_wnon("ashift below the device LBA size: ashift ", zfs_ashift); }
    # a protected device would fail the commit's first write — named here instead (blk_readonly_on: virtio F_RO, NVMe
    # NSATTR; QEMU 11.1's nvme does NOT report a readonly=on drive, so zfs-write-smoke's ashift9-ro lane is that failure)
    if (blk_readonly_on(zfs_backend) == 1) { return zfs_wno("device is write-protected"); }
    # the commit writes the slot in L2/L3 at psize - 512 KiB / - 256 KiB (vdev_label.c:163-170) — a LABEL only when the
    # partition is the vdev's size: a grown partition or a cut image puts them elsewhere (OpenZFS then rewrites every
    # label, vdev_copy_uberblocks; agnos never writes one, WPA § 2.2), so all four nvlists must verify where they are
    # AND name this vdev (zfs_lbl_ok: the chosen label's pool_guid and leaf guid — the eck verifier is only the offset,
    # so an intact stale label verifies wherever it sits)
    if (zfs_dev_bytes == 0) { return zfs_wno("device size unknown"); }
    var l = 0;
    while (l < 4) {
        if (((zfs_lbl_ok >> l) & 1) == 0) { return zfs_wnon("no valid label of this vdev at L", l); }
        l = l + 1;
    }
    return zfs_wub_scan();
}

# --- the pool gate: the MOS (design § a.2, WPA § 3, § 9) ----------------------------------------------------------
# One feature table (features_for_read / _for_write): note the three the log-space-map writer needs and the two
# refcounts B3 moves or relies on, and the first active feature that is not on the writer list. 0 / -1.
fn zfs_wfeat_zap(od, key) {
    var fo = 0;
    var r = zfs_wzu64(od, key, &fo);
    if (r <= 0) { return r; }
    var fd = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, fo, fd) != 0) { return zfs_wno("feature table unreadable"); }
    var nm = zfs_mem + ZR_NAME;
    var cur = 0;
    r = zfs_zap_next(fd, &cur);
    while (r == 1) {
        var l = zfs_it_nlen;
        if (zfs_it_val != 0) {
            if (zfs_is(nm, l, "com.delphix:log_spacemap") == 1) { zfs_w_feat = zfs_w_feat | 1; zfs_w_lsm = zfs_it_val; }
            if (zfs_is(nm, l, "com.delphix:spacemap_v2") == 1) { zfs_w_feat = zfs_w_feat | 2; }
            if (zfs_is(nm, l, "com.delphix:spacemap_histogram") == 1) { zfs_w_feat = zfs_w_feat | 4; zfs_w_smh = zfs_it_val; }
            if (zfs_is(nm, l, "com.delphix:hole_birth") == 1) { zfs_w_feat = zfs_w_feat | 8; }
            if (zfs_is(nm, l, "com.fudosecurity:block_cloning") == 1) { zfs_w_feat = zfs_w_feat | 16; }
            if (zfs_is(nm, l, "com.klarasystems:fast_dedup") == 1) { zfs_w_feat = zfs_w_feat | 128; }
            if (zfs_is(nm, l, "com.delphix:livelist") == 1) { zfs_w_feat = zfs_w_feat | 256; }
            if (zfs_is(nm, l, "com.delphix:empty_bpobj") == 1) { zfs_w_ebr = zfs_it_val; }
            if (zfs_w_unl == 0 && zfs_wfeat_listed(nm, l) == 0) {
                if (l > 63) { l = 63; }
                memcpy(&zfs_wr_nm, nm, l);
                zfs_w_unl = l;
            }
        }
        if (zfs_is(nm, l, "org.zfsonlinux:userobj_accounting") == 1) { zfs_w_feat = zfs_w_feat | 32; }
        if (zfs_is(nm, l, "org.zfsonlinux:project_quota") == 1) { zfs_w_feat = zfs_w_feat | 64; }
        r = zfs_zap_next(fd, &cur);
    }
    if (r < 0) { return zfs_wno("feature table unreadable"); }
    return 0;
}
fn zfs_wgate_mos() {
    var od = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, 1, od) != 0) { return zfs_wno("MOS directory unreadable"); }
    if (zfs_wzno(od, "com.delphix:zpool_checkpoint", "pool checkpoint") != 0) { return 0 - 1; }
    if (zfs_wzno(od, "com.delphix:removing", "device removal in progress") != 0) { return 0 - 1; }
    var pp = 0;
    var r = zfs_wzu64(od, "pool_props", &pp);
    if (r < 0) { return r; }
    if (r == 1) {
        var pd = zfs_wdn(1);
        if (zfs_dnode(zfs_mem + ZR_MOS, pp, pd) != 0) { return zfs_wno("pool properties unreadable"); }
        var v = 0;
        r = zfs_wzu64(pd, "multihost", &v);
        if (r < 0) { return r; }
        if (r == 1 && v != 0) { return zfs_wno("multihost (MMP)"); }
    }
    zfs_w_feat = 0;
    zfs_w_smh = 0;
    zfs_w_lsm = 0;
    zfs_w_ebr = 0;
    zfs_w_unl = 0;
    if (zfs_wfeat_zap(od, "features_for_read") != 0) { return 0 - 1; }
    if (zfs_wfeat_zap(od, "features_for_write") != 0) { return 0 - 1; }
    # WPA § 6.5-6.6: agnos records a txg only as a log space map (two-word entries) in OpenZFS's format
    if ((zfs_w_feat & 1) == 0) { return zfs_wno("no log_spacemap"); }
    if ((zfs_w_feat & 2) == 0) { return zfs_wno("no spacemap_v2"); }
    if ((zfs_w_feat & 4) == 0) { return zfs_wno("no spacemap_histogram"); }
    if (zfs_w_unl > 0) {
        zfs_wr_lit = "unsupported active feature ";
        zfs_wr_num = 0 - 1;
        zfs_wr_nml = zfs_w_unl;
        return 0 - 1;
    }
    # nothing ever decrements it, and the ZAP it counts is never removed (spa_log_spacemap.c:960-976)
    if (zfs_w_lsm != 1) { return zfs_wnon("log_spacemap refcount ", zfs_w_lsm); }
    return 0;
}
# ⛔ The mount scratch (ZWA_OS / ZWA_STK / ZWA_ZIL / ZWA_CFG) IS the dirty-data arena: every function that writes it
# (zfs_wconfig, zfs_wzil_head, zfs_wzil_ds, zfs_wdsl, zfs_wds_gate) refuses once the open txg holds a dirty block —
# re-running a mount-time check later would overwrite dirty data silently. 0 / -1.
fn zfs_wscr() {
    if (zfs_dx_n != 0 || zfs_dx_data != 0) { return zfs_wno("mount scratch in use: dirty data"); }
    return 0;
}
# The MOS `config` packed nvlist (XDR, its byte size in the bonus — spa_sync_nvlist): the top-level vdev must be
# one disk/file child carrying com.delphix:vdev_zap_top (the label never has it, WPA § 6.1), and its geometry must
# be the label's. Being the leaf too, it names the DTL space map once a scrub/resilver has synced one (vdev.c:3418-
# 3421, :3657-3666) — counted by spacemap_histogram. 0 / -1.
fn zfs_wconfig() {
    if (zfs_wscr() != 0) { return 0 - 1; }
    var od = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, 1, od) != 0) { return zfs_wno("MOS directory unreadable"); }
    var co = 0;
    var r = zfs_wzu64(od, "config", &co);
    if (r < 0) { return r; }
    if (r == 0) { return zfs_wno("no MOS config"); }
    var cd = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, co, cd) != 0 || load16(cd + 10) < 8) { return zfs_wno("MOS config unreadable"); }
    var sz = load64(zfs_bonus(cd));
    var bsz = load16(cd + 8) << 9;
    if (sz < 24 || sz > 0x100000 || bsz < 512) { return zfs_wno("MOS config unreadable"); }
    var buf = zfs_wmem + ZWA_CFG;
    var o = 0;
    while (o < sz) {
        var b = zfs_obj_blk(cd, o / bsz, 1);
        if (b == 0) { return zfs_wno("MOS config unreadable"); }
        var c = sz - o;
        if (c > bsz) { c = bsz; }
        memcpy(buf + o, b, c);
        o = o + bsz;
    }
    if (load8(buf) != 1 || zfs_be32(buf + 4) != 0) { return zfs_wno("MOS config unreadable"); }
    var end = buf + sz;
    var vt = zfs_nv_find(buf + 12, end, "vdev_tree", 19);
    if (vt == 0) { return zfs_wno("MOS config has no vdev_tree"); }
    var ch = zfs_nv_find(vt + 8, end, "children", 20);
    if (ch == 0 || zfs_nv_n != 1) { return zfs_wno("MOS config: not one top-level vdev"); }
    var tp = ch + 8;
    var ty = zfs_nv_find(tp, end, "type", 9);
    if (ty == 0) { return zfs_wno("MOS config has no vdev type"); }
    var tl = zfs_be32(ty);
    if (zfs_is(ty + 4, tl, "disk") == 0 && zfs_is(ty + 4, tl, "file") == 0) { return zfs_wnos("vdev type ", ty + 4, tl); }
    zfs_vzap_top = zfs_nv_u64(tp, end, "com.delphix:vdev_zap_top");
    if (zfs_nv_ok == 0 || zfs_vzap_top <= 0) { return zfs_wno("MOS config names no vdev_zap_top"); }
    zfs_ms_array = zfs_nv_u64(tp, end, "metaslab_array");
    if (zfs_nv_ok == 0 || zfs_ms_array <= 0) { return zfs_wno("MOS config names no metaslab_array"); }
    zfs_ms_shift = zfs_nv_u64(tp, end, "metaslab_shift");
    if (zfs_nv_ok == 0) { return zfs_wno("MOS config names no metaslab_shift"); }
    zfs_dtl_obj = zfs_nv_u64(tp, end, "DTL");
    if (zfs_nv_u64(tp, end, "ashift") != zfs_ashift || zfs_nv_u64(tp, end, "asize") != zfs_asize) { return zfs_wno("label and MOS config disagree"); }
    if (zfs_nv_u64(tp, end, "id") != zfs_top_id) { return zfs_wno("label and MOS config disagree"); }
    return 0;
}
# The top-level vdev ZAP: a checkpoint space map refuses (frees would have to go there, metaslab.c:6075-6100);
# ms_unflushed_phys_txgs names U[] (absent = every U is 0, spa_log_spacemap.c:1291-1294). 0 / -1.
fn zfs_wtopzap() {
    var tz = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, zfs_vzap_top, tz) != 0) { return zfs_wno("top-level vdev ZAP unreadable"); }
    if (zfs_wzno(tz, "com.delphix:pool_checkpoint_sm", "pool checkpoint") != 0) { return 0 - 1; }
    var uo = 0;
    if (zfs_wzu64(tz, "com.delphix:ms_unflushed_phys_txgs", &uo) < 0) { return 0 - 1; }
    zfs_unfl_obj = uo;
    return 0;
}

# --- the ZIL of every head dataset (WPA § 3) ----------------------------------------------------------------------
# Read the objset_phys the BP at src names into dst (4 KiB, zero-filled), from a copy of the BP. An encrypted
# dataset's objset block is AUTHENTICATED, not encrypted (plain bytes, the full checksum, zio_checksum.c:509-511):
# the crypt bit is cleared and DVA[2], which carries no copy there, is dropped. ⚠ A dataset whose metadata uses
# skein / edonr / blake3 (the codec has none of them; the reader never grafts it) is read UNVERIFIED — checksum OFF
# in the copy, zfs_w_unver = 1 — because the pool gate still has to see its ZIL header; only the lz4/gzip length
# check stands behind those bytes, and the ZIL head block they name is verified on its own (zfs_wzil_head).
# ⛔ SOUND ONLY UNDER D7 (a), EXPORTED POOLS: a cleanly exported pool holds no live chain, so a misread header can
# only land in a class that accepts the pool (0, 2, 3) and lose nothing. D7 (b) (forced ACTIVE pools) must refuse a
# pool holding such a dataset or implement those checksums first (zfs.md § 8). 0 / -1.
fn zfs_wos_read(src, dst) {
    var bp[128];
    memcpy(&bp, src, 128);
    var pr = load64(&bp + 48);
    if (((pr >> 61) & 1) == 1) {
        pr = pr & (0 - 1 - (1 << 61));
        store64(&bp + 32, 0);
        store64(&bp + 40, 0);
    }
    var ck = (pr >> 40) & 0xFF;
    zfs_w_unver = 0;
    if (ck >= 12 && ck <= 14) {
        pr = (pr & (0 - 1 - (0xFF << 40))) | (2 << 40);
        zfs_w_unver = 1;
    }
    store64(&bp + 48, pr);
    memset(dst, 0, 4096);
    return zfs_bp_read(&bp, dst, 4096);
}
# Does the ZIL block bp names verify (ZILOG2: zil_chain_t at the start, fletcher4 over roundup(zc_nused, 4 KiB);
# ZILOG: the eck in the last 40 bytes, fletcher2 over the block; the verifier is the BP's own checksum,
# zio_checksum.c:439-525)? 1 a live block · 0 it does not verify (allocated, never written) · -1 unreadable.
fn zfs_wzil_head(bp) {
    var pr = load64(bp + 48);
    var ck = (pr >> 40) & 0xFF;
    var psz = (((pr >> 16) & 0xFFFF) + 1) << 9;
    var w0 = load64(bp);
    var w1 = load64(bp + 8);
    if (((pr >> 39) & 1) == 1 || psz > 0x100000) { return 0 - 1; }
    if ((w0 >> 32) != zfs_top_id || (w1 >> 63) != 0) { return 0 - 1; }   # another vdev, or a gang: not a ZIL block
    if (zfs_wscr() != 0) { return 0 - 1; }
    var buf = zfs_wmem + ZWA_ZIL;
    if (zfs_rd(((w1 & ZWK_OFF63) << 9) + ZK_DATA0, psz, buf) != 0) { return 0 - 1; }
    var eo = 0;
    var n = psz;
    if (ck == 9) {
        var mg = load64(buf + 144);
        if (mg == zfs_cx_bswap64(ZK_ECKMAGIC)) { return 0 - 1; }       # a big-endian writer's chain: not judged here
        if (mg != ZK_ECKMAGIC) { return 0; }
        n = (load64(buf + 136) + 4095) & (0 - 4096);
        if (n <= 0 || n > psz) { return 0; }
        eo = 152;
    } elif (ck == 5) {
        if (load64(buf + psz - 40) != ZK_ECKMAGIC) { return 0; }
        eo = psz - 32;
    } else { return 0 - 1; }
    var sv[32];
    var got[32];
    memcpy(&sv, buf + eo, 32);
    memcpy(buf + eo, bp + 96, 32);
    var rc = 0;
    if (ck == 9) { rc = zfs_fletcher4(buf, n, &got); } else { rc = zfs_fletcher2(buf, n, &got); }
    if (rc != 0) { return 0; }
    if (((pr >> 61) & 1) == 1) {
        # encrypted: checksum words 2-3 carry the MAC; OpenZFS compares (w0 ^ w2, w1 ^ w3) only
        store64(&got, load64(&got) ^ load64(&got + 16));
        store64(&got + 8, load64(&got + 8) ^ load64(&got + 24));
        return memeq(&got, &sv, 16);
    }
    return memeq(&got, &sv, 32);
}
# The ZIL class of the objset at os: 0 empty · 1 REPLAY_NEEDED (the dataset is refused) · 2 claimed, no replay
# (the next mount frees nothing, zil.c:1085-1130) · 3 one allocated, never-written block — the normal state after a
# clean export (zil_close, zil.c:4401-4458) · 4 a live unclaimed chain · 5 a dangling head (born after T0) ·
# -1 the head could not be judged. 4, 5 and -1 refuse the POOL: those chain blocks are not in the space maps.
fn zfs_wzil_class(os) {
    var zh = os + 512;
    if ((load64(zh + 152) & 1) != 0) { return 1; }
    var lp = zh + 16;
    if (zfs_bp_hole(lp) == 1) { return 0; }
    if (load64(zh) != 0) { return 2; }
    if (zfs_wugt(load64(lp + 80), zfs_txg) == 1) { return 5; }
    var v = zfs_wzil_head(lp);
    if (v < 0) { return 0 - 1; }
    if (v == 1) { return 4; }
    return 3;
}
fn zfs_wzil_ds(dsobj) {
    if (zfs_wscr() != 0) { return 0 - 1; }
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, dsobj, dn) != 0) { return zfs_wnon("dataset unreadable: object ", dsobj); }
    var os = zfs_wmem + ZWA_OS;
    if (zfs_wos_read(zfs_bonus(dn) + 128, os) != 0) { return zfs_wnon("objset unreadable: dataset ", dsobj); }
    var c = zfs_wzil_class(os);
    zfs_wd_zil(dsobj, c);
    if (c == 4) { return zfs_wnon("unclaimed live ZIL in dataset ", dsobj); }
    if (c == 5) { return zfs_wnon("dangling ZIL head in dataset ", dsobj); }
    if (c < 0) { return zfs_wnon("ZIL head unreadable in dataset ", dsobj); }
    return 0;
}
# Every dsl_dir from root, depth first and ITERATIVE (no kernel-stack cost per level): a stack of (child-dir ZAP,
# cursor) in the mount scratch, ZWK_DSLMAX deep. Each dir's head dataset gets its ZIL judged (zfs_wzil_ds). 0 / -1.
fn zfs_wdsl(root) {
    if (zfs_wscr() != 0) { return 0 - 1; }
    var stk = zfs_wmem + ZWA_STK;
    var sp = 0;
    var dobj = root;
    var dn = zfs_wdn(0);
    while (1 == 1) {
        if (dobj != 0) {
            if (zfs_dnode(zfs_mem + ZR_MOS, dobj, dn) != 0) { return zfs_wnon("dsl_dir unreadable: object ", dobj); }
            var bon = zfs_bonus(dn);
            var head = load64(bon + 8);
            var cz = load64(bon + 32);
            if (head != 0) { if (zfs_wzil_ds(head) != 0) { return 0 - 1; } }
            if (cz != 0) {
                if (sp >= ZWK_DSLMAX) { return zfs_wnon("DSL nesting over ", ZWK_DSLMAX); }
                store64(stk + sp * 16, cz);
                store64(stk + sp * 16 + 8, 0);
                sp = sp + 1;
            }
        }
        if (sp == 0) { return 0; }
        var e = stk + (sp - 1) * 16;
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(e), dn) != 0) { return zfs_wnon("dsl_dir unreadable: object ", load64(e)); }
        var r = zfs_zap_next(dn, e + 8);
        if (r < 0) { return zfs_wnon("dsl_dir unreadable: object ", load64(e)); }
        dobj = 0;
        if (r == 0) { sp = sp - 1; } else { dobj = zfs_it_val; }
    }
    return 0;
}
# The root dsl_dir (MOS directory root_dataset); 0 when unreadable.
fn zfs_wrootdir() {
    var od = zfs_wdn(0);
    var rd = 0;
    if (zfs_dnode(zfs_mem + ZR_MOS, 1, od) != 0) { return 0; }
    if (zfs_zap_u64(od, "root_dataset", &rd) != 1) { return 0; }
    return rd;
}

# --- the state load (design § c.1, § c.2) -------------------------------------------------------------------------
# Geometry and bitmap sizing, then sm_obj[] and U[] into the per-metaslab table. 0 / -1.
fn zfs_warrays() {
    if (zfs_ms_shift < zfs_ashift + 6 || zfs_ms_shift > 40) { return zfs_wnon("metaslab_shift ", zfs_ms_shift); }
    zfs_ms_count = zfs_asize >> zfs_ms_shift;
    if (zfs_ms_count < 1 || zfs_ms_count > ZWK_MAXMS) { return zfs_wnon("metaslab count ", zfs_ms_count); }
    zfs_ms_bits = 1 << (zfs_ms_shift - zfs_ashift);
    zfs_bm_bytes = zfs_ms_bits >> 3;
    if (zfs_bm_bytes > ZWK_BMCAP) { return zfs_wnon("metaslab bitmap over 512 KiB: KiB ", zfs_bm_bytes >> 10); }
    zfs_bm_slots = ZWK_BMAREA / (2 * zfs_bm_bytes);
    if (zfs_bm_slots > zfs_ms_count) { zfs_bm_slots = zfs_ms_count; }
    zfs_bm_next = 0;
    var dn = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, zfs_ms_array, dn) != 0) { return zfs_wno("metaslab array unreadable"); }
    var i = 0;
    while (i < zfs_ms_count) {
        var so = zfs_wobj_u64(dn, i);
        if (so < 0 || so > ZK_MASK48) { return zfs_wnon("metaslab array unreadable at ms ", i); }
        memset(zfs_msent(i), 0, 64);
        store64(zfs_msent(i), so);
        i = i + 1;
    }
    if (zfs_unfl_obj == 0) { return 0; }
    if (zfs_dnode(zfs_mem + ZR_MOS, zfs_unfl_obj, dn) != 0) { return zfs_wno("unflushed txgs unreadable"); }
    i = 0;
    while (i < zfs_ms_count) {
        var u = zfs_wobj_u64(dn, i);
        # U names a txg this pool already synced; anything else is not OpenZFS's
        if (u < 0 || u > zfs_txg) { return zfs_wnon("unflushed txg beyond the pool txg, ms ", i); }
        store64(zfs_msent(i) + 8, u);
        i = i + 1;
    }
    return 0;
}
# The log space maps: MOS directory com.delphix:log_spacemap_zap = { "%llx"(txg) -> object } (WPA § 6.5),
# parsed as zfs_strtonum does (lowercase hex) and kept ascending by txg. log_spacemap is active (the MOS gate), and
# OpenZFS creates the ZAP in the txg that activates it and never removes it — so it must be there. 0 / -1.
fn zfs_wlogs() {
    zfs_nlogs = 0;
    var od = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, 1, od) != 0) { return zfs_wno("MOS directory unreadable"); }
    var lz = 0;
    var r = zfs_wzu64(od, "com.delphix:log_spacemap_zap", &lz);
    if (r < 0) { return r; }
    if (r == 0) { return zfs_wno("log_spacemap active without its ZAP"); }
    if (zfs_dnode(zfs_mem + ZR_MOS, lz, od) != 0) { return zfs_wno("log space map ZAP unreadable"); }
    var nm = zfs_mem + ZR_NAME;
    var tab = zfs_wmem + ZWA_LOG;
    var cur = 0;
    r = zfs_zap_next(od, &cur);
    while (r == 1) {
        if (zfs_nlogs >= ZWK_MAXLOG) { return zfs_wnon("log space maps over ", ZWK_MAXLOG); }
        var t = 0;
        var k = 0;
        while (k < zfs_it_nlen) {
            var c = load8(nm + k);
            if (c >= 48 && c <= 57) { t = t * 16 + c - 48; }
            elif (c >= 97 && c <= 102) { t = t * 16 + c - 87; }
            else { return zfs_wno("log space map ZAP: bad txg key"); }
            k = k + 1;
        }
        var o = zfs_it_val;
        if (zfs_it_nlen < 1 || zfs_it_nlen > 13 || t < 1 || t > zfs_txg || o < 1 || o > ZK_MASK48) { return zfs_wno("log space map ZAP: bad entry"); }
        var j = zfs_nlogs;
        while (j > 0 && load64(tab + (j - 1) * 16) > t) {
            store64(tab + j * 16, load64(tab + (j - 1) * 16));
            store64(tab + j * 16 + 8, load64(tab + (j - 1) * 16 + 8));
            j = j - 1;
        }
        if (j > 0 && load64(tab + (j - 1) * 16) == t) { return zfs_wnon("log space map ZAP: duplicate txg ", t); }
        store64(tab + j * 16, t);
        store64(tab + j * 16 + 8, o);
        zfs_nlogs = zfs_nlogs + 1;
        r = zfs_zap_next(od, &cur);
    }
    if (r < 0) { return zfs_wno("log space map ZAP unreadable"); }
    return 0;
}

# One space-map entry (raw units: ashift for a metaslab SM relative to the metaslab, 512 B absolute for a log —
# sm_start 0, sm_shift 9, spa_log_spacemap.c:987-994). ty 0 ALLOC / 1 FREE; txg = the last debug entry's. 0 / -1.
fn zfs_wsm_ent(ty, raw, run, txg) {
    var bit = raw;
    var n = run;
    if (zfs_ws_log == 1) {
        var lim = zfs_asize >> 9;
        if (raw > lim || run > lim) { return 0 - 1; }
        var by = raw << 9;
        var nb = run << 9;
        var am = (1 << zfs_ashift) - 1;
        if ((by & am) != 0 || (nb & am) != 0) { return 0 - 1; }
        var ms = by >> zfs_ms_shift;
        # one metaslab per entry: the replay indexes vdev_ms[offset >> ms_shift] (spa_log_spacemap.c:1097)
        if (ms >= zfs_ms_count || by + nb > (ms + 1) << zfs_ms_shift) { return 0 - 1; }
        # an entry for a metaslab whose U is 0: OpenZFS's next writable import looks for a log-summary row at txg 0,
        # finds none and stores through NULL (spa_log_spacemap.c:1123-1127 -> :611-622; build-dependent — an ASSERT,
        # a page fault, or survival, as FreeBSD 15.1's kernel showed) — and never flushes that metaslab, so its
        # log-only changes are lost once the logs are destroyed (design § c.3, B3b's negative N3)
        var me = zfs_msent(ms);
        var u = load64(me + 8);
        if (u == 0) { return 0 - 1; }
        if (ty == 0) { zfs_ws_a = zfs_ws_a + nb; } else { zfs_ws_f = zfs_ws_f + nb; }
        if (zfs_ws_ms == 0 - 2) {
            # (B11) the RELEASE of a log's FREEs once they leave the deferral window (zfs_wdef_rel): a resident metaslab's
            # deferred units cleared — each must be set, every agnos free deferred exactly once — and its count down; a
            # non-resident one rebuilds the window at its next load. The mount's own logs (zfs_wrel_ev) are released by
            # evicting instead: OpenZFS at its slop may have reallocated their units (zfs_wxl_undo's `pre`)
            if (ty == 1 && zfs_wrel_ev == 0 && load64(me + 40) != 0) {
                var rb = (by - (ms << zfs_ms_shift)) >> zfs_ashift;
                if (zfs_bm_op(zfs_bm_a(load64(me + 40) - 1) + zfs_bm_bytes, rb, nb >> zfs_ashift, 0) != 0) { return 0 - 1; }
                store64(me + 32, load64(me + 32) - nb);
            }
            return 0;
        }
        if (zfs_ws_ms < 0) {
            # the one scan: what the import replays into ms — every entry of a log with txg >= U[ms]
            # (spa_ld_log_sm_cb skips the rest, spa_log_spacemap.c:1107-1108)
            if (zfs_ws_lt >= u) {
                store64(me + 48, load64(me + 48) + 1);
                if (ty == 0) { store64(me + 56, load64(me + 56) + nb); } else { store64(me + 56, load64(me + 56) - nb); }
            }
            return 0;
        }
        if (ms != zfs_ws_ms) { return 0; }
        bit = (by - (ms << zfs_ms_shift)) >> zfs_ashift;
        n = nb >> zfs_ashift;
        if (zfs_ws_def == 1 && ty == 1) { zfs_bm_op(zfs_ws_dbm, bit, n, 2); }
        if (zfs_ws_app == 0) { return 0; }
    } else {
        if (raw > zfs_ms_bits || run > zfs_ms_bits || raw + run > zfs_ms_bits) { return 0 - 1; }
        if (ty == 0) { zfs_ws_a = zfs_ws_a + (run << zfs_ashift); } else { zfs_ws_f = zfs_ws_f + (run << zfs_ashift); }
        # (B10, design k.108) a FREE appended to a space map is not deferred by itself: a flush appends what logs or
        # ghosts carry (zfs_wl_kill_logs keeps a destroyed log's deferral), and a range allocated and freed between two
        # flushes is in no append at all. (The merge, k.133 (a)) The window is B11's: a log's or a ghost's FREEs stay
        # deferred while its txg is >= zfs_wdef_lo, and zfs_wdef_rel releases both — the ghost then retired
    }
    if (ty == 0) { return zfs_bm_op(zfs_ws_abm, bit, n, 1); }
    return zfs_bm_op(zfs_ws_abm, bit, n, 0);
}
# Walk the space map whose dnode is at dn in file order (WPA § 6.3; space_map_iterate, space_map.c:85-185) through
# zfs_wsm_ent, then demand smp_alloc == ALLOC - FREE (zdb's "INCONSISTENT", zdb.c:1669-1673; OpenZFS keeps it for
# metaslab SMs and logs alike). 0 / -1.
fn zfs_wsm_walk(dn) {
    zfs_ws_n = 0;
    zfs_ws_a = 0;
    zfs_ws_f = 0;
    if (load8(dn) != ZWK_SM || load8(dn + 4) != ZWK_SMHDR || load16(dn + 10) < 24) { return 0 - 1; }
    var bon = zfs_bonus(dn);
    var len = load64(bon + 8);
    var bsz = load16(dn + 8) << 9;
    if (len < 0 || (len & 7) != 0 || bsz < 512) { return 0 - 1; }
    if (len > (load64(dn + 16) + 1) * bsz) { return 0 - 1; }
    var off = 0;
    var cb = 0 - 1;
    var b = 0;
    var txg = 0;
    while (off < len) {
        var bi = off / bsz;
        var bo = off - bi * bsz;
        if (bi != cb) {
            b = zfs_obj_blk(dn, bi, 1);
            if (b == 0) { return 0 - 1; }
            cb = bi;
        }
        var e = load64(b + bo);
        off = off + 8;
        var ty = 0;
        var raw = 0;
        var run = 0;
        if ((e >> 63) == 0) {
            # one word: a log never has one — it decodes to SM_NO_VDEVID and the replay looks up vdev 2^24
            if (zfs_ws_log == 1) { return 0 - 1; }
            raw = (e >> 16) & ZWK_OFF47;
            ty = (e >> 15) & 1;
            run = (e & 0x7FFF) + 1;
        } elif ((e >> 62) == 2) {
            if ((e & ZWK_TXG50) != 0) { txg = e & ZWK_TXG50; }   # txg 0 = the straddle pad word
            continue;
        } else {
            # two words, never straddling a block (space_map.c:615-631)
            if (bo + 8 >= bsz || off >= len) { return 0 - 1; }
            if (zfs_ws_log == 1 && (e & 0xFFFFFF) != zfs_top_id) { return 0 - 1; }
            run = ((e >> 24) & ZWK_RUN36) + 1;
            var e2 = load64(b + bo + 8);
            off = off + 8;
            ty = (e2 >> 63) & 1;
            raw = e2 & ZWK_OFF63;
        }
        zfs_ws_n = zfs_ws_n + 1;
        if (zfs_wsm_ent(ty, raw, run, txg) != 0) { return 0 - 1; }
    }
    if (load64(bon + 16) != zfs_ws_a - zfs_ws_f) { return 0 - 1; }
    return 0;
}
# Check every log once (format, bounds, smp_alloc), print it, and sum per metaslab what the import replays — and the
# FREE bytes of every log with txg >= zfs_wdef_lo into zfs_w_defer (the units zfs_ms_load defers: T0 - 2 at mount; the
# live window when the op list's read-back re-runs the scan, B11); then every metaslab with
# U != 0 must have the log whose txg is exactly U, or OpenZFS's import fails ENOENT (spa_log_spacemap.c:1042-1066).
# 0 / -1.
fn zfs_wscan_logs() {
    var ldn = zfs_wdn(1);
    zfs_ws_ms = 0 - 1;
    zfs_ws_log = 1;
    zfs_w_defer = 0;
    var k = 0;
    while (k < zfs_nlogs) {
        var lg = zfs_wmem + ZWA_LOG + k * 16;
        zfs_ws_lt = load64(lg);
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(lg + 8), ldn) != 0 || zfs_wsm_walk(ldn) != 0) { return zfs_wnon("log space map inconsistent, txg ", zfs_ws_lt); }
        if (zfs_ws_lt >= zfs_wdef_lo) { zfs_w_defer = zfs_w_defer + zfs_ws_f; }
        zfs_wd_log(k);
        k = k + 1;
    }
    # (B10) the logs this boot destroyed inside the window: their FREEs stay deferred (their ghosts, zfs_wl_kill_logs —
    # retired by zfs_wdef_rel once the window passes them: the merge, k.133 (a))
    var g = 0;
    while (g < zfs_ngho) {
        var ge = zfs_wmem + ZWA_GHO + g * ZWL_GSZ;
        if (load64(ge) >= zfs_wdef_lo) { zfs_w_defer = zfs_w_defer + load64(ge + 8); }
        g = g + 1;
    }
    var i = 0;
    while (i < zfs_ms_count) {
        var u = load64(zfs_msent(i) + 8);
        if (u != 0) {
            var hit = 0;
            k = 0;
            while (k < zfs_nlogs && hit == 0) {
                if (load64(zfs_wmem + ZWA_LOG + k * 16) == u) { hit = 1; }
                k = k + 1;
            }
            if (hit == 0) { return zfs_wnon("no log space map for the unflushed txg of ms ", i); }
        }
        i = i + 1;
    }
    return 0;
}
# Load metaslab i into a resident bitmap slot (design § c.2, the review-fixed rule) — on first use from B3 on; at
# mount only under ZFS_WRITE_SELFTEST. ALLOCATED = the true state: its SM in file order, then every log with txg >=
# U[i], ascending, entries of metaslab i only — all strict, and the result must count exactly smp_alloc + the mount
# scan's net. DEFERRED = not handed out yet: FREEs in any log with txg >= zfs_wdef_lo (whatever U says; B11 — T0 - 2 at
# mount, then the last two txgs: zfs_wdef_rel) — (B10) a destroyed one's too, through its GHOST while its txg is inside
# the window (zfs_wl_kill_logs; the SM-append rule is gone, k.108; the merge, k.133 (a)). Then the OPEN txg's own extents
# (B3a): they live in the txg's extent list, not only in
# the bitmap, so a metaslab the open txg touched may be evicted and rebuilt — design § c.2's PIN rule ("its pending
# lists live only in memory") answered by reconstruction instead: a one-slot pool (16 GiB metaslabs, >= 3 TB) could
# otherwise touch only one metaslab per txg. The commit, before it drops the list, adds log T to the log table and to
# each metaslab's U / net (+8, +56) — zfs_wc_pub — so a later reload replays T from the device instead.
# Slot / -1 (zfs_wr_* names the metaslab).
# ⚠ SIDE EFFECTS (every allocation and free can land here): the round-robin slot's metaslab is EVICTED (so a slot
# number from an earlier call is stale — re-load by metaslab); the zfs_ws_* walker globals are overwritten; and the
# space map and logs are read through the READER's metadata cache (zfs_dnode / zfs_obj_blk), which may evict any
# cached block — a pointer zfs_obj_blk returned before the call is not valid after it. The dnodes it reads land in
# its OWN slots (zfs_wldn 0 / 1), never in zfs_wdn's.
fn zfs_ms_load(i) {
    var me = zfs_msent(i);
    if (load64(me + 40) != 0) { return load64(me + 40) - 1; }
    zfs_ms_nload = zfs_ms_nload + 1;
    var s = zfs_bm_next;
    zfs_bm_next = (s + 1) % zfs_bm_slots;
    var own = zfs_wmem + ZWA_RES + s * 8;
    if (load64(own) != 0) { zfs_ms_evict(load64(own) - 1); }
    store64(own, 0);
    var abm = zfs_bm_a(s);
    memset(abm, 0, zfs_bm_bytes * 2);
    zfs_ws_abm = abm;
    zfs_ws_dbm = abm + zfs_bm_bytes;
    zfs_ws_ms = i;
    var so = load64(me);
    if (so != 0) {
        var dn = zfs_wldn(0);
        zfs_ws_log = 0;
        if (zfs_dnode(zfs_mem + ZR_MOS, so, dn) != 0 || zfs_wsm_walk(dn) != 0) { return zfs_wnon("space map inconsistent ms ", i); }
    }
    var u = load64(me + 8);
    var ldn = zfs_wldn(1);
    var k = 0;
    while (k < zfs_nlogs) {
        var lg = zfs_wmem + ZWA_LOG + k * 16;
        var lt = load64(lg);
        zfs_ws_app = 0;
        zfs_ws_def = 0;
        if (u != 0 && lt >= u) { zfs_ws_app = 1; }
        if (lt >= zfs_wdef_lo) { zfs_ws_def = 1; }
        if (zfs_ws_app == 1 || zfs_ws_def == 1) {
            zfs_ws_log = 1;
            if (zfs_dnode(zfs_mem + ZR_MOS, load64(lg + 8), ldn) != 0 || zfs_wsm_walk(ldn) != 0) { return zfs_wnon("space map inconsistent ms ", i); }
        }
        k = k + 1;
    }
    # (B10) the logs this boot destroyed inside the window: their FREEs deferred, never applied (their ghosts —
    # zfs_wl_kill_logs). (The merge, k.133 (a)) A ghost lives only while its txg L is inside the window — L >= D - 2 for
    # the destroying txg D, retired by zfs_wdef_rel(L + 2) <= zfs_wdef_rel(D + 1) — and its blocks, freed in D, are
    # released by zfs_wdef_rel(D + 2): so they still hold its entries at every load of its lifetime
    var g = 0;
    while (g < zfs_ngho) {
        var ge = zfs_wmem + ZWA_GHO + g * ZWL_GSZ;
        if (load64(ge) >= zfs_wdef_lo) {
            memset(ldn, 0, 512);
            memcpy(ldn, ge + 16, 216);
            zfs_ws_log = 1;
            zfs_ws_lt = load64(ge);
            zfs_ws_app = 0;
            zfs_ws_def = 1;
            if (zfs_wsm_walk(ldn) != 0) { return zfs_wnon("space map inconsistent ms ", i); }
        }
        g = g + 1;
    }
    var pc = zfs_popc(abm, zfs_bm_bytes) << zfs_ashift;
    if (pc != load64(me + 16) + load64(me + 56)) { return zfs_wnon("space map inconsistent ms ", i); }
    # ⭐ B3a: the open txg's own ALLOCs and FREEs of this metaslab, from its extent list (zfs_wxl_apply) — so a
    # metaslab the txg touched may be evicted and reloaded like any other (see zfs_wxl_apply)
    if (zfs_wxl_apply(i, abm, abm + zfs_bm_bytes) != 0) { return zfs_wnon("space map inconsistent ms ", i); }
    store64(zfs_msx(i), 0);
    pc = zfs_popc(abm, zfs_bm_bytes) << zfs_ashift;
    store64(me + 24, pc);
    store64(me + 32, zfs_popc(abm + zfs_bm_bytes, zfs_bm_bytes) << zfs_ashift);
    store64(me + 40, s + 1);
    store64(own, i + 1);
    return s;
}
# Drop metaslab i's resident slot, if it has one: its bitmaps are rebuilt by its next zfs_ms_load. 0.
fn zfs_ms_evict(i) {
    var me = zfs_msent(i);
    var s = load64(me + 40);
    if (s != 0) {
        store64(zfs_wmem + ZWA_RES + (s - 1) * 8, 0);
        store64(me + 40, 0);
    }
    return 0;
}
# Every metaslab evicted; the next load takes slot 0. 0.
fn zfs_ms_evall() {
    var i = 0;
    while (i < zfs_ms_count) {
        zfs_ms_evict(i);
        i = i + 1;
    }
    zfs_bm_next = 0;
    return 0;
}
# ⭐ B11 (design § b.3, k.40 / k.64 — DECIDED: TXG_DEFER_SIZE = 2, exactly as OpenZFS): THE RELEASE OF DEFERRED FREES once
# txg t is DURABLE (its uberblock written and flushed: zfs_wc_pub, or the op list's ub-only commit). OpenZFS's
# metaslab_sync_done(txg) (metaslab.c:4545-4655) hands ms_defer[txg % TXG_DEFER_SIZE] — the frees of txg - 2 — back to
# ms_allocatable and parks txg's own frees in that slot, so a block freed in txg T is allocatable from the sync of T + 3
# (its comment's "not available until txg 52 (50 + TXG_DEFER_SIZE)" means until 52 has SYNCED) and every uberblock back to
# the last synced - TXG_DEFER_SIZE stays whole: spa_load's safe_rewind_txg (spa.c:6365). Here: the window's low txg
# zfs_wdef_lo moves to t - 1 and every log below it leaves the window — its FREE bytes leave zfs_w_defer (zfs_wroom's room
# grows back) and its units the deferred bitmap of every RESIDENT metaslab (zfs_wsm_ent's release mode; a non-resident one
# rebuilds the window at its next load, zfs_ms_load). The mount's window (T0 - 2 .. T0 — OpenZFS's txgs, which at its slop
# may reallocate a unit it freed: zfs_wxl_undo's `pre`) is released by EVICTING every resident metaslab instead; agnos's
# own logs never overlap inside the window (a deferred unit is never allocated, so never freed again before its release).
# ⭐ CRASH (design § b.3, checked for agnos's commit order): txg T allocates only units released by T - 1's publish —
# freed in T - 3 or earlier, referenced by no uberblock after T - 4 — so whatever T's writes did before its uberblock,
# T - 1, T - 2 and T - 3 (OpenZFS's rewind window) are whole; once one copy of uberblock T lands, T's blocks were already
# flushed (zfs_commit_ubw's first FLUSH). zfs-write-smoke's cut lanes hold it on disk (a block freed in T - 2 placed under
# the allocator's cursor: OpenZFS's rewind to T - 3 must stay clean). A release whose units are not deferred means the
# writer's tables disagree with the device: the pool goes read-only (zfs_wfail; t is durable either way). 0 / -1.
fn zfs_wdef_rel(t) {
    zfs_wdef_rl = 0;
    var nlo = t - 1;
    if (nlo <= zfs_wdef_lo) { return 0; }
    var ev = 0;
    var ldn = zfs_wldn(1);
    var k = 0;
    while (k < zfs_nlogs) {
        var lg = zfs_wmem + ZWA_LOG + k * 16;
        var lt = load64(lg);
        if (lt >= zfs_wdef_lo && lt < nlo) {
            zfs_ws_ms = 0 - 2;
            zfs_ws_log = 1;
            zfs_ws_lt = lt;
            zfs_wrel_ev = 0;
            if (lt <= zfs_t0) {
                zfs_wrel_ev = 1;
                ev = 1;
            }
            if (zfs_dnode(zfs_mem + ZR_MOS, load64(lg + 8), ldn) != 0 || zfs_wsm_walk(ldn) != 0) { return zfs_wfail(t, "deferred frees not released (not deferred, or the log unreadable): log txg ", lt); }
            zfs_w_defer = zfs_w_defer - zfs_ws_f;
            zfs_wdef_rl = zfs_wdef_rl + zfs_ws_f;
        }
        k = k + 1;
    }
    # (The merge, k.133 (a)) B10's GHOSTS — the logs its hygiene destroyed while their txg was inside the window — leave
    # it the same way: their FREEs released (the ghost's dnode copy walked; its blocks, freed in the destroying txg D,
    # are released only at D + 2, after every ghost of D is retired) and the ghost RETIRED, so the table holds at most
    # the window's logs (<= 3: the mount's T0 - 2 .. T0) and never fills — the bound B10 alone lacked (k.122)
    var gk = 0;
    var g = 0;
    while (g < zfs_ngho) {
        var ge = zfs_wmem + ZWA_GHO + g * ZWL_GSZ;
        var gt = load64(ge);
        if (gt < nlo) {
            if (gt >= zfs_wdef_lo) {
                zfs_ws_ms = 0 - 2;
                zfs_ws_log = 1;
                zfs_ws_lt = gt;
                zfs_wrel_ev = 0;
                if (gt <= zfs_t0) {
                    zfs_wrel_ev = 1;
                    ev = 1;
                }
                memset(ldn, 0, 512);
                memcpy(ldn, ge + 16, 216);
                if (zfs_wsm_walk(ldn) != 0) { return zfs_wfail(t, "deferred frees not released (not deferred, or the log unreadable): ghost log txg ", gt); }
                zfs_w_defer = zfs_w_defer - zfs_ws_f;
                zfs_wdef_rl = zfs_wdef_rl + zfs_ws_f;
            }
            zfs_wl_gret = zfs_wl_gret + 1;
        } else {
            if (gk != g) { memcpy(zfs_wmem + ZWA_GHO + gk * ZWL_GSZ, ge, ZWL_GSZ); }
            gk = gk + 1;
        }
        g = g + 1;
    }
    zfs_ngho = gk;
    zfs_wdef_lo = nlo;
    if (ev == 1) { zfs_ms_evall(); }
    return 0;
}
#ifdef ZFS_WRITE_SELFTEST
# The strict replay of EVERY metaslab at mount (production loads lazily), then the zfs-wms / zfs-wpool dump that
# scripts/smoke/lib/zfs-wms-check.py diffs against its own replay of the image. 0 / -1.
fn zfs_wst_replay(sm, al, un) {
    var de = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        if (zfs_ms_load(i) < 0) { return 0 - 1; }
        de = de + load64(zfs_msent(i) + 32);
        zfs_wd_ms(i);
        i = i + 1;
    }
    zfs_wd_pool(sm, al, de, un);
    return 0;
}
#endif
#ifndef ZFS_WRITE_SELFTEST
fn zfs_wst_replay(sm, al, un) { return 0; }
#endif
# The whole state load (design § c.1): arrays, the log list, every log checked once — which also sums each
# metaslab's unflushed entries — then every metaslab's space-map HEADER (OpenZFS's import reads no more:
# metaslab_init opens the SM, metaslab_load reads it on first use). Pool allocated = Σ smp_alloc + Σ unflushed net
# (spa_log_spacemap.c:1251-1261), the slop baseline. spacemap_histogram's refcount must be zdb's count
# (verify_spacemap_refcounts, zdb.c:1541-1567: SMs with a 320-byte bonus — metaslabs, the leaf's DTL — plus every
# log; checkpoint/obsolete SMs exist only on pools refused above): B3 adds one per log it creates. 0 / -1.
fn zfs_wstate() {
    if (zfs_warrays() != 0) { return 0 - 1; }
    if (zfs_wlogs() != 0) { return 0 - 1; }
    if (zfs_wscan_logs() != 0) { return 0 - 1; }
    var dn = zfs_wdn(0);
    var nsm = zfs_nlogs;
    if (zfs_dtl_obj != 0) {
        if (zfs_dnode(zfs_mem + ZR_MOS, zfs_dtl_obj, dn) != 0 || load8(dn) != ZWK_SM) { return zfs_wno("DTL space map unreadable"); }
        if (load16(dn + 10) == ZWK_SMV1) { nsm = nsm + 1; }
    }
    var msz = 1 << zfs_ms_shift;
    var sm = 0;
    var al = 0;
    var un = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        var me = zfs_msent(i);
        var sa = 0;
        if (load64(me) != 0) {
            if (zfs_dnode(zfs_mem + ZR_MOS, load64(me), dn) != 0 || load8(dn) != ZWK_SM || load8(dn + 4) != ZWK_SMHDR || load16(dn + 10) < 24) { return zfs_wnon("space map inconsistent ms ", i); }
            if (load16(dn + 10) == ZWK_SMV1) { nsm = nsm + 1; }
            sa = load64(zfs_bonus(dn) + 16);
        }
        var a = sa + load64(me + 56);
        if (sa < 0 || sa > msz || a < 0 || a > msz) { return zfs_wnon("space map inconsistent ms ", i); }
        store64(me + 16, sa);
        store64(me + 24, a);
        sm = sm + sa;
        al = al + a;
        if (load64(me + 48) > 0) { un = un + 1; }
        i = i + 1;
    }
    if (zfs_w_smh != nsm) {
        # zdb's words: "space map refcount mismatch: expected <feature refcount> != actual <space maps>"
        zfs_wnon("space map refcount mismatch: expected ", nsm);
        var l = fmt_int_buf(zfs_w_smh, &zfs_wr_nm);
        memcpy(&zfs_wr_nm + l, " != actual ", 11);
        zfs_wr_nml = l + 11;
        return 0 - 1;
    }
    zfs_w_alloc = al;
    return zfs_wst_replay(sm, al, un);
}

# --- the dataset gate (design § a.2 "Dataset") --------------------------------------------------------------------
# The effective u64 property pname of dsl_dir dobj as dsl_prop_get_dd resolves it (dsl_prop.c:118-180; the order
# is zfs.cyr zfs_prop_find's), from dobj up, else dflt. -2 when a dsl_dir or a props ZAP on the way cannot be read,
# or the chain does not end — never "unset": an unreadable readonly=on would read as off. Writer slots 2 and 3.
fn zfs_wprop(dobj, pname, dflt) {
    var dd = zfs_wdn(2);
    var zd = zfs_wdn(3);
    var depth = 0;
    while (dobj != 0) {
        if (depth >= ZWK_DSLMAX || zfs_dnode(zfs_mem + ZR_MOS, dobj, dd) != 0) { return 0 - 2; }
        var bon = zfs_bonus(dd);
        var pz = load64(bon + 80);
        dobj = load64(bon + 16);
        if (pz != 0) {
            if (zfs_dnode(zfs_mem + ZR_MOS, pz, zd) != 0) { return 0 - 2; }
            var v = 0;
            var r = zfs_prop_find(zd, pname, 8, 1, &v);
            if (r == 1) { return v; }
            if (r != (0 - 2)) { return 0 - 2; }
        }
        depth = depth + 1;
    }
    return dflt;
}
# The checksum dmu_write_policy gives METADATA for checksum property c: on (and inherit at the root) = fletcher4
# (ZIO_CHECKSUM_ON_VALUE); a metadata-capable, non-embedded algorithm is used as is; anything else falls back to
# fletcher4 (dmu.c:2387-2398, zio_checksum.c:170-207).
fn zfs_wmdck(c) {
    if (c == 7 || c == 8 || c >= 11) { return c; }
    return 7;
}
# $ORIGIN@$ORIGIN: the root dsl_dir's child $ORIGIN, its head dataset's ds_prev_snap_obj (dsl_pool.c:290-296).
# Every filesystem created after pool version 11 is born a "clone" of it (dsl_dataset.c:1186-1187), so it is
# neither a clone origin nor a snapshot for the gate below. 0 when absent (then such a dataset reads as a clone:
# refused, the safe side).
fn zfs_worigin() {
    zfs_origin = 0;
    var rd = zfs_wrootdir();
    var dn = zfs_wdn(0);
    if (rd == 0 || zfs_dnode(zfs_mem + ZR_MOS, rd, dn) != 0) { return 0; }
    var cz = load64(zfs_bonus(dn) + 32);
    if (cz == 0 || zfs_dnode(zfs_mem + ZR_MOS, cz, dn) != 0) { return 0; }
    var od = 0;
    if (zfs_zap_u64(dn, "$ORIGIN", &od) != 1 || zfs_dnode(zfs_mem + ZR_MOS, od, dn) != 0) { return 0; }
    var hd = load64(zfs_bonus(dn) + 8);
    if (hd == 0 || zfs_dnode(zfs_mem + ZR_MOS, hd, dn) != 0) { return 0; }
    zfs_origin = load64(zfs_bonus(dn) + 8);
    return 0;
}
# The write verdict of grafted dataset slot di. 0 = writable / -1 (zfs_wr_* says why). Order: the ruled list.
# A dataset or dsl_dir object is a ZAP only once zapified (type DMU_OTN_ZAP_METADATA, dsl_dataset_is_zapified);
# before that it has no keys at all — not even per-dataset feature flags.
fn zfs_wds_gate(di) {
    if (zfs_wscr() != 0) { return 0 - 1; }
    var ds = zfs_ds(di);
    var dsobj = load64(ds + 840);
    var mn = zfs_wdn(0);
    var v = 0;
    if (zfs_dnode(ds, 1, mn) != 0 || zfs_zap_u64(mn, "VERSION", &v) != 1) { return zfs_wno("master node unreadable"); }
    if (v < 5) { return zfs_wnon("ZPL version ", v); }                 # pre-SA znodes (WPA § 10)
    var nrm = 0;
    var cs = 0;
    if (zfs_wzu64(mn, "normalization", &nrm) < 0 || zfs_wzu64(mn, "casesensitivity", &cs) < 0) { return 0 - 1; }
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, dsobj, dn) != 0) { return zfs_wno("dataset unreadable"); }
    var bon = zfs_bonus(dn);
    var dir = load64(bon);
    var prev = load64(bon + 8);
    if (((load64(bon + 176) >> 61) & 1) == 1) { return zfs_wno("encrypted"); }   # ds_bp's crypt bit
    if ((load64(bon + 120) & 1) != 0) { return zfs_wno("incomplete receive"); }
    var bmo = 0;
    if (load8(dn) == ZWK_ZAPMD) {
        # a redacted receive: the per-dataset feature key, a u64 array of redaction snapshots (dsl_dataset.c:5088-5100)
        if (zfs_wzno(dn, "com.delphix:redacted_datasets", "redacted") != 0) { return 0 - 1; }
        if (zfs_wzu64(dn, "com.delphix:bookmarks", &bmo) < 0) { return 0 - 1; }   # DS_FIELD_BOOKMARK_NAMES
    }
    var os = zfs_wmem + ZWA_OS;
    if (zfs_wos_read(bon + 128, os) != 0) { return zfs_wno("objset unreadable"); }
    if (load64(os + 704) != 2) { return zfs_wno("not a filesystem"); }
    var zc = zfs_wzil_class(os);
    var dd = zfs_wdn(2);
    if (zfs_dnode(zfs_mem + ZR_MOS, dir, dd) != 0) { return zfs_wno("dsl_dir unreadable"); }
    if (load64(zfs_bonus(dd) + 8) != dsobj) { return zfs_wno("not a head dataset"); }
    var org = load64(zfs_bonus(dd) + 24);
    var cl = 0;
    if (org != 0 && org != zfs_origin) { cl = 1; }                   # dsl_dir_is_clone (dsl_dir.c:994-999)
    if (load8(dd) == ZWK_ZAPMD) {
        if (zfs_wzno(dd, "com.datto:crypto_key_obj", "encrypted") != 0) { return 0 - 1; }   # DD_FIELD_CRYPTO_KEY_OBJ
        # (B9) a clone's LIVELIST (DD_FIELD_LIVELIST, dsl_dir.c:272-283) takes an ALLOC / FREE record of every block born
        # or killed after its origin (dsl_dataset.c:194-204, :282-292), flushed and condensed at sync: not built, refused.
        # OpenZFS drops it once the clone shares <= 75 % (dsl_livelist_should_disable) — the fixture's wr/clone has none
        if (cl == 1 && zfs_wzno(dd, "com.delphix:livelist", "clone with a livelist") != 0) { return 0 - 1; }
    }
    if (bmo != 0) {
        var bd = zfs_wdn(3);
        var bc = 0;
        if (zfs_dnode(zfs_mem + ZR_MOS, bmo, bd) != 0 || zfs_zap_next(bd, &bc) != 0) { return zfs_wno("bookmarks"); }
    }
    if (nrm != 0) { return zfs_wno("normalization"); }
    if (cs != 0) { return zfs_wno("case-insensitive"); }
    var ro = zfs_wprop(dir, "readonly", 0);
    if (ro == (0 - 2)) { return zfs_wno("properties unreadable"); }
    if (ro != 0) { return zfs_wno("readonly=on"); }
    var ck = zfs_wprop(dir, "checksum", 1);
    if (ck == (0 - 2)) { return zfs_wno("properties unreadable"); }
    ck = zfs_wmdck(ck);
    if (ck == 12) { return zfs_wno("metadata checksum skein"); }
    if (ck == 13) { return zfs_wno("metadata checksum edonr"); }
    if (ck == 14) { return zfs_wno("metadata checksum blake3"); }
    if (ck != 7 && ck != 8 && ck != 11) { return zfs_wnon("metadata checksum ", ck); }
    if (zc == 1) { return zfs_wno("ZIL replay needed"); }
    # (B9) a snapshot — or a clone's origin — before the head: the kill of a block it owns goes to the head's DEADLIST
    # (WPA § 7.4; zfs_wdl_add), which must be one agnos writes: a DEADLIST ZAP with its 320-byte header, or the
    # pre-SPA_VERSION_DEADLISTS form, one BPOBJ (dl_oldfmt). (B9 review, k.101) Judged whenever a block CAN be the
    # previous snapshot's — ds_prev_snap_txg >= TXG_INITIAL — whichever object ds_prev_snap_obj names: $ORIGIN@$ORIGIN is
    # created with ds_creation_txg 1 (dsl_dataset_snapshot_sync_impl: "the origin's ds_creation_txg has to be <
    # TXG_INITIAL") and every head attached to it, created or upgraded (upgrade_clones_cb), carries that 1
    if (prev != 0 && zfs_wugt(ZWK_TXGI, load64(bon + 16)) == 0) {
        var dl = zfs_wdn(3);
        if (zfs_dnode(zfs_mem + ZR_MOS, load64(bon + 64), dl) != 0 || zfs_wdl_ok(dl) == 0) { return zfs_wno("deadlist unreadable"); }
    }
    return 0;
}

# --- the writer area ----------------------------------------------------------------------------------------------
fn zfs_wmem_get() {
    if (zfs_wmem != 0) { return 0; }
    zfs_wmem_phys = pmm_alloc_2mb_run(ZWK_WRUNS);
    if (zfs_wmem_phys == 0) { return zfs_wno("no 10 MiB writer area"); }
    zfs_wmem = pmm_kva_for_access(zfs_wmem_phys);
    memset(zfs_wmem + ZWA_DN, 0, ZWA_END - ZWA_DN);
    zfs_ngho = 0;
    zfs_wl_gmk = 0;
    zfs_wl_gret = 0;
    return 0;
}
fn zfs_wmem_put() {
    if (zfs_wmem_phys == 0) { return 0; }
    var k = 0;
    while (k < ZWK_WRUNS) {
        pmm_free_2mb(zfs_wmem_phys + k * 0x200000);
        k = k + 1;
    }
    zfs_wmem_phys = 0;
    zfs_wmem = 0;
    return 0;
}

# --- B2: the device write, the embedded checksum, the flush, the uberblock-only commit (design § d, § h) ----------
# The uberblock ring's slot size, 1 << MIN(MAX(ashift, 10), 13) (VDEV_UBERBLOCK_SHIFT); 128 KiB of them per label.
fn zfs_ub_slot() {
    var sh = zfs_ashift;
    if (sh < 10) { sh = 10; }
    if (sh > 13) { sh = 13; }
    return 1 << sh;
}
# Is [off, off+len) inside ONE label's 128 KiB uberblock ring? 1 / 0.
fn zfs_wr_ring(off, len) {
    var l = 0;
    while (l < 4) {
        var r = zfs_label_off(l) + ZK_UBOFF;
        if (off >= r && off + len <= r + ZK_UBRING) { return 1; }
        l = l + 1;
    }
    return 0;
}
# Is [off, off + len) (partition bytes) inside ONE extent the open txg ALLOCATED (zfs_xl, an ALLOC's +0 is its DVA
# offset)? 1 / 0.
fn zfs_wr_mine(off, len) {
    var d = off - ZK_DATA0;
    if (d < 0) { return 0; }
    var k = 0;
    while (k < zfs_xl_n) {
        var w = load64(zfs_xl(k));
        if ((w >> 63) == 0 && d >= w && d + len <= w + zfs_xl_asz(zfs_xl(k))) { return 1; }
        k = k + 1;
    }
    return 0;
}
# Write [off, off+len) of the pool device (partition-relative bytes) from src — the mirror of zfs.cyr zfs_rd: at most
# 4 KiB per blk_write_sectors_on command (NVMe's single-command size, nvme_blk_write_sectors). 0 / -1; the first
# failed command ends it and the caller fails the commit. ⛔ Refused before any I/O:
#   · a pool that is not rw — the gate refused it, or a commit already failed (zfs_wfail)
#   · a range outside the device, or a device of unknown size (zfs_dev_bytes 0: no back labels to find)
#   · a range off LBA boundaries — the pool gate refuses ashift below the LBA size, so every extent a commit writes is
#     aligned; an unaligned one would read-modify-write a sector holding bytes this txg does not own
#   · anything but a uberblock ring or ONE extent the open txg ALLOCATED (B3b; makefs's own assertion, makefs/zfs/
#     vdev.c:83-110): a label's [0, 128 KiB) (pad, boot env, nvlist — WPA § 2.2), the 3.5 MiB boot region, and every
#     byte T - 1 references, or a txg in the deferral window freed (k.125: released 2 txgs later), is never written (§ d)
fn zfs_wr(off, len, src) {
    if (zfs_rw != 1 || len <= 0 || off < 0) { return 0 - 1; }
    if (zfs_dev_bytes == 0 || off + len > zfs_dev_bytes) { return 0 - 1; }
    var lb = zfs_lbsz;
    if ((off % lb) != 0 || (len % lb) != 0) { return 0 - 1; }
    if (zfs_wr_ring(off, len) == 0 && zfs_wr_mine(off, len) == 0) { return 0 - 1; }
    zfs_wt_cutw();                                    # (B11) the crash-cut knob (ZFS_WRITE_OPS; a no-op twin otherwise)
    var lba = zfs_part_lba + off / lb;
    var n = len / lb;
    var per = 4096 / lb;
    var i = 0;
    while (i < n) {
        var c = n - i;
        if (c > per) { c = per; }
        kirqw_point();                                # (B11) an interrupt window between two commands (io.cyr)
        if (blk_write_sectors_on(zfs_backend, lba + i, c, src + i * lb) != 0) { return 0 - 1; }
        i = i + c;
    }
    return 0;
}
# The embedded checksum of the len-byte block at buf — the inverse of zfs.cyr zfs_eck_ok (RPA § 1.1, WPA § 2.1): the
# zio_eck_t in the LAST 40 bytes gets the magic and the verifier (voff, 0, 0, 0), SHA-256 runs over the whole block,
# and the digest words replace the verifier (zio_checksum_compute, zio_checksum.c:389-414). voff is the block's byte
# offset on the LEAF vdev — partition-relative for a partition vdev (zio_checksum_label_verifier, :295-298; makefs
# makefs/zfs/vdev.c:146-158) — so the four copies of one uberblock carry four different checksums.
fn zfs_eck_set(buf, len, voff) {
    var e = buf + len - 40;
    store64(e, ZK_ECKMAGIC);
    store64(e + 8, voff);
    store64(e + 16, 0);
    store64(e + 24, 0);
    store64(e + 32, 0);
    var got[32];
    zfs_sha256_words(buf, len, &got);
    memcpy(e + 8, &got, 32);
    return 0;
}
# The device cache flush, the commit's two barriers (WPA § 2.3). 0 / -1, and -1 FAILS THE COMMIT (operator ruling
# pending — B2 review): OpenZFS issues its flushes CANFAIL | DONT_PROPAGATE and ignores the error (zio.c:1731-1743),
# but this device is then not trusted with T + 1. A device with NO cache to flush is not an error, and the block layer
# answers 0 for it on every backend: virtio without VIRTIO_BLK_F_FLUSH, the ramdisk, and (since 1.57.12) a USB stick
# whose SYNCHRONIZE CACHE draws ILLEGAL REQUEST / INVALID COMMAND OPERATION CODE — msc_blk_flush records it and stops
# issuing the command, OpenZFS's vdev_nowritecache (zio.c:4978-4987). NVMe and AHCI flush unconditionally.
fn zfs_wflush() {
    kirqw_point();                                    # (B11) windows around the flush (and inside its poll: nvme / ahci)
    var r = blk_flush_on(zfs_backend);
    kirqw_point();
    return r;
}
#ifdef ZFS_WRITE_OPS
var zfs_wt_n = 0;            # the op list (zfs_wtest): ops started · ops failed · the mounted uberblock's timestamp
var zfs_wt_f = 0;
var zfs_wt_ts0 = 0;
# The op list's DETERMINISTIC clock (design § i.1): the mounted uberblock's timestamp + the ops started, so the images
# it writes are byte-reproducible run to run — never below the previous uberblock's (the production rule, below;
# the host audit's h3 checks it on every new uberblock).
fn zfs_wclock(prev) {
    var t = zfs_wt_ts0 + zfs_wt_n;
    if (t < prev) { t = prev; }
    return t;
}
#endif
#ifndef ZFS_WRITE_OPS
# ub_timestamp: UTC seconds of the agnos clock (the RTC seed or NTP, net_ntp.cyr ntp_now — 0 when never set), never
# below the previous uberblock's (WPA § 2.1: a SHOULD — the selection tie-break and the rewind report; makefs writes 0).
fn zfs_wclock(prev) {
    var t = ntp_now();
    if (t < prev) { t = prev; }
    return t;
}
#endif
# A commit of txg t that cannot finish: the pool is READ-ONLY until reboot (design § b.3) — zfs_rw 0, every dataset's
# verdict 0, the writer area returned — with the named line `zfs: commit txg <t> failed: <why> - pool read-only until
# reboot`. why + num (num < 0: none) also land in zfs_wr_* for the caller; zfs_wfail_now names the refusal already in
# zfs_wr_* (the plan's). -1.
fn zfs_wfail(t, why, num) {
    zfs_wnon(why, num);
    return zfs_wfail_now(t);
}
fn zfs_wfail_now(t) {
    if (zfs_wr_lit == 0) { zfs_wno("unnamed failure"); }
    zfs_rw = 0;
    var i = 0;
    while (i < zfs_nds) {
        store64(zfs_ds(i) + 1016, 0);
        i = i + 1;
    }
    kprint("zfs: commit txg ", 16);
    kprint_num(t);
    kprint(" failed: ", 9);
    kprint(zfs_wr_lit, strlen(zfs_wr_lit));
    if (zfs_wr_nml > 0) { kprint(&zfs_wr_nm, zfs_wr_nml); }
    if (zfs_wr_num >= 0) { kprint_num(zfs_wr_num); }
    kprintln(" - pool read-only until reboot", 30);
    zfs_wmem_put();
    return 0 - 1;
}
# ⭐ THE UBERBLOCK-ONLY COMMIT (design § h B2): uberblock T = T0 + 1 naming the SAME ub_rootbp as T0 — what OpenZFS
# itself writes when the config is dirty but no block changed (vdev_label.c:2069-2077); B0 forged one (main@ubonly)
# and every oracle phase accepted it (design § k.1). The fields are uberblock_update's (uberblock.c:48-75, WPA § 2.1):
# magic, txg T, timestamp (zfs_wclock), software_version 5000, mmp_magic, mmp_delay / mmp_config 0 (the gate refuses
# multihost), checkpoint_txg 0; version, guid_sum, rootbp and raidz_reflow_info COPIED from T0; zeros up to the eck.
# The order is vdev_config_sync's (vdev_label.c:2027-2163) without its two label phases, which agnos never runs:
#   1. FLUSH — every block of T is durable before any uberblock names it (B2 wrote none; from B3 on, design § d.3)
#   2. slot n = T % N into L0, L1, L2, L3 — vdev_uberblock_sync's own issue order (:1791-1795) — each copy with its
#      own eck (the verifier is that copy's offset); no other slot of any label is touched
#   3. FLUSH — vdev_uberblock_sync_list's (:1825-1851): T is durable before the commit returns
#   4. publish: ZR_UB and zfs_txg become T, so the next commit is T + 1 (design § d.6)
# ⭐ CRASH CONSISTENCY (design § b.3, WPA § 2.3): until one copy of slot n is durable the pool IS T0 — T0's own slot
# (index T0 % N, never n) is untouched and still verifies. A copy torn by a crash fails its embedded SHA-256 and is
# skipped (vdev_uberblock_load checks every slot of every label), so the copies that landed whole decide: none → T0,
# any one → T, whose blocks step 1 made durable (in B2, whose rootbp IS T0's). The copies are ISSUED in label order,
# but until step 3 a write cache may persist any subset of them, torn or whole — every subset is one of those two
# pools, and OpenZFS opens either. agnos's gate skips a torn copy the same way (zfs_wub_scan), so the next mount is
# rw at whichever txg won, and a mount at T0 commits T0 + 1 into slot n first — over the torn copy.
# ⛔ A failed write or flush leaves the pool READ-ONLY until reboot (zfs_wfail): T may or may not be durable — the next
# mount selects whichever verifies best, both consistent — but this device is not trusted with T + 1. B2 moves no
# in-memory root (T's rootbp is T0's), so nothing is reloaded; B3's failure path drops the dirty set and reloads the
# roots (design § b.3). Caller holds fs_spin_lock (the op list; later the commit hooks). 0 / -1 (zfs_wr_* says why).
# ⭐ B3b: zfs_commit_ubw(rbp) is the same uberblock naming rbp instead — T's new MOS rootbp (zfs_commit), whose blocks
# step 1 makes durable; zfs_commit_ub is it with T0's own.
fn zfs_commit_ub() {
    if (zfs_commit_ubw(zfs_mem + ZR_UB + 40) != 0) { return 0 - 1; }
    return zfs_wdef_rel(zfs_txg);                     # (B11) txg T is durable: the frees of T - 2 leave the window
}
fn zfs_commit_ubw(rbp) {
    if (zfs_rw != 1) { return zfs_wno("pool read-only"); }
    var t = zfs_txg + 1;
    var ss = zfs_ub_slot();
    var n = t % (ZK_UBRING / ss);
    var cur = zfs_mem + ZR_UB;
    var ub = zfs_wmem + ZWA_UBS;
    memset(ub, 0, ss);
    memcpy(ub, cur, 216);                      # sizeof (uberblock_t), T0's: version, guid_sum, rootbp, reflow info
    memcpy(ub + 40, rbp, 128);                 # ub_rootbp (B3b: T's; B2: T0's own)
    store64(ub, ZK_UBMAGIC);
    store64(ub + 16, t);
    store64(ub + 32, zfs_wclock(load64(cur + 32)));
    store64(ub + 168, 5000);                   # ub_software_version = SPA_VERSION
    store64(ub + 176, ZWK_MMP);                # ub_mmp_magic
    store64(ub + 184, 0);                      # ub_mmp_delay
    store64(ub + 192, 0);                      # ub_mmp_config
    store64(ub + 200, 0);                      # ub_checkpoint_txg
    if (zfs_wflush() != 0) { return zfs_wfail(t, "device flush before the uberblock", 0 - 1); }
    var l = 0;
    while (l < 4) {
        var off = zfs_label_off(l) + ZK_UBOFF + n * ss;
        zfs_eck_set(ub, ss, off);
        zfs_wr_cls = 5 + l;
        if (zfs_wr(off, ss, ub) != 0) { return zfs_wfail(t, "uberblock write to label L", l); }
        l = l + 1;
    }
    if (zfs_wflush() != 0) { return zfs_wfail(t, "device flush after the uberblock", 0 - 1); }
    memcpy(cur, ub, 256);
    zfs_txg = t;
    return 0;
}


# --- B3a: the dirty set (design § b.1) ------------------------------------------------------------------------------
# The open txg T = zfs_txg + 1 is its DIRTY SET: blocks keyed (objset, object, level, blkid) (the key space is above,
# enum ZfsWD), each a private copy of its content in the writer area — data blocks in the 4 MiB data arena, metadata
# (indirects, dnode blocks, ZAP / SA / space-map blocks, objset_phys) in the metadata arena. A slot is the block's
# lsize rounded up to the allocation unit with the tail ZEROED: zio_vdev_io_start pads every write to asize with zeros
# (zio.c:4686-4697), and an uncompressed block is written straight from its slot. Nothing here reads the pool: the
# caller copies a block in (dirty-first, then the reader — design § b.1) and edits the copy. The commit (B3b) walks
# the set bottom-up in zfs_dirty_plan's order, finalising each block (zfs_bp_build) into its parent's copy, so the
# BP a block REPLACES is still in that parent's slot until the child is finalised — the index keeps no BPs.
# Entry (64 B, zfs_dent): +0 objset · +8 object · +16 blkid · +24 level · +32 lsize · +40 the slot (offset in the
# writer area) · +48 the hash chain (entry + 1, 0 = end) · +56 flags (ZWD_*) | DMU type << 8.
var zfs_dx_n = 0;            # dirty blocks in the open txg
var zfs_dx_data = 0;         # bytes of the data arena in use
var zfs_dx_meta = 0;         # bytes of the metadata arena in use
var zfs_xl_n = 0;            # extents (ALLOC / FREE) the open txg recorded for its log space map
var zfs_xl_rap = 0;          # already-deferred units (zfs_xl_pre) zfs_wxl_apply re-applied at reloads (the op list's)
var zfs_tx_alloc = 0;        # bytes the open txg allocated (Σ ALLOC asize) — and freed (Σ FREE asize)
var zfs_tx_free = 0;
var zfs_bpb_va = 0;          # zfs_bp_build's result: the VA of the physical bytes to write
var zfs_wd_n = 0;            # B4: datasets with dirty blocks in the open txg (ZWA_DSX) · user/group/project deltas
var zfs_wq_n = 0;            #   (ZWA_UQ) · the table entries the txg's ops reserved for the commit (zfs_wd_dirty1)
var zfs_wq_rsv = 0;
var zfs_wfr_n = 0;           # B5: the txg's deferred kills (a truncation's freed BPs, zfs_wf_kl — ZWF_FRL) · the data
var zfs_dx_dmax = 0;         #   arena's limit while that list lives in its upper half (0 = all of ZWK_DARENA)
var zfs_wblk_nr = 0;         # B5: 1 = zfs_wblk's NEXT data block is overwritten whole — not read (consumed by it)
var zfs_wfr_x = 0;           # B5 review: the DVAs of the kill list — each a FREE extent of log T (zfs_wf_xfit)
var zfs_wl_hb = 0;           # (B10 review, k.119) hygiene's MINIMUM in the open txg (zfs_wl_hres), held back by every
var zfs_wl_hx = 0;           #   admission outside the commit (zfs_wf_alim, zfs_wf_xfit): dirty blocks · FREE extents ·
var zfs_wl_hm = 0;           #   metadata-arena bytes of the first flush zfs_wl_plan tries and of destroying every live log
var zfs_wl_wu = 0;           # (B10 review) a flush that waited: the arena in use · what it asked · the extent room (1 / 0)
var zfs_wl_wn = 0;
var zfs_wl_wr = 0;
var zfs_wl_cnb = 0;          # (B10 review) a dry zfs_wl_flush's cost: dirty blocks · metadata-arena bytes (0 0: an empty
var zfs_wl_cneed = 0;        #   delta)
var zfs_wf_infl = 0;         # B5: the open txg's in-flight user data — request bytes x 24 (OpenZFS's tempreserved,
var zfs_wf_inflr = 0;        #   worst-case inflated) and their raw allocation (asize x copies) — that zfs_wd_space
var zfs_wf_ud = 0;           #   charged (k.36) · the user data the commit then ALLOCATED (Σ dsize of the data blocks
#   born): never more than charged (zfs-write-smoke holds every plan line to it — B5 review)
var zfs_wfb_du = 0;          # B7: the open txg's kills DEFERRED to free_bpobj (zfs_wfb_add) — Σ dsize / PSIZE / UCSIZE,
var zfs_wfb_dc = 0;          #   $FREE's charge at the end of the dataset phase (zfs_wfb_charge) — and their count
var zfs_wfb_duc = 0;
var zfs_wfb_n = 0;
var zfs_wfb_q = 0;           # (B7 review, design k.70) the kills the open txg WILL defer — kill-list entries and dirtied
#   blocks whose predecessor defers — whose free_bpobj appends the commit dirties: zfs_wfb_meta budgets them
var zfs_wfb_c = 0 - 1;       # free_bpobj's committed bpo_num_blkptrs, read at the txg's first budget (-1: not yet) ·
var zfs_wfb_bs = 0;          #   its block size · its indirect block size · its blkptrs (zfs_wfb_meta)
var zfs_wfb_ib = 0;
var zfs_wfb_np = 0;
var zfs_wdl_n = 0;           # B9: deadlist entries the open txg loaded (ZWA_DLE, zfs_wdl_load) · its deadlist appends (the
var zfs_wdl_app = 0;         #   op list's plan line: dl=) · the bpobjs it materialised from empty_bpobj (mat=) · Σ dsize
var zfs_wdl_nm = 0;          #   appended (dlu=) · (B9 review, k.100) the appends whose entry no admission counted (dlx=:
var zfs_wdl_du = 0;          #   0 — every deadlist load and every refusal of one ran before the commit) · 1 = zfs_wblk's
var zfs_wdl_ux = 0;          #   last refusal was the txg's size (zfs_wdl_q chk 1: a write ends its txg there instead)
var zfs_wdl_full = 0;

fn zfs_dent(e) { return zfs_wmem + ZWA_DIX + e * 64; }
fn zfs_dirty_buf(e) { return zfs_wmem + load64(zfs_dent(e) + 40); }
fn zfs_msx(i) { return zfs_wmem + ZWA_MSX + i * 8; }
fn zfs_xl(k) { return zfs_wmem + ZWA_XL + k * 16; }
fn zfs_xl_asz(x) { return load64(x + 8) & ZWK_XLASZ; }
fn zfs_xl_pre(x) { return load64(x + 8) >> 40; }
# The bucket of a key: a multiplicative mix kept to its top 10 bits (>> is logical in Cyrius, so the high bits are
# taken without sign trouble).
fn zfs_dhash(os, obj, lv, bid) {
    var h = os * 0x9E3779B97F4A7C15 + obj * 0xC2B2AE3D27D4EB4F + bid * 0x165667B19E3779F9 + lv;
    h = (h ^ (h >> 29)) * 0xBF58476D1CE4E5B9;
    return h >> 54;
}
# An empty dirty set and extent list for a new txg (or after a failed one). The bitmaps are NOT touched: a caller
# dropping a txg that allocated must first undo it (zfs_wxl_undo) or put the pool read-only (zfs_wfail).
fn zfs_dirty_reset() {
    zfs_dx_n = 0;
    zfs_dx_data = 0;
    zfs_dx_meta = 0;
    zfs_xl_n = 0;
    zfs_tx_alloc = 0;
    zfs_tx_free = 0;
    zfs_wd_n = 0;
    zfs_wq_n = 0;
    zfs_wq_rsv = 0;
    zfs_wfr_n = 0;
    zfs_dx_dmax = 0;
    zfs_wblk_nr = 0;
    zfs_wfr_x = 0;
    zfs_wf_infl = 0;
    zfs_wf_inflr = 0;
    zfs_wf_ud = 0;
    zfs_wfb_du = 0;
    zfs_wfb_dc = 0;
    zfs_wfb_duc = 0;
    zfs_wfb_n = 0;
    zfs_wfb_q = 0;
    zfs_wfb_c = 0 - 1;
    zfs_wz_mres = 0;
    zfs_wdl_n = 0;
    zfs_wdl_app = 0;
    zfs_wdl_nm = 0;
    zfs_wdl_du = 0;
    zfs_wdl_ux = 0;
    memset(zfs_wmem + ZWA_DHT, 0, ZWK_DHASH * 4);
    return 0;
}
# The data arena's limit: all of it, or its lower half while the txg's kill list lives in the upper (B5, ZWF_FRL).
fn zfs_dx_lim() {
    if (zfs_dx_dmax != 0) { return zfs_dx_dmax; }
    return ZWK_DARENA;
}
# The entry holding (os, obj, lv, bid), or -1.
fn zfs_dirty_find(os, obj, lv, bid) {
    var c = load32(zfs_wmem + ZWA_DHT + zfs_dhash(os, obj, lv, bid) * 4);
    while (c != 0) {
        var d = zfs_dent(c - 1);
        if (load64(d) == os && load64(d + 8) == obj && load64(d + 16) == bid && load64(d + 24) == lv) { return c - 1; }
        c = load64(d + 48);
    }
    return 0 - 1;
}
# Dirty (os, obj, lv, bid): lsize bytes, flags fl (ZWD_DATA picks the data arena; | type << 8), content copied from
# src (0 = zeros). The entry, or -1 when the key is already dirty or the set / its arena is full — then the caller
# commits first (policy, design § b.2) — all named in zfs_wr_*.
fn zfs_dirty_add(os, obj, lv, bid, lsize, fl, src) {
    if (lsize < 512 || (lsize & 511) != 0 || lv < 0 || lv > 31) { return zfs_wnon("dirty block size ", lsize); }
    if (zfs_dirty_find(os, obj, lv, bid) >= 0) { return zfs_wnon("block dirtied twice: object ", obj); }
    if (zfs_dx_n >= ZWK_MAXDIRTY) { return zfs_wnon("dirty set full: blocks ", zfs_dx_n); }
    var un = 1 << zfs_ashift;
    var asz = (lsize + un - 1) & (0 - un);
    var off = 0;
    if ((fl & ZWD_DATA) != 0) {
        if (lsize > ZK_DATAMAX || zfs_dx_data + asz > zfs_dx_lim()) { return zfs_wnon("dirty data full: bytes ", zfs_dx_data); }
        off = ZWA_OS + zfs_dx_data;
        zfs_dx_data = zfs_dx_data + asz;
    } else {
        if (lsize > ZK_METAMAX || zfs_dx_meta + asz > ZWK_MARENA) { return zfs_wnon("dirty metadata full: bytes ", zfs_dx_meta); }
        off = ZWA_META + zfs_dx_meta;
        zfs_dx_meta = zfs_dx_meta + asz;
    }
    var b = zfs_wmem + off;
    if (src != 0) {
        memcpy(b, src, lsize);
        memset(b + lsize, 0, asz - lsize);
    } else { memset(b, 0, asz); }
    var e = zfs_dx_n;
    var d = zfs_dent(e);
    var h = zfs_wmem + ZWA_DHT + zfs_dhash(os, obj, lv, bid) * 4;
    store64(d, os);
    store64(d + 8, obj);
    store64(d + 16, bid);
    store64(d + 24, lv);
    store64(d + 32, lsize);
    store64(d + 40, off);
    store64(d + 48, load32(h));
    store64(d + 56, fl);
    store32(h, e + 1);
    zfs_dx_n = e + 1;
    return e;
}
# The commit's walk order (design § d): every dataset objset before the MOS; inside one, ordinary objects (phase 0),
# then the user/group/project-used dnodes (1 — their deltas come from the dnodes of phase 0, design § d.1.2), then the
# meta-dnode (2 — it holds the dnodes the phases before finalised), then objset_phys (3); inside a phase, level
# ascending (a block before the indirect that points at it); in the MOS every non-chain block before every chain
# block (design § d.2.2). Ties keep insertion order (a stable sort), so a deterministic op list allocates
# deterministically and its images are byte-reproducible (design § i.1).
fn zfs_dirty_rank(e) {
    var d = zfs_dent(e);
    var obj = load64(d + 8);
    var ph = 0;
    if (obj == 0) { ph = 2; }
    elif (obj == ZWO_OSB) { ph = 3; }
    elif (obj > ZWO_OSB) { ph = 1; }
    var r = (ph << 8) | load64(d + 24);
    if (load64(d) == 0) {
        r = r | 0x1000;
        if ((load64(d + 56) & ZWD_CHAIN) != 0) { r = r | 0x800; }
    }
    return r;
}
# Build the walk order into ZWA_ORD (u32 entry indices; a stable insertion sort — at most ZWK_MAXDIRTY entries, once
# per commit). Returns the count; zfs_dirty_at(k) is the k-th block to finalise.
fn zfs_dirty_plan() {
    var ord = zfs_wmem + ZWA_ORD;
    var k = 0;
    while (k < zfs_dx_n) {
        var rk = zfs_dirty_rank(k);
        var j = k;
        while (j > 0 && zfs_dirty_rank(load32(ord + (j - 1) * 4)) > rk) {
            store32(ord + j * 4, load32(ord + (j - 1) * 4));
            j = j - 1;
        }
        store32(ord + j * 4, k);
        k = k + 1;
    }
    return zfs_dx_n;
}
fn zfs_dirty_at(k) { return load32(zfs_wmem + ZWA_ORD + k * 4); }

# --- B3a: the open txg's extents (design § c.3, c.4) ----------------------------------------------------------------
# Every ALLOC and FREE of T, in order: +0 the DVA offset | FREE << 63, +8 asize | pre << 40 (zfs_xl_asz, zfs_xl_pre:
# for a FREE, how many of its units were ALREADY deferred when it ran — 0 but on a pool OpenZFS last ran at its slop;
# see zfs_wxl_undo). Log T is encoded from it (B3b: the asize is zfs_xl_asz, never the raw word); a metaslab reloaded
# during T gets its share re-applied from it (zfs_wxl_apply), which is why the list, not the bitmap, is the record.
# Each extent lies inside ONE metaslab (allocations never cross one, frees are refused if they do).
fn zfs_wxl_add(off, asz, fr, pre) {
    if (zfs_xl_n >= ZWK_MAXXL) { return zfs_wnon("txg extent list full: extents ", zfs_xl_n); }
    var x = zfs_xl(zfs_xl_n);
    store64(x, off | (fr << 63));
    store64(x + 8, asz | (pre << 40));
    zfs_xl_n = zfs_xl_n + 1;
    return 0;
}
# Apply the open txg's extents of metaslab i to its freshly replayed bitmaps (zfs_ms_load): ALLOC sets allocated bits
# (each must be clear), FREE clears them (each must be set) and sets the deferred bits — some of which the replay may
# have set already (zfs_xl_pre; zfs_ms_load recounts from the bitmap, so nothing is counted twice). 0 / -1.
fn zfs_wxl_apply(i, abm, dbm) {
    var k = 0;
    while (k < zfs_xl_n) {
        var x = zfs_xl(k);
        var w = load64(x);
        var off = w & ZWK_OFF63;
        if ((off >> zfs_ms_shift) == i) {
            var b = (off - (i << zfs_ms_shift)) >> zfs_ashift;
            var n = zfs_xl_asz(x) >> zfs_ashift;
            if ((w >> 63) == 0) {
                if (zfs_bm_op(abm, b, n, 1) != 0) { return 0 - 1; }
            } else {
                if (zfs_bm_op(abm, b, n, 0) != 0) { return 0 - 1; }
                zfs_bm_op(dbm, b, n, 2);
                zfs_xl_rap = zfs_xl_rap + zfs_xl_pre(x);
            }
        }
        k = k + 1;
    }
    return 0;
}
# Undo the open txg's extents from the newest down to the first `keep` (an allocation that failed part-way returns
# its DVAs — metaslab_alloc_range's unwind, metaslab.c:6032-6041; the selftest returns everything). The counts track
# the metaslab resident or not (a non-resident one keeps its last loaded counts + T's): an ALLOC gives back its
# bytes, a FREE takes back its bytes and the deferred bytes it ADDED (asize - pre units). A resident metaslab also gets
# its bits back: an ALLOC's cleared; a FREE's re-set and, when it deferred every unit itself (pre 0), un-deferred. A
# FREE that found units already deferred (pre > 0) EVICTS the metaslab instead: on a pool OpenZFS last ran at its slop
# it does not defer (metaslab.c:4573-4577, :4616-4632), so a range freed in T0 - 1 and reallocated in T0 is both
# allocated and deferred here once log T0 - 1 outlives the export (zfs_keep_log_spacemaps_at_export, spa.c:2073;
# zfs-write-smoke's wr@u0 and full@pre lanes forge it, zfs-damage.py pre-defer) — which of its units were deferred
# before the FREE is not recorded, and the next load rebuilds exactly that from disk plus the shortened list. A
# non-resident metaslab needs no bits: its next load replays the shortened list. 0 / -1 (a bit was not as the extent
# left it).
fn zfs_wxl_undo(keep) {
    var rc = 0;
    while (zfs_xl_n > keep) {
        zfs_xl_n = zfs_xl_n - 1;
        var x = zfs_xl(zfs_xl_n);
        var w = load64(x);
        var off = w & ZWK_OFF63;
        var asz = zfs_xl_asz(x);
        var n = asz >> zfs_ashift;
        var i = off >> zfs_ms_shift;
        var b = (off - (i << zfs_ms_shift)) >> zfs_ashift;
        var me = zfs_msent(i);
        var s = load64(me + 40);
        if ((w >> 63) == 0) {
            zfs_tx_alloc = zfs_tx_alloc - asz;
            store64(me + 24, load64(me + 24) - asz);
            if (s != 0) { if (zfs_bm_op(zfs_bm_a(s - 1), b, n, 0) != 0) { rc = 0 - 1; } }
        } else {
            zfs_tx_free = zfs_tx_free - asz;
            store64(me + 24, load64(me + 24) + asz);
            store64(me + 32, load64(me + 32) - ((n - zfs_xl_pre(x)) << zfs_ashift));
            if (s != 0) {
                var abm = zfs_bm_a(s - 1);
                if (zfs_bm_op(abm, b, n, 1) != 0) { rc = 0 - 1; }
                if (zfs_xl_pre(x) == 0) {
                    if (zfs_bm_op(abm + zfs_bm_bytes, b, n, 0) != 0) { rc = 0 - 1; }
                } else { zfs_ms_evict(i); }
            }
        }
    }
    return rc;
}

# --- B3a: allocation (design § c.3) ----------------------------------------------------------------------------------
# The pool's slop (spa_get_slop_space, spa_misc.c:1966-2000; WPA § 6.7): space = the normal class's metaslabs — all
# of them, but the one OpenZFS moves to the embedded-log class when the vdev has more than 64 (zfs_embedded_slog_min_ms,
# vdev.c:1687-1726) — slop = MIN(space >> 5, 128 GiB), less MIN(that log metaslab, slop / 2), at least
# MIN(space / 2, 128 MiB). On the 96-256 MiB fixtures half the pool is slop.
fn zfs_wslop() {
    var nms = zfs_ms_count;
    var lg = 0;
    if (nms > 64) {
        nms = nms - 1;
        lg = 1 << zfs_ms_shift;
    }
    return zfs_wslop_sp(nms << zfs_ms_shift, lg);
}
# The slop of a normal class of space bytes whose embedded-log metaslab is lg bytes (0: none) — statfs#103 takes it
# of a read-only pool's allocatable size (zfs.cyr zfs_fill_statfs, B5 review).
fn zfs_wslop_sp(space, lg) {
    var slop = space >> 5;
    if (slop > 0x2000000000) { slop = 0x2000000000; }
    var h = slop >> 1;
    if (lg < h) { h = lg; }
    slop = slop - h;
    var mn = space >> 1;
    if (mn > 0x8000000) { mn = 0x8000000; }
    if (slop < mn) { slop = mn; }
    return slop;
}
# The bytes the pool may hold allocated before user data reaches its slop: dsl_pool_unreserved_space (dsl_pool.c:
# 950-957) — the normal class (one metaslab short from 64 on: the embedded log class) less the slop less the DEFERRED
# frees (metaslab_class_get_deferred). agnos defers every free for TXG_DEFER_SIZE = 2 txgs as OpenZFS does (zfs_w_defer;
# B11 — until B11 for the whole boot) and the mount's T0 - 2 .. T0 where OpenZFS defers none after an import
# two txgs, so this is never above OpenZFS's figure. A txg's own FREEs stay busy until zfs_wc_pub moves them from
# zfs_w_alloc into zfs_w_defer, so a caller adds the open txg's allocations, never subtracts its frees (B4 review).
# ⭐ B5 review: and never above what the ALLOCATOR can reach — it allocates only in metaslabs with a space map
# (zfs_wpick: a never-synced one is not used in 1.57.12), which hold every allocated and every deferred byte — so
# their size less zfs_w_defer less ZWK_MDRES (one commit's metadata, which user data must leave free). Measured over
# the whole class (OpenZFS's figure alone), `wr` (4 of 15 metaslabs synced) let user data through until a commit found
# no metaslab — the pool read-only until reboot — where this answers ENOSPC (a short write) before the txg is dirtied.
# This is agnos's ALLOCATION rule's figure (zfs_wd_aroom, zfs_walloc_bp; statfs's f_bavail); OpenZFS's own quota model
# on dd_used keeps OpenZFS's figure (zfs_wroomz, zfs_wd_space's dsl_dir walk — dd_used counts reservations, which no
# metaslab holds).
fn zfs_wroom() {
    var r = zfs_wroomz();
    var p = zfs_wphys();
    if (p < r) { r = p; }
    if (r < 0) { r = 0; }
    return r;
}
fn zfs_wroomz() {
    var nms = zfs_ms_count;
    if (nms > 64) { nms = nms - 1; }
    var r = (nms << zfs_ms_shift) - zfs_wslop() - zfs_w_defer;
    if (r < 0) { r = 0; }
    return r;
}
# The allocator's own bound in the same frame (pool allocated + the open txg's allocations): Σ the size of the metaslabs
# with a space map, less zfs_w_defer, less ZWK_MDRES. A txg is opened only below it (zfs_wf_begin): its commit's
# metadata then has ZWK_MDRES to allocate in.
fn zfs_wphys() {
    var ns = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        if (load64(zfs_msent(i)) != 0) { ns = ns + 1; }
        i = i + 1;
    }
    if (zfs_wt_msmax > 0 && ns > zfs_wt_msmax) { ns = zfs_wt_msmax; }
    return (ns << zfs_ms_shift) - zfs_w_defer - ZWK_MDRES;
}
# statfs#103's available bytes on a WRITABLE pool (zfs.cyr zfs_fill_statfs, B5 review — design § a.4): what user data
# may still take, zfs_wroom less the pool's allocated bytes; -1 on a read-only pool.
fn zfs_wavail() {
    if (zfs_rw != 1 || zfs_wmem == 0) { return 0 - 1; }
    var r = zfs_wroom() - zfs_w_alloc;
    if (r < 0) { r = 0; }
    return r;
}
# Is unit b of a resident metaslab busy — allocated, or deferred (freed inside the window: zfs_wdef_lo, B11)? 1 / 0.
fn zfs_wbusy(abm, dbm, b) {
    return ((load8(abm + (b >> 3)) | load8(dbm + (b >> 3))) >> (b & 7)) & 1;
}
# The first run of n free units starting in [from, to) (runs may extend to the metaslab's end, never past it). The
# start unit, or -1. Whole busy words are skipped 64 units at a time.
fn zfs_wfit_rng(abm, dbm, from, to, n) {
    var b = from;
    while (b < to) {
        if ((b & 63) == 0) {
            if ((load64(abm + (b >> 3)) | load64(dbm + (b >> 3))) == (0 - 1)) {
                b = b + 64;
                continue;
            }
        }
        if (zfs_wbusy(abm, dbm, b) == 1) {
            b = b + 1;
            continue;
        }
        var e = b + 1;
        while (e < zfs_ms_bits && e - b < n) {
            if (zfs_wbusy(abm, dbm, e) == 1) { break; }
            e = e + 1;
        }
        if (e - b == n) { return b; }
        b = e + 1;
    }
    return 0 - 1;
}
# First fit of n units in resident slot s (metaslab i) from its cursor, wrapping once (design § c.3). Unit / -1.
fn zfs_wfit(s, i, n) {
    var abm = zfs_bm_a(s);
    var dbm = abm + zfs_bm_bytes;
    var cur = load64(zfs_msx(i));
    var r = zfs_wfit_rng(abm, dbm, cur, zfs_ms_bits, n);
    if (r < 0 && cur > 0) { r = zfs_wfit_rng(abm, dbm, 0, cur, n); }
    return r;
}
# Is metaslab i distinct from those of DVAs 0..d-1 already in bp? OpenZFS's ditto rule on one vdev:
# metaslab_is_unique (metaslab.c:4699-4717), required on the first pass of the search, relaxed on the second
# ("try_hard", metaslab.c:4952-4962). 1 / 0.
fn zfs_wuniq(bp, d, i) {
    var k = 0;
    while (k < d) {
        if ((((load64(bp + k * 16 + 8) & ZWK_OFF63) << 9) >> zfs_ms_shift) == i) { return 0; }
        k = k + 1;
    }
    return 1;
}
# The metaslab to try for an allocation of need bytes as DVA d of bp (design § c.3): a space map exists
# (sm_obj[i] != 0 — metaslabs never synced are not used in 1.57.12), not yet tried for this DVA, unique unless hard,
# its free estimate (size - allocated - deferred; deferred known only once loaded) >= need; a RESIDENT one before a
# non-resident one (a load replays a space map and logs), then the most free; ties to the lowest index. -1 when none.
fn zfs_wpick(bp, d, need, hard, tried) {
    var best = 0 - 1;
    var bres = 0;
    var bfree = 0;
    var msz = 1 << zfs_ms_shift;
    var nsm = 0;
    var i = 0;
    while (i < zfs_ms_count) {
        var me = zfs_msent(i);
        var ok = 1;
        if (load64(me) != 0) { nsm = nsm + 1; }
        if (load64(me) == 0 || ((load8(tried + (i >> 3)) >> (i & 7)) & 1) == 1) { ok = 0; }
        if (zfs_wt_msmax > 0 && nsm > zfs_wt_msmax) { ok = 0; }
        if (zfs_wt_msonly > 0 && i != zfs_wt_msonly - 1) { ok = 0; }
        if (ok == 1 && hard == 0) { ok = zfs_wuniq(bp, d, i); }
        if (ok == 1) {
            var res = 0;
            var fr = msz - load64(me + 24);
            if (load64(me + 40) != 0) {
                res = 1;
                fr = fr - load64(me + 32);
            }
            if (fr >= need) {
                if (best < 0 || res > bres || (res == bres && fr > bfree)) {
                    best = i;
                    bres = res;
                    bfree = fr;
                }
            }
        }
        i = i + 1;
    }
    return best;
}
# Allocate DVA d of bp: asize bytes in one metaslab, first fit, ashift-aligned (a unit is 1 << ashift), never past the
# metaslab's end; the bits are set (strict), the metaslab's count and the cursor move, an ALLOC extent is recorded,
# and words 2d, 2d + 1 of bp get the DVA (zfs_wenc.cyr zfs_dva_w0 / w1: vdev = the top-level id, gang 0).
# 0 · -1 ENOSPC (no metaslab with a space map holds the run — OpenZFS would gang, agnos never does; WPA § 4) or the
# extent list is full · -2 a metaslab failed its strict load: the pool is inconsistent (the caller fails the commit).
fn zfs_walloc_dva(bp, d, asz) {
    var n = asz >> zfs_ashift;
    var tried[256];                                    # 2048 bits: metaslabs tried for this DVA
    var hard = 0;
    while (hard < 2) {
        memset(&tried, 0, 256);
        var i = zfs_wpick(bp, d, asz, hard, &tried);
        while (i >= 0) {
            store8(&tried + (i >> 3), load8(&tried + (i >> 3)) | (1 << (i & 7)));
            var s = zfs_ms_load(i);
            if (s < 0) { return 0 - 2; }
            var u = zfs_wfit(s, i, n);
            if (u >= 0) {
                var off = (i << zfs_ms_shift) + (u << zfs_ashift);
                if (zfs_wxl_add(off, asz, 0, 0) != 0) { return 0 - 1; }
                if (zfs_bm_op(zfs_bm_a(s), u, n, 1) != 0) {
                    zfs_xl_n = zfs_xl_n - 1;
                    zfs_wnon("allocator found an allocated unit free, ms ", i);
                    return 0 - 2;
                }
                var me = zfs_msent(i);
                store64(me + 24, load64(me + 24) + asz);
                store64(zfs_msx(i), u + n);
                zfs_tx_alloc = zfs_tx_alloc + asz;
                store64(bp + d * 16, zfs_dva_w0(asz, zfs_top_id));
                store64(bp + d * 16 + 8, zfs_dva_w1(off));
                return 0;
            }
            i = zfs_wpick(bp, d, asz, hard, &tried);
        }
        hard = hard + 1;
    }
    return zfs_wnon("no space: no metaslab holds bytes ", asz);
}
# All nd DVAs of a block of psize physical bytes into words 0-5 of bp (DVAs packed from 0, the unused ones zero; the
# rest of bp untouched). asize = roundup(psize, 1 << ashift) (vdev_default_asize; the write is zero-padded to it,
# zio.c:4686-4697). user = 1: user data, refused when it would take the pool past zfs_wroom (OpenZFS's view: pool
# allocated at mount + this boot's net + every deferred free — none of which an allocation can take — below the
# slop, WPA § 6.7) — 0: the commit's own metadata, which may use the slop as OpenZFS's syncing context does
# (spa_misc.c:354-393). Any failure returns every DVA this call allocated (zfs_wxl_undo). 0 / -1 / -2 as
# zfs_walloc_dva.
# ⚠ SIDE EFFECTS: each DVA may load a metaslab (zfs_ms_load's — slots evicted, walker globals, the reader's metadata
# cache), so a caller holds no zfs_obj_blk pointer and no resident slot number across the call.
fn zfs_walloc_bp(bp, psize, nd, user) {
    if (nd < 1 || nd > 3 || psize < 512 || (psize & 511) != 0) { return zfs_wnon("bad allocation: bytes ", psize); }
    var un = 1 << zfs_ashift;
    var asz = (psize + un - 1) & (0 - un);
    if (user == 1 && zfs_w_alloc + zfs_tx_alloc + nd * asz > zfs_wroom()) { return zfs_wno("no space: the pool is at its slop"); }
    memset(bp, 0, 48);
    var keep = zfs_xl_n;
    var d = 0;
    while (d < nd) {
        var r = zfs_walloc_dva(bp, d, asz);
        if (r != 0) {
            zfs_wxl_undo(keep);
            memset(bp, 0, 48);
            return r;
        }
        d = d + 1;
    }
    return 0;
}
# Free every DVA of the BP at bp, killed in T (design § c.3, e.2 branch A; WPA § 6.7): each [offset, offset + asize)
# must lie in ONE metaslab that has a space map and be ALLOCATED; its bits are cleared in the allocated bitmap (the
# true state B10 flushes) and set in the deferred one (B11: until txg T + 2 is durable — zfs_wdef_rel — OpenZFS's own
# TXG_DEFER_SIZE; never reused this boot before B11),
# the metaslab's deferred count grows by the units NEWLY deferred (on a pool OpenZFS last ran at its slop some may be
# deferred already — zfs_wxl_undo), and a FREE extent is recorded for log T. Not for: a hole or an embedded BP
# (nothing allocated — the caller's kill skips them); a gang DVA, a DEDUP BP (BP_GET_DEDUP, blk_prop bit 62: the DDT
# and other BPs still reference its DVAs) or one with the crypt bit (61: an encrypted L0's third DVA is its salt and
# IV, not a DVA; the gate refuses encrypted datasets, so this is the backstop) — OpenZFS's own
# zio_free sends gang, dedup and BRT BPs to spa_free_bplist instead (zio.c:1445-1453), agnos to free_bpobj (design
# § e.2); a BP born in T or later (allocate-and-free inside one txg is never logged, metaslab.c:5739-5785; agnos never
# does it). ⛔ A block CLONE (BRT) is indistinguishable here: it is the caller's job — B4's kill must route EVERY kill
# to free_bpobj while block_cloning is active (design § e.2), or this frees space other BPs still reference.
# ⚠ SIDE EFFECTS: each DVA loads its metaslab (zfs_ms_load's — see there).
# 0 · -1 refused, nothing changed · -2 a range is not allocated or a metaslab failed its load: the pool is
# inconsistent. Every DVA is checked before any is freed.
fn zfs_wfree_bp(bp) {
    var pr = load64(bp + 48);
    if (((pr >> 39) & 1) == 1 || (load64(bp) == 0 && load64(bp + 8) == 0)) { return zfs_wno("free of a hole or embedded block"); }
    if (((pr >> 62) & 1) == 1) { return zfs_wno("free of a dedup block"); }
    if (((pr >> 61) & 1) == 1) { return zfs_wno("free of an encrypted block"); }
    var pb = load64(bp + 72);
    if (pb == 0) { pb = load64(bp + 80); }
    if (zfs_wugt(zfs_txg + 1, pb) == 0) { return zfs_wnon("free of a block born in the open txg: birth ", pb); }
    var nd = 0;
    var k = 0;
    while (k < 3) {
        if (load64(bp + k * 16) != 0 || load64(bp + k * 16 + 8) != 0) { nd = nd + 1; }
        k = k + 1;
    }
    if (zfs_xl_n + nd > ZWK_MAXXL) { return zfs_wnon("txg extent list full: extents ", zfs_xl_n); }
    var pass = 0;
    while (pass < 2) {
        var d = 0;
        while (d < 3) {
            var w0 = load64(bp + d * 16);
            var w1 = load64(bp + d * 16 + 8);
            if (w0 != 0 || w1 != 0) {
                var asz = (w0 & 0xFFFFFF) << 9;
                var off = (w1 & ZWK_OFF63) << 9;
                var i = off >> zfs_ms_shift;
                if (pass == 0) {
                    if ((w1 >> 63) != 0) { return zfs_wno("free of a gang DVA"); }
                    if ((w0 >> 32) != zfs_top_id || asz == 0 || ((off | asz) & ((1 << zfs_ashift) - 1)) != 0) { return zfs_wno("free of a malformed DVA"); }
                    if (i >= zfs_ms_count || off + asz > (i + 1) << zfs_ms_shift) { return zfs_wno("free of a DVA outside one metaslab"); }
                    if (load64(zfs_msent(i)) == 0) {
                        zfs_wnon("free in a metaslab without a space map: ms ", i);
                        return 0 - 2;
                    }
                } else {
                    var s = zfs_ms_load(i);
                    if (s < 0) { return 0 - 2; }
                    var abm = zfs_bm_a(s);
                    var dbm = abm + zfs_bm_bytes;
                    var b = (off - (i << zfs_ms_shift)) >> zfs_ashift;
                    var n = asz >> zfs_ashift;
                    var pre = zfs_bm_cnt(dbm, b, n);
                    if (zfs_wxl_add(off, asz, 1, pre) != 0) { return 0 - 1; }
                    if (zfs_bm_op(abm, b, n, 0) != 0) {
                        zfs_xl_n = zfs_xl_n - 1;
                        zfs_wnon("free of unallocated space, ms ", i);
                        return 0 - 2;
                    }
                    zfs_bm_op(dbm, b, n, 2);
                    var me = zfs_msent(i);
                    store64(me + 24, load64(me + 24) - asz);
                    store64(me + 32, load64(me + 32) + ((n - pre) << zfs_ashift));
                    zfs_tx_free = zfs_tx_free + asz;
                }
            }
            d = d + 1;
        }
        pass = pass + 1;
    }
    return 0;
}

# --- B3a: the BP builder (design § d.1.1, D4 / D5 / D6; WPA § 4) ---------------------------------------------------
# ⭐ The block pointer of a finalised block of T: its lsize bytes at src (the slot's tail up to the allocation unit
# must be zero — every dirty slot's is), the policy word pol (type | level << 8 | checksum << 16 | copies << 24 |
# ZWP_*), its fill (zfs_wenc.cyr zfs_fill_dnodes / zfs_ind_ready, 1 for data), and old — the BP it replaces (0 = none)
# — into out (128 B). Step for step what zio_write_compress + zio_dva_allocate + zio_checksum_generate do (zio.c):
#   1. ZWP_ZLE (metadata, D4): zfs_wcomp — all zeros -> a hole; ZLE when it beats the 12.5 % floor after rounding to
#      the allocation unit; else OFF. Without ZWP_ZLE but with ZWP_HOLE, an all-zero block is still a hole: data on a
#      dataset whose compression is not off (OpenZFS compresses it and finds zeros, zio.c:1977-1978 — agnos writes the
#      nonzero ones OFF, D4) and metadata a caller writes OFF (WPA § 4 ⚠: OpenZFS never writes a zero indirect).
#      Neither flag: the block goes out as it is — a MOS chain block, whose psize must be known first (design § d.2.4).
#   2. A hole: birth T when the replaced BP had a logical birth and hole_birth is active, else all zero
#      (zio.c:2097-2104; zfs_bp_mkhole). Nothing is allocated or written.
#   3. The checksum (7 fletcher4, 8 sha256, 11 sha512 — D5; nothing else is written) over the psize physical bytes;
#      nd DVAs (D6: the caller passes data copies, metadata copies + 1, MOS 3); prop and the rest (zfs_bp_fin):
#      logical birth T, physical 0, byteorder little-endian, dedup / crypt / embedded / gang 0 — never anything that
#      would activate a feature (WPA § 4 MUST NOT).
# Returns 1 a block to write — zfs_bpb_va = its physical bytes (src, or ZWA_CMP for ZLE: write it before the next
# zfs_bp_build), psize = BP_GET_PSIZE(out), padded with zeros to the DVA's asize · 0 a hole (nothing to write) · -1 / -2
# as zfs_walloc_bp, or -1 for a policy the writer does not emit (named).
# ⚠ SIDE EFFECTS (zfs_walloc_bp's): metaslab loads — evicted slots, the zfs_ws_* walker globals, and reader
# metadata-cache blocks — so the commit loop keeps no zfs_obj_blk pointer across a call; its dirty slots and the
# zfs_wdn slots are untouched (the loader has its own, zfs_wldn).
fn zfs_bp_build(src, lsize, pol, fill, old, out) {
    var ty = pol & 0xFF;
    var lv = (pol >> 8) & 0x1F;
    var ck = (pol >> 16) & 0xFF;
    var nd = (pol >> 24) & 0xF;
    if (ck != 7 && ck != 8 && ck != 11) { return zfs_wnon("checksum not written by agnos: ", ck); }
    if (lsize < 512 || lsize > ZK_DATAMAX || (lsize & 511) != 0) { return zfs_wnon("block size not written by agnos: ", lsize); }
    var t = zfs_txg + 1;
    var phys = src;
    var psize = lsize;
    var comp = 2;
    var hole = 0;
    if ((pol & ZWP_ZLE) != 0) {
        if (lsize > ZK_METAMAX) { return zfs_wnon("metadata block over 128 KiB: ", lsize); }
        var p = zfs_wcomp(src, lsize, zfs_wmem + ZWA_CMP, 1 << zfs_ashift);
        if (p == 0) { hole = 1; }
        elif (p < lsize) {
            phys = zfs_wmem + ZWA_CMP;
            psize = p;
            comp = ZE_ZLE;
        }
    } elif ((pol & ZWP_HOLE) != 0) {
        if (zfs_wzero(src, lsize) == 1) { hole = 1; }
    }
    if (hole == 1) {
        var hb = 0;
        if (old != 0 && load64(old + 80) != 0 && (zfs_w_feat & 8) != 0) { hb = t; }
        if (zfs_bp_mkhole(out, lsize, ty, lv, hb) != 0) { return zfs_wnon("hole not encodable: type ", ty); }
        zfs_bpb_va = 0;
        return 0;
    }
    var prop = zfs_bp_prop(lsize, psize, comp, ck, ty, lv);
    if (prop == (0 - 1)) { return zfs_wnon("block pointer not encodable: type ", ty); }
    var ckw[32];
    if (zfs_cksum_words(ck, phys, psize, &ckw) != 0) { return zfs_wnon("checksum failed: algorithm ", ck); }
    var r = zfs_walloc_bp(out, psize, nd, (pol >> 30) & 1);
    if (r != 0) { return r; }
    zfs_bp_fin(out, prop, t, fill, &ckw);
    zfs_bpb_va = phys;
    return 1;
}

# --- B3b: the commit of txg T (design § d) — this bite: the NULL txg, every piece of MOS bookkeeping a txg carries ---
# T = zfs_txg + 1 is PLANNED in the writer area, written to space uberblock T - 1 calls free, flushed, and made live by
# ONE uberblock (zfs_commit_ubw). What every txg changes in the MOS (design § c.4, § e.1; spa_sync / metaslab_sync /
# dsl_pool_sync in OpenZFS 2.4.2):
#   · log space map T — a NEW MOS object (the first free slot; space_map_alloc's dnode) whose two-word entries record
#     every ALLOC and FREE of T, those of its own block and of every rewritten MOS block included (metaslab_sync)
#   · features_for_write com.delphix:spacemap_histogram + 1 (space_map_alloc's spa_feature_incr), in place
#   · the log ZAP: "%llx"(T) -> that object (spa_generate_syncing_log_sm, zap_add_int_key; a microzap that grows by
#     512 B when full, zap_micro.c:675-690)
#   · U[i] = T for every metaslab with an entry in log T whose U is 0 (metaslab_unflushed_add, metaslab.c:4025-4041)
#   · the MOS's space — Σ dsize / psize of the MOS blocks born minus killed — into $MOS's dsl_dir and every dir above it
#     (dsl_pool_sync -> dsl_dir_diduse_space, dsl_pool.c:806-815, dsl_dir.c:1538-1653); each object's dn_used
#   · every changed MOS block copied on write, bottom-up to a new MOS objset_phys and rootbp (3 copies, fletcher4); the
#     blocks they replace FREED (in log T; deferred — released TXG_DEFER_SIZE = 2 txgs later, zfs_wdef_rel, k.125)
# ⭐ CONVERGENCE (design § d.2.4, "chain planning"; OpenZFS iterates sync passes, spa_sync_iterate_to_convergence):
# the plan runs in ONE pass. Every block whose CONTENT depends on the txg's allocations — the CHAIN: log T's block, the
# dnode blocks holding log T's dnode or a dsl_dir that carries the MOS's space, the meta-dnode's indirects, the
# objset_phys — has its psize and allocation fixed BEFORE its content:
#   (1) every non-chain block is finalised (ZLE, zfs_bp_build), allocated and written, its predecessor freed;
#   (2) every chain block is allocated (DVAs only), its predecessor freed;
#   (3) now every ALLOC and FREE of T is known: log T is encoded, the dirs' space written, every dn_used final;
#   (4) the chain is filled bottom-up — fills, checksums — and written.
# ⭐ B4 (design § k.25, decided 2026-10-10): a chain INDIRECT is no longer written OFF — it is ZLE into a RESERVED psize:
# step (2) reserves its current ZLE size plus a margin for what (3)-(4) still change (the checksum and fill of each
# chain child; zfs_wc_rsv), step (4) compresses the final content into it, zero-padded; when the output does not fit,
# steps (2)-(4) are RE-PLANNED — their extents undone (zfs_wxl_undo to the mark), the chain blocks restored from the
# snapshot taken before (2) (ZWA_CSN), the reservation raised — at most ZWK_RPLMAX times, the last attempt OFF. So a
# txg needs a few KiB for the MOS's L1 (128 KiB x 3 contiguous before), OpenZFS's convergence in miniature. The other
# chain blocks (log T, the dnode blocks, the objset_phys) stay OFF.
# ⭐ U[] (design § k.24, decided 2026-10-10): U = T is preset at the FIRST commit after the mount for EVERY metaslab
# with a space map and U 0 — legal: a U naming a log the metaslab has no entry in is what metaslab_unflushed_bump writes
# for clean metaslabs — because a round can no longer be replayed once the dataset phase has finalised its blocks.
# OpenZFS gives a metaslab its U at its first log entry (metaslab_unflushed_add, metaslab.c:4025-4041) and its export
# flushes only the metaslabs that have one (spa_metaslabs_by_flushed: spa_log_spacemap.c:771, :1319-1324), so one whose
# space map predates log_spacemap and that nothing touched since keeps U 0 through any number of exports (design
# § c.3): every UPGRADED pool takes the preset once per mount. A metaslab with U 0 that still gets an entry (which needs
# a metaslab without a space map: never allocated from, a free there refused) FAILS the commit by name.
var zfs_w_ffw = 0;           # MOS objects every commit changes (zfs_wgate_objs): features_for_write · the log ZAP ·
var zfs_w_lzo = 0;           #   the $MOS dsl_dir · the root dsl_dir
var zfs_w_mdd = 0;
var zfs_w_rdd = 0;
var zfs_w_fbo = 0;           # B7: the pool's free_bpobj (MOS directory "free_bpobj"; 0: none) · the $FREE dsl_dir (design
var zfs_w_fdd = 0;           #   § e.2: a gang / dedup / clone kill is appended there and charged to $FREE) · (B9) the pool's
var zfs_w_ebo = 0;           #   empty_bpobj (MOS directory "empty_bpobj"; 0: none)
var zfs_wc_du = 0;           # the open txg's MOS space: dsize born - killed (dsl_pool_mos_diduse_space's used) ·
var zfs_wc_dc = 0;           #   psize born - killed (its compressed = its uncompressed: the MOS is all metadata)
var zfs_wc_lo = 0;           # log T's object
var zfs_wc_rnd = 0;          # the rounds the last commit planned (1 since B4's preset; kept for the op list's line)
var zfs_wc_rbp[16];          # the MOS rootbp: T - 1's while the plan runs, T's once the chain is filled
var zfs_wc_pre[32];          # U preset, ZWK_MAXMS bits: metaslab i gets U = T in this txg
var zfs_wc_first = 0;        # 1 until the first commit after the mount succeeds (k.24's preset)
var zfs_wc_rpl = 0;          # chain re-plans in the open txg (k.25) · reservations raised (ZWA_RSV) · 1 = the chain
var zfs_wc_nrsv = 0;         #   snapshot was taken (reservations in use) · the op list's knob: reserve 512 B on the
var zfs_wc_snap = 0;         #   first attempt, so the re-plan runs on disk (ZFS_WRITE_OPS only)
var zfs_wc_tight = 0;
var zfs_wc_srbp[16];         # the snapshot's rootbp and MOS space
var zfs_wc_sdu = 0;
var zfs_wc_sdc = 0;
var zfs_wh_set[32];          # B7 (k.68): the txg's histogram set, ZWK_MAXMS bits — the metaslabs whose stored space map
#   histogram T lowers (zfs_wh_plan, zfs_wh_check: each one's space map dnode in the chain) · the members whose space
var zfs_wh_pend[32];         #   map dnode is not in the chain yet (zfs_wh_grow puts it there)
var zfs_wh_n = 0;            # the space map histograms the open txg lowered (the op list's plan line: hist=)
var zfs_wh_ndem = 0;         # since the mount: step-(1) dnode blocks demoted into the chain · chain re-plans that grew the
var zfs_wh_nrp = 0;          #   set (zfs_wc_chrun) — the op list prints them
var zfs_wh_force = 0;        # the op list's knob (ZFS_WRITE_OPS only — zfs_wc_tight's pattern): bit 0 every metaslab with a
#   histogram that T allocated in joins the set at plan time, bit 1 after the chain — the demotion and the re-plan run
#   ON DISK whatever the weights say (a member whose stored weight still holds keeps its histogram); 0 in production
var zfs_wc_ne = 0;           # log T's extent bound as zfs_wc_plan set it (zfs_wh_plan grows it)
var zfs_wt_msonly = 0;       # (B11) the op list's knob (ZFS_WRITE_OPS only; 0 in production): > 0 = agnos allocates ONLY in
#   metaslab zfs_wt_msonly - 1 (zfs_wpick) — the release op and the cut list put a block onto a freed DVA through it
var zfs_wt_msmax = 0;        # (B9, fixture RECIPE 7) the op list's knob (ZFS_WRITE_OPS only): agnos allocates in, and counts
#   room in (zfs_wpick, zfs_wphys), only the first N metaslabs with a space map — wr's B5 / B7 gates are tuned to the
#   room of 5, which a build's luck no longer decides (its recipe spreads to all of them, k.69); 0 in production
var zfs_wt_dlfat = 0;        # (B9 review) the op list's knobs (ZFS_WRITE_OPS only; 0 in production), so the admission's
var zfs_wt_dlmax = 0;        #   deadlist refusals and a multi-txg truncation through a deadlist run ON DISK on a small
var zfs_wt_ftight = 0;       #   fixture: 1 = every deadlist ZAP reads as FAT to zfs_wdl_fatok (k.100) · > 0 = the deadlist
#   table holds that many entries instead of ZWK_MAXDLE (zfs_wdl_put; k.99) · > 0 = a truncation txg holds that many
#   kill-list entries (zfs_wf_kill)

# A MOS microzap the commit edits in place (features_for_write, the log ZAP): ONE block of type ZBT_MICRO, no
# normalisation (a normalised ZAP hashes the normalised name). 0 / -1 named.
fn zfs_wgate_mz(obj, what) {
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, obj, dn) != 0) { return zfs_wnos("unreadable: ", what, strlen(what)); }
    var b = zfs_obj_blk(dn, 0, 1);
    if (b == 0) { return zfs_wnos("unreadable: ", what, strlen(what)); }
    if (load64(b) != ((1 << 63) | 3) || load64(dn + 16) != 0 || load8(dn + 2) != 1) { return zfs_wnos("not a microzap: ", what, strlen(what)); }
    if (load64(b + 16) != 0) { return zfs_wnos("normalized ZAP: ", what, strlen(what)); }
    return 0;
}
# (B8) A MOS ZAP the commit ADDS to (the log space map ZAP): a microzap, or a fat ZAP the writer's code takes (no
# zap_flags), neither normalised. 0 / -1 named. Writer slot 1.
fn zfs_wgate_zap(obj, what) {
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, obj, dn) != 0) { return zfs_wnos("unreadable: ", what, strlen(what)); }
    var b = zfs_obj_blk(dn, 0, 1);
    if (b == 0) { return zfs_wnos("unreadable: ", what, strlen(what)); }
    if (load64(b) == ((1 << 63) | 3)) {
        if (load64(dn + 16) != 0 || load8(dn + 2) != 1) { return zfs_wnos("not a microzap: ", what, strlen(what)); }
        if (load64(b + 16) != 0) { return zfs_wnos("normalized ZAP: ", what, strlen(what)); }
        return 0;
    }
    if (load64(b) != ((1 << 63) | 1) || load64(b + 8) != ZZ_MAGIC) { return zfs_wnos("not a ZAP: ", what, strlen(what)); }
    if (load64(b + 96) != 0) { return zfs_wnos("fat ZAP with zap_flags: ", what, strlen(what)); }
    if (load64(b + 88) != 0) { return zfs_wnos("normalized ZAP: ", what, strlen(what)); }
    # (B8 review) a doubling in a MOS ZAP is not built (zfs_zf_gok): one whose table is already its own block — or
    # mid-grow — is refused here, not by a commit that would need it
    if (load64(b + 24) != 0 || load64(b + 40) != 0) { return zfs_wnos("fat ZAP with an external pointer table (a MOS doubling is not built): ", what, strlen(what)); }
    return 0;
}
# The write gate's last part (design § c.4, § e.1): the MOS objects every commit changes, each in the shape the commit
# writes — features_for_write (a microzap holding spacemap_histogram), the log ZAP (a microzap), the unflushed-txg
# array U[], and every dsl_dir from $MOS up (a dsl_dir_phys_t bonus, a parent chain that ends). 0 / -1 named.
fn zfs_wgate_objs() {
    var od = zfs_wdn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, 1, od) != 0) { return zfs_wno("MOS directory unreadable"); }
    var r = zfs_wzu64(od, "features_for_write", &zfs_w_ffw);
    if (r == 0) { return zfs_wno("no features_for_write"); }
    if (r < 0) { return r; }
    r = zfs_wzu64(od, "com.delphix:log_spacemap_zap", &zfs_w_lzo);
    if (r == 0) { return zfs_wno("log_spacemap active without its ZAP"); }
    if (r < 0) { return r; }
    if (zfs_wgate_mz(zfs_w_ffw, "features_for_write") != 0) { return 0 - 1; }
    var fd = zfs_wdn(1);
    var b = zfs_obj_blk(fd, 0, 1);
    if (b == 0 || zfs_mz_find(b, load16(fd + 8) << 9, "com.delphix:spacemap_histogram", 30) == 0) { return zfs_wno("features_for_write has no spacemap_histogram"); }
    if (zfs_wgate_zap(zfs_w_lzo, "the log space map ZAP") != 0) { return 0 - 1; }
    if (zfs_unfl_obj == 0) { return zfs_wno("no unflushed-txg array"); }
    zfs_w_rdd = zfs_wrootdir();
    var dn = zfs_wdn(1);
    if (zfs_w_rdd == 0 || zfs_dnode(zfs_mem + ZR_MOS, zfs_w_rdd, dn) != 0) { return zfs_wno("no root dsl_dir"); }
    var cz = load64(zfs_bonus(dn) + 32);
    if (cz == 0 || zfs_dnode(zfs_mem + ZR_MOS, cz, dn) != 0) { return zfs_wno("root dsl_dir children unreadable"); }
    r = zfs_wzu64(dn, "$MOS", &zfs_w_mdd);
    if (r == 0) { return zfs_wno("no $MOS dsl_dir"); }
    if (r < 0) { return r; }
    # B7 (design § e.2): $FREE and the pool's free_bpobj (a BPOBJ, bonus BPOBJ_HDR of >= 16 bytes — dsl_pool_create's,
    # bpobj_alloc) — what a kill of a gang, dedup or possibly-cloned block is appended to and charged to, exactly as
    # dsl_dataset_block_kill does; OpenZFS's async destroy frees it at its next writable import. Absent (both exist on
    # every pool since SPA_VERSION_DEADLISTS): such a kill is refused by name (zfs_wd_okbp)
    zfs_w_fdd = 0;
    zfs_w_fbo = 0;
    r = zfs_wzu64(dn, "$FREE", &zfs_w_fdd);
    if (r < 0) { return r; }
    r = zfs_wzu64(od, "free_bpobj", &zfs_w_fbo);
    if (r < 0) { return r; }
    if (r == 1) {
        var bo = zfs_wdn(1);
        if (zfs_dnode(zfs_mem + ZR_MOS, zfs_w_fbo, bo) != 0 || load8(bo) != 5 || load8(bo + 4) != 6 || load16(bo + 10) < 16 || load16(bo + 8) < 1) { return zfs_wno("free_bpobj unreadable"); }
    }
    var d = zfs_w_mdd;
    var k = 0;
    while (d != 0) {
        if (k >= ZWK_DSLMAX || zfs_dnode(zfs_mem + ZR_MOS, d, dn) != 0 || load8(dn + 4) != 12 || load16(dn + 10) < 256) { return zfs_wnon("dsl_dir unreadable: object ", d); }
        d = load64(zfs_bonus(dn) + 16);
        k = k + 1;
    }
    # B9 (design § e.2, WPA § 7.4): the pool's empty_bpobj — the MOS directory's "empty_bpobj", bpobj_alloc_empty's
    # shared bpobj that holds nothing, present while the feature is active (bpobj.c:38-76) — and its refcount's entry in
    # features_for_write, which each deadlist entry materialised away from it decrements in place (bpobj_decr_empty).
    # Absent: every deadlist entry is a bpobj of its own
    zfs_w_ebo = 0;
    r = zfs_wzu64(od, "empty_bpobj", &zfs_w_ebo);
    if (r < 0) { return r; }
    if (r == 1) {
        if (zfs_w_ebr <= 0 || zfs_dnode(zfs_mem + ZR_MOS, zfs_w_ebo, dn) != 0 || load8(dn) != 5 || load8(dn + 4) != 6 || load64(zfs_bonus(dn)) != 0) { return zfs_wno("empty_bpobj unreadable"); }
        if (zfs_dnode(zfs_mem + ZR_MOS, zfs_w_ffw, dn) != 0) { return zfs_wno("features_for_write unreadable"); }
        b = zfs_obj_blk(dn, 0, 1);
        if (b == 0 || zfs_mz_find(b, load16(dn + 8) << 9, "com.delphix:empty_bpobj", 23) == 0) { return zfs_wno("features_for_write has no empty_bpobj"); }
    }
    return 0;
}

# --- dirty-first access (the MOS's, and from B4 any dataset's) ---------------------------------------------------
# The MOS objset_phys's dirty entry (a CHAIN block), read on first use through the reader (zfs_bp_read: checksum,
# decompression) from zfs_wc_rbp — T - 1's rootbp while the plan runs. -1 named.
fn zfs_wmos_os() {
    var e = zfs_dirty_find(0, ZWO_OSB, 0, 0);
    if (e >= 0) { return e; }
    var ls = zfs_bp_lsize(&zfs_wc_rbp);
    if (ls < 1024 || ls > 4096) { return zfs_wnon("MOS objset_phys of bytes ", ls); }
    e = zfs_dirty_add(0, ZWO_OSB, 0, 0, ls, ZWD_CHAIN | (11 << 8), 0);
    if (e < 0) { return e; }
    if (zfs_bp_read(&zfs_wc_rbp, zfs_dirty_buf(e), ls) != 0 || load64(zfs_dirty_buf(e) + 704) != 1) { return zfs_wno("MOS unreadable"); }
    return e;
}
# Block (lv, bid) of object obj of objset os, whose dnode is at dn — in a DIRTY slot, or the dirty objset_phys's
# meta-dnode: its dirty entry, dirtied on first use together with every indirect above it, each a private copy of
# the block its parent's dirty copy names, read through the reader (checksum, decompression; a hole reads as zeros — a
# new block). The entry carries the dnode's type (an indirect's BP carries it too). ⭐ B4, a DATASET's block (os != 0):
# the BP it replaces must be one the commit can kill (zfs_wd_okbp — an encrypted block is REFUSED here, before anything
# is written, not at the commit; (B7) a gang, dedup or possibly-cloned one is killable, the commit DEFERS it to
# free_bpobj — zfs_wd_defer / zfs_wfb_add; (B9) a snapshot-owned one goes to the deadlist, its append counted here —
# zfs_wdl_q); a level-0 block of a DATA type goes to the data arena
# (ZWD_DATA), read whole through zfs_bp_read (<= 1 MiB). -1 named.
fn zfs_wblk(dn, os, obj, lv, bid) {
    var e = zfs_dirty_find(os, obj, lv, bid);
    if (e >= 0) { return e; }
    var nl = load8(dn + 2);
    var ibs = load8(dn + 1);
    var epbs = ibs - 7;
    if (nl < 1 || nl > 9 || lv < 0 || lv >= nl || epbs < 2 || epbs > 10 || bid < 0) { return zfs_wnon("bad block address: object ", obj); }
    var bp = 0;
    if (lv == nl - 1) {
        if (bid >= load8(dn + 3)) { return zfs_wnon("block beyond the dnode: object ", obj); }
        bp = dn + 64 + bid * 128;
    } else {
        var pe = zfs_wblk(dn, os, obj, lv + 1, bid >> epbs);
        if (pe < 0) { return pe; }
        bp = zfs_dirty_buf(pe) + (bid & ((1 << epbs) - 1)) * 128;
    }
    var ls = load16(dn + 8) << 9;
    if (lv > 0) { ls = 1 << ibs; }
    if (zfs_bp_hole(bp) == 0 && zfs_bp_lsize(bp) != ls) { return zfs_wnon("block size differs from its dnode: object ", obj); }
    var ty = load8(dn);
    if (os != 0) {
        var dse = zfs_wds_find(os);
        if (dse == 0) { return zfs_wnon("dataset not opened for write: ", os); }
        if (zfs_wd_okbp(dse, bp) != 0) { return 0 - 1; }
        # (B7 review, k.70) a predecessor the commit will DEFER is counted: its free_bpobj append is metadata the
        # commit dirties. The last admission reserved it (zfs_wfb_meta's ZWF_FBM margin); only the FIRST of a txg on a
        # pool where nothing defers otherwise came unreserved — refused by name when the arena could not hold it then
        # (never a commit that runs out)
        # (B9) a predecessor a snapshot owns is counted for its deadlist entry's appends the same way (zfs_wdl_q). (B9
        # review, k.100) A write or a truncation predicted it before dirtying the block (zfs_wdl_path) and ends its txg
        # there instead; every other op starts an EMPTY txg (policy A), so a refusal here is the op's own size — never
        # "commit first". zfs_wdl_full tells that refusal from any other (zfs_wf_write1)
        if (zfs_wc_in == 0 && zfs_bp_hole(bp) == 0) {
            if (zfs_wugt(zfs_bp_birth(bp), load64(dse + 56)) == 0) {
                var qr = zfs_wdl_q(dse, bp, 1);
                if (qr < 0) { return 0 - 1; }
                if (qr == 1) {
                    zfs_wdl_full = 1;
                    return zfs_wno("the op does not fit a txg: a snapshot-owned block's deadlist blocks");
                }
            } elif (((load64(bp + 48) >> 39) & 1) == 0 && zfs_wd_defer(bp) == 1) {
                if (zfs_wfb_q == 0 && (zfs_w_feat & 144) == 0 && zfs_dx_meta + zfs_wfb_meta(1) + zfs_wdl_meta() > zfs_wf_alim()) { return zfs_wno("txg full: a deferred kill's free_bpobj blocks (commit first)"); }
                zfs_wfb_q = zfs_wfb_q + 1;
            }
        }
        if (lv == 0 && zfs_ot_meta(ty) == 0) {
            if (ls > ZK_DATAMAX) { return zfs_wnon("data block over 1 MiB: object ", obj); }
            var nr = zfs_wblk_nr;
            zfs_wblk_nr = 0;
            e = zfs_dirty_add(os, obj, 0, bid, ls, ZWD_DATA | (ty << 8), 0);
            if (e < 0) { return e; }
            # B5: a block the write covers whole is not read (zeros, then the caller's bytes); a hole reads as zeros;
            # a PARTIAL overwrite reads it through the reader's decompressors — none for zstd, and no checksum agnos
            # can verify for skein / edonr / blake3 (design § a.3: -1 named)
            if (nr == 1 || zfs_bp_hole(bp) == 1) { return e; }
            var pr = load64(bp + 48);
            if (((pr >> 32) & 0x7F) == 16) { return zfs_wnon("partial overwrite of a zstd block (no decompressor): object ", obj); }
            var ck = (pr >> 40) & 0xFF;
            if (((pr >> 39) & 1) == 0 && ck >= 12 && ck <= 14) { return zfs_wnon("partial overwrite of a block agnos cannot verify (checksum ", ck); }
            if (zfs_bp_read(bp, zfs_dirty_buf(e), ls) != 0) { return zfs_wnon("block unreadable: object ", obj); }
            return e;
        }
    }
    var src = zfs_mc_get(bp);
    if (src == 0) { return zfs_wnon("block unreadable: object ", obj); }
    e = zfs_dirty_add(os, obj, lv, bid, ls, ty << 8, src);
    # B5: a re-materialised hole indirect WITH birth B gives its children holes of birth B — LSIZE the data block size
    # under an L1, else the parent's; the parent's TYPE; level - 1 (dbuf_read_hole -> dbuf_handle_indirect_hole,
    # dbuf.c:1449-1465, 1490-1499) — so a region freed in B keeps saying so (zfs send -i, WPA § 4)
    if (e >= 0 && lv > 0 && zfs_bp_hole(bp) == 1 && load64(bp + 80) != 0) {
        var cl = ls;
        if (lv == 1) { cl = load16(dn + 8) << 9; }
        var hb = zfs_dirty_buf(e);
        var i = 0;
        while (i < ls) {
            if (zfs_bp_mkhole(hb + i, cl, (load64(bp + 48) >> 48) & 0xFF, lv - 1, load64(bp + 80)) != 0) { return zfs_wnon("hole not encodable: object ", obj); }
            i = i + 128;
        }
    }
    return e;
}
# The objset_phys of objset os (0 = the MOS) in its dirty entry. A dataset's is read from ds_bp in its COMMITTED
# dsl_dataset_phys (the reader's MOS, ZR_MOS: nothing the plan does moves it before uberblock T) through zfs_bp_read,
# after zfs_wd_okbp judged that BP; the dataset must be open for write (zfs_wds_open). -1 named.
fn zfs_wos_os(os) {
    if (os == 0) { return zfs_wmos_os(); }
    var e = zfs_dirty_find(os, ZWO_OSB, 0, 0);
    if (e >= 0) { return e; }
    var dse = zfs_wds_find(os);
    if (dse == 0) { return zfs_wnon("dataset not opened for write: ", os); }
    var dn = zfs_wdn(1);
    if (zfs_dnode(zfs_mem + ZR_MOS, os, dn) != 0) { return zfs_wnon("dataset unreadable: ", os); }
    var bp[128];
    memcpy(&bp, zfs_bonus(dn) + 128, 128);
    if (zfs_wd_okbp(dse, &bp) != 0) { return 0 - 1; }
    # (B9) the objset_phys the commit replaces, a snapshot's: its deadlist append counted (zfs_wdl_q)
    if (zfs_wc_in == 0 && zfs_bp_hole(&bp) == 0 && zfs_wugt(zfs_bp_birth(&bp), load64(dse + 56)) == 0 && zfs_wdl_q(dse, &bp, 0) != 0) { return 0 - 1; }
    var ls = zfs_bp_lsize(&bp);
    if (zfs_bp_hole(&bp) == 1 || ls < 1024 || ls > 4096) { return zfs_wnon("objset_phys of bytes ", ls); }
    e = zfs_dirty_add(os, ZWO_OSB, 0, 0, ls, 11 << 8, 0);
    if (e < 0) { return e; }
    if (zfs_bp_read(&bp, zfs_dirty_buf(e), ls) != 0 || load64(zfs_dirty_buf(e) + 704) != 2) { return zfs_wnon("objset unreadable: dataset ", os); }
    return e;
}
# The dnode of object obj (>= 1) of objset os inside its DIRTY dnode block — dirtied on first use, with the meta-dnode's
# indirects and the objset_phys above it. The address stays valid until the dirty set is reset. 0 named.
fn zfs_wos_dn(os, obj) {
    var oe = zfs_wos_os(os);
    if (oe < 0) { return 0; }
    var mdn = zfs_dirty_buf(oe);
    var per = load16(mdn + 8);                   # dnodes per block: block bytes / 512 = dn_datablkszsec
    if (per < 1 || obj < 1 || obj > ZK_MASK48) {
        zfs_wnon("bad object ", obj);
        return 0;
    }
    var be = zfs_wblk(mdn, os, 0, 0, obj / per);
    if (be < 0) { return 0; }
    return zfs_dirty_buf(be) + (obj % per) * 512;
}
fn zfs_wmos_dn(obj) { return zfs_wos_dn(0, obj); }
# The dnode whose blocks object obj's are in objset os: the meta-dnode (object 0) and the user / group / project-used
# dnodes (OpenZFS's -1 / -2 / -3) in the objset_phys at 0 / 1024 / 1536 / 2048, else the object's own. 0.
fn zfs_wobj_dn(os, obj) {
    if (obj == 0 || obj > ZWO_OSB) {
        var oe = zfs_wos_os(os);
        if (oe < 0) { return 0; }
        if (obj == 0) { return zfs_dirty_buf(oe); }
        return zfs_dirty_buf(oe) + 512 + (obj - ZWO_OSB) * 512;
    }
    return zfs_wos_dn(os, obj);
}
# Where the BP naming dirty entry e lives: its parent's dirty copy (an indirect, or the dnode's dn_blkptr — the
# meta-dnode's and the special dnodes' in the objset_phys), or for the objset_phys itself zfs_wc_rbp (the MOS) / the
# ds_bp of its dataset's DIRTY dsl_dataset_phys (a dataset — the MOS block is dirtied here, in the dataset phase).
# The parent is dirty already (zfs_wblk dirtied the path). 0 named.
fn zfs_wpbp(e) {
    var d = zfs_dent(e);
    var os = load64(d);
    var obj = load64(d + 8);
    var lv = load64(d + 24);
    var bid = load64(d + 16);
    if (obj == ZWO_OSB) {
        if (os == 0) { return &zfs_wc_rbp; }
        var sd = zfs_wmos_dn(os);
        if (sd == 0) { return 0; }
        return zfs_bonus(sd) + 128;
    }
    var dn = zfs_wobj_dn(os, obj);
    if (dn == 0) { return 0; }
    var epbs = load8(dn + 1) - 7;
    if (lv == load8(dn + 2) - 1) { return dn + 64 + bid * 128; }
    var pe = zfs_dirty_find(os, obj, lv + 1, bid >> epbs);
    if (pe < 0) {
        zfs_wnon("indirect not dirty: object ", obj);
        return 0;
    }
    return zfs_dirty_buf(pe) + (bid & ((1 << epbs) - 1)) * 128;
}
# Grow dirty entry e — block 0 of a one-block object — to nls bytes, the new bytes zero (dnode_set_blksz ->
# dbuf_new_size): in place when its slot's allocation-unit tail holds them, else into a new slot at the end of the
# metadata arena. 0 / -1 named.
fn zfs_dirty_grow(e, nls) {
    var d = zfs_dent(e);
    var ols = load64(d + 32);
    var un = 1 << zfs_ashift;
    var oa = (ols + un - 1) & (0 - un);
    var na = (nls + un - 1) & (0 - un);
    if (na > oa) {
        var off = 0;
        if ((load64(d + 56) & ZWD_DATA) != 0) {
            # B5: a DATA block 0 growing to the file's new block size (zfs_wf_grow: dbuf_new_size) — its slot moves to
            # the end of the data arena, the new bytes zero
            if (nls > ZK_DATAMAX || zfs_dx_data + na > zfs_dx_lim()) { return zfs_wnon("dirty data full: bytes ", zfs_dx_data); }
            off = ZWA_OS + zfs_dx_data;
            zfs_dx_data = zfs_dx_data + na;
        } else {
            if (nls > ZK_METAMAX || zfs_dx_meta + na > ZWK_MARENA) { return zfs_wnon("dirty metadata full: bytes ", zfs_dx_meta); }
            off = ZWA_META + zfs_dx_meta;
            zfs_dx_meta = zfs_dx_meta + na;
        }
        memcpy(zfs_wmem + off, zfs_wmem + load64(d + 40), ols);
        memset(zfs_wmem + off + ols, 0, na - ols);
        store64(d + 40, off);
    } elif (nls > ols) { memset(zfs_dirty_buf(e) + ols, 0, nls - ols); }
    store64(d + 32, nls);
    return 0;
}
fn zfs_wc_chain(e) {
    if (e >= 0) { store64(zfs_dent(e) + 56, load64(zfs_dent(e) + 56) | ZWD_CHAIN); }
    return 0;
}

# --- microzaps (mzap_phys_t: a 64-byte header — block type, salt, normflags — then 64-byte mzap_ent_phys_t chunks:
# value, cd, pad, name[50]; zap_impl.h) -------------------------------------------------------------------------
# The entry named n (l bytes, 1..49) in the microzap block at b of bsz bytes: its address, or 0.
fn zfs_mz_find(b, bsz, n, l) {
    var k = 64;
    while (k < bsz) {
        if (load8(b + k + 14) != 0 && load8(b + k + 14 + l) == 0) { if (memeq(b + k + 14, n, l) == 1) { return b + k; } }
        k = k + 64;
    }
    return 0;
}
# zap_add of the name n (l bytes) -> val into the microzap whose block 0 is dirty entry e and whose dnode is at dn
# (mzap_addent, zap_micro.c): the first free chunk, the lowest cd no entry with the same 28-bit hash uses
# (mze_find_unused_cd — two entries with one (hash, cd) break OpenZFS's in-memory tree). A full block grows by 512 B
# first (zap_lockdir_impl: dmu_object_set_blocksize to db_size + SPA_MINBLOCKSIZE, the new chunks zero) up to
# 128 KiB; beyond it OpenZFS upgrades to a fat ZAP — (B8) zfs_wz_op does that BEFORE calling here, so the refusal below
# is a backstop. 0 / -1 named.
fn zfs_mz_add(dn, e, n, l, val) {
    if (l < 1 || l > 49) { return zfs_wnos("microzap name: ", n, l); }
    var b = zfs_dirty_buf(e);
    var bsz = load64(zfs_dent(e) + 32);
    if (zfs_mz_find(b, bsz, n, l) != 0) { return zfs_wnos("microzap already holds ", n, l); }
    var k = 64;
    while (k < bsz && load8(b + k + 14) != 0) { k = k + 64; }
    if (k >= bsz) {
        if (bsz + 512 > ZK_METAMAX) { return zfs_wno("microzap full (no fat-ZAP upgrade)"); }
        if (zfs_dirty_grow(e, bsz + 512) != 0) { return 0 - 1; }
        store16(dn + 8, (bsz + 512) >> 9);
        b = zfs_dirty_buf(e);
        bsz = bsz + 512;
    }
    var h = zfs_zap_hash(load64(b + 8), n, l);
    var cd = 0;
    var j = 64;
    while (j < bsz) {
        if (load8(b + j + 14) != 0 && load32(b + j + 8) == cd) {
            var jl = 0;
            while (jl < 50 && load8(b + j + 14 + jl) != 0) { jl = jl + 1; }
            if (zfs_zap_hash(load64(b + 8), b + j + 14, jl) == h) {
                cd = cd + 1;
                j = 0;
            }
        }
        j = j + 64;
    }
    store64(b + k, val);
    store32(b + k + 8, cd);
    memset(b + k + 12, 0, 52);
    memcpy(b + k + 14, n, l);
    return 0;
}
# "%llx" of v into out — lowercase, no prefix, no leading zero: the log ZAP's key (zap_add_int_key). Its length.
fn zfs_whex(v, out) {
    var n = 0;
    var x = v;
    while (n == 0 || x != 0) {
        n = n + 1;
        x = x >> 4;
    }
    var i = n;
    while (i > 0) {
        i = i - 1;
        var c = v & 15;
        if (c < 10) { store8(out + i, 48 + c); } else { store8(out + i, 87 + c); }
        v = v >> 4;
    }
    return n;
}

# --- space and accounting -------------------------------------------------------------------------------------------
# bp_get_dsize_sync on a disk/file vdev (deflate ratio 1): Σ DVA asize — 0 for a hole or an embedded BP.
fn zfs_bp_dsize(bp) {
    if (((load64(bp + 48) >> 39) & 1) == 1) { return 0; }
    var s = 0;
    var d = 0;
    while (d < 3) {
        s = s + ((load64(bp + d * 16) & 0xFFFFFF) << 9);
        d = d + 1;
    }
    return s;
}
# dnode_diduse_space (dnode.c): dn_used += delta bytes, kept in BYTES with DNODE_FLAG_USED_BYTES set — a sector count
# converted the first time (DN_USED_BYTES; pool version 5000 >= SPA_VERSION_DNODE_BYTES). dn 0: no dnode (the
# objset_phys block). 0.
fn zfs_wdn_used(dn, delta) {
    if (dn == 0) { return 0; }
    var u = load64(dn + 24);
    if ((load8(dn + 7) & 1) == 0) { u = u << 9; }
    store64(dn + 24, u + delta);
    store8(dn + 7, load8(dn + 7) | 1);
    return 0;
}
# A MOS block born in T (dsl_dataset_block_born, ds NULL — dsl_pool_mos_diduse_space): the MOS's space, and the
# dn_used of the object whose block it is (dbuf_write_ready -> dnode_diduse_space). bp is not a hole. 0.
fn zfs_wc_born(dn, bp) {
    var u = zfs_bp_dsize(bp);
    zfs_wc_du = zfs_wc_du + u;
    zfs_wc_dc = zfs_wc_dc + ((((load64(bp + 48) >> 16) & 0xFFFF) + 1) << 9);
    return zfs_wdn_used(dn, u);
}
# The MOS block bp, killed in T (dsl_dataset_block_kill, ds NULL, dsl_dataset.c:255-276): a hole kills nothing; an
# embedded block moves no space (BP_GET_PSIZE and the dsize are 0); any other is FREED (dsl_free — the MOS has no
# snapshots, no clones): zfs_wfree_bp — (B10, k.27) a GANG one with its whole tree in this txg, as OpenZFS's
# spa_free_bplist is drained in the same sync (zfs_wgang); a dedup one stays refused (the MOS has none). B7's
# free_bpobj deferral (zfs_wd_defer) is the DATASET kill's only. 0 / -1 / -2 (zfs_wfree_bp's / zfs_wgang's).
fn zfs_wc_kill(dn, bp) {
    var pr = load64(bp + 48);
    if (zfs_bp_hole(bp) == 1 || ((pr >> 39) & 1) == 1) { return 0; }
    var r = 0;
    if ((load64(bp + 8) >> 63) == 1) {
        # (B10, k.27) a GANG predecessor: freed in T, header and tree (zfs_wgang) — checked and counted first, so a
        # refusal changes nothing
        r = zfs_wgang(bp, 0, 0);
        if (r >= 0) { r = zfs_wgang(bp, 0, 1); }
        if (r >= 0) {
            r = 0;
            zfs_wl_ng = zfs_wl_ng + 1;
        }
    } else { r = zfs_wfree_bp(bp); }
    if (r != 0) { return r; }
    var u = zfs_bp_dsize(bp);
    zfs_wc_du = zfs_wc_du - u;
    zfs_wc_dc = zfs_wc_dc - ((((pr >> 16) & 0xFFFF) + 1) << 9);
    return zfs_wdn_used(dn, 0 - u);
}
# A space change into dsl_dir dd and up to the root — dsl_dir_diduse_transfer_space (dsl_dir.c:1616-1663) at every
# level: dd_used += used, compressed / uncompressed += comp / uncomp, and with DD_FLAG_USED_BREAKDOWN the breakdown slot
# OLD -= tonew - used and NEW += tonew; then the parent gets (parent_delta(dd, used before, used) — reservation-aware,
# zfs_pdelta with dd_reserved — comp, uncomp, tonew = this level's used, CHILD_RSRV -> CHILD). At dd itself OLD/NEW are
# REFRSRV -> HEAD: a dataset's born / kill pass (parent_delta(ds, dsize) — its refreservation's — comp, uncomp, the
# full dsize, REFRSRV, HEAD) (dsl_dataset.c:206-208, :318-320); the MOS passes used = tonew, i.e. dsl_dir_diduse_space
# (HEAD), dsl_pool.c:806-815. dsl_dir_phys_t: +16 parent · +40 used · +48 compressed · +56 uncompressed · +72 reserved ·
# +96 flags (bit 0 DD_FLAG_USED_BREAKDOWN) · +104 the breakdown (HEAD, SNAP, CHILD, CHILD_RSRV, REFRSRV). Each dir is in
# a dirty MOS dnode block — a CHAIN block from $MOS up (zfs_wc_plan); a dataset's dirs are edited in the dataset phase,
# before the MOS phase plans (B4). 0 / -1.
fn zfs_wdd_use(dd, used, tonew, comp, uncomp) {
    var oo = 136;                                # REFRSRV, then CHILD_RSRV above the first level
    var no = 104;                                # HEAD, then CHILD
    while (dd != 0) {
        var dn = zfs_wmos_dn(dd);
        if (dn == 0) { return 0 - 1; }
        var b = zfs_bonus(dn);
        var old = load64(b + 40);
        store64(b + 40, old + used);
        store64(b + 48, load64(b + 48) + comp);
        store64(b + 56, load64(b + 56) + uncomp);
        if ((load64(b + 96) & 1) != 0) {
            store64(b + oo, load64(b + oo) - (tonew - used));
            store64(b + no, load64(b + no) + tonew);
        }
        tonew = used;
        used = zfs_pdelta(old, used, load64(b + 72));
        oo = 128;
        no = 120;
        dd = load64(b + 16);
    }
    return 0;
}

# --- the plan -------------------------------------------------------------------------------------------------------
# The first free MOS object (design § c.4): a 512-byte slot that is all zero (dnode_sync_free zeroes a freed dnode)
# and not inside a multi-slot dnode before it, scanning the meta-dnode's L0 blocks DIRTY-FIRST (a block is not
# dirtied by the scan); with every block full, the first object of a new block past dn_maxblkid, which grows (OpenZFS
# would also scan for sparse L1 regions, dmu_object_alloc_impl — any free slot is a valid object). Object / -1.
fn zfs_wmos_free() {
    var oe = zfs_wmos_os();
    if (oe < 0) { return 0 - 1; }
    var mdn = zfs_dirty_buf(oe);
    var per = load16(mdn + 8);
    var mb = load64(mdn + 16);
    var b = 0;
    while (b <= mb) {
        var e = zfs_dirty_find(0, 0, 0, b);
        var p = 0;
        if (e >= 0) { p = zfs_dirty_buf(e); } else { p = zfs_obj_blk(mdn, b, 1); }
        if (p == 0) { return zfs_wno("MOS dnode block unreadable"); }
        var s = 0;
        while (s < per) {
            if (load8(p + s * 512) != 0) { s = s + 1 + load8(p + s * 512 + 12); }
            else {
                if ((b > 0 || s > 0) && zfs_wzero(p + s * 512, 512) == 1) { return b * per + s; }
                s = s + 1;
            }
        }
        b = b + 1;
    }
    var epbs = load8(mdn + 1) - 7;
    if (zfs_shr(mb + 1, epbs * (load8(mdn + 2) - 1)) >= load8(mdn + 3)) { return zfs_wno("MOS meta-dnode full"); }
    store64(mdn + 16, mb + 1);
    return (mb + 1) * per;
}
# --- B7 (design k.68): the space map histograms of the metaslabs a txg allocates in ---------------------------------
# OpenZFS keeps a metaslab's on-disk histogram (space_map_phys_t smp_histogram, a count of free segments per power of
# two from the space map's sm_shift) at or BELOW its real free space: it allocates only in a LOADED metaslab, rewrites
# a loaded one's histogram from its range trees at every sync, and only ADDS a free's segments to an unloaded one's
# (metaslab_sync, metaslab.c:4469-4476 — the drift is downward). metaslab_load_impl ASSERTs it (metaslab.c:2670: the
# segment weight read from the histogram — its highest nonzero bucket, then that bucket's count — never above the
# loaded one). agnos allocates from its own bitmaps and logs T only, so a txg that consumes a metaslab's largest
# segments leaves a histogram that claims space it no longer holds: a debug build's next load of that metaslab panics,
# and zdb -mmmm after an export aborts (the wr lane's C-zdbm, B7: a 20 MiB write over three metaslabs, bucket 23 left
# where 20 was real). So a txg LOWERS the stored histogram of every metaslab whose weight its allocations took below
# it — to the exact one of its free space after T — and never raises one (agnos's own frees, which a lower stored
# histogram leaves out, cost OpenZFS only an allocation preference until its first load; and the stored one also
# bounds what a READ-ONLY zdb loads: the space map alone, the logs not replayed). Only such a txg dirties a space map
# dnode: the plan decides after step (1), when every allocation but the chain's is made (zfs_wh_plan), and again after
# the chain's (zfs_wh_check) — a metaslab the chain took below its stored weight joins the set too, re-planning the
# chain when its space map dnode was not in it yet.
fn zfs_wh_bit(m, i) { return (load64(m + (i >> 6) * 8) >> (i & 63)) & 1; }
fn zfs_wh_set1(m, i) {
    var p = m + (i >> 6) * 8;
    store64(p, load64(p) | (1 << (i & 63)));
    return 0;
}
# The metaslabs the open txg ALLOCATED in so far, as bits into m (256 bytes). 0.
fn zfs_wh_hits(m) {
    memset(m, 0, 256);
    var k = 0;
    while (k < zfs_xl_n) {
        var w = load64(zfs_xl(k));
        if ((w >> 63) == 0) { zfs_wh_set1(m, (w & ZWK_OFF63) >> zfs_ms_shift); }
        k = k + 1;
    }
    return 0;
}
# One free segment of n allocation units into histogram h (32 u64): bucket highbit(n) - 1 (the units are the space
# map's sm_shift, the vdev's ashift); past bucket 31 the last bucket counts it scaled (space_map_histogram_add). 0.
fn zfs_wh_seg(h, n) {
    if (n <= 0) { return 0; }
    var x = 0;
    while ((n >> (x + 1)) != 0) { x = x + 1; }
    if (x > 31) { store64(h + 248, load64(h + 248) + (1 << (x - 31))); }
    else { store64(h + x * 8, load64(h + x * 8) + 1); }
    return 0;
}
# Is histogram a's segment weight below b's — a lower highest nonzero bucket, or the same one with a smaller count
# (metaslab_weight_from_spacemap's WEIGHT_SET_INDEX / WEIGHT_SET_COUNT order)? 1 / 0.
fn zfs_wh_lt(a, b) {
    var i = 31;
    while (i >= 0) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (x != 0 || y != 0) {
            if (x == 0) { return 1; }
            if (y == 0) { return 0; }
            if (x < y) { return 1; }
            return 0;
        }
        i = i - 1;
    }
    return 0;
}
# The exact histogram of metaslab i's free space now, into h (32 u64): its ALLOCATED bitmap (the true state, this
# boot's frees free; reloaded if it was evicted — zfs_ms_load re-applies the open txg's extents), one segment per run
# of clear bits. 0 / -1 named.
fn zfs_wh_exact(i, h) {
    var s = zfs_ms_load(i);
    if (s < 0) { return 0 - 1; }
    memset(h, 0, 256);
    var abm = zfs_bm_a(s);
    var run = 0;
    var b = 0;
    while (b < zfs_ms_bits) {
        if ((b & 63) == 0 && b + 64 <= zfs_ms_bits) {
            var wv = load64(abm + (b >> 3));
            if (wv == 0) {
                run = run + 64;
                b = b + 64;
                continue;
            }
            if (wv == (0 - 1)) {
                zfs_wh_seg(h, run);
                run = 0;
                b = b + 64;
                continue;
            }
        }
        if (((load8(abm + (b >> 3)) >> (b & 7)) & 1) == 0) { run = run + 1; }
        else {
            zfs_wh_seg(h, run);
            run = 0;
        }
        b = b + 1;
    }
    zfs_wh_seg(h, run);
    return 0;
}
# Would metaslab i's STORED histogram — its space map's, as T - 1 committed it (the reader's MOS) — claim more than
# its free space holds now: its weight above the exact one's? 1 · 2 no, it still holds · 0 no space map with a
# histogram (nothing to keep) · -1 named.
fn zfs_wh_need(i) {
    var so = load64(zfs_msent(i));
    if (so == 0) { return 0; }
    var dn = zfs_wldn(0);
    if (zfs_dnode(zfs_mem + ZR_MOS, so, dn) != 0) { return zfs_wnon("space map unreadable ms ", i); }
    if (load8(dn) != ZWK_SM || load8(dn + 4) != ZWK_SMHDR || load16(dn + 10) != ZWK_SMV1) { return 0; }
    var hs[256];
    memcpy(&hs, zfs_bonus(dn) + 64, 256);
    # (B10) dirty-first: a flush of T rewrote it (zfs_wl_flush) — T's allocations are judged against that one
    var per = load16(zfs_dirty_buf(zfs_wmos_os()) + 8);
    if (zfs_dirty_find(0, 0, 0, so / per) >= 0) {
        var dd = zfs_wmos_dn(so);
        if (dd == 0) { return 0 - 1; }
        memcpy(&hs, zfs_bonus(dd) + 64, 256);
    }
    var he[256];
    if (zfs_wh_exact(i, &he) != 0) { return 0 - 1; }
    if (zfs_wh_lt(&he, &hs) == 1) { return 1; }
    return 2;
}
# Take ALLOC extent (off, asz) back out of the open txg: the newest such entry removed from the list (the later ones
# move down), its bytes off the metaslab's and the txg's counts, its units clear again when the metaslab is resident
# (a non-resident one replays the shortened list at its next load). 0 / -1.
fn zfs_wh_unxl(off, asz) {
    var k = zfs_xl_n - 1;
    while (k >= 0) {
        var x = zfs_xl(k);
        if (load64(x) == off && zfs_xl_asz(x) == asz) {
            var j = k;
            while (j + 1 < zfs_xl_n) {
                store64(zfs_xl(j), load64(zfs_xl(j + 1)));
                store64(zfs_xl(j) + 8, load64(zfs_xl(j + 1) + 8));
                j = j + 1;
            }
            zfs_xl_n = zfs_xl_n - 1;
            var i = off >> zfs_ms_shift;
            var me = zfs_msent(i);
            store64(me + 24, load64(me + 24) - asz);
            zfs_tx_alloc = zfs_tx_alloc - asz;
            var s = load64(me + 40);
            if (s != 0) { return zfs_bm_op(zfs_bm_a(s - 1), (off - (i << zfs_ms_shift)) >> zfs_ashift, asz >> zfs_ashift, 0); }
            return 0;
        }
        k = k - 1;
    }
    return 0 - 1;
}
# Dirty MOS dnode block e, which step (1) finalised and wrote in T, made a CHAIN block again — a space map dnode in it
# needs a histogram only the chain's allocations decide: its DVAs (born in T, referenced by nothing durable) go back
# out of T (zfs_wh_unxl — never logged, as an allocate-and-free inside one txg never is, metaslab.c:5739-5785), its
# born space is returned, and its BP in the parent's dirty copy is a hole until the chain allocates it (the
# predecessor's kill in step (1) stands). 0 / -1 named.
fn zfs_wh_demote(e) {
    var pbp = zfs_wpbp(e);
    var mdn = zfs_wobj_dn(0, 0);
    if (pbp == 0 || mdn == 0) { return 0 - 1; }
    if (zfs_bp_hole(pbp) == 0 && ((load64(pbp + 48) >> 39) & 1) == 0) {
        var d = 0;
