fn zfs_wt_b11pre(pool) {
    if (memeq(pool, "agnoswr", 8) != 1) { return 0; }
    zfs_wt_c(0, "/agnoswr/utf8/emoji-\xf0\x9f\x98\x80.txt", 0, 0);
    zfs_wt_c(0, "/agnoswr/utf8/overlong-\xc0\xaf", 0, 0 - 1);
    zfs_wt_c(0, "/agnoswr/utf8/surrogate-\xed\xa0\x80", 0, 0 - 1);
    zfs_wt_c(0, "/agnoswr/utf8/past-10ffff-\xf4\x90\x80\x80", 0, 0 - 1);
    zfs_wt_c(0, "/agnoswr/utf8/lead-\xf5\x80\x80\x80", 0, 0 - 1);
    zfs_wt_c(0, "/agnoswr/utf8/truncated-\xe2\x82", 0, 0 - 1);
    return 0;
}
fn zfs_wt_b11(pool) {
    if (memeq(pool, "agnos9", 7) != 1) { return 0; }
    zfs_wt_c(1, "/agnos9/b11", 0, 0);
    zfs_wt_c(0, "/agnos9/b11/a.bin", 0, 0);
    zfs_wt_c(0, "/agnos9/b11/b.bin", 0, 0);
    zfs_wp_pol = 0;
    zfs_wt_fdw("cp", "/agnos9/b11/a.bin", 1, 0, 8, 65536, "b11/cp", 8);
    zfs_wp_pol = 1;
    zfs_wt_fdw("cp", "/agnos9/b11/b.bin", 1, 0, 8, 65536, "b11/cp", 1);
    zfs_wt_obsv("/agnos9/b11/b.bin", "/agnos9/hello.txt");
    zfs_wt_hook("/agnos9/b11/b.bin", 600000, 5000, "b11/sync", 0, "/agnos9/b11");
    zfs_wt_hook("/agnos9/b11/b.bin", 700000, 5000, "b11/age", 1, "/agnos9/dir20");
    zfs_wt_c(0, "/agnos9/b11/big.bin", 0, 0);
    zfs_wt_fdw("arena", "/agnos9/b11/big.bin", 1, 0, 72, 65536, "b11/big", 0);
    zfs_wt_rel("/agnos9/b11/a.bin", "/agnos9/hello.txt");
    zfs_wt_race("/agnos9/b11/big.bin", "/agnos9/b11/a.bin");     # (B11 review) after the release op: its frees stay out of it
    return 0;
}
# (k.64) The boot-long deferral refused NAMESPACE ops late in a long boot (`rename ... refused (no space: the pool is at its
# slop)` after main's ~600 txgs): with B11's release a rename after main's burst and truncation commits. One op.
fn zfs_wt_b11late(pool) {
    if (memeq(pool, "agnostank", 10) == 1) { zfs_wt_u(2, "/agnostank/coff/kid/f01", "/agnostank/coff/kid/f01-late", 0); }
    return 0;
}
# THE CUT LANE'S LIST (/boot/cmdline zfs_cut=...; agnos9 only): mkdir b11c, create b11c/f.bin, 4 x 64 KiB through one fd
# (blocks 0 and 1, one txg at close), block 0 rewritten (P: its DVA X freed), hello.txt written (P + 1), then — the
# allocator's cursor on X in X's metaslab only (zfs_wt_msonly) — the knob ARMED and block 1 rewritten: txg P + 2, whose
# writes the kernel stops after the knob's N. Every txg before it is a policy-B close's commit, so a close that does not
# commit leaves its writes for the cut txg (lost: the guest's T - 1 lacks them); a free released one txg early puts P + 2's
# block ON X, which T - 3 (= P - 1) still references (the guest's A4 rewind). If the knob is beyond the txg's writes it
# completes and prints its write map.
fn zfs_wt_cutlist(pool) {
    if (memeq(pool, "agnos9", 7) != 1) {
        kprintln("zfs-wtest: the cut list runs on agnos9 only", 43);
        return 0;
    }
    zfs_wt_c(1, "/agnos9/b11c", 0, 0);
    zfs_wt_c(0, "/agnos9/b11c/f.bin", 0, 0);
    zfs_wt_fdw("cut-a", "/agnos9/b11c/f.bin", 1, 0, 4, 65536, "b11c/f", 1);
    var bp[128];
    if (zfs_rw == 0 || zfs_wt_bp("/agnos9/b11c/f.bin", 0, &bp) != 0) {
        zfs_wt_fail("cut list: block 0 unreadable");
        return 0 - 1;
    }
    var x = zfs_wt_dva(&bp);
    var ms = x >> zfs_ms_shift;
    zfs_wt_fdw("cut-p", "/agnos9/b11c/f.bin", 1, 0, 1, 131072, "b11c/g", 1);
    zfs_wt_fdw("cut-p1", "/agnos9/hello.txt", 1, 0, 1, 10, "b11c/h", 1);
    zfs_wt_msonly = ms + 1;
    store64(zfs_msx(ms), (x - (ms << zfs_ms_shift)) >> zfs_ashift);
    kprint("zfs-wtest: cut: block 0's old DVA ", 34);
    kprint_num(x);
    kprint(" (metaslab ", 11);
    kprint_num(ms);
    kprint(") freed in txg ", 15);
    kprint_num(zfs_txg - 1);
    kprintln(", the cursor on it", 18);
    zfs_wt_cutarm();
    zfs_wt_fdw("cut-t", "/agnos9/b11c/f.bin", 1, 131072, 1, 131072, "b11c/k", 1);
    zfs_wt_msonly = 0;
    if (zfs_wt_bp("/agnos9/b11c/f.bin", 1, &bp) == 0) {
        kprint("zfs-wtest: cut: txg ", 20);
        kprint_num(zfs_txg);
        kprint("'s block 1 at ", 14);
        kprint_num(zfs_wt_dva(&bp));
        if (zfs_wt_dva(&bp) == x) { kprintln(" - ON the deferred block: FAIL", 30); }
        else { kprintln(", not the deferred block: ok", 28); }
    }
    return 0;
}
fn zfs_wtest() {
    if (zfs_active == 0) { kprintln("zfs-wtest: no pool", 18); return 0; }
    var pool = zfs_mem + ZR_POOL;
    if (memeq(pool, "agnos", 5) != 1) {
        kprint("zfs-wtest: skipped (pool ", 25);
        kprint(pool, strlen(pool));
        kprintln(" is not a fixture pool)", 23);
        return 0;
    }
    # a failed B3a exercise put the pool read-only; nothing it touched is trusted with the device (zfs_wst_fail)
    if (zfs_wst_bad == 1) {
        kprintln("zfs-wtest: skipped (the writer selftest failed)", 47);
        return 0;
    }
    var cut = zfs_wt_cmdline();                       # (B11) /boot/cmdline zfs_cut=...: the cut lane's list only
    fs_spin_lock();
    # (B10, k.63) the B7 lists' knob-forced lazy unlinks stay QUEUED for OpenZFS's own drain to judge in the guest;
    # zfs_wt_b10 turns the drain on for its own
    zfs_wq_auto = 0;
    zfs_wt_ts0 = load64(zfs_mem + ZR_UB + 32);
    kprint("zfs-wtest: begin txg=", 21);
    kprint_num(zfs_txg);
    kprint(" rw=", 4);
    kprint_num(zfs_rw);
    kprintln("", 0);
    if (cut == 1) {
        # op 1 is the full list's ub-only commit, which the cut list does not run: its clock (zfs_wclock: ts0 + ops
        # started) and zfs-sa-check.py's numbering of the ops' stamps both start the list at op 2
        zfs_wt_n = 1;
        zfs_wt_cutlist(pool);
        zfs_wp_flush();
        kprint("zfs-wtest: cut list done txg=", 29);
        kprint_num(zfs_txg);
        kprint(" ops=", 5);
        kprint_num(zfs_wt_n);
        kprint(" fails=", 7);
        kprint_num(zfs_wt_f);
        kprintln("", 0);
        fs_spin_unlock();
        return 0;
    }
    # design § k.22: the `full` fixture runs the list at ONE resident bitmap slot, so every commit there loads,
    # evicts and reloads metaslabs mid-txg on a real pool (the other lanes keep every metaslab resident) — and with
    # EIGHT null txgs, so its log ZAP (one entry after the export) passes the 7 a 512-byte microzap holds and GROWS
    # (zfs_mz_add) on a pool OpenZFS then judges
    var nn = 3;
    if (zfs_rw == 1 && memeq(pool, "agnosfull", 10) == 1) {
        zfs_wt_cap = 1;
        zfs_ms_evall();
        zfs_bm_slots = 1;
        nn = 8;
        kprintln("zfs-wtest: residency capped at 1 bitmap slot; 8 null txgs", 57);
    }
    # (B9, fixture RECIPE 7) wr's room: the first 5 metaslabs with a space map — what its B5 / B7 gates are tuned to
    if (zfs_rw == 1 && memeq(pool, "agnoswr", 8) == 1) {
        zfs_wt_msmax = 5;
        kprintln("zfs-wtest: allocation capped at the first 5 metaslabs with a space map", 70);
    }
    zfs_wt_ubonly();
    zfs_wt_cows(pool);
    zfs_wt_b6(pool);
    zfs_wt_b7pre(pool);
    zfs_wt_b11pre(pool);
    zfs_wt_b9(pool);
    zfs_wt_b5(pool);
    zfs_wt_b7(pool);
    zfs_wt_b8(pool);
    zfs_wt_b10(pool);
    zfs_wt_b11(pool);
    zfs_wt_b11late(pool);
    zfs_wp_flush();                                   # (B11) nothing pending enters the null txgs
    # the SECOND null txg reserves 512 B for the MOS's chain indirects on its first attempt (zfs_wc_tight): too small,
    # so its chain is re-planned ON DISK (k.25 — `replans=` >= 1 on its plan line), and it is T - 1 of the list, one of
    # the guest's A4 rewinds
    # (the merge, k.133 (a)) agnos9's LAST null txg flushes every dirty metaslab (zfs_wt_flall): the least U reaches it, so
    # logs T - 1 and T - 2 — inside the deferral window — are destroyed in it and become GHOSTS: T - 2's is released and
    # retired by T's own publish (zfs_wdef_rel), T - 1's is kept, read back (zfs_wt_rb) and handed to OpenZFS's verify
    var k = 0;
    while (k < nn) {
        zfs_wc_tight = 0;
        if (k == 1) { zfs_wc_tight = 1; }
        if (k == nn - 1 && memeq(pool, "agnos9", 7) == 1) { zfs_wt_flall = 1; }
        zfs_wt_null();
        zfs_wt_flall = 0;
        k = k + 1;
    }
    zfs_wc_tight = 0;
    kprint("zfs-wtest: ghost logs: made=", 28);
    kprint_num(zfs_wl_gmk);
    kprint(" retired=", 9);
    kprint_num(zfs_wl_gret);
    kprint(" alive=", 7);
    kprint_num(zfs_ngho);
    kprintln("", 0);
    kprint("zfs-wtest: done txg=", 20);
    kprint_num(zfs_txg);
    kprint(" ops=", 5);
    kprint_num(zfs_wt_n);
    kprint(" fails=", 7);
    kprint_num(zfs_wt_f);
    kprintln("", 0);
    fs_spin_unlock();
    return 0;
}
#endif
