# B11's RELEASE op (k.40 / k.64, DECIDED: TXG_DEFER_SIZE = 2) on path (>= 3 x 128 KiB blocks), other a small file: block
# 0's DVA X; txg P rewrites block 0 (X freed in P); txg P + 1 writes other; with the knobs on X's metaslab (zfs_wt_msonly,
# its cursor at X), txg P + 2 rewrites block 1 — its new block must NOT be X (still deferred) — and txg P + 3 block 2 —
# its new block IS X (released once P + 2 was durable, zfs_wdef_rel). Four write ops, each its own zfs_wt_wend.
fn zfs_wt_rel(path, other) {
    var bp[128];
    if (zfs_rw == 0) {
        # a pool gone read-only (the wfail lane): the same four write ops, each refused by name
        zfs_wt_fdw("rel-free", path, 1, 0, 1, 131072, "b11/r0", 1);
        zfs_wt_fdw("rel-next", other, 1, 0, 1, 10, "b11/r1", 1);
        zfs_wt_fdw("rel-deferred", path, 1, 131072, 1, 131072, "b11/r2", 1);
        zfs_wt_fdw("rel-released", path, 1, 262144, 1, 131072, "b11/r3", 1);
        return 0;
    }
    if (zfs_wt_bp(path, 0, &bp) != 0) {
