# Once every allocation of T is made (zfs_wc_try, before the chain is filled — each member's space map dnode is in a
# chain block): each member of the histogram set gets the exact histogram of its free space after T in place of the
# stored one, whose weight it is below. Each attempt starts from the snapshot's bytes (a re-plan restores the chain
# blocks), so the count restarts too. 0 / -1 named.
fn zfs_wh_fill() {
    zfs_wh_n = 0;
