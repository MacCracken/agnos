# --- B8: the op list's FAT-ZAP ops (design § h B8, § i.1) ------------------------------------------------------------
# On agnosfz (fixture RECIPE 7, the FAT-ZAP pool), each op one txg through the syscalls' own paths (zfs_wt_c / _u / _w),
# held to the expected manifest the smoke builds (scripts/smoke/lib/zfs-fz-ops.py — the same plan, and dir3000's
# smallest leaf read off the PRISTINE image), every create's where-line naming its parent's ZAP shape (zfs_wt_zdesc):
#   b8/        a NEW directory, its microzap salt the list's own (zfs_wc_fsalt 0x5A17B9 — any odd salt is OpenZFS's kind of
#              value) so names can be CHOSEN by their hash: s0..s3 and c85912 / c140200 (one 28-bit hash: cd 0 and 1)
#              in the microzap; a 60-byte name UPGRADES it (mzap_upgrade: every entry re-added with its own cd); 42
#              255-byte `b` names (top 2 hash bits 0b00; 15 chunks each, 42 to a leaf) split its leaf; 255-byte `a` names,
#              which all share their top 12 bits (0x5A3), until the pointer table starts DOUBLING (79: every split of
#              their leaf goes one way — the embedded table moves
#              out at prefix 10, doubles once at 11 and, at 12, 2 -> 4 blocks within the op; then a prefix-13 leaf under
#              ZAP_LEAF_LOW_WATER starts the 4 -> 8 doubling one block per op, zap_put_leaf_maybe_grow_ptrtbl); 2 more `b`
#              names split the full `b` leaf MID-GROW (every new table entry written to both tables, zap_table_store);
#              10 spread names finish the doubling; a 255-byte name (13 name chunks). Then removes (every spread name,
#              every 10th `a`, 5 `b`), a rename in it and across to dir3000, links both ways
#   dir3000/   (OpenZFS's 3,000 names, 16 leaves) a 255-byte name created and unlinked; its SMALLEST leaf emptied — every
#              name in it unlinked (the leaf kept, its table range unchanged: zap_shrink is not built)
#   longn/     all 60 255-byte names unlinked (both OpenZFS leaves emptied), then rmdir: a fat directory object freed
#   micro/     a 55-byte name: OpenZFS's 20-entry microzap upgraded by agnos
#   uids       10 bytes into u50 (its owner's keys updated in FAT accounting ZAPs), unlink of u51 (keys 0x803 removed),
#              new.txt (uid 0 and gid 1999: keys every such dataset has — the hidden shares directory owns uid 0 — updated)
#   uidm       new.txt: a create's two reserved keys do not fit a userused microzap with one free chunk — UPGRADED at
#              admission (zfs_wz_urs; design k.78)
#   sym, sym2  the pool's first symlink: a NEW SA layout (the LAYOUTS add), the second reuses it
var zfs_wt_ga = 0;           # the class-name generators' cursors (zfs_wt_gname): `a`, `b`
var zfs_wt_gb = 0;
# The next name of class letter (cursor at cur, a u64) into out (255 bytes): "<letter><7 digits>-" padded with q to 255
# bytes, whose hash under the b8 salt has want in its top bits (bits 0: any). Its length. (B8 gate: the digits were 5 and
# the cursor passes 100,000 — the a-names wrapped onto earlier ones, EEXIST; zfs-fz-ops.py's gen is the same 7.)
fn zfs_wt_gname(letter, bits, want, cur, out) {
    while (1 == 1) {
        var i = load64(cur);
        store64(cur, i + 1);
        memset(out, 113, 255);
        store8(out, letter);
        var d = 7;
        while (d > 0) {
            store8(out + d, 48 + i % 10);
            i = i / 10;
            d = d - 1;
        }
        store8(out + 8, 45);
        if (bits == 0 || (zfs_zap_hash(0x5A17B9, out, 255) >> (64 - bits)) == want) { return 255; }
    }
    return 0;
}
# path = dir + "/" + the nl bytes at n (NUL-terminated) into p. p.
fn zfs_wt_pj(p, dir, n, nl) {
    var dl = strlen(dir);
    memcpy(p, dir, dl);
    store8(p + dl, 47);
    memcpy(p + dl + 1, n, nl);
    store8(p + dl + 1 + nl, 0);
    return p;
}
# The fat-ZAP header of directory path at T (the reader's view) — 0 when it is not fat.
fn zfs_wt_zhdr(path) {
    var r = zfs_resolve(path, strlen(path), 1);
    var dn = zfs_dnslot(4);
    if (r < 0 || zfs_ref_dn(r, dn) != 0) { return 0; }
    var b = zfs_obj_blk(dn, 0, 1);
    if (b == 0 || load64(b) != ((1 << 63) | 1)) { return 0; }
    return b;
}
fn zfs_wt_zinfo(path) {
    var r = zfs_resolve(path, strlen(path), 1);
    var dn = zfs_dnslot(4);
    if (r < 0 || zfs_ref_dn(r, dn) != 0) { store8(dn, 0); }
    kprint("zfs-wtest: zap ", 15);
    kprint(path, strlen(path));
    kprint(": ", 2);
    zfs_wt_zdesc(dn);
    kprintln("", 0);
    return 0;
}
# Every name of fat directory path's leaf with the fewest entries (the lowest block among equals), in chunk order, into
# out (NUL-separated: ZWA_TNL, 16 KiB — a 16 KiB leaf's names fit, ≈ 638 chunks x 21 bytes). Their count /
# -1.
fn zfs_wt_small_leaf(path, out) {
    var r = zfs_resolve(path, strlen(path), 1);
    var dn = zfs_dnslot(4);
    if (r < 0 || zfs_ref_dn(r, dn) != 0) { return 0 - 1; }
    var b0 = zfs_obj_blk(dn, 0, 1);
    if (b0 == 0 || load64(b0) != ((1 << 63) | 1)) { return 0 - 1; }
    var fb = load64(b0 + 56);
    var bsz = load16(dn + 8) << 9;
    var best = 0 - 1;
    var bn = 0x7FFFFFFF;
    var k = 1;
    while (k < fb) {
        var lf = zfs_obj_blk(dn, k, 1);
        if (lf != 0 && load64(lf) == (1 << 63) && load32(lf + 24) == ZK_LEAFMAGIC && load16(lf + 30) < bn) {
            bn = load16(lf + 30);
            best = k;
        }
        k = k + 1;
    }
    if (best < 0) { return 0 - 1; }
    var lf2 = zfs_obj_blk(dn, best, 1);
    if (lf2 == 0) { return 0 - 1; }
    var nh = bsz / 32;
    var nc = (bsz - 2 * nh) / 24 - 2;
    var ch = lf2 + 48 + nh * 2;
    var o = 0;
    var c = 0;
    var cnt = 0;
    while (c < nc) {
        var e = ch + c * 24;
        if (load8(e) == 252) {
            var nn = load16(e + 6) - 1;
            var a = load16(e + 4);
            if (nn < 0 || o + nn + 1 > 0x4000) { return 0 - 1; }      # ZWA_TNL's 16 KiB
            var i = 0;
            while (i < nn && a < nc) {
                var ar = ch + a * 24;
                var j = 0;
                while (j < 21 && i < nn) {
                    store8(out + o + i, load8(ar + 1 + j));
                    i = i + 1;
                    j = j + 1;
                }
                a = load16(ar + 22);
            }
            store8(out + o + nn, 0);
            o = o + nn + 1;
            cnt = cnt + 1;
        }
        c = c + 1;
    }
    kprint("zfs-wtest: the smallest leaf of ", 32);
    kprint(path, strlen(path));
    kprint(": block ", 8);
    kprint_num(best);
    kprint(", ", 2);
    kprint_num(cnt);
    kprintln(" entries", 8);
    return cnt;
}
fn zfs_wt_b8(pool) {
    if (memeq(pool, "agnosfz", 8) != 1) { return 0; }
    var p[320];
    var n[256];
    var i = 0;
    zfs_wc_fsalt = 0x5A17B9;
    zfs_wt_c(1, "/agnosfz/b8", 0, 0);
    zfs_wc_fsalt = 0;
    zfs_wt_c(0, "/agnosfz/b8/s0", 0, 0);
    zfs_wt_c(0, "/agnosfz/b8/s1", 0, 0);
    zfs_wt_c(0, "/agnosfz/b8/c85912", 0, 0);
    zfs_wt_c(0, "/agnosfz/b8/s2", 0, 0);
    zfs_wt_c(0, "/agnosfz/b8/c140200", 0, 0);
    zfs_wt_c(0, "/agnosfz/b8/s3", 0, 0);
    zfs_wt_zinfo("/agnosfz/b8");
    zfs_wt_c(0, "/agnosfz/b8/b8-long-name-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy", 0, 0);
    zfs_wt_zinfo("/agnosfz/b8");
    zfs_wt_ga = 0;
    zfs_wt_gb = 0;
    while (i < 42) {
        zfs_wt_gname(98, 2, 0, &zfs_wt_gb, &n);
        zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0);
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/b8");
    var na = 0;
    var h = zfs_wt_zhdr("/agnosfz/b8");
    while (na < 400 && (h == 0 || load64(h + 40) == 0)) {
        zfs_wt_gname(97, 12, 0x5A3, &zfs_wt_ga, &n);
        if (zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0) != 0) { break; }
        na = na + 1;
        h = zfs_wt_zhdr("/agnosfz/b8");
    }
    kprint("zfs-wtest: b8: ", 15);
    kprint_num(na);
    kprintln(" a-names until the pointer table began doubling", 47);
    zfs_wt_zinfo("/agnosfz/b8");
    i = 0;
    while (i < 2) {
        zfs_wt_gname(98, 2, 0, &zfs_wt_gb, &n);
        zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0);
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/b8");
    i = 0;
    while (i < 10) {
        memcpy(&n, "spread-00", 9);
        store8(&n + 9, 48 + i);
        zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 10), 0, 0);
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/b8");
    memset(&n, 76, 255);
    memcpy(&n, "b8-255-", 7);
    zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0);
    # removes: every spread name, every 10th a-name, the first 5 b-names
    i = 0;
    while (i < 10) {
        memcpy(&n, "spread-00", 9);
        store8(&n + 9, 48 + i);
        zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 10), 0, 0);
        i = i + 1;
    }
    zfs_wt_ga = 0;
    i = 0;
    while (i < na) {
        zfs_wt_gname(97, 12, 0x5A3, &zfs_wt_ga, &n);
        if (i % 10 == 0) { zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0); }
        i = i + 1;
    }
    zfs_wt_gb = 0;
    i = 0;
    while (i < 5) {
        zfs_wt_gname(98, 2, 0, &zfs_wt_gb, &n);
        zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/b8", &n, 255), 0, 0);
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/b8");
    # renames and links within and across fat directories
    zfs_wt_u(2, "/agnosfz/b8/s0", "/agnosfz/b8/s0-renamed-in-its-fat-directory-to-a-name-of-sixty-bytes", 0);
    zfs_wt_u(2, "/agnosfz/b8/s1", "/agnosfz/dir3000/s1-from-b8", 0);
    zfs_wt_u(2, "/agnosfz/dir3000/f0001", "/agnosfz/b8/f0001", 0);
    zfs_wt_u(3, "/agnosfz/dir3000/f0002", "/agnosfz/b8/link-f0002", 0);
    zfs_wt_u(3, "/agnosfz/b8/s2", "/agnosfz/dir3000/link-s2", 0);
    # dir3000: a 255-byte name in and out; then its smallest leaf emptied
    memset(&n, 77, 255);
    memcpy(&n, "d3k-255-", 8);
    zfs_wt_c(0, zfs_wt_pj(&p, "/agnosfz/dir3000", &n, 255), 0, 0);
    zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/dir3000", &n, 255), 0, 0);
    var lb = zfs_wmem + ZWA_TNL;
    var cnt = zfs_wt_small_leaf("/agnosfz/dir3000", lb);
    var o = 0;
    i = 0;
    while (i < cnt) {
        var ln = strlen(lb + o);
        zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/dir3000", lb + o, ln), 0, 0);
        o = o + ln + 1;
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/dir3000");
    # longn: every 255-byte name out, both leaves emptied, then the directory itself
    i = 0;
    while (i < 60) {
        memset(&n, 76, 255);
        store8(&n, 48 + i / 10);
        store8(&n + 1, 48 + i % 10);
        store8(&n + 2, 45);
        zfs_wt_u(0, zfs_wt_pj(&p, "/agnosfz/longn", &n, 255), 0, 0);
        i = i + 1;
    }
    zfs_wt_zinfo("/agnosfz/longn");
    zfs_wt_u(1, "/agnosfz/longn", 0, 0);
    zfs_wt_c(0, "/agnosfz/micro/a-name-of-fifty-five-bytes-upgrades-this-microzap-xxxxx", 0, 0);
    zfs_wt_zinfo("/agnosfz/micro");
    zfs_wt_w("/agnosfz/uids/u50", 0, 10, "b8/u50", 1, 10);
    zfs_wt_u(0, "/agnosfz/uids/u51", 0, 0);
    zfs_wt_c(0, "/agnosfz/uids/new.txt", 0, 0);
    zfs_wt_c(0, "/agnosfz/uidm/new.txt", 0, 0);
    zfs_wt_c(2, "/agnosfz/sym", "hello.txt", 0);
    zfs_wt_c(2, "/agnosfz/sym2", "hello.txt", 0);
    return 0;
}
# --- B9: the op list's SNAPSHOTTED-DATASET ops (design § h B9, § i.1) --------------------------------------------------
# B5 / B6 / B7's kinds of op in datasets whose kills reach a snapshot (each txg's plan line: dl= its deadlist appends,
# dlu= their Σ dsize, mat= the entries materialised from empty_bpobj), right after zfs_wt_b7pre — before B5's, whose
# last op on agnoswr exhausts the metaslabs agnos allocates in and on agnostank leaves the boot-long deferral above the
# room (k.40) — then each touched dataset's deadlist as committed (zfs_wt_dl):
#   agnostank  the root (@snap1 — its head deadlist's entry 1 already a bpobj of its own): RMW of the EMBEDDED small.txt
#              (deadlisted: an UCSIZE, no dsize), of one record of rand-1m.bin, of snap-changed.txt (its block born
#              after @snap1: FREED, the snapshot's around it deadlisted — one txg); big.bin truncated to 1,000,000 B (40
#              records), text-3m.txt AO_TRUNC'd; unlink deep/a/b/c/d/e/leaf.txt, the emptied e moved to deep/a/e2,
#              mkdir deep/b9 + a file written there (the root DIRECTORY is a fat ZAP: B8's)
#   agnoswr    snap (@s1): RMW of the EMBEDDED keep.txt, rewritten.bin overwritten whole (its block born after @s1:
#              freed), unlink moved.txt; clone (of snap@s1, no livelist — OpenZFS dropped it at 71 % shared): RMW of
#              keep.txt, the ORIGIN's block (deadlisted with no unique and no HEAD -> SNAP: born before dd_origin_txg),
#              unlink own.txt (the clone's); snap2 (RECIPE 7: @a, @b, its head's every entry still the empty_bpobj):
#              a.bin's first 4 KiB — TWO entries materialised in one txg (a.bin's block born before @a, its dnode block
#              and the objset's chain between @a and @b) — then b.bin's second 4 KiB, a.bin AO_TRUNC'd (born after @b:
#              freed)
# The deadlist of the dataset holding path as the committed MOS holds it: `zfs-wtest: deadlist <path> object <o>: <n>
# entries (<e> naming empty_bpobj), dl_used <u>, prev snapshot unique <pu>, dir SNAP <s>`.
fn zfs_wt_dl(path) {
    var ref = zfs_resolve(path, strlen(path), 0);
    var d = zfs_wdn(1);
    kprint("zfs-wtest: deadlist ", 20);
    kprint(path, strlen(path));
    if (ref < 0 || zfs_dnode(zfs_mem + ZR_MOS, load64(zfs_ds(zfs_ref_di(ref)) + 840), d) != 0) {
        zfs_wt_f = zfs_wt_f + 1;
        kprintln(" FAIL unreadable", 16);
        return 0 - 1;
    }
    var pv = load64(zfs_bonus(d) + 8);
    var dir = load64(zfs_bonus(d));
    var dl = load64(zfs_bonus(d) + 64);
    var n = 0;
    var ne = 0;
    var du = 0;
    if (zfs_dnode(zfs_mem + ZR_MOS, dl, d) == 0 && load8(d) == 50) {
        du = load64(zfs_bonus(d));
        var cur = 0;
        while (zfs_zap_next(d, &cur) == 1) {
            n = n + 1;
            if (zfs_it_val == zfs_w_ebo) { ne = ne + 1; }
        }
    }
    kprint(" object ", 8);
    kprint_num(dl);
    kprint(": ", 2);
    kprint_num(n);
    kprint(" entries (", 10);
    kprint_num(ne);
    kprint(" naming empty_bpobj), dl_used ", 30);
    kprint_num(du);
    kprint(", prev snapshot unique ", 23);
    if (zfs_dnode(zfs_mem + ZR_MOS, pv, d) == 0) { kprint_num(load64(zfs_bonus(d) + 96)); }
    kprint(", dir SNAP ", 11);
    if (zfs_dnode(zfs_mem + ZR_MOS, dir, d) == 0) { kprint_num(load64(zfs_bonus(d) + 112)); }
    kprintln("", 0);
    return 0;
}
fn zfs_wt_b9(pool) {
    if (memeq(pool, "agnostank", 10) == 1) {
        zfs_wt_w("/agnostank/small.txt", 100, 10, "b9/small", 1, 10);
        zfs_wt_w("/agnostank/rand-1m.bin", 300000, 5000, "b9/r1m", 1, 5000);
        zfs_wt_w("/agnostank/snap-changed.txt", 0, 5, "b9/sc", 1, 5);
        zfs_wt_t("/agnostank/big.bin", 1000000, 0);
        zfs_wt_t("/agnostank/text-3m.txt", 0, 0);
        zfs_wt_u(0, "/agnostank/deep/a/b/c/d/e/leaf.txt", 0, 0);
        zfs_wt_u(2, "/agnostank/deep/a/b/c/d/e", "/agnostank/deep/a/e2", 0);
        zfs_wt_c(1, "/agnostank/deep/b9", 0, 0);
        zfs_wt_c(0, "/agnostank/deep/b9/n.txt", 0, 0);
        zfs_wt_w("/agnostank/deep/b9/n.txt", 0, 100, "b9/n", 1, 100);
        zfs_wt_dl("/agnostank");
    } elif (memeq(pool, "agnoswr", 8) == 1) {
        zfs_wt_w("/agnoswr/snap/keep.txt", 0, 10, "b9/keep", 1, 10);
        zfs_wt_w("/agnoswr/snap/rewritten.bin", 0, 131072, "b9/rw", 1, 131072);
        zfs_wt_u(0, "/agnoswr/snap/moved.txt", 0, 0);
        zfs_wt_w("/agnoswr/clone/keep.txt", 0, 10, "b9/ckeep", 1, 10);
        zfs_wt_u(0, "/agnoswr/clone/own.txt", 0, 0);
        zfs_wt_w("/agnoswr/snap2/a.bin", 0, 4096, "b9/a", 1, 4096);
        zfs_wt_w("/agnoswr/snap2/b.bin", 4096, 4096, "b9/b", 1, 4096);
        zfs_wt_t("/agnoswr/snap2/a.bin", 0, 0);
        # (B9 review, fixture RECIPE 8) edge: block 0's path reaches four deadlist intervals (k.100) — first with every
        # deadlist read as FAT (zfs_wt_dlfat): its objset's entry still names empty_bpobj, so the ADMISSION refuses the
        # materialisation, nothing written; q.bin (three levels: no txg holds its path with four entries — refused by
        # name); p.bin (two: four entries appended in one txg). These run before any other edge op, while the chain is
        # still the snapshot's
        zfs_wt_dlfat = 1;
        zfs_wt_w("/agnoswr/edge/p.bin", 0, 4096, "b9/p", 1, 0 - 1);
        zfs_wt_dlfat = 0;
        zfs_wt_w("/agnoswr/edge/q.bin", 0, 4096, "b9/q", 1, 0 - 1);
        zfs_wt_w("/agnoswr/edge/p.bin", 0, 4096, "b9/p", 1, 4096);
        # the four boundary births (k.103): edge's e4.bin at ds_prev_snap_txg (branch B), e3.bin at a deadlist key and at
        # the previous snapshot's ds_prev_snap_txg; edgec's e4.bin at a key, the previous's ds_prev_snap_txg and the
        # clone's dd_origin_txg, its c1.bin at ds_prev_snap_txg
        zfs_wt_w("/agnoswr/edge/e4.bin", 0, 4096, "b9/e4", 1, 4096);
        zfs_wt_w("/agnoswr/edge/e3.bin", 0, 4096, "b9/e3", 1, 4096);
        zfs_wt_w("/agnoswr/edgec/e4.bin", 0, 4096, "b9/ce4", 1, 4096);
        zfs_wt_w("/agnoswr/edgec/c1.bin", 0, 4096, "b9/c1", 1, 4096);
        # (k.99) edgec/t.bin, four kill-list entries a txg (zfs_wt_ftight): its blocks 8-15 are branch A, 0-7 the
        # origin's. With the deadlist table capped below edgec's keys (zfs_wt_dlmax) the truncation is refused at its
        # SCAN — nothing freed, txgs=0 (B9 refused it in its third txg, two committed); then it runs: four txgs, the last
        # two deadlisting
        zfs_wt_ftight = 4;
        zfs_wt_dlmax = 3;
        zfs_wt_t("/agnoswr/edgec/t.bin", 0, 0 - 1);
        zfs_wt_dlmax = 0;
        zfs_wt_t("/agnoswr/edgec/t.bin", 0, 0);
        zfs_wt_ftight = 0;
        zfs_wt_dl("/agnoswr/snap");
        zfs_wt_dl("/agnoswr/clone");
        zfs_wt_dl("/agnoswr/snap2");
        zfs_wt_dl("/agnoswr/edge");
        zfs_wt_dl("/agnoswr/edgec");
    }
    return 0;
}
# --- B10: the op list's DRAIN ops (design § h B10, § i.1, k.63) ---------------------------------------------------------
# Every txg of every list prints its HYGIENE line (zfs_wt_stats): flushes, bumps and destroyed logs run on every lane —
# main's and fz's lists are runs of 300+ txgs, the 200-txg run the bite's gate names, held to <= 16 logs alive by
# zfs-write-smoke. This section adds what no list did before: agnos DRAINING a DELETE_QUEUE (k.63, zfs_wq_obj):
#   · agnos9: every object B7's knob-forced lazy unlinks queued in the root dataset (zfs_wt_dq) — lz2.bin (a rename's
#     target) and lzd (a directory) freed, one txg each; xd.txt REFUSED by name: it holds an extended-attribute
#     directory (zfs_rmnode's purge is not built), so it stays for OpenZFS's drain (the guest's k.72 set-aside stands)
#   · agnostank: off/lazy.bin (64 KiB of 4 KiB records) in BOUNDED PARTS — zfs_wq_tight 1 sends it through the
#     truncation, zfs_wt_ftight 4 kill entries a txg (dmu_free_long_range's chunks), then its final free — and the
#     PRODUCTION path: a new off/b10.bin (12 KiB) unlinked with zfs_wq_auto on, queued by its own txg (zfs_wu_tight 1)
#     and drained by the same op in the txgs after it (zfs_wu_end)
# Is "%x"(obj) on the committed DELETE_QUEUE of dataset slot di? 1 / 0 / -1.
fn zfs_wt_dqhas(di, obj) {
    var mn = zfs_dnslot(4);
    var dq = 0;
    if (zfs_dnode(zfs_ds(di), 1, mn) != 0 || zfs_zap_u64(mn, "DELETE_QUEUE", &dq) != 1) { return 0 - 1; }
    if (zfs_dnode(zfs_ds(di), dq, mn) != 0) { return 0 - 1; }
    var key[24];
    memset(&key, 0, 24);
    zfs_whex(obj, &key);
    var v = 0;
    var r = zfs_zap_u64(mn, &key, &v);
    if (r == 1) { return 1; }
    if (r == (0 - 2)) { return 0; }
    return 0 - 1;
}
# The first object on the committed DELETE_QUEUE of dataset slot di that is not among the ns at sk: its number, 0 none,
# -1 unreadable.
fn zfs_wt_dqnext(di, sk, ns) {
    var mn = zfs_dnslot(4);
    var dq = 0;
    if (zfs_dnode(zfs_ds(di), 1, mn) != 0 || zfs_zap_u64(mn, "DELETE_QUEUE", &dq) != 1) { return 0 - 1; }
    if (zfs_dnode(zfs_ds(di), dq, mn) != 0) { return 0 - 1; }
    var cur = 0;
    var r = zfs_zap_next(mn, &cur);
    while (r == 1) {
        var o = zfs_it_val;
        var k = 0;
        var seen = 0;
        while (k < ns) {
            if (load64(sk + k * 8) == o) { seen = 1; }
            k = k + 1;
        }
        if (seen == 0) { return o; }
        r = zfs_zap_next(mn, &cur);
    }
    if (r < 0) { return 0 - 1; }
    return 0;
}
# Drain the DELETE_QUEUE of the dataset whose root is path (k.63): every queued object agnos can free (zfs_wq_obj),
# FreeBSD's zfs_unlinked_drain past a refusal; nref refusals expected, each by name. Lines: `zfs-wtest: drain begin txg=T
# <path>`, per object `zfs-wtest: drain <path> object N: freed txgs=K parts=P` (P: the steps that freed a part of its data
# first) or `... object N: refused (<why>)`, the commit lines, `zfs-wtest: drain <path> -> 0 txgs=K`, the read-back of the
# last txg, then `zfs-wtest: drain ok` — or FAIL: an object still queued or its slot still allocated after `freed`, a
# refusal count other than nref.
fn zfs_wt_dq(path, nref) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    zfs_wt_op("drain");
    kprint(" begin txg=", 11);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprintln(path, strlen(path));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var ref = zfs_resolve(path, strlen(path), 1);
    var di = 0 - 1;
    if (ref >= 0) { di = zfs_ref_di(ref); }
    var sk[64];
    var ns = 0;
    var bad = 0;
    var n = 0;
    while (di >= 0 && n < 8) {
        var obj = zfs_wt_dqnext(di, &sk, ns);
        if (obj <= 0) {
            if (obj < 0) { bad = 1; }
            break;
        }
        n = n + 1;
        var dr = zfs_wq_obj(di, obj);
        zfs_wt_op("drain");
        kprint(" ", 1);
        kprint(path, strlen(path));
        kprint(" object ", 8);
        kprint_num(obj);
        if (dr == 0) {
            kprint(": freed txgs=", 13);
            kprint_num(zfs_wq_nt);
            kprint(" parts=", 7);
            kprint_num(zfs_wq_np);
            kprintln("", 0);
            var dn = zfs_dnslot(5);
            if (zfs_wt_dqhas(di, obj) != 0 || zfs_dnode(zfs_ds(di), obj, dn) != (0 - 2)) { bad = 1; }
        } else {
            kprint(": refused (", 11);
            zfs_wt_why();
            kprintln(")", 1);
            store64(&sk + ns * 8, obj);
            ns = ns + 1;
        }
    }
    var t = t0 + 1;
    while (t <= zfs_txg) {
        kprint("zfs-wtest: commit txg ", 22);
        kprint_num(t);
        kprintln("", 0);
        t = t + 1;
    }
    var k = zfs_txg - t0;
    zfs_wt_op("drain");
    kprint(" ", 1);
    kprint(path, strlen(path));
    kprint(" -> 0 txgs=", 11);
    kprint_num(k);
    kprintln("", 0);
    if (rw == 0) {
        zfs_wt_op("drain");
        if (k != 0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return 0 - 1;
        }
        kprintln(" ok refused (pool read-only)", 28);
        return 0;
    }
    if (k > 0 && zfs_wt_rb(zfs_txg) != 0) {
        zfs_wfail_now(zfs_txg);
        zfs_wt_fail("drain");
        return 0 - 1;
    }
    zfs_wt_op("drain");
    if (bad == 1 || di < 0 || ns != nref) {
        zfs_wt_f = zfs_wt_f + 1;
        kprint(" FAIL the queue after it: refusals ", 35);
        kprint_num(ns);
        kprint(" (want ", 7);
        kprint_num(nref);
        kprintln(")", 1);
        return 0 - 1;
    }
    kprintln(" ok", 3);
    return 0;
}
# The PRODUCTION drain on disk (zfs_wu_end): unlink a with zfs_wq_auto on — the knob zfs_wu_tight sends the object to the
# DELETE_QUEUE in the unlink's own txg, and the same op drains it in the txgs after. Lines as zfs_wt_u's (kind 0); the
# where-line `zfs-wtest: unlink <a> object N: freed (queued by its txg, drained by K more)`; FAIL unless it was queued
# and drained (K >= 1, one txg + K), the name gone, the entry gone, the slot free.
fn zfs_wt_ul(a) {
    zfs_wt_n = zfs_wt_n + 1;
    var rw = zfs_rw;
    var t0 = zfs_txg;
    zfs_wt_op("unlink");
    kprint(" begin txg=", 11);
    kprint_num(t0 + 1);
    kprint(" ", 1);
    kprintln(a, strlen(a));
    zfs_ms_nload = 0;
    zfs_xl_rap = 0;
    var ref = zfs_resolve(a, strlen(a), 0);
    var obj = ref & ZK_MASK48;
    var di = 0 - 1;
    if (ref >= 0) { di = zfs_ref_di(ref); }
    zfs_wq_nt = 0;
    zfs_wno("refused");
    var r = zfs_wunlink(a, strlen(a));
    var t = t0 + 1;
    while (t <= zfs_txg) {
        kprint("zfs-wtest: commit txg ", 22);
        kprint_num(t);
        kprintln("", 0);
        t = t + 1;
    }
    var k = zfs_txg - t0;
    zfs_wt_op("unlink");
    kprint(" ", 1);
    kprint(a, strlen(a));
    kprint(" -> ", 4);
    kprint_num(r);
    kprint(" txgs=", 6);
    kprint_num(k);
    kprintln("", 0);
    if (rw == 0) {
        zfs_wt_op("unlink");
        if (r == 0 || k != 0) {
            kprintln(" FAIL a read-only pool committed", 32);
            zfs_wt_f = zfs_wt_f + 1;
            return r;
        }
        kprint(" ok refused (", 13);
        zfs_wt_why();
        kprintln(")", 1);
        return r;
    }
    if (r != 0) {
        zfs_wt_fail("unlink");
        return r;
    }
    if (k > 0 && zfs_wt_rb(zfs_txg) != 0) {
        zfs_wfail_now(zfs_txg);
        zfs_wt_fail("unlink");
        return 0 - 1;
    }
    zfs_wt_op("unlink");
    kprint(" ", 1);
    kprint(a, strlen(a));
    kprint(" object ", 8);
    kprint_num(obj);
    kprint(": freed (queued by its txg, drained by ", 39);
    kprint_num(zfs_wq_nt);
    kprintln(" more)", 6);
    var bad = 0;
    var dn = zfs_dnslot(5);
    if (zfs_wq_nt < 1 || k != 1 + zfs_wq_nt || di < 0 || zfs_wt_x(a) != 0) { bad = 1; }
    elif (zfs_wt_dqhas(di, obj) != 0 || zfs_dnode(zfs_ds(di), obj, dn) != (0 - 2)) { bad = 1; }
    zfs_wt_op("unlink");
    if (bad == 1) {
        zfs_wt_f = zfs_wt_f + 1;
        kprintln(" FAIL the object was not queued and drained", 43);
        return 0 - 1;
    }
    kprintln(" ok", 3);
    return 0;
}
fn zfs_wt_b10(pool) {
    if (memeq(pool, "agnos9", 7) == 1) {
        zfs_wt_dq("/agnos9", 1);
    } elif (memeq(pool, "agnostank", 10) == 1) {
        zfs_wq_tight = 1;
        zfs_wt_ftight = 4;
        zfs_wt_dq("/agnostank/off", 0);
        zfs_wq_tight = 0;
        zfs_wt_ftight = 0;
        zfs_wt_c(0, "/agnostank/off/b10.bin", 0, 0);
        zfs_wt_w("/agnostank/off/b10.bin", 0, 12288, "b10/q", 1, 12288);
        zfs_wq_auto = 1;
        zfs_wu_tight = 1;
        zfs_wt_ul("/agnostank/off/b10.bin");
        zfs_wu_tight = 0;
        zfs_wq_auto = 0;
    }
    return 0;
}
# --- B11: the op list's POLICY-B, RELEASE and CRASH-CUT ops (design § h B11, § b.2, § b.3, k.40, k.124-k.128 (B11)) -----
# Every op runs the syscalls' own code (zfs_open, zfs_fd_write, zfs_fd_read, zfs_stat, vfs_close_inner, zfs_wp_sync) on
# agnos9 (and its byte-identical variants), each held by the op itself to the txgs it must commit, then zfs_wt_wend's
# read-back and F line; scripts/smoke/zfs-write-smoke.sh carries the same list as zfs-expect.py ops (b11_ops):
#   cp       b11/ (mkdir), b11/a.bin and b11/b.bin created, then 8 x 64 KiB through ONE fd and closed — policy A (the
#            knob zfs_wp_pol 0): 8 txgs, 8 logs; policy B: ONE txg, committed by the close
#   observe  a write through fd A left pending; a READ of another file commits nothing; a read through fd B of the
#            pending object commits it first and sees the bytes (commit-before-observe); stat sees the new size
#   sync     a pending write committed by sync#12 (zfs_wp_sync); age: one committed by the age bound (the knob) at a
#            getdents of an unrelated directory
#   arena    4.5 MiB in 64 KiB writes through one fd: the txg commits at its threshold and goes on — >= 2 txgs
#   release  (k.40 / k.64, DECIDED) a 128 KiB block freed in txg P with the allocator's cursor set onto it: txg P + 2's
#            new block lands elsewhere (deferred), txg P + 3's ON it (released when P + 2 became durable)
# Lines: as zfs_wt_w's (`zfs-wtest: write begin ...`, each txg's plan line, `... -> r txgs=k`, the F line, `write ok`),
# plus `zfs-wtest: b11 <what> ... ok` / `FAIL` naming what the op proved.
var zfs_wt_cut = 0 - 1;      # the crash-cut knob (/boot/cmdline `zfs_cut=[CLASS:]N`, zfs_wt_cmdline): -1 off · halt after
var zfs_wt_cutc = 0;         #   N device writes of the ARMED txg — of CLASS (0 any · 1 data · 2 dataset metadata · 3 MOS ·
var zfs_wt_cuta = 0;         #   4 MOS chain · 5 uberblock slot) · 1 = armed: the next commit's writes count
var zfs_wt_cutk = 0;         # the armed commit's writes of the class so far
var zfs_wt_cutn[6];          # its writes: [0] all · [1..4] by class · [5] uberblock slots
fn zfs_wt_clsname(c) {
    if (c == 1) { return "data"; }
    if (c == 2) { return "dataset metadata"; }
    if (c == 3) { return "MOS"; }
    if (c == 4) { return "MOS chain"; }
    return "uberblock";
}
fn zfs_wt_cutmap() {
    kprint_num(load64(&zfs_wt_cutn));
    kprint(" device writes (data ", 21);
    kprint_num(load64(&zfs_wt_cutn + 8));
    kprint(", dataset metadata ", 19);
    kprint_num(load64(&zfs_wt_cutn + 16));
    kprint(", MOS ", 6);
    kprint_num(load64(&zfs_wt_cutn + 24));
    kprint(", MOS chain ", 12);
    kprint_num(load64(&zfs_wt_cutn + 32));
    kprint(", uberblock ", 12);
    kprint_num(load64(&zfs_wt_cutn + 40));
    kprint(")", 1);
    return 0;
}
# The machine stops — the cut lane's crash: no further write reaches the device. Never returns.
fn zfs_wt_halt() {
    while (1 == 1) {
        # REGISTER CONTRACT: no GPR read or written; cli clears RFLAGS.IF, hlt parks the CPU (only an NMI / SMI wakes it,
        # and the loop parks it again) — the kernel's last instruction on the cut lane
        asm {
            0xFA;                     # cli
            0xF4;                     # hlt
        }
    }
    return 0;
}
# zfs_wr's hook (ZFS_WRITE_OPS): the device write about to be issued is the armed txg's next — after N of its class the
# kernel halts BEFORE it (`zfs-wtest: cut txg T after <map>, before a <class> write - halted`). 0.
fn zfs_wt_cutw() {
    if (zfs_wt_cuta != 1) { return 0; }
    var c = zfs_wr_cls;
    if (c > 5) { c = 5; }
    if (c < 1) { c = 3; }
    if (zfs_wt_cutk >= zfs_wt_cut) {
        # (the merge, k.133 (e)) the cut txg's own log hygiene, planned before any of its writes (zfs_wl_plan): a cut
        # lane whose txg flushed halts with that flush's space-map appends written (MOS) or not yet (data) — B10's flush
        # cut mid-way, which OpenZFS must open past exactly as any other partial txg
        kprint("zfs-wtest: cut txg ", 19);
        kprint_num(zfs_txg + 1);
        kprint(" hygiene: flushed=", 18);
        kprint_num(zfs_wl_nf);
        kprint(" bumped=", 8);
        kprint_num(zfs_wl_nb);
        kprint(" destroyed=", 11);
        kprint_num(zfs_wl_nd);
        kprint(" words=", 7);
        kprint_num(zfs_wl_nw);
        kprintln("", 0);
        kprint("zfs-wtest: cut txg ", 19);
        kprint_num(zfs_txg + 1);
        kprint(" after ", 7);
        zfs_wt_cutmap();
        kprint(", before a ", 11);
        var nm = zfs_wt_clsname(c);
        kprint(nm, strlen(nm));
        kprintln(" write - halted", 15);
        zfs_wt_halt();
    }
    store64(&zfs_wt_cutn, load64(&zfs_wt_cutn) + 1);
    store64(&zfs_wt_cutn + c * 8, load64(&zfs_wt_cutn + c * 8) + 1);
    if (zfs_wt_cutc == 0 || zfs_wt_cutc == c) { zfs_wt_cutk = zfs_wt_cutk + 1; }
    return 0;
}
# Arm the knob for the NEXT commit. 0.
fn zfs_wt_cutarm() {
    zfs_wt_cutk = 0;
    memset(&zfs_wt_cutn, 0, 48);
    zfs_wt_cuta = 1;
    kprint("zfs-wtest: cut armed for txg ", 29);
    kprint_num(zfs_txg + 1);
    kprint(": ", 2);
    var nm = "any";
    if (zfs_wt_cutc > 0) { nm = zfs_wt_clsname(zfs_wt_cutc); }
    kprint(nm, strlen(nm));
    kprint(" write ", 7);
    kprint_num(zfs_wt_cut);
    kprintln("", 0);
