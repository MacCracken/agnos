    var key[24];
    var kl = zfs_whex(t, &key);
    dn = zfs_wmos_dn(zfs_w_lzo);
    if (dn == 0) { return 0 - 1; }
    zfs_wz_open(0, zfs_w_lzo, dn);                   # (B8) a microzap growing by 512 B — or an OpenZFS-made fat one
    var lv[8];
    store64(&lv, lo);
