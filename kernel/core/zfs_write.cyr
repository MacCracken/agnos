# After every commit (zfs_commit, ZFS_WRITE_OPS): the B11 figures of txg T — its hold (µs: the plan, every write, both
# flushes, the four slots — under fs_lock), the longest stretch with no interrupt window (µs: the latency a live window
# leaves; the whole hold without them), the windows opened (0 at boot: the scheduler is not live), the frees the publish
# RELEASED (bytes) and the window's low txg after it, the deferred bytes left, and what committed it (`by=`: a policy-B
# hook — close, sync, observe, age — or the op itself); an armed knob the txg never reached prints its write map. 0.
fn zfs_wt_b11line(r) {
    if (r != 0) { return 0; }
    if (zfs_wt_cuta == 1) {
        kprint("zfs-wtest: cut txg ", 19);
        kprint_num(zfs_txg);
        kprint(" not reached: ", 14);
        zfs_wt_cutmap();
        kprintln("", 0);
        zfs_wt_cuta = 0;
    }
    kprint("zfs-wtest: txg ", 15);
    kprint_num(zfs_txg);
    kprint(" b11: hold=", 11);
    kprint_num(zfs_wc_hold);
    kprint(" irqmax=", 8);
    kprint_num(zfs_wc_imax);
    kprint(" windows=", 9);
    kprint_num(zfs_wc_iwin);
    kprint(" rel=", 5);
    kprint_num(zfs_wdef_rl);
    kprint(" lo=", 4);
    kprint_num(zfs_wdef_lo);
    kprint(" defer=", 7);
    kprint_num(zfs_w_defer);
    kprint(" by=", 4);
    var w = "op";
