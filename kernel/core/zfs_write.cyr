        var ro = zfs_fd_read(bo, buf, 64);
        var t2 = zfs_txg;
        var p2 = zfs_wp_ref;
        if (ro <= 0 || t2 != t0 || p2 == 0) { ok = 0; }
        kpayload_set(bb, 0, 1000);
        var rb = zfs_fd_read(bb, buf, 3000);
        var t3 = zfs_txg;
        zfs_gen_fill(zfs_gen_seed("b11/obs", 7), 1000, ex, 3000);
        if (rb != 3000 || t3 != t0 + 1 || zfs_wp_ref != 0 || memeq(buf, ex, 3000) != 1) { ok = 0; }
        var st[48];
        if (zfs_stat(path, strlen(path), 1, &st) != 0 || load64(&st + 16) < 4000) { ok = 0; }
        kprint("zfs-wtest: b11 observe ", 23);
        kprint(path, strlen(path));
        kprint(": write pending (txg ", 21);
        kprint_num(t1 - t0);
        kprint(" committed), a read of another file left it pending (", 53);
        kprint_num(t2 - t0);
        kprint("), a read through another fd committed it first (", 49);
        kprint_num(t3 - t0);
        kprint(") and read the new bytes: ", 26);
        if (ok == 1) {
            kprintln("ok", 2);
            r = 3000;
        } else {
            kprintln("FAIL", 4);
            zfs_wno("commit-before-observe: a reader saw the pending state, or a read committed another file's txg");
        }
    }
    if (fa >= 0) { vfs_close_inner(fa); }
    if (fo >= 0) { vfs_close_inner(fo); }
