    store64(zfs_msx(ms), (x - (ms << zfs_ms_shift)) >> zfs_ashift);
    zfs_wt_fdw("rel-released", path, 1, 262144, 1, 131072, "b11/r3", 1);
    var y3 = 0 - 1;
    if (zfs_wt_bp(path, 2, &bp) == 0) { y3 = zfs_wt_dva(&bp); }
    zfs_wt_msonly = 0;
    kprint("zfs-wtest: b11 release ", 23);
