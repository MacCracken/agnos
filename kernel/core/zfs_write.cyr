        kprint(path, strlen(path));
        kprint(": 4718592 bytes in ONE write#1 through fd X, ", 45);
        kprint_num(zfs_txg - t0);
        kprint(" txgs; ", 7);
        kprint(other, strlen(other));
        kprint(": 4096 bytes written through fd Y in the gap (pending) committed before X went on, read back: ", 94);
        if (ok == 1) {
            kprintln("ok", 2);
            r = 4718592;
        } else {
            kprintln("FAIL", 4);
            zfs_wno("a pending txg left in a multi-txg write's gap was dropped, or X ended short");
        }
        zfs_wt_obj(other);                                       # its F line: other changed in this op too
    }
    if (fx >= 0) { vfs_close_inner(fx); }
    if (fy >= 0) { vfs_close_inner(fy); }
