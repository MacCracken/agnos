    zfs_wc_chain(e);
    return 0;
}
# Every metaslab in zfs_wh_pend gets its space map's dnode into the chain: its dnode block dirtied as a new CHAIN block,
# or made one again (zfs_wh_demote) when step (1) finalised it; the meta-dnode's indirects the dirtying reached are
# chain blocks; log T's block grows when its bound (6 entries a new MOS block) needs it. The caller rebuilds the walk
# order. 0 / -1 named.
fn zfs_wh_grow() {
    var per = load16(zfs_dirty_buf(zfs_wmos_os()) + 8);
    var n0 = zfs_dx_n;
    var i = 0;
    while (i < zfs_ms_count) {
        if (zfs_wh_bit(&zfs_wh_pend, i) == 1) {
            var so = load64(zfs_msent(i));
