# === Process Abstraction ===
# Full process context for real context switching.
# Layout per process (176 bytes = 22 fields x 8 bytes):
#   0: pid       8: state     16: rsp      24: rip
#  32: rax      40: rbx       48: rcx      56: rdx
#  64: rsi      72: rdi       80: rbp      88: r8
#  96: r9      104: r10      112: r11     120: r12
# 128: r13     136: r14      144: r15     152: rflags
# 160: cr3     168: exit_code

# Process struct: documentation-only.
#
# v1.28.3 attempted to add `#derive(accessors)` but discovered cyrius's
# derive parser has a hard-coded 16-field cap (`field_names[16][32]` in
# `lex_pp.cyr`); with 22 fields the metadata-table overflow silently
# corrupts the offsets array, generating accessors at wrong byte
# offsets. Filed as a cyrius bug (see
# `cyrius/docs/development/issues/2026-05-11-derive-accessors-16-field-cap.md`)
# and **acknowledged upstream — slotted for v5.11.x repair**. When
# agnos picks up the cyrius cap-raise (passively via the pin bump),
# this struct can grow `#derive(accessors)` and consumers (proc.cyr's
# wrappers, sched.cyr's save/restore, main.cyr's exec_pid load) port
# to named accessors as a small follow-up patch.
#
# Until then: consumers use raw `load64`/`store64` at the offsets
# listed below (8 bytes per field per cyrius i64 convention).
struct Process { pid; state; rsp; rip; rax; rbx; rcx; rdx; rsi; rdi; rbp; r8; r9; r10; r11; r12; r13; r14; r15; rflags; cr3; exit_code; }

# ═══════════════ 1.57.7 (Path 2, S3.4) — PROCESS STATES (field +8) ═══════════════
# 0 dead · 1 ready · 2 running · 3 claiming · 4 DYING (reserved, the lifecycle step) · 5 STOPPED (reserved,
# the lifecycle step) · 6 BLOCKED. sched_next picks ONLY 1; do_context_switch revives only 1..3 (a proc in
# 4/5/6 left its CPU on purpose); proc_alloc_slot reuses only 0 with on_cpu == -1. BLOCKED means "left its
# CPU inside a kernel wait" (docs/architecture/blocking-waits.md): ONLY wq_wake / wq_tick / wq_interrupt
# (sched.cyr) make a BLOCKED proc READY again. Hot paths keep literals with a comment (the do_context_switch
# zone rule: no extra call in the regalloc-sensitive save/restore path).
var PROC_ST_DYING   = 4;
var PROC_ST_STOPPED = 5;
var PROC_ST_BLOCKED = 6;

var proc_table[2816];  # 16 processes x 176 bytes each
var proc_count = 0;
# First-occurrence latch for the "process table is full" refusal in proc_alloc_slot(). ⚠ Scalar, not
# an array — module-scope `var X[N]` would be N x u64 here [[cyrius-var-array-u64-units]].
var proc_full_said = 0;
# 1.46.x SMP sub-bite 2 — per-CPU "current proc pid". Was a single global `proc_current_get()`;
# under SMP each CPU runs a different proc, so it is indexed by APIC id (the tss_array
# template). Single-core FAST PATH: while cpu_count<2 (single-core, or before the APs wake) the
# accessors hit slot 0 with NO APIC read, so this is byte-for-byte the old global. Post-wake on
# multi-core (cpu_count>=2, live since the sub-bite-7 flip) the accessor does the real per-CPU APIC
# read. The old `var proc_current_get()` is REMOVED so any unconverted read fails to COMPILE (the
# review's forcing-function safety net). kpti_*/syscall-stub stay global until sub-bite 4 (the
# stub reads them via baked imm64 — they can't be arrays until it's regenerated).
var pcpu_curproc[4];     # per-CPU current-proc pid, indexed by APIC id (slot 0 = single-core)

# ── PER-CORE CPU ACCOUNTING (1.56.59, telemetry filing §8) ───────────────────────────────────────
#
# 100 Hz ticks split by the PRIVILEGE OF THE INTERRUPTED CONTEXT, per CPU. This is Linux's `%us` /
# `%sy` split and is computed the same way: the timer ISR reads the CS its hardware frame saved and
# tests the RPL. It is exact — no sampling heuristic, no scheduler cooperation.
#
# ⛔⛔ THERE IS DELIBERATELY NO `idle` COUNTER, AND THE ABSENCE IS THE HONEST ANSWER. agnos has no
# single idle loop to instrument: `arch_wait()` (a bare `hlt`) is called from a dozen polling waits —
# DHCP retry, `sleep_ms`#41's legacy loop, `kbd_read_blocking`, the NIC drain — so a CPU halted inside a blocking
# syscall is indistinguishable at the tick boundary from a CPU doing real kernel work. Both are ring 0.
# ⇒ A monitor gets user vs kernel, which is a real split; it does NOT get idle separated from system.
# Inventing an idle number here (guessing from the saved RIP, or flagging one arch_wait site and not
# the other eleven) would be a plausible-looking wrong number, and this cut already declined one of
# those. The limit is stated in the ABI row rather than papered over.
#
# ⚠ NOT gated on `pcpu_cpu()==0`, unlike `timer_ticks`. That gate exists because the wall clock is one
# global; this is PER-CORE by definition and every CPU must charge its own slot.
# ⚠ 4 slots, matching `pcpu_curproc` and the CPU-CAP invariant `pcpu_cpu()` enforces.
var cpu_user_ticks[4];   # ticks whose interrupted CS was ring 3
var cpu_kern_ticks[4];   # ticks whose interrupted CS was ring 0 (kernel work OR a halted poll wait)
fn proc_current_get() {
    if (cpu_count < 2) { return load64(&pcpu_curproc); }
    var c = tss_get_current_cpu_id();
    if (c >= 4) { c = 0; }
    return load64(&pcpu_curproc + c * 8);
}
fn proc_current_set(v) {
    if (cpu_count < 2) { store64(&pcpu_curproc, v); return 0; }
    var c = tss_get_current_cpu_id();
    if (c >= 4) { c = 0; }
    store64(&pcpu_curproc + c * 8, v);
    return 0;
}
var sched_active = 0;

# ── PER-PROCESS CPU TIME (1.56.59, telemetry filing §4) ───────────────────────────────────────────
#
# ⭐ THE FIELD A SYSTEM MONITOR EXISTS TO SHOW. chakshu's filing: "If only one gets done, §4 is the one
# that changes what a system monitor can be on AGNOS." Its CPU% column read `n/a` because nothing in
# this kernel counted a process's time anywhere.
#
# ⚠ A PARALLEL ARRAY, NOT A struct Process FIELD, AND THAT IS FORCED. `struct Process` is 22 fields x
# 8 B == the 176-byte stride `proc_table` is indexed by; every one of those fields is register state
# and there is no spare slot. Widening the struct would move the stride and silently invalidate every
# `proc_table + i * 176 + N` in the tree — and this file alone has dozens. A side array costs 128 B.
#
# ⚠ INDEXED BY SLOT, NOT BY PID, matching `proc_table`'s own convention (`proc_get_state` takes what
# it calls `pid` and indexes by it directly). Ticks accrue at the 100 Hz timer rate, so one unit is
# 10 ms — the resolution `uptime_ms`#40 already reports in, deliberately, so a consumer differencing
# two samples is doing the same arithmetic it does on Linux jiffies.
#
# ⛔ NOT RESET ON REAP. A slot is zeroed by `proc_alloc_slot` when it is handed out, which is the only
# moment the count means nothing; clearing it at exit would race a monitor sampling between exit and
# reap and hand it a live process with 0 ticks — indistinguishable from a process that just started.
var proc_ticks[16];     # per-slot 100 Hz tick count — the process's accumulated CPU time

# ⭐ 1.56.60 — IS THIS CPU PARKED IN A BLOCKING WAIT RIGHT NOW? Set around the `hlt` in arch_wait()
# (arch/x86_64/io.cyr) and read by timer_handler (arch/x86_64/pic.cyr) so a halted core does not
# charge the tick to whoever happens to be `current`.
#
# WHY: chakshu built a CPU% column on proc_ticks, measured it, and BACKED IT OUT. sleep_ms#41 halted (until
# 1.57.7, when it began to BLOCK its caller; only its legacy preempt-held path still halts like this)
# with the caller still current (preempt_disable, so do_context_switch early-returns), so a process
# blocked in a syscall accrued ticks at WALL-CLOCK rate — their monitor rendered a sleeping process
# at 100%. The quantity was "share of wall-clock ticks while this slot was current, INCLUDING
# halted", which equals CPU utilisation only for a process that never blocks. Their column head is
# shared with their Linux build where it means utime+stime, so one name meant two things.
#
# ⚠ PER-CPU, indexed by pcpu_cpu(), NOT a single global. Each core parks independently; a global
# would let one core's idle suppress another core's real work — the failure mode that looks like
# "the monitor says the box is idle while it is busy", which is the hardest kind to trace back.
# ⚠ 4 entries to match cpu_user_ticks/cpu_kern_ticks above; pcpu_cpu() already clamps >= 4 to 0.
var cpu_in_halt[4];
# ⭐ 1.57.7 (Path 2, S3.8) — IS THIS CPU A KICK TARGET? 1 = this CPU is halted (or about to halt) in the idle step
# (sched_idle_step) or a #14/#44 park (sched_halt_window) and will RE-SCAN for READY work when its hlt ends. ONLY such
# a CPU is a target of sched_kick_for's 0xE1 IPI — a kick to any other CPU could not be served (0xE1 never switches).
# Rules: written ONLY by code running ON that CPU — set to 1 by sched_idle_step / sched_halt_window at IF=0 BEFORE
# their scan (flag -> mfence -> scan -> sti;hlt, the Dekker half the waker pairs with), cleared by them after their hlt
# (or when the scan finds work), and cleared by the timer ISR on that CPU (pic.cyr: a tick ends any halt and may switch
# the halted context out; a flag left at 1 on a CPU now running another process would draw kicks it cannot serve).
# `cpu_in_halt` above stays the ACCOUNTING flag (every arch_wait sets it, including preempt-held waits that cannot take
# work); kick targeting never reads it. Shared file, x86-only readers: no aarch64 name is added.
# ⭐ 1.57.8 (ENDFIX PIPE-R1): a #44 sched_yield park publishes 2 instead of 1. sched_kick_for treats any non-zero value
# alike; sched_kick_parker (the #44 directed kick) targets ONLY 2, so an idle step or a #14 pause park is never its target.
var cpu_kickable[4];


var proc_signals[128];  # 16 processes x 8 bytes
var proc_sigmask[128];  # 16 processes x 8 bytes
# 1.44.3 (multi-threading): per-process saved CS/SS selectors so the scheduler can
# resume a proc to its REAL privilege level — ring-0 (0x08/0x10) for kmain/idle/
# kthreads, ring-3 (0x23/0x1B) for user procs — instead of proc_restore_context
# (1.56.51: the ring-3 pair was written "0x1B/0x23", inverted; proc_set_ring3 below stores
# proc_cs = 0x23 and proc_ss = 0x1B. Derivation at sched.cyr's proc_restore_context.)
# hardcoding ring-0. Parallel pid-indexed arrays (like proc_signals), NOT new
# Process-struct fields: that would push the slot past 176 B and require changing
# the `pid * 176` stride at ~16 sites. Default ring-0 so every existing proc
# round-trips byte-identically (this bite is behavior-preserving); spawn_user_proc
# will set ring-3 in a later bite. proc_save_context persists the interrupted
# proc's CS/SS here; proc_restore_context reads them back into the iretq frame.
var proc_cs[16];        # saved CS per pid (default 0x08 = ring-0 kernel code)
var proc_ss[16];        # saved SS per pid (default 0x10 = ring-0 kernel data)
# 1.50.7: parent pid per pid (default 0 = init). Filled at proc_create_user from the
# CREATOR pid (the single user-proc inheritance point, the same source vfs_fd_inherit
# uses), reset to 0 for a recycled slot in proc_alloc_slot, and read back by
# proc_get_ppid — which makes kill#16's "may only signal your children" gate REAL (it
# was inert while proc_get_ppid stubbed 0). Parallel pid-indexed array like proc_cs/
# proc_ss, NOT a Process-struct field (that would change the 176 B stride at ~16 sites).
# GUARDRAIL ([[project_agnos_auth_posture]]): signal-ownership hardening ONLY — must NOT
# grow into pgid/sid or kill(-pgid, …); process-group semantics WOULD be Unix projection.
# 1.57.7 (S7, D4): child-only AUTHORITY; descendants-only REACH via KILL_TREE (operator ruling
# 2026-09-23); still no process-group / session reach. The parent is an INCARNATION: proc_ppid_epoch.
var proc_ppid[16];      # saved parent pid per pid (default 0 = init)

# ═══════════════ 1.57.7 (S3b) — INV-FG-2: THE FOREGROUND-WAIT CELL (docs/architecture/foreground-exec.md) ═══════════════
# waiter pid -> its foreground child's pid + 1 while the waiter is in execwait#37 (sys_execwait) or kmain's
# kernel_run_child; 0 = not waiting. A PARALLEL array (the 176 B stride is frozen), scrubbed in proc_alloc_slot. Single
# writer: the waiter itself, which stores c+1 BEFORE c is READY and clears it only AFTER reaping c (S7's death chain
# will also clear a dying waiter's cell). Readers: proc_slot_reusable (under proctab_lock), S7's proc_fg_chain_kill_locked, S7's
# proc_stoppable. WHY: kmain's children carry ppid 0, which the reuse scan reads as "reaped" — without this cell a
# dead-but-unread kmain child's slot could be handed to a concurrent #43 before kmain read its exit code.
# HERE, in shared proc.cyr, because proc_alloc_slot scrubs it: an array in an x86-only file would add an aarch64
# undefined name.
var proc_fgwait[16];
fn proc_fgwait_get(w) { if (w < 0) { return 0; } if (w >= 16) { return 0; } return load64(&proc_fgwait + w * 8); }
fn proc_fgwait_set(w, v) { if (w < 0) { return 0 - 1; } if (w >= 16) { return 0 - 1; } store64(&proc_fgwait + w * 8, v); return 0; }

# ═══════════════ 1.57.7 (S7) — THE PROCESS LIFECYCLE STATE (docs/architecture/process-lifecycle.md) ═══════════════
# A parent can END (SIGKILL 9), STOP (SIGSTOP 19) and CONTINUE (SIGCONT 18) its child, and — with KILL_TREE (0x100 in
# kill#16's arg2) — every epoch-validated descendant. Parallel pid-indexed arrays (the 176 B stride is frozen), HERE in
# shared proc.cyr because proc_alloc_slot scrubs them (all five, for every slot, next to the proc_ppid scrub).
# ⛔ WRITE RULE: kill/stop pending are written under sched_spin_lock, EXCEPT proc_alloc_slot's scrub of a CLAIMING slot,
# which is program-ordered before that slot's ppid publication (so no tree-walk mark can precede it). proc_death_done is
# written under proctab+sched (the final death hold) and by the scrub. Hot-path readers (B1, the tick's fast check) read
# lock-free and re-check under the lock.
#   proc_kill_pending   0, or the signal that will END the proc (9; S8: 24). The first kill wins.
#   proc_stop_pending   0 · 1 = a direct stop · 2 = a tree stop (the only kind a newborn inherits).
#   proc_term_sig       0 = exit#0 / fault; 1..63 = the signal that ended it (feeds the wait status, D2).
#   proc_ppid_epoch     proc_epoch[ppid] at birth: (ppid, ppid_epoch) names the parent INCARNATION — a recycled parent
#                       slot does not inherit its predecessor's children (every child test is proc_is_child_of).
#   proc_death_done     1 once this incarnation's final death hold ran: its children must treat it as gone.
var SIG_KILL = 9;
var SIG_CHLD = 17;
var SIG_CONT = 18;
var SIG_STOP = 19;
var SIG_XCPU = 24;                # S8
var KILL_TREE = 0x100;            # kill#16 arg2 bit 8 (D4)
var WSTAT_SIGNALED = 0x100;       # wait status of a death by signal = 0x100 | sig (D2)
var PROC_ZOMBIE_REPORT = 7;       # #99 report-only state (an exited, unreaped child)
var VIA_NONE = 0;
var VIA_CLAIM = 1;
var VIA_TICK = 2;
var VIA_B1 = 3;
var VIA_WAIT = 4;
var VIA_SIG = 5;
var VIA_ORPHAN = 6;
var VIA_FAULT = 7;
var LT_KILL = 1;
var LT_STOP = 2;
var LT_CONT = 3;
var LT_ORPHAN = 4;
var proc_kill_pending[16];
var proc_stop_pending[16];
var proc_term_sig[16];
var proc_ppid_epoch[16];
var proc_death_done[16];
var proc_orphan_leak_seen = 0;    # the reuse tripwire (proc_slot_reusable): a dead slot with a live AS was recycled
var proc_orphan_leak_said = 0;
# Raw accessors (no bounds check — every caller has a pid in [0, 16)). They exist for IMAGE SIZE: an inline
# `load64(&arr + t * 8)` costs ~35 bytes of this compiler's code, a call ~15, and the lifecycle code makes ~120 such
# accesses (check.sh's 2 MB weighed-size gate). The per-syscall B1 check and the per-tick check keep raw loads.
fn lc_st(t) { return load64(&proc_table + t * 176 + 8); }
fn lc_st_set(t, v) { store64(&proc_table + t * 176 + 8, v); return 0; }
fn lc_kp(t) { return load64(&proc_kill_pending + t * 8); }
fn lc_sp(t) { return load64(&proc_stop_pending + t * 8); }
fn lc_sp_set(t, v) { store64(&proc_stop_pending + t * 8, v); return 0; }
fn lc_pp(t) { return load64(&proc_ppid + t * 8); }
fn lc_pep(t) { return load64(&proc_ppid_epoch + t * 8); }
fn lc_done(t) { return load64(&proc_death_done + t * 8); }

# ═══════════════ 1.57.7 (Path 2, S3.4) — THE WAIT CELLS AND THE PER-PROCESS 4TH SYSCALL ARGUMENT ═══════════════
# Parallel pid-indexed arrays (the 176 B struct stride is frozen), scrubbed in proc_alloc_slot. HERE, in shared
# proc.cyr, because proc_alloc_slot scrubs them and vfs.cyr (shared) names WK_FLOCK: arrays in an x86-only file
# would add aarch64 undefined names.
#   proc_wait_key       WK_* | object; 0 = not waiting. Written under sched_lock only (wq_arm / wq_wake / wq_tick).
#   proc_wait_deadline  sched_clock_us deadline, 0 = none. WQ-DL: != 0 => state 6; wq_tick's rescan self-heals a
#                       stale one (a remote retire, a death path, this scrub) — it never has to be kept exact.
#   proc_wake_reason    WR_* set by the waker, read and cleared by the sleeper.
#   proc_sc_a4          the 4th syscall argument, PER PROCESS (was pcpu_ksyscall_a4 — a per-CPU cell): it must
#                       survive a syscall that blocks and resumes on another CPU, and another process's syscall
#                       on this CPU must not overwrite it meanwhile. syscall_handler stores it at entry.
var proc_wait_key[16];
var proc_wait_deadline[16];
var proc_wake_reason[16];
var proc_sc_a4[16];

# Wait keys (the high byte names the class, the low bits the object) and wake reasons. Module-scope literals.
var WK_SLEEP = 0x0100000000000000;
var WK_FLOCK = 0x0200000000000000;
var WK_CHILD = 0x0300000000000000;
var WK_KBD = 0x0400000000000000;
var WK_KBD_OWNER = 0x0500000000000000;
var WK_SND = 0x0600000000000000;
var WK_TCP = 0x0700000000000000;
var WK_ICMP = 0x0800000000000000;
var WK_PIPE = 0x0900000000000000;       # 1.57.8: | the pipe buffer (pipe_key, vfs.cyr) — a blocking pipe read#5
var WK_CHAN = 0x0A00000000000000;       # 1.57.8: | the reading endpoint — a blocking channel read#5
var WK_TEST = 0x7F00000000000000;
var WR_NONE = 0;
var WR_EVENT = 1;
var WR_TIMEOUT = 2;
var WR_SIGNAL = 3;

# The 4th syscall argument of `pid`'s current syscall. store: syscall_handler (the entry, with the pid it already
# holds — no second LAPIC read) and in-kernel callers that stage an a4 before ksyscall (main.cyr/selftests.cyr,
# through ksyscall_a4_set, which names the CALLER's own slot). A bad pid stores nothing and reads 0.
# ⚠ In-kernel staging is still REQUIRED: ksyscall reads the current process's cell, so a caller that does not
# set it passes whatever its own previous syscall left there.
fn ksyscall_a4_store(pid, v) {
    if (pid < 0) { return 0; }
    if (pid >= 16) { return 0; }
    store64(&proc_sc_a4 + pid * 8, v);
    return 0;
}
fn ksyscall_a4_set(v) { return ksyscall_a4_store(proc_current_get(), v); }
fn ksyscall_a4_get() {
    var a4_p = proc_current_get();
    if (a4_p < 0) { return 0; }
    if (a4_p >= 16) { return 0; }
    return load64(&proc_sc_a4 + a4_p * 8);
}

# ── 1.57.6 — PER-PROCESS SPAWN ARMS (issue 2026-09-23-child-inherits-every-fd-and-spawn-arms-leak §3) ──
#
# The one-shot arms a process sets up for its NEXT child: the `exec_redirect`#62 redirect set (up to
# SPAWN_REDIR_MAX pairs) and the `chan_op`#97 CH_ENDOW endowment (endpoint, announced fd, PTY flag, the
# channel epoch seen at arm time) — plus the fd its latest child's endowment landed on.
# ⛔⛔ THESE WERE PER-CPU UNTIL 1.57.6, AND PER-CPU LEAKED ACROSS PROCESSES ON THE *SUCCESS* PATH. An arm
# spans TWO syscalls issued from preemptible IF=1 ring-3 code: arm, then spawn. Between them the arming
# process can be preempted (or migrated to an AP, smp_sched_aps=1), and whatever next created a child on
# that CPU — an agnsh `&` job, a compositor's client spawn — consumed the arm: its child got the redirected
# stdout, or was born OWNING an endpoint nobody endowed it with. Clearing on failure paths alone could not
# fix that; keying by the ARMING pid makes cross-process consumption structurally impossible.
# ⚠ NO LOCK, deliberately. A pid's cells are written only by (a) that process's own syscalls — a process
# runs on one CPU at a time; (b) chan_place_into_child inside that same process's own spawn; (c)
# proc_alloc_slot while the slot is dead. Nothing else names another process's cells.
# ⚠ HERE, IN proc.cyr, NOT syscall.cyr: proc_alloc_slot (shared by both architectures) resets them, and a
# helper defined only in the x86-only syscall.cyr would add an undefined name to the aarch64 build.
# ⚠ Every accessor bounds-checks pid: a bad pid reads as "nothing armed" and writes nothing.
var SPAWN_REDIR_MAX = 4;
var proc_redir_n[16];       # armed redirect pairs per pid (0..SPAWN_REDIR_MAX)
var proc_redir_src[64];     # [pid*4 + i] the CHILD fd that gets repointed
var proc_redir_dst[64];     # [pid*4 + i] the fd whose entry it receives — read from the CHILD's table AT APPLY
var proc_endow_end[16];     # armed endpoint + 1; 0 = unarmed (zero-init must mean "nothing armed")
var proc_endow_fd[16];      # the child fd announced by CH_ENDOW (decided at arm time)
var proc_endow_stdio[16];   # 1 = PTY mode: the endpoint also lands on the child's fd 0/1/2
var proc_endow_epoch[16];   # chan_epoch[e >> 1] at CH_ENDOW — placement refuses a re-minted channel
var proc_endow_placed[16];  # fd + 1 of the endowment placed into this creator's LATEST child; 0 = none

fn spawn_pid_ok(pid) {
    if (pid < 0) { return 0; }
    if (pid >= 16) { return 0; }
    return 1;
}
fn redir_n_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    return load64(&proc_redir_n + pid * 8);
}
fn redir_src_get(pid, i) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    if (i < 0) { return 0 - 1; }
    if (i >= SPAWN_REDIR_MAX) { return 0 - 1; }
    return load64(&proc_redir_src + (pid * 4 + i) * 8);
}
fn redir_dst_get(pid, i) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    if (i < 0) { return 0 - 1; }
    if (i >= SPAWN_REDIR_MAX) { return 0 - 1; }
    return load64(&proc_redir_dst + (pid * 4 + i) * 8);
}
fn redir_clear(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    store64(&proc_redir_n + pid * 8, 0);
    var rci = 0;
    while (rci < SPAWN_REDIR_MAX) {
        store64(&proc_redir_src + (pid * 4 + rci) * 8, 0);
        store64(&proc_redir_dst + (pid * 4 + rci) * 8, 0);
        rci = rci + 1;
    }
    return 0;
}
# Is `f` the src of one of `pid`'s armed redirects? -> 1 / 0.
fn redir_is_src(pid, f) {
    var rn = redir_n_get(pid);
    var ri = 0;
    while (ri < rn) {
        if (redir_src_get(pid, ri) == f) { return 1; }
        ri = ri + 1;
    }
    return 0;
}
# #62 op 0 — REPLACE the whole set with this one pair (the pre-1.57.6 single-slot semantics exactly).
fn redir_arm_replace(pid, s, d) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    redir_clear(pid);
    store64(&proc_redir_src + (pid * 4) * 8, s);
    store64(&proc_redir_dst + (pid * 4) * 8, d);
    store64(&proc_redir_n + pid * 8, 1);
    return 0;
}
# #62 op 1 (REDIR_ADD) — append, or replace the dst of an already-armed src in place. -1 when the set is
# full, or when `s` is the child fd this process's ARMED endowment will land on.
# ⚠ `endow_arm_get(pid) >= 0` FIRST: proc_endow_fd outlives a consumed arm, and a stale fd number must
# not refuse a legitimate ADD.
fn redir_arm_add(pid, s, d) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    if (endow_arm_get(pid) >= 0) {
        if (endow_fd_get(pid) == s) { return 0 - 1; }
    }
    var an = redir_n_get(pid);
    var ai = 0;
    while (ai < an) {
        if (redir_src_get(pid, ai) == s) {
            store64(&proc_redir_dst + (pid * 4 + ai) * 8, d);
            return 0;
        }
        ai = ai + 1;
    }
    if (an >= SPAWN_REDIR_MAX) { return 0 - 1; }
    store64(&proc_redir_src + (pid * 4 + an) * 8, s);
    store64(&proc_redir_dst + (pid * 4 + an) * 8, d);
    store64(&proc_redir_n + pid * 8, an + 1);
    return 0;
}
fn endow_arm_set(pid, e) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    store64(&proc_endow_end + pid * 8, e + 1);
    return 0;
}
fn endow_arm_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    return load64(&proc_endow_end + pid * 8) - 1;
}
fn endow_fd_set(pid, f) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    store64(&proc_endow_fd + pid * 8, f);
    return 0;
}
fn endow_fd_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    return load64(&proc_endow_fd + pid * 8);
}
fn endow_stdio_set(pid, v) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    store64(&proc_endow_stdio + pid * 8, v);
    return 0;
}
fn endow_stdio_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    return load64(&proc_endow_stdio + pid * 8);
}
fn endow_epoch_set(pid, v) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    store64(&proc_endow_epoch + pid * 8, v);
    return 0;
}
fn endow_epoch_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    return load64(&proc_endow_epoch + pid * 8);
}
fn endow_placed_set(pid, v) {
    if (spawn_pid_ok(pid) == 0) { return 0 - 1; }
    store64(&proc_endow_placed + pid * 8, v);
    return 0;
}
fn endow_placed_get(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    return load64(&proc_endow_placed + pid * 8);
}
# Disarm the endowment AND its PTY flag together — a stale PTY flag would turn the next unrelated
# endowment's placement into a terminal (the hazard chan_place_into_child's comment names).
fn endow_disarm(pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    store64(&proc_endow_end + pid * 8, 0);
    store64(&proc_endow_fd + pid * 8, 0);
    store64(&proc_endow_stdio + pid * 8, 0);
    store64(&proc_endow_epoch + pid * 8, 0);
    return 0;
}
fn spawn_arms_reset(pid) {
    redir_clear(pid);
    endow_disarm(pid);
    endow_placed_set(pid, 0);
    return 0;
}
# What every #43 / #37 exit calls for the CALLER: the whole arm state is spent by that call, success or
# refusal. Same cells as the slot-recycle reset; a separate name so the two intents read apart.
fn spawn_arms_clear(pid) { return spawn_arms_reset(pid); }
# Proc-table bootstrap (main.cyr): proc_alloc_slot skips the CALLER's own slot (see there), so pid 0's
# boot-context arms would otherwise survive into kybernet's runtime pid 0.
fn spawn_arms_reset_all() {
    var ra = 0;
    while (ra < 16) {
        spawn_arms_reset(ra);
        lim_arm_clear(ra);    # 1.57.7 (S8): a separate call — spawn_arms_clear aliases spawn_arms_reset
        ra = ra + 1;
    }
    return 0;
}

# ⭐ 1.57.7 (S8) — PER-PROCESS RESOURCE LIMITS (spawn_limits#107; process-lifecycle.md "Resource limits").
# CAPS are the proc's own effective limits, placed at birth (proc_create_user: the creator's lim_eff) or copied by
# fork; 0 = none. ARMS are the caller's one-shot limits for its NEXT child, set by #107 and consumed at the ONE site
# in syscall_handler after every #3/#37/#43 return. No lock, the S2 arm argument: a pid's ARM cells are written by
# its own #107, its own syscall exit, proc_alloc_slot (slot dead) and the death chain; CAP + cursor cells only while
# the slot is CLAIMING (alloc, proc_create_user, sys_fork). Readers: the owner's syscalls and the tick head on the
# owner's CPU. The 176 B struct Process stride is frozen, hence parallel arrays (module-scope [16] = 16 u64).
var proc_mem_cap[16];       # effective memory cap, 4 KiB pages (#99's RSS unit), enforced at 2 MB granularity
var proc_cpu_cap[16];       # effective CPU cap, 100 Hz ticks (charged in timer_handler, compared by lim_cpu_tick_head)
var proc_arm_mem[16];       # #107 a1 for the caller's next child, pages; 0 = no memory arm
var proc_arm_cpu[16];       # #107 ceil(a2 / 10) ticks; 0 = no CPU arm
# 1.50.4 per-pid high-arena cursor (0 = uninit -> the floor). DECLARED HERE, in the shared region, since 1.57.7 (S8):
# proc_alloc_slot scrubs it (a recycled slot starts at the floor) and sys_fork copies it (himmap_cursor_copy); an
# x86-only declaration would add an undefined name to the aarch64 build. The users (himmap_reserve, sys_mmap,
# sys_munmap) stay in the x86 block.
var proc_himmap_next[16];

# An arm can only LOWER: arm == 0 -> own; own == 0 -> arm; else min.
fn lim_eff(own, arm) {
    if (arm == 0) { return own; }
    if (own == 0) { return arm; }
    if (arm < own) { return arm; }
    return own;
}
fn lim_cell(base, pid) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    return load64(base + pid * 8);
}
fn lim_child_mem(c) { return lim_eff(lim_cell(&proc_mem_cap, c), lim_cell(&proc_arm_mem, c)); }
fn lim_child_cpu(c) { return lim_eff(lim_cell(&proc_cpu_cap, c), lim_cell(&proc_arm_cpu, c)); }
fn lim_arm_set(pid, mem_pages, cpu_ticks) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    store64(&proc_arm_mem + pid * 8, mem_pages);
    store64(&proc_arm_cpu + pid * 8, cpu_ticks);
    return 0;
}
fn lim_arm_clear(pid) { return lim_arm_set(pid, 0, 0); }
fn lim_caps_set(pid, mem, cpu) {
    if (spawn_pid_ok(pid) == 0) { return 0; }
    store64(&proc_mem_cap + pid * 8, mem);
    store64(&proc_cpu_cap + pid * 8, cpu);
    return 0;
}
# fork: the CAPS only, never the arm (the child's arm was reset by proc_alloc_slot).
fn lim_copy(child, parent) { return lim_caps_set(child, lim_cell(&proc_mem_cap, parent), lim_cell(&proc_cpu_cap, parent)); }
# fork: the child continues the parent's high-arena cursor — its copied high pages sit below it (a fresh cursor
# would start at the floor, on those copies).
fn himmap_cursor_copy(child, parent) {
    if (spawn_pid_ok(child) == 0) { return 0; }
    store64(&proc_himmap_next + child * 8, lim_cell(&proc_himmap_next, parent));
    return 0;
}

# 1.56.47 — PER-PROCESS NAME, so a monitor can render a process TABLE and not just
# a count. Nothing in the kernel recorded a name before this: `struct Process` is
# pure register state and `proc_create_user(entry, stack_top)` never saw a path, so
# the only identity a ring-3 process had was its pid. chakshu's AGNOS build could
# therefore enumerate nothing and rendered a bare column header — the gap that
# blocked its v1.0 "AGNOS default monitor" milestone.
#
# ⚠ SIZING, and it is the trap this file already documents twice: module-scope
# `var X[N]` is N x u64 = N*8 BYTES [[cyrius-var-array-u64-units]]. 16 procs x
# 32 bytes = 512 bytes, so the declaration is [64], NOT [512]. Indexed by SLOT
# (pid), byte offset pid*PROC_NAME_MAX.
var PROC_NAME_MAX = 32;
var proc_names[64];     # 16 processes x 32 bytes, NUL-terminated

# Record the basename of `path` for `pid`. Basename, not the full path: the table
# column is narrow and "/bin/shu" tells a reader nothing "shu" does not. Truncates
# at PROC_NAME_MAX-1 and always NUL-terminates.
fn proc_set_name(pid, path, pathlen) {
    if (pid < 0) { return 0 - 1; }
    if (pid >= 16) { return 0 - 1; }
    var base = &proc_names + pid * PROC_NAME_MAX;
    # Walk to the last '/' so "/bin/agnsh" stores "agnsh".
    var st = 0;
    var i = 0;
    while (i < pathlen) {
        if (load8(path + i) == 47) { st = i + 1; }
        i = i + 1;
    }
    var n = pathlen - st;
    if (n > PROC_NAME_MAX - 1) { n = PROC_NAME_MAX - 1; }
    if (n < 0) { n = 0; }
    var k = 0;
    while (k < n) {
        store8(base + k, load8(path + st + k));
        k = k + 1;
    }
    store8(base + n, 0);
    return n;
}

# Pointer to pid's NUL-terminated name, or 0 when the pid is out of range.
fn proc_name_ptr(pid) {
    if (pid < 0) { return 0; }
    if (pid >= 16) { return 0; }
    return &proc_names + pid * PROC_NAME_MAX;
}

# Clear a slot's name when it is reused, so a dead process's name can never be
# read back against a live pid that happens to land on the same slot.
fn proc_clear_name(pid) {
    var b = proc_name_ptr(pid);
    if (b == 0) { return 0; }
    store8(b, 0);
    return 0;
}

# 1.56.40 (channel-band bite 2) — THE PROCESS GENERATION COUNTER. Written here, read by NOTHING yet.
#
# ⛔ A pid IS NOT A DURABLE IDENTITY on agnos. pids are recycled slot indices with no generation
# counter: `proc_alloc_slot` reuses the first dead slot, so "pid 4" after a death is a DIFFERENT
# process that any stale record still names correctly. Every ownership claim in the kernel inherits
# that hole — shm's owner field (bite 1) included.
#
# `proc_epoch[pid]` is bumped every time a slot is handed out, so the pair (pid, epoch) identifies a
# process INCARNATION rather than a table row. A holder that stamps both can tell "my peer" from
# "whoever got that slot next", which is what makes an inherited handle inert by construction at
# bite 4 rather than merely unlikely to collide.
#
# ⛔ DELIBERATELY UNREAD IN THIS BITE. Landing the write first means the counter is already correct and
# already exercised across a full boot before anything gates on it — so if bite 4's authority check
# ever refuses wrongly, the epoch is not one of the suspects. Never wraps in any real uptime.
var proc_epoch[16];     # per-slot generation; (pid, epoch) = a process incarnation
fn proc_epoch_get(pid) { return load64(&proc_epoch + pid * 8); }
# 1.46.x SMP sub-bite 6: per-pid "which CPU is running / mid-switching this proc"; -1 = none.
# The scheduler FENCE — on_cpu_set(new, mycpu) is the LAST mutation under sched_lock, then the
# lock releases and the lock-free restore proceeds with `new` claimed. sched_next selects only
# procs with on_cpu==-1 (both passes), so a proc owned by another CPU is never double-picked.
# Parallel pid-indexed array (like proc_cs/proc_ss), NOT a Process-struct field (the 176B/22-
# field stride is frozen — proc.cyr:55-65). Default MUST be -1 (0 is a valid CPU id), so
# proc_on_cpu_init sets all 16 at boot BEFORE sched_active=1; proc_alloc_slot resets a recycled
# slot to -1. INERT single-core: pcpu_cpu()==0, only the running proc (state==2, already
# excluded by the state gate) ever carries on_cpu!=-1 → sched_next byte-identical (INV-10).
var proc_on_cpu[16];
fn on_cpu_get(pid) { return load64(&proc_on_cpu + pid * 8); }
fn on_cpu_set(pid, c) { store64(&proc_on_cpu + pid * 8, c); return 0; }
# GAP-C (1.46.x SMP sub-bite 7): reap-vs-restore fence. A reaper must NOT free a proc's
# address space while another CPU is mid proc_restore_context on it (or still running it on
# its own CR3) — that would fault the foreign CPU. Callers set state 0 FIRST (so sched_next
# can no longer PICK it), then call this to wait out any IN-FLIGHT restore that already
# passed the state gate: spin until on_cpu clears. Must be called AFTER proc_set_state(pid,0)
# and BEFORE proc_free_address_space.
# ⭐ 1.57.6 (Path 2, S3.1) — INV-11: the owning CPU clears on_cpu ONLY in its switch tail
# (sched.cyr sched_frame_iretq), after its RSP has left this proc's kernel stack and after it has
# loaded the next proc's CR3 — no longer under sched_lock in do_context_switch, where it used to be
# published while that CPU was still popping the ISR frame off this proc's stack. So a -1 read here
# now means "nobody is on the stack AND nobody has the CR3": the fence got strictly stronger, and a
# spin here is the few instructions of that tail.
#
# 1.50.9 SELF-OWNED FAST PATH (deadlock fix): a proc that terminates via kernel_resume — a ring-3
# FAULT (fault_kill_current) or exit#0 on the FOREGROUND exec child — leaves the CPU WITHOUT going
# through do_context_switch, so its on_cpu is NEVER cleared and still points at the CURRENT CPU. Under
# exec_preempt=1 (preemptive agnsh, init.cyr) that child WAS scheduled by do_context_switch, so on_cpu
# was set — and the old unconditional spin then waited forever for a deschedule that can't happen
# (we ARE the owner, spinning here IF=0, single core → hard hang right after the agnsh banner — the
# 1.46.x fence regression that turned an agnsh fault/exit into a frozen box). If THIS CPU owns the
# (now-dead) proc, there is no FOREIGN in-flight restore to wait out — clear on_cpu and proceed. A
# DIFFERENT CPU's ownership still spins (the real SMP race the fence guards). Single-core: pcpu_cpu()==0
# always equals the self-owned case, so the loop never iterates.
fn proc_reap_off_cpu_fence(pid) {
    if (on_cpu_get(pid) == pcpu_cpu()) { on_cpu_set(pid, 0 - 1); }   # self-owned (kernel_resume exit/fault) → no foreign restore
    while (on_cpu_get(pid) != 0 - 1) { asm { 0xF3; 0x90; } }   # pause; spin until a FOREIGN owner deschedules
    return 0;
}
# 1.46.x SMP sub-bite 6b: PERSISTENT per-pid idle-owner CPU (-1 = not an idle). UNLIKE
# proc_on_cpu (cleared to -1 on every deschedule), idle_owner is NEVER cleared on deschedule —
# so a descheduled AP idle (state==1, on_cpu==-1) is STILL excluded from a FOREIGN CPU's
# sched_next (the pcpu_idle skip only deprioritizes the CALLING CPU's idle). Set in ap_entry
# when an AP registers its idle kthread; -1 for every non-idle proc. Single-core: no AP wakes, so
# nothing sets a non-(-1) value and the skip is a no-op. Multi-core (smp_wake_enabled=1, live since
# the sub-bite-7 flip): each woken AP sets its idle's owner here and the skip becomes load-bearing.
var idle_owner[16];
fn idle_owner_get(pid) { return load64(&idle_owner + pid * 8); }
fn idle_owner_set(pid, c) { store64(&idle_owner + pid * 8, c); return 0; }
fn proc_on_cpu_init() { var i = 0; while (i < 16) { store64(&proc_on_cpu + i * 8, 0 - 1); store64(&idle_owner + i * 8, 0 - 1); i = i + 1; } return 0; }
# 1.46.1 (per-process kernel stacks): each proc's own TSS.RSP0 — the kernel stack
# the CPU switches to on a CPL3->CPL0 interrupt. Foundation for IF=1 preemptive
# agnsh (LIVE since 1.44.14, exec_preempt=1): a preempted ring-3 proc takes its
# timer tick on ITS OWN stack instead of the shared 0x3C0000, so two procs never
# grow down one interrupt stack. RSP0 is consumed on a CPL3->CPL0 preemption. (Until
# 1.57.6 the deep syscall path stayed on a SHARED per-CPU syscall kstack and only this
# shallow interrupt stack was per-proc; since Path 2 step S3.3 the syscalls run here too —
# see KSTACK_SLOT below and docs/architecture/kernel-stacks-and-preemption.md.)
# Pool PHYS = region 7 (14-16MB), reserved in pmm_init. **1.51.x: RSP0 points at the
# region-7 phys via its DIRECT-MAP alias (DIRECTMAP_BASE + phys, 8 GB+), NOT its low
# identity VA.** The identity VA (14-16MB) sits INSIDE the user-segment range — elf_load
# maps PT_LOADs up to 256 MB, and proc_map_page OVERRIDES the per-proc PD entries it
# covers — so a large binary (e.g. ark's ~16 MB image, segment to ~20 MB) clobbered PD[7]
# in its own CR3 and the next CPL3->CPL0 interrupt #PF'd on the vanished stack -> #DF ->
# triple fault (the "ark won't run" bug). The direct-map (PDPT[8..directmap_pdpt_top], mirrored into every
# per-proc CR3, vmm.cyr pmm_setup_directmap) is at 8 GB+, far above ANY user VA (segments
# <=256 MB, mmap/stack <=~1 GB), and is NEVER overridden by a user segment, so RSP0 is
# always reachable. The phys stays reserved in region 7; only the VA the CPU loads moves up.
var proc_rsp0[16];      # per-pid TSS.RSP0 top (0 = unassigned -> 0x3C0000 fallback)
var KSTACK_POOL_BASE = 0xE00000;   # region 7 PHYS base (14 MB) — RSP0 = DIRECTMAP_BASE + this
var KSTACK_SLOT = 0x10000;         # 64 KB per proc; the lowest 4 KB is a not-present GUARD page (vmm.cyr)
# ⭐ 1.57.6 (Path 2, S3.3): this slot is THE process's kernel stack now — its SYSCALLs run here as well as its
# CPL3 interrupts (kstack_install, syscall_hw.cyr), and a syscall switched out mid-flight keeps its frames
# here while it waits. 60 KB usable (the largest single kernel frame is ~5 KB).
# KSTACK_HW (1.57.6 S3-fix; implied by KSTACK_SELFTEST — scripts/build.sh) paints [base + 4 KB, top - 256) with 0x6B
# when the slot is handed out, so a smoke can report how deep a stack went (a LOWER bound: a frame that never
# writes its low locals leaves paint under it). Skipped in a KEEP_GNOBOOT build (no direct map there).
# ⭐ S3-fix — MEASURE THE REAL SYSCALL PATHS, NOT ONLY THE PROBES. The budget went from 64 KB with no guard (the old
# per-CPU stacks) to 60 KB with one, and until this pass only KSTACK_SELFTEST's four ~1 KB probes were ever
# measured. Under KSTACK_HW every reap (both doors, after the off-CPU fence) and every slot hand-out scans ALL
# painted slots and prints one COM1 line whenever the high-water mark grows:
#   kstack-hw: max=0x... of 0xf000 usable, slot=N name=<the slot's process name>
# so any workload (spawn-smoke, exec-smoke, agnsh-smoke, ...) run on a KSTACK_HW kernel reports its deepest
# syscall + interrupt nest against the 60 KB budget. Lock-free (serial only), because a reap can run anywhere.
#ifdef KSTACK_HW
var kstack_painted[16];      # 1 = the slot was painted at its last hand-out (only painted slots are scanned)
var kstack_hw_max = 0;
#ifndef BOOTCR3_KEEP_GNOBOOT_CR3
fn kstack_paint(idx) {
    memset(DIRECTMAP_BASE + KSTACK_POOL_BASE + idx * KSTACK_SLOT + 4096, 0x6B, KSTACK_SLOT - 4096 - 256);
    store64(&kstack_painted + idx * 8, 1);
    return 0;
}
#endif
#ifdef BOOTCR3_KEEP_GNOBOOT_CR3
fn kstack_paint(idx) { return 0; }
#endif
# Depth of slot idx's stack: the first qword from the bottom that is no longer paint bounds the use.
fn kstack_hw_of(idx) {
    var khb = DIRECTMAP_BASE + KSTACK_POOL_BASE + idx * KSTACK_SLOT;
    var kht = khb + KSTACK_SLOT;
    var kha = khb + 4096;
    while (kha < kht - 256) {
        if (load64(kha) != 0x6B6B6B6B6B6B6B6B) { return kht - kha; }
        kha = kha + 8;
    }
    return 0;
}
fn kstack_hw_scan() {
    var khs_i = 0;
    var khs_best = 0;
    var khs_slot = 0;
    while (khs_i < 16) {
        if (load64(&kstack_painted + khs_i * 8) == 1) {
            var khs_d = kstack_hw_of(khs_i);
            if (khs_d > khs_best) { khs_best = khs_d; khs_slot = khs_i; }
        }
        khs_i = khs_i + 1;
    }
    if (khs_best <= kstack_hw_max) { return 0; }
    kstack_hw_max = khs_best;
    serial_print("kstack-hw: max=", 15);
    exc_serial_hex(khs_best);
    serial_print(" of 0xf000 usable, slot=", 24);
    exc_serial_hex(khs_slot);
    serial_print(" name=", 6);
    var khs_n = proc_name_ptr(khs_slot);
    var khs_k = 0;
    if (khs_n != 0) {
        while (khs_k < 32) {
            var khs_c = load8(khs_n + khs_k);
            if (khs_c == 0) { khs_k = 32; } else { serial_putc(khs_c); khs_k = khs_k + 1; }
        }
    }
    serial_putc(13); serial_putc(10);
    return 0;
}
#endif
#ifndef KSTACK_HW
fn kstack_paint(idx) { return 0; }
fn kstack_hw_scan() { return 0; }
#endif

# === 1.53.x FP/SIMD arc (B2) — per-proc FP (FXSAVE) state + per-CPU FP owner ===
# Each proc gets a 512-byte FXSAVE area (x87 + XMM + MXCSR) for the lazy #NM
# save/restore B3 installs. A SEPARATE module-global sibling array — never the
# 176-byte proc slot (the proc_cs/proc_ss/proc_rsp0 precedent) — because FXSAVE
# needs 16-byte alignment and the slot stride is 176. Module-global `var X[N]` is
# N*u64, so [1026] = 8208 B = 16 procs * 512 + 16 align slop. fpu_area(pid) 16-aligns
# the base (512 is a multiple of 16, so every per-pid slot stays aligned).
var fpu_state[1026];
# Per-CPU (NOT per-pid) live-FP owner: fpu_owner[cpu] = the pid whose XMM is live on
# that core, -1 = kernel/none. Per-CPU like pcpu_curproc — a single global would
# corrupt XMM across cores once APs run real procs. B3 maintains it; B2 seeds it -1.
var fpu_owner[4];
fn fpu_area(pid): i64 {
    var base = (&fpu_state + 15) & (0 - 16);   # 16-align the array base up
    return base + pid * 512;
}
# Seed a proc's FXSAVE area with the fninit-equivalent default: zeroed, FCW=0x037F
# (x87 control word), MXCSR=0x1F80 (all six SSE exceptions masked). HAND-BUILT via
# plain stores — NO fxsave — so the production kernel stays FP-free through B2 (the
# first real fxsave/fxrstor arrive with the #NM handler in B3). FXRSTOR-legal (MXCSR
# valid under any MXCSR_MASK; reserved header/area zeroed); B4's first-FXRSTOR test
# is the confirmation. Also reused by proc_alloc_slot to reset a recycled slot.
fn fpu_area_reset(pid): i64 {
    var area = fpu_area(pid);
    var i = 0;
    while (i < 512) { store64(area + i, 0); i = i + 8; }
    store32(area, 0x037F);        # offset 0:  FCW=0x037F, FSW=0
    store32(area + 24, 0x1F80);   # offset 24: MXCSR default (0x18)
    return 0;
}
# Boot-time init (called once from main.cyr after fpu_enable): seed all 16 areas +
# set every per-CPU FP owner to -1 (none). Pure memory init — no FP instruction.
fn fpu_area_init(): i64 {
    var pid = 0;
    while (pid < 16) { fpu_area_reset(pid); pid = pid + 1; }
    var c = 0;
    while (c < 4) { store64(&fpu_owner + c * 8, 0 - 1); c = c + 1; }
    return 0;
}
#ifdef FP_AREA_SELFTEST
# B2 proof: every pid's FXSAVE area is 16-aligned and carries the default FCW+MXCSR.
fn fpu_area_selftest(): i64 {
    var ok = 1;
    var pid = 0;
    while (pid < 16) {
        var area = fpu_area(pid);
        if ((area & 15) != 0) { ok = 0; }               # 16-byte aligned
        if (load32(area + 24) != 0x1F80) { ok = 0; }    # default MXCSR
        if (load32(area) != 0x037F) { ok = 0; }         # default FCW (low 16, FSW=0)
        pid = pid + 1;
    }
    if (ok == 1) { kprintln("fp: area OK", 11); } else { kprintln("fp: area FAIL", 13); }
    return 0;
}
#endif

var pending_signal_flag = 0;  # Set by scheduler ISR, read by main — benign race (atomic store on x86_64)

# === 1.44.x multi-threading (opening) — preempt gate ===
# `preempt_count > 0` makes the timer's do_context_switch a no-op (sched.cyr), so
# a critical section that touches shared scratch buffers / non-reentrant FS state
# can wrap itself in preempt_disable()/preempt_enable() and stay atomic w.r.t.
# preemption. This is the "reentrant-or-gated" foundation the cooperative →
# preemptive transition needs — the single-core no-lock invariant the FS code
# relies on ([[project_multithreading_future_arc]]). It generalizes the ad-hoc
# "the timer handler's do_context_switch early-returns while a syscall runs" guard
# in syscall.cyr into one counted, nestable primitive. Plain i64 (single-core:
# no atomic needed yet; SMP later makes it a per-CPU/atomic field).
# 1.46.x SMP sub-bite 2: per-CPU preempt-disable nesting count (was a single global).
# Each CPU has its own count — a preempt_disable on CPU N must not gate CPU M's switch.
# cpu_count<2 fast path = slot 0, no APIC read -> byte-for-byte the old global single-core.
var pcpu_preempt[4];
fn preempt_cpu_slot() {
    if (cpu_count < 2) { return &pcpu_preempt; }
    var c = tss_get_current_cpu_id();
    if (c >= 4) { c = 0; }
    return &pcpu_preempt + c * 8;
}
fn preempt_count_get() { return load64(preempt_cpu_slot()); }
# ⛔ 1.57.6 (Path 2, S3-finish) — THE INCREMENT IS IRQ-SAVED. preempt_disable is the one call that runs at
# count 0, i.e. while its caller is still PREEMPTIBLE, and it is a read-modify-write of a slot picked by
# THIS CPU's id. Since S3.2 every plain spinlock calls it, and since S3.1/S3.3 a preempted context may
# resume on ANOTHER CPU (an unpinned kthread, a switched-out syscall). A tick landing between
# preempt_cpu_slot() and the store would migrate the caller mid-RMW: the +1 lands in the OLD CPU's slot
# (that CPU is then non-preemptible for good) and the caller holds its lock on the new CPU at count 0 —
# preemptible while holding it, the exact deadlock class S3.2 closes. Masking IF for the three statements
# makes the RMW atomic with respect to the only thing that can move it (the local timer). Latent in
# 1.57.6 — kmain is BSP-pinned and the THREAD_SELFTEST kthreads take no lock — closed before S3.4's
# blocking waits make IF=1 CPL0 contexts routine. preempt_enable needs no mask: it runs at count >= 1,
# where no switch can happen before its store. kbd_irq_save/restore (keyboard.cyr; no-op stubs on
# aarch64) restore the caller's IF exactly.
fn preempt_disable() { var pf = kbd_irq_save(); var s = preempt_cpu_slot(); store64(s, load64(s) + 1); kbd_irq_restore(pf); return 0; }
fn preempt_enable() { var s = preempt_cpu_slot(); var v = load64(s); if (v > 0) { store64(s, v - 1); } return 0; }
fn preempt_enabled() { if (load64(preempt_cpu_slot()) == 0) { return 1; } return 0; }

# Allocate a proc_table slot. NON-LIFO (1.44.x): REUSE the first dead (state==0) slot in
# [0,proc_count) THAT IS NOT STILL AN UNREAPED CHILD (1.56.55 — see the ppid guard in the scan
# below; a dead slot may be a zombie holding an exit status its parent has not collected yet)
# so an out-of-order background-job reap does not leak its slot; else APPEND
# at proc_count (cap 16). Returns the slot index, or -1 if the table is full. CLEARS the
# pid-indexed signal arrays (proc_signals/proc_sigmask) for the slot so a RECYCLED slot does
# not inherit the prior occupant's pending signals or mask — the create paths reset
# proc_cs/proc_ss but NOT these two, which were never cleared (latent under the old LIFO-only
# reclaim, live under reuse).
#   INVARIANT: scan+reuse is atomic w.r.t. the scheduler on the single-core no-preempt model
#   (do_context_switch no-ops while preempt_count>0; the reap paths run IF=0 in-handler / under
#   boot CR3). The multi-threading/SMP arc ([[project_multithreading_future_arc]]) must add a
#   lock or per-CPU free-list here.
#   PID-RECYCLE: a pid IS a slot index, so a reused slot RECYCLES that pid. This used to read
#   "safe today because reuse only follows a reap done BY the reaper (waitpid#4 / execwait#37)
#   AFTER it captured the exit code" — TRUE while every child was reaped synchronously by its
#   spawner, and FALSE the moment `fork`#96 + wait-any produced an exited-but-unreaped child that
#   a later fork then allocated straight over. The ppid guard in the scan below is what makes the
#   original sentence true again, by construction rather than by convention.
#   A consumer caching a pid across a yield or a wait MUST re-validate that the slot still names the same logical
#   process. 1.57.7: the blocking waitpid (sys_waitpid_block, syscall.cyr) caches `t` across its wait and does so by
#   construction — waitpid_peek re-runs proc_may_reap(me, t) on every iteration, so if some other reaper (pid 0)
#   reaps and recycles `t`, the waiter gets -1 ("not your child") and never reaps a stranger; and the ppid guard in
#   the scan below forbids reusing a dead child's slot while its parent is alive. (An agnsh job table or a
#   kill-by-saved-pid still has to do its own re-validation.)
# May dead slot `i` be handed out again? A PURE read, called by proc_alloc_slot under proctab_lock (and by ktest T12).
# 1 = reusable, 0 = keep it. The rules, oldest first (their history is at the scan in proc_alloc_slot):
#   · the slot is dead (state 0), AND
#   · 1.56.55: it is nobody's unread child — ppid 0 (both reap doors clear it; also every kmain child, see INV-FG-2),
#     the parent slot is gone (pp >= proc_count), or the parent is itself dead (an orphan);
#   · 1.57.6 (S3.1, INV-11): no CPU is still leaving it (on_cpu == -1);
#   · 1.57.7 (S3b, INV-FG-2): it is not the foreground child a LIVE waiter still owes a status read to
#     (proc_fgwait[pp] == i + 1). DEP-2: only while that waiter is alive — a dead waiter's stale cell never pins a
#     slot. kmain (pp 0) is always live, and before the lifecycle step nothing can kill a blocked waiter.
fn proc_slot_reusable(i) {
    if (load64(&proc_table + i * 176 + 8) != 0) { return 0; }
    var sr_pp = load64(&proc_ppid + i * 8);
    var sr_r = 0;
    var sr_orph = 0;
    if (sr_pp == 0) { sr_r = 1; }                                      # reaped (both reap doors clear ppid), or a kmain child
    if (sr_pp >= proc_count) { sr_r = 1; sr_orph = 1; }                # parent slot gone
    if (sr_pp > 0) { if (sr_pp < proc_count) { if (load64(&proc_table + sr_pp * 176 + 8) == 0) { sr_r = 1; sr_orph = 1; } } }   # orphan
    # ⛔ 1.57.7 (S7) REUSE TRIPWIRE: since the lifecycle step an orphan frees its fd table and address space at its OWN
    # death (proc_death_finish -> proc_reap_orphan), so an orphan/parent-gone slot handed out here still holding a live
    # address space is the D-29 leak class coming back. Latched; proc_alloc_slot says it after its unlock (denied by
    # every smoke). The decision itself is unchanged.
    if (sr_orph == 1) {
        var sr_cr3 = load64(&proc_table + i * 176 + 160);
        if (sr_cr3 != 0) { if (sr_cr3 != 0x1000) { proc_orphan_leak_seen = 1; } }
    }
    if (load64(&proc_on_cpu + i * 8) != (0 - 1)) { sr_r = 0; }          # S3.1: a CPU is still leaving it (INV-11)
    # INV-FG-2: a LIVE waiter's foreground child -> its status is still owed.
    if (sr_pp >= 0) {
        if (sr_pp < proc_count) {
            if (load64(&proc_table + sr_pp * 176 + 8) != 0) {
                if (load64(&proc_fgwait + sr_pp * 8) == i + 1) { sr_r = 0; }
            }
        }
    }
    return sr_r;
}
# (1.57.7 S7: proc_is_fg_child — S3b's never-called helper for this step — is gone: proc_stoppable reads the fgwait
# cell itself, and orphans are reaped at their own death, not by a scan that would need to skip fg children.)
# The reuse tripwire's latched line (klug + COM1, never the console: proc_alloc_slot's callers include the timer-free
# boot path and ISR-free syscalls, but a lock-free emitter is the simple rule). Called after proctab_spin_unlock.
fn proc_orphan_leak_say() {
    if (proc_orphan_leak_seen == 0) { return 0; }
    if (proc_orphan_leak_said != 0) { return 0; }
    proc_orphan_leak_said = 1;
    klug_append("proc: orphan zombie recycled unreaped", 37); klug_putc(10);
    serial_println("proc: orphan zombie recycled unreaped", 37);
    return 0;
}
fn proc_alloc_slot() {
    # 1.46.x SMP sub-bite 3: the scan-find-free + claim + proc_count-bump is a non-atomic RMW on
    # shared proc-table state. Under proctab_lock, AND set a CLAIMING sentinel (state=3) on the
    # chosen slot BEFORE releasing — otherwise the slot is returned still state==0 and a second
    # CPU's scan re-grabs the SAME idx before the caller (proc_create/_full) sets state=1. States:
    # 0=dead/free · 1=ready · 2=running · 3=claiming (sched_next selects only ==1, the scan reuses
    # only ==0, so a sentinel slot is invisible to both). Inert single-core: no scheduler runs
    # between this return and the caller's state=1, so the sentinel is immediately overwritten.
    proctab_spin_lock();
    var i = 0;
    var idx = 0 - 1;
    var reusable = 0;
    while (i < proc_count) {
        if (load64(&proc_table + i * 176 + 8) == 0) {
            # ⛔⛔ 1.56.55 — A DEAD SLOT IS NOT NECESSARILY A FREE ONE, AND `fork` IS WHAT MADE THE
            # DIFFERENCE REACHABLE. agnos has NO zombie state: `exit`#0 sets state 0 and deliberately
            # does NOT reap, so the row survives for the parent's `waitpid` to read. State 0 therefore
            # means BOTH "reaped / free" AND "exited, awaiting its parent" — and this scan reused
            # either one. The banner above stated the premise that made that safe: *"reuse only
            # follows a reap done BY the reaper AFTER it captured the exit code."* That held while
            # every child was reaped synchronously by its spawner. `fork`#96 + `waitpid` wait-any
            # created the first exited-but-UNREAPED child in this kernel, and the very next `fork`
            # then handed its slot away — destroying an exit status nobody had collected.
            # ⭐ MEASURED, not reasoned: forking twice in a row returned **the same pid twice**
            # (FORK-MULTI-P1 pid=3 / FORK-MULTI-P2 pid=3), because child 1 exited between the two
            # calls and child 2 was allocated straight over it. The parent then reaped exactly ONE
            # child and wait-any correctly answered -1 for the other — which had never existed as far
            # as the table was concerned. This is the allocator-side face of the same rule the 1.44.15
            # multi-collapse revert established from the reap side: *"a proc's slot must persist until
            # ITS OWN waitpid reaps it."*
            # ⇒ THE MARK IS `proc_ppid`, and it is exact as of this same cut: both reap doors now
            # clear it (see proc_reap / proc_reap_child), so a non-zero ppid on a dead slot means
            # PRECISELY "exited, not yet reaped". Reuse is allowed only when the row is genuinely
            # nobody's business any more.
            # ⚠ THE ORPHAN CLAUSE IS NOT OPTIONAL — without it this leaks. A zombie whose parent died
            # unreaping would pin its slot until reboot and march a 16-slot table to full. If the
            # parent slot is itself dead, or no longer exists, nobody will ever collect this row and
            # it is free. ⭐ 1.57.7 (S7): an orphan now reaps ITSELF at its death (its fd table AND its
            # address space — proc_reap_orphan), and a dying parent reaps its zombies before it
            # publishes, so this clause only ever meets an already-freed row; one that still holds an
            # address space trips proc_orphan_leak_seen (proc_slot_reusable) — the D-29 leak tripwire.
            # ⚠ KNOWN, BOUNDED, AND IN THE SAFE DIRECTION: if the parent's slot has since been
            # RECYCLED by an unrelated process, that process's live state pins this zombie. That is
            # the pid-recycle hazard the banner above already flags for a future consumer; it can only
            # over-PRESERVE a row, never hand a live one away.
            # ⭐ 1.57.7 (S3b): the whole predicate is proc_slot_reusable (above) — this rule, the on_cpu fence below and
            # the INV-FG-2 live-waiter clause — so ktest T12 drives exactly what the allocator decides.
            # ⛔ 1.57.6 (Path 2, S3.1) — AND NO CPU MAY STILL BE ON IT. A dead slot whose on_cpu is not -1
            # belongs to a CPU that has not finished leaving it: the switch tail publishes -1 only after
            # RSP is off the slot's kernel stack and the CR3 is gone (INV-11), and the store64 of -1
            # further down would erase that fence while the departing CPU is still popping its frame from
            # this very stack. STRICT form — no "the allocating CPU owns it" exemption: every non-(-1) value
            # on a dead slot is cleared promptly, by that tail or by the reap fence's self-owned path
            # (kernel_resume exits are reaped at once), so an exemption would buy nothing and add a case.
            reusable = proc_slot_reusable(i);
            if (reusable == 1) { idx = i; i = proc_count; }
            else { i = i + 1; }
        }
        else { i = i + 1; }
    }
    if (idx < 0) {
        if (proc_count >= 16) {
            proctab_spin_unlock();
            # ⛔⛔ SAY IT. Until now this returned -1 in SILENCE from four call sites, and the whole
            # chain above it is silent too: elf_load_from_file passes the -1 through, spawn_path #43
            # returns it, and the only thing that ever spoke was the CALLER — aethersafha printing
            # "spawn_path_env FAILED", which names the symptom and not one word of the cause. A full
            # process table then presents as a desktop that comes up, draws its chrome and hosts
            # nothing, with nothing anywhere saying why. That is what the 2026-08-09 iron session hit.
            # ⚠ Nothing REAPS an orphan: a compositor that exits without closing its clients leaves
            # them alive holding their rows forever, so repeated launches march the count to the cap.
            # An absent resource must say it is absent and why — the same rule that produced
            # "hda: ctl1 NOT PROBED" and gpu_hdmi_preflight's self-naming early returns.
            # ⚠ LATCHED, and deliberately not counted: the first refusal is the one that explains the
            # boot, and an unlatched print inside an allocation failure is a storm waiting for a
            # caller that retries.
            if (proc_full_said == 0) {
                proc_full_said = 1;
                kprintln("proc: the process table is full and this spawn was refused", 58);
                kprintln("proc: nothing reaps a process whose parent exited without closing it", 68);
            }
            proc_orphan_leak_say();
            return 0 - 1;
        }
        idx = proc_count;
        proc_count = proc_count + 1;
    }
    store64(&proc_table + idx * 176 + 8, 3);   # CLAIMING — release the lock with the slot owned
    # ⭐ ZERO THE CPU-TIME COUNTER HERE — at ALLOC, not at exit or reap (telemetry §4). This slot may
    # have held a previous process whose ticks are still in the array; a new process must not inherit
    # them. ⛔ AND NOT AT REAP: a monitor sampling between exit and reap would then see a live process
    # with 0 ticks, which is indistinguishable from one that just started. Alloc is the single moment
    # the old value provably means nothing.
    store64(&proc_ticks + idx * 8, 0);
    # ⛔ 1.57.7 ENDFIX (S7-R1): THE NEW INCARNATION IS BORN INSIDE THIS HOLD. The epoch bump and the death_done scrub
    # used to run AFTER the unlock (done=0 first, the bump ~40 lines later): for that stretch the recycled slot read
    # as the OLD parent, alive (state 3, old epoch, done 0), and an orphan child dying on another CPU (its final
    # hold takes proctab) published itself as a zombie nobody could reap, sending SIGCHLD to the newcomer. Bumping
    # FIRST, under proctab, means every final hold sees either done==1 or a changed epoch; lc_parent_live also
    # refuses a CLAIMING parent (belt and braces — ktest T-L12).
    store64(&proc_epoch + idx * 8, load64(&proc_epoch + idx * 8) + 1);
    store64(&proc_death_done + idx * 8, 0);
    proctab_spin_unlock();
    proc_orphan_leak_say();                    # 1.57.7 (S7): the reuse tripwire's latched line, after the unlock
    store64(&proc_signals + idx * 8, 0);
    store64(&proc_sigmask + idx * 8, 0);
    store64(&proc_rsp0 + idx * 8, DIRECTMAP_BASE + KSTACK_POOL_BASE + (idx + 1) * KSTACK_SLOT);  # 1.46.1 region-7 phys, 1.51.x via direct-map VA (8 GB+, clear of user segments)
    kstack_hw_scan();                          # 1.57.6 (S3-fix): KSTACK_HW — measure the previous occupant (and every slot) before the repaint
    kstack_paint(idx);                         # 1.57.6 (S3.3): KSTACK_HW high-water paint (a no-op twin otherwise)
    store64(&proc_on_cpu + idx * 8, 0 - 1);   # 1.46.x SMP6: recycled slot must not inherit a stale CPU id
    store64(&idle_owner + idx * 8, 0 - 1);     # 1.46.x STEP-2: recycled slot starts UNPINNED (a prior foreground proc may have left idle_owner=its launch CPU; a fresh proc must be free to migrate / not falsely pinned). Idles never reuse a slot, so their persistent pin is unaffected.
    store64(&proc_ppid + idx * 8, 0);          # 1.50.7: recycled slot must not inherit a stale parent (default init; proc_create_user sets the real creator)
    store64(&proc_fgwait + idx * 8, 0);        # 1.57.7 (S3b, INV-FG-2): a fresh slot waits on nothing
    # 1.57.7 (S7): nor a lifecycle state. The slot is CLAIMING and its ppid is not published yet, so no tree-walk
    # mark can precede these stores (the one exception to the "under sched_lock" write rule).
    store64(&proc_kill_pending + idx * 8, 0);
    store64(&proc_stop_pending + idx * 8, 0);
    store64(&proc_term_sig + idx * 8, 0);
    store64(&proc_ppid_epoch + idx * 8, 0);
    # 1.57.7 (S3.4): nor a stale wait (key, deadline, reason) or 4th syscall argument. The slot is CLAIMING and
    # nobody arms it. wq_ntimed is NOT adjusted: wq_tick's rescan is authoritative, so a stale deadline cleared
    # here can only leave the counter stale-HIGH (self-healing at the next rescan), never stale-low.
    store64(&proc_wait_key + idx * 8, 0);
    store64(&proc_wait_deadline + idx * 8, 0);
    store64(&proc_wake_reason + idx * 8, 0);
    store64(&proc_sc_a4 + idx * 8, 0);
    # 1.57.7 (S8): nor the dead occupant's caps or high-arena cursor (a fresh incarnation starts uncapped at the
    # arena floor; proc_create_user / sys_fork then place the real caps). Unconditional: the only caller-slot case
    # is the unregistered boot pid 0, whose caps are 0, and proc_create_user read the creator's values already.
    lim_caps_set(idx, 0, 0);
    store64(&proc_himmap_next + idx * 8, 0);
    # ⛔⛔ 1.56.53 — proc_names WAS THE ONE MEMBER OF THIS FAMILY MISSING FROM THE SCRUB, and its
    # absence made a PUBLISHED ABI GUARANTEE FALSE. `#99 proclist`s contract — in the issue record and
    # in the userland ABI doc — reads: "the name field is NUL-padded to the full 32 bytes **so ring 3
    # can never read a stale byte left by a previous occupant of the slot**." That is a slot-RECYCLE
    # guarantee, not a within-record padding note, and a pid IS a slot index here (see the PID-RECYCLE
    # banner below) with proc_alloc_slot reusing the first dead slot. Every other per-slot shadow is
    # reset above — signals, sigmask, rsp0, on_cpu, idle_owner, ppid, epoch, the FPU area — each with a
    # comment saying why a recycled slot must not inherit it. proc_names was added at 1.56.47 and never
    # joined the pattern, so a fresh process could report the DEAD one`s name to ring 3.
    # ⛔ AND THE FIX WAS ALREADY WRITTEN AND NEVER CALLED. `proc_clear_name` exists twenty lines up with
    # the comment "Clear a slot`s name when it is reused, so a dead process`s name can never be read
    # back against a live pid that happens to land on the same slot" — and `cyrius build` listed it as
    # DEAD CODE. A guarantee, a function written to provide it, and no edge between them.
    proc_clear_name(idx);
    # ⛔ 1.57.6 — A RECYCLED SLOT MUST NOT INHERIT THE PRIOR OCCUPANT'S SPAWN ARMS (redirect set, endowment,
    # placement record): a fresh process, fork#96 children included, starts with nothing armed.
    # ⛔⛔ BUT NEVER THE CALLER'S OWN SLOT. proc_create_user allocates the child BEFORE it places the
    # creator's endowment, and before proc 0 is registered (main.cyr's proc-table bootstrap) the boot
    # context IS pid 0 while the first user process it creates is ALSO handed slot 0 — main.cyr says so
    # at the SYSCALL_HARDEN endowment check and above chan_ring3_selftest. Resetting there wiped the
    # creator's own arm one line before its placement (shsys "endow owner not moved", CHANX-INH-ENDOWED
    # red). The guard is exact: a LIVE caller's slot is never state 0, so equality happens only for the
    # unregistered boot pid 0 — and spawn_arms_reset_all() at the bootstrap covers that slot instead.
    if (idx != proc_current_get()) {
        spawn_arms_reset(idx);
        lim_arm_clear(idx);   # 1.57.7 (S8): the limits arm, under the same guard
    }
    # 1.56.40 bite 2: a slot handed out is a NEW incarnation, whether it is a fresh row or a recycled
    # one — so the bump belongs in proc_alloc_slot, at the single point every user proc is born through, and not on
    # the death path (a slot that is never reused must still not alias the proc that last held it).
    # (1.57.7 ENDFIX S7-R1: the bump moved up, inside the proctab hold — see there.)
    fpu_area_reset(idx);                        # 1.53.x B2: recycled slot must not inherit the prior occupant's saved XMM — reset to the fninit-equivalent default (matters once B3's #NM restore is live)
    # 1.53.x B3b: belt-and-suspenders for the dangling-owner hazard — if any CPU's FP
    # owner still names this recycled pid (a death path that didn't clear it), drop it so
    # the new occupant's first #NM restores its fresh area, not the prev==cur skip.
    var _oc = 0;
    while (_oc < 4) { if (load64(&fpu_owner + _oc * 8) == idx) { store64(&fpu_owner + _oc * 8, 0 - 1); } _oc = _oc + 1; }
    return idx;
}
# 1.46.1: the per-proc TSS.RSP0 top for `pid`, or the legacy shared stack (0x3C0000
# = tss_kernel_stack, gdt.cyr) for an unassigned slot — e.g. hand-registered kmain/
# idle that bypass proc_alloc_slot. Called by do_context_switch (kstack_install) /
# exec_and_wait before a ring-3 entry. The 0-fallback keeps an uninitialized slot
# from setting RSP0=0 (a triple fault on the next CPL3->CPL0 interrupt).
fn proc_rsp0_top(pid) {
    var r = load64(&proc_rsp0 + pid * 8);
    if (r == 0) { return 0x3C0000; }
    return r;
}
fn proc_create(entry) {
    var idx = proc_alloc_slot();
    if (idx < 0) { return 0 - 1; }
    var p = &proc_table + idx * 176;
    store64(p, idx);          # pid
    store64(p + 8, 1);        # state: 1=ready
    store64(p + 16, 0);       # rsp (set by proc_create_full)
    store64(p + 24, entry);   # rip (entry point)
    # Zero all register fields
    memset(p + 32, 0, 128);
    # Set initial RFLAGS: IF=1 (interrupts enabled)
    store64(p + 152, 0x200);
    # Default: use kernel page tables
    store64(p + 160, 0x1000);
    # 1.44.3: default ring-0 selectors (kmain/idle/kthreads). spawn_user_proc overrides.
    store64(&proc_cs + idx * 8, 0x08);
    store64(&proc_ss + idx * 8, 0x10);
    return idx;                          # 1.44.x: slot + proc_count handled by proc_alloc_slot
}

fn proc_get_state(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    return load64(&proc_table + pid * 176 + 8);
}

fn proc_set_state(pid, st) {
    if (pid >= proc_count) { return 0 - 1; }
    store64(&proc_table + pid * 176 + 8, st);
    return 0;
}

# 1.44.4: flip a proc's saved selectors to ring-3 (CS=0x23, SS=0x1B) so the
# scheduler's proc_restore_context (1.44.3 table-driven) iretq's it into ring 3
# (default is ring-0 0x08/0x10). The proc must already carry a per-process CR3 +
# a user-VA RIP/RSP + IF=1 in its saved rflags (spawn_user_proc + proc_create_full
# provide these). Only safe to make a ring-3 proc PREEMPTIBLE if its work is
# syscall-free until per-proc kernel stacks land (the shared-RSP0 wall).
fn proc_set_ring3(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    store64(&proc_cs + pid * 8, 0x23);
    store64(&proc_ss + pid * 8, 0x1B);
    return 0;
}

fn proc_count_by_state(st) {
    var n: i64 = 0;
    for (var i = 0; i < proc_count; i = i + 1) {
        if (proc_get_state(i) == st) { n = n + 1; }
    }
    return n;
}

# Extended process creation with stack
# ⛔ 1.57.6 (S3-fix) — THE READY PUBLISH IS THE LAST STORE, NOT THE FIRST. This used to write state 1 right
# after the pid and THEN the RSP, RIP, flags and CR3, so under a live scheduler another CPU could see a READY
# slot whose context was still the previous occupant's (x86-TSO orders the stores, but the READY store came
# first). proc_create_kclaim does all of the writing and leaves the slot CLAIMING (proc_alloc_slot's 3);
# proc_create_full publishes it READY afterwards. A caller that must publish under its own lock (ap_entry's
# idle) calls proc_create_kclaim directly.
fn proc_create_full(entry, stack_top) {
    var idx = proc_create_kclaim(entry, stack_top);
    if (idx < 0) { return 0 - 1; }
    store64(&proc_table + idx * 176 + 8, 1);   # state: 1=ready — published LAST
    return idx;
}
fn proc_create_kclaim(entry, stack_top) {
    var idx = proc_alloc_slot();         # 1.44.x: non-LIFO slot reuse (else append, cap 16) — returns it CLAIMING (3)
    if (idx < 0) { return 0 - 1; }
    var p = &proc_table + idx * 176;
    store64(p, idx);          # pid (state stays 3 = CLAIMING: the caller publishes it)
    store64(p + 16, stack_top); # rsp
    store64(p + 24, entry);   # rip
    # Zero all register fields
    memset(p + 32, 0, 128);
    # Set initial RFLAGS: IF=1 (interrupts enabled)
    store64(p + 152, 0x200);
    # Set rbp = stack_top (frame pointer)
    store64(p + 80, stack_top);
    # Default: use kernel page tables
    store64(p + 160, 0x1000);
    # 1.44.3: default ring-0 selectors (kmain/idle/kthreads). spawn_user_proc overrides.
    store64(&proc_cs + idx * 8, 0x08);
    store64(&proc_ss + idx * 8, 0x10);
    return idx;                          # 1.44.x: slot + proc_count handled by proc_alloc_slot
}

# 1.46.x SMP STEP-2 (#2, 2026-06-26): create a USER process slot that is NOT YET SCHEDULABLE.
# Identical to proc_create_full EXCEPT it leaves the slot at state=3 (CLAIMING — the proc_alloc_slot
# sentinel) instead of state=1 (ready). WHY: a user proc needs post-creation wiring its caller does
# AFTER this returns — proc_set_cr3 (a real per-proc address space, not the 0x1000 default below) and,
# for scheduled procs, proc_set_ring3 (CS=0x23/SS=0x1B). proc_create_full set state=1 BEFORE that
# wiring, so under smp_sched_aps=1 a woken AP's sched_next could pick the half-built proc (CR3=0x1000,
# ring-0 selectors) and iretq a user RIP under CS=0x08 → fault. With state=3 the proc is invisible to
# BOTH sched_next (picks only ==1) and proc_alloc_slot's reuse scan (reuses only ==0) until the caller
# flips it ready via proc_set_state(pid, 1) AFTER full wiring. Single-core inert: the same store the old
# code did, just deferred to the caller; no scheduler runs between here and the caller's flip at slot 0.
fn proc_create_user(entry, stack_top) {
    # 1.57.7 (S8): the creator's effective limits for its child, read FIRST (before proc_alloc_slot). The creator is
    # the spawner in #3/#37/#43 (P is current at load); kmain (pid 0) has no caps and never arms.
    var lc_cr = proc_current_get();
    var lc_m = lim_child_mem(lc_cr);
    var lc_c = lim_child_cpu(lc_cr);
    var idx = proc_alloc_slot();
    if (idx < 0) { return 0 - 1; }
    var p = &proc_table + idx * 176;
    store64(p, idx);          # pid
    store64(p + 8, 3);        # state: 3=CLAIMING/building — NOT schedulable until the caller readies it
    store64(p + 16, stack_top); # rsp
    store64(p + 24, entry);   # rip
    memset(p + 32, 0, 128);   # zero all register fields
    store64(p + 152, 0x200);  # initial RFLAGS: IF=1
    store64(p + 80, stack_top); # rbp = stack_top
    store64(p + 160, 0x1000); # default CR3 (caller overrides via proc_set_cr3)
    store64(&proc_cs + idx * 8, 0x08);   # default ring-0 selectors (caller overrides via proc_set_ring3)
    store64(&proc_ss + idx * 8, 0x10);
    # 1.47.x per-proc fd tables (2b): give the child its own fd table, inheriting a COPY of its
    # creator's (proc_current) — so it sees the parent's stdin/stdout + pipe fds, but isolated.
    # The single inheritance point for every user proc (elf_load / elf_load_from_file / spawn).
    # 1.50.7: record the same creator pid as the child's PARENT — the one place every user proc
    # is born, so kill#16's child-only gate sees a real parent. (proc_current_get() reads a
    # per-CPU global, NOT CR3-derived, so it is still the spawner even when the #3 path has
    # cr3_load(0x1000)'d to boot CR3 for the disk read.)
    store64(&proc_ppid + idx * 8, proc_current_get());
    # ⭐ 1.57.7 (S7): the parent is an INCARNATION (pid, epoch) — proc_is_child_of compares it, so a recycled parent
    # slot never inherits its predecessor's children. proc_epoch_get has no bounds check: the creator is the caller.
    store64(&proc_ppid_epoch + idx * 8, proc_epoch_get(proc_current_get()));
    # ⛔ A DYING CREATOR CREATES NO CHILD, AND A TREE-STOPPED ONE CREATES A STOP-PENDING CHILD (S7 §2.9). The check
    # runs under sched_lock AFTER ppid/epoch are stored, so a KILL_TREE / tree stop walk (one sched_lock hold) either
    # saw this child (kill -> MARK, stop -> birth stop) or the check sees the creator's pending kill / tree stop. A
    # spawning agent cannot outrun a tree kill. On refusal the slot is released unborn; the loaders' < 0 arms free the
    # address space they built, and the dying caller never observes the code (it ends at its syscall exit).
    if (proc_birth_check(idx, proc_current_get()) == 0) { proc_slot_release_unborn(idx); return 0 - 1; }
    lim_caps_set(idx, lc_m, lc_c);   # 1.57.7 (S8): lim_eff inheritance (an arm can only lower)
    vfs_fd_inherit(idx, proc_current_get());
    # 1.56.40 bite 5 — place an armed channel endowment into the child (planning/ipc.md §9.6).
    # ⛔ THE HIGHEST-RISK LINE IN THE CUT: this sits on the birth path of EVERY user process, so a
    # defect here does not break the channel band, it breaks spawn. It is deliberately the LAST thing
    # proc_create_user does, after the child's fd table exists, and it returns immediately when nothing
    # is armed — which is every spawn in the system except a deliberately endowed one.
    # ⚠ If placement ever destabilises spawn measurably, ipc.md's kill criterion says it moves OFF the
    # birth path — and a child then cannot be born holding a channel, which voids the PTY answer.
    chan_place_into_child(idx);
    return idx;
}

# === 1.44.x multi-threading (opening) — kernel-thread primitive ===
# A kernel thread is a schedulable proc on the SHARED kernel address space
# (CR3 0x1000) with IF=1, so the timer preempts and round-robins it. This
# generalizes the hand-rolled idle proc (main.cyr proc 1) into a real spawn API.
# Stacks come from a static pool so the create path takes no PMM/heap allocation
# (scheduler-path-safe). `entry` is a `fn(): i64` that loops forever — a kthread
# does not return; it is retired via proc_set_state(pid, 0). Returns pid / -1.
# ⭐ 1.57.6 (Path 2, S3.3) — THE STACKS ARE 64 KB REGION-7 SLOTS WITH A GUARD PAGE, NOT 4 KB OF .bss. The
# range [0xF00000, 0xF40000) held the per-CPU primary SYSCALL stacks until syscalls moved onto per-process
# stacks; it is the kthread pool now (gdt.cyr's region-7 map). The BSP idle runs every switch path (the
# timer ISR chain, the switch tail) on its kthread stack, which was 4 KB with nothing under it but other
# .bss — an overflow would have corrupted a neighbour silently; now it has 60 KB and a not-present page
# below (vmm.cyr kstack_guard_init). Addressed through the DIRECT MAP (DIRECTMAP_BASE + phys) like every
# region-7 stack. It also takes 16 KB out of the image's LOAD segment.
# ⚠ BOOTCR3_KEEP_GNOBOOT_CR3 builds keep the .bss pool: their kmain context has no direct map (the
# kfont_init exclusion), and they get no guard pages either.
var KTHREAD_MAX = 4;
var KTHREAD_STACK_POOL = 0xF00000;     # region 7 PHYS base of the pool: 4 x 64 KB slots
var kthread_next = 0;
#ifdef BOOTCR3_KEEP_GNOBOOT_CR3
var KTHREAD_STACK_U64 = 512;           # 4 KB per kthread kernel stack (the pre-1.57.6 pool)
var kthread_stacks[2048];              # KTHREAD_MAX x KTHREAD_STACK_U64 (= 16 KB)
fn kthread_stack_top(n) { return &kthread_stacks + (n + 1) * KTHREAD_STACK_U64 * 8; }
#endif
#ifndef BOOTCR3_KEEP_GNOBOOT_CR3
fn kthread_stack_top(n) { return DIRECTMAP_BASE + KTHREAD_STACK_POOL + (n + 1) * 0x10000; }
#endif
fn kthread_create(entry) {
    if (kthread_next >= KTHREAD_MAX) { return 0 - 1; }
    # Stacks grow down: top = the top of this kthread's slot.
    var stack_top = kthread_stack_top(kthread_next);
    kthread_next = kthread_next + 1;
    return proc_create_full(entry, stack_top);   # CR3 0x1000, IF=1, state=ready
}

# Set a process's CR3 (page table root)
fn proc_set_cr3(pid, cr3_val) {
    if (pid >= proc_count) { return 0 - 1; }
    store64(&proc_table + pid * 176 + 160, cr3_val);
    return 0;
}

fn proc_get_cr3(pid) {
    if (pid >= proc_count) { return 0; }
    return load64(&proc_table + pid * 176 + 160);
}

fn proc_set_exit_code(pid, code) {
    if (pid >= proc_count) { return 0 - 1; }
    store64(&proc_table + pid * 176 + 168, code);
    return 0;
}

fn proc_get_exit_code(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    return load64(&proc_table + pid * 176 + 168);
}

# === Per-Process Address Space ===
# Create new page tables for a process. Returns kernel CR3.
# S8 (KPTI): Also creates a separate user CR3 with minimal kernel mappings.
#   Kernel CR3: full mappings (kernel + user pages)
#   User CR3:   only PD entry 0 (supervisor-only, for SYSCALL/ISR trampoline)
#               + user-mapped pages (added later via proc_map_page)

# KPTI CR3 pair: 1.46.x SMP sub-bite 4c moved this PER-CPU into pcpu_kpti_kernel_cr3 /
# pcpu_kpti_user_cr3 (syscall_hw.cyr). The old single globals here were a single-core
# invariant. Writers: sched.cyr (both switch paths), ring3.cyr (the boot-only exec_and_wait; syscall.cyr's #37 ew37
# restore wrote them too until 1.57.7 S3b made #37 a blocking wait).
# Stub installs them via r8*8 per-CPU loads. KPTI is currently COLLAPSED (kernel==user==running).

# Repair (J) — Attempt 23: PMM-allocation CMOS-stamp call counter.
# Distinguishes successive `proc_create_address_space` invocations so each
# call's pmm_alloc results land in a different CMOS slot range:
#   call 1 (AS1)  → slots 0x56..0x58 (3 page-table pages; was 0x56..0x5B
#                   before 1.40.14 dropped the dead u_* alloc — slots +3..+5
#                   no longer stamped)
#   call 2 (AS2)  → slots 0x5C..0x5E
#   call 3+       → no stamps (out of CMOS scratch budget)
# Each stamp writes byte 2 of the returned phys addr — `(addr >> 16) & 0xFF`.
# Reading 0x00 from any stamp = pmm_alloc returned a phys < 0x10000, which is
# inside the kernel-reserved [0x1000..0x3FFF] PT range. That's the smoking gun
# for the Attempt-22 kernel-CR3-restore #PF (kcp=0x68): zeroing a "fresh" page
# that's actually the kernel PML4 corrupts it in place, then `mov cr3, 0x1000`
# walks zeros and #PFs. See iron-nuc-zen-log.md § Attempt 22 audit.
var proc_pca_call_n = 0;
#ifdef ELF_PDE_PROBE
var cr3w_n = 0;
fn cr3_install_watch(cr3) {
    if (cr3 == 0) { return 0; }
    if (cr3 == 0x1000) { return 0; }
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk (ptw_pd_kva header)
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;               # RAW PHYS — what the klug lines print
    var pd_kva = pmm_kva_for_access(pd_addr);           # the handle every deref below uses
    var e = load64(pd_kva + 510 * 8);
    # SUBJECT CONTROL: log EVERY install of the faulting space 0xffd7000, present-or-absent, so the
    # record proves this path ran for it — not just the anomaly. Bounded to 40 to survive the ring.
    if ((cr3 & 0xFFFFF000) == 0xffd7000) {
        if (cr3w_n < 40) {
            cr3w_n = cr3w_n + 1;
            klug_append("CR3INST as=0x", 13);
            epp_hex(cr3);
            klug_append(" pd=0x", 6);
            epp_hex(pd_addr);
            klug_append(" pde510=0x", 10);
            epp_hex(e);
            klug_append(" by=", 4);
            epp_hex(proc_current_get());
            klug_append(" cpu=", 5);
            epp_hex(pcpu_cpu());
            klug_putc(10);
        }
    }
    return 0;
}
#endif
#ifndef ELF_PDE_PROBE
fn cr3_install_watch(cr3) { return 0; }
#endif

# Load cr3_val (first param at [rbp-8] per Cyrius calling convention)
# into RAX, then write to CR3. Replaces the `var x = y; asm { mov cr3,
# rax; }` pattern — that pattern relied on cc3-era codegen leaving the
# assigned value in RAX, which cc5's regalloc breaks. Function-shaped
# helpers using `[rbp-N]` param loads are robust across compiler
# versions (same approach as kernel/arch/x86_64/io.cyr's outb/inb).
# See docs/development/issues/archived/2026-04-27-cyrius-fmt-tracks-braces-in-comments.md
# for the cyrius v5.7.22 fix that allows raw `{`/`}` in comments again.
fn cr3_load(cr3_val) {
    # ⭐ THE UNIVERSAL CR3 CHOKEPOINT. Every ring-3 entry must pass through here, whatever path it
    # took to get here — so a tripwire at THIS point cannot miss a proc the way a scheduler-only
    # tripwire did. Check the stack PDE of the space being installed.
    cr3_install_watch(cr3_val);
    asm {
        0x48; 0x8B; 0x45; 0xF8;   # mov rax, [rbp - 8]   (cr3_val)
        0x0F; 0x22; 0xD8;         # mov cr3, rax
    }
    return 0;
}

#ifdef ARCH_X86_64
# X86-specific page-table layout (PML4 → PDPT → PD). Guarded so the
# aarch64 build uses the no-op stubs in arch/aarch64/stubs.cyr instead
# of these x86-specific implementations. Pre-1.27.0 these were unguarded
# and "won" over the aarch64 stubs under last-definition-wins, which
# cyrius 5.10.x began emitting as a `duplicate fn` warning. Beyond
# silencing the warning this also closes a latent aarch64-correctness
# gap: the aarch64 kernel was carrying x86 page-table code in these
# slots and would have walked wrong memory if any caller had reached it.

# ⛔⛔ 1.56.51 — EVERY PAGE-TABLE DEREFERENCE BELOW GOES THROUGH THE DIRECT MAP, NEVER THROUGH AN
# IDENTITY VA. A page-table page is a raw PHYSICAL address. Using it as a VIRTUAL address only works
# while the low identity window still means phys==VA under whatever CR3 the kernel happens to be
# running on — and it does not. elf.cyr accepts a PT_LOAD anywhere in [0x400000, 0x10000000), which
# is exactly PD[2..127] of the per-process PD, and proc_map_page's only index math is
# `pd_idx = (virt >> 21) & 0x1FF`. So a crafted segment at, say, 0xC00000 overwrites PD[6] with a
# ring-3-writable page and SHADOWS the identity mapping of physical 12-14 MB in that process's own
# address space — where its PML4/PDPT/PD and the whole kernel heap live, because pmm_alloc hands out
# [0x400000, 0xFFFF000], a strict subset of the same window. The next `load64(cr3)` under that CR3
# then reads ATTACKER BYTES as a page-table entry and stores through the result: ring 3 to arbitrary
# kernel write. pmm.cyr:317-330 asserted the opposite ("the ONLY per-proc PDE override inside
# PD[0..127] is PD[2]") as a load-bearing invariant, and conceded on the next line that the heap was
# clear "only by luck of placement".
# ⭐ THE REMEDY IS THE ONE ALREADY APPLIED TWICE: the PMM bitmap (pmm.cyr:326-330) and the TSS RSP0
# stack (proc.cyr:363) were both moved off identity onto DIRECTMAP_BASE + phys, which lives in kernel
# PDPT[8..511] (8 GB+). proc_create_address_space mirrors kernel PDPT[1..511] into every per-process
# PDPT, so that alias resolves under EVERY CR3; and no user segment can reach it, because the loaders
# cap p_vaddr + p_memsz at 0x10000000 — PDPT[0]. Narrowing that ceiling would shrink the window
# without closing the class; this closes it.
# ⚠ ONLY THE ADDRESS MOVES. The VALUE stored in a PDE stays a raw physical page number — the CPU's
# own page walker is physical and none of this touches it.
# ⛔ ORDERING: the direct map is installed by pmm_setup_directmap at main.cyr:236. The earliest
# caller of anything below is main.cyr:2596. Do not add a caller ahead of that line.
#
# ptw_pd_kva(cr3) — walk PML4[0] -> PDPT[0] -> PD and return the PD's DIRECT-MAP kernel VA, or 0 if
# the chain is broken. 0 was previously "walk garbage and store through it"; callers now bail.
fn ptw_pd_kva(cr3) {
    if (cr3 == 0) { return 0; }
    var pml4e = load64(pmm_kva_for_access(cr3));
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    if (pdpt_addr == 0) { return 0; }
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;
    if (pd_addr == 0) { return 0; }
    return pmm_kva_for_access(pd_addr);
}

fn proc_create_address_space() {
    # Repair (J) — Attempt 23: bump the global call counter and compute the
    # CMOS slot base for this invocation's 6 pmm_alloc stamps. Only the first
    # two calls (AS1 / AS2 from the mem-iso test in main.cyr) get stamped;
    # subsequent calls leave `pca_stamp_base = 0` and skip stamping.
    proc_pca_call_n = proc_pca_call_n + 1;
    var pca_stamp_base = 0;
    if (proc_pca_call_n == 1) { pca_stamp_base = 0x56; }
    if (proc_pca_call_n == 2) { pca_stamp_base = 0x5C; }

    # Allocate 3 pages for kernel page tables: PML4, PDPT, PD
    var new_pml4 = pmm_alloc();
    if (pca_stamp_base != 0) { outb(0x70, pca_stamp_base + 0); outb(0x71, (new_pml4 >> 16) & 0xFF); }
    if (new_pml4 == 0) { return 0; }
    var new_pdpt = pmm_alloc();
    if (pca_stamp_base != 0) { outb(0x70, pca_stamp_base + 1); outb(0x71, (new_pdpt >> 16) & 0xFF); }
    if (new_pdpt == 0) { pmm_free(new_pml4); return 0; }
    var new_pd = pmm_alloc();
    if (pca_stamp_base != 0) { outb(0x70, pca_stamp_base + 2); outb(0x71, (new_pd >> 16) & 0xFF); }
    if (new_pd == 0) { pmm_free(new_pml4); pmm_free(new_pdpt); return 0; }

    # 1.56.51 — the three tables are ZEROED AND BUILT THROUGH THE DIRECT MAP, not through their
    # phys==VA identity alias. This function runs under the CALLER's CR3, and the caller may be a
    # ring-3 process whose own PT_LOAD shadowed PD[2..127] — the very window pmm_alloc draws these
    # pages from. See the ptw_pd_kva header. The VALUES written stay raw phys.
    var kml4 = pmm_kva_for_access(new_pml4);
    var kpdpt = pmm_kva_for_access(new_pdpt);
    var kpd = pmm_kva_for_access(new_pd);

    # Zero all three pages
    memset(kml4, 0, 4096);
    memset(kpdpt, 0, 4096);
    memset(kpd, 0, 4096);

    # PML4[0] → PDPT (present + writable + user)
    store64(kml4, new_pdpt | 0x07);
    # PDPT[0] → PD (present + writable + user)
    store64(kpdpt, new_pd | 0x07);

    # Copy kernel PD entries [0..127] from kernel PD at 0x3000 — covers
    # 0 GB through 256 MB (0x10000000), the kernel/identity half of the
    # per-process PD where the kernel text/data/heap and the SYSCALL kstack
    # (0x3F0000) live. These MUST stay identity-mapped: the syscall handler
    # and kstack run under THIS per-process CR3 and need a faithful phys==VA
    # map. Entry 511 is reserved as the user-CR3 stash slot (see
    # store64(new_pd + 511 * 8, new_pml4) below — proc_get_user_cr3 reads it
    # back). Pre-v1.25.1 this loop only copied [0..7] (16 MB) to mirror the
    # old kernel identity-map ceiling, which left every per-process address
    # space unable to reach kernel data above 16 MB — surfaced as a #PF
    # triple-fault in the memory-isolation test once the kernel started
    # living past 16 MB.
    for (var i = 0; i < 128; i = i + 1) {
        var entry = load64(pmm_kva_for_access(0x3000) + i * 8);
        store64(kpd + i * 8, entry);
    }
    # 1.43.x: the boot identity map the copy above inherits only covers 0-16MB
    # (PD[0..7]). The PMM 2MB pool now reaches 128MB (regions 8-63 = phys
    # 16-128MB), and sys_mmap zeroes a freshly-allocated region via its IDENTITY
    # address — memset(phys, 0, 2MB) — under THIS per-process CR3. A region >=16MB
    # was therefore unmapped here → ring-0 #PF on the memset → #DF (caught on iron
    # as cyrius-doom's 4.2MB WAD alloc). Map PD[8..63] = 16-128MB as identity-
    # SUPERVISOR 2MB pages so the kernel can reach the whole pmm range. U/S=0 keeps
    # ring 3 out; user code/stack live in PD[2]/PD[4] and the mmap arena in
    # PD[128+], so no user VA resolves through these slots (no aliasing).
    for (var hi = 8; hi < 128; hi = hi + 1) {     # 1.49.6: 16-256MB (was 16-128MB) — full identity window
        store64(kpd + hi * 8, (hi * 0x200000) | 0x83);
    }
    # Direction B (page-map fragility, issue 2026-06-04): leave the mmap-arena
    # PD slots [128..510] — covering [0x10000000, 0x3FE00000), the arena
    # sys_mmap bumps through (base 0x10000000 = mmap_next_vaddr, ceiling
    # 0x40000000; pd_idx = VA>>21, so 0x10000000>>21 = 128) — NOT-PRESENT (0)
    # rather than inheriting pt_init's present-SUPERVISOR identity entries
    # (0x83). Every process was otherwise born with the whole arena as
    # present-supervisor 2 MB pages, so when proc_map_page's user-PDE write
    # went astray (the wrong-CR3 walk) the stale supervisor PDE "won" and a
    # ring-3 heap store faulted e=0007 (US-protection on a PRESENT page)
    # instead of a clean e=0006 (not-present). sys_mmap/proc_map_page now
    # populate these slots as user pages (0x87) on demand; an un-mapped arena
    # access faults cleanly e=0006 and there is no stale supervisor PDE to
    # win. Kernel slots [0..127] are untouched above. Entry 511 is the
    # user-CR3 stash (overwritten below), so this loop stops at 510.
    for (var ai = 128; ai < 511; ai = ai + 1) {
        store64(kpd + ai * 8, 0);
    }
    # Mirror ALL present kernel PDPT entries [1..511], not just the 1–4 GB
    # huge pages. vmm_remap_uc_2mb / vmm_remap_wc_2mb (vmm.cyr) install
    # device-MMIO and ≥4 GB BARs at arbitrary pdpt_idx in the kernel PDPT,
    # and a running program's syscalls do kernel-side work (console, device
    # I/O) under THIS per-process CR3. Copying only [1..3] left every mapping
    # ≥4 GB absent → the 1.40.6 NVMe-BAR fault (worked around by kernel_resume
    # restoring the boot CR3 on exit). Making the per-process CR3 a faithful
    # superset of the kernel map removes that whole class of "mapped under the
    # boot CR3, not under exec_cr3_g" faults. Kernel PDPT entries carry U/S=0,
    # so ring 3 still can't reach them — protection holds. (Entries that are
    # absent in the kernel PDPT copy as 0 = not-present, which is harmless.)
    for (var pi = 1; pi < 512; pi = pi + 1) {
        store64(kpdpt + pi * 8, load64(pmm_kva_for_access(0x2000) + pi * 8));
    }
    # Mirror present kernel PML4 entries [1..511] too — vmm_remap_*'s
    # pml4_idx > 0 branch (phys ≥ 512 GB) installs whole high PDPTs directly
    # in the kernel PML4 @ 0x1000. Without these the per-process CR3 cannot
    # reach them. PML4[0] stays our custom new_pdpt (set above); [1..511]
    # share the kernel's (supervisor-only, so ring 3 is still walled off).
    for (var mi = 1; mi < 512; mi = mi + 1) {
        store64(kml4 + mi * 8, load64(pmm_kva_for_access(0x1000) + mi * 8));
    }

    # 1.40.3 collapsed the KPTI split for ring-3 bring-up: the minimal user CR3
    # (only 0-2MB supervisor) never mapped the user code/stack a running ring-3
    # process needs, and the SYSCALL/interrupt CR3-swap paths were unproven
    # hand-asm that triple-faulted. So we stash the FULL per-process CR3 (new_pml4)
    # as the "user" CR3 in PD entry 511: it maps kernel pages supervisor (U/S=0 →
    # ring 3 still can't touch them, so protection holds), user pages U/S=1 (ring 3
    # runs), the SYSCALL stub (0-2MB), the user stack, and the Local APIC (PDPT[3]).
    # proc_get_user_cr3 reads this slot back; the stub's CR3 switches are safe no-ops.
    # Only the Meltdown side-channel defense is deferred — KPTI-proper is its own arc.
    #
    # 1.40.14: the three separate u_pml4/u_pdpt/u_pd pages this block used to
    # allocate (the minimal KPTI user tables) were ORPHANED the moment the stash
    # above started storing new_pml4 instead of u_pml4 — nothing ever read them
    # (proc_get_user_cr3 / proc_map_page resolve PD[511] = new_pml4, the same
    # table). They were a silent 3-page-per-exec leak that proc_reap could not
    # reclaim (orphaned = unreachable from the CR3 chain). Removed: per-process
    # address-space construction now allocates exactly 3 page-table pages
    # (new_pml4/new_pdpt/new_pd), all reachable and all freed by
    # proc_free_address_space on teardown.
    store64(kpd + 511 * 8, new_pml4);          # VALUE stays raw phys — proc_get_user_cr3 reads it back

    # ELF_PDE_PROBE: record every address-space ALLOCATION. Paired with the FREE record in
    # proc_free_address_space, this shows whether one PML4 is handed out twice — and if so whether a
    # free came between (LIFO pmm reuse under a live occupant) or not (one proc loaded twice).
    #ifdef ELF_PDE_PROBE
    ptpage_selftest_once();
    ptpage_register(new_pml4);
    ptpage_register(new_pdpt);
    ptpage_register(new_pd);
    klug_append("asalloc pml4=0x", 15);
    epp_hex(new_pml4);
    klug_append(" pdpt=0x", 8);
    epp_hex(new_pdpt);
    klug_append(" pd=0x", 6);
    epp_hex(new_pd);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    #endif
    return new_pml4;
}

# === Per-Process Address-Space Teardown (1.40.14; mmap-arena sweep 1.42.x) ===
# Free every physical page a per-process address space owns: the user huge
# pages (ELF segments + stack + ANY un-munmap'd anonymous mmap) and the three
# page-table pages (PML4/PDPT/PD). Inverse of proc_create_address_space +
# the loader's proc_map_page calls AND sys_mmap's proc_map_page calls. Returns
# 0, or -1 on a kernel/boot CR3.
#
# How user pages are found: a per-process PD covers 0-1 GB (512 x 2 MB). At
# AS-creation we copy the kernel identity PD (flag 0x83 — supervisor, NO user
# bit) into entries [0..510]; the loader then OVERWRITES specific entries with
# user huge pages via proc_map_page (flag 0x87 — the U/S user bit 0x04 SET),
# and sys_mmap likewise installs anonymous arena pages via proc_map_page (also
# flag 0x87). So "present (0x01) AND user (0x04)" cleanly identifies exactly the
# pages the loader+mmap allocated, regardless of physical address — a
# divergence-from-kernel scan is unreliable because the first pmm_alloc_2mb
# commonly returns region 2 (0x400000), which equals the code segment's own
# identity vaddr.
#
# 1.42.x mmap-on-exit fix: the anonymous mmap arena [0x10000000, 0x40000000)
# occupies PD indices 128..511 (0x10000000>>21 == 128 ; the top page at vaddr
# 0x3FE00000 is PD index 511). The pre-1.42 loop stopped at index 510, so a
# process that exited WITHOUT munmap'ing left every still-mapped arena page in
# the PMM permanently (the heapstress symptom: ~3 interactive runs, then
# pmm_alloc_2mb exhaustion). The scan now covers the FULL user PD range [1..511]
# — `present AND user` still discriminates correctly at every index:
#   - munmap'd / never-mapped arena pages are not-present (0x01 clear) -> skipped
#     (this is exactly B2's "arena not-present until mapped" layout: harmless);
#   - the kernel-mirrored identity entries are supervisor (0x04 clear) -> skipped
#     (never freed — they belong to the shared kernel map, not this process);
#   - index 511 is the user-CR3 stash slot (raw page-aligned new_pml4 with NO
#     flag bits, so both present and user read 0) -> skipped, never freed as a
#     huge page even though it now falls inside the scan.
# So the sweep is correct under BOTH the current (arena pre-copied as supervisor
# identity, then overwritten user-on-map) and B2's (arena not-present until
# mapped) PD-seeding layouts — it only ever frees PRESENT+USER entries.

# === proc_dup_address_space — the fork half (1.56.54) ==============================================
#
# Duplicate `src_cr3` into a BRAND-NEW address space and return its CR3, or 0 on any failure. Every
# user page is COPIED, not shared: after this returns, the two address spaces have no physical page
# in common and a write in either is invisible to the other.
#
# ⛔⛔ FULL COPY, NOT COPY-ON-WRITE, AND THAT IS A DECISION RATHER THAN A SHORTCUT. CoW needs a
# write-fault path — a #PF handler that distinguishes "this page is CoW, unshare it" from a real
# fault, plus refcounts on every shared frame and a teardown that only frees at zero. agnos's #PF
# handler routes CPL3 faults to `fault_kill_current` and CPL0 faults to a halt; there is no
# unshare-and-resume anywhere, so a CoW page would present as a killed process. The roadmap's own
# line is that this kernel grows per native workload rather than to match Linux, and the named
# consumer (agora, fork-per-connection) forks and immediately diverges — it would take the copy
# almost at once anyway.
# ⚠ THE COST IS REAL AND IS THE CALLER'S TO KNOW: a fork of a process holding N MB of mapped pages
# copies N MB. `sys_fork` bounds it by refusing when the PMM cannot cover the source's footprint.
#
# ⭐ IT REUSES proc_map_page / _nx / _hi RATHER THAN INSTALLING PDEs BY HAND. Those three are the only
# code that knows the whole shape of an installed entry — the 0x87 user bits, bit 63 for NX, and the
# KPTI entry-511 stash that must receive the SAME write or ring 3 walks a stale user PD. Hand-rolling
# a `store64` here would be a fourth place that has to stay in step with all of that, and the tree has
# already paid for exactly that mistake once (proc_unmap_page's supervisor guard, 1.41.13).
#
# ⚠ PD[511] IS THE USER-CR3 STASH, NOT A MAPPING — the loop stops at 510. proc_create_address_space
# writes the new space's own stash; copying the source's would point this process's KPTI user CR3 at
# the PARENT's PML4.
# ⚠ SUPERVISOR ENTRIES ARE SKIPPED, exactly as proc_free_address_space skips them: PD[0..127] carry
# the kernel identity mirror, which proc_create_address_space has already installed correctly for the
# new space. Copying them would be a no-op at best; allocating fresh pages for them would double the
# kernel's own image.
fn proc_dup_address_space(src_cr3) {
    if (src_cr3 == 0) { return 0; }
    if (src_cr3 == 0x1000) { return 0; }          # never duplicate the kernel/boot CR3
    var dst_cr3 = proc_create_address_space();
    if (dst_cr3 == 0) { return 0; }
    var src_pd = ptw_pd_kva(src_cr3);
    if (src_pd == 0) { proc_free_address_space(dst_cr3); return 0; }

    # --- low window: image, stack and the low mmap arena, PD[1..510] ---------------------------
    for (var i = 1; i < 511; i = i + 1) {
        var e = load64(src_pd + i * 8);
        if ((e & 0x01) != 0) {
            if ((e & 0x04) != 0) {                # present AND user — never a kernel mirror entry
                var sphys = e & 0x000FFFFFFFE00000;
                var nphys = pmm_alloc_2mb();
                if (nphys == 0) { proc_free_address_space(dst_cr3); return 0; }
                # ⚠ Through the DIRECT MAP on both sides. The identity alias is reachable by a crafted
                # PT_LOAD (see the ptw_pd_kva header); a copy is exactly where reading the wrong frame
                # would be invisible, because the destination would still be perfectly well-formed.
                memcpy(pmm_kva_for_access(nphys), pmm_kva_for_access(sphys), 0x200000);
                var va = i * 0x200000;
                # ⚠ PRESERVE NX. Bit 63 is the sign bit in i64, so `e < 0` IS the NX test — Cyrius has
                # no unsigned type and `e & 0x8000000000000000` would be a negative literal. Losing it
                # would silently make a W^X-protected data page EXECUTABLE in the child.
                var mr = 0;
                if (e < 0) { mr = proc_map_page_nx(dst_cr3, va, nphys); }
                else       { mr = proc_map_page(dst_cr3, va, nphys); }
                if (mr != 0) {
                    pmm_free_2mb(nphys);
                    proc_free_address_space(dst_cr3);
                    return 0;
                }
            }
        }
    }

    # --- high mmap arena: per-process PDs at PDPT[128..511] ------------------------------------
    # Mirrors proc_free_address_space's teardown walk. A process that never mmap'd high finds all-zero
    # entries and this is one cheap 384-entry scan.
    var src_pml4e = load64(pmm_kva_for_access(src_cr3));
    var src_pdpt = src_pml4e & 0xFFFFFFFFF000;
    if (src_pdpt != 0) {
        var src_pdpt_kva = pmm_kva_for_access(src_pdpt);
        for (var hi = 128; hi < 512; hi = hi + 1) {
            var hpe = load64(src_pdpt_kva + hi * 8);
            if ((hpe & 0x01) != 0) {
                if ((hpe & 0x04) != 0) {          # present AND user — a per-process arena PD
                    var hpd_kva = pmm_kva_for_access(hpe & 0xFFFFFFFFF000);
                    for (var hj = 0; hj < 512; hj = hj + 1) {
                        var he = load64(hpd_kva + hj * 8);
                        if ((he & 0x01) != 0) {
                            if ((he & 0x04) != 0) {
                                var hsrc = he & 0x000FFFFFFFE00000;
                                var hnew = pmm_alloc_2mb();
                                if (hnew == 0) { proc_free_address_space(dst_cr3); return 0; }
                                memcpy(pmm_kva_for_access(hnew), pmm_kva_for_access(hsrc), 0x200000);
                                # VA reconstructed from the two indices: PDPT slot = 1 GB each.
                                var hva = hi * 0x40000000 + hj * 0x200000;
                                if (proc_map_page_hi(dst_cr3, hva, hnew) != 0) {
                                    pmm_free_2mb(hnew);
                                    proc_free_address_space(dst_cr3);
                                    return 0;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return dst_cr3;
}

fn proc_free_address_space(cr3) {
    if (cr3 == 0) { return 0 - 1; }
    if (cr3 == 0x1000) { return 0 - 1; }   # boot/kernel CR3 — never free its tables
    # 1.56.51: the whole teardown walk goes through the direct map — see the ptw_pd_kva header.
    var pml4e = load64(pmm_kva_for_access(cr3));
    var pdpt = pml4e & 0xFFFFFFFFF000;
    if (pdpt == 0) { return 0 - 1; }
    var pdpt_kva = pmm_kva_for_access(pdpt);
    var pdpte = load64(pdpt_kva);
    var pd = pdpte & 0xFFFFFFFFF000;
    if (pd == 0) { return 0 - 1; }
    var pd_kva = pmm_kva_for_access(pd);
    # Free user huge pages: present + user-bit set, across the FULL user PD range
    # 1..511 (covers ELF/stack AND the whole mmap arena 128..511). Supervisor
    # (kernel-mirror) and not-present entries are skipped; the index-511 stash
    # slot has no flag bits so it's skipped too.
    for (var i = 1; i < 512; i = i + 1) {
        var e = load64(pd_kva + i * 8);
        if ((e & 0x01) != 0) {
            if ((e & 0x04) != 0) {
                pmm_free_2mb(e & 0x000FFFFFFFE00000);
            }
        }
    }
    # 1.50.2 bite 1b — free the HIGH user mmap arena. proc_map_page_hi installs
    # per-process PDs at PDPT[128..511] (VA >= 128 GB) on demand; the 0-1 GB PD
    # sweep above only walks PDPT[0]'s PD, so without this every process that
    # touched the high arena would leak its PDs + 2 MB pages on exit. The kernel
    # never uses PDPT[128..511] on this machine (1.56.51: the direct map tops at
    # `directmap_pdpt_top`, recorded by pmm_setup_directmap — NOT the fixed PDPT[71] this comment
    # used to assert; see the USER_HIMMAP_BASE header), so any
    # entry here that is PRESENT + USER (proc_map_page_hi sets 0x07, kernel entries
    # are supervisor) is a per-process arena PD: free its present+user 2 MB pages,
    # then the PD page itself. Procs that never mmap'd high find all-zero entries
    # (one cheap 384-entry scan).
    for (var hpi = 128; hpi < 512; hpi = hpi + 1) {
        var hpe = load64(pdpt_kva + hpi * 8);
        if ((hpe & 0x01) != 0) {
            if ((hpe & 0x04) != 0) {
                var hpd = hpe & 0xFFFFFFFFF000;
                for (var hj = 0; hj < 512; hj = hj + 1) {
                    var he = load64(pmm_kva_for_access(hpd) + hj * 8);
                    if ((he & 0x01) != 0) {
                        if ((he & 0x04) != 0) {
                            pmm_free_2mb(he & 0x000FFFFFFFE00000);
                        }
                    }
                }
                ptpage_unregister(hpd);
                pmm_free(hpd);
            }
        }
    }
    # Free the three page-table pages (4 KB each).
    # ELF_PDE_PROBE: record every address-space FREE, before the pages go back to the allocator.
    #ifdef ELF_PDE_PROBE
    klug_append("asfree pml4=0x", 14);
    epp_hex(cr3);
    klug_append(" pdpt=0x", 8);
    epp_hex(pdpt);
    klug_append(" pd=0x", 6);
    epp_hex(pd);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    #endif
    # ⭐ SHOOT DOWN BEFORE THESE PAGES GO BACK TO THE ALLOCATOR. LIFO pmm_alloc hands the same PML4
    # straight back out, and without PCID a CR3 value is the only TLB tag — so any CPU still holding
    # entries for this address space would apply them to its successor. This is the fix for the
    # 2026-08-02 -smp 4 large-image fault.
    tlb_shootdown_all();
    ptpage_unregister(pd);
    ptpage_unregister(pdpt);
    ptpage_unregister(cr3);
    pmm_free(pd);
    pmm_free(pdpt);
    pmm_free(cr3);
    return 0;
}

# Reap an exited process: tear down its address space and hand its proc_table
# slot back. Called from sh_cmd_run after exec_and_wait returns (the program
# has exit()ed; kernel_resume already restored the boot CR3 and reset
# proc_current_get() to 0), so we are running on the boot CR3 — freeing the per-process
# tables is safe (the CPU is not walking them).
#
# Order matters for scheduler-safety on the single-core model: mark the slot
# dead (state 0) FIRST so a timer tick mid-reap can never select it (sched_next
# only returns state==1 procs), THEN detach its CR3 and free the pages. The
# interactive `run` path is run-to-completion and one-at-a-time, so the reaped
# proc is always the TOP slot (pid == proc_count-1); a LIFO proc_count decrement
# returns the slot to proc_create_full. Without this, each `run` permanently
# consumed 2 of the 6 usable 2 MB regions (code + stack) — so the 4th run hit
# pmm_alloc_2mb exhaustion ("run: not an executable") and, further out, the
# 16-slot proc_table filled. (The kmain/idle procs carry CR3 0x1000, so
# proc_free_address_space refuses them even if a stray pid 0/1 ever arrived.)
fn proc_reap(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    # 1.41.10: reclaim any fds the exiting process left open (POSIX exit()
    # semantics). Critical for VFS_SEC_WFILE write-fds — their finite 4-slot
    # pool would otherwise leak to permanent exhaustion (a buggy/malicious ring-3
    # program that opens write-fds and exits without close would DoS all
    # FAT/exFAT writes until reboot). vfs_close flushes + frees and is idempotent
    # (an already-FREE slot is a no-op, so a program that closed its own fds sees
    # a pure no-op). Safe under the single-foreground run-to-completion model: the
    # kernel shell closes its own fds synchronously, so at reap any non-FREE fd in
    # 3..31 belongs to the just-exited process. (Per-process fd ownership is a
    # prerequisite to generalize this for the future multi-threading/SMP arc.)
    # 1.47.x per-proc fd tables (2b): free THIS pid's own fd table (flush write-backs + release
    # flocks first), instead of sweeping the global. The per-proc table makes "any open fd
    # belongs to the exited proc" exact — no risk of touching the parent's fds (the very reason
    # proc_reap_child historically never swept). Replaces the old fd-3..31 vfs_close loop.
    # ⛔ 1.57.1 — DISARM RAW DISK WRITE ON EXIT. `blk_rw_armed` (core/syscall.cyr) gates
    # blk_write#78; blk_close_sys clears it, but a process that armed the gate and then DIED —
    # faulted, killed, or simply exited without closing — left it OPEN for whatever ran next. The
    # arm is a global with no owner, so exit is the only other place its lifetime can end.
    # ⚠ CLEARING ON ANY EXIT IS DELIBERATE AND CONSERVATIVE. There is no per-process ownership to
    # consult, so this fails CLOSED: an installer that is still running simply re-arms, which is one
    # syscall, whereas the alternative leaves a raw-disk write gate open across process boundaries.
    # ⛔ This is the codeable half ONLY. It does not make the arm a real privilege check —
    # BLK_RW_ARM_MAGIC is still a compile-time constant any ring-3 process can send, and replacing
    # it needs the per-process capability model agnos does not have. That half is an operator ruling,
    # not a fix; do not treat this line as closing it.
    # 1.56.55 — the second reap door. See the long banner in proc_reap_child: a reaped slot must
    # stop being its parent's child, or the parent's next `waitpid(-1)` re-matches this dead row
    # forever and never reaches its other children. This path is the FOREGROUND reap (agnsh `run`,
    # init's exec_and_wait), whose caller has already read the exit code — so the parent-child
    # relationship is fully discharged here too, and agnsh is itself a wait-any caller.
    # LIFO slot reclaim: hand the top dead slot back to the allocator.
    # ⭐ 1.57.7 (S7): the two reap doors share their body (proc_reap_slot, below) — the image bytes the lifecycle step needs.
    return proc_reap_slot(pid, 1);
}

# Reap a waited-on CHILD process (spawn / elf_load in-memory path, 1.42.x).
#
# The from-disk path (sh_cmd_run / kybernet_exec_agnsh) is the synchronous
# foreground model: exec_and_wait runs the child to completion ON the caller's
# stack, the kernel resumes, the caller reads the exit code and calls proc_reap.
# The IN-MEMORY path (syscall 3 spawn -> elf_load, then syscall 4 waitpid) is
# the PARENT/child model: the child is created ready, the SCHEDULER runs it, and
# the parent blocks in waitpid until the child's exit() sets state 0. Pre-1.42
# nothing ever reaped these — the child's address space (ELF + stack + any mmap
# huge pages) and proc_table slot leaked for the whole boot. waitpid now calls
# this AFTER it has captured the exit code, making the in-memory path symmetric
# with the from-disk path: slot + address space + ALL user pages reclaimed.
#
# Why a SEPARATE helper rather than reusing proc_reap: proc_reap's fd-reclaim
# loop (closes every non-FREE fd in 3..31) is correct ONLY under the single-
# foreground run-to-completion model, where any open fd at reap belongs to the
# just-exited program. In the parent/child model the PARENT is alive and may
# hold its own fds — sweeping 3..31 here would wrongly flush+free the parent's
# fds. The child's own fds are its responsibility to close on exit (POSIX
# exit() closes them; a future per-process fd table will let us reclaim a
# child's leaked fds without touching the parent's). So this reap does the
# address-space + slot reclaim only, leaving the fd table alone.
#
# Scheduler-safety mirrors proc_reap: the child is already dead (waitpid only
# returns once proc_get_state(pid)==0), so sched_next can never select it; and
# the child's per-process CR3 is distinct from the parent's, so freeing its page
# tables never frees tables the CPU is currently walking. We mark state 0
# (idempotent) before detaching/freeing for the same ordering guarantee.
fn proc_reap_child(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    if (pid == proc_current_get()) { return 0 - 1; }   # never reap the running proc here
    # 1.47.x per-proc fd tables (2b): free the child's OWN fd table. do_flush=0 matches this
    # path's prior behavior (it never swept fds — the global table was shared, so it couldn't
    # safely close the parent's; the per-proc table removes that coupling). The child's table
    # is a separate kmalloc'd copy, so freeing it never touches the parent's fds.
    # ⛔⛔ 1.56.55 — A REAPED SLOT MUST STOP BEING ITS PARENT'S CHILD, AND UNTIL NOW IT DID NOT.
    # `proc_ppid` was cleared in exactly ONE place — proc_alloc_slot's recycle scrub (the 1.50.7
    # line, "recycled slot must not inherit a stale parent") — and that runs at slot REUSE, not at
    # reap. So a NON-TOP child survived its own reap still carrying `ppid == parent` AND `state == 0`,
    # which is verbatim the predicate `waitpid`#4's wait-any arm scans for (syscall.cyr, `arg1 < 0`).
    # The parent's next `waitpid(-1)` matched that same dead slot again, returned its stale exit code
    # again, and never advanced to a second child — `-2` (children live) and `-1` (no children) both
    # became unreachable, every other child went unreaped, and their FULL-COPY address spaces and
    # slots leaked until the 16-slot table filled. Exactly the fork-per-connection shape agora runs.
    # ⚠ NOT a double-free: proc_destroy_fd_table early-returns on a NULL base and cr3 is already
    # 0x1000 by then, so the re-reap was SILENT. A loud failure would have been found years earlier.
    # ⭐ THE GATE THAT SHIPPED WITH WAIT-ANY COULD NOT SEE IT. `tests/fork/forker.cyr` forked exactly
    # ONE child, and one child is the TOP slot — the LIFO collapse below deletes the row, so the
    # phantom cannot exist. It takes TWO children to appear; that is what the FORK-MULTI phase adds.
    # ⛔ AND EVEN TWO CHILDREN DID NOT SHOW IT AT FIRST, because proc_alloc_slot's zombie-reuse bug
    # (fixed in the same cut — see the guard there) handed BOTH children the same slot, so the
    # phantom could not form. The recycle defect MASKED this one. With the guard in and this line
    # removed the phase reports FORK-MULTI-DUP; with both in it passes. Both were measured.
    # ⚠ The same clear is in `proc_reap` for the same reason. The invariant is "a reaped slot is
    # nobody's child", and it has to hold on BOTH reap doors or it returns through the other one:
    # agnsh reaps its foreground jobs via proc_reap and is itself a wait-any caller.
    # LIFO slot reclaim: hand the top dead slot back to the allocator (same rule as proc_reap —
    # ONLY the topmost slot collapses). A non-top child that exits early keeps its slot until the
    # slots above it drain; proc_alloc_slot (1.44.12) reuses that hole so nothing leaks. The address
    # space + pages are freed regardless. NOTE: a multi-collapse "while trailing-dead" was tried at
    # 1.44.15 and REVERTED — it would reclaim the slot of an EXITED-BUT-NOT-YET-`waitpid`'d proc when
    # a later reap trailed into it, so the parent's pending waitpid(pid) would find the proc gone
    # (pid >= proc_count -> -1) and its address space would leak. A proc's slot must persist until
    # ITS OWN waitpid reaps it. (Multi-background-jobs validated WITHOUT it — agnsh-multijob-test.)
    return proc_reap_slot(pid, 0);
}
# THE SHARED REAP BODY (1.57.7 S7 — both doors' statements, in their order; the comments above each door explain them).
# full = 1: proc_reap (flush the fd table's write-backs, the unconditional raw-disk disarm, the current-proc reset).
fn proc_reap_slot(pid, full) {
    proc_destroy_fd_table(pid, full);
    if (full == 1) { blk_rw_armed = 0; }
    var cr3 = proc_get_cr3(pid);
    proc_set_state(pid, 0);                 # dead — scheduler skips it (set before free)
    if (full == 1) { if (proc_current_get() == pid) { proc_current_set(0); } }
    proc_set_cr3(pid, 0x1000);              # detach the stale per-process CR3
    proc_reap_off_cpu_fence(pid);           # GAP-C: wait out any in-flight restore before freeing
    kstack_hw_scan();                       # 1.57.6 (S3-fix): KSTACK_HW — no CPU is on pid's stack now (a no-op twin otherwise)
    if (cr3 != 0x1000) { proc_free_address_space(cr3); }
    store64(&proc_ppid + pid * 8, 0);       # 1.56.55: a reaped slot is nobody's child (both doors)
    proctab_spin_lock();   # 1.46.x SMP sub-bite 3: proc_count decrement vs proc_alloc_slot's bump
    if (pid == proc_count - 1) { proc_count = proc_count - 1; }
    proctab_spin_unlock();
    return 0;
}

# Retrieve user CR3 from kernel page tables (stored in PD entry 511)
fn proc_get_user_cr3(kernel_cr3) {
    if (kernel_cr3 == 0x1000) { return 0x1000; }  # Boot page tables, no KPTI
    var pd_kva = ptw_pd_kva(kernel_cr3);          # 1.56.51: direct-map walk, never an identity VA
    # ⛔ A BROKEN CHAIN RETURNS kernel_cr3, NOT 0. This value's only consumer is
    # pcpu_kpti_user_cr3, which the SYSCALL exit stub loads straight into CR3
    # (syscall_hw.cyr `mov r10,[r8*8+&pcpu_kpti_user_cr3]; mov cr3,r10`) — so returning 0 here
    # would be a guaranteed triple fault on the next syscall. KPTI has been COLLAPSED since
    # 1.40.3 (PD[511] stashes new_pml4, i.e. this same CR3), so kernel_cr3 is the self-consistent
    # answer and is what a healthy walk returns anyway. Unreachable in practice — every CR3 from
    # proc_create_address_space has a non-zero PML4[0]/PDPT[0] — but the fallback must be the
    # safe one, not the loud one.
    if (pd_kva == 0) { return kernel_cr3; }
    var stash = load64(pd_kva + 511 * 8);
    if (stash == 0) { return kernel_cr3; }        # same reasoning: never hand back 0
    return stash;
}

# 1.50.7: the proc's REAL parent pid (was a stub returning 0 always, which left kill#16's
# "may only signal your children" gate inert — a non-init proc could effectively only
# signal itself). Recorded at proc_create_user from the creator pid; 0 (= init) for kernel
# threads and unset slots. Read by the kill#16 gate (syscall.cyr) + fault_kill_current's
# SIGCHLD-to-parent (syscall.cyr).
fn proc_get_ppid(pid) {
    if (pid >= proc_count) { return 0 - 1; }
    return load64(&proc_ppid + pid * 8);
}

# 1.50.7: the kill#16 authorization predicate, EXTRACTED so it has one definition the
# selftest exercises (the gate was previously inline in ksyscall, untestable). Returns 1 if
# `caller` may post a signal to `target`, else 0. Capability/ownership policy — NOT Unix
# uid/pgid ([[project_agnos_auth_posture]]):
#   • init (pid 0) may signal ANY proc.
#   • a non-init caller may signal ONLY itself or its own DIRECT child (proc_get_ppid==caller).
#   • init may be signalled ONLY by itself (subsumed by the child rule — target 0's parent is
#     0, so a non-init caller fails it — but the explicit early-out documents the intent).
# GUARDRAIL: child-only AUTHORITY; descendants-only REACH via KILL_TREE (operator ruling 2026-09-23); still no
# process-group / session reach (that WOULD be projection).
# Behavior-preserving refactor of the prior inline ksyscall #16 gate (arg1 bounds + sig
# validation stay at the call site — they validate syscall args, not authorization policy).
# ⭐ 1.57.7 (S7, D-30): the child clause is EPOCH-VALIDATED (sig_auth_ok): a recycled parent slot inherits no
# authority over its predecessor's live orphans — with SIGKILL that would be kill authority over a stranger.
fn proc_may_signal(caller, target) {
    if (spawn_pid_ok(caller) == 0) { return 0; }
    if (target < 0) { return 0; }
    if (target >= proc_count) { return 0; }
    return sig_auth_ok(caller, target, load64(&proc_ppid + target * 8), load64(&proc_ppid_epoch + target * 8), proc_epoch_get(caller));
}

# 1.50.8: the waitpid#4 ownership predicate — sibling of proc_may_signal, same proc_ppid
# infra. Returns 1 if `caller` may REAP `target` (collect its exit code + free its slot +
# address space), else 0. Only the parent reaps its child: a non-parent reaping would steal
# the exit code AND collapse the slot out from under the real parent's pending waitpid.
#   • init (pid 0) may reap ANY proc — the orphan reaper (a child whose parent already exited).
#   • a non-init caller may reap ONLY its own DIRECT child (proc_get_ppid(target) == caller).
# There is NO "self" clause (unlike proc_may_signal): waitpid#4 already rejects target==caller
# at the call site. Unblocked by 1.50.7's real proc_get_ppid (this gate was inert — and so
# deferred at the 1.44.22 audit — while the getter stubbed 0, which would have meant "only
# init may reap" → broke agnsh `&`-job reaping; now agnsh IS the parent of its `&` jobs, so
# it reaps them and a stranger cannot). GUARDRAIL: child-only, no process-group reach.
# ⭐ 1.57.7 (S7): epoch-validated like proc_may_signal (reap_auth_ok).
fn proc_may_reap(caller, target) {
    if (spawn_pid_ok(caller) == 0) { return 0; }
    if (target < 0) { return 0; }
    if (target >= proc_count) { return 0; }
    return reap_auth_ok(caller, load64(&proc_ppid + target * 8), load64(&proc_ppid_epoch + target * 8), proc_epoch_get(caller));
}

#ifdef TEST
# (1.57.7 S7: every kernel signal-bit site now ORs through atomic_or64 directly — proc_sig_locked, SIGCONT's bit 18,
# SIGCHLD at death — so this helper's only caller is ktest's test_proc; it ships only in TEST builds.)
# ⭐ 1.57.7 (S7, D-4): the pending-bit OR is ATOMIC (lock or) — a plain RMW here raced vfs_read_signalfd's clear.
fn proc_send_signal(pid, sig) {
    if (pid < 0) { return 0 - 1; }
    if (pid >= proc_count) { return 0 - 1; }
    if (sig < 0) { return 0 - 1; }
    if (sig >= 64) { return 0 - 1; }
    atomic_or64(&proc_signals + pid * 8, 1 << sig);
    return 0;
}
#endif

# ═══════════════ 1.57.7 (S7) — LIFECYCLE IDENTITY + PURE PREDICATES (docs/architecture/process-lifecycle.md) ═══════════
# Hermetic where possible (the lc_* / *_auth_ok / desc_walk / wstat / zombie_pred forms take every input as a
# parameter) so ktest's [lifecycle] section drives each decision row with synthetic inputs. States (proc_table +8):
# 0 dead (reaped/free OR an exited, unreaped zombie) · 1 ready · 2 running · 3 claiming/birth · 4 DYING · 5 STOPPED ·
# 6 BLOCKED · (7 is never stored: #99's report-only ZOMBIE).
# A user process: in the table, with its own address space (kmain, the idles and the kthreads run on 0x1000).
fn proc_is_user(pid) {
    if (pid < 0) { return 0; }
    if (pid >= proc_count) { return 0; }
    var iu_c = proc_get_cr3(pid);
    if (iu_c == 0) { return 0; }
    if (iu_c == 0x1000) { return 0; }
    return 1;
}
# Is c a child of THIS incarnation of p? (ppid AND the epoch it recorded at birth.)
fn proc_is_child_of(c, p) {
    if (c < 0) { return 0; }
    if (p < 0) { return 0; }
    if (c >= proc_count) { return 0; }
    if (p >= proc_count) { return 0; }
    if (c == p) { return 0; }
    if (lc_pp(c) != p) { return 0; }
    if (lc_pep(c) != proc_epoch_get(p)) { return 0; }
    return 1;
}
# kill#16 authority: init -> anyone · nobody else -> init · self · an epoch-valid DIRECT child. (D4: child-only.)
fn sig_auth_ok(caller, target, t_ppid, t_pep, caller_ep) {
    if (caller == 0) { return 1; }
    if (target == 0) { return 0; }
    if (target == caller) { return 1; }
    if (t_ppid == caller) { if (t_pep == caller_ep) { return 1; } }
    return 0;
}
# waitpid#4 authority: init -> anyone · an epoch-valid direct child. (No self clause: the call sites refuse t == me.)
fn reap_auth_ok(caller, t_ppid, t_pep, caller_ep) {
    if (caller == 0) { return 1; }
    if (t_ppid == caller) { if (t_pep == caller_ep) { return 1; } }
    return 0;
}
# Is the parent INCARNATION (pp, my_pep) alive? kmain (pp 0) never dies. A parent whose final death hold ran
# (pp_done) is gone even while its slot still reads 2/4 (it is reaping itself — D-32).
# ENDFIX (S7-R1): a CLAIMING slot (state 3) is being recycled for a NEW incarnation — never an existing process's
# parent, whatever its epoch/done cells read mid-allocation.
fn lc_parent_live(pp, n, pp_st, pp_ep, my_pep, pp_done) {
    if (pp == 0) { return 1; }
    if (pp < 0) { return 0; }
    if (pp >= n) { return 0; }
    if (pp_st == 0) { return 0; }
    if (pp_st == 3) { return 0; }
    if (pp_ep != my_pep) { return 0; }
    if (pp_done != 0) { return 0; }
    return 1;
}
# Is a dying process with parent pp an orphan (nobody will read its status)? kmain's children never are (kmain reaps
# them through fgwait — kernel_run_child).
fn lc_orphan(pp, n, pp_st, pp_ep, my_pep, pp_done) {
    if (pp == 0) { return 0; }
    return 1 - lc_parent_live(pp, n, pp_st, pp_ep, my_pep, pp_done);
}
# lc_orphan over the live arrays (out of range -> 1: no parent anyone can name). proc_parent_live is its complement.
fn proc_orphan_of(t) {
    if (t < 0) { return 1; }
    if (t >= proc_count) { return 1; }
    var pl_pp = lc_pp(t);
    var pl_st = 0;
    var pl_ep = 0;
    var pl_dn = 0;
    if (pl_pp >= 0) {
        if (pl_pp < 16) { pl_st = lc_st(pl_pp); pl_ep = proc_epoch_get(pl_pp); pl_dn = lc_done(pl_pp); }
    }
    return lc_orphan(pl_pp, proc_count, pl_st, pl_ep, lc_pep(t), pl_dn);
}
fn proc_parent_live(t) { return 1 - proc_orphan_of(t); }
# BINDING (S7): a user process whose parent waits on it in the foreground (execwait#37 / kmain's kernel_run_child —
# proc_fgwait[ppid] == t + 1) cannot be stopped. kmain waits on /bin/agnsh, so agnsh is unstoppable.
fn proc_stoppable(t) {
    if (proc_is_user(t) == 0) { return 0; }
    if (proc_fgwait_get(lc_pp(t)) == t + 1) { return 0; }
    return 1;
}
# Is q a (strict) descendant of root, following EPOCH-VALID links only? Bounded (16 hops — the whole table) and
# cycle-safe. A dead-but-unreaped intermediate still links (its epoch is unchanged until its slot is recycled); a
# reaped one has ppid 0, so its orphans are unreachable from the old root (documented; no reparenting).
fn desc_walk(q, root, pa, pea, ea, n) {
    if (q == root) { return 0; }
    var dw_x = q;
    var dw_i = 0;
    while (dw_i < 16) {
        if (dw_x < 0) { return 0; }
        if (dw_x >= n) { return 0; }
        var dw_p = load64(pa + dw_x * 8);
        if (dw_p < 0) { return 0; }
        if (dw_p >= n) { return 0; }
        if (dw_p == dw_x) { return 0; }                                      # malformed self-parent
        if (load64(pea + dw_x * 8) != load64(ea + dw_p * 8)) { return 0; }    # the link must name the CURRENT incarnation
        if (dw_p == root) { return 1; }
        if (dw_p == 0) { return 0; }                                         # reached init without meeting root
        dw_x = dw_p;
        dw_i = dw_i + 1;
    }
    return 0;
}
fn proc_is_descendant(q, root) { return desc_walk(q, root, &proc_ppid, &proc_ppid_epoch, &proc_epoch, proc_count); }
# The wait status (D2): a death by signal -> 0x100 | sig (SIGKILL 265, SIGXCPU 280); otherwise code & 0xFF (an exit's
# low byte; a fault keeps 128 + vector = 142). Every value is >= 0, so a reaped child never reads as -1 / -2.
fn wstat_encode(code, sig) {
    if (sig != 0) { return WSTAT_SIGNALED | (sig & 0xFF); }
    return code & 0xFF;
}
fn proc_wait_status(pid) {
    if (pid < 0) { return 0 - 1; }
    if (pid >= 16) { return 0 - 1; }
    return wstat_encode(load64(&proc_table + pid * 176 + 168), load64(&proc_term_sig + pid * 8));
}
# Is dead slot i an exited, UNREAPED child someone will still collect? (#99 lists it as state 7.) plive is the
# parent incarnation's liveness (proc_parent_live: lc_parent_live over the live arrays — its rows are T-L12's).
fn zombie_pred(st, pp, plive, fg_names_me) {
    if (st != 0) { return 0; }
    if (fg_names_me == 1) { return 1; }
    if (pp > 0) { if (plive == 1) { return 1; } }
    return 0;
}
fn proc_is_zombie(i) {
    if (i < 0) { return 0; }
    if (i >= proc_count) { return 0; }
    var iz_pp = lc_pp(i);
    var iz_fg = 0;
    if (iz_pp == 0) { if (proc_fgwait_get(0) == i + 1) { iz_fg = 1; } }
    return zombie_pred(lc_st(i), iz_pp, proc_parent_live(i), iz_fg);
}
# chan_auth's PTY-descendant test over explicit tables (the owner itself, or an epoch-valid descendant).
fn chan_pty_desc_pure(owner, cur, pa, pea, ea, n) {
    if (cur == owner) { return 1; }
    return desc_walk(cur, owner, pa, pea, ea, n);
}
# ── The decision tables. Every lifecycle transition decision lives here so ktest T-L12 drives its rows. ──
# kill: 0 NOOP (dead/dying — a zombie keeps its status) · 1 MARK (a birth: dies at its first boundary) · -1 REFUSE
# (not a user process) · 2 CLAIM (off-CPU, saved from ring 3: torn down here) · 3 WAKE_KICK (stopped, not claimable:
# 5 -> 1, it runs to a boundary and dies there) · 4 INTERRUPT (blocked: its wait returns WR_SIGNAL) · 5 KICK.
fn lc_kill_action(st, user, claimable) {
    if (st == 0) { return 0; }
    if (st == 4) { return 0; }
    if (st == 3) { return 1; }
    if (user == 0) { return 0 - 1; }
    if (claimable == 1) { return 2; }
    if (st == 5) { return 3; }
    if (st == 6) { return 4; }
    return 5;
}
# stop: 0 NOOP · 6 PEND_BIRTH · -1 REFUSE (not user / not stoppable / no live parent — D-33) · 2 CLAIM_STOP (1 -> 5)
# · 4 PEND_INTERRUPT · 5 PEND_KICK. A pending kill wins: a process about to die is never parked (crit (b)).
fn lc_stop_action(st, user, kp, stoppable, plive, claimable) {
    if (st == 0) { return 0; }
    if (st == 4) { return 0; }
    if (kp != 0) { return 0; }
    if (st == 3) { return 6; }
    if (user == 0) { return 0 - 1; }
    if (stoppable == 0) { return 0 - 1; }
    if (plive == 0) { return 0 - 1; }
    if (st == 5) { return 0; }
    if (claimable == 1) { return 2; }
    if (st == 6) { return 4; }
    return 5;
}
# tick (the CPL3-interrupted current): 1 DIE · 0 NONE · 3 DROP (the stop no longer applies: clear it) · 2 STOP.
fn lc_tick_action(kp, sp, stoppable, plive) {
    if (kp != 0) { return 1; }
    if (sp == 0) { return 0; }
    if (stoppable == 0) { return 3; }
    if (plive == 0) { return 3; }
    return 2;
}
# park (B1 / a wait's signal point): 1 ABORT · 0 CONTINUE · 3 DROP · 4 PREEMPT_HELD (a kernel bug) · 2 PARK.
fn lc_park_action(kp, sp, stoppable, plive, preempt) {
    if (kp != 0) { return 1; }
    if (sp == 0) { return 0; }
    if (stoppable == 0) { return 3; }
    if (plive == 0) { return 3; }
    if (preempt != 0) { return 4; }
    return 2;
}
# birth: 0 REFUSE (the creator has a pending kill) · 2 OK_INHERIT_STOP (the creator is TREE-stopped) · 1 OK.
fn lc_birth_action(ckp, csp) {
    if (ckp != 0) { return 0; }
    if (csp == 2) { return 2; }
    return 1;
}
# Hand back a slot whose process never ran (a refused birth, fork's early failures): under proctab_lock, so the reuse
# scan never sees a half-cleared row. on_cpu is -1 (it never ran). LIFO collapse when it is the top.
fn proc_slot_release_unborn(idx) {
    if (idx < 0) { return 0 - 1; }
    if (idx >= proc_count) { return 0 - 1; }
    proctab_spin_lock();
    store64(&proc_ppid + idx * 8, 0);
    store64(&proc_ppid_epoch + idx * 8, 0);
    store64(&proc_table + idx * 176 + 160, 0x1000);
    lc_sp_set(idx, 0);
    store64(&proc_kill_pending + idx * 8, 0);
    lc_st_set(idx, 0);
    if (idx == proc_count - 1) { proc_count = proc_count - 1; }
    proctab_spin_unlock();
    return 0;
}
# Hot-path self tests (one load each): the legacy wait loops poll the first; sys_pause checks the second.
# (kind 1: a kill pending · kind 2: a kill or a stop pending.) The legacy loops poll kind 1; sys_pause checks kind 2.
fn lc_self_pending(kind) {
    var kr_me = proc_current_get();
    if (spawn_pid_ok(kr_me) == 0) { return 0; }
    var kr_v = lc_kp(kr_me);
    if (kind == 2) { kr_v = kr_v | lc_sp(kr_me); }
    if (kr_v != 0) { return 1; }
    return 0;
}
fn proc_kill_requested_self() { return lc_self_pending(1); }
fn lifecycle_pending_self() { return lc_self_pending(2); }

fn proc_check_pending_signals(pid) {
    if (pid >= proc_count) { return 0; }
    var sig_pending = load64(&proc_signals + pid * 8);
    var sig_mask = load64(&proc_sigmask + pid * 8);
    # Check for unmasked pending signals
    var unmasked = sig_pending & (0 - 1 - sig_mask);
    if (unmasked != 0) {
        pending_signal_flag = 1;
    }
    return unmasked;
}

# Invalidate the TLB entry for a single virtual address. `va` is the first
# param (at [rbp-8] per the Cyrius calling convention, same shape as cr3_load).
# proc_map_page flips a previously NOT-PRESENT arena PDE to present; without
# this flush a stale (negative/global) 2 MB TLB entry for `virt` can survive,
# and on a multi-page mmap that desyncs the freshly-installed mapping (the
# first-mmap-return RIP=0 class). vmm_map's own invlpg is dead on the mmap path
# (pt_init pre-maps all 512 boot-PD slots, so vmm_is_mapped is always true).
fn invlpg_va(va) {
    asm {
        0x48; 0x8B; 0x45; 0xF8;   # mov rax, [rbp-8]  (va)
        0x0F; 0x01; 0x38;         # invlpg [rax]
    }
    return 0;
}

# Which process slot owns this address space? -1 if none. (1.56.59, telemetry §5.)
#
# ⛔ THE BOOT/KERNEL CR3 IS REFUSED OUTRIGHT, and that guard is load-bearing rather than defensive:
# `proc_create_full` and friends store 0x1000 as the DEFAULT cr3 (this file, three sites), so several
# slots carry it at once and a lookup would match whichever came first — attributing kernel mappings
# to an arbitrary process. Mappings into the boot address space are not any process's RSS.
# ⚠ Live slots only (`state != 0`): a dead slot's stale cr3 must not capture a live mapping.
fn proc_slot_of_cr3(cr3) {
    if (cr3 == 0x1000) { return 0 - 1; }
    if (cr3 == 0) { return 0 - 1; }
    var si = 0;
    while (si < 16) {
        if (load64(&proc_table + si * 176 + 8) != 0) {
            if (load64(&proc_table + si * 176 + 160) == cr3) { return si; }
        }
        si = si + 1;
    }
    return 0 - 1;
}

# Resident size of a process, in 4 KiB pages — COMPUTED FROM THE PAGE DIRECTORY, not accounted.
#
# ⭐ THE FILING CALLED THIS RIGHT: "the kernel must already know each address space's extent to tear it
# down, so this may be recording a number it COMPUTES rather than new accounting." It is. The PD holds
# the answer; walking it is the whole implementation.
#
# ⛔ THE INCREMENTAL VERSION WAS TRIED FIRST AND CANNOT WORK — recorded so it is not re-attempted.
# Charging at `proc_map_page` fails because the ELF loaders call `proc_create_address_space()` and map
# every segment into the new cr3 BEFORE `proc_set_cr3(new_pid, new_cr3)` binds it to a slot (elf.cyr —
# the mapping loop sits ~250 lines above the bind). At charge time NO slot owns that cr3, so every
# charge is dropped and the counter reads 0 for every process. Measured.
#
# ⭐ MEASURED TOPOLOGY (1.56.59, via a RSS_PROBE build that dumped the walk for every live slot):
#     pid=6 cr3=ffd7000  pml4e=ffd6027  pdpte=ffd5027  pd=ffd5000  present=129  user=3
#     pid=5 cr3=ffda000  pml4e=ffd9027  pdpte=ffd8027  pd=ffd8000  present=130  user=4
#     pid<=4 cr3=1000 (the BOOT address space) present=512 user=0
# ⇒ PML4[0] -> PDPT[0] -> PD is exactly right, and `present` is ~129 because
# `proc_create_address_space` fills PD[0..7] kernel-identity and PD[8..63] identity-SUPERVISOR
# (flag 0x83 — no US bit). Only the loader's `0x87`/`0x85` mappings carry US, which is why the US test
# is the whole discriminator: without it every process would report ~258 MB of "resident" kernel window.
#
# ⚠ ENTRY 511 IS SKIPPED: it holds the raw user-PML4 for KPTI (`proc_get_user_cr3` reads it), not a
# PDE. It happens to have bit 0 clear so it would not count anyway — but that is luck of the address,
# not a guarantee, and a future allocator could hand out a page whose low bits alias P|US.
# ⚠ COST: one 511-entry walk per process per call. `proclist`#99 is a monitor's ~1 Hz sample over <=16
# slots, so ~8 K loads/sec worst case — below anything this kernel notices, and paid only by askers.
# ⭐ 1.57.7 (S8): #99's RSS now INCLUDES THE HIGH ARENA (PDPT[128..511]) — it was low-arena only, so a high-arena
# user under-reported — and it is the SAME walk the memory cap measures (proc_user_pages_cr3), so the two can never
# disagree. Not counted (not user PDEs): shm#71 buffers, #86 GPU slots, channel rings, pipe buffers, page tables,
# kernel stacks.
fn proc_rss_pages(pid) {
    if (pid < 0) { return 0; }
    if (pid >= 16) { return 0; }
    if (load64(&proc_table + pid * 176 + 8) == 0) { return 0; }   # dead slot
    return proc_user_pages_cr3(load64(&proc_table + pid * 176 + 160));
}

# ⭐ 1.57.7 (S8) — THE FOOTPRINT WALK. A page-table pointer the walk may follow: 4 KB aligned and inside the
# page-table pool [0x400000, 0x10000000) that pmm_alloc draws from (pmm.cyr). #99 walks FOREIGN tables with no lock,
# so a table freed by a concurrent reap yields a stale count, never a dereference outside the pool (pmm_page_valid
# is not a bound: it spans all RAM, holes included). Every pointer is checked BEFORE pmm_kva_for_access.
fn ptw_pt_ok(p) {
    if ((p & 0xFFF) != 0) { return 0; }
    if (p < 0x400000) { return 0; }
    if (p >= 0x10000000) { return 0; }
    return 1;
}
# The kernel VA of the table a PRESENT entry `e` names (and USER too when `u`), or 0.
fn ptw_next(e, u) {
    if ((e & 1) == 0) { return 0; }
    if (u != 0) { if ((e & 4) == 0) { return 0; } }
    var pn_t = e & 0xFFFFFFFFF000;
    if (ptw_pt_ok(pn_t) == 0) { return 0; }
    return pmm_kva_for_access(pn_t);
}
# Present+user 2 MB entries among pd[0..n) (pd = a kernel VA from ptw_next, 0 = none).
fn ptw_pd_users(pd, n) {
    if (pd == 0) { return 0; }
    var pu_c = 0;
    var pu_k = 0;
    while (pu_k < n) {
        if ((load64(pd + pu_k * 8) & 5) == 5) { pu_c = pu_c + 1; }
        pu_k = pu_k + 1;
    }
    return pu_c;
}
# The mapped user memory of an address space in 4 KiB pages: 512 x the present+user 2 MB PDEs of the low PD
# (PML4[0] -> PDPT[0] -> PD[0..510]; 511 is the KPTI stash) plus every present+user PDPT[128..511] PD (the high
# arena) — the walk proc_free_address_space tears down. 0 for cr3 0 / 0x1000 (the boot space) / out of the pool.
fn proc_user_pages_cr3(cr3) {
    if (ptw_pt_ok(cr3) == 0) { return 0; }
    var up_pdpt = ptw_next(load64(pmm_kva_for_access(cr3)), 0);
    if (up_pdpt == 0) { return 0; }
    var up_n = ptw_pd_users(ptw_next(load64(up_pdpt), 0), 511);
    var up_h = 128;
    while (up_h < 512) {
        up_n = up_n + ptw_pd_users(ptw_next(load64(up_pdpt + up_h * 8), 1), 512);
        up_h = up_h + 1;
    }
    return up_n * 512;
}
# 1 iff the 2 MB PDE mapping `va` (< 512 GB: PDPT[va >> 30] -> PD[(va >> 21) & 511]) is present in `cr3`; an absent
# PDPT/PD entry (or one outside the pool) is 0. sys_mmap's no-overwrite rule.
fn proc_va_present_2mb(cr3, va) {
    if (ptw_pt_ok(cr3) == 0) { return 0; }
    var vp_pdpt = ptw_next(load64(pmm_kva_for_access(cr3)), 0);
    if (vp_pdpt == 0) { return 0; }
    var vp_pd = ptw_next(load64(vp_pdpt + ((va >> 30) & 511) * 8), 0);
    if (vp_pd == 0) { return 0; }
    return load64(vp_pd + ((va >> 21) & 511) * 8) & 1;
}

fn proc_map_page(cr3, virt, phys) {
    # Get PD address from PML4 → PDPT → PD chain (x86 — see #ifdef above).
    # 1.56.51: through the direct map — see the ptw_pd_kva header for why identity is unsafe here.
    var pd_kva = ptw_pd_kva(cr3);
    if (pd_kva == 0) { return 0 - 1; }
    # Write PD entry in kernel page tables
    var pd_idx = (virt >> 21) & 0x1FF;
    store64(pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x87);
    # S8 (KPTI): also map in user page tables so ring-3 can access user pages
    var u_cr3 = load64(pd_kva + 511 * 8);
    if (u_cr3 != 0) {
        var u_pd_kva = ptw_pd_kva(u_cr3);
        if (u_pd_kva != 0) {
            store64(u_pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x87);
        }
    }
    invlpg_va(virt);            # flush the (possibly stale not-present) 2 MB TLB entry
    return 0;
}

# proc_map_page_nx(cr3, virt, phys) — like proc_map_page, but maps the page
# NON-EXECUTABLE (NX, bit 63 set: flag 0x8000000000000087 = the canonical user
# data/stack flag from vmm.cyr). 1.50.5 W^X: used by sys_mmap for the LOW anonymous
# arena (pure heap data — a program never executes its mmap'd memory), so a heap
# spray can't be jumped into. (EFER.NXE is set at boot — boot_shim.cyr.) Code stays
# on proc_map_page (0x87, executable). Every site that later EXTRACTS phys from one
# of these PDEs must mask with 0x000FFFFFFFE00000 (bits 21-51), NOT 0xFFFF...E00000,
# or it would grab the NX bit and free/read a corrupt address.
# proc_map_page_rx(cr3, virt, phys) — READ-ONLY + EXECUTABLE user page. The missing half of W^X.
#
# ⛔⛔ 1.56.51 — "W^X" WAS ONLY EVER HALF ENFORCED, AND THE COMMENTS CLAIMED OTHERWISE. 1.50.6 made
# DATA non-executable (proc_map_page_nx, NX bit set) and stopped there. Code kept using
# proc_map_page, whose flag word is `0x87` = P | **RW** | US | PS — present, user, huge, and
# WRITABLE, with NX clear. So every ELF text page was mapped WRITABLE AND EXECUTABLE: the exact
# state W^X exists to prevent, in the one mapping where it matters most. "Writable XOR executable"
# with the executable half never made read-only is not W^X, it is NX.
# ⭐ A THIRD MODE, NOT A CHANGE TO proc_map_page. That function is still the right mapping for the
# several DATA pages that legitimately need RW and are not ELF text — ring3.cyr's selftest stack
# (:277) and main.cyr's counter/witness pages. Flipping its bits would have broken those silently.
# Only the two ELF loaders' PF_X arms move here.
# ⚠ 0x85 = P | US | PS with RW CLEARED and NX CLEAR. The loader is unaffected: it fills the page
# through `pmm_kva_for_access(phys)` — the KERNEL identity/direct-map alias, a different PDE — so the
# user mapping being read-only does not block the copy. Verified: the exec-from-disk and agnsh smokes
# both pass with text read-only.
# ⚠ Measured before landing: across 166 agnos-target binaries the toolchain emits `R-X @0x400000`
# and `RW- @0x600000` (or 0x800000) — segment permissions never share a 2 MB page, which is what
# makes this enforceable at PDE granularity at all. 1.57.2, measured: build/rootfs/bin holds 0/48 RWX
# binaries — the only RWX PT_LOADs ever loaded were main.cyr's two hand-built selftest ELFs (now R|X),
# and both loaders REFUSE that shape outright (elf.cyr, mutation-locked by ring3-smoke's `wx:` gate).
fn proc_map_page_rx(cr3, virt, phys) {
    var pd_kva = ptw_pd_kva(cr3);                 # 1.56.51: direct-map walk (see ptw_pd_kva header)
    if (pd_kva == 0) { return 0 - 1; }
    var pd_idx = (virt >> 21) & 0x1FF;
    store64(pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x85);
    var u_cr3 = load64(pd_kva + 511 * 8);
    if (u_cr3 != 0) {
        var u_pd_kva = ptw_pd_kva(u_cr3);
        if (u_pd_kva != 0) {
            store64(u_pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x85);
        }
    }
    invlpg_va(virt);
    return 0;
}

fn proc_map_page_nx(cr3, virt, phys) {
    var pd_kva = ptw_pd_kva(cr3);                 # 1.56.51: direct-map walk (see ptw_pd_kva header)
    if (pd_kva == 0) { return 0 - 1; }
    var pd_idx = (virt >> 21) & 0x1FF;
    store64(pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x8000000000000087);
    var u_cr3 = load64(pd_kva + 511 * 8);
    if (u_cr3 != 0) {
        var u_pd_kva = ptw_pd_kva(u_cr3);
        if (u_pd_kva != 0) {
            store64(u_pd_kva + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x8000000000000087);
        }
    }
    invlpg_va(virt);
    return 0;
}

# === ELF_PDE_PROBE (2026-08-03) — read a PDE back through the SAME walk that wrote it =========
# WHY: `run /bin/aethersafha` (15.6 MB) is fault-killed under -smp 4 with the faulting address's
# PDE reading 0, on the proc's OWN cr3, victim slot moving between runs (PD[3] and PD[510]).
# Two stories remain and NO fault address can separate them:
#     (1) the PDE write never landed, or
#     (2) it landed and something undid it later.
# This reads the entry back IMMEDIATELY after the map call, through cr3 -> PML4[0] -> PDPT[0] -> PD,
# mirroring proc_map_page_nx exactly. A mismatch here proves (1); all-match at map time plus a
# later fault proves (2).
#
# ⚠ THIS PROBE IS NOT TRUSTED UNTIL IT IS VALIDATED AGAINST A KNOWN ANSWER. Four diagnostics on
# this fault were wrong before they were right — including a page-table read-back with one load64
# too many that reported stackpde=0 for EVERY proc, procs that boot fine included. The gate:
# run at -smp 1 (which PASSES) and confirm the probe reports match on every page. A probe that
# cries mismatch on a healthy boot is broken, and its -smp 4 output means nothing.
#
# ⚠ fmt_hex_buf emits ZERO characters for a zero value, which is how "pde=0x" once read as a
# MISSING field rather than a zero one. epp_hex below prints a literal "0" for zero.
#ifdef ELF_PDE_PROBE
# === LIVE PAGE-TABLE REGISTRY ==================================================================
# Every page currently serving as a PML4 / PDPT / PD for a live address space. pmm_alloc consults
# it and screams if the allocator is about to reissue one. That is the whole question left on the
# -smp 4 large-image fault: a PDE is written and VERIFIED correct, nothing else loads into that
# address space, and it later reads 0 — which happens if the page holding it is handed to someone
# who legitimately zeroes it (proc_create_user's memset, proc_map_page_hi's 512-entry clear).
# Both of those are correct code; they are only dangerous if pmm_alloc returns a LIVE page.
# ⚠ Module-global var[N] is N x u64 in Cyrius — 128 slots here, well past 16 procs x 3 tables.
var ptpage_live[128];
fn ptpage_register(a) {
    if (a == 0) { return 0; }
    var i = 0;
    while (i < 128) {
        if (load64(&ptpage_live + i * 8) == 0) { store64(&ptpage_live + i * 8, a); return 0; }
        i = i + 1;
    }
    return 0;                      # registry full — silently skip rather than perturb the run
}
fn ptpage_unregister(a) {
    var i = 0;
    while (i < 128) {
        if (load64(&ptpage_live + i * 8) == a) { store64(&ptpage_live + i * 8, 0); return 0; }
        i = i + 1;
    }
    return 0;
}
fn ptpage_is_live(a) {
    var i = 0;
    while (i < 128) {
        if (load64(&ptpage_live + i * 8) == a) { return 1; }
        i = i + 1;
    }
    return 0;
}
# ⭐ POSITIVE CONTROL — calibrate the NULL. A detector that never fires is indistinguishable from a
# detector that CANNOT fire. This proves the registry+lookup path works, once, on the first
# address-space creation: register a sentinel, assert it reads live, unregister, assert it reads dead.
# If this prints FAIL (or never prints at all), every "no PTREISSUE" result below is meaningless.
var ptpage_st_done = 0;
fn ptpage_selftest_once() {
    if (ptpage_st_done != 0) { return 0; }
    ptpage_st_done = 1;
    var probe = 0xDEAD000;
    var a = ptpage_is_live(probe);
    ptpage_register(probe);
    var b = ptpage_is_live(probe);
    ptpage_unregister(probe);
    var c = ptpage_is_live(probe);
    klug_append("PTSELFTEST before=", 18);
    epp_hex(a);
    klug_append(" registered=", 12);
    epp_hex(b);
    klug_append(" after=", 7);
    epp_hex(c);
    if (a == 0) {
        if (b == 1) {
            if (c == 0) { klug_append(" PASS\n", 6); return 0; }
        }
    }
    klug_append(" FAIL\n", 6);
    return 0;
}
# tag: 0 = proc_unmap_page (the loader guard / munmap path) · 1 = proc_unmap_2mb_hi (high arena).
# The signal is `was=` : a GUARD unmap should find an ABSENT entry. Clearing a PRESENT user PDE means
# a live mapping was destroyed — the failure this function caused once before, when the loader's guard
# unmap on pid 2 deleted PD[7] and took agnsh's page tables with it.
# Walk the WHOLE PD and report which user entries are present. Called at points in the proc lifecycle
# to pin down WHEN a verified-written PDE becomes zero: end-of-load, pre-schedule, etc.
# TRIPWIRE — silent unless PD[510] (the user stack) has gone absent. Safe to call on every scheduler
# dispatch: a per-dispatch log floods and WRAPS the klug ring, which is how the first attempt at this
# lost every record it was meant to capture.
var pd_trip_seen = 0;
fn pd_tripwire(cr3, tag) {
    if (cr3 == 0) { return 0; }
    if (cr3 == 0x1000) { return 0; }
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk (ptw_pd_kva header)
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;               # RAW PHYS — what the klug lines print
    var pd_kva = pmm_kva_for_access(pd_addr);           # the handle every deref below uses
    var e = load64(pd_kva + 510 * 8);
    # ⚠ VALIDATE THE INSTRUMENT: log the PD this tripwire is actually WATCHING, a bounded number of
    # times. "Never fires" is worthless if it is watching a different PD than the one that faults.
    if (pd_trip_seen < 4) {
        pd_trip_seen = pd_trip_seen + 1;
        klug_append("PDWATCH as=0x", 13);
        epp_hex(cr3);
        klug_append(" pd=0x", 6);
        epp_hex(pd_addr);
        klug_append(" pd510=0x", 9);
        epp_hex(e & 0x000FFFFFFFE00000);
        klug_append(" p=", 3);
        epp_hex(e & 1);
        klug_putc(10);
    }
    if ((e & 1) != 0) { return 0; }        # stack present — nothing to say
    klug_append("PDTRIP tag=", 11);
    epp_hex(tag);
    klug_append(" as=0x", 6);
    epp_hex(cr3);
    klug_append(" pd=0x", 6);
    epp_hex(pd_addr);
    klug_append(" pd510=0x", 9);
    epp_hex(e);
    klug_append(" pd2=0x", 7);
    epp_hex(load64(pd_kva + 2 * 8) & 0x000FFFFFFFE00000);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    return 0;
}
fn pd_audit(cr3, tag) {
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk (ptw_pd_kva header)
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;               # RAW PHYS — what the klug lines print
    var pd_kva = pmm_kva_for_access(pd_addr);           # the handle every deref below uses
    var nuser = 0;
    var bits = 0;
    var i = 0;
    while (i < 16) {                       # image region idx 0..15 as a bitmask
        var e = load64(pd_kva + i * 8);
        if ((e & 1) != 0) {
            if ((e & 4) != 0) { bits = bits | (1 << i); }
        }
        i = i + 1;
    }
    i = 0;
    while (i < 512) {
        var e2 = load64(pd_kva + i * 8);
        if ((e2 & 1) != 0) {
            if ((e2 & 4) != 0) { nuser = nuser + 1; }
        }
        i = i + 1;
    }
    var stk = load64(pd_kva + 510 * 8);
    klug_append("pdaudit tag=", 12);
    epp_hex(tag);
    klug_append(" as=0x", 6);
    epp_hex(cr3);
    klug_append(" pd=0x", 6);
    epp_hex(pd_addr);
    klug_append(" nuser=", 7);
    epp_hex(nuser);
    klug_append(" lo16=0x", 8);
    epp_hex(bits);
    klug_append(" pd510=0x", 9);
    epp_hex(stk & 0x000FFFFFFFE00000);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    return 0;
}
fn unmap_probe(cr3, virt, pd_idx, entry, tag) {
    var present = entry & 1;
    var user = (entry >> 2) & 1;
    klug_append("unmap tag=", 10);
    epp_hex(tag);
    klug_append(" cr3=0x", 7);
    epp_hex(cr3);
    klug_append(" va=0x", 6);
    epp_hex(virt);
    klug_append(" idx=0x", 7);
    epp_hex(pd_idx);
    klug_append(" was=0x", 7);
    epp_hex(entry & 0x000FFFFFFFE00000);
    klug_append(" p=", 3);
    epp_hex(present);
    klug_append(" u=", 3);
    epp_hex(user);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    if (present != 0) {
        if (user != 0) { klug_append(" DESTROYED_LIVE\n", 16); return 0; }
    }
    klug_append(" noop\n", 6);
    return 0;
}
# 2 MB variant: does ANY live page-table page fall inside [base, base+2MB)? pmm_alloc_2mb's callers
# immediately memset the whole 2 MB region, so a PT page anywhere inside it is destroyed wholesale.
# ⚠ The 4 KB detector could never see this: page tables are allocated by pmm_alloc (4 KB, top-down),
# but they are DESTROYED by a 2 MB allocation that merely CONTAINS them.
fn ptpage_alarm_if_live_2mb(base) {
    var i = 0;
    while (i < 128) {
        var a = load64(&ptpage_live + i * 8);
        if (a != 0) {
            if (a >= base) {
                if (a < base + 0x200000) {
                    klug_append("PTREISSUE2M base=0x", 19);
                    epp_hex(base);
                    klug_append(" hits_pt=0x", 11);
                    epp_hex(a);
                    klug_append(" by=", 4);
                    epp_hex(proc_current_get());
                    klug_append(" cpu=", 5);
                    epp_hex(pcpu_cpu());
                    klug_putc(10);
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}
fn ptpage_alarm_if_live(a) {
    if (ptpage_is_live(a) == 0) { return 0; }
    ptpage_alarm(a);
    return 0;
}
fn ptpage_alarm(a) {
    klug_append("PTREISSUE addr=0x", 17);
    epp_hex(a);
    klug_append(" by=", 4);
    epp_hex(proc_current_get());
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    return 0;
}
# Tick-rate bracket: sample PD[510] of the CURRENT proc's own space every timer tick. Logs the
# TRANSITION only (present -> absent) plus a bounded number of healthy samples, so the ring survives.
var t510_n = 0;
var t510_last = 0 - 1;
var t510_seen = 0;
fn pd510_tick_watch() {
    var pid = proc_current_get();
    var cr3 = proc_get_cr3(pid);
    if (cr3 == 0) { return 0; }
    if (cr3 == 0x1000) { return 0; }
    if ((cr3 & 0xFFFFF000) != 0xffd7000) { return 0; }
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk (ptw_pd_kva header)
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;               # RAW PHYS — what the klug lines print
    var pd_kva = pmm_kva_for_access(pd_addr);           # the handle every deref below uses
    var pdev = load64(pd_kva + 510 * 8);
    t510_seen = t510_seen + 1;
    if (pdev == t510_last) { return 0; }     # no change — stay quiet
    t510_last = pdev;
    var p = pdev & 1;
    if (t510_n >= 12) { return 0; }
    t510_n = t510_n + 1;
    klug_append("PD510 pde=0x", 12);
    epp_hex(pdev);
    klug_append(" p=", 3);
    epp_hex(p);
    klug_append(" after_ticks=", 13);
    epp_hex(t510_seen);
    klug_append(" pd=0x", 6);
    epp_hex(pd_addr);
    klug_append(" by=", 4);
    epp_hex(pid);
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_putc(10);
    return 0;
}
fn epp_hex(v) {
    # ⛔ 1.56.52 — [24], NOT [16]. fn-local `var x[N]` is N BYTES; fmt_hex_buf writes 16 hex digits
    # PLUS the NUL at buf[len], so it needs 17. The old [16] carried the comment "16 hex digits
    # exactly", which is precisely the off-by-one.
    var b[24];
    if (v == 0) { klug_append("0", 1); return 0; }
    # ⛔ fmt_hex_buf emits ZERO CHARACTERS for a value with BIT 63 SET (a PDE with NX is
    # 0x8000000000000087). That renders as an empty field, identical to the zero case, and is how
    # "pde=0x" was read all day as "the PDE is zero" when the entry was PRESENT. Split the top bit off.
    if (v < 0) { klug_append("NX|", 3); }
    var n = fmt_hex_buf(v & 0x7FFFFFFFFFFFFFFF, &b);
    if (n == 0) { klug_append("0", 1); return 0; }
    klug_append(&b, n);
    return 0;
}
# tag: 0 = a PT_LOAD segment page, 1 = the user stack page.
fn elf_pde_probe(cr3, virt, phys, tag) {
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk (ptw_pd_kva header)
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr));
    var pd_addr = pdpte & 0xFFFFFFFFF000;               # RAW PHYS — what the klug lines print
    var pd_kva = pmm_kva_for_access(pd_addr);           # the handle every deref below uses
    var pd_idx = (virt >> 21) & 0x1FF;
    var got = load64(pd_kva + pd_idx * 8);
    var want_phys = phys & 0xFFFFFFFFFFE00000;
    var got_phys = got & 0x000FFFFFFFE00000;
    # ⭐⭐ THE USER-SIDE MIRROR IS A SECOND, DIFFERENT TABLE — AND IT IS THE ONE RING 3 RUNS ON.
    # proc_map_page_nx writes the kernel-view PD, then mirrors into the PD[511]-stashed user PML4
    # **only if that stash is non-zero**. fault_kill_current walks dm_read_cr3() — the LIVE CR3,
    # which for a ring-3 fault is the USER PML4. So a probe that checks only the kernel-view PD can
    # report MATCH on every page while the table the CPU actually consults is empty. Checking one
    # table and concluding about the other is how this probe nearly produced a false root cause.
    var u_cr3 = load64(pd_kva + 511 * 8);
    var u_got = 0;
    var u_present = 0;
    if (u_cr3 != 0) {
        var u_pd_kva = ptw_pd_kva(u_cr3);              # 1.56.51: direct-map walk
        if (u_pd_kva != 0) { u_got = load64(u_pd_kva + pd_idx * 8); }
        u_present = 1;
    }
    var u_got_phys = u_got & 0x000FFFFFFFE00000;
    klug_append("pdeprobe pid=", 13);
    epp_hex(proc_current_get());
    klug_append(" tag=", 5);
    epp_hex(tag);
    klug_append(" cpu=", 5);
    epp_hex(pcpu_cpu());
    klug_append(" va=0x", 6);
    epp_hex(virt);
    klug_append(" idx=0x", 7);
    epp_hex(pd_idx);
    klug_append(" want=0x", 8);
    epp_hex(want_phys);
    klug_append(" kpd=0x", 7);
    epp_hex(got_phys);
    klug_append(" pd=0x", 6);
    epp_hex(pd_addr);                  # ⭐ the PD's PHYSICAL page — two live procs sharing one is the smoking gun
    klug_append(" ustash=0x", 10);
    epp_hex(u_cr3);
    klug_append(" upd=0x", 7);
    epp_hex(u_got_phys);
    # Verdict names WHICH table is wrong — that is the whole point of the probe.
    if (u_cr3 == 0) { klug_append(" NOSTASH\n", 9); return 0; }
    if (got_phys != want_phys) { klug_append(" KPD_BAD\n", 9); return 0; }
    if ((got & 1) == 0) { klug_append(" KPD_BAD\n", 9); return 0; }
    if (u_got_phys != want_phys) { klug_append(" UPD_BAD\n", 9); return 0; }
    if ((u_got & 1) == 0) { klug_append(" UPD_BAD\n", 9); return 0; }
    klug_append(" MATCH\n", 7);
    return 0;
}
#endif
#ifndef ELF_PDE_PROBE
fn elf_pde_probe(cr3, virt, phys, tag) { return 0; }
fn ptpage_register(a) { return 0; }
fn ptpage_unregister(a) { return 0; }
fn ptpage_is_live(a) { return 0; }
fn ptpage_alarm(a) { return 0; }
fn ptpage_alarm_if_live(a) { return 0; }
fn ptpage_alarm_if_live_2mb(base) { return 0; }
fn ptpage_selftest_once() { return 0; }
fn pd510_tick_watch() { return 0; }
fn unmap_probe(cr3, virt, pd_idx, entry, tag) { return 0; }
fn pd_audit(cr3, tag) { return 0; }
fn pd_tripwire(cr3, tag) { return 0; }
#endif

# proc_map_page_hi(cr3, virt, phys) — like proc_map_page, but for the HIGH user
# mmap arena (VA >= USER_HIMMAP_BASE = 128 GB). proc_map_page only ever touches
# PDPT[0]'s single 0-1 GB PD; a high VA needs its OWN per-process PDPT entry +
# PD, neither of which exists until the first map. The high arena lives at
# PDPT[128..511] (>= 128 GB) — chosen above the direct map (1.56.51: whose top is
# `directmap_pdpt_top`, recorded by pmm_setup_directmap; this comment used to assert a fixed
# PDPT[8..71] ceiling that the code never enforced — see the USER_HIMMAP_BASE header)
# and clear of every device BAR + the framebuffer (all PDPT[0..3]), so a PRESENT
# entry in that range is unambiguously a per-process arena PD, never a shared
# kernel entry. That is what lets teardown free it safely (proc_free_address_space).
# On-demand: if the per-proc PDPT[hi] is absent, allocate a zero-filled PD
# (pmm_alloc — 4 KB; 1.56.51 zeroes and writes it through pmm_kva_for_access, NOT its phys==VA,
# which is the identity alias a crafted PT_LOAD can shadow — see the ptw_pd_kva header) and
# install it user (0x07); then write the 2 MB user PDE (0x87). KPTI is collapsed
# (PD[511]==new_pml4==this CR3), so there is no separate user table to mirror.
# Bite 1a (1.50.2): the mapper itself, verified hermetically by MMAP_HIMEM_SELFTEST;
# sys_mmap routing + teardown are bite 1b. Returns 0 on success, -1 on PD-alloc fail.
fn proc_map_page_hi(cr3, virt, phys) {
    if (cr3 == 0) { return 0 - 1; }
    var pml4e = load64(pmm_kva_for_access(cr3));               # 1.56.51: direct-map walk throughout
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    if (pdpt_addr == 0) { return 0 - 1; }
    var pdpt_kva = pmm_kva_for_access(pdpt_addr);
    var pdpt_idx = (virt >> 30) & 0x1FF;
    var pdpte = load64(pdpt_kva + pdpt_idx * 8);
    var pd_addr = 0;
    if ((pdpte & 1) == 0) {
        pd_addr = pmm_alloc();
        if (pd_addr == 0) { return 0 - 1; }
        var npd_kva = pmm_kva_for_access(pd_addr);
        for (var z = 0; z < 512; z = z + 1) { store64(npd_kva + z * 8, 0); }
        ptpage_register(pd_addr);
        store64(pdpt_kva + pdpt_idx * 8, pd_addr | 0x07);      # present + RW + user — VALUE stays raw phys
    } else {
        # ⛔ 1.56.51 — A PRESENT ENTRY IS ONLY OURS IF IT IS A **USER** ENTRY. Kernel PDPT entries
        # are mirrored into every per-process PDPT by proc_create_address_space and carry U/S=0;
        # the direct map installs exactly such entries, and (see the USER_HIMMAP_BASE header) its
        # reach is PDPT[8..511], not the PDPT[8..71] the old comments claimed. Adopting one here
        # would write a per-process user PDE into a page table the kernel and every other process
        # share. Refuse instead — himmap_reserve's floor should already keep us clear of them, so
        # reaching this is a bug somewhere else and must not be papered over.
        if ((pdpte & 0x04) == 0) { return 0 - 1; }
        pd_addr = pdpte & 0xFFFFFFFFF000;
    }
    var pd_idx = (virt >> 21) & 0x1FF;
    store64(pmm_kva_for_access(pd_addr) + pd_idx * 8, (phys & 0xFFFFFFFFFFE00000) | 0x8000000000000087);   # NX (1.50.5 W^X — anon arena)
    invlpg_va(virt);
    return 0;
}

# proc_unmap_2mb_hi(cr3, virt) — unmap + free ONE 2 MB page in the HIGH user mmap
# arena (VA >= 128 GB; the inverse of proc_map_page_hi). Walks PML4 -> PDPT[hi] ->
# PD; if the target PDE is present + USER, clears it, flushes the TLB, and frees the
# 2 MB phys. The user-bit guard means a kernel/absent entry is never freed (defence
# in depth — the high range is per-process anyway). The PD page is LEFT allocated
# (it may still hold siblings; proc_free_address_space reclaims an emptied PD at
# process exit — bounded: <=384 PDs * 4 KB for the whole arena). 1.50.3. Returns 1
# if a page was freed, 0 otherwise (absent / already-unmapped — idempotent).
fn proc_unmap_2mb_hi(cr3, virt) {
    if (cr3 == 0) { return 0; }
    var pml4e = load64(pmm_kva_for_access(cr3));        # 1.56.51: direct-map walk throughout
    var pdpt_addr = pml4e & 0xFFFFFFFFF000;
    if (pdpt_addr == 0) { return 0; }
    var pdpt_idx = (virt >> 30) & 0x1FF;
    var pdpte = load64(pmm_kva_for_access(pdpt_addr) + pdpt_idx * 8);
    if ((pdpte & 0x01) == 0) { return 0; }              # PDPT entry absent — nothing mapped
    var pd_addr = pdpte & 0xFFFFFFFFF000;
    var pd_kva = pmm_kva_for_access(pd_addr);
    var pd_idx = (virt >> 21) & 0x1FF;
    var entry = load64(pd_kva + pd_idx * 8);
    unmap_probe(cr3, virt, pd_idx, entry, 1);
    if ((entry & 0x01) == 0) { return 0; }              # PDE not present
    if ((entry & 0x04) == 0) { return 0; }              # not user — never free a kernel page
    var phys = entry & 0x000FFFFFFFE00000;
    store64(pd_kva + pd_idx * 8, 0);                    # clear the PDE
    invlpg_va(virt);
    tlb_shootdown_all();                                # other CPUs may still cache this translation
    pmm_free_2mb(phys);
    return 1;
}

# 1.44.19 — fault-PROOF copy from a (possibly garbage) user VA range, for the per-process
# env blob on execwait(#37)/spawn_path(#43). WHY not the ew37_path-style copy-under-caller-CR3:
# legacy 3-arg syscall() callers deliver GARBAGE in a3/a4 (the cyrius builtin pops exactly N
# arg regs — verified in the compiler's emitter; agnoshi 1.6.1 binaries on a new kernel are
# the NORMAL ESP-only deployment), and a blind load8 of an unmapped-but-in-range garbage VA
# would #PF the handler. This walks the CALLER's page tables under boot-CR3 identity instead
# (table pages are physical addresses — the same chain proc_map_page writes above), requires
# each 2 MB PDE to be Present+User+PS, and copies via the DIRECT-MAP alias of the physical page.
# ⚠ 1.56.51: not the identity alias it used until then. A user data page whose phys lands in
# PD[2..127] has a US=1 identity PDE under the caller's own CR3, so a CPL=0 load8 through it is a
# SMAP violation — and PD[2..127] is also the window a crafted PT_LOAD can shadow. The direct map is
# supervisor (0x83) and out of reach of any user segment. See the ptw_pd_kva header.
# Returns 1 on success, 0 on ANY absent/non-user/non-huge mapping — the caller treats 0 as
# "no env" (fallback to the default), never an error. VAs are < 1 GB (is_user_range), so
# PML4[0]/PDPT[0] indices are 0 — mirroring proc_map_page's walk.
fn proc_copy_from_user(cr3, dst, uva, len) {
    var copied = 0;
    while (copied < len) {
        var va = uva + copied;
        # ⛔ 1.56.52 — INDEX PML4 AND PDPT FROM THE VA. Both were hardcoded to entry 0, which is correct
        # only for VAs below 1 GB. That was survivable while is_user_range's ceiling WAS 1 GB; it is not
        # now that the high mmap arena [128 GB, 512 GB) is a legal syscall pointer. A high VA walked
        # through PML4[0]/PDPT[0] lands on `(va >> 21) & 0x1FF` of the LOW page directory — e.g.
        # 0x2010000000 aliases to PD[128], the low mmap arena — so the copy would silently read or write
        # a DIFFERENT page of the same process than the caller named. It fails safe today only by luck
        # (whichever slot it aliases is usually the supervisor identity map, and the user-bit check
        # below refuses it); an aliased slot that happens to hold a user page corrupts data instead.
        var pml4e = load64(pmm_kva_for_access(cr3) + ((va >> 39) & 0x1FF) * 8);
        if ((pml4e & 1) == 0) { return 0; }
        var pdpt_addr = pml4e & 0xFFFFFFFFF000;
        var pdpte = load64(pmm_kva_for_access(pdpt_addr) + ((va >> 30) & 0x1FF) * 8);
        if ((pdpte & 1) == 0) { return 0; }
        if ((pdpte & 4) == 0) { return 0; }    # supervisor PDPT (the direct map lives here) — not user
        if ((pdpte & 0x80) != 0) { return 0; } # a 1 GB page: no user mapping has this shape
        var pd_addr = pdpte & 0xFFFFFFFFF000;
        var pde = load64(pmm_kva_for_access(pd_addr) + ((va >> 21) & 0x1FF) * 8);
        if ((pde & 1) == 0) { return 0; }      # not present
        if ((pde & 4) == 0) { return 0; }      # not a user page
        if ((pde & 0x80) == 0) { return 0; }   # not a 2 MB huge page (unexpected shape)
        var page_phys = pde & 0x000FFFFFFFE00000;
        var off = va & 0x1FFFFF;
        var chunk = 0x200000 - off;
        if (chunk > len - copied) { chunk = len - copied; }
        var k = 0;
        var page_kva = pmm_kva_for_access(page_phys);   # 1.56.51: direct map, never the identity alias
        while (k < chunk) { store8(dst + copied + k, load8(page_kva + off + k)); k = k + 1; }
        copied = copied + chunk;
    }
    return 1;
}

# 1.56.24 — the WRITE-side twin of proc_copy_from_user, and the reason it exists.
#
# ⛔ THE DEFECT IT REPLACES. #82/#83 (gpu_dispatch_sys / gpu_dispatch_f64_sys) wrote their result
# back to ring 3 as: "probe the destination with proc_copy_from_user, then raw store32 into the user
# VA." The comment there said so outright — *"no proc_copy_TO_user primitive exists, so confirm C's
# user pages are present+user first, then the direct store32 loop cannot #PF."* That reasoning is
# sound about FAULTING and silent about PERMISSION: proc_copy_from_user validates Present + User + PS
# because it is a READ, and never looks at the R/W bit (PDE bit 1). So a destination that is present,
# user, and READ-ONLY passed the probe and then got written anyway. Ring 0 does not honour the R/W bit
# unless CR0.WP is set, so the store simply succeeded — silently writing memory the process had asked
# the kernel to protect. A read-only or copy-on-write mapping is exactly where that matters.
#
# ⭐ THE CHECK THAT MAKES THIS DIFFERENT IS ONE LINE: `(pde & 2) == 0` ⇒ refuse. Everything else
# mirrors proc_copy_from_user deliberately — same boot-CR3 walk of the caller's tables, same
# Present+User+PS requirements, same 2 MB huge-page shape, same 0/1 return convention — because two
# primitives that walk the same tables differently is how one of them drifts.
#
# Returns 1 on success, 0 on ANY absent / non-user / non-writable / non-huge mapping. ⛔ On 0 the copy
# may be PARTIAL: it validates each 2 MB page as it reaches it, so a caller must treat 0 as "the
# destination is not fully writable" and report it, never retry.
fn proc_copy_to_user(cr3, uva, src, len) {
    var copied = 0;
    while (copied < len) {
        var va = uva + copied;
        # ⛔ 1.56.52 — INDEX PML4 AND PDPT FROM THE VA. Both were hardcoded to entry 0, which is correct
        # only for VAs below 1 GB. That was survivable while is_user_range's ceiling WAS 1 GB; it is not
        # now that the high mmap arena [128 GB, 512 GB) is a legal syscall pointer. A high VA walked
        # through PML4[0]/PDPT[0] lands on `(va >> 21) & 0x1FF` of the LOW page directory — e.g.
        # 0x2010000000 aliases to PD[128], the low mmap arena — so the copy would silently read or write
        # a DIFFERENT page of the same process than the caller named. It fails safe today only by luck
        # (whichever slot it aliases is usually the supervisor identity map, and the user-bit check
        # below refuses it); an aliased slot that happens to hold a user page corrupts data instead.
        var pml4e = load64(pmm_kva_for_access(cr3) + ((va >> 39) & 0x1FF) * 8);
        if ((pml4e & 1) == 0) { return 0; }
        var pdpt_addr = pml4e & 0xFFFFFFFFF000;
        var pdpte = load64(pmm_kva_for_access(pdpt_addr) + ((va >> 30) & 0x1FF) * 8);
        if ((pdpte & 1) == 0) { return 0; }
        if ((pdpte & 4) == 0) { return 0; }    # supervisor PDPT (the direct map lives here) — not user
        if ((pdpte & 0x80) != 0) { return 0; } # a 1 GB page: no user mapping has this shape
        var pd_addr = pdpte & 0xFFFFFFFFF000;
        var pde = load64(pmm_kva_for_access(pd_addr) + ((va >> 21) & 0x1FF) * 8);
        if ((pde & 1) == 0) { return 0; }      # not present
        if ((pde & 2) == 0) { return 0; }      # ⭐ NOT WRITABLE — the check the read-side twin lacks
        if ((pde & 4) == 0) { return 0; }      # not a user page
        if ((pde & 0x80) == 0) { return 0; }   # not a 2 MB huge page (unexpected shape)
        var page_phys = pde & 0x000FFFFFFFE00000;
        var off = va & 0x1FFFFF;
        var chunk = 0x200000 - off;
        if (chunk > len - copied) { chunk = len - copied; }
        var k = 0;
        var page_kva = pmm_kva_for_access(page_phys);   # 1.56.51: direct map, never the identity alias
        while (k < chunk) { store8(page_kva + off + k, load8(src + copied + k)); k = k + 1; }
        copied = copied + chunk;
    }
    return 1;
}

# Unmap a 2MB page in a process's page directory (for guard pages)
#
# 1.41.13 — guard-page unmap must NEVER punch the kernel identity map. A user
# stack's guard page (stack_base - 0x200000) can land on a VA whose PD entry is
# the kernel's SUPERVISOR identity mapping rather than a user page. Concretely:
# pid 2's stack is at 0x1000000 (PD[8]) so its guard is 0xE00000 = PD[7], which
# identity-maps physical region 7 (14-16 MB) — and under top-down pmm_alloc that
# is exactly where this process's own page-table pages (PML4/PDPT/PD) live.
# Zeroing that supervisor entry is BOTH useless and catastrophic:
#   - useless: a supervisor PD entry (U/S=0) already faults any ring-3 access, so
#     the overflow guard is ALREADY enforced by the protection bit;
#   - catastrophic: it removes the kernel's own path to the page-table pages under
#     this CR3, so the very next proc_map_page (e.g. sys_mmap) does load64(cr3) and
#     #PFs at CR2 = PML4-phys (a region-7 VA) → silent triple fault, no banner.
# So clear the entry ONLY when it is a USER page (bit 0x04 set) — a real user
# mapping below the stack. Supervisor/identity entries are left intact. This is
# what was killing agnsh after exec (CR2=0x?fee000 / CR3=same): the loader's
# guard unmap on pid 2 deleted PD[7], the home of agnsh's page tables.
fn proc_unmap_page(cr3, virt) {
    # x86 page-table walk — see #ifdef ARCH_X86_64 above.
    # 1.56.51: through the direct map — see the ptw_pd_kva header.
    var pd_kva = ptw_pd_kva(cr3);
    if (pd_kva == 0) { return 0 - 1; }
    var pd_idx = (virt >> 21) & 0x1FF;
    var k_entry = load64(pd_kva + pd_idx * 8);
    # ELF_PDE_PROBE: a GUARD unmap should find NOTHING. If this clears a PRESENT user entry it has
    # just destroyed a live mapping — the exact failure this function caused once before ("the
    # loader's guard unmap on pid 2 deleted PD[7], the home of agnsh's page tables").
    unmap_probe(cr3, virt, pd_idx, k_entry, 0);
    if ((k_entry & 0x04) != 0) {            # user page only — never a kernel PDE
        store64(pd_kva + pd_idx * 8, 0);
    }
    # S8 (KPTI): also unmap in user page tables (same user-only guard)
    var u_cr3 = load64(pd_kva + 511 * 8);
    if (u_cr3 != 0) {
        var u_pd_kva = ptw_pd_kva(u_cr3);
        if (u_pd_kva != 0) {
            var u_entry = load64(u_pd_kva + pd_idx * 8);
            if ((u_entry & 0x04) != 0) {
                store64(u_pd_kva + pd_idx * 8, 0);
            }
        }
    }
    # A cleared PDE is only cleared on THIS CPU until every other CPU drops its cached translation.
    if ((k_entry & 0x04) != 0) { tlb_shootdown_all(); }
    return 0;
}

# === Anonymous mmap (1.35.3) ===
# Global vaddr arena cursor: 256 MB base (clear of code ~2-34 MB and per-pid
# stacks at 0x800000 + pid*0x400000), ceiling 1 GB (the per-process PD covers
# 0-1 GB). Each address space is independent (own CR3), so a global monotonic
# cursor never collides across processes. 2 MB-granular (the VMM is huge-pages
# only) and bump-only (no reclaim on the v1 no-munmap path). See
# agnosticos/docs/development/mmap-prior-art.md.
# ⚠ 1.57.7 (S8): "never collides" stopped being true once fork copied low pages and munmap rewound the cursor —
# sys_mmap's present-test (the no-overwrite rule) is what makes a collision harmless now.
var mmap_next_vaddr = 0x10000000;

# HIGH user mmap arena. [USER_HIMMAP_BASE, HIMMAP_CEILING) = [128 GB, 512 GB),
# mapped via proc_map_page_hi into per-proc PDPT[128..511], clear of every device BAR +
# the FB (PDPT[0..3]).
#
# ⛔⛔ 1.56.51 — "128 GB IS ABOVE THE <=64 GB DIRECT-MAP (PDPT[8..71])" WAS FALSE, and the same
# sentence appeared three times (here, at proc_map_page_hi, and in proc_free_address_space). There
# is no 64 GB ceiling on the direct map: pmm_setup_directmap sizes itself from the RAW
# pmm_memmap_ram_top and clamps only at 504 GB, so its reach is PDPT[8..511]. The 64 GB number
# came from pmm_migrate_bitmap's BITMAP cap, which constrains nothing here. On a box with more
# than ~120 GB of conventional RAM the direct map therefore OWNS PDPT[128] upward — and
# proc_create_address_space copies kernel PDPT[1..511] into every process, so proc_map_page_hi's
# on-demand branch would find the entry PRESENT, take the else, and write a per-process user PDE
# into a page table the kernel and every other process share. The direct map for that GB is then
# silently pointing at one process's private page (pmm_kva_for_access on anything in that range —
# the PMM bitmap, sys_mmap's zero-fill, both ELF loaders — reads and writes the wrong frame), and
# the mapping is useless to its owner anyway because the shared PDPT entry carries no U/S bit.
# ⭐ Fixed on both sides: the base is now DERIVED from directmap_pdpt_top (vmm.cyr, recorded by
# pmm_setup_directmap from what it really installed), and proc_map_page_hi REFUSES to adopt a
# present-but-not-user PDPT entry rather than writing into it.
# 1.50.4: the bump cursor is PER-PROCESS (proc_himmap_next,
# indexed by pid; mirrors proc_rsp0) rather than global — each address space gets the
# full [128 GB, 512 GB) independently, so a long-lived multi-process system never
# exhausts the way one shared cursor would (each proc's high VAs live in its own CR3).
var USER_HIMMAP_BASE = 0x2000000000;    # 128 GB
var HIMMAP_CEILING   = 0x8000000000;    # 512 GB — PML4[0] top
# proc_himmap_next[16] (the per-pid cursor, 0 = uninit -> the floor) is declared in the SHARED region beside the
# S8 limit arrays since 1.57.7: proc_alloc_slot scrubs it and sys_fork copies it (a stale or uncopied cursor mapped
# a fork child's first high mmap over its copied pages).


# himmap_reserve(pid, len): reserve `len` bytes of high-arena VA for process `pid`
# from its OWN bump cursor (lazy-init to USER_HIMMAP_BASE). Returns the base VA, or 0
# if that process's high arena is exhausted (cursor + len would pass 512 GB).
# 1.56.51 — the arena's real floor: the first GB above everything pmm_setup_directmap installed,
# never below the historical USER_HIMMAP_BASE. On every machine with <=120 GB of RAM this is
# exactly USER_HIMMAP_BASE and nothing moves; above that it steps the arena clear of the direct map
# instead of colliding with it. Returns a 1 GB-aligned VA.
fn himmap_floor() {
    var f = (directmap_pdpt_top + 1) * 0x40000000;
    if (f < USER_HIMMAP_BASE) { f = USER_HIMMAP_BASE; }
    return f;
}
fn himmap_reserve(pid, len) {
    if (pid < 0) { return 0; }
    if (pid >= 16) { return 0; }
    var cur = load64(&proc_himmap_next + pid * 8);
    if (cur == 0) { cur = himmap_floor(); }
    if (cur < himmap_floor()) { cur = himmap_floor(); }   # a cursor seeded before the floor moved
    if ((cur + len) > HIMMAP_CEILING) { return 0; }
    store64(&proc_himmap_next + pid * 8, cur + len);
    return cur;
}

# sys_mmap(length): map `length` (rounded up to 2 MB) of zero-filled, user-
# accessible memory into the calling process's address space; return the base
# vaddr or 0 (MAP_FAILED). Anonymous only — addr/prot/flags/fd/offset ignored.
# Small allocs use the proven LOW arena [256 MB, ~1 GB) (one PD); a request that
# doesn't fit there (big, or the low cursor is exhausted) SPILLS to the HIGH arena
# [128 GB, 512 GB) — the 1.50.2 lift of the ~768 MB single-process cap to machine
# RAM. (munmap of a HIGH region is not yet supported — returns -1; its pages are
# reclaimed at process exit by proc_free_address_space.)
fn sys_mmap(length) {
    # Sanity cap BEFORE rounding: no single alloc can exceed machine RAM (the
    # bitmap caps RAM at 64 GB), which also blocks the `length + 0x1FFFFF` near-u64
    # round-up wrap. 64 GB is well within the 384 GB high-arena VA window.
    if (length > 0x1000000000) { return 0; }             # > 64 GB
    var len = (length + 0x1FFFFF) & 0xFFFFFFFFFFE00000;   # round up to 2 MB
    if (len < 0x200000) { len = 0x200000; }
    var npages = len / 0x200000;
    var mm_me = proc_current_get();
    var cr3 = proc_get_cr3(mm_me);
    if (cr3 == 0) { return 0; }
    # ⭐ 1.57.7 (S8): THE MEMORY CAP (spawn_limits#107 or inherited), before the free-RAM pre-count so a cap refusal
    # never depends on free RAM. The footprint is COMPUTED (proc_user_pages_cr3), so munmap credits back by itself.
    # npages <= 32768 (the 64 GB cap): no overflow. One address space has one thread: no interleaving mmap.
    var mm_cap = lim_cell(&proc_mem_cap, mm_me);
    if (mm_cap != 0) {
        if (proc_user_pages_cr3(cr3) + npages * 512 > mm_cap) { lim_mmap_refused_once(mm_me, mm_cap); return 0; }
    }
    if (pmm_count_2mb_free() < npages) { return 0; }       # not enough physical (pre-count)
    # LOW arena first (the proven path) when it still fits under the stack-guard
    # ceiling (0x3FA00000, below the user stack @0x3FC00000).
    # ⭐ RESERVE THE WHOLE SPAN ATOMICALLY, THEN MAP INTO IT.
    # The cursor read, the ceiling check and the advance are now one critical section, and the loop
    # maps `base_vaddr + i*2MB` — a fixed range this caller owns — instead of re-reading a global that
    # another CPU is also advancing. Previously the base was captured before the loop while the loop
    # itself did an UNLOCKED read-modify-write of `mmap_next_vaddr`, so two concurrent multi-page
    # mmaps interleaved and left a HOLE in each other's range.
    # ⛔ IRON-CONFIRMED 2026-08-03, not theoretical: `fault: pid=7 cr2=0x1043c000 err=0x6 pde=0 idx=82`
    # — PD[130], inside this arena, a user WRITE to a page that was never mapped. It cost the desktop
    # its second client on that burn. The HIGH arena below already reserved per-process
    # (`himmap_reserve`, 1.50.4); this brings the low arena to the same guarantee.
    mmap_spin_lock();
    var base_vaddr = 0;
    if ((mmap_next_vaddr + len) <= 0x3FA00000) {
        base_vaddr = mmap_next_vaddr;
        mmap_next_vaddr = mmap_next_vaddr + len;    # claim the ENTIRE span before releasing
    }
    mmap_spin_unlock();
    # ⛔ 1.57.7 (S8) — NO MAPPING EVER LANDS ON A LIVE ONE. The low cursor is GLOBAL and munmap rewinds it (LIFO), while
    # fork copies every low page: P maps A at the top, forks C, munmaps A -> the cursor rewinds to A, and C's next mmap
    # got A and proc_map_page_nx's blind store overwrote C's live PDE (data clobbered, frame leaked for good, and
    # uncounted by any cap). A span with ANY present page is abandoned (the cursor already moved past it: a harmless VA
    # hole) and the request takes the HIGH arena, exactly as for "does not fit".
    if (base_vaddr != 0) {
        var mo = 0;
        while (mo < npages) {
            if (proc_va_present_2mb(cr3, base_vaddr + mo * 0x200000) != 0) { base_vaddr = 0; mo = npages; }
            mo = mo + 1;
        }
    }
    if (base_vaddr != 0) {
        for (var i = 0; i < npages; i = i + 1) {
            var phys = pmm_alloc_2mb();
            if (phys == 0) { return 0; }            # pre-counted, but guard anyway
            # 1.49.12: zero via the kernel access handle — identity <=256 MB, direct-map above.
            var kva = pmm_kva_for_access(phys);
            memset(kva, 0, 0x200000);               # zero-fill (anonymous contract)
            # 1.56.52: proc_map_page_nx's return was DISCARDED. It returns -1 when ptw_pd_kva(cr3)
            # fails, and `phys` would then be neither mapped nor freed — unreachable from any PDE, so
            # proc_free_address_space's sweep cannot reclaim it at exit either. Permanent 2 MB loss.
            if (proc_map_page_nx(cr3, base_vaddr + i * 0x200000, phys) != 0) {
                pmm_free_2mb(phys);
                return 0;
            }
        }
        return base_vaddr;
    }
    # HIGH arena: reserve the whole range from THIS process's own cursor (1.50.4).
    var hbase = himmap_reserve(mm_me, len);
    if (hbase == 0) { return 0; }                    # this process's high arena is exhausted
    # 1.57.7 (S8): the same no-overwrite rule (defence in depth: the per-incarnation cursor + fork's copy keep it
    # unreachable).
    var mh = 0;
    while (mh < npages) {
        if (proc_va_present_2mb(cr3, hbase + mh * 0x200000) != 0) { return 0; }
        mh = mh + 1;
    }
    for (var j = 0; j < npages; j = j + 1) {
        var hphys = pmm_alloc_2mb();
        if (hphys == 0) { return 0; }
        var hkva = pmm_kva_for_access(hphys);       # direct-map handle for the >256 MB zero-fill
        memset(hkva, 0, 0x200000);
        # ⛔ 1.56.52 — FREE THE PAGE BEFORE BAILING. This was a bare `return 0`, so `hphys` was
        # allocated and then dropped: never installed in any PDE, therefore invisible to
        # proc_free_address_space's PDPT[128..511] sweep (which only reclaims PRESENT+USER entries),
        # therefore lost until reboot. 2,097,152 bytes per failed call.
        # ⚠ AND IT IS DETERMINISTICALLY REACHABLE FROM RING 3, because the two allocators have
        # different ceilings: proc_map_page_hi's on-demand branch needs a 4 KB PD from pmm_alloc,
        # which scans only up to pmm_alloc_top (hard-clamped to 65535 = 256 MB), while pmm_alloc_2mb
        # scans the FULL RAM pool. So a process that first consumes every 2 MB region below 256 MB
        # makes pmm_alloc fail while pmm_alloc_2mb keeps succeeding — every subsequent high mmap then
        # allocates 2 MB, fails to map it, and leaks it. Unprivileged, unbounded, needs no crafted
        # input, and syscall 27 has no gating.
        if (proc_map_page_hi(cr3, hbase + j * 0x200000, hphys) != 0) {
            pmm_free_2mb(hphys);
            return 0;
        }
    }
    return hbase;
}

# sys_munmap(addr, length): release a region previously returned by sys_mmap
# and return its physical 2 MB pages to the PMM. addr must be 2 MB-aligned and
# inside the mmap arena [0x10000000, 0x40000000); length rounds up to 2 MB like
# mmap. Conservative (no VMA tracking): frees each currently-mapped 2 MB region
# in the range, skips already-unmapped ones (idempotent), never touches non-
# arena memory. vaddr space is reclaimed only when the range sits exactly at the
# top of the bump arena (LIFO); otherwise physical is freed but the cursor holds.
# Returns 0 on success, -1 on a bad request. See mmap-prior-art.md § 7.
fn sys_munmap(addr, length) {
    if ((addr & 0x1FFFFF) != 0) { return 0 - 1; }            # not 2 MB-aligned
    # ⛔⛔ 1.56.52 — `length` HAD NO INGRESS CAP AND THE CEILING TESTS BELOW WRAPPED. Cyrius has only
    # i64 and every comparison is SIGNED. sys_mmap caps its length (`length > 0x1000000000`); this
    # function did not, so `len` could be made huge-but-positive and `addr + len` could be made
    # NEGATIVE, which sails through a signed `> ceiling` test.
    # Worked example, both values ring-3 supplied through syscall 28 with no other validation:
    #   length = 0x7FFFFFFFFFD00000 → +0x1FFFFF = 0x7FFFFFFFFFEFFFFF → masked len =
    #   0x7FFFFFFFFFE00000 (positive, so the `len < 0x200000` floor does not fire)
    #   addr = 0x10000000 → addr + len = 0x800000000FE00000, i.e. -9223372032825982976 as i64
    #   ⇒ `(addr + len) > 0x40000000` is FALSE and the request is ACCEPTED.
    # npages = 4,398,046,511,103. The loop's `pd_idx = (vaddr >> 21) & 0x1FF` then simply CYCLES, so
    # it walks off the arena into the KERNEL IDENTITY window: at i = 385 pd_idx is 1 → PD[1] =
    # 0x200000|0x83, and the free site tested ONLY the present bit, so pmm_free_2mb(0x200000) marked
    # physical 2-4 MB — the SYSCALL kstack, the boot TSS RSP0 seeds — FREE WHILE LIVE. i = 386..511
    # does the same for 4 MB..256 MB (proc_create_address_space seeds PD[0..127] from the boot PD and
    # re-asserts PD[8..127] as `(hi * 0x200000) | 0x83`). proc_unmap_page correctly refuses to CLEAR a
    # supervisor PDE, so the mappings survive — only the ALLOCATOR'S RECORD of them is destroyed, and
    # pmm_alloc then hands those live frames to the next caller. The loop then spins ~4.4e12 more
    # iterations with IF=0, so the box is wedged as well. Two integers, no privilege.
    # ⚠ The high arm below had the identical unguarded compare; it did not corrupt only because
    # proc_unmap_2mb_hi refuses a non-user PDE — which is exactly the guard the low arm lacked.
    if (length < 0) { return 0 - 1; }                        # negative length is never legitimate
    if (length > 0x1000000000) { return 0 - 1; }             # 64 GB, mirroring sys_mmap's cap
    var len = (length + 0x1FFFFF) & 0xFFFFFFFFFFE00000;       # round up to 2 MB
    if (len < 0x200000) { len = 0x200000; }
    if (addr < 0) { return 0 - 1; }                          # signed-compare hygiene, as above
    if (addr + len < addr) { return 0 - 1; }                 # belt-and-braces wrap check (is_user_range idiom)
    var cr3 = proc_get_cr3(proc_current_get());
    if (cr3 == 0) { return 0 - 1; }
    var npages = len / 0x200000;
    # HIGH arena [128 GB, 512 GB) (1.50.3): each 2 MB page may sit in a DIFFERENT
    # PDPT[hi] entry, so unmap per-page via proc_unmap_2mb_hi (idempotent — it skips
    # already-unmapped pages). The PDs themselves are reclaimed at process exit.
    if (addr >= 0x2000000000) {
        if ((addr + len) > 0x8000000000) { return 0 - 1; }   # past the 512 GB ceiling
        for (var hi = 0; hi < npages; hi = hi + 1) {
            proc_unmap_2mb_hi(cr3, addr + hi * 0x200000);
        }
        # LIFO vaddr reclaim: rewind THIS process's high cursor if this was its most-recent map.
        var mpid = proc_current_get();
        if (mpid >= 0) {
            if (mpid < 16) {
                if ((addr + len) == load64(&proc_himmap_next + mpid * 8)) {
                    store64(&proc_himmap_next + mpid * 8, addr);
                }
            }
        }
        return 0;
    }
    # LOW arena [256 MB, 1 GB) — the original path (the whole low arena shares one
    # 0-1 GB PD, so walk PML4 -> PDPT[0] -> PD once).
    if (addr < 0x10000000) { return 0 - 1; }                  # below the arena
    # ⛔ 1.56.52 — 0x3FA00000, NOT 0x40000000. sys_mmap's low arena stops at 0x3FA00000 (the constant
    # it bump-checks against), chosen to sit below the FIXED user stack at 0x3FC00000. This ceiling
    # was 0x40000000, so the 6 MB gap [0x3FA00000, 0x40000000) — PD slots 509 (the loader's guard
    # page), 510 (THE USER STACK) and 511 (the user-CR3 stash) — was inside the range ring 3 could
    # name. `munmap(0x3FC00000, 0x200000)` read PD[510] = stack_phys|0x8000000000000087, saw the
    # present bit, and freed the process's own live stack page. Nothing legitimate is lost by
    # lowering it: sys_mmap never returns a low base at or above 0x3FA00000, so no honest munmap can
    # name that span.
    if ((addr + len) > 0x3FA00000) { return 0 - 1; }          # the arena's REAL top (see sys_mmap)
    var pd_kva = ptw_pd_kva(cr3);                             # 1.56.51: direct-map walk
    if (pd_kva == 0) { return 0 - 1; }
    var flush = 0;
    var freed = 0;
    for (var i = 0; i < npages; i = i + 1) {
        var vaddr = addr + i * 0x200000;
        var pd_idx = (vaddr >> 21) & 0x1FF;
        var entry = load64(pd_kva + pd_idx * 8);
        # ⛔ 1.56.52 — THE USER BIT IS REQUIRED, NOT JUST PRESENT. proc_unmap_2mb_hi has always
        # carried this guard ("not user — never free a kernel page") and proc_unmap_page refuses to
        # CLEAR a supervisor PDE; the FREE here had neither, so any present kernel-identity PDE the
        # index arithmetic reached was handed to pmm_free_2mb. The caps above make that unreachable;
        # this is the defence in depth that keeps a future arithmetic slip from being catastrophic.
        if ((entry & 1) != 0 && (entry & 0x04) != 0) {        # present AND user -> unmap + free
            var phys = entry & 0x000FFFFFFFE00000;
            proc_unmap_page(cr3, vaddr);                      # clears kernel + KPTI user PD
            flush = vaddr;
            asm { invlpg [rax]; }                             # drop the stale huge-page TLB entry
            pmm_free_2mb(phys);
            freed = freed + 1;
        }
    }
    # LIFO vaddr reclaim: rewind the bump cursor if this was the most-recent map.
    # The munmap rollback touches the same global the alloc path claims from, so it takes the same
    # lock. Unlocked, a rollback racing an alloc could hand two callers the same base.
    # ⛔⛔ 1.56.53 — `freed == npages` IS THE POINT OF THIS CONDITION, AND IT WAS MISSING. The rollback
    # was gated on VA ARITHMETIC ALONE — `addr + len == mmap_next_vaddr` — against a cursor that is
    # GLOBAL to every process, with no check that the caller owns, or has ever mapped, the span it is
    # rewinding past. It also ran unconditionally: reached whether or not the loop above unmapped a
    # single page.
    # ⇒ Ring-3 reachable, and it needs no crafted input beyond two integers. A process that has never
    # called mmap has NOTHING present in the low arena (proc_create_address_space explicitly zeroes
    # PD[128..510] in every new address space), so its munmap frees nothing, skips every page, and
    # falls straight into the rollback — rewinding the shared cursor past a span another process is
    # using. The next sys_mmap then hands out a base already in use.
    # ⚠ ACROSS processes that is harmless (separate CR3s). WITHIN one it is not: the caller can rewind,
    # mmap twice, and get two overlapping regions, because proc_map_page_nx is a blind
    # `store64(pd_kva + pd_idx * 8, ...)` with no present-check — so the second map OVERWRITES the
    # first`s PDE and the first`s physical pages become unreachable from any PDE. proc_free_address_space
    # reclaims by SWEEPING present+user PDEs, so it cannot find them either: they are leaked until
    # reboot, 2 MB at a time, by a process leaking only its own memory but leaking it permanently.
    # ⭐ REQUIRING `freed == npages` is the honest test of the property the rollback assumes: that this
    # call actually owned and released the whole span it names. A caller unmapping its own most-recent
    # full mapping — the LIFO case this optimisation exists for — still rewinds exactly as before.
    # ⛔ 1.57.7 (S8) — `freed == npages` WAS NOT ENOUGH: FORK REOPENED THE CLASS. A fork child holds COPIES of every
    # low page, so the parent's own honest LIFO munmap rewound the global cursor onto a span still live in the child,
    # and the child's next mmap overwrote its own PDE. The overwrite is now closed BY CONSTRUCTION in sys_mmap (a span
    # with any present page is never mapped); this rewind stays as the VA-reuse optimisation only.
    if (freed == npages) {
        mmap_spin_lock();
        if ((addr + len) == mmap_next_vaddr) { mmap_next_vaddr = addr; }
        mmap_spin_unlock();
    }
    return 0;
}
#endif
