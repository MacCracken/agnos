# klug — Kernel Logs Unified Grep. The unified in-kernel log ring buffer.
#
# Every byte that kprint/kputc/kprintln mirror to serial+fb (core/kprint.cyr)
# is ALSO appended here, so the whole boot log + runtime kernel output lives in
# one place. Userland reads it via the `klug` syscall (1.42.12) and greps it
# with the existing toolchain (agnsh `grep`) — the kernel itself does NOT filter.
# That's the sovereign split the name encodes: the kernel UNIFIES the logs; GREP
# stays a userland capability, so no string-matching machinery enters the kernel.
#
# 64 KB circular byte buffer. NOTE the Cyrius var-array unit rule (CLAUDE.md):
# a module-global `var X[N]` allocates N * u64 = 8N bytes, so `var klug_buf[8192]`
# is 8192 * 8 = 65536 bytes, indexed as bytes [0, 65535] via store8/load8. The
# size is 2^16 so the wrap is a mask (& 0xFFFF), not a modulo. When the ring
# fills, the oldest bytes are overwritten (dmesg-style aging).
#
# ⚠ SIZED FOR THE FULL IRON BOOT LOG. The old 16 KB assumed a ~4 KB boot log, but
# the log grew past it (GPU arc F0..C2x ~3 KB + full iron USB/device enumeration +
# SMP push a clean iron boot to ~16-20 KB) — so the ring WRAPPED and the earliest
# lines were lost (the `klug` tool faithfully returned the last 16 KB of whatever
# had been printed by the time it ran). 64 KB holds the whole boot log ~3x over
# with headroom for the rest of the arc. The userland `klug` tool's read buffer +
# KLUG_RING_BYTES MUST match this size (they're bumped in lockstep, else the tool
# only pulls its buffer's worth of the tail). Cyrius emits module-global arrays as
# file-resident zero-data (not .bss), so the buffer costs its full size in the
# kernel image — the check.sh size ceiling was raised to suit.
#
# ⛔ FALSE UNTIL 1.56.48 — RETAINED SO IT IS NOT RE-DERIVED. This note used to claim
# "the kernel stops feeding the ring at the kybernet userland handoff, so the ring's
# newest byte is ~kybernet and it held only the 16 KB before it". THERE IS NO HANDOFF
# GATE. The tap in kputc/kprint/kprintln (core/kprint.cyr) is unconditional, so the
# ring keeps taking (a) every runtime KERNEL line — drivers, faults, syscalls — and
# (b) every console-bound RING-3 byte, because fd 1 is a VFS_DEVICE and `write(1,…)`
# walks vfs_write (core/vfs.cyr:960) → dev_write → serial_dev_write (core/devs.cyr:71)
# → kprint → klug_append. The newest byte is simply the last thing anyone printed,
# kernel or userland. The SIZING verdict above survives — 16 KB was too small either
# way — but the stated reason was wrong, and the truth costs log forensics:
#
# ⇒ PRINTING THE LOG RE-APPENDS THE LOG TO ITSELF. The `klug` tool's dump is up to
# 65536 bytes and this ring is exactly 65536, so dumping to the console re-appends the
# whole log. While the ring is still short of full (a ~20 KB iron boot log) that
# DOUBLES it, and the next dump wraps and takes the boot head with it — the one thing
# you were reading the log to find. `run /bin/klug > /f.txt` is REQUIRED, not merely
# convenient; the same instruction already stands at core/syscall.cyr:444. A pipe is
# safe for the same reason the redirect is: a pipe fd takes vfs_write's VFS_PIPE arm
# and never reaches kprint, so only grep's matches are console-bound.
#
# ⚠ THE MECHANISM IS DELIBERATELY UNFIXED — OPERATOR CALL AT 1.56.48. The redirect is
# the workflow, and the userland tool carries the warning (`klug --help` on AGNOS
# builds, in the klug repo). Two seams were weighed and BOTH declined; do not re-derive:
#   (a) klug#36 gains an op that dumps to the console kernel-side through a no-tap
#       emitter — race-free and lossless, but that is syscall ABI surface bought to
#       avoid a hazard a single `>` already avoids.
#   (b) serial_dev_write emits through a no-tap kprint — one function, kills the class
#       outright (no chatty ring-3 program can age the ring), but STRIPS RING-3 LINES
#       FROM THE RING, and klug_spill_covered_console() below exists precisely to
#       preserve those on a box whose console is covered by a full-screen app.
# ⛔ The kernel CANNOT simply special-case "klug's own write". The dump is an ordinary
# write(1,…) issued by a separate ring-3 instruction, indistinguishable from any other
# program's output — which is why (a) has to MOVE the write into the kernel rather
# than filter it, and why there is no cheap third option hiding here.

var klug_buf[8192];        # 64 KB (8192 * 8)
var klug_head = 0;         # next write offset, 0..65535
var klug_count = 0;        # total bytes captured, saturates at 65536 (wrap flag)

# Append one byte. The whole capture path is pure store8 + integer math — it must
# never call kprint/serial/fb (that would recurse through the tap), so it can run
# safely from the earliest boot, before any console backend is up.
fn klug_putc(ch) {
    store8(&klug_buf + klug_head, ch & 0xFF);
    klug_head = (klug_head + 1) & 0xFFFF;
    if (klug_count < 65536) { klug_count = klug_count + 1; }
    return 0;
}

# Append a (buf, len) run.
fn klug_append(buf, len) {
    var i = 0;
    while (i < len) {
        store8(&klug_buf + klug_head, load8(buf + i));
        klug_head = (klug_head + 1) & 0xFFFF;
        if (klug_count < 65536) { klug_count = klug_count + 1; }
        i = i + 1;
    }
    return 0;
}

# Leveled log helpers (1.42.12). Prefix the line with a severity tag then route
# through kprint — so the message is BOTH shown (serial+fb) AND captured into
# klug (via the kprint tap), and the prefix is the userland grep key (a
# `klug | grep '[E]'` shows only errors). [I] info / [W] warn / [E] err; terse
# single-char tags keep the log dense. The API is the bite-2 deliverable —
# adopt it gradually across the kernel, not in a mass conversion.
fn klug_info(buf, len) { kprint("[I] ", 4); kprintln(buf, len); return 0; }
fn klug_warn(buf, len) { kprint("[W] ", 4); kprintln(buf, len); return 0; }
fn klug_err(buf, len)  { kprint("[E] ", 4); kprintln(buf, len); return 0; }

# Validation (KLUG_SELFTEST): re-emit the captured ring between markers so a
# smoke can confirm the boot log was unified into klug. Emits via serial_print/
# fb_print DIRECTLY (not kprint), so the dump's own output is NOT re-captured
# into the ring it is reading — that avoids a read-during-write on the snapshot.
# Linear case (boot log << 16 KB, never wrapped) is the validated path; the
# wrapped-ring unwrap (oldest→newest from klug_head) lands with the klug syscall
# in 1.42.12. The call site is gated; this fn is DCE'd out of normal builds.
# klug_replay_fb — repaint the captured log to the FRAMEBUFFER ONLY (1.56.37).
#
# THE PROBLEM: agnos paints the boot console from line 1 at **boot_info's** geometry (this box:
# 2560x1440, pitch 10240) while DCN is still scanning the firmware's **800x600 pitch-832** surface and
# upscaling it. 2560-wide rows read as 832-px rows, so the first ~87 lines smear into the banding in every
# boot photo. At ~line 88 the register aperture maps, gpu_scanout_matchgeom reads the REAL viewport and
# clears — and those 87 lines are simply GONE, because a clear is all it ever did.
#
# ⭐ THE FIX IS A REPAINT, NOT A RE-DERIVATION. Every one of those lines is already in the ring: klug is fed
# from the earliest boot by a pure store8 path that runs before any console backend exists. So once the
# geometry is known, the whole log can simply be drawn again — correctly this time.
#
# ⛔ FB ONLY — never serial, and never back into the ring. This replays bytes the ring ALREADY holds; a
# serial echo would duplicate the whole boot log on a box that has one, and klug_append here would grow the
# ring by its own contents on every call. fb_print reaches fb_putc, which does NOT tap klug (only
# kprint/kprintln do), so the ring is untouched by construction — but say it out loud, because the next
# person to "make it consistent" with klug_dump above will reach for serial_print.
fn klug_replay_fb() {
    var n = klug_head;
    if (klug_count >= 65536) { n = 65536; }     # wrapped — best-effort, whole ring
    fb_print(&klug_buf, n);
    return 0;
}

fn klug_dump() {
    var begin = "KLUG-DUMP-BEGIN\n";
    serial_print(begin, 16); fb_print(begin, 16);
    var n = klug_head;
    if (klug_count >= 65536) { n = 65536; }     # wrapped — emit the whole ring (best-effort)
    serial_print(&klug_buf, n);
    fb_print(&klug_buf, n);
    var endm = "\nKLUG-DUMP-END\n";
    serial_print(endm, 15); fb_print(endm, 15);
    return 0;
}

# === H1 (gpu.md, modeset arc) — klug_spill: persist the log ring to agnos-fs ============================
#
# THE PROBLEM IT SOLVES: a bite whose failure blanks the console loses its diagnostic with it. The D lane
# burned five iron flashes for one result and **two of them produced no evidence at all** — the console died
# and the log died with it. Every risk row in the plan (R1, R2, R6) claims "log survives — spilled per
# group"; that claim is only true once this exists.
#
# ⚠ NON-JOURNALED ON PURPOSE. Uses ext2_write_at (ext2.cyr:3300), NOT ext2_write_at_journaled (:5259).
# A spill runs when things have already gone wrong; it must not be able to hang in journal replay with a
# dead console. A torn spill that yields most of the log beats a clean one that never returns.
#
# ⚠ BLOCKS ARE PRE-ALLOCATED AT MOUNT TIME, which is the whole point of the prepare/spill split. Creating
# the dirent is not enough: writing 64 KB into a 0-byte file allocates ~16 blocks, and the allocator is the
# last thing you want running after the console is gone. klug_spill_prepare() writes the full ring size once
# at mount, so every later spill is a pure OVERWRITE-IN-PLACE. That also sidesteps the extent-append limit
# ext2_write_at documents (overwrite works at any depth; append is depth-0 only).
#
# ⚠ vfs_create_on / vfs_write_on are NOT usable here — they dispatch FAT/exFAT only and return -1 for ext2
# (vfs.cyr:502-514). agnos-fs is ext2, so this goes straight at the ext2 layer.

var klug_spill_ino = 0;        # inode of the pre-allocated spill file (0 = not prepared)

# Pre-create AND pre-allocate the spill file. Call once, right after vfs_mount_init().
# Returns 1 if a later spill can run without touching the allocator, 0 otherwise.
fn klug_spill_prepare() {
    if (ext2_active == 0)   { return 0; }
    if (ext2_write_ok == 0) { return 0; }        # read-only mount — nothing to do, and not an error
    # H2/S7 — ⚠ ON A LATCH-BLOCKED (RECOVERY) BOOT, SPILL TO A DIFFERENT FILE. This prepare unconditionally
    # writes 64 KB over its target, so on the boot that came up to investigate a failed modeset it would
    # otherwise ERASE the very log the latch existed to protect. Sequential ifs — Cyrius has no chained
    # else-if. This is why modeset_latch_check() must run BEFORE this function, not after.
    var p = "/klug.txt";  var pl = 9;  var b = "klug.txt";  var bl = 8;
    if (modeset_latch_blocked != 0) { p = "/klug-2.txt"; pl = 11; b = "klug-2.txt"; bl = 10; }
    var ino = ext2_path_lookup(p, pl);
    if (ino <= 0) { ino = ext2_create(2, b, bl); }            # 2 = ext2 root
    if (ino <= 0) { kprintln("klug: spill file unavailable", 28); return 0; }
    # Allocate every block now, while the console is alive and a failure is readable. The content written
    # here is the ring as it stands at mount (mostly zeros this early) and is fully overwritten by a spill.
    if (ext2_write_at(ino, 0, &klug_buf, 65536) <= 0) {
        kprintln("klug: spill preallocation failed", 32);
        return 0;
    }
    klug_spill_ino = ino;
    kprintln("klug: spill file ready at /klug.txt", 35);
    return 1;
}

# Write the ring to the pre-allocated file, oldest byte first. Returns bytes written, 0 if unavailable.
#
# The ring is circular: once klug_count saturates at 65536 the oldest byte is at klug_head, not at 0, so a
# wrapped ring is spilled as TWO runs — [klug_head, 65536) then [0, klug_head) — which puts the file in
# chronological order. klug_dump() only ever handled the linear case; a spill taken after a long boot is
# exactly when the ring HAS wrapped, so getting this wrong would silently rotate the log.
fn klug_spill() {
    if (klug_spill_ino == 0) { return 0; }
    var n = 0;
    if (klug_count >= 65536) {
        var tail = 65536 - klug_head;                                  # oldest run: head -> end
        if (ext2_write_at(klug_spill_ino, 0, &klug_buf + klug_head, tail) <= 0) { return 0; }
        n = tail;
        if (klug_head > 0) {
            if (ext2_write_at(klug_spill_ino, tail, &klug_buf, klug_head) > 0) { n = n + klug_head; }
        }
    }
    if (klug_count < 65536) {
        if (ext2_write_at(klug_spill_ino, 0, &klug_buf, klug_head) <= 0) { return 0; }
        n = klug_head;
    }
    return n;
}

# klug_spill_covered_console() -> bytes written. Spill for a run whose output NOBODY COULD SEE.
#
# ⛔ Called by `gpu_release_pid` when a full-screen app that OWNED THE SCANOUT exits — normally or via
# `fault_kill_current`, which routes through the same place. While such an app runs, every kernel and
# userland line lands on a console underneath its frames; before this existed the desktop had no spill
# site at all, and the 2026-08-09 iron burn produced no evidence of any kind because of it.
#
# ⛔⛔ FACTORED OUT OF `gpu_release_pid` ON PURPOSE, AND THIS IS THE WHOLE REASON: `gpu_scanout_pid` is set
# only by `gpu_blit_present` (`#84`), which does DCN register writes — so **QEMU can never reach the real
# call site**, having no amdgpu. Left inline, this code would have shipped to iron with ZERO executions,
# which is how the window mover flew to hardware as dead code and how the GPU cursor ran for the first time
# anywhere on a burn. Living here, `KLUG_SPILL_SCANOUT_TEST` can call it directly on a substrate that has a
# disk. [[feedback_compiled_is_not_reachable]] [[reference_target_arm_contract_bugs_are_invisible_offtarget]]
#
# ⛔ BOOT CR3 FOR THE DISK WRITE, RESTORED AFTER. The spill is an ext2 write to NVMe and the live CR3 at the
# call site is the DYING process's, under which the NVMe BAR is not mapped. Same dance `spawn_path #43` does
# around `elf_load_from_file`, and restoring on the way out matters for the same reason: the fault path's
# tail runs a `kernel_resume`/`iretq` that expects the mappings it arrived with.
# ⚠ The kprint sits INSIDE the window deliberately — `fb_console` paints through the boot mappings, so it
# is safe there and would not be under a half-torn-down address space.
fn klug_spill_covered_console() {
    var kc_cr3 = dm_read_cr3();
    cr3_load(0x1000);
    var kc_n = klug_spill();
    # ⚠ REPORT THE COUNT, because `klug_spill()` is SILENT and returns 0 when `klug_spill_prepare()` never
    # got a usable inode — in which case /klug.txt still holds a STALE BOOT, which is the "looks fine, is
    # wrong" failure this whole mechanism exists to prevent. A number is the difference between evidence
    # and a file that lies.
    kprint("klug: the console was covered by this run -- spilled ", 53);
    kprint_num(kc_n);
    kprintln(" bytes to /klug.txt", 19);
    cr3_load(kc_cr3);
    return kc_n;
}

#ifdef KLUG_SPILL_SCANOUT_TEST
# The exercise for the above, because its production call site is UNREACHABLE OFF IRON (see the note there).
# Runs at boot on any substrate with a writable ext2 — which QEMU has — and proves the three things that can
# independently be wrong: the CR3 save/switch/restore survives (the box keeps booting after it), the spill
# returns a non-zero byte count, and the message reaches the console.
# ⚠ It asserts a NON-ZERO count rather than merely calling the function: a spill that quietly writes nothing
# is the exact failure the count was added to catch, and a test that ignores the return value would pass on it.
# ⭐ MUTATION-VERIFIED: forcing `kc_n = 0` in the function above turns this green line red
# (`SCANOUT-SPILL TEST FAILED -- spilled zero bytes`), so the count assertion genuinely bites.
#
# ⛔ BUT THE CR3 HALF OF THIS TEST IS WEAK HERE, AND SAYING SO IS THE POINT. It runs at BOOT, where the live
# CR3 already IS boot CR3 — so `cr3_load(0x1000)` changes nothing and `t_before == t_after` holds even if the
# restore were deleted. It catches only gross breakage (CR3 left at some third value). The case that matters
# — entry under a DYING PROCESS's CR3 — exists solely at the production call site, and this substrate has no
# safe way to manufacture it. ⚠ Do not read a PASS here as "the CR3 dance is proven"; the byte count is what
# this test proves. [[feedback_oracle_must_test_external_invariant]]
fn klug_spill_scanout_test() {
    var t_before = dm_read_cr3();
    var n = klug_spill_covered_console();
    var t_after = dm_read_cr3();
    if (n <= 0) {
        kprintln("klug: SCANOUT-SPILL TEST FAILED -- spilled zero bytes", 53);
        return 0;
    }
    if (t_before != t_after) {
        kprintln("klug: SCANOUT-SPILL TEST FAILED -- CR3 not restored", 51);
        return 0;
    }
    kprintln("klug: scanout-spill test PASS -- spilled, and CR3 came back", 59);
    return n;
}
#endif

#ifdef KLUG_SPILL_WRAPTEST
# H1 wrap exercise — the two-run chronological path, which a normal boot NEVER reaches.
#
# ⚠ WHY THIS IS NOT OPTIONAL. A QEMU boot log is ~2.5 KB and an iron boot ~16-20 KB, both far under the
# 64 KB ring, so klug_spill()'s wrapped branch would otherwise ship having never executed — and its failure
# mode is SILENT: the log still appears, just ROTATED, with the oldest lines in the middle. That is worse
# than no log, because it looks fine. (Same class as the ATOM rc codes that read 0 and made a test pass.)
#
# Forces a wrap, then plants two ordered markers. A correct spill puts AAA before BBB in the file; a naive
# spill from offset 0 puts them in ring order, which after a wrap is BBB first.
fn klug_spill_wraptest() {
    var pad = "................................................................\n";  # 65 bytes
    var i = 0;
    while (i < 1100) { klug_append(pad, 65); i = i + 1; }      # 71,500 bytes -> ring is definitely wrapped
    klug_append("KLUG-WRAP-AAA\n", 14);
    i = 0;
    while (i < 16) { klug_append(pad, 65); i = i + 1; }        # 1,040 bytes between the markers
    klug_append("KLUG-WRAP-BBB\n", 14);
    var n = klug_spill();
    kprint("klug: wraptest count=", 21); kprint_num(klug_count);
    kprint(" head=", 6); kprint_num(klug_head);
    kprint(" spilled=", 9); kprint_num(n); kprintln("", 0);
    return n;
}
#endif
