# === Stack Canary (S13) ===
# Random secret initialized at boot via RDRAND. Checked in critical functions
# to detect stack buffer overflows before they corrupt return addresses.
var stack_canary_secret = 0;

fn stack_canary_init() {
    # v1.28.0: use the shared rdrand_u64() helper (arch/x86_64/io.cyr +
    # arch/aarch64/stubs.cyr). Same entropy source as KASLR's
    # kaslr_seed() — one helper, two callers. The timer-mixer fallback
    # is preserved so the canary still gets a varying value if RDRAND
    # fails this boot.
    var val = rdrand_u64();
    if (val == 0) {
        val = timer_ticks * 6364136223846793005 + 0xDEAD1337CAFE4242;
    }
    stack_canary_secret = val;
    return 0;
}

fn stack_canary_check(canary) {
    if (canary != stack_canary_secret) {
        serial_println("PANIC: stack smash detected", 27);
        arch_halt();
    }
    return 0;
}

# === Syscall Interface ===
# Syscall#: 0=exit 1=write 2=getpid 3=spawn 4=waitpid 5=read 6=close 7=open
# 8=dup 9=mkdir 10=rmdir 11=mount 12=sync 13=reboot 14=pause 15=getuid
# 16=kill 17=sigprocmask 18=signalfd 19=epoll_create 20=epoll_ctl
# 21=epoll_wait 22=timerfd_create 23=timerfd_settime 24=umount 25=pipe
# 26=write_boot_checkpoint(byte) — diagnostic-only, writes CMOS[0x50]=arg1.
#    Added for iron-boot bring-up so userspace (kybernet) can mark progress
#    in the same CMOS slot the kernel uses. Will likely stay through MVP.
# 27=mmap(length) — anonymous, zero-filled, 2 MB-granular (1.35.3). The first
#    new functional syscall since v1.21.0; the CVE-2026-31431 immunity is
#    anchored on the absence of the AF_ALG/socket/splice surface, which mmap
#    (a pure memory syscall) does not add.
# 28=munmap(addr, length) — release an mmap region + free its physical 2 MB
#    pages (1.35.4). The natural pair to 27; same pure-memory posture.
# 45-57 = the net band (getrandom / time_unix / sock_* / udp_* / icmp_echo) — see
#    the inline handlers below + cyrius lib/syscalls_x86_64_agnos.cyr for the full map.
# 58=lseek(fd, offset, whence) — VFS_EXT2_FILE read/write cursor reposition (1.45.13).
# 59=flock(fd, op) — BSD advisory whole-file lock, inode-keyed, non-blocking, released
#    on close#6 + proc exit (1.45.13). Both serve the server-stage persistence/locking
#    consumers (descent libro/patra, agora shared-world door games).
# 60=winsize() — console char grid packed as (cols<<16 | rows) from the live
#    framebuffer (fb_width/fb_height/fb_scale, 8×16 glyph), or -1 (FB not up). No
#    args, no buffer (like uptime#40). Lets a ring-3 TUI size to the real console
#    instead of a hardcoded 80×24 (darshana tty_winsize on agnos → kii/cyim/chakshu). (1.45.13)
# 61=net_config / 62=exec_redirect / 63=symlink / 64-69=HDA audio band — see the
#    inline handlers below + cyrius lib/syscalls_x86_64_agnos.cyr for the full map.
# 70=readlink(path, pathlen, buf, buflen) — symlink INTROSPECTION peer of #63: read a
#    symbolic link's TEXT target into buf, returning the target byte length or -1. The
#    final path component is resolved NO-FOLLOW (ext2_path_lookup_ex follow_last=0) so it
#    reads the LINK, not its target; ext2-only. The ring-3 primitive a symlink manager
#    (hapi) needs to SEE an existing link + byte-compare its target (stat#33 follows).

var sys_exit_code = 0;

# --- execwait #37 nested-exec save block (1.43.x) ---
# Snapshot of agnsh's kernel resume context across the nested exec_and_wait(child).
# ALL module-global, NOT [rbp-N] locals: agnsh was itself entered via exec_and_wait
# (by kybernet PID 1), so the resume-context GLOBALS (exec_ctx + kernel_return_* +
# kpti_* + kernel_rsp_save) currently hold KYBERNET's armed frame — the frame
# agnsh's OWN exit() must longjmp into. The nested exec_and_wait(child) overwrites
# them with the #37-handler frame and kernel_resume zeroes kernel_return_*, so
# without a save/restore agnsh's later exit() would find kernel_return_rsp=0 and
# never resume kybernet. Single-slot: correct for one-level nesting under the
# single-threaded run-to-completion model (agnsh runs leaf programs); a recursive
# execwait is refused via ew37_busy. Module-global `var X[N]` = N*u64 — the 8-u64
# exec_ctx mirror is exactly right.
# 1.46.x SMP STEP-2 (#3, 2026-06-26): the ew37_* save block goes PER-CPU (the deferred note below,
# now resolved). Each CPU nesting a #37 gets its OWN snapshot — two CPUs in a #37 simultaneously
# (a bg-proc execwait on an AP while agnsh's #37 runs on the BSP) no longer collide on this scratch.
# Scalars: pcpu_X[4] cell at byte cpu*8; the ew37_ctx mirror: pcpu_ew37_ctx[32], block for cpu c at
# byte c*64 (ew37_ctx_base folds pcpu_cpu()*64 so the copy loop's +0..+56 read VERBATIM). pcpu_cpu()
# cpu_count<2 fast path = slot 0 → single-core byte-identical.
var pcpu_ew37_ctx[32];    # exec_ctx[0..7] mirror per CPU (kybernet's armed resume frame)
fn ew37_ctx_base() { return &pcpu_ew37_ctx + pcpu_cpu() * 64; }
var pcpu_ew37_kr_rsp[4];      # kernel_return_rsp (==1 armed)
fn ew37_kr_rsp_set(v) { store64(&pcpu_ew37_kr_rsp + pcpu_cpu() * 8, v); return 0; }
fn ew37_kr_rsp_get() { return load64(&pcpu_ew37_kr_rsp + pcpu_cpu() * 8); }
var pcpu_ew37_kr_rip[4];      # kernel_return_rip
fn ew37_kr_rip_set(v) { store64(&pcpu_ew37_kr_rip + pcpu_cpu() * 8, v); return 0; }
fn ew37_kr_rip_get() { return load64(&pcpu_ew37_kr_rip + pcpu_cpu() * 8); }
var pcpu_ew37_rsp_save[4];    # kernel_rsp_save — agnsh's user RSP (the exit stub reloads it pre-SYSRET)
fn ew37_rsp_save_set(v) { store64(&pcpu_ew37_rsp_save + pcpu_cpu() * 8, v); return 0; }
fn ew37_rsp_save_get() { return load64(&pcpu_ew37_rsp_save + pcpu_cpu() * 8); }
var pcpu_ew37_a4[4];          # ksyscall_a4 (defense-in-depth)
fn ew37_a4_set(v) { store64(&pcpu_ew37_a4 + pcpu_cpu() * 8, v); return 0; }
fn ew37_a4_get() { return load64(&pcpu_ew37_a4 + pcpu_cpu() * 8); }
var pcpu_ew37_pid[4];         # proc_current_get() (agnsh's pid)
fn ew37_pid_set(v) { store64(&pcpu_ew37_pid + pcpu_cpu() * 8, v); return 0; }
fn ew37_pid_get() { return load64(&pcpu_ew37_pid + pcpu_cpu() * 8); }
var pcpu_ew37_resume_pid[4];  # 1.44.14: exec_resume_pid (agnsh) saved across the nested exec
fn ew37_resume_pid_set(v) { store64(&pcpu_ew37_resume_pid + pcpu_cpu() * 8, v); return 0; }
fn ew37_resume_pid_get() { return load64(&pcpu_ew37_resume_pid + pcpu_cpu() * 8); }
var pcpu_ew37_cr3[4];         # agnsh's CR3 (kpti_user_cr3 the exit stub reloads into CR3)
fn ew37_cr3_set(v) { store64(&pcpu_ew37_cr3 + pcpu_cpu() * 8, v); return 0; }
fn ew37_cr3_get() { return load64(&pcpu_ew37_cr3 + pcpu_cpu() * 8); }
var pcpu_ew37_cpid[4];        # child pid (per-CPU; a [rbp-N] local would survive the disjoint kstack
fn ew37_cpid_set(v) { store64(&pcpu_ew37_cpid + pcpu_cpu() * 8, v); return 0; }   # too, but the slot is the contract)
fn ew37_cpid_get() { return load64(&pcpu_ew37_cpid + pcpu_cpu() * 8); }
var pcpu_ew37_code[4];        # child exit code captured post-resume
fn ew37_code_set(v) { store64(&pcpu_ew37_code + pcpu_cpu() * 8, v); return 0; }
fn ew37_code_get() { return load64(&pcpu_ew37_code + pcpu_cpu() * 8); }
# 1.46.x SMP sub-bite 4d: the #37 re-entrancy guard goes PER-CPU (was a single global `ew37_busy`).
# Each CPU tracks its OWN nested-exec state so a #37 in flight on CPU N does not block CPU M. Capped
# via pcpu_cpu() (syscall_hw.cyr); single-core fast path = slot 0 → byte-for-byte the old global.
# RESOLVED 1.46.x STEP-2 (#3, 2026-06-26): the ew37_* SCRATCH (ew37_cr3/_cpid/_code/_path/_env + ew37_ctx
# + the kr/rsp_save/a4/pid/resume_pid scalars) are NOW per-CPU (above + below), joining the already-per-CPU
# kernel_rsp_save+kpti_* (4b/4c). Two CPUs nesting #37 SIMULTANEOUSLY (reachable post-flip: a bg-proc
# execwait on an AP while agnsh's #37 runs on the BSP) each get their own slot — no scratch collision.
var pcpu_ew37_busy[4];
fn pcpu_ew37_busy_get() { return load64(&pcpu_ew37_busy + pcpu_cpu() * 8); }
fn pcpu_ew37_busy_set(v) { store64(&pcpu_ew37_busy + pcpu_cpu() * 8, v); return 0; }
var pcpu_ew37_path[64];   # 1.46.x STEP-2 (#3): PER-CPU. 16 u64 (128 B) per CPU × 4; cpu c at byte c*128.
fn ew37_path_base() { return &pcpu_ew37_path + pcpu_cpu() * 128; }   # kernel copy of the caller's path cstr (128 B). elf_load_from_file
# does ext2/NVMe I/O under boot CR3 (the user VA + the NVMe BAR are
# NOT both mapped under one CR3), so the path is copied here from the
# user buffer BEFORE the CR3 switch — mirroring sh_cmd_run's sh_path_buf.

# 1.44.10: spawn(#3) in-memory-ELF staging buffer (16 KB = 2048 u64). A ring-3
# PARENT calling spawn runs the handler under the PARENT's CR3, which mirrors only
# 0-256 MB + the GB ranges — so elf_load's fresh page-table pages (allocated
# anywhere in phys) may land in the 256 MB-1 GB gap the parent CR3 does NOT map,
# mis-wiring the child's tables (the 1.44.9 #UD-at-child-entry blocker). The user
# ELF is copied here while the caller CR3 still resolves it, then elf_load runs
# under boot CR3 0x1000 (maps all phys) — the proven 1.44.8 kernel-side condition.
# Mirrors the execwait#37 copy-then-boot-CR3 idiom (no kstack swap — spawn does not
# block). 16 KB bounds an in-memory payload; real binaries load from disk (#37).
# 1.46.x SMP STEP-2 (#3): PER-CPU. Two CPUs each in spawn#3 (e.g. a bg-proc spawn on an AP) would
# clobber one another's staging. 2048 u64 (16 KB) per CPU × 4; cpu c at byte c*16384.
var pcpu_spawn_elf_buf[8192];
fn spawn_elf_buf_base() { return &pcpu_spawn_elf_buf + pcpu_cpu() * 16384; }

# 1.44.11: spawn_path(#43) path/argv staging buffer ([16] = 16 u64 = 128 B, exactly like
# ew37_path — a module-global var X[N] is N*u64 = 8N bytes). Holds the caller's "PATH
# [args..]" line (capped ≤127 by the arg2>127 guard) for the NON-BLOCKING from-disk spawn —
# copied here under the caller CR3 BEFORE the boot-CR3 switch (the user VA won't resolve once
# CR3 is the NVMe-BAR-mapping boot CR3). A DEDICATED buffer (not ew37_path) so a #43 from a
# bg proc can never collide with agnsh's in-flight #37 frame.
var pcpu_spawn_path_buf[64];   # 1.46.x STEP-2 (#3): PER-CPU. 16 u64 (128 B) per CPU × 4; cpu c at byte c*128.
fn spawn_path_buf_base() { return &pcpu_spawn_path_buf + pcpu_cpu() * 128; }
# 1.44.19: per-process env staging — kernel copies of the caller's flat "KEY=V\0KEY=V\0"
# blob (a3=ptr, a4=len on #37/#43; <=1024 B, <=16 entries). DEDICATED buffers per the
# spawn_path_buf rationale above (a bg-proc #43 must never collide with agnsh's in-flight
# #37 frame). No ew37-style save/restore needed: the blob is fully consumed onto the
# child's stack page INSIDE elf_load_from_file, which returns before exec_and_wait runs
# the child — by the time any nested syscall exists, these contents are dead.
# [128] = 128 u64 = 1024 B each (the 8N module-global rule).
var pcpu_ew37_env[512];   # 1.46.x STEP-2 (#3): PER-CPU execwait(#37) env staging. 128 u64 (1024 B) per CPU × 4; cpu c at byte c*1024.
fn ew37_env_base() { return &pcpu_ew37_env + pcpu_cpu() * 1024; }

# 1.46.x (fd-redirect for output capture) — issue 2026-06-15-cyrius-stdlib-missing-syscalls
# group 1 ("the high-value one": an fd-redirect primitive for capturing subprocess helpers;
# consumers: cyrius's regression test-runner (run-a-tool-and-read-its-stdout), shakti session
# logging). A ONE-SHOT redirect consumed by the NEXT execwait#37: route the child's writes to
# `redir_src_fd` (e.g. 1=stdout) to `redir_dst_fd`'s backend (an open writable file or pipe).
# Works because #37 is run-to-completion (the parent is suspended while the child runs), so we
# save the src fd's vfs_table entry, copy the dst entry over it for the child's run, and restore
# on resume — no per-proc fd table needed. NOT applied to the non-blocking spawn#3 (the child
# runs later → a per-proc redirect is the follow-on). vfs_table entry = 32 B (4 u64).
# 1.46.x SMP STEP-2 (#3): PER-CPU. The redirect spans TWO syscalls (exec_redirect#62 arms, the
# next execwait#37 consumes) — both run on the SAME CPU (each CPU's agnsh/bg-proc arms then execs
# on itself), so per-CPU state keeps one CPU's armed redirect from leaking into another CPU's #37.
var pcpu_redir_pending[4];   # 1 = a redirect is armed for the next execwait#37
fn redir_pending_set(v) { store64(&pcpu_redir_pending + pcpu_cpu() * 8, v); return 0; }
fn redir_pending_get() { return load64(&pcpu_redir_pending + pcpu_cpu() * 8); }
var pcpu_redir_src_fd[4];    # the fd the child writes to (gets repointed)
fn redir_src_fd_set(v) { store64(&pcpu_redir_src_fd + pcpu_cpu() * 8, v); return 0; }
fn redir_src_fd_get() { return load64(&pcpu_redir_src_fd + pcpu_cpu() * 8); }
var pcpu_redir_dst_fd[4];    # the backend the writes go to
fn redir_dst_fd_set(v) { store64(&pcpu_redir_dst_fd + pcpu_cpu() * 8, v); return 0; }
fn redir_dst_fd_get() { return load64(&pcpu_redir_dst_fd + pcpu_cpu() * 8); }
var pcpu_redir_backup[16];   # 4 u64 (32-byte vfs_table entry save) per CPU × 4; cpu c at byte c*32.
fn redir_backup_base() { return &pcpu_redir_backup + pcpu_cpu() * 32; }

# Apply the armed redirect: save vfs_table[src] into redir_backup, copy vfs_table[dst] over it.
# Called by execwait#37 right before running the child (under boot CR3 — vfs_table is kernel
# memory, identity-mapped). No-op when nothing is armed (so #37 stays byte-identical by default).
fn exec_redirect_apply() {
    if (redir_pending_get() == 0) { return 0; }
    var rsrc = vfs_fd_table_of(ew37_cpid_get()) + redir_src_fd_get() * 32;
    var rdst = vfs_fd_table_of(ew37_cpid_get()) + redir_dst_fd_get() * 32;
    var rbk = redir_backup_base();
    var k = 0;
    while (k < 32) {
        store64(rbk + k, load64(rsrc + k));   # save src entry
        store64(rsrc + k, load64(rdst + k));             # src <- dst (child's writes now route to dst)
        k = k + 8;
    }
    return 0;
}
# Restore the src fd entry after the child run; clears the one-shot.
fn exec_redirect_restore() {
    if (redir_pending_get() == 0) { return 0; }
    var rsrc = vfs_fd_table_of(ew37_cpid_get()) + redir_src_fd_get() * 32;
    var k = 0;
    var rbk = redir_backup_base();
    while (k < 32) { store64(rsrc + k, load64(rbk + k)); k = k + 8; }
    redir_pending_set(0);
    return 0;
}

# 1.56.39 — the spawn_path#43 arm of the SAME one-shot redirect #62 arms. Until now #43 never
# consumed it: only #37 did (exec_redirect_apply above), so a BACKGROUND child's stdout could not
# be pointed anywhere and every concurrent proc wrote to the console at once. That is not cosmetic
# — three interleaved desktop procs already corrupted a verdict on 2026-08-02, landing
# `a11y nodes synced:run: exit 142` mid-line and costing the boot that carried the evidence.
#
# APPLY-ONLY, deliberately: #37 needs the save/restore pair because it is run-to-completion — the
# parent is suspended, the child runs on the parent's own table entry, and the entry has to go
# back. #43 is the opposite shape. The child is created holding its OWN private fd table (
# vfs_fd_inherit, from proc_create_user), the parent stays live and never blocks, and there is no
# later moment at which "restore" would mean anything. The swap is written into the child's copy,
# is private to that child for its whole life, and dies with the table at reap. No backup slot is
# taken, so this cannot collide with a #37 redirect armed on another CPU.
#
# ⛔ REFUSES when the target's table IS the global `vfs_table`. Writing the redirect there would
# repoint fd 1 for proc 0, every kthread and every later global-table user, permanently, with
# nothing anywhere to restore it. A skipped redirect is an interleaved console line; a corrupted
# global table is the box. Refuse, say so, and move on.
#
# ⛔ THE TEST IS THE RESOLVED TABLE, NOT `proc_fd_base_get(pid) == 0`. Two DIFFERENT states mean
# "this proc uses the global table" and only one of them is a zero base:
#   - `proc_fd_base[pid] == 0` — the implicit fallback, which is what vfs_fd_inherit leaves behind
#     when its kmalloc fails (it returns 0 on success AND on that failure, so no caller can tell);
#   - `proc_fd_base[pid] == &vfs_table` — set EXPLICITLY for proc 0 at `vfs.cyr:264`
#     (*"proc 0 (kmain/kybernet) owns the static global table"*).
# A `== 0` guard passes the second one straight through and writes the global table. That is not
# hypothetical: it is what the first build of this function did, and the boot selftest caught it on
# proc 0 (`spawnredir: FAIL global not refused`). `vfs_fd_table_of` folds both states into one
# answer, which is why the comparison belongs on its result — the same shape `proc_destroy_fd_table`
# already uses at `vfs.cyr:234-235`.
#
# Clears the one-shot on BOTH paths — a refusal that left it armed would silently apply to the
# next spawn instead, which is the wrong child.
fn spawn_redirect_apply(pid) {
    if (redir_pending_get() == 0) { return 0; }
    redir_pending_set(0);
    var stbl = vfs_fd_table_of(pid);
    if (stbl == &vfs_table) {
        kprintln("spawn: child is on the global fd table -- redirect skipped", 58);
        return 0 - 1;
    }
    var ssrc = stbl + redir_src_fd_get() * 32;
    var sdst = stbl + redir_dst_fd_get() * 32;
    var sk = 0;
    while (sk < 32) {
        store64(ssrc + sk, load64(sdst + sk));
        sk = sk + 8;
    }
    return 0;
}
var pcpu_spawn_env_buf[512];   # 1.46.x STEP-2 (#3): PER-CPU spawn_path(#43) env staging. 128 u64 (1024 B) per CPU × 4; cpu c at byte c*1024.
fn spawn_env_buf_base() { return &pcpu_spawn_env_buf + pcpu_cpu() * 1024; }
# 1.44.20: blit#39 scaled-row staging — ONE expanded src row (w*scale px, 32bpp). [4096] =
# 4096 u64 = 32 KB (8N), the invariant the handler's `w*scale <= 8192` gate enforces (NOT
# "max FB row" — the expanded width is what lands here). Single-core IF=0 handler scratch.
var fb_scale_rowbuf[4096];

# Security: a userspace pointer must lie in the user VA window [0x200000, 0x40000000):
# above the kernel low region (0-2 MB) and below the 1 GB arena ceiling. EVERY
# legitimate user address is below 1 GB — ELF segments (p_vaddr >= 2 MB, p_memsz
# <= 32 MB, so < 34 MB), the per-pid user stack (0x800000 + pid*0x400000, < 72 MB
# for the 16-process cap), and the mmap arena [0x10000000, 0x40000000). Device
# MMIO / PCI BARs (e.g. NVMe ~0xC0000000) and the 1-4 GB PDPT range the per-process
# CR3 ALSO mirrors all sit ABOVE the ceiling — so without the upper bound a ring-3
# caller could aim a kernel load64/store64 at MMIO or high kernel memory (1.41.5).
# Returns 1 if the pointer/range is safe, 0 otherwise.
fn is_user_ptr(ptr) {
    if (ptr < 0x200000) { return 0; }
    if (ptr >= 0x40000000) { return 0; }   # above the 1 GB user ceiling
    return 1;
}

fn is_user_range(ptr, len) {
    if (ptr < 0x200000) { return 0; }
    if (ptr + len < ptr) { return 0; }          # wrap check
    if (ptr + len > 0x40000000) { return 0; }    # above the 1 GB user ceiling
    return 1;
}

# A RELATIVE path (no leading '/') has no CWD in agnos, so it is rooted at the "/"
# mount — the writable ext2/primary root. This scratch buffer holds the "/"-prepended
# form so bare names (`touch foo`, `cmd > foo`) create in the root FS instead of
# falling through to the read-only initrd (the open handler uses it; the ext2 lookup
# needs the leading '/'). Single-threaded per syscall ⇒ one shared buffer is safe.
var sc_open_abs[32];   # 256 bytes: '/' + up to 254-char relative name

# 1.41.6 (#22): the path-argument preamble every mount-routed FS syscall shares —
# a non-empty length AND a valid user range. Returns 1 if (ptr,len) is an
# acceptable path argument, 0 otherwise. Pure factoring of the duplicated
# `if (len < 1) ... if (is_user_range(ptr,len) == 0) ...` pair; callers keep
# their own canary/return conventions on the reject.
fn sc_path_ok(ptr, len) {
    if (len < 1) { return 0; }
    return is_user_range(ptr, len);
}

# 1.44.19: validate a KERNEL COPY of a caller env blob — flat NUL-separated "KEY=V\0KEY=V\0".
# Rules: the last byte MUST be NUL; every NUL-split entry must be non-empty with '=' (61) at
# index >= 1 (a KEY exists); 1..16 entries. The 16-entry cap is LOAD-BEARING, not stylistic:
# the SysV envp pointer array ends at stack offset 0x3008+(argc+3+envc)*8 and must stay below
# the 0x3100 string base (elf.cyr) — with argc<=8, envc=16 tops out at 0x30E0; envc>=20 would
# overwrite the first string bytes. Enforced HERE on the kernel copy, never trusted from
# caller-side counts. Returns 1 ok / 0 reject (the callers fall back to the default env).
fn sc_env_blob_ok(buf, len) {
    if (len < 1) { return 0; }
    if (load8(buf + len - 1) != 0) { return 0; }     # must end on a NUL
    var entries = 0;
    var i = 0;
    while (i < len) {
        var es = i;
        while (i < len) { if (load8(buf + i) == 0) { break; } i = i + 1; }
        var el = i - es;                              # entry [es, es+el), NUL at i
        if (el > 0) {
            # require a '=' at index >= 1 within the entry
            var eq = 0;
            var j = es + 1;
            while (j < es + el) { if (load8(buf + j) == 61) { eq = 1; break; } j = j + 1; }
            if (eq == 0) { return 0; }
            entries = entries + 1;
            if (entries > 16) { return 0; }
        }
        i = i + 1;                                    # skip the NUL
    }
    if (entries < 1) { return 0; }
    return 1;
}

# Resume kernel execution after a user process exits, by performing
# exec_and_wait's epilogue: ret_rsp is exec_and_wait's OWN rbp, so
# `mov rsp, ret_rsp; pop rbp; ret` restores the caller's rbp and returns into
# the caller (sh_cmd_run) exactly as if exec_and_wait had returned normally —
# letting the kernel/shell continue (run more programs) instead of halting on a
# garbage rbp. (1.40.4 — the old version jmp'd without restoring rbp.)
fn kernel_resume() {
    # 1.42.14 SECURITY (audit #3): the SYSCALL entry stub's STAC (AC=1, SMAP off
    # for the user-copy window) is paired with a CLAC only on the NORMAL return.
    # The exit syscall (num==0) reaches here and longjmps out (jmp rdx below) —
    # it never returns to the stub, so AC would stay 1 and ALL post-exit kernel
    # work (the next `run`, ext2/VFS) would execute with SMAP disabled. Re-enable
    # SMAP here so the exit path resumes with the backstop intact.
    asm {
        0x0F; 0x01; 0xCA;   # clac
    }
    kernel_return_rsp_set(0);
    kernel_return_rip_set(0);
    # 1.40.10 bite 2 — restore the kernel main thread (proc 0) as current after a
    # program exits. sh_cmd_run sets proc_current_get() = the exec pid for exit-code
    # attribution; without this reset proc_current_get() stays on that now-dead
    # (state=0) proc, and the next timer tick's do_context_switch (sched.cyr)
    # takes it as `old` and unconditionally marks it ready again (line 150,
    # deliberately unconditional per iron Attempt 14 — do NOT make it conditional),
    # resurrecting a dead exec proc that sched_next could then switch into → an
    # iretq into ring-3 user code under CS=0x08. Pointing proc_current_get() back at
    # proc 0 (the kmain thread registered before sched_active=1) keeps every
    # post-exit timer tick switching kmain↔idle only. Exit-code attribution is
    # unaffected: sh_cmd_run reads the local pid (shell.cyr:765), not proc_current_get(),
    # and the exit code was already stamped before kernel_resume was called. During
    # the boot exec selftest sched_active=0 (no scheduling) so this is a no-op there.
    proc_current_set(0);
    # 1.53.x B3b: arm #NM for the resumed context — the foreground-exec-return longjmps
    # back to the parent WITHOUT passing through enter_ring3 or the scheduler, so its
    # next SSE op must fault to FXRSTOR its FP area rather than run on the reaped child's
    # stale XMM. Bare CR0.TS RMW; the kernel is FP-free so TS=1 is inert until that op.
    fpu_set_ts();
    # 1.40.6: restore the BOOT kernel CR3 (0x1000). On the program's exit the
    # SYSCALL stub left CR3 = the per-process CR3, which mirrors only 0-1 GB +
    # PDPT[1..3] — it does NOT map the device MMIO (NVMe BAR ~0xC0000010xx) that
    # the next kernel work (ext2 read for the next `run`) touches → a second
    # sequential exec faulted on the NVMe BAR. Switch back to the boot CR3 (maps
    # everything, incl. MMIO) so the kernel runs clean after a program exits.
    # kernel_resume's code + exec_ctx are in 0-2 MB, mapped under 0x1000 too.
    asm {
        0x48; 0xC7; 0xC0; 0x00; 0x10; 0x00; 0x00;  # mov rax, 0x1000
        0x0F; 0x22; 0xD8;                           # mov cr3, rax
    }
    # Switch back to kernel data segments (SS/DS/ES = 0x10).
    asm {
        0x48; 0xC7; 0xC0; 0x10; 0x00; 0x00; 0x00;  # mov rax, 0x10
        0x8E; 0xD8;  # mov ds, ax
        0x8E; 0xC0;  # mov es, ax
        0x8E; 0xD0;  # mov ss, ax
    }
    # Restore the full resume context exec_and_wait saved (callee-saved regs +
    # caller rbp + return rsp/rip), then jmp — exec_and_wait "returns" exactly
    # as a normal call. `var c = &exec_ctx` lands the address in rax; rdx scratch.
    var c = exec_ctx_base();
    asm {
        0x48; 0x8B; 0x18;        # mov rbx, [rax]
        0x4C; 0x8B; 0x60; 0x08;  # mov r12, [rax+8]
        0x4C; 0x8B; 0x68; 0x10;  # mov r13, [rax+16]
        0x4C; 0x8B; 0x70; 0x18;  # mov r14, [rax+24]
        0x4C; 0x8B; 0x78; 0x20;  # mov r15, [rax+32]
        0x48; 0x8B; 0x68; 0x28;  # mov rbp, [rax+40]   (caller rbp)
        0x48; 0x8B; 0x50; 0x38;  # mov rdx, [rax+56]   (return rip)
        0x48; 0x8B; 0x60; 0x30;  # mov rsp, [rax+48]   (caller post-call rsp)
        0xFF; 0xE2;              # jmp rdx
    }
    return 0;
}

# === proc-teardown-on-fault (1.47.x fault-resilience arc) ===
# A RING-3 (CPL3) CPU exception (#PF/#GP/#UD) is routed here by the idt.cyr exception
# stub, which calls this ONLY when the saved-frame CS has RPL==3 (a ring-3 fault), instead
# of painting the 1.45.16 fault-canary bar and halting the box. We mirror exit#0's teardown
# for the FAULTING proc, then — when it is the foreground exec_and_wait child (the common
# case: agnsh exec'd a tool that segfaulted, e.g. the cyrius-doom OOB #PF) — kernel_resume()
# back into agnsh EXACTLY as a clean exit would (restores boot CR3 + the saved continuation;
# DOES NOT RETURN). A userland segfault must not take the whole system down.
#
# Scope (first bite): the foreground child case. A CPL3 fault in a `&` BACKGROUND job
# (proc_current != exec_resume_pid) returns to the stub, which halts — bg-proc fault teardown
# needs a scheduler-yield-from-fault path (follow-on, same arc). A KERNEL (CPL0) fault never
# reaches here (the stub gates on RPL==3), so a real kernel bug still halts loudly behind the
# canary bar — the CPL0 path is deliberately untouched.
#
# Runs on the faulting proc's OWN per-proc RSP0 kstack (1.46.x region-7) with the proc's CR3
# still loaded — identical to exit#0, which also runs its teardown on the child's CR3 before
# kernel_resume switches to boot CR3. The IDT interrupt gate cleared IF on entry, so the
# teardown is uninterruptible (no preemption mid-teardown), matching exit#0's IF=0 handler.
#
# Exit code = 128 + vector (POSIX-ish): a fault-killed proc is distinguishable from a small
# clean exit code. agnsh surfaces it via its normal "run: exit N" path; a dedicated
# "killed (#PF)" message is a userland (agnoshi) follow-on (kprint here is unsafe — the FB
# may be unmapped under the faulting proc's CR3, per the idt.cyr canary-paint #DF note).
fn fault_kill_current(vector) {
    var pid = proc_current_get();
    var code = 128 + vector;
    # ⭐ SAY WHERE THE FAULT WAS, not merely that there was one. Until this line, the ONLY record a
    # fault-killed proc left was `128 + vector` — so `run: exit 142` meant "#PF killed it" and
    # nothing more: no address, no localisation. That is not enough to iterate on an IRON-ONLY
    # fault, which is exactly the class this path exists to explain (the 2026-08-02 desktop burn:
    # the compositor died at its nested `spawn_path` with no way to ask which address).
    # ⛔ kprint IS genuinely unsafe here — the FB may be unmapped under the faulting proc's CR3
    # (idt.cyr's canary-paint #DF note), and that comment is why this path stayed mute. But
    # `klug_append` is pure store8 + integer math into a kernel-resident ring, which is mapped
    # under every per-proc CR3; the same property that makes it safe at the earliest boot makes it
    # safe here. Read it after the box survives: `run /bin/klug > /f.txt`.
    # ⚠ CR2 is valid until the NEXT page fault, so it must be read here, before anything else runs.
    var fk_hex[16];                                   # fn-local var[N] = N BYTES; 16 hex digits exactly
    var fk_n = 0;
    klug_append("fault: pid=", 11);
    fk_n = fmt_hex_buf(pid, &fk_hex);       klug_append(&fk_hex, fk_n);
    klug_append(" vec=", 5);
    fk_n = fmt_hex_buf(vector, &fk_hex);    klug_append(&fk_hex, fk_n);
    klug_append(" cr2=0x", 7);
    fk_n = fmt_hex_buf(dm_read_cr2(), &fk_hex);  klug_append(&fk_hex, fk_n);
    # ⭐ THE ERROR CODE AND THE FAULTING RIP WERE ALREADY BEING CAPTURED AND THROWN AWAY. The #PF
    # stub (idt.cyr) stamps CMOS **before** it dispatches to this kill path: 0x5F = the error-code
    # low byte, 0x63-0x66 = the faulting RIP's low 32 bits. Nothing ever read them back on a
    # SURVIVABLE kill — they were built for the halt/reboot path, where CMOS is the only medium that
    # outlives the box. Reading them here costs four port reads and turns "something faulted at
    # address X" into "this instruction did this KIND of access to X".
    # ⚠ ERROR-CODE BITS (SDM Vol.3 4.7): 0=P (0 -> page NOT PRESENT / not visible to this CPU,
    # 1 -> protection violation on a present page) · 1=W/R (1 -> the access was a WRITE) ·
    # 2=U/S (1 -> the access was from RING 3) · 3=RSVD · 4=I/D (1 -> INSTRUCTION FETCH, i.e. the
    # proc jumped into a page it may not execute — the NX/W^X signature).
    # That present-bit alone splits "the mapping is not visible here" (a TLB/CR3/SMP problem) from
    # "the mapping is visible and refused the access" (a permissions problem), which is the exact
    # fork the desktop's spawn fault sits on.
    klug_append(" err=0x", 7);
    fk_n = fmt_hex_buf(cmos_read(0x5F), &fk_hex);   klug_append(&fk_hex, fk_n);
    var fk_rip = cmos_read(0x63) | (cmos_read(0x64) << 8) | (cmos_read(0x65) << 16) | (cmos_read(0x66) << 24);
    klug_append(" rip=0x", 7);
    fk_n = fmt_hex_buf(fk_rip, &fk_hex);            klug_append(&fk_hex, fk_n);
    # ⭐ IS THE PROC EVEN RUNNING ON ITS OWN ADDRESS SPACE? A not-present fault has two very
    # different causes that no address can separate: the mapping vanished from THIS proc's tables,
    # or the CPU is running this proc on ANOTHER proc's CR3. They are indistinguishable by CR2
    # because every ring-3 image loads at the same 0x400000, so a small child's CR3 maps the
    # 2 MB page the parent is executing from (PD[2]) while lacking the ones a large parent needs.
    # Print both and the ambiguity is gone: live != own ⇒ a scheduler/context-switch defect;
    # live == own ⇒ the page tables really did lose the entry.
    # ⚠ Low 32 bits only — CR3s here are well under 4 GB and the line stays readable.
    klug_append(" cr3=0x", 7);
    fk_n = fmt_hex_buf(dm_read_cr3() & 0xFFFFF000, &fk_hex);   klug_append(&fk_hex, fk_n);
    klug_append(" own=0x", 7);
    fk_n = fmt_hex_buf(proc_get_cr3(pid) & 0xFFFFF000, &fk_hex); klug_append(&fk_hex, fk_n);
    # ⭐ THE RAW PD ENTRY FOR THE FAULTING ADDRESS. cr3 == own proves the proc is on its own
    # address space, so a not-present fault means the ENTRY itself is wrong — and there are two
    # very different wrongs: 0 (never mapped, or cleared out from under it) versus non-zero with
    # bad flags (mapped but, say, present-bit cleared or the wrong physical frame). Walking the
    # same PML4[0]->PDPT[0]->PD path proc_map_page_nx writes through keeps this honest: if the
    # walk disagrees with the hardware, the walk is what is wrong, not the CPU.
    var fk_pml4e = load64(dm_read_cr3() & 0xFFFFF000);
    var fk_pdpte = load64(fk_pml4e & 0xFFFFFFFFF000);
    var fk_pd    = fk_pdpte & 0xFFFFFFFFF000;
    var fk_pde   = load64(fk_pd + ((dm_read_cr2() >> 21) & 0x1FF) * 8);
    klug_append(" pde=", 5);
    if (fk_pde < 0) { klug_append("NX|", 3); }
    fk_n = fmt_hex_buf(fk_pde & 0x7FFFFFFFFFFFFFFF, &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" pdeP=", 6);
    fk_n = fmt_hex_buf(fk_pde & 1, &fk_hex);        klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    # ⭐ WHICH PD DID THIS WALK LAND ON? ELF_PDE_PROBE records the PD address it wrote each PDE into.
    # If the two disagree, the PDE was never cleared — the WALK diverged, i.e. PML4[0] or PDPT[0] is
    # corrupt and the fault handler (and the CPU) are consulting a different page entirely. That
    # distinction is invisible to a pde= value alone, which reads 0 in both cases.
    klug_append(" HWCR3=0x", 9);
    fk_n = fmt_hex_buf(pf_hw_cr3 & 0xFFFFF000, &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" HWCR2=0x", 9);
    fk_n = fmt_hex_buf(pf_hw_cr2, &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" fpml4=0x", 9);
    fk_n = fmt_hex_buf(fk_pml4e & 0xFFFFFFFFF000, &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" fpd=0x", 7);
    fk_n = fmt_hex_buf(fk_pd, &fk_hex);             klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    # ⭐ NEIGHBOURS. One cleared entry and a wholesale overwrite of the PD page both read pde=0 at the
    # victim index and are otherwise indistinguishable. If PD[2] (image), PD[509] (guard) and PD[511]
    # (the user-PML4 stash) survive while the victim is 0, exactly one entry was cleared. If they are
    # ALL zero, the page's memory was destroyed — a stray write or DMA, not paging logic.
    klug_append(" n2=0x", 6);
    fk_n = fmt_hex_buf(load64(fk_pd + 2 * 8), &fk_hex);   klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" n509=0x", 8);
    fk_n = fmt_hex_buf(load64(fk_pd + 509 * 8), &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" n510=", 6);
    if (load64(fk_pd + 510 * 8) < 0) { klug_append("NX|", 3); }
    fk_n = fmt_hex_buf(load64(fk_pd + 510 * 8) & 0x7FFFFFFFFFFFFFFF, &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" stash=0x", 9);
    fk_n = fmt_hex_buf(load64(fk_pd + 511 * 8), &fk_hex); klug_append(&fk_hex, fk_n);
    if (fk_n == 0) { klug_append("0", 1); }
    klug_append(" idx=", 5);
    fk_n = fmt_hex_buf((dm_read_cr2() >> 21) & 0x1FF, &fk_hex);  klug_append(&fk_hex, fk_n);
    klug_putc(10);
    sys_exit_code = code;
    proc_set_exit_code(pid, code);
    flock_release_pid(pid);                       # release advisory locks (mirror exit#0)
    snd_release_pid(pid);                         # release any snd#64 audio slot (Gate 2)
    shm_release_pid(pid);                         # 1.56.40 bite 1: release shm#71/#86 slots (mirror exit#0)
    chan_release_pid(pid);                        # 1.56.40 bite 4: release #97 channel endpoints (mirror exit#0)
    gpu_release_pid(pid);                         # 1.55.x: hand the scanout back to the console. Without
    # this a full-screen app that FAULTS would strand its last
    # frame on the panel forever while the console scrolled
    # invisibly — the crash path must mirror exit#0 exactly.
    if (pid < proc_count) {
        proc_set_state(pid, 0);                   # mark dead — sched_next won't pick it
        # 1.53.x B3b: clear this CPU's FP owner if it named the dying proc, so a recycled
        # slot (same pid) doesn't hit nm_handler's prev==cur fast-path and SKIP the restore
        # (a silent XMM leak into the new occupant). No fxsave — the dying XMM is garbage.
        var _fkc = pcpu_cpu();
        if (load64(&fpu_owner + _fkc * 8) == pid) { store64(&fpu_owner + _fkc * 8, 0 - 1); }
        var ppid = proc_get_ppid(pid);
        if (ppid >= 0) { proc_send_signal(ppid, 17); }   # SIGCHLD to parent
    }
    # Foreground exec child → resume agnsh's exec_and_wait as a clean exit would.
    # kernel_resume restores boot CR3 + the saved continuation and NEVER returns.
    if (kernel_return_rsp_get() != 0) {
        if (pid == exec_resume_pid_get()) {
            kernel_resume();
        }
    }
    # 1.50.7 bg-job fault teardown: a BACKGROUND (`&`) proc faulted — it is NOT the
    # foreground exec child (no armed kernel_resume for it), so control reached here
    # instead of the kernel_resume() above. The proc is already torn down (state 0 +
    # SIGCHLD to its parent), so the box must NOT halt: a server running concurrent bg
    # services has to survive one service's ring-3 fault. Yield to the scheduler via the
    # PROVEN timer-preemption path — enable interrupts and halt; the next timer tick's
    # do_context_switch saves this now-dead slot (harmless), declines to revive it
    # (state 0, sched.cyr:336 guard), and context-switches to the next ready proc
    # (agnsh / idle) through the timer ISR's OWN pop+iretq epilogue. We never return
    # through the abandoned exception frame.
    #
    # Why sti+hlt and not a direct switch here: do_context_switch restores the next proc
    # INTO an isr_rsp frame and relies on the timer ISR's epilogue (pic.cyr) to iretq it
    # — this fault stub has no such epilogue (it `call`s us, then falls through to halt).
    # Letting the REAL timer tick drive the switch reuses that epilogue intact (lowest-
    # risk; the roadmap-blessed "existing sched_next/do_context_switch path"). preempt_count
    # is 0 here — only a CPL3 fault reaches this fn (the idt.cyr stub gates on saved-CS
    # RPL==3, so the faulter was in ring 3, never mid kernel critical-section) — so
    # do_context_switch is not preempt-gated and WILL switch. Mirrors the smp.cyr:586 /
    # kernel_idle_loop idle pattern (sti;hlt) until that switch fires.
    while (1) { asm { sti; hlt; } }
    return 0;                             # unreachable — kept for the type checker
}

# === Blocking keyboard stdin (1.41.1 — shell-separation arc; line discipline 1.41.15) ===
# read(fd=0) for a ring-3 process: block, read a WHOLE LINE in ONE continuous
# interrupts-enabled window, echo as we go, return when Enter (newline) is seen
# or the caller's buffer fills. Canonical-lite line discipline (ABI O1, revised
# 1.41.15): kernel echoes printable bytes + handles backspace + terminates on
# newline — the userland shell consumes a ready-made line. This is a deliberate
# move AWAY from the original RAW per-byte design, for the reason below.
#
# WHY THE PER-BYTE RAW DESIGN BROKE ON IRON (the 1.41.14 `14114` "Command: D"
# burn): keystrokes on archaemenid arrive via IRQ1 -> kb_isr -> kb_buf (the UEFI
# USB-legacy i8042 emulation; hid_poll's xHCI ring stays empty on that box). The
# in-kernel recovery shell types correctly there because it holds IF=1 across the
# ENTIRE line in one loop, so every scancode — including the SHIFT-RELEASE break
# (0xAA) — is processed in-window and kb_shift is cleared. The old userland path
# returned after the FIRST char, and ring 3 runs with IF=0 between syscalls
# (ring3.cyr:108 sets RFLAGS=0x002; SYSRET restores it via R11). In that IF=0
# inter-byte gap IRQ1 is masked, so a shift-release landing there was DROPPED:
# kb_shift latched at 1, and scancode 0x20 ('d') resolved through sc_shifted to
# 'D'=68 — every typed line collapsed to a stuck shift+d. The fix is to stop
# diverging from the proven reference: drain the whole line under one continuous
# sti window, exactly like shell.cyr's input loop.
#
# Why `sti` is safe in a ring-3 syscall: the only unsafe interrupt mid-syscall
# is the TIMER (its handler calls do_context_switch; the kernel is not reentrant
# across a switch on the syscall stack). We clear sched_active for the duration:
# the timer ISR still fires (EOIs + advances timer_ticks, so net/NTP timing keeps
# moving) but do_context_switch early-returns. Held across the whole line, same
# regime the in-kernel shell runs in.
#
# kb_has_key() also calls hid_poll() to drain the xHCI USB-HID event ring (how
# QEMU's usb-kbd delivers — events DMA in regardless of any interrupt). One loop
# serves both substrates identically now: kb_buf is filled by hid_poll's xHCI drain. We
# busy-poll (no hlt) so the QEMU path needs no wake interrupt. Echo uses kputc
# (serial + GOP framebuffer mirror) — the same fb path write(1) uses from a
# ring-3 syscall since 1.41.12, so it renders under the unified exec CR3 on iron.
fn kbd_read_blocking(buf, count) {
    if (count <= 0) { return 0; }
    preempt_disable();         # 1.44.1: suspend preemption for the whole line read.
    # The timer ISR still EOIs + ticks, but do_context_switch is a no-op while
    # preempt_count>0. Replaces the old `sched_active=0`/save+restore toggle: the
    # counted gate is nestable and composes with the boot sched_active=0 (which keeps
    # do_context_switch returning regardless) — no manual save/restore needed.
    kb_shift = 0; kb_ctrl = 0; # defensive: never enter a read with a stranded
    # modifier from a prior partial read (continuous drain below keeps it honest
    # within the line; this just guarantees a clean start)
    kbd_irq_enable();          # IF=1 for the WHOLE line so the spin can take the
    # timer wake. INPUT PATH: keystrokes arrive via the xHCI USB-HID ring that
    # kb_has_key()->hid_poll() drains. ⭐ As of 2026-08-08 that is the ONLY path —
    # the IRQ1/kb_isr/PIC code this comment used to argue against is DELETED, so
    # there is no longer a second producer to be confused with. The old
    # "IRQ1 fills kb_buf on iron" comment here was wrong and misdirected five
    # iron burns — see project_archaemenid_keystroke_path_usb_only.
    hid_kbd_kick();            # KBD-RING-DEPTH FIX: re-kick the kbd EP in case it
    # stalled during the IF=0 command-execution gap since the previous read. The
    # deep transfer ring (hid_kbd_configure) prevents the stall; this restarts the
    # EP if one ever happens anyway. No-op if no HID kbd (slot 0) / already Running.
    var n = 0;
    while (n < count) {
        while (kb_has_key() == 0) { arch_wait(); }   # hlt-park until timer/kbd IRQ — NOT a busy-spin.
        # A continuous IF=1 ring-0 CPU busy-spin starves the firmware's SMM USB-legacy keyboard
        # emulation on real Zen (it injects i8042 scancodes via periodic SMIs, which a never-yielding
        # spin can't let run) -> keyboard dies after the first line; invisible in QEMU (no SMM legacy
        # emulation). hlt yields the pipeline so SMM runs, and is the proven-on-iron recipe used by
        # sleep_ms#41 (DOOM frame pacing) + kbscan#42 (DOOM input). IF=1 (sti above) so the 100 Hz
        # timer guarantees a wake even with no key; the xHCI MSI-X on vector 0x51 wakes hlt on a key.
        # preempt_count>0 (preempt_disable above) so the timer ISR ticks+EOIs but never switches.
        var sc = kb_read_scancode();
        var ch = scancode_to_ascii(sc);
        if (ch == 10) {                 # Enter: terminate the line. Echo newline,
            kputc(10);                  # store it as the terminator, return.
            store8(buf + n, 10);
            n = n + 1;
            kbd_irq_disable();
            preempt_enable();
            return n;
        }
        if (ch == 4) {                  # Ctrl-D (EOF). Canonical tty semantics:
            # at line start (n==0) signal end-of-input by returning 0 — this is
            # the ONLY path by which read(fd 0) can return 0 on agnos, so it's
            # what lets a stdin filter (anuenue, cat) terminate; without it a
            # filter loops forever (no pipes, no other EOF). Mid-line (n>0) it
            # delivers the bytes typed so far WITHOUT a terminating LF, so a
            # second Ctrl-D at the fresh line start then yields EOF. Not echoed.
            kbd_irq_disable();
            preempt_enable();
            return n;
        }
        if (ch == 8) {                  # Backspace: erase one cell + drop one byte
            if (n > 0) {                # (BS SP BS), mirrors shell.cyr:797.
                n = n - 1;
                kputc(8); kputc(32); kputc(8);
            }
        } elif (ch > 31) {              # Printable: store + echo (shell.cyr:800-805)
            store8(buf + n, ch);
            n = n + 1;
            kputc(ch);
        }
        # ch == 0 (modifier/release) or other control (<32, non-LF/BS): consumed
        # in-window, never stored — so the whole make/break stream is drained here
        # and kb_shift can't strand across a syscall boundary.
    }
    # Buffer filled before a newline arrived — return the partial line.
    kbd_irq_disable();
    preempt_enable();
    return n;
}

# 1.44.x — NON-BLOCKING cooked-line stdin read for schedulable agnsh (Option B). The blocking
# read above busy-spins `while kb_has_key()==0` holding preempt_disable for the WHOLE line — so a
# background job CANNOT run while agnsh waits at the prompt. This variant instead DRAINS whatever
# is already in kb_buf (cook + echo + line-edit into the nbline_buf accumulator), and returns:
#   - the line length (incl. the trailing LF) when Enter completes a line, OR
#   - -2 (WOULD_BLOCK) when no complete line is ready yet — DISTINCT from Ctrl-D EOF (0).
# agnsh polls this between bg-job waitpid(#4) polls; bg jobs time-slice in the preemptible RING-3
# gap between agnsh's polls. CRITICAL: the preempt_disable window is SHORT (drain-what's-there,
# NEVER spin) and released before every return, so the scheduler can run bg procs between calls.
fn kbd_read_nonblock(buf, count) {
    if (count <= 0) { return 0; }
    preempt_disable();             # SHORT window — drain only, never spin (see header).
    kbd_irq_enable();              # IF=1 so the xHCI MSI-X (vector 0x51) / 100 Hz tick can drive hid_poll.
    if (nbline_pos == 0) { kb_shift = 0; kb_ctrl = 0; }   # clean modifiers ONLY at a fresh line
    # (never mid-line — a shift HELD across a poll boundary must survive into the next drain).
    var ret = 0 - 2;               # default WOULD_BLOCK — NOT 0 (0 is reserved for Ctrl-D EOF).
    var draining = 1;
    while (draining == 1) {
        if (kb_has_key() == 0) { draining = 0; }    # nothing buffered -> stop (do NOT spin)
        else {
            var sc = kb_read_scancode();
            var ch = scancode_to_ascii(sc);
            if (ch == 10) {                          # Enter: flush the accumulated line + LF
                kputc(10);
                # 1.44.21 HARDENING: clamp the flush to THIS call's validated buffer. nbline_buf +
                # nbline_pos PERSIST across poll calls, but `buf` is range-checked only for THIS
                # call's `count` (read#5: is_user_range(arg2, arg3)). A ring-3 caller can accumulate
                # under a large count, then flush under a SMALLER count — copying nbline_pos+1 bytes
                # would then write PAST [buf, buf+count) (an OOB write into the caller's AS, or a
                # fatal kernel #PF under STAC on an unmapped/over-ceiling page). Clamp to count-1 (LF
                # takes the last slot). count>=1 here (the count<=0 guard returns at fn entry).
                # FOREGROUND agnsh polls with a fixed prompt count >= the line, so flush_n==nbline_pos
                # and this is byte-identical; only a shrinking-count caller truncates (safe).
                var flush_n = nbline_pos;
                if (flush_n > count - 1) { flush_n = count - 1; }
                var k = 0;
                while (k < flush_n) { store8(buf + k, load8(&nbline_buf + k)); k = k + 1; }
                store8(buf + flush_n, 10);
                ret = flush_n + 1;
                nbline_pos = 0;
                draining = 0;
            } elif (ch == 4) {                       # Ctrl-D: canonical EOF (mirror kbd_read_blocking)
                if (nbline_pos == 0) { ret = 0; }    # at line start -> EOF (return 0)
                else {                                # mid-line -> deliver typed bytes, no LF
                    # 1.44.21 HARDENING: clamp to THIS call's validated count (no LF on this path,
                    # so the full count is available for data). Same cross-call rationale as Enter.
                    var flush_n2 = nbline_pos;
                    if (flush_n2 > count) { flush_n2 = count; }
                    var k2 = 0;
                    while (k2 < flush_n2) { store8(buf + k2, load8(&nbline_buf + k2)); k2 = k2 + 1; }
                    ret = flush_n2;
                    nbline_pos = 0;
                }
                draining = 0;
            } elif (ch == 8) {                       # Backspace: drop one accumulated byte + erase cell
                if (nbline_pos > 0) {
                    nbline_pos = nbline_pos - 1;
                    kputc(8); kputc(32); kputc(8);
                }
            } elif (ch > 31) {                       # Printable: accumulate + echo (cap: leave room for LF)
                if (nbline_pos + 1 < count) {
                    if (nbline_pos < 4095) {         # nbline_buf capacity (512 u64 = 4096 B)
                        store8(&nbline_buf + nbline_pos, ch);
                        nbline_pos = nbline_pos + 1;
                        kputc(ch);
                    }
                }
            }
            # ch == 0 (modifier/release) or other control: consumed in-window, never stored.
        }
    }
    kbd_irq_disable();
    preempt_enable();
    # 1.44.14: distinguish "no complete line, but a PARTIAL line is buffered here" (-3) from
    # "nothing buffered at all" (-2). The accumulator (nbline_buf) persists ACROSS poll calls, so
    # if agnsh's last background job drains mid-line and agnsh switched to the BLOCKING read (which
    # accumulates into the USER buffer, NOT nbline_buf), the half-typed line would be ORPHANED and
    # the command would split + misparse. -3 tells agnsh to KEEP polling (never switch to blocking)
    # until this line completes; -2 (truly empty) is safe to block on.
    if (ret == 0 - 2) {
        if (nbline_pos > 0) { ret = 0 - 3; }
    }
    return ret;
}

# System hostname — read-only identity for uname(34).nodename. Seeded to
# "agnos"; no sethostname syscall yet (added only when a native workload needs a
# mutable hostname — kernel grows per workload, not by Linux default).
#
# ⛔ THE GVAR FORM DID NOT WORK AND THE COMMENT THAT SAID IT DID WAS WRONG. This read
# "A gvar string literal, safe to read from a syscall (post-gvar-init, like
# _AGNOS_VERSION)" — an assertion, never a measurement. Measured 2026-08-11 in QEMU:
# `iam` printed `Kernel: AGNOS ` (bare, trailing space) and an EMPTY `Host:`, while
# `sysname` and `machine` — inline literals in the very same uname arm, through the very
# same sysinfo_put_str — came out correct. Two literals right, two gvars empty, one
# function: the gvar pointers are not live on the ring-3 syscall path.
# ⭐ version.cyr already had the answer and had written it down: `agnos_version_str()`
# exists precisely because the rodata pointer is baked into the FUNCTION at compile time,
# and its comment names the _AGNOS_VERSION gvar as the thing not to use. uname reached for
# the gvar anyway. The accessor form below is that same pattern for the hostname.
# ⚠ The gvar is kept ONLY as the seed value's home; nothing reads it. Anything that needs
# the hostname from a syscall must call kernel_hostname_str().
var kernel_hostname = "agnos";

# Program-body-safe hostname accessor — the rodata pointer is baked in at compile time,
# so this is valid from a ring-3 syscall regardless of gvar-init ordering. Mirrors
# agnos_version_str() in kernel/version.cyr. Callers copy from the returned pointer.
fn kernel_hostname_str() {
    return "agnos";
}

# Copy a NUL-terminated kernel string literal into a fixed `max`-byte user field,
# NUL-padding the remainder. Stops at the source NUL or `max` bytes, whichever
# comes first — never reads past a short literal. `dst` is part of a user buffer
# the caller already validated with is_user_range. Used by uname(34).
fn sysinfo_put_str(dst, src, max) {
    var copying = 1;
    var i = 0;
    while (i < max) {
        var c = 0;
        if (copying == 1) {
            c = load8(src + i);
            if (c == 0) { copying = 0; }   # hit end of source — pad zeros from here
        }
        store8(dst + i, c);
        i = i + 1;
    }
    return 0;
}

# SMP sub-bite 5 (fs_lock): the ext2 open/create body, extracted so the syscall #2
# arm can wrap it in a SINGLE fs_lock/unlock (one return point → the lock can't leak
# across an early return). Caller has already resolved be7==FS_EXT2 and set the
# vfs_base_off/vfs_base_len globals via vfs_resolve_mount. All ext2_*/vfs_ext2_parent
# called here are leaves w.r.t. the VFS boundary (no locked-fn re-entry).
fn sys_open_ext2_inner(arg1, arg2, arg3) {
    if ((arg3 & 0x800) != 0) { return ext2_open_dir(arg1, arg2); }
    var ino7 = ext2_path_lookup(arg1, arg2);
    if (ino7 <= 0) {
        if ((arg3 & 0x100) == 0) { return 0 - 1; }
        var par7 = vfs_ext2_parent(arg1, arg2);
        if (par7 <= 0) { return 0 - 1; }
        if (ext2_create(par7, arg1 + vfs_base_off, vfs_base_len) <= 0) { return 0 - 1; }
    } else {
        if ((arg3 & 0x200) != 0) { ext2_truncate_zero(ino7); }
    }
    return ext2_open(arg1, arg2);
}

# ================================================================
# Kernel shared-memory buffers (shm #71-74) — the sovereign shared-buffer PRESENT
# backend (setu buf.cyr's agnos path). A client WRITEs its rendered pixels into a
# kernel-OWNED buffer keyed by a small id, ATTACH carries the id (not the pixels),
# and the compositor READs them back out. This sidesteps the single-CPU two-proc TCP
# flow-control deadlock (TCP_RX_RING = 2 KB, but a surface is hundreds of KB).
#
# COPY-based (not shared-page-mapped) ON PURPOSE: the buffer is kmalloc'd (kernel heap,
# present in EVERY proc's CR3 via the kernel mirror), so the client's shm_write and the
# compositor's shm_read each reach it from their own syscall CR3 with a plain copy — no
# cross-proc page mapping, and a client that exits right after present can't free it
# (proc_free_address_space only frees a proc's OWN arena pages, never the kernel heap).
# See agnosticos docs/development/planning/shared-buffer-present.md.
var SHM_MAX = 16;
var SHM_MAX_SIZE = 2097152;         # 2 MB — one pmm page per buffer (bite-2 cap; multi-page = follow-up)
var shm_phys[16];                   # 2 MB physical base per slot (0 = free)
var shm_kva[16];                    # kernel access VA for the page (kernel-mirror; every-CR3 reachable)
var shm_size[16];                   # byte size per slot
var shm_mc[16];                     # GPU MC address per slot (0 = PMM-backed ⇒ NOT GPU-reachable)

# 1.56.40 (channel-band bite 1) — WHO OWNS A SLOT, AND WHICH INCARNATION OF THEM.
#
# ⛔ Before this, the shm table had NO owner field at all: `shm_slot_valid` checked bounds and a
# non-zero phys, so **any process could read, write or FREE any other process's live buffer** — the
# desktop's pixel surfaces and mishran's PCM among them. That is already how the compositor reads a
# client's pixels, so it cannot simply be closed; bite 1 records ownership and closes only the
# destructive op (`shm_free #74`). Reads and writes get a WARN COUNTER and are still permitted, so
# nothing is refused that works today — see `shm_xown_warns`.
#
# ⛔ THE EPOCH IS NOT DECORATION. pids are recycled slot indices with no generation counter, so "pid 4
# owns slot 2" goes stale the instant pid 4 dies and slot 4 is reused: the NEW pid 4 would inherit the
# dead one's buffers. `shm_epoch` is a per-slot generation bumped on every create, so a stale id can be
# told from a live one. The process-side half of that (`proc_epoch`) lands in bite 2 and is written but
# never read; the two are combined at bite 4, when the channel band has a use for the pair.
var shm_owner[16];                  # owning pid per slot (valid only where shm_phys != 0)
var shm_epoch[16];                  # per-slot generation, bumped on every create — stale-id detection
var shm_epoch_next = 1;             # monotonic source for the above; never wraps in any real uptime
var shm_xown_warns = 0;             # cross-owner read/write count — COUNTED, NEVER REFUSED (bite 1)

# Stamp ownership on a freshly-claimed slot. Both create paths (#71 pmm-backed, #86 GPU carveout) call
# this so the two can never drift apart on who owns what.
fn shm_claim(slot) {
    store64(&shm_owner + slot * 8, proc_current_get());
    store64(&shm_epoch + slot * 8, shm_epoch_next);
    shm_epoch_next = shm_epoch_next + 1;
    return 0;
}

# Count a cross-owner touch. ⛔ Deliberately returns nothing and refuses nothing: the compositor reading
# a client's pixel buffer IS a cross-owner read and is the desktop's whole design today. The counter
# exists so the flip to enforcement — which can only land once every client holds a channel to hang a
# grant on — is made against a measured number instead of a guess.
fn shm_note_xown(id) {
    if (load64(&shm_owner + (id - 1) * 8) != proc_current_get()) {
        shm_xown_warns = shm_xown_warns + 1;
    }
    return 0;
}

# Release every slot owned by `pid`. Sibling of flock_release_pid / snd_release_pid / gpu_release_pid,
# and like them it MUST be called from BOTH death sites — the `exit #0` path and the fault-kill path —
# or a proc that dies the other way leaks its buffers forever.
#
# ⚠ Before this, nothing released shm at all: a client that exited left its 2 MB slot claimed for the
# rest of the boot, and `shm_create` calls `pmm_alloc_2mb()` unconditionally regardless of requested
# size, so 16 exits of any size exhausted the table.
#
# ⛔ MEASURED 2026-08-05: THIS IS INERT IN THE DESKTOP WORKLOAD — instrumented, it frees NOTHING across
# a full `AE_CLIENTS_MODE=desktop` run, because neither client exits inside the capture window. So the
# desktop cannot validate it and must not be cited as evidence that it works; the boot selftest
# (`shsys: shm owner gate OK`) is the coverage, and it drives the release directly.
# ⚠ That measurement also RETRACTED a wrong attribution: a flaky desktop run was first blamed on this
# function, and the instrumentation disproved it — a function that never executes cannot change an
# outcome. See the desktop-mode flakiness note in the CHANGELOG.
fn shm_release_pid(pid) {
    var s = 0;
    while (s < SHM_MAX) {
        if (load64(&shm_phys + s * 8) != 0) {
            if (load64(&shm_owner + s * 8) == pid) { shm_free(s + 1); }
        }
        s = s + 1;
    }
    return 0;
}

# ids are 1-BASED: 0 is the setu "inline pixels" sentinel (setu_attach arg5), so a real
# shm buffer must never be 0. slot = id - 1.
fn shm_slot_valid(id) {
    if (id < 1) { return 0; }
    if (id > SHM_MAX) { return 0; }
    if (load64(&shm_phys + (id - 1) * 8) == 0) { return 0; }
    return 1;
}

# Byte copy (word-fast + byte tail). Both ends are reachable in the current CR3
# (the user range in the caller's arena + the shm page's kernel-mirror KVA).
fn shm_copy(dst, src, n) {
    var words = n / 8;
    var wi = 0;
    while (wi < words) { store64(dst + wi * 8, load64(src + wi * 8)); wi = wi + 1; }
    var bi = words * 8;
    while (bi < n) { store8(dst + bi, load8(src + bi)); bi = bi + 1; }
    return 0;
}

# shm_create(size) -> slot id (0..SHM_MAX-1) or -1 (bad size / OOM / table full).
# Backed by a single 2 MB pmm page (kmalloc caps out well below a surface); the page's
# kernel-access VA lives in the kernel mirror, so shm_write (client CR3) and shm_read
# (compositor CR3) both reach it with a plain copy — no cross-proc page mapping.
fn shm_create(size) {
    if (size <= 0) { return 0 - 1; }
    if (size > SHM_MAX_SIZE) { return 0 - 1; }
    var i = 0;
    while (i < SHM_MAX) {
        if (load64(&shm_phys + i * 8) == 0) {
            var phys = pmm_alloc_2mb();
            if (phys == 0) { return 0 - 1; }
            var kva = pmm_kva_for_access(phys);
            store64(&shm_phys + i * 8, phys);
            store64(&shm_kva + i * 8, kva);
            store64(&shm_size + i * 8, size);
            shm_claim(i);                           # 1.56.40 bite 1: owner + epoch
            return i + 1;                           # 1-based id (0 reserved for "inline")
        }
        i = i + 1;
    }
    return 0 - 1;
}

# shm_create_gpu(size) -> slot id (1-based) / -1. The GPU-VISIBLE peer of shm_create#71: same table, same
# shm_write#72 / shm_read#73 / shm_free#74, but the page is carved out of the GPU CARVEOUT instead of PMM so
# it has an MC address the CP-DMA engine can actually read. That is not an optimisation — `pmm_alloc_2mb`
# returns SYSTEM RAM and the GPU cannot reach it at all (bus-master off by design), so a GPU composite is
# impossible from a #71 buffer. Slot i is a FIXED 2 MB window at GPU_SHM_REGION_OFF + i*GPU_SHM_SLOT_SIZE —
# no allocator, and the MC address is pure arithmetic off the carveout base. Returns -1 when there is no GPU
# carveout (QEMU): the caller then falls back to shm_create#71 and the CPU path, unchanged.
fn shm_create_gpu(size) {
    if (size <= 0) { return 0 - 1; }
    if (size > SHM_MAX_SIZE) { return 0 - 1; }
    if (gpu_present == 0) { return 0 - 1; }
    if (gpu_arena_mc == 0) { return 0 - 1; }
    if (gpu_arena_phys == 0) { return 0 - 1; }
    # Carveout bases, derived from the arena globals (arena = base + GPU_VM_ARENA_OFF on both sides).
    var cpu_carve = gpu_arena_phys - GPU_VM_ARENA_OFF;
    var mc_carve  = gpu_arena_mc   - GPU_VM_ARENA_OFF;
    var i = 0;
    while (i < SHM_MAX) {
        if (load64(&shm_phys + i * 8) == 0) {
            var off = GPU_SHM_REGION_OFF + i * GPU_SHM_SLOT_SIZE;
            var cpu = cpu_carve + off;                  # CPU-side direct-DRAM window
            var mc  = mc_carve  + off;                  # what the CP-DMA engine addresses
            vmm_remap_wc_2mb(cpu);                      # WC: shm_write is a big sequential CPU store run
            store64(&shm_phys + i * 8, cpu);            # non-zero ⇒ slot in use (shm_slot_valid)
            store64(&shm_kva  + i * 8, cpu);            # the direct window IS the access VA
            store64(&shm_size + i * 8, size);
            store64(&shm_mc   + i * 8, mc);             # the GPU-visibility marker
            shm_claim(i);                               # 1.56.40 bite 1: owner + epoch
            return i + 1;                               # 1-based id (0 = setu "inline pixels" sentinel)
        }
        i = i + 1;
    }
    return 0 - 1;
}

# gpu_blit_shm_sys(id, wh, dstxy) -> 0 / -1. THE compositor composite primitive: GPU-blit a client's
# surface straight from its carveout shm slot into the current blit back buffer at (dx,dy), via
# gpu_cp_dma_blit (one CP-DMA per row, src stride = w*4, dst stride = the framebuffer pitch). Replaces the
# per-pixel userland composite AND the shm->userland read that precedes it: the pixels never leave the
# kernel's GPU-visible memory. Pack: wh = (h<<16)|w, dstxy = (dy<<16)|dx — same convention as blit#39.
# Ring-3 passes an id + geometry only; no MC address crosses the boundary. Pair with gpu_fill#85 for the
# background and gpu_present#84 to flip. Returns -1 if the slot is PMM-backed (use #86 to allocate),
# out of bounds, or the GPU/display isn't usable.
fn gpu_blit_shm_sys(id, wh, dstxy) {
    if (gpu_present == 0) { return 0 - 1; }
    if (shm_slot_valid(id) == 0) { return 0 - 1; }
    var slot = id - 1;
    var src_mc = load64(&shm_mc + slot * 8);
    if (src_mc == 0) { return 0 - 1; }                  # PMM-backed ⇒ the GPU cannot read it
    if (gpu_blit_arm() != 1) { return 0 - 1; }
    if (gpu_bb_pitch == 0) { return 0 - 1; }
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var dx = dstxy & 0xFFFF;
    var dy = (dstxy >> 16) & 0xFFFF;
    if (w < 1) { return 0 - 1; }
    if (h < 1) { return 0 - 1; }
    var row = w * 4;                                    # 32bpp packed source rows
    if (row * h > load64(&shm_size + slot * 8)) { return 0 - 1; }   # source must fit its slot
    # Reject (don't silently clip) anything off-screen — the compositor owns clipping.
    var fbw = gpu_bb_pitch / 4;
    var fbh = gpu_bb_fbsize / gpu_bb_pitch;
    if (dx + w > fbw) { return 0 - 1; }
    if (dy + h > fbh) { return 0 - 1; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var dst_mc = tgt + dy * gpu_bb_pitch + dx * 4;
    if (gpu_cp_dma_blit(dst_mc, gpu_bb_pitch, src_mc, row, row, h) != 1) { return 0 - 1; }
    return 0;
}

# gpu_fill_rect_sys(color, wh, dstxy) -> 0 / -1. The RECT peer of gpu_fill#85 (which only clears the WHOLE
# back buffer). GPU-fills a sub-rectangle with a 32-bit xRGB8888 colour via gpu_cp_dma_fill_rect. This is the
# window-chrome primitive: a compositor draws body/titlebar/focus-accent/buttons as ~10 of these per window
# per frame, today a per-pixel CPU loop with 4 compares + 2 loads + 2 multiplies BEFORE each store32.
# Pack: wh = (h<<16)|w, dstxy = (dy<<16)|dx — blit#39's convention. Rejects (does not clip) off-screen
# rects; the compositor owns clipping and learns the bounds from gpu_caps#89.
fn gpu_fill_rect_sys(color, wh, dstxy) {
    if (gpu_present == 0) { return 0 - 1; }
    if (gpu_blit_arm() != 1) { return 0 - 1; }
    if (gpu_bb_pitch == 0) { return 0 - 1; }
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var dx = dstxy & 0xFFFF;
    var dy = (dstxy >> 16) & 0xFFFF;
    if (w < 1) { return 0 - 1; }
    if (h < 1) { return 0 - 1; }
    var fbw = gpu_bb_pitch / 4;
    var fbh = gpu_bb_fbsize / gpu_bb_pitch;
    if (dx + w > fbw) { return 0 - 1; }
    if (dy + h > fbh) { return 0 - 1; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var dst_mc = tgt + dy * gpu_bb_pitch + dx * 4;
    if (gpu_cp_dma_fill_rect(dst_mc, gpu_bb_pitch, color, w * 4, h) != 1) { return 0 - 1; }
    return 0;
}

# gpu_readback_shm_sys(id, wh, srcxy) -> 0 / -1. The INVERSE of gpu_blit_shm#87: GPU-copy a rectangle OUT of
# the current blit back buffer at (sx,sy) INTO the client's carveout shm slot `id`, via gpu_cp_dma_blit (one
# CP-DMA per row, src stride = the framebuffer pitch, dst stride = w*4 packed). This is the screen-capture /
# read-pixels primitive; without it a compositor reading its own shm sees STALE content because the composited
# result lives in the kernel's GPU back buffer, never in the client page. The captured pixels are the frame
# the compositor just built (the render target #87/#88/#92 write), before #84 flips it. Pack: wh = (h<<16)|w,
# srcxy = (sy<<16)|sx. Ring 3 passes an id + geometry only; no MC address crosses the boundary. Returns -1 if
# the slot is PMM-backed (the GPU cannot WRITE it — use #86 to allocate), the capture won't fit the slot, the
# rect is off-screen, or the GPU/display isn't usable.
fn gpu_readback_shm_sys(id, wh, srcxy) {
    if (gpu_present == 0) { return 0 - 1; }
    if (shm_slot_valid(id) == 0) { return 0 - 1; }
    var slot = id - 1;
    var dst_mc = load64(&shm_mc + slot * 8);
    if (dst_mc == 0) { return 0 - 1; }                  # PMM-backed ⇒ the GPU cannot write it
    if (gpu_blit_arm() != 1) { return 0 - 1; }
    if (gpu_bb_pitch == 0) { return 0 - 1; }
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var sx = srcxy & 0xFFFF;
    var sy = (srcxy >> 16) & 0xFFFF;
    if (w < 1) { return 0 - 1; }
    if (h < 1) { return 0 - 1; }
    var row = w * 4;                                    # 32bpp packed destination rows
    if (row * h > load64(&shm_size + slot * 8)) { return 0 - 1; }   # capture must fit the slot
    # Reject (don't silently clip) anything off-screen — the compositor owns clipping.
    var fbw = gpu_bb_pitch / 4;
    var fbh = gpu_bb_fbsize / gpu_bb_pitch;
    if (sx + w > fbw) { return 0 - 1; }
    if (sy + h > fbh) { return 0 - 1; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var src_mc = tgt + sy * gpu_bb_pitch + sx * 4;
    # COHERENCE: the destination slot's CPU window is WC-mapped, and the CPU reads it via shm_read#73 AFTER
    # this CP-DMA writes it. Empirically (iron 2026-07-23, gpucopy) a slot the CPU has ALREADY read returns a
    # STALE cache-line ghost of its previous contents on the next read — the fresh GPU write never reaches the
    # CPU. Same class as gpu.md the first 64-thread dispatch ("dispatch into a fresh, never-CPU-touched slot"). Evict the stale/dirty
    # lines BEFORE the DMA (not after: a flush after would write a dirty line back OVER the GPU's fresh data).
    # A whole-cache wbinvd proved this on iron (gpucopy exit 95, burn 4); this is the SCOPED form — clflush
    # only the destination window [kva, kva+row*h), so a per-frame screen capture doesn't flush the world.
    var kva = load64(&shm_kva + slot * 8);
    var total = row * h;
    var off = 0;
    while (off < total) { clflush(kva + off); off = off + 64; }
    gpu_mfence();
    if (gpu_cp_dma_blit(dst_mc, row, src_mc, gpu_bb_pitch, row, h) != 1) { return 0 - 1; }
    return 0;
}

# gpu_blit_bb_sys(srcxy, wh, dstxy) -> 0 / -1. A rect COPY within the blit back buffer, from (sx,sy) to
# (dx,dy): the move-a-window / scroll-a-region primitive, entirely on the GPU (gpu_cp_dma_blit, framebuffer
# pitch on both sides). Pack: wh = (h<<16)|w, srcxy = (sy<<16)|sx, dstxy = (dy<<16)|dx. Rejects (does not clip)
# either rect off-screen; the compositor owns clipping. OVERLAP: the copy is one CP-DMA per row, so a DOWNWARD
# move (dy > sy) into overlapping rows must run BOTTOM-UP or it would read a row after the row above it was
# overwritten (memmove semantics) — handled below. An upward or non-overlapping move is safe top-down.
# Intra-row horizontal overlap on the SAME source row is still undefined (one DMA reads-then-writes the whole
# row); a caller must not self-overlap a single row.
fn gpu_blit_bb_sys(srcxy, wh, dstxy) {
    if (gpu_present == 0) { return 0 - 1; }
    if (gpu_blit_arm() != 1) { return 0 - 1; }
    if (gpu_bb_pitch == 0) { return 0 - 1; }
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var sx = srcxy & 0xFFFF;
    var sy = (srcxy >> 16) & 0xFFFF;
    var dx = dstxy & 0xFFFF;
    var dy = (dstxy >> 16) & 0xFFFF;
    if (w < 1) { return 0 - 1; }
    if (h < 1) { return 0 - 1; }
    var fbw = gpu_bb_pitch / 4;
    var fbh = gpu_bb_fbsize / gpu_bb_pitch;
    if (sx + w > fbw) { return 0 - 1; }
    if (sy + h > fbh) { return 0 - 1; }
    if (dx + w > fbw) { return 0 - 1; }
    if (dy + h > fbh) { return 0 - 1; }
    var tgt = gpu_bb_a_mc;
    if (gpu_bb_back != 0) { tgt = gpu_bb_b_mc; }
    var row = w * 4;
    # Downward overlapping move ⇒ copy rows bottom-up so each source row is read before the destination row
    # one place above it (which shares its pixels) is overwritten. Upward/non-overlapping is safe top-down.
    if (dy > sy) {
        var i = h;
        var s = 0;
        var d = 0;
        while (i > 0) {
            i = i - 1;
            s = tgt + (sy + i) * gpu_bb_pitch + sx * 4;
            d = tgt + (dy + i) * gpu_bb_pitch + dx * 4;
            if (gpu_cp_dma(d, s, row) != 1) { return 0 - 1; }
        }
        return 0;
    }
    var src_mc = tgt + sy * gpu_bb_pitch + sx * 4;
    var dst_mc = tgt + dy * gpu_bb_pitch + dx * 4;
    if (gpu_cp_dma_blit(dst_mc, gpu_bb_pitch, src_mc, gpu_bb_pitch, row, h) != 1) { return 0 - 1; }
    return 0;
}

# ── #92 gpu_shader_op — THE shader-compositing seam (plan bite S8, decision D-3) ───────────────────────
#
# ONE syscall number. An ARRAY of fixed-size op records. The operation is an op code INSIDE each record,
# so alpha blend, coverage, glyph expand and gradient are op codes rather than syscall numbers, and every
# later primitive (channel swap, CP-DMA fill/blit as ops, batched frames) rides this same number.
#
# WHY A DESCRIPTOR AND NOT ONE NUMBER PER OP. The arc plan settled this as decision D-3 *before* any of it
# was built; 1.56.2/1.56.3 then shipped the rejected shape anyway (#92 blend, #93 coverage, #94 glyph).
# All four of D-3's reasons still hold:
#   - The dispatcher offers four args and a coverage blit needs five operands. That is exactly why #93/#94
#     had to smuggle their colour through ksyscall_a4 (r10), and why a gradient — which needs two stops
#     plus geometry — had NO room left at all and never got a ring-3 path. A record has no such ceiling.
#   - Syscall numbers are not free. (⚠ HISTORICAL: #90/#91 were *reserved* when this was written; they are
#     now IMPLEMENTED and iron-proven — gpu_readback_shm_sys and gpu_blit_bb_sys, ~1700 lines below. The
#     next free number is #93, ratified for gpu_modeset_op by operator decision MD-4.) This band lands on
#     OCCUPIED, partly DESTRUCTIVE Linux numbers: 92=chown, 93=fchown, 94=lchown, 95=umask. One number
#     costs one collision to document and gate; four cost four.
#   - The consolidated cyrius wrapper ticket exists specifically to end the one-ask-per-syscall pattern.
#   - It makes plan bite S12 (N ops in ONE submission — one flush, one write-back, one fence) an
#     IMPLEMENTATION change rather than an ABI break. That is the point of specifying the array now,
#     while there is exactly one shipped consumer, instead of after a compositor depends on it.
#
# NO ADDRESS APPEARS IN A RECORD. Sources are named by shm slot id and resolved to an MC address inside
# the kernel, so "no MC address crosses the ring-3 boundary" is a property of the LAYOUT rather than a
# rule this handler has to remember to enforce.
#
# ⚠ SOURCES MUST BE PREMULTIPLIED (every colour channel already scaled by its own alpha, so c <= a). The
# shaders compute `out = src + dst*(1 - src_a/255)` with no per-pixel divide, which is only correct for
# premultiplied input. Straight-alpha input produces washed-out edges SILENTLY — never an error. This is
# the single most likely way a caller misuses this syscall, so it is stated here, in the ABI doc, and in
# the cyrius wrapper docstring.

# --- Descriptor staging -------------------------------------------------------------------------------
# syscall.cyr is an INCLUDED module, so a module-global `var X[N]` allocates N x u64 = 8N BYTES (in a
# TOP-LEVEL program the same syntax allocates N bytes — the unit differs by scope, and getting it wrong
# silently under-allocates by 8x). 2048 x 8 = 16384 B = 4 CPUs x 4096 B.
#
# PER-CPU, not one shared buffer. A single global staging cell is precisely what corrupted an FS operation
# under SMP at 1.46.x, where `rename` ran with another CPU's length. Same shape as pcpu_ksyscall_a4[4].
var pcpu_sc_gpuop[2048];             # 16384 B total = GPU_OP_CPUS x GPU_OP_BUF_BYTES
var GPU_OP_CPUS      = 4;            # matches pcpu_cpu()'s `if (c >= 4) { c = 0; }` clamp
var GPU_OP_BUF_BYTES = 4096;         # per-CPU share
var GPU_OP_STRIDE    = 64;           # bytes per op record — a power of two, so indexing is a shift
var GPU_OP_MAX       = 64;           # GPU_OP_BUF_BYTES / GPU_OP_STRIDE
fn sc_gpuop_buf() { return &pcpu_sc_gpuop + pcpu_cpu() * GPU_OP_BUF_BYTES; }

# --- Op codes. Codes 0x00-0x1F are the bitmask tier: an op code IS its bit index in gpu_caps#89's
# support word at +28, so ring 3 can discover exactly which ops this kernel implements instead of
# probing by trial. Minting a code >= 0x20 requires growing gpu_caps first; that is the only sanctioned
# growth path, and it is deliberately awkward so the mask stays authoritative.
var GPU_OP_NOP         = 0x00;       # validated, dispatches nothing — batch padding / ABI probe
var GPU_OP_BLEND_RECT  = 0x01;       # 32bpp premultiplied source, per-pixel src-over   (was #92)
var GPU_OP_BLEND_COV   = 0x02;       # 8bpp coverage mask x one uniform colour           (was #93)
var GPU_OP_GLYPH_1BPP  = 0x03;       # 1bpp bitmap, colour where set, dst untouched      (was #94)
var GPU_OP_GRAD_LINEAR = 0x04;       # two-stop vertical gradient, NO source buffer      (never had one)
# ⭐ RUNG 9 (3D arc) — THE RASTERISER. An edge array (16.16) + a winding rule from a #86 slot,
# rasterised to an 8bpp coverage mask. **This op IS the triangle rasteriser**: a triangle is a
# 3-edge closed path, and nothing about the kernel is triangle-specific.
# ⚠ Record layout (dwords): 0 op · 1 flags · 3 edge_id · 4 wh · 5 dstxy · 9 n_edges|rule
# ⛔ Vertex transform stays on the CPU in ring 3 (TD-4) — the kernel receives SCREEN-SPACE edges.
var GPU_OP_EDGE_COV    = 0x08;       # edge array -> 8bpp coverage mask                   (3D arc rung 9)
# ⭐ RUNG 11 (3D arc) — ATTRIBUTE INTERPOLATION. Per-vertex premultiplied RGBA interpolated
# barycentrically across a frame and src-over'd into the back buffer. Generalises op 0x04's
# two-stop vertical gradient: that is this op with a degenerate frame and two equal colours.
# ⚠ The attribute FRAME (3 vertices + 3 colours) is independent of the coverage SHAPE (an edge
# array). Barycentric interpolation is affine over the whole plane, so the frame need not
# coincide with the shape — which is what lets a two-triangle quad be ONE record, making a seam
# structurally unrepresentable rather than merely tested-for.
# ⚠ Record: 0 op · 1 flags · 2 RESERVED · 3 edge_id · 4 wh · 5 dstxy · 6-11 verts · 12-14 colours
#           · 15 n_edges|rule
var GPU_OP_TRI_RGBA    = 0x09;       # barycentric per-vertex RGBA + src-over  (3D arc rung 11)
var GPU_TRI_FLAG_DERIVE = 0x01;      # synthesise the frame's 3 edges; edge_id and n_edges MUST be 0

# ⭐ RUNG 12 — BATCHED TRIANGLES. N triangles from ONE #86 vertex slot in ONE record, so a mesh is a
# single syscall, a single validation pass and a single arming check instead of N of each.
# ⚠ The per-triangle record in the vertex slot is 48 BYTES: 6 x i32 screen-space 16.16 vertices
# followed by 3 x u32 premultiplied ARGB. Fixed stride so the kernel indexes rather than parses.
#   +0  vx0 vy0 vx1 vy1 vx2 vy2      (i32, 16.16)
#   +24 c0  c1  c2                   (u32, premultiplied ARGB)
#   +36 reserved x3, MUST be zero    -- the extension point, mirroring the #92 record's own rule
var GPU_OP_TRI_LIST    = 0x0A;       # N triangles from a vertex slot         (3D arc rung 12)
var GPU_TRI_VTX_BYTES  = 48;         # per-triangle stride in the vertex slot
var GPU_TRI_LIST_MAX   = 256;        # per-record triangle cap; a reject, never a clamp      # synthesise the frame's 3 edges; edge_id and n_edges MUST be 0

# ⛔ THE AREA BOUNDS ARE 2^16 AND 2^42, NOT THE 2^32 / 2^53 THE PLAN SPECIFIED. Both of the plan's
# numbers assumed the vertices were lifted to 16.16, which would put 2A at cross << 32. They are
# not: only the CONSTANT term and 2A carry the << 16, because kx/ky already multiply a 16.16
# sample point. So 2A = cross << 16, and the real range is:
#   * MIN — a 0.5 px^2 frame is cross = 1, i.e. 2A = 2^16. The plan's 2^32 would have demanded
#     cross >= 2^16, i.e. an area of 32768 px^2 — REJECTING EVERY TRIANGLE SMALLER THAN ~256x256,
#     which is most of them.
#   * MAX — edge coordinates cap at +-2^28 in 16.16 (+-4096 px), so cross <= 2^26 and 2A <= 2^42.
#     The plan's 2^53 sits above anything constructible and could never have fired.
var GPU_TRI_AREA_MIN   = 65536;              # 2^16 — frame area >= 0.5 px^2
var GPU_TRI_AREA_MAX   = 4398046511104;      # 2^42 — the largest area the coordinate bound allows
var GPU_TRI_E_RATIO    = 1024;               # max |E| / 2A over the mask-rect corners
var GPU_TRI_MAX_PIXELS = 1048576;            # w*h. ⚠ AN ARENA SIZE WEARING A CONSTANT'S CLOTHES.

# ⭐ RUNG 13 — TEXTURE MAPPING. Nearest-neighbour, affine UV, texture read out of a #86 slot with
# plain `global_load_dword`.
#
# ⛔ NO MIMG, NO T#, NO S#, NO SAMPLER DESCRIPTOR, NO NEW INSTRUCTION CLASS. The texture address is
# computed in the shader and fetched as an ordinary dword load. That keeps rung 13 inside the
# instruction repertoire already proven on this silicon across rungs 9-12; an image-op path would
# introduce a descriptor format, a sampler state and a fetch class all at once, none of them
# covered by an existing oracle. Linear surfaces only — no tiling, no swizzle.
#
# ⚠ The per-triangle record in the vertex slot is 48 BYTES and is NOT the same shape as op 0x0A's,
# which packs colours. Here every field is a 16.16 signed coordinate:
#   +0  vx0 vy0 vx1 vy1 vx2 vy2      (i32, 16.16 screen space)
#   +24 u0  v0  u1  v1  u2  v2       (i32, 16.16 TEXEL space)
# There is no reserved tail: 12 x 4 = 48 exactly. A future extension takes a new stride constant
# rather than stealing space that never existed.
var GPU_OP_TRI_TEX     = 0x0B;       # affine nearest-neighbour texturing      (3D arc rung 13)
var GPU_TEX_VTX_BYTES  = 48;         # 6 vertex coords + 6 UV coords, all i32 16.16
var GPU_TEX_MAX_DIM    = 4096;       # per-axis texture cap; a reject, never a clamp

# ⭐ TWO FORMATS, AND THE PALETTED ONE IS DELIBERATELY GENERAL. IDX8 is "8bpp index + a slot-resident
# 256-entry ARGB lookup", not a DOOM-shaped op: the LUT is a caller-supplied slot, so any paletted
# source works. Choosing the general form here is what stops rung 16's tile-owner from needing its
# own bespoke fetch.
var GPU_TEX_FLAG_IDX8  = 0x01;       # texture is 8bpp indices + a LUT slot; else RGBA8 linear

# ⭐ FULLCOV — RUNG 14's FEASIBILITY FLAG, AND IT IS GENERAL, NOT DOOM-SHAPED.
#
# op 0x0B costs THREE dispatches: edge_setup, the coverage rasteriser, then the texture pass. Rung
# 13's MEASURED fit puts the chain at 52.7 us fixed, which caps a 35 Hz frame at ~542 submissions
# before a single pixel is shaded. Two of those three dispatches exist only to build a coverage
# mask — and for a primitive that fills its destination rect COMPLETELY that mask is uniformly 255,
# so the work is pure waste.
#
# ⛔ THIS IS A COVERAGE-SHAPE STATEMENT, NOT A DOOM OP. "the primitive fills its rect" is a general
# graphics fact — axis-aligned quads, full-screen blits, glyph cells. Same doctrine as TD-7's
# IDX8+LUT: the kernel grows per native workload, never to chase a consumer's internals.
# [[project_agnos_kernel_growth_rules]]
#
# ⚠ WITH FULLCOV THERE IS NO SHAPE, SO THERE MUST BE NO EDGES. edge_id, n_edges and rule must all
# be zero; accepting them and ignoring them is how a caller silently gets geometry it did not ask
# for — the same doctrine as the bidirectional LUT rule.
var GPU_TEX_FLAG_FULLCOV = 0x02;     # every pixel of the rect is covered; skip both coverage passes

# ⭐ WRAP — RUNG 14 REQUIRES IT, AND IT IS THE MODE DOOM ACTUALLY USES.
# cyrius-doom's render_draw_tex_column holds V as `wty % (th << 16)` with a negative correction —
# TRUE MODULO. A wall column's V range routinely exceeds the texture height, so clamp-to-edge would
# smear the last row down the whole wall instead of tiling it.
#
# ⛔ WRAP REQUIRES POWER-OF-TWO DIMENSIONS, AND THAT IS A REJECT, NOT A CLAMP. A general modulo is
# an integer divide PER PIXEL; a power-of-two wrap is one AND. Restricting the accepted surface to
# what can be done cheaply is the same discipline as rejecting the even-odd fill rule: the ACCEPTED
# surface stays equal to the PROVEN surface. DOOM's textures are power-of-two already.
var GPU_TEX_FLAG_WRAP  = 0x04;       # tile the texture instead of clamping; dims must be 2^k
var GPU_TEX_FLAGS_KNOWN = 0x07;      # anything outside this is REJECTED, never accepted-and-ignored

# ⭐ RUNG 14b — COLMAJOR: TRANSPOSE THE LANE AXIS. Row-major puts the 64 lanes on X, so a 1-px DOOM
# column lights ONE lane and launches ph wavefronts. Measured on iron at 1.56.23: 177 ns per LAUNCHED
# wave against 22 ns per additional WORKING one — launch dominates 8:1, so the wave COUNT is the cost,
# not the pixel count. With lanes on Y a 200-row column is ceil(200/64) = 4 wavefronts, not 200.
# GPU_TEXL_MAX_WAVES's own comment below pre-registered this flag as the fix "if the residual pixel
# cost is too high"; the measurement asking for it now exists.
#
# ⛔ LIST-UNIFORM, ENFORCED. The address form lives in the BLOB and a DISPATCH_DIRECT packet names ONE
# shader; tile_shift is one scalar and the grid is one (gx, gy). One dispatch physically has one lane
# axis. The bit is per-PRIMITIVE in the ABI — the extension point stays general — but every primitive
# in an array must agree, or the op is refused with GPO_E_MIXMODE.
#
# ⛔ LEGAL BUT SLOWER ON WIDE PRIMITIVES, and that is the caller's call, not the kernel's. Col-major
# wins iff ceil(ph/64)*pw < ceil(pw/64)*ph — essentially iff ph > pw. Set on a 200x1 strip it costs
# 200 waves where row-major costs 4. The kernel rejects for SAFETY (the wave cap still bounds the
# TRANSPOSED grid), never for taste.
var GPU_TEX_FLAG_COLMAJOR = 0x08;    # op 0x0C only: lanes walk Y; tile_shift from ph, rows from pw

# ⛔ A SEPARATE MASK, NOT A WIDENED GPU_TEX_FLAGS_KNOWN. That constant is shared with op 0x0B
# (gpo_flags_known, gpo_validate_tritex), whose shader has no col-major body at all. Widening it would
# make 0x0B accept-and-IGNORE this bit — exactly the failure mode the flags vocabulary exists to
# prevent. Op 0x0B must keep REJECTING 0x08.
var GPU_TEXL_PRIM_FLAGS_KNOWN = 0x0F;   # op 0x0C per-primitive: IDX8 | FULLCOV | WRAP | COLMAJOR

# ⭐ RUNG 15 — BILINEAR. **ACCEPTED as of 1.56.29**, in the same change that landed the blob.
# The bit was minted RESERVED earlier in this cut and returned GPO_E_NOTIMPL while the shader did not
# exist, on the rule earned in 1.56.24: **the ACCEPTED surface must equal the PROVEN surface**. (That
# cut found op 0x09 blessing GPU_RULE_EVENODD and GPU_TRI_FLAG_DERIVE that its worker refuses —
# requests that passed validation and died deep in pass 2 as an opaque GPO_E_DISPATCH.) The blob now
# exists — kernel/shaders/tex_bilin.s, 580 dwords, resident at GPU_TEXBI_SHADER_SUBOFF, dispatched
# under GPU_COMPUTE_PGM_RSRC1_TEXBI — so the reject came out with it, and not one commit earlier.
# ⚠ STILL DELIBERATELY NOT IN EITHER FLAGS_KNOWN MASK. gpo_flags_known adds it for op 0x0B ALONE
# (see the GPU_OP_TRI_TEX line there). Widening GPU_TEX_FLAGS_KNOWN would hand the bit to op 0x0C too,
# whose blobs have no bilinear body — accept-and-IGNORE, the precise failure the vocabulary exists to
# prevent, and the same reason GPU_TEXL_PRIM_FLAGS_KNOWN is its own constant.
# ⚠ SCOPE, decided 2026-07-28: op **0x0B ONLY**. The shader-copy rule makes a variant a NEW BLOB rather
# than an edit or a runtime branch, so covering 0x0C and its col-major twin as well would mean THREE
# new ~400-dword hand-assembled blobs with three drift gates — doubling the shader surface for a filter
# that has **no consumer at all** (DOOM is a 1993 renderer; it samples nearest). The 3D section's own
# rule 2 says the kernel is never more than one rung ahead of a shipped consumer, and it is already six
# ahead. One blob, one op, and the list variants wait for someone to ask.
var GPU_TEX_FLAG_BILINEAR = 0x10;    # op 0x0B: 4-tap bilinear. LIVE since 1.56.29.
var GPU_TEX_LUT_ENTRIES = 256;       # a full byte of index; a short LUT is a reject, not a clamp

# ⭐ RUNG 14 — N TEXTURED PRIMITIVES IN ONE DISPATCH. The rung's structural blocker, measured.
#
# ⛔ WHY THIS OP EXISTS, AND WHY MERGING GEOMETRY WOULD NOT HAVE WORKED. `doomwall.cyr` measured a
# multi-column affine quad: a 1.5x depth ratio across a seg makes 4096 of 4096 pixels wrong, because
# DOOM's `ty_step = 1/depth` is a hyperbola in screen x while an affine quad interpolates it
# linearly. cyrius-doom itself refuted that approach (render.cyr:1275 — it "made textures swim").
# So primitives CANNOT merge. Submissions must.
#
# ⭐ ONE WORKGROUP PER PRIMITIVE. The dispatch grid is gx = n_prims, and the shader reads
# `tgid_x` to index the record array — O(1) per pixel, no per-pixel search over the list, and no
# constraint that primitives be adjacent, uniform or sorted. That is what makes this general rather
# than DOOM-shaped: "N independent textured rects, one dispatch" is a statement about SUBMISSION.
#
# ⛔ FULLCOV IS WHAT MAKES IT TRACTABLE. Rung 12's batch failed because N primitives shared three
# fixed arena slots; with no coverage pass there is no shared mask at all, and each primitive gets
# its own 160-byte record in an ARRAY the shader indexes. The bug class is designed out, not fenced
# around. FULLCOV is therefore REQUIRED here, not optional.
var GPU_OP_TEX_LIST    = 0x0C;       # N textured primitives, ONE dispatch     (3D arc rung 14)
var GPU_TEX_LIST_MAX   = 512;        # per-record primitive cap; a reject, never a clamp
# GPU_TEXL_MAX_WAVES — the launched-WAVEFRONT ceiling for op 0x0C.
#
# ⚠ NOT GPU_TRI_MAX_PIXELS. That constant is "an arena size wearing a constant's clothes" by its own
# admission — it bounds the coverage mask, which this op does not use at all. Reusing it here was
# tried and would have REJECTED THE VERY WORKLOAD THIS OP EXISTS FOR: a 640-column DOOM frame at
# 200 rows launches 128000 wavefronts, against that constant's 1048576/64 = 16384.
#
# ⭐ WAVEFRONTS ARE THE COST UNIT, and one workgroup here is one wavefront: gy = max(ph) rows by
# gx = n_prims << tile_shift. 262144 sits ~2x above a full DOOM frame and far below anything that
# could wedge the queue. Bounding waves rather than lanes is also what catches the pathological
# case — ONE 4096-wide primitive among 511 one-pixel columns forces tile_shift = 6 and a grid 64x
# wider than 511 of the 512 primitives can use (47185920 waves; rejected).
#
# ⛔⛔ THE HONEST LIMIT WAS MEASURED, AND IT IS FATAL ROW-MAJOR. This comment used to end "the residual
# pixel cost is the number the burn must produce. If it is too high the fix is a per-primitive
# COLUMN-MAJOR flag letting lanes walk Y instead of X — deliberately NOT built ahead of a measurement
# saying it is needed." Burn 1 (1.56.23) produced the number: 3.1% lane occupancy at 2 px wide, 99.6 ns
# per USEFUL pixel against rung 13's 1.6 ns/px slope. A 640-column DOOM frame is 128000 launched waves
# = 24.5 ms of a 28.6 ms budget. ⇒ GPU_TEX_FLAG_COLMAJOR is now REQUIRED, and is built (rung 14b);
# the same frame column-major is 2560 waves = 0.51 ms.
#
# ⭐ THE DEFERRAL WORKED AS DESIGNED — the flag was named here, left unbuilt pending a measurement, and
# the measurement said build it. Building it on the guess would have been right for the wrong reason.
#
# ⚠ THIS CAP IS AXIS-AWARE AS OF 14b. Under COLMAJOR the launched grid is
# (n_prims << ceil(log2(ceil(max_ph/64)))) * max_pw — tiles from the HEIGHT, rows from the WIDTH. A cap
# computed off the wrong axis can sit 64x below the grid actually launched, which is a wedged queue.
var GPU_TEXL_MAX_WAVES = 262144;     # launched wavefronts per op 0x0C dispatch
var GPU_TEX_PRIM_BYTES = 96;         # per-primitive input record, ring-3 supplied:
#   +0  wh        h<<16 | w      (rect size)
#   +4  dstxy     y<<16 | x      (rect origin, screen)
#   +8  tex_id    #86 slot
#   +12 lut_id    #86 slot (IDX8 only, else 0)
#   +16 texwh     th<<16 | tw
#   +20 flags     per-primitive: IDX8 | WRAP | COLMAJOR
#                 (FULLCOV mandatory; COLMAJOR must agree across the list)
#   +24 vx0 vy0 vx1 vy1 vx2 vy2  (i32 16.16)
#   +48 u0 v0 u1 v1 u2 v2        (i32 16.16)
# ⚠ 96 B: a 24-byte header + 48 bytes of coords = 72, rounded
# UP to 96 so the record is 32-byte aligned and the shader can
# index it with a shift instead of a multiply. +72..95 reserved,
# MUST be zero — the extension point, as on every other record.

var GPU_RULE_NONZERO   = 0;
var GPU_RULE_EVENODD   = 1;
var GPU_EDGE_BYTES     = 16;         # one edge = x0,y0,x1,y1 as 4x i32 in 16.16
var GPU_EDGE_MAX       = 256;        # per-op cap; a reject, never a clamp
# 0x05 channel swap (plan S4) · 0x06 cov-modulated source · 0x07 packed VOP3P blend ·
# 0x10-0x17 CP-DMA-domain ops (fill/blit/readback, plan S12) · 0x18-0x1F control (barrier/present).
# ⭐ RUNG 17 (1.56.30) — op 0x0D, minted WITH its worker in the same change.
# ⚠ `0x0C` was reserved for DEPTH_CLEAR in the original plan and 1.56.23 allocated it to TEX_LIST, so
# depth-clear takes the next free code. Check gpo_field_mask / gpo_flags_known / gpo_validate and the
# ABI battery before assuming ANY code is free -- that renumbering is why this warning exists.
var GPU_OP_DEPTH_CLEAR = 0x0D;       # clear a TD-3 depth handle           (3D arc rung 17)
var GPU_OP_TRI_DEPTH   = 0x0E;       # depth-tested triangle list          (3D arc rung 17)
# ⭐ RUNG 18 takes 0x0F, the last code in the triangle-draw lane (0x08..0x0F). ⚠ The rung-17 comment
# here earmarked 0x0F "for rung 19" — but rung 19 is the CONSUMER close (a game in a setu window,
# presented with #84) and mints no op at all, so the reservation was protecting nothing. Taking it keeps
# every triangle-draw op inside one contiguous lane, which is what makes GPU_OP_SUPPORTED's bit index
# readable as a family rather than a scatter.
var GPU_OP_TRI_PERSP   = 0x0F;       # perspective-correct textured triangles   (3D arc rung 18)
# ⭐ 0x10 opens the fill/blit/READBACK lane gpu.md reserved at 0x10..0x17.
var GPU_OP_RT_READ     = 0x10;       # copy a render-target handle out to a #86 slot (rung 17)
# ⛔ GROWING THIS WORD ADVERTISES THE OP. It is both the validator's gate (gpo_validate) and what
# gpu_caps #89 reports to ring 3, which is the "deliberately awkward" property the plan wanted: you
# cannot add an op here without also promising it works. So 0x0D is added in the SAME change as
# gpu_depth_clear, and that worker refuses with GPO_E_ARM until rung 6's audit passes on this boot.
var GPU_OP_SUPPORTED   = 0x1FF1F;    # bits 0..4 + 8 EDGE_COV + 9 TRI_RGBA + 10 TRI_LIST + 11 TRI_TEX + 12 TEX_LIST + 13 DEPTH_CLEAR + 14 TRI_DEPTH + 15 TRI_PERSP + 16 RT_READ — MUST equal what gpo_validate REACHES

# ⭐⭐ GPU_OP_NOTIMPL_MASK — ops whose ABI is COMPLETE and whose WORKER IS NOT. Reachable by the
# validator (so every rule below is exercised by the battery through the real dispatch path) and
# SUBTRACTED from what #89 advertises (so ring 3 is never told an op works when it does not).
#
# ⛔ WITHOUT THIS THE TWO PROPERTIES ARE IN DIRECT CONFLICT, and the rung-17 plan picked the wrong
# side of it. `gpo_validate` gates on GPU_OP_SUPPORTED at its first line, so an op left OUT of that
# word answers GPO_E_BADOP to every battery case and NONE of its field rules can be tested. But
# putting it IN also hands the bit to `gpu_caps` +28, which is the 1.56.24 defect exactly: an
# advertised surface larger than the proven one. The plan's B5 said "GPU_OP_SUPPORTED bit 14 ...
# worker returns GPO_E_NOTIMPL", which takes the advertising hit; the comment four lines above says
# that is not allowed. One extra word resolves it and keeps BOTH invariants.
#
# ⚠ THE PRECEDENT IS RUNG 15'S, one level down: GPU_TEX_FLAG_BILINEAR was "minted RESERVED then
# ACCEPTED with the blob", its battery case moving from ea_expect(GPO_E_NOTIMPL) to ea_expect_valid
# in the SAME change that added tex_bilin.s. A FLAG could do that without this word because #89
# advertises ops, not flags. An OP cannot.
# ⇒ WHEN THE WORKER LANDS (plan bite B9), bit 14 clears HERE and the GPO_E_NOTIMPL return at the end
# of gpo_validate_tridepth goes away, in one change. Both moves or neither.
var GPU_OP_NOTIMPL_MASK = 0x0000;    # EMPTY — every op in GPU_OP_SUPPORTED has a worker

# ---- rung 17 op 0x0E sizing. ⚠ Its OWN constants, not TRI_LIST's: the record, the stride and the
# work unit all differ, and sharing a name would couple two ABIs that are free to move apart.
var GPU_TRID_VTX_BYTES  = 48;        # per-triangle stride: 6 coords + 3 z + colour + 2 reserved
var GPU_TRID_LIST_MAX   = 256;       # per-record triangle cap; a reject, never a clamp
var GPU_TRID_Z_MAX      = 16777215;  # 2^24-1 — the largest legal per-vertex z
# ⭐ EVERY far value must exceed EVERY legal z, because the depth compare is UNSIGNED. This is the
# constant that makes the hardware clear value 0xFFFFFFFF sit BEHIND all geometry instead of, under a
# signed compare, reading as -1 and landing in front of it — which draws nothing, and a blank frame is
# byte-identical in both submission orders, so the rung's own iron oracle would go green on it.
var GPU_TRID_ZCLEAR_MIN = 16777216;  # 2^24
# ⚠ The unit is TILE x TRIANGLE, not pixels. gpo_validate_trilist's w*h*nt*3 pixel-edge bound is
# meaningless here: one workgroup owns an 8x8 tile and walks the whole list, so cost is tiles times
# triangles. ⛔ At 2^20 this caps 800x600 at 13 triangles, deliberately — v1 is a correctness proof
# at the 32x32 corpus, not a DOOM-scale renderer, and raising it is its own bite with its own
# watchdog measurement.
var GPU_TRID_WORK_MAX   = 1048576;   # 2^20 tile-triangle pairs
var GPU_TILE            = 8;         # one workgroup owns an 8x8 tile == exactly one 64-lane wave
# The 32-bit lane the shader evaluates w0/w1/w2 and zn in. ⚠ A SIGNED bound: a value in
# [2^31, 2^32) restores NEGATIVE and fails the compare it feeds while passing an unsigned width test.
var GPU_TRID_LANE_MAX   = 2147483647;  # 2^31-1

# ---- rung 18 op 0x0F sizing. ⭐ EVERY BOUND HERE WAS MEASURED ON THE HOST BEFORE THIS ABI EXISTED,
# which is the opposite of rung 17, where four plan specifications were falsified during implementation.
var GPU_TPER_VTX_BYTES  = 64;        # per-triangle: 3 x (x, y, w, u, v) + 1 reserved dword
var GPU_TPER_LIST_MAX   = 256;       # per-record triangle cap; a reject, never a clamp
# GPU_TPER_K lives in gpu_regs.cyr -- ONE definition. It was duplicated here and as
# GPU_TPER_K_SHIFT in gpu.cyr, which is ATOM_DRY: two constants that must agree and nothing diffing them.
# ⛔⛔ THE w FLOOR IS THE LOAD-BEARING ONE, AND IT IS NOT A STYLE CHOICE. `W_i = 2^K / w_i`, so a SMALL
# w gives a LARGE W and inflates every downstream width. Measured: `perspcore` originally used w = 1
# and put the denominator past a 32-bit lane on ALL 4096 pixels of its full-screen frame, contradicting
# `perspbits`' 24-29 bits on identical geometry — the two probes disagreed on nothing but the w scale.
# ⇒ w is a FIXED-POINT MAGNITUDE, floored here, and a record below the floor is refused.
var GPU_TPER_W_MIN      = 256;
# ⛔⛔ THE CEILING IS 4096, AND THE FIRST VERSION OF THIS CONSTANT WAS A DIVIDE-BY-ZERO HOLE. It was set
# to 2^28 by copying the COORDINATE bound, which has nothing to do with w. But `W_i = 2^16 / w_i` is an
# INTEGER divide, so **W_i is 0 for every w >= 65537** — and this validator accepted those records, which
# makes D = SUM e_i * W_i identically zero and divides by zero in prep AND in the shader.
# ⚠ 65536 would close the crash and still be wrong: at w = 65536 the reciprocal is W = 1, i.e. ZERO bits
# of precision, and the interpolation would be garbage while every gate stayed green.
# ⇒ 4096 is the top of the band the host probes actually validated (perspbits swept K over w ~ 256..4096;
# perspcore/perspmodel run there), giving W >= 16. **Widening it requires raising K and re-running the
# perspbits sweep** — K is bounded above too, at 24, past which the numerator overflows i64.
var GPU_TPER_W_MAX      = 4096;
# ⛔ THE DENOMINATOR BOUND, and it exists because a design claim was FALSIFIED on the host. "D fits a
# 32-bit lane" held on every early figure and is FALSE at the ABI's extremes: with w at its floor and
# the coordinate ceiling at 4096x2048, `perspmodel` measured D = **8,583,644,160 = 2^33**, twice an
# UNSIGNED lane. ⭐ D is affine in (x,y), so the DRAW RECT'S FOUR CORNERS bound it — rung 17's corner
# bound is the precedent and depthgate's D8 proved that shortcut sound against brute force. Rejecting
# here is what makes "D fits one lane" true BY CONSTRUCTION rather than by luck.
# ⛔ 2^31-1, NOT 2^32-1, AND THE FIRST VALUE CONTRADICTED THE REFERENCE'S OWN COMMENT. perspcore and
# perspmodel argue the restoring divide's remainder fits one lane because `rem < D` always — but with
# D allowed up to 2^32-1, `(rem << 1) | bit` needs **33 bits** and the claim is false. Bounding D at
# 2^31-1 makes `rem << 1 | bit` strictly under 2^32, which is what the gates already assert.
# ⚠ Lowering it does NOT retire the C_D residue: bounding D AT A CORNER does not bound C_D, because
# A_D*qx can cancel it. The residue is still load-bearing and prep's header still explains why.
var GPU_TPER_D_MAX      = 2147483647;  # 2^31-1
# The numerator is a REGISTER PAIR by design (measured 46-57 bits), so it needs no lane bound — but
# prep evaluates it in i64, so it needs a bound that keeps the KERNEL's own arithmetic defined. Same
# trap GPU_EDGE_COORD_MAX's comment names: past ~2^63 the oracle itself has no defined value.
var GPU_TPER_N_MAX      = 4611686018427387904;   # 2^62, two bits of margin inside i64

# Flags word (+4). NOTHING is accepted here yet, on purpose: a flag that is accepted and ignored is how
# a caller silently gets behaviour it did not ask for. bit0 SERIALIZE and bit1 CHECK_PREMUL are reserved
# for S12, where they will mean something; until then a non-zero flags word is rejected.
var GPU_OP_FLAGS_KNOWN = 0x00;

# Per-op flag vocabulary. ⛔ A flag accepted by one op must not be silently accepted by another —
# that is how a caller gets behaviour it did not ask for. Default is "no flags at all".
fn gpo_flags_known(op) {
    if (op == GPU_OP_TRI_RGBA) { return GPU_TRI_FLAG_DERIVE; }
    # ⭐ BILINEAR is added HERE but deliberately NOT to GPU_TEX_FLAGS_KNOWN itself. The two tests ask
    # different questions and must keep giving different answers:
    #   this one (outer, gpo_validate) — "is that bit a NAME this op knows?"  yes ⇒ fall through
    #   gpo_validate_tritex (inner)     — "can this kernel EXECUTE it?"       no  ⇒ GPO_E_NOTIMPL
    # Widening the shared constant instead would let the inner unknown-bit test accept it too, and a
    # future op reusing GPU_TEX_FLAGS_KNOWN would silently inherit a flag it has no shader for.
    if (op == GPU_OP_TRI_TEX)  { return GPU_TEX_FLAGS_KNOWN | GPU_TEX_FLAG_BILINEAR; }
    if (op == GPU_OP_TEX_LIST) { return 0; }   # per-PRIMITIVE flags live in the array, not here
    return GPU_OP_FLAGS_KNOWN;
}

# --- Failure reasons. The syscall returns 0, or a PACKED negative naming WHICH op failed and why:
#       e = 0 - rc ;  idx = e >> 8 ;  reason = e & 0xFF
# reason is always >= 1, so a valid failure never encodes as 0. GPO_E_NOGPU at idx 0 encodes as exactly
# -1, which keeps every existing `if (rc != 0)` / `if (rc == -1)` caller working unchanged.
var GPO_E_NOGPU    = 1;              # call  — GPU/display unavailable
var GPO_E_BADOP    = 2;              # op    — unknown, reserved, or not implemented in this kernel
var GPO_E_BADSLOT  = 3;              # op    — slot invalid/free, or PMM-backed (the GPU cannot read it)
var GPO_E_SLOTSIZE = 4;              # op    — source does not fit its slot under this op's stride rule
var GPO_E_BOUNDS   = 5;              # op    — rect off-screen (REJECT, never clip)
var GPO_E_DIM      = 6;              # op    — w < 1 or h < 1
var GPO_E_ARM      = 7;              # op    — the shader could not be made resident
var GPO_E_DISPATCH = 8;              # op    — the dispatch watchdog expired (pass 2 only)
var GPO_E_DESC     = 11;             # call  — bad desc_uva / len, or the copy-in failed
var GPO_E_RESERVED = 12;             # op    — a reserved field or an undefined flag bit was non-zero
var GPO_E_UNPROVEN = 13;             # call  — the dispatch envelope is unproven on this boot
# call — the BATCH's single completion fence never retired. Distinct from GPO_E_DISPATCH on purpose: with
# one submission there is one marker, so the failing op is NOT identifiable and reporting an index would be
# a fabrication. idx is 0 and carries no meaning for this reason.
var GPO_E_BATCH    = 15;
# rung 9 (EDGE_COV). Distinct from SLOTSIZE/DIM on purpose: "your edge array is the wrong size" and
# "your mask slot is the wrong size" are different mistakes with different fixes, and one shared code
# would make the tool's failure table ambiguous exactly where it needs to discriminate.
var GPO_E_EDGEBUF  = 16;             # op    — edge slot too small for n_edges, or n_edges out of range
var GPO_E_DSTSLOT  = 17;             # op    — destination mask slot invalid/free/PMM-backed/too small
var GPO_E_RULE     = 18;             # op    — winding rule is not NONZERO or EVENODD
var GPO_E_ALIAS    = 19;             # op    — edge slot and destination mask slot are the same slot
# ⭐ rung 9b bite B3. An edge coordinate outside the domain on which byte-identity to the CPU
# reference is DEFINED. ⛔ A DISTINCT code, not a reused GPO_E_DIM: the failure table has to say
# "your geometry is out of range" separately from "your mask is out of range", because the fixes
# are different and rung 9b's whole debugging story is attribution.
var GPO_E_COORD    = 20;             # op    — an edge endpoint is outside +-2^28 (16.16)
# ⭐ 1.56.19. Its own code, not a reused GPO_E_EDGEBUF: "too many edges" and "too much total
# work" are different mistakes with different fixes — halve the mask, or halve the edges — and
# the caller cannot tell which from a shared code.
var GPO_E_WORK     = 21;             # op    — w*h*n_edges exceeds the measured watchdog budget
# ⭐ 1.56.19 rung 11. Two distinct codes because the two failures have different fixes: an AREA
# reject means the frame is degenerate or absurd (move a vertex); a FRAME reject means the frame is
# legal but so skewed relative to the mask rect that the numerator would overflow (re-fit the frame
# to the geometry). A shared code cannot tell the caller which.
var GPO_E_AREA     = 22;             # op    — frame area outside [GPU_TRI_AREA_MIN, _MAX]
var GPO_E_FRAME    = 23;             # op    — frame skew vs the mask rect exceeds GPU_TRI_E_RATIO
# ⭐ 1.56.20 rung 12. Its own code because "the batch is malformed" and "one triangle in it is
# malformed" have different fixes, and the caller cannot tell which from a shared reason.
var GPO_E_TEXSLOT  = 25;             # op    — texture slot invalid/free/too small for its declared dims
var GPO_E_TEXDIM   = 26;             # op    — texture w/h is zero or exceeds GPU_TEX_MAX_DIM
# ⚠ GPO_E_LUTSLOT covers BOTH directions: IDX8 without a valid 256-entry LUT, and a LUT supplied
# WITHOUT IDX8 — the second because accepting it would silently ignore a slot the caller believes is
# in use, which is the same failure mode the flags word exists to prevent.
var GPO_E_LUTSLOT  = 27;             # op    — LUT slot missing, invalid, or supplied when unusable
# ⭐ Rung 14b. Its own code because the fix is specific and non-obvious: SPLIT THE LIST, do not
# flip a bit. GPO_E_RESERVED would say "a flag bit is wrong" when every flag is individually legal and
# it is their DISAGREEMENT that is not executable — one dispatch has one lane axis.
var GPO_E_MIXMODE  = 28;             # op    — primitives in one 0x0C array disagree on COLMAJOR
# ⭐ 1.56.24. "This flag/mode is DEFINED by the ABI but no worker can execute it yet." Its own code
# because the caller's fix is specific and none of the neighbours say it: GPO_E_RESERVED means "that
# bit is not a thing" (fix: stop setting garbage), GPO_E_RULE means "that rule value is not a thing"
# (fix: pass a legal one) — but NOTIMPL means "you asked correctly for something unbuilt" and the fix
# is to take the other, working path. ⛔ It exists because the alternative was worse: the validator
# BLESSED these requests and the worker then refused them deep in dispatch, surfacing as a generic
# GPO_E_DISPATCH — the "ABI accepts then silently fails" defect that gpo_validate_edge's comment
# already names for op 0x08. Same defect, same fix, applied to op 0x09 five months late.
var GPO_E_NOTIMPL  = 29;             # op    — ABI-legal but unimplemented (see the two sites below)
# ⭐ Rung 17, op 0x0E. Three codes, each because the caller's FIX differs and no neighbour says it.
# ⚠ 30/31/32 are taken because they are genuinely next. 9, 10 and 14 are gaps in this namespace whose
# history is not visible in the file (they ARE live in the separate MDO_E_ namespace) — do not reuse
# an absence you cannot explain.
# ⛔ SUBPIXEL is a REJECT, not a quantisation. depthcore/depthmodel prove the arithmetic in the
# doubled-INTEGER domain only, so accepting arbitrary 16.16 and rounding kernel-side would be
# accept-and-silently-do-something-else — the same doctrine as WRAP's power-of-two reject.
var GPO_E_SUBPIXEL = 30;             # op    — a vertex coordinate has non-zero 16.16 fraction bits
# ⛔ ZRANGE covers BOTH the per-vertex ceiling and the CORNER BOUND, because both mean "this record's
# depth arithmetic does not fit the 32-bit lane the shader evaluates it in" and both have the same
# fix: shrink z or shrink the draw rect.
var GPO_E_ZRANGE   = 31;             # op    — z out of range, or |w|/|zn| exceeds a 32-bit lane
# ⭐ ALIGN is what keeps `exec == -1` for the whole kernel. Because w/h/dx/dy are all multiples of 8
# there is no partial tile, so the shader needs no bounds guard and never writes exec. ⚠ A prologue
# guard instead would make every edge tile show lane dropouts — byte-identical to the S1 per-lane
# signature the lane witness exists to detect, and the burn would be spent telling them apart.
var GPO_E_ALIGN    = 32;             # op    — w/h/dx/dy not a multiple of GPU_TILE
# ⭐ Rung 18. Two codes, because the caller's FIX differs: WRANGE means "your w is outside the
# representable band" (fix: rescale the clip w), DRANGE means "this geometry's denominator or numerator
# outgrows the lane at a corner of your draw rect" (fix: shrink the rect or raise w). Sharing one code
# would tell a caller to change the wrong number.
var GPO_E_WRANGE   = 33;             # op    — a per-vertex w outside [GPU_TPER_W_MIN, _W_MAX]
var GPO_E_DRANGE   = 34;             # op    — D or N exceeds its lane at a draw-rect corner
var GPO_E_TRILIST  = 24;             # op    — triangle count/slot invalid, or a per-triangle record is
var GPU_COV_MAX_DIM = 4096;          # per-side mask cap — a REJECT, never a clamp
# ⭐ THE COORDINATE DOMAIN (B3). 2^28 = 4096 px in 16.16 — the same 4096 as GPU_COV_MAX_DIM, so
# geometry and mask are bounded consistently.
#
# ⛔ THIS IS NOT A STYLE CHECK. It is the domain on which "byte-identical to the CPU reference"
# MEANS anything at all, and BOTH ends need it:
#   * the REFERENCE (`tests/gpu/refraster.cyr:154`) computes `(bx-ax)*(sy-ay)` in i64. With
#     ABI-legal i32 coordinates that product OVERFLOWS i64, so above roughly M*d ~ 2^63 the
#     oracle itself has no defined value and "identical" is meaningless.
#   * the SHADER's divider is exact iff |bx-ax| < 2^31 and 2*|by-ay| < 2^32. `edgemodel.cyr`'s
#     gate 3 FALSIFIES this on purpose (15 of 4000 cases differ above 2^31), which is what makes
#     the bound a measured domain rather than decoration.
# At +-2^28: M, d <= 2^29, so the divider keeps two bits of margin and the reference five.
# ⛔ WIDENING THIS PAST 2^30 HAS A SHADER CONSEQUENCE. `edge_cov.s`'s normalising shift omits the
# model's `L == 0 -> tw = 0` guard, and gfx9 masks shift counts to 5 bits, so at L == 0 it would
# compute P.hi | P.lo instead of P.hi. L = clz32(d) makes L == 0 require d >= 2^31, which THIS
# BOUND forbids. Raise it and you must add that cndmask in the same bite.
var GPU_EDGE_COORD_MAX = 268435456;  # 2^28

# gpo_field_mask(op) — bit i set <=> this op DEFINES record dword i (byte offset i*4).
# Every dword an op does not define MUST be zero. That rule is what makes the reserved dwords safe to
# fill in later: a v1 caller physically cannot ship garbage in a field a future kernel will read, so
# `srcxy` / `src_pitch` / `mask_pitch` (dwords 6/7/8) can gain "0 = derive" meaning without an ABI break.
# They are laid out NOW so adding them is never a stride change.
fn gpo_field_mask(op) {
    if (op == GPU_OP_NOP)         { return 0x0003; }   # op flags
    if (op == GPU_OP_BLEND_RECT)  { return 0x0037; }   # op flags src_id wh dstxy
    if (op == GPU_OP_BLEND_COV)   { return 0x023B; }   # op flags mask_id wh dstxy color0
    if (op == GPU_OP_GLYPH_1BPP)  { return 0x023B; }   # op flags mask_id wh dstxy color0
    if (op == GPU_OP_GRAD_LINEAR) { return 0x0633; }   # op flags wh dstxy color0 color1
    # rung 11: op(0) flags(1) edge_id(3) wh(4) dstxy(5) verts(6-11) colours(12-14) n_edges|rule(15)
    # ⚠ dword 2 stays RESERVED and MUST be zero — the one forward-compat dword, kept so a future
    # render-target handle is a non-breaking extension by construction rather than by hope.
    # ⭐ dstxy IS defined here, unlike op 0x08. This op writes the back buffer; 0x08 rasterises into
    # a mask slot whose origin is (0,0) and therefore refuses dstxy. Consistent, not contradictory.
    if (op == GPU_OP_TRI_RGBA)    { return 0xFFFB; }   # everything except the reserved dword 2
    # rung 12: op(0) flags(1) vtx_id(3) wh(4) dstxy(5) n_tris(6). ⚠ The per-triangle geometry lives
    # in the SLOT, not the record, which is the whole point -- one record, N triangles.
    if (op == GPU_OP_TRI_LIST)    { return 0x007B; }   # op flags vtx_id wh dstxy n_tris
    # op flags tex_id edge_id wh dstxy vtx_id texwh lut_id  +  n_edges|rule at +60
    if (op == GPU_OP_TRI_TEX)     { return 0x81FF; }
    # op flags prim_id wh dstxy n_prims  — the union rect + the primitive array
    if (op == GPU_OP_TEX_LIST)    { return 0x007B; }
    # rung 9: op(0) flags(1) dst_id(2) edge_id(3) wh(4) n_edges|rule(9)
    # ⛔ dstxy (dword 5) is NOT defined by this op and must be zero. EDGE_COV does not touch the
    # framebuffer at all -- it rasterises into a mask slot whose origin IS (0,0). Accepting a dstxy
    # here and ignoring it is precisely the "silently gets behaviour it did not ask for" failure the
    # flags-word comment above refuses; placement is BLEND_COV's job, in a second record.
    if (op == GPU_OP_EDGE_COV)    { return 0x021F; }
    # rung 17: op(0) flags(1) z_handle(2) wh(4) value(6)
    # ⛔ dstxy (dword 5) is NOT defined and must be zero — same reasoning as EDGE_COV above. A depth
    # handle's origin IS (0,0); it is not the framebuffer and there is nothing to place it at.
    # z_handle sits at dword 2, matching EDGE_COV's dst_id rather than TRI_RGBA's reserved dword.
    if (op == GPU_OP_DEPTH_CLEAR) { return 0x0057; }
    # rung 17: op(0) flags(1) z_handle(2) vtx_id(3) wh(4) dstxy(5) n_tris(6) zwh(7) witness_id(8)
    # ⚠ z_handle sits at dword 2 (matching 0x0D) and vtx_id at dword 3 (matching 0x0A), deliberately:
    # a field that means the same thing should live at the same offset across ops, so a reader who
    # knows one record can read the next. dword 7 carries the DEPTH extent, which is not the draw
    # rect -- 0x0B's texwh occupies the same dword for the same "a second, different size" reason.
    # ⭐ witness_id (dword 8) is a FIRST-CLASS ABI FIELD, not a debug bit behind an #ifdef. A build-flag
    # would make #89's advertised surface build-dependent, i.e. would make the mask a lie for a
    # production kernel. Prior art: op 0x09's destination mask slot, a shader writing into a
    # ring-3-named slot, resolved with the same gpu_shm_mc.
    if (op == GPU_OP_TRI_DEPTH)   { return 0x01FF; }
    # rung 17: op(0) flags(1) z_handle(2) dst_id(3) wh(4) zwh(7)
    # ⛔ dstxy (dword 5) is NOT defined and must be zero — a handle's origin IS (0,0), same reasoning
    # as EDGE_COV and DEPTH_CLEAR. The readback rect starts at the handle's corner; placing it is the
    # caller's business once the pixels are in its own slot.
    if (op == GPU_OP_RT_READ)     { return 0x009F; }
    # rung 18: op(0) flags(1) tex_id(2) vtx_id(3) wh(4) dstxy(5) n_tris(6) texwh(7)
    # ⚠ Field offsets chosen to MATCH THE NEIGHBOURS rather than to be compact: tex_id and texwh sit
    # where op 0x0B puts them, vtx_id and n_tris where 0x0E puts them. A field that means the same thing
    # should live at the same dword across ops, so a reader who knows one record can read the next.
    if (op == GPU_OP_TRI_PERSP)   { return 0x00FF; }
    return 0;
}

# gpo_slot_bytes(op, w, h) — how many source bytes this op reads from its slot. The three rules differ,
# and using the wrong one is a live bug class: 1bpp rows are BYTE-ALIGNED, so a 12 px glyph run costs 2
# bytes per row and not 1.5 — copying blend_cov's w*h rule here would reject valid callers.
fn gpo_slot_bytes(op, w, h) {
    # ⚠ EDGE_COV's slot holds EDGES, not pixels — its size is a function of n_edges, not of w*h.
    # Handled by gpo_edge_bytes() at the call site because this signature has no n_edges to give.
    # Returning a w*h rule here would reject every valid caller, which is exactly the bug class
    # this function's own comment warns about for the 1bpp row stride.
    if (op == GPU_OP_EDGE_COV)   { return 0; }
    if (op == GPU_OP_BLEND_RECT) { return w * 4 * h; }
    if (op == GPU_OP_BLEND_COV)  { return w * h; }
    if (op == GPU_OP_GLYPH_1BPP) { return ((w + 7) / 8) * h; }
    return 0;
}

# gpo_slot_field(op) — record byte offset of the slot id this op sources from, or 0 for none.
fn gpo_slot_field(op) {
    if (op == GPU_OP_EDGE_COV)   { return 12; }        # edge_id
    if (op == GPU_OP_BLEND_RECT) { return 8; }         # src_id
    if (op == GPU_OP_BLEND_COV)  { return 12; }        # mask_id
    if (op == GPU_OP_GLYPH_1BPP) { return 12; }        # mask_id
    return 0;
}


# gpo_i32(addr) — read a dword and SIGN-EXTEND it to i64.
# ⛔ load32 ZERO-extends in Cyrius. Reading a negative 16.16 coordinate without this returns a huge
# positive number, so every "is it in range" test below would pass on exactly the values that are
# out of range in the negative direction. [[reference_cyrius_shift_right_is_logical]] is the same
# class of trap one operator over.
# gpu_shm_mc — resolve a validated #86 slot id to its GPU-visible MC address, or 0.
# ⚠ Callers must have validated the slot already; this returns 0 for an out-of-range id rather than
# reading past the table, but 0 is also a legitimate "unmapped" answer, so it is a backstop, not a check.
fn gpu_shm_mc(id) {
    if (shm_slot_valid(id) == 0) { return 0; }
    return load64(&shm_mc + (id - 1) * 8);
}

fn gpo_i32(addr) {
    var v = load32(addr) & 0xFFFFFFFF;
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}

# gpo_coord_bad(c) — 1 if a 16.16 coordinate is outside the ABI's +-2^28 window.
fn gpo_coord_bad(c) {
    if (c > GPU_EDGE_COORD_MAX) { return 1; }
    if (c < 0 - GPU_EDGE_COORD_MAX) { return 1; }
    return 0;
}

# gpo_lane_bad(v) — 1 if an i64 value does not fit the SIGNED 32-bit lane the shader evaluates it in.
# ⚠ SIGNED, and that is the whole point: a value in [2^31, 2^32) fits a 32-bit register but restores
# NEGATIVE when the `v_cmp_*_i32` that reads it interprets those bits, so it fails the compare it
# feeds while passing any unsigned-width test. depthmodel's A4 carried exactly that mistake.
fn gpo_lane_bad(v) {
    if (v > GPU_TRID_LANE_MAX) { return 1; }
    if (v < 0 - GPU_TRID_LANE_MAX - 1) { return 1; }
    return 0;
}


# ============================================================================================
# gpo_validate_trilist(rec, fbw, fbh) -> 0 or a GPO_E_* reason. RUNG 12's validator.
# ============================================================================================
# ⛔ EVERY TRIANGLE IS VALIDATED BEFORE ANY IS DRAWN. A batch that validates lazily would draw the
# first k triangles and then refuse, leaving the framebuffer in a state neither the caller nor the
# kernel can describe. Reject-don't-clip is only enforceable if the whole batch is checked first.
# ⚠ PURE READS on the KERNEL-RESIDENT record and on the slot's kernel VA. Ring 3 cannot change a
# field between the check and the use.
# gpo_validate_tritex — rung 13's ABI gate. Returns 0 or a GPO_E_*.
#
# ⛔ EVERY REJECT HERE IS A REJECT, NEVER A CLAMP. A silently clamped texture dimension reads back as
# a correct run that sampled the wrong texels, which is precisely the failure the byte oracle cannot
# distinguish from a shader bug — and this arc has already spent burns on exactly that confusion.
#
# ⚠ The LUT rule is bidirectional ON PURPOSE. IDX8 without a LUT is obviously invalid; a LUT slot
# supplied WITHOUT IDX8 is rejected too, because accepting it would mean silently ignoring a slot
# the caller believed was in use. Same doctrine as the flags word.
# gpo_validate_texlist — rung 14's ABI gate. Returns 0 or a GPO_E_*.
#
# ⛔ EVERY PRIMITIVE IS VALIDATED, NOT SAMPLED. A list op that checked only the header would let one
# malformed entry out of 512 reach the shader, and the shader has no way to refuse — it would fetch
# from a bad slot address at dispatch time, which on this silicon is a wedged queue with no pointer
# back to the caller. The cost is a bounded pass over the array before anything is dispatched.
fn gpo_validate_texlist(rec, fbw, fbh) {
    if ((load32(rec + 4) & 0xFFFFFFFF) != 0) { return GPO_E_RESERVED; }   # header flags: none defined

    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w = wh & 0xFFFF;
    var h = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    if (w * h > GPU_TRI_MAX_PIXELS) { return GPO_E_WORK; }
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    if (dx + w > fbw) { return GPO_E_DIM; }
    if (dy + h > fbh) { return GPO_E_DIM; }

    var np = load32(rec + 24) & 0xFFFFFFFF;
    if (np < 1) { return GPO_E_TRILIST; }
    if (np > GPU_TEX_LIST_MAX) { return GPO_E_TRILIST; }
    var lmaxw = 0;
    var lmaxh = 0;
    # The list's lane axis, latched from primitive 0 and required to hold for every other primitive.
    # -1 = not yet seen. ⚠ Latched INSIDE the loop, not read ahead of it, so the primitive that sets
    # the mode is the same one the bounds checks above have already vetted.
    var lcm = 0 - 1;

    var pid = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(pid) == 0) { return GPO_E_TRILIST; }
    var pslot = pid - 1;
    var pkva = load64(&shm_kva + pslot * 8);
    if (pkva == 0) { return GPO_E_TRILIST; }
    if (load64(&shm_size + pslot * 8) < np * GPU_TEX_PRIM_BYTES) { return GPO_E_TRILIST; }

    # ---- every primitive, in bounds and resolvable -------------------------------------
    var i = 0;
    while (i < np) {
        var b = pkva + i * GPU_TEX_PRIM_BYTES;

        var pwh = load32(b + 0) & 0xFFFFFFFF;
        var pw = pwh & 0xFFFF;
        var ph = (pwh >> 16) & 0xFFFF;
        if (pw < 1) { return GPO_E_DIM; }
        if (ph < 1) { return GPO_E_DIM; }
        var pxy = load32(b + 4) & 0xFFFFFFFF;
        var px = pxy & 0xFFFF;
        var py = (pxy >> 16) & 0xFFFF;
        # ⚠ Bounded by the FRAMEBUFFER, not by the union rect. A primitive outside the union is a
        # caller error, but it is not a SAFETY error, and rejecting it here would make the union a
        # second thing to compute correctly. The shader clips to the union anyway.
        if (px + pw > fbw) { return GPO_E_DIM; }
        if (py + ph > fbh) { return GPO_E_DIM; }
        if (pw > lmaxw) { lmaxw = pw; }
        if (ph > lmaxh) { lmaxh = ph; }

        var pflags = load32(b + 20) & 0xFFFFFFFF;
        # ⚠ GPU_TEXL_PRIM_FLAGS_KNOWN, not GPU_TEX_FLAGS_KNOWN — this op accepts COLMAJOR and op 0x0B
        # must keep rejecting it. Sharing the mask would make 0x0B accept-and-ignore the bit.
        if ((pflags & (0 - 1 - GPU_TEXL_PRIM_FLAGS_KNOWN)) != 0) { return GPO_E_RESERVED; }
        # ⛔ FULLCOV IS REQUIRED, not merely permitted. This op has no coverage pass at all — that
        # absence is what removes rung 12's shared-slot failure mode. A primitive without it would
        # be asking for a mask that is never produced.
        if ((pflags & GPU_TEX_FLAG_FULLCOV) == 0) { return GPO_E_RESERVED; }

        # ⛔ ONE DISPATCH, ONE LANE AXIS. Checked in BOTH directions on purpose: the dangerous
        # direction is a row-major primitive 0 followed by a COLMAJOR primitive 1, because a driver
        # that sampled only primitive 0 would dispatch row-major and SILENTLY DISCARD primitive 1's
        # flag — a picture the caller did not ask for, with no error. Latching from primitive 0 and
        # comparing every successor makes both directions the same reject.
        var pcm = 0;
        if ((pflags & GPU_TEX_FLAG_COLMAJOR) != 0) { pcm = 1; }
        if (lcm < 0) { lcm = pcm; }
        if (pcm != lcm) { return GPO_E_MIXMODE; }

        var twh = load32(b + 16) & 0xFFFFFFFF;
        var tw = twh & 0xFFFF;
        var th = (twh >> 16) & 0xFFFF;
        if (tw < 1) { return GPO_E_TEXDIM; }
        if (th < 1) { return GPO_E_TEXDIM; }
        if (tw > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }
        if (th > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }
        if ((pflags & GPU_TEX_FLAG_WRAP) != 0) {
            if ((tw & (tw - 1)) != 0) { return GPO_E_TEXDIM; }
            if ((th & (th - 1)) != 0) { return GPO_E_TEXDIM; }
        }

        var tid = load32(b + 8) & 0xFFFFFFFF;
        if (shm_slot_valid(tid) == 0) { return GPO_E_TEXSLOT; }
        if (load64(&shm_kva + (tid - 1) * 8) == 0) { return GPO_E_TEXSLOT; }
        var bpt = 4;
        if ((pflags & GPU_TEX_FLAG_IDX8) != 0) { bpt = 1; }
        if (load64(&shm_size + (tid - 1) * 8) < tw * th * bpt) { return GPO_E_TEXSLOT; }
        if (tid == pid) { return GPO_E_ALIAS; }

        var lid = load32(b + 12) & 0xFFFFFFFF;
        if ((pflags & GPU_TEX_FLAG_IDX8) != 0) {
            if (shm_slot_valid(lid) == 0) { return GPO_E_LUTSLOT; }
            if (load64(&shm_kva + (lid - 1) * 8) == 0) { return GPO_E_LUTSLOT; }
            if (load64(&shm_size + (lid - 1) * 8) < GPU_TEX_LUT_ENTRIES * 4) { return GPO_E_LUTSLOT; }
            if (lid == tid) { return GPO_E_ALIAS; }
        }
        if ((pflags & GPU_TEX_FLAG_IDX8) == 0) {
            if (lid != 0) { return GPO_E_LUTSLOT; }
        }

        # reserved tail
        # ⛔ ALL SIX DWORDS, NOT THE FIRST. +72..95 is declared "the extension point, MUST be zero",
        # and until 14b only +72 was actually checked — +76/+80/+84/+88/+92 were accepted and ignored,
        # which is the precise thing an extension point must never do. A caller who parks a future
        # flag at +92 gets it silently dropped today and a silent behaviour CHANGE the day it acquires
        # meaning. 14b leans on this extension point (it is the stated reason COLMAJOR stays
        # per-primitive rather than moving to the header), so the gap is paid off here.
        var rz = 0;
        while (rz < 6) {
            if ((load32(b + 72 + rz * 4) & 0xFFFFFFFF) != 0) { return GPO_E_RESERVED; }
            rz = rz + 1;
        }
        i = i + 1;
    }

    # ⛔ BOUND THE LAUNCHED GRID, NOT THE UNION RECT. The generic w*h check above bounds the
    # caller's DAMAGE DECLARATION, which bounds nothing about the work: primitives may sit outside
    # the union, and 512 of them each the size of the screen would pass it untouched.
    #
    # What the hardware actually spends is the grid this op launches:
    #     lanes = (n_prims << tile_shift) * max(ph) * 64,   tile_shift = ceil(log2(ceil(max_pw/64)))
    # and that quantity is not proportional to the useful pixels. A list mixing ONE 4096-wide
    # primitive with 511 one-pixel columns forces tile_shift = 6, so the grid is 64x wider than 511
    # of the 512 primitives can use. Bounding the launched lanes catches that; bounding sum(pw*ph)
    # would not. On this silicon an unbounded dispatch is a wedged queue with no pointer back here.
    #
    # ⚠ AXIS-AWARE SINCE 14b. The lane axis is the one tile_shift is computed from, and the OTHER
    # axis becomes the row count. Getting this backwards does not produce a wrong picture — it
    # produces a cap computed against a grid nobody launches, which can sit 64x under the real one.
    var laxis = lmaxw;
    var lrows = lmaxh;
    if (lcm == 1) { laxis = lmaxh; lrows = lmaxw; }
    var lt = 0;
    var ltiles = (laxis + 63) / 64;
    while ((1 << lt) < ltiles) { lt = lt + 1; }
    if ((np << lt) * lrows > GPU_TEXL_MAX_WAVES) { return GPO_E_WORK; }
    return 0;
}

fn gpo_validate_tritex(rec, fbw, fbh) {
    var flags = load32(rec + 4) & 0xFFFFFFFF;
    # ⭐ RUNG 15 LANDED (1.56.29): the GPO_E_NOTIMPL reject that stood here while the shader did not
    # exist came out in the SAME change as the blob, which was the whole point of minting it.
    # ⛔ IT COULD NOT SIMPLY BE DELETED. The generic test below used the SHARED GPU_TEX_FLAGS_KNOWN
    # (0x07), which does not contain BILINEAR — so removing the reject alone would have turned every
    # bilinear request into GPO_E_RESERVED, "that bit is not a thing", on the exact commit that made it
    # a thing. The mask now comes from gpo_flags_known(GPU_OP_TRI_TEX), the accessor that already
    # encodes "0x0B accepts BILINEAR, 0x0C does not" in ONE place. Reading the per-op accessor rather
    # than the shared constant is also what keeps op 0x0C rejecting the bit for free.
    if ((flags & (0 - 1 - gpo_flags_known(GPU_OP_TRI_TEX))) != 0) { return GPO_E_RESERVED; }

    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w = wh & 0xFFFF;
    var h = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    if (w * h > GPU_TRI_MAX_PIXELS) { return GPO_E_WORK; }
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    if (dx + w > fbw) { return GPO_E_DIM; }
    if (dy + h > fbh) { return GPO_E_DIM; }

    # ---- the texture itself -------------------------------------------------------------
    var twh = load32(rec + 28) & 0xFFFFFFFF;
    var tw = twh & 0xFFFF;
    var th = (twh >> 16) & 0xFFFF;
    if (tw < 1) { return GPO_E_TEXDIM; }
    if (th < 1) { return GPO_E_TEXDIM; }
    if (tw > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }
    if (th > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }

    # ⛔ WRAP's power-of-two precondition, checked rather than assumed. `(n & (n-1)) == 0` with n >= 1.
    if ((flags & GPU_TEX_FLAG_WRAP) != 0) {
        if ((tw & (tw - 1)) != 0) { return GPO_E_TEXDIM; }
        if ((th & (th - 1)) != 0) { return GPO_E_TEXDIM; }
    }

    var tid = load32(rec + 8) & 0xFFFFFFFF;
    if (shm_slot_valid(tid) == 0) { return GPO_E_TEXSLOT; }
    var tslot = tid - 1;
    if (load64(&shm_kva + tslot * 8) == 0) { return GPO_E_TEXSLOT; }
    # ⚠ BYTES-PER-TEXEL IS SET BY THE FORMAT, so the size check must be too. A 4x undersized RGBA8
    # slot that happens to satisfy the IDX8 bound would otherwise read off the end of the slot.
    var bpt = 4;
    if ((flags & GPU_TEX_FLAG_IDX8) != 0) { bpt = 1; }
    if (load64(&shm_size + tslot * 8) < tw * th * bpt) { return GPO_E_TEXSLOT; }

    # ---- the palette --------------------------------------------------------------------
    var lid = load32(rec + 32) & 0xFFFFFFFF;
    if ((flags & GPU_TEX_FLAG_IDX8) != 0) {
        if (shm_slot_valid(lid) == 0) { return GPO_E_LUTSLOT; }
        var lslot = lid - 1;
        if (load64(&shm_kva + lslot * 8) == 0) { return GPO_E_LUTSLOT; }
        if (load64(&shm_size + lslot * 8) < GPU_TEX_LUT_ENTRIES * 4) { return GPO_E_LUTSLOT; }
        if (lid == tid) { return GPO_E_ALIAS; }
    }
    if ((flags & GPU_TEX_FLAG_IDX8) == 0) {
        if (lid != 0) { return GPO_E_LUTSLOT; }     # supplied but unusable — refuse, do not ignore
    }

    # ---- the vertex/UV record -----------------------------------------------------------
    var vid = load32(rec + 24) & 0xFFFFFFFF;
    if (shm_slot_valid(vid) == 0) { return GPO_E_TRILIST; }
    var vslot = vid - 1;
    if (load64(&shm_kva + vslot * 8) == 0) { return GPO_E_TRILIST; }
    if (load64(&shm_size + vslot * 8) < GPU_TEX_VTX_BYTES) { return GPO_E_TRILIST; }
    if (vid == tid) { return GPO_E_ALIAS; }

    # ---- the coverage edges, same contract as op 0x09 -----------------------------------
    var ner = load32(rec + 60) & 0xFFFFFFFF;
    var ne = ner & 0xFFFF;
    var rule = (ner >> 16) & 0xFFFF;

    # ⭐ FULLCOV supplies no shape, so it must supply no edges. All three fields zero, or refuse.
    if ((flags & GPU_TEX_FLAG_FULLCOV) != 0) {
        if (ne != 0) { return GPO_E_EDGEBUF; }
        if (rule != 0) { return GPO_E_RULE; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return GPO_E_EDGEBUF; }
        return 0;
    }

    if (rule != GPU_RULE_NONZERO) { return GPO_E_RULE; }
    if (ne < 3) { return GPO_E_EDGEBUF; }
    if (ne > GPU_EDGE_MAX) { return GPO_E_EDGEBUF; }

    var eid = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(eid) == 0) { return GPO_E_EDGEBUF; }
    var eslot = eid - 1;
    if (load64(&shm_kva + eslot * 8) == 0) { return GPO_E_EDGEBUF; }
    if (load64(&shm_size + eslot * 8) < ne * GPU_EDGE_BYTES) { return GPO_E_EDGEBUF; }
    if (eid == tid) { return GPO_E_ALIAS; }
    if (eid == vid) { return GPO_E_ALIAS; }

    if (w * h * ne > GPU_EDGE_WORK_MAX) { return GPO_E_WORK; }
    return 0;
}

fn gpo_validate_trilist(rec, fbw, fbh) {
    var flags = load32(rec + 4) & 0xFFFFFFFF;
    if (flags != 0) { return GPO_E_RESERVED; }        # no flags defined for this op yet

    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w = wh & 0xFFFF;
    var h = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    if (w * h > GPU_TRI_MAX_PIXELS) { return GPO_E_WORK; }
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    if (dx + w > fbw) { return GPO_E_DIM; }
    if (dy + h > fbh) { return GPO_E_DIM; }

    var nt = load32(rec + 24) & 0xFFFFFFFF;
    if (nt < 1) { return GPO_E_TRILIST; }
    if (nt > GPU_TRI_LIST_MAX) { return GPO_E_TRILIST; }

    var vid = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(vid) == 0) { return GPO_E_TRILIST; }
    var vslot = vid - 1;
    if (load64(&shm_size + vslot * 8) < nt * GPU_TRI_VTX_BYTES) { return GPO_E_TRILIST; }
    var vkva = load64(&shm_kva + vslot * 8);
    if (vkva == 0) { return GPO_E_TRILIST; }

    # ⚠ The WORK BOUND applies to the WHOLE BATCH, not per triangle. N triangles over the same rect
    # cost N coverage passes; bounding each one separately would let a 256-triangle batch spend 256x
    # the watchdog budget with every individual triangle "in range".
    if (w * h * nt * 3 > GPU_EDGE_WORK_MAX) { return GPO_E_WORK; }

    var i = 0;
    while (i < nt) {
        var b = vkva + i * GPU_TRI_VTX_BYTES;
        # reserved tail MUST be zero -- the same rule the #92 record itself carries, so a future
        # per-triangle field is a non-breaking extension by construction
        if ((load32(b + 36) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }
        if ((load32(b + 40) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }
        if ((load32(b + 44) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }

        var f = 0;
        while (f < 6) {
            if (gpo_coord_bad(gpo_i32(b + f * 4)) == 1) { return GPO_E_COORD; }
            f = f + 1;
        }
        var ax = gpo_i32(b +  0) >>> 16;  var ay = gpo_i32(b +  4) >>> 16;
        var bx = gpo_i32(b +  8) >>> 16;  var by = gpo_i32(b + 12) >>> 16;
        var cx = gpo_i32(b + 16) >>> 16;  var cy = gpo_i32(b + 20) >>> 16;
        var cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
        if (cross < 0) { cross = 0 - cross; }
        var a2 = cross << 16;
        if (a2 < GPU_TRI_AREA_MIN) { return GPO_E_AREA; }
        if (a2 > GPU_TRI_AREA_MAX) { return GPO_E_AREA; }
        i = i + 1;
    }
    return 0;
}

# ============================================================================================
# gpo_validate_tri(rec, fbw, fbh) -> 0 or a GPO_E_* reason. RUNG 11's validator.
# ============================================================================================
# ⚠ PURE READS on the KERNEL-RESIDENT copy. Validating the copy rather than user memory is a
# security property: ring 3 cannot change a field between the check and the use.
fn gpo_validate_tri(rec, fbw, fbh) {
    var flags = load32(rec + 4) & 0xFFFFFFFF;
    var derive = 0;
    if ((flags & GPU_TRI_FLAG_DERIVE) != 0) { derive = 1; }

    # Geometry: the mask rect, placed on the back buffer. REJECT, never clip.
    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w = wh & 0xFFFF;
    var h = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    if (w * h > GPU_TRI_MAX_PIXELS) { return GPO_E_WORK; }
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    if (dx + w > fbw) { return GPO_E_DIM; }
    if (dy + h > fbh) { return GPO_E_DIM; }

    # Edge source. With DERIVE the kernel synthesises the frame's three edges, so both the slot id
    # and the edge count MUST be zero -- a caller supplying either alongside DERIVE is confused
    # about which one wins, and guessing on their behalf is how silent wrong output happens.
    var edge_id = load32(rec + 12) & 0xFFFFFFFF;
    var nr = load32(rec + 60) & 0xFFFFFFFF;
    var ne = nr & 0xFFFF;
    var rule = (nr >> 16) & 0xFFFF;
    if (derive == 1) {
        if (edge_id != 0) { return GPO_E_EDGEBUF; }
        if (nr != 0) { return GPO_E_EDGEBUF; }
        # ⛔ DERIVE IS NOT IMPLEMENTED — the reject is at the BOTTOM of this function, not here.
        # See the block above `return 0`. Placing it last is deliberate: every real defect in the
        # request still gets its own specific code, and NOTIMPL then means "well-formed in every
        # other respect, but unbuildable."
    }
    if (derive == 0) {
        if (ne < 3) { return GPO_E_EDGEBUF; }
        if (ne > GPU_EDGE_MAX) { return GPO_E_EDGEBUF; }
        # ⛔ 1.56.24 — NONZERO ONLY, AND THE REJECT LIVES HERE, exactly as it does for op 0x08 in
        # gpo_validate_edge. This block used to accept EVENODD as well, while the shared worker
        # gpu_edge_cov (gpu.cyr) rejects `rule != GPU_RULE_NONZERO` outright — so rule 1 passed
        # validation and died as an opaque GPO_E_DISPATCH. gpo_validate_edge's own comment already
        # spells out why that is wrong twice over ("the ABI would ACCEPT rule 1 and then silently
        # fail it ... and the worker never runs in QEMU so the reject had no test at all"); the fix
        # was applied to op 0x08 and not to its twin. refraster.cyr implements `wind != 0` and
        # nothing else, so an EVENODD path would still ship with NO oracle.
        if (rule != GPU_RULE_NONZERO) { return GPO_E_RULE; }
        if (w * h * ne > GPU_EDGE_WORK_MAX) { return GPO_E_WORK; }
    }

    # The attribute frame: three 16.16 screen-space vertices, dwords 6..11.
    var vx0 = gpo_i32(rec + 24);  var vy0 = gpo_i32(rec + 28);
    var vx1 = gpo_i32(rec + 32);  var vy1 = gpo_i32(rec + 36);
    var vx2 = gpo_i32(rec + 40);  var vy2 = gpo_i32(rec + 44);
    if (gpo_coord_bad(vx0) == 1) { return GPO_E_COORD; }
    if (gpo_coord_bad(vy0) == 1) { return GPO_E_COORD; }
    if (gpo_coord_bad(vx1) == 1) { return GPO_E_COORD; }
    if (gpo_coord_bad(vy1) == 1) { return GPO_E_COORD; }
    if (gpo_coord_bad(vx2) == 1) { return GPO_E_COORD; }
    if (gpo_coord_bad(vy2) == 1) { return GPO_E_COORD; }

    # ⚠ VERTICES ARRIVE IN 16.16 BUT THE CROSS PRODUCT IS TAKEN IN PIXELS, then lifted by << 16.
    # Only the constant term and 2A carry that lift, because kx/ky already multiply a 16.16 sample
    # point. Cross-multiplying two 16.16 values instead would put 2A at cross << 32 and every area
    # bound below would be wrong by 2^16 -- which is exactly the error the plan's 2^32 / 2^53
    # constants encoded.
    var ax = vx0 >>> 16;  var ay = vy0 >>> 16;
    var bx = vx1 >>> 16;  var by = vy1 >>> 16;
    var cx = vx2 >>> 16;  var cy = vy2 >>> 16;
    var cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
    if (cross < 0) { cross = 0 - cross; }
    var a2 = cross << 16;
    if (a2 < GPU_TRI_AREA_MIN) { return GPO_E_AREA; }
    if (a2 > GPU_TRI_AREA_MAX) { return GPO_E_AREA; }

    # ⭐ FRAME SKEW. The numerator is bounded by the largest |E| over the mask rect's corners, and
    # E leaves [0, 2A] whenever a corner lies outside the frame -- which is legal and common. What
    # is NOT legal is a frame so small relative to the rect that |E| runs away and the 96-bit
    # numerator overflows. Bound the ratio rather than clamping E: clamping changes the interpolant
    # (it breaks gradient reproduction at the far corner) instead of merely bounding it.
    var lim = a2 * GPU_TRI_E_RATIO;
    var kxb = cy - ay;  var kyb = ax - cx;  var k0b = (ay * cx - ax * cy) << 16;
    var kxc = ay - by;  var kyc = bx - ax;  var k0c = (ax * by - ay * bx) << 16;
    var ci = 0;
    while (ci < 4) {
        var qx = dx;  var qy = dy;
        if (ci == 1) { qx = dx + w - 1; }
        if (ci == 2) { qy = dy + h - 1; }
        if (ci == 3) { qx = dx + w - 1; qy = dy + h - 1; }
        var pcx = (qx << 16) + 32768;
        var pcy = (qy << 16) + 32768;
        var eb = kxb * pcx + kyb * pcy + k0b;
        var ec = kxc * pcx + kyc * pcy + k0c;
        if (eb < 0) { eb = 0 - eb; }
        if (ec < 0) { ec = 0 - ec; }
        if (eb > lim) { return GPO_E_FRAME; }
        if (ec > lim) { return GPO_E_FRAME; }
        ci = ci + 1;
    }

    # ⛔ 1.56.24 — DERIVE IS NOT IMPLEMENTED, AND THIS VALIDATOR USED TO BLESS IT.
    # There is no edge synthesis anywhere in the kernel: gpu_tri_rgba (gpu.cyr) calls gpu_edge_cov
    # unconditionally, and on the DERIVE path gpo_execute leaves edge_mc = 0 and n_edges = 0, so
    # gpu_edge_cov's `n_edges < 1` guard refuses — the caller got a generic GPO_E_DISPATCH from deep
    # inside pass 2, with no way to tell "unbuilt feature" from "the GPU wedged". That is the exact
    # "ABI accepts then silently fails" defect gpo_validate_edge's comment names for op 0x08; the fix
    # shipped for 0x08 and was never applied to its twin.
    # ⭐ LAST, not at the flag test, on purpose: everything above still returns its own specific code,
    # so NOTIMPL here carries real information — "this request is well-formed in every other respect."
    # That is why the geometry battery can keep asserting through the DERIVE path.
    # Delete this in the SAME change that lands edge synthesis, never before — the ACCEPTED surface
    # must equal the PROVEN surface.
    if (derive == 1) { return GPO_E_NOTIMPL; }
    return 0;
}

# gpo_validate(rec, fbw, fbh) -> 0 or a GPO_E_* reason. PURE READS on the KERNEL-RESIDENT copy: no ring
# traffic, nothing drawn. Validating the copy rather than user memory is a security property, not a
# convenience — ring 3 cannot change the descriptor between the check and the use.
# gpo_validate_edge(rec) -> 0 or a GPO_E_* reason. RUNG 9's validator.
#
# ⭐ The whole point of rung 9a: every reject below is provable in QEMU, at zero burns, BEFORE the
# shader exists. The rasteriser is the part that needs iron; the ABI is not, and proving them
# together is how a shader bug and a validation bug become indistinguishable.
#
# Record: op(0) flags(4) dst_id(8) edge_id(12) wh(16) n_edges|rule(36)
fn gpo_validate_edge(rec) {
    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var w   = wh & 0xFFFF;
    var h   = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    if (w > GPU_COV_MAX_DIM) { return GPO_E_DIM; }
    if (h > GPU_COV_MAX_DIM) { return GPO_E_DIM; }

    var nr   = load32(rec + 36) & 0xFFFFFFFF;
    var ne   = nr & 0xFFFF;
    var rule = (nr >> 16) & 0xFFFF;
    # ⛔ NONZERO ONLY, AND THE REJECT LIVES HERE — not in gpu_edge_cov.
    # `refraster.cyr` implements `wind != 0` and nothing else, so an EVENODD path would ship with
    # NO oracle. It was first rejected inside the dispatch worker, which is wrong twice over: the
    # ABI would ACCEPT rule 1 and then silently fail it (precisely what the flags-word rule
    # forbids), and the worker never runs in QEMU so the reject had no test at all. At the
    # validator it is an ABI reject with a named code, provable at zero burns.
    if (rule != GPU_RULE_NONZERO) { return GPO_E_RULE; }
    # A closed path needs three edges. Two edges cannot enclose area, so a 2-edge call is a caller bug
    # that would otherwise rasterise to a silent all-zero mask -- indistinguishable from a dead shader,
    # which is the one confusion rung 9's failure table must never have.
    if (ne < 3) { return GPO_E_EDGEBUF; }
    # ⚠ The SHIPPED cap, not the ABI's 256. Same reasoning: the accepted surface must equal the
    # PROVEN surface, and it must be enforced where a test can see it. GPU_EDGE_CAP rises at B10
    # from the measured cost curve, never from the arithmetic model.
    if (ne > GPU_EDGE_CAP) { return GPO_E_EDGEBUF; }
    # ⭐ THE REAL ENVELOPE, MEASURED. Cost is 28.8 us + 0.0005953*(w*h)*ne (probe burn, linear in
    # E to ~2.6% across 4..256 edges), so the work product is what must be bounded — an edge cap
    # alone permitted 4096^2 x E=64 at ~639 ms against a ~94 ms watchdog while forbidding
    # 64^2 x E=256 at ~0.65 ms. See GPU_EDGE_WORK_MAX in gpu.cyr for the derivation.
    if (w * h * ne > GPU_EDGE_WORK_MAX) { return GPO_E_WORK; }
    if (ne > GPU_EDGE_MAX) { return GPO_E_EDGEBUF; }

    # Edge slot (input).
    var eid = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(eid) == 0) { return GPO_E_BADSLOT; }
    var es = eid - 1;
    if (load64(&shm_mc + es * 8) == 0) { return GPO_E_BADSLOT; }         # PMM-backed => GPU can't read
    if (ne * GPU_EDGE_BYTES > load64(&shm_size + es * 8)) { return GPO_E_EDGEBUF; }

    # Destination mask slot (output, 8bpp, w bytes per row).
    var did = load32(rec + 8) & 0xFFFFFFFF;
    if (shm_slot_valid(did) == 0) { return GPO_E_DSTSLOT; }
    var ds = did - 1;
    if (load64(&shm_mc + ds * 8) == 0) { return GPO_E_DSTSLOT; }
    # ⛔ Aliasing the edge array onto its own output is rejected, not merely discouraged: the shader
    # reads edges after it has begun writing coverage, so an alias is a data race whose symptom would
    # be a plausible-looking WRONG triangle -- the single hardest failure in rung 9's table to
    # attribute, because it mimics an edge-setup bug exactly.
    # ⚠ BEFORE the size check, not after. Aliasing is structural and size-independent, so a slot that
    # is both aliased AND too small must report the alias -- the more specific fault. The first run of
    # edge-abi-smoke reported 17 here where 19 was correct, for exactly this reason.
    if (eid == did) { return GPO_E_ALIAS; }
    if (w * h > load64(&shm_size + ds * 8)) { return GPO_E_DSTSLOT; }

    # ⭐ B3 — THE COORDINATE GUARD. Walks the edge array itself, because the coordinates live in
    # the SLOT, not in the record, and nothing else in this validator has ever needed to read a
    # caller's buffer. The cost is 4 loads per edge at a cap of 256 — bounded, and paid once per
    # call rather than per pixel.
    #
    # ⚠ `load32` ZERO-EXTENDS in Cyrius, so every coordinate MUST be sign-extended before it is
    # compared. Omitting this is a one-line trap that turns every negative coordinate into a
    # value near 2^32, so an entirely legal off-screen triangle would be rejected as out of
    # domain — and corpus case 5 is exactly that shape.
    var ekva = load64(&shm_kva + es * 8);
    if (ekva == 0) { return GPO_E_BADSLOT; }
    var q = 0;
    while (q < ne) {
        var f = 0;
        while (f < 4) {
            var c = load32(ekva + q * GPU_EDGE_BYTES + f * 4) & 0xFFFFFFFF;
            if (c >= 2147483648) { c = c - 4294967296; }     # sign-extend i32 -> i64
            if (c > GPU_EDGE_COORD_MAX) { return GPO_E_COORD; }
            if (c < 0 - GPU_EDGE_COORD_MAX) { return GPO_E_COORD; }
            f = f + 1;
        }
        q = q + 1;
    }

    if (gpu_edge_arm() != 1) { return GPO_E_ARM; }
    return 0;
}

#ifdef EDGE_ABI_SELFTEST
# edge_abi_selftest — RUNG 9a's oracle. Sixteen records through the SHIPPED gpo_validate_edge.
#
# ============================================================================================
# WHY THIS IS A SELFTEST AND NOT A RING-3 TOOL — the one place that rule bends, and why
# ============================================================================================
# The D lane's rule is that a bite whose oracle is A HUMAN WATCHING THE SCREEN belongs in a shell
# command. This oracle is a TEXT TABLE in klug, and the thing under test needs no GPU at all — so it
# runs in QEMU, at zero burns, which is the entire point of splitting 9a from 9b. Routing it through
# ring 3 instead would put it behind gpu_shader_op#92's `gpu_present` gate and make it IRON-ONLY,
# turning a free test into a burn.
#
# ⛔ IT CALLS THE SHIPPED FUNCTION. Not a copy, not a host re-implementation. Rung 9's whole risk is
# that a shader bug and a validation bug become indistinguishable on iron; a second artifact that
# agreed with the first by construction would be the ATOM_DRY defect all over again.
#
# The table is seeded DIRECTLY into the shm arrays because shm_create_gpu returns -1 without a GPU
# carveout. That is a deliberate trade: it makes the battery run identically on QEMU and on iron, and
# it lets a case ask for a PMM-backed slot, which no allocator would hand out on purpose.
# ⛔ Enters through gpo_validate, NOT gpo_validate_edge. The reserved-dword sweep and the flags check
# live in the SHARED prologue, so calling the edge validator directly skips them -- and the first run
# of this battery duly reported "want 12 got 7" on all three reserved cases. Testing the inner
# function was testing a path no caller can take.
# ⚠ REAL BACKING MEMORY. B3's guard walks the edge array through shm_kva, so the seeded slots
# can no longer be pure table entries — a null kva would fault the kernel inside the validator.
# ⚠ 512 slots x u64 = 4096 bytes = 256 edges. Sized from the WORK-BOUND case, not the 17-edge
# one: the coordinate guard walks `ne` edges out of this buffer, so a 256-edge record read past
# a 512-byte array and tripped GPO_E_COORD on garbage — a real reject for an unreal reason.
var eabi_edges[512];

# ⭐ ea_expect_valid — the well-formed record's expectation is ENVIRONMENT-DEPENDENT, and the
# plan got this wrong. It said to flip the expectation from GPO_E_ARM to 0 in the bite that arms
# the shader. That is right ON IRON — but this battery runs in QEMU, where `gpu_present == 0`,
# so `gpu_edge_arm()` correctly returns 0 and a perfectly valid record is correctly rejected at
# residency. A hard 0 would make the gate permanently red in the only environment it runs in.
#
# ⛔ So the gate accepts EXACTLY TWO answers and names which it saw. It is still a real check:
# every OTHER reject code is excluded, so a validation bug on a well-formed record still fails
# it. What it no longer does is confuse "no GPU in this VM" with "the ABI is broken".
fn ea_expect_valid(rec, name, nlen) {
    var got = gpo_validate(rec, 2560, 1440);
    if (got == 0) {
        kprint("edge-abi: PASS ", 15); kprint(name, nlen);
        kprint(" [accepted -- shader resident]\n", 31);
        return 1;
    }
    if (got == GPO_E_ARM) {
        kprint("edge-abi: PASS ", 15); kprint(name, nlen);
        kprint(" [GPO_E_ARM -- no GPU in this environment]\n", 43);
        return 1;
    }
    kprint("edge-abi: FAIL ", 15); kprint(name, nlen);
    kprint(" want 0 or ARM, got ", 20); kprint_num(got); kprint("\n", 1);
    return 0;
}

# ea_seed_prim — write one well-formed 96-byte TEX_LIST primitive. Vertices are RECT-LOCAL (the
# shader shades in rect space and the record carries the screen origin separately), UVs span the
# whole texture. ⚠ Writes all 24 dwords including the reserved tail, so a case that dirtied the tail
# is cleaned by the next reseed rather than leaking into an unrelated case.
fn ea_seed_prim(base, i, tex, lut, tw, th, fl, pw, ph, px, py) {
    var b = base + i * GPU_TEX_PRIM_BYTES;
    var z = 0;
    while (z < 24) { store32(b + z * 4, 0); z = z + 1; }
    store32(b +  0, ((ph << 16) | pw) & 0xFFFFFFFF);
    store32(b +  4, ((py << 16) | px) & 0xFFFFFFFF);
    store32(b +  8, tex);
    store32(b + 12, lut);
    store32(b + 16, ((th << 16) | tw) & 0xFFFFFFFF);
    store32(b + 20, fl);
    store32(b + 24, 0);              store32(b + 28, 0);
    store32(b + 32, pw * 65536);     store32(b + 36, 0);
    store32(b + 40, 0);              store32(b + 44, ph * 65536);
    store32(b + 48, 0);              store32(b + 52, 0);
    store32(b + 56, tw * 65536);     store32(b + 60, 0);
    store32(b + 64, 0);              store32(b + 68, th * 65536);
    return 0;
}

fn ea_expect(rec, want, name, nlen) {
    var got = gpo_validate(rec, 2560, 1440);
    if (got == want) {
        kprint("edge-abi: PASS ", 15); kprint(name, nlen); kprint("\n", 1);
        return 1;
    }
    kprint("edge-abi: FAIL ", 15); kprint(name, nlen);
    kprint(" want ", 6); kprint_num(want);
    kprint(" got ", 5);  kprint_num(got); kprint("\n", 1);
    return 0;
}

fn edge_abi_selftest() {
    # Refuse rather than corrupt: if anything already owns these slots, seeding them would clobber a
    # live buffer. Nothing allocates shm this early, so a non-free slot means an ordering change and
    # the selftest must say so instead of proceeding.
    var g = 10;
    while (g < 16) {
        if (load64(&shm_phys + g * 8) != 0) {
            kprint("edge-abi: REFUSED -- shm slot already in use, cannot seed\n", 58);
            return 0;
        }
        g = g + 1;
    }
    # id 12 (idx 11) stays FREE -- the invalid-slot cases point at it.
    # idx 10 (id 11) -- a LARGE edge slot, 4096 B = 256 edges. Only the work-bound ACCEPT case
    # uses it: id 14 stays at 256 B so the "edge slot too small" case keeps working, and a single
    # slot cannot serve both without one of the two tests silently losing its meaning.
    store64(&shm_phys + 10 * 8, 1); store64(&shm_mc + 10 * 8, 0x4000); store64(&shm_size + 10 * 8, 4096);
    store64(&shm_kva  + 10 * 8, &eabi_edges);
    store64(&shm_phys + 12 * 8, 1); store64(&shm_mc + 12 * 8, 0);      store64(&shm_size + 12 * 8, 256);
    store64(&shm_phys + 13 * 8, 1); store64(&shm_mc + 13 * 8, 0x1000); store64(&shm_size + 13 * 8, 256);
    store64(&shm_kva  + 13 * 8, &eabi_edges);       # the edge slot needs READABLE bytes now
    var ez = 0;
    while (ez < 512) { store64(&eabi_edges + ez * 8, 0); ez = ez + 1; }  # 0 is in range
    store64(&shm_phys + 14 * 8, 1); store64(&shm_mc + 14 * 8, 0x2000); store64(&shm_size + 14 * 8, 4096);
    store64(&shm_phys + 15 * 8, 1); store64(&shm_mc + 15 * 8, 0x3000); store64(&shm_size + 15 * 8, 16);

    var pass = 0;
    var d[64];                                     # function-local => 64 BYTES = exactly one record
    kprint("edge-abi: ---- #92 op 0x08 EDGE_COV ABI battery ----\n", 53);

    # well-formed -> VALID (the shader is resident)
    var z3 = 0; while (z3 < 16) { store32(&d + z3 * 4, 0); z3 = z3 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    # ⛔ FLIPPED FROM GPO_E_ARM TO 0 IN THE SAME BITE THAT ARMED THE SHADER (9b B7).
    # Through 9a-B6 `gpu_edge_arm()` returned 0 by design, so a well-formed record was correctly
    # rejected at residency. B7 writes both blobs, so residency now SUCCEEDS and the record
    # validates clean. Leaving the old expectation would turn edge-abi-smoke red FOR A CORRECT
    # REASON -- and a known-red gate carried into a burn is exactly how a real regression gets
    # waved through.
    pass = pass + ea_expect_valid(&d, "well-formed record", 18);

    # dstxy set (undefined for this op)
    var z12 = 0; while (z12 < 16) { store32(&d + z12 * 4, 0); z12 = z12 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 20, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "dstxy set (undefined for this op)", 33);

    # flags set (nothing is accepted yet)
    var z22 = 0; while (z22 < 16) { store32(&d + z22 * 4, 0); z22 = z22 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d +  4, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "flags set (nothing is accepted yet)", 35);

    # reserved dword 6 set
    var z32 = 0; while (z32 < 16) { store32(&d + z32 * 4, 0); z32 = z32 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 24, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "reserved dword 6 set", 20);

    # w = 0
    var z42 = 0; while (z42 < 16) { store32(&d + z42 * 4, 0); z42 = z42 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 16, (32 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "w = 0", 5);

    # h > cap
    var z52 = 0; while (z52 < 16) { store32(&d + z52 * 4, 0); z52 = z52 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 16, (5000 * 65536) + 32);
    pass = pass + ea_expect(&d, GPO_E_DIM, "h > cap", 7);

    # winding rule 2
    var z62 = 0; while (z62 < 16) { store32(&d + z62 * 4, 0); z62 = z62 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 36, (2 * 65536) + 3);
    pass = pass + ea_expect(&d, GPO_E_RULE, "winding rule 2", 14);

    # n_edges 2 (cannot enclose area)
    var z72 = 0; while (z72 < 16) { store32(&d + z72 * 4, 0); z72 = z72 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 36, 2);
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "n_edges 2 (cannot enclose area)", 31);

    # n_edges over cap
    var z82 = 0; while (z82 < 16) { store32(&d + z82 * 4, 0); z82 = z82 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 36, 257);
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "n_edges over cap", 16);

    # edge slot too small for n_edges
    var z92 = 0; while (z92 < 16) { store32(&d + z92 * 4, 0); z92 = z92 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 36, 17);
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "edge slot too small for n_edges", 31);

    # edge_id 0
    var z102 = 0; while (z102 < 16) { store32(&d + z102 * 4, 0); z102 = z102 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 12, 0);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "edge_id 0", 9);

    # edge_id free slot
    var z112 = 0; while (z112 < 16) { store32(&d + z112 * 4, 0); z112 = z112 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 12, 12);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "edge_id free slot", 17);

    # edge slot PMM-backed (GPU cannot read)
    var z122 = 0; while (z122 < 16) { store32(&d + z122 * 4, 0); z122 = z122 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d + 12, 13);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "edge slot PMM-backed (GPU cannot read)", 38);

    # dst_id free slot
    var z132 = 0; while (z132 < 16) { store32(&d + z132 * 4, 0); z132 = z132 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d +  8, 12);
    pass = pass + ea_expect(&d, GPO_E_DSTSLOT, "dst_id free slot", 16);

    # dst slot too small for w*h
    var z142 = 0; while (z142 < 16) { store32(&d + z142 * 4, 0); z142 = z142 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d +  8, 16);
    pass = pass + ea_expect(&d, GPO_E_DSTSLOT, "dst slot too small for w*h", 26);

    # edge and dst are the SAME slot
    var z152 = 0; while (z152 < 16) { store32(&d + z152 * 4, 0); z152 = z152 + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);                       # dst_id  -> 4096 B
    store32(&d + 12, 14);                       # edge_id -> 256 B
    store32(&d + 16, (32 * 65536) + 32);        # wh = 32x32 (1024 B mask)
    store32(&d + 36, 3);                        # n_edges 3, rule NONZERO
    store32(&d +  8, 14);
    store32(&d + 16, (8 * 65536) + 8);          # 8x8 = 64 B, fits slot 14's 256 B: ONLY the alias is wrong
    pass = pass + ea_expect(&d, GPO_E_ALIAS, "edge and dst are the SAME slot", 30);

    # ---- B3: the coordinate domain. Four cases, and the two BOUNDARY ones matter as much as
    # the two rejects: an off-by-one in the comparison would reject legal geometry sitting
    # exactly on 2^28, and nothing else in the battery would notice.
    var cz = 0;
    while (cz < 16) { store32(&d + cz * 4, 0); cz = cz + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15);
    store32(&d + 12, 14);
    store32(&d + 16, (32 * 65536) + 32);
    store32(&d + 36, 3);

    store32(&eabi_edges + 0, 268435456);            # +2^28 EXACTLY -- in range, inclusive
    pass = pass + ea_expect_valid(&d, "coord at +2^28 exactly is IN range", 34);

    store32(&eabi_edges + 0, 4026531840);           # -2^28 exactly (i32 two's complement)
    pass = pass + ea_expect_valid(&d, "coord at -2^28 exactly is IN range", 34);

    store32(&eabi_edges + 0, 268435457);            # +2^28 + 1 -- OUT
    pass = pass + ea_expect(&d, GPO_E_COORD, "coord above +2^28", 17);

    # ⚠ THE SIGN-EXTENSION CASE. load32 zero-extends in Cyrius, so without the explicit
    # sign-extend this reads as ~4.03e9, trips the UPPER bound, and reports GPO_E_COORD for the
    # RIGHT reason by ACCIDENT -- while every legal negative coordinate is rejected too. The
    # boundary case above is what actually catches that, which is why both are here.
    store32(&eabi_edges + 0, 4026531839);           # -2^28 - 1 -- OUT
    pass = pass + ea_expect(&d, GPO_E_COORD, "coord below -2^28", 17);

    # ---- B7: the shipped envelope, enforced at the ABI boundary ----
    var rz = 0;
    while (rz < 16) { store32(&d + rz * 4, 0); rz = rz + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15); store32(&d + 12, 14);
    store32(&d + 16, (32 * 65536) + 32);
    store32(&d + 36, (1 * 65536) + 3);               # rule = EVENODD, unimplemented
    pass = pass + ea_expect(&d, GPO_E_RULE, "rule EVENODD is refused, not silently failed", 44);

    store32(&d + 36, 257);                           # n_edges over the ABI maximum of 256
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "n_edges over the ABI max of 256", 31);

    # ⭐ THE WORK BOUND (1.56.19), measured. 4096x4096 with 64 edges is ~639 ms against a ~94 ms
    # watchdog — the envelope the old edge-only cap PERMITTED. It must now be refused, and with
    # its OWN code so "too much total work" is distinguishable from "too many edges".
    # ⛔ CLEAN THE EDGE ARRAY FIRST. These cases sit BEFORE the B3 block's own
    # `store32(&eabi_edges + 0, 0)` tidy-up, so offset 0 still holds the -2^28-1 value the last
    # out-of-domain reject wrote. The coordinate guard then correctly returned GPO_E_COORD and
    # the work-bound ACCEPT case looked like a work-bound failure. The guard was right; the
    # fixture was dirty — a test that inherits state from the test before it is not a test.
    store32(&eabi_edges + 0, 0);
    var wz = 0;
    while (wz < 16) { store32(&d + wz * 4, 0); wz = wz + 1; }
    store32(&d +  0, GPU_OP_EDGE_COV);
    store32(&d +  8, 15); store32(&d + 12, 14);
    store32(&d + 16, (4096 * 65536) + 4096);
    store32(&d + 36, 64);
    pass = pass + ea_expect(&d, GPO_E_WORK, "4096x4096 x 64 edges exceeds the work budget", 44);

    # ⛔ AND THE ENVELOPES THAT MUST STILL BE ACCEPTED. A bound that only ever rejects is a bound
    # nobody can use: 64 edges on a 128x128 mask was MEASURED at 655 us and must pass.
    # ⭐ 64x64 x 256 edges is EXACTLY the envelope the old edge-only cap wrongly FORBADE, at a
    # modelled ~0.65 ms. Asserting it is ACCEPTED is what proves the new bound fixed the right
    # thing, rather than merely tightening a different one.
    store32(&d + 12, 14);                            # 256 B edge slot -- exactly 16 edges
    store32(&d + 16, (64 * 65536) + 64);             # 4096 B mask -- fits the seeded dst slot
    store32(&d + 36, 16);
    pass = pass + ea_expect_valid(&d, "64x64 x 16 edges is INSIDE the budget", 37);

    store32(&eabi_edges + 0, 0);                    # leave the array clean


    # ======================================================================================
    # op 0x09 TRI_RGBA — rung 11's ABI
    # ======================================================================================
    # ⚠ Vertices are 16.16, so a pixel coordinate P is written P * 65536. The frames below are
    # sized in PIXELS and lifted here, which is the same discipline the validator applies when it
    # takes the cross product in pixels before lifting 2A.
    kprint("edge-abi: ---- #92 op 0x09 TRI_RGBA ABI battery ----\n", 53);

    # ⭐ THE PREP-RECORD ORACLE, AT ZERO BURNS. The kernel computes the 128-byte TRI-PREP record
    # from corpus case 0's frame and prints it; tests/gpu/triref computes the SAME record from the
    # SAME inputs on the host. A field that differs indicts whichever copy of the integer-divide
    # primitives drifted — and those primitives exist twice (kernel + host tool) because the kernel
    # cannot include a host file, with Cyrius shadowing duplicate fns silently.
    # ⚠ THIS IS NOT A READ-BACK. Printing what was computed lets an independent computation
    # CONTRADICT it. A kernel reading back its own store and declaring agreement proves nothing.
    var trec = &eabi_edges;                       # borrow the battery's scratch page
    var tv1 = 256 * 65536;
    var tc0 = 0xFFFF0000; var tc1 = 0xFF00FF00; var tc2 = 0xFF0000FF;
    if (gpu_tri_prep(trec, 0x1234000, 0, 0, tv1, 0, 0, tv1, tc0, tc1, tc2) == 1) {
        gpu_tri_prep_dump(trec);
    }
    var tk1 = 100 * 65536; var tk2 = 200 * 65536;
    if (gpu_tri_prep(trec, 0, 0, 0, tk1, tk1, tk2, tk2, tc0, tc1, tc2) != 0) {
        kprint("tri-prep: FAIL -- a COLLINEAR frame was accepted\n", 49);
    }


    # well-formed, DERIVE (no edge slot at all) -> NOT IMPLEMENTED (1.56.24)
    # ⛔ This assertion used to be ea_expect_valid. That was the bug in test form: the ABI blessed a
    # request no worker can execute, and the selftest FROZE that gap as correct behaviour. Flip this
    # back to ea_expect_valid only in the change that lands edge synthesis.
    var t1 = 0; while (t1 < 16) { store32(&d + t1 * 4, 0); t1 = t1 + 1; }
    store32(&d +  0, GPU_OP_TRI_RGBA);
    store32(&d +  4, GPU_TRI_FLAG_DERIVE);
    store32(&d + 16, (64 * 65536) + 64);        # wh = 64x64
    store32(&d + 20, 0);                        # dstxy = (0,0)
    store32(&d + 28, 0);       store32(&d + 24, 0);
    store32(&d + 32, 256 * 65536); store32(&d + 36, 0);
    store32(&d + 40, 0);       store32(&d + 44, 256 * 65536);
    store32(&d + 48, 0xFFFF0000); store32(&d + 52, 0xFF00FF00); store32(&d + 56, 0xFF0000FF);
    pass = pass + ea_expect(&d, GPO_E_NOTIMPL, "tri: well-formed DERIVE is unimplemented", 40);

    # the RESERVED dword 2 must be zero -- the one forward-compat slot
    store32(&d +  8, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tri: reserved dword 2 non-zero", 30);
    store32(&d +  8, 0);

    # an unknown flag bit -- per-op vocabulary, so bit1 is NOT known to this op
    store32(&d +  4, GPU_TRI_FLAG_DERIVE | 0x02);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tri: unknown flag bit", 21);
    store32(&d +  4, GPU_TRI_FLAG_DERIVE);

    # DERIVE with an edge slot -- ambiguous, so refuse rather than pick a winner
    store32(&d + 12, 14);
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "tri: DERIVE with an edge slot", 29);
    store32(&d + 12, 0);

    # ⭐ AREA floor: a degenerate (collinear) frame has zero area
    store32(&d + 32, 128 * 65536); store32(&d + 36, 128 * 65536);
    store32(&d + 40, 256 * 65536); store32(&d + 44, 256 * 65536);
    pass = pass + ea_expect(&d, GPO_E_AREA, "tri: collinear frame (zero area)", 32);

    # a legal SMALL frame -- 16x16 is 128 px^2, far below the plan's 2^32 floor and it must be
    # ACCEPTED. This case exists because that floor would have rejected most real triangles.
    store32(&d + 32, 16 * 65536); store32(&d + 36, 0);
    store32(&d + 40, 0);          store32(&d + 44, 16 * 65536);
    # ⚠ Expects NOTIMPL, not VALID, because this descriptor rides the DERIVE path (1.56.24) — and
    # NOTIMPL is still a passing result for THIS assertion's purpose: it is returned last, after
    # every geometry check, so reaching it proves the AREA floor did NOT reject a 16x16 frame. A
    # GPO_E_AREA here would be the regression this case exists to catch.
    pass = pass + ea_expect(&d, GPO_E_NOTIMPL, "tri: small frame clears the AREA floor", 38);

    # coordinate outside the +-2^28 window
    store32(&d + 32, 0x20000000);
    pass = pass + ea_expect(&d, GPO_E_COORD, "tri: vertex beyond +-2^28", 25);
    store32(&d + 32, 256 * 65536);
    store32(&d + 40, 0); store32(&d + 44, 256 * 65536);

    # ⭐ FRAME SKEW: a 1 px frame at the origin under a rect placed far away drives |E| past the
    # ratio bound. ⚠ THE RECT MUST STAY UNDER GPU_TRI_MAX_PIXELS or the pixel cap fires FIRST and
    # this case tests GPO_E_WORK instead -- which is what a 2048x2048 rect did on the first run.
    # 512x512 = 262144 is well under 2^20; the skew comes from the DISTANCE, not the size.
    store32(&d + 16, (512 * 65536) + 512);      # 512x512
    store32(&d + 20, (900 * 65536) + 1024);     # placed at (1024, 900), far from the frame
    store32(&d + 32, 1 * 65536); store32(&d + 36, 0);
    store32(&d + 40, 0);         store32(&d + 44, 1 * 65536);
    pass = pass + ea_expect(&d, GPO_E_FRAME, "tri: frame skew beyond the ratio", 32);
    store32(&d + 20, 0);

    # destination off the right edge of the framebuffer -- REJECT, never clip
    var t9 = 0; while (t9 < 16) { store32(&d + t9 * 4, 0); t9 = t9 + 1; }
    store32(&d +  0, GPU_OP_TRI_RGBA);
    store32(&d +  4, GPU_TRI_FLAG_DERIVE);
    store32(&d + 16, (64 * 65536) + 64);
    store32(&d + 20, 2540);                     # dx = 2540, +64 > 2560
    store32(&d + 32, 256 * 65536); store32(&d + 44, 256 * 65536);
    store32(&d + 48, 0xFFFF0000); store32(&d + 52, 0xFF00FF00); store32(&d + 56, 0xFF0000FF);
    pass = pass + ea_expect(&d, GPO_E_DIM, "tri: dst runs off the framebuffer", 33);

    # ⭐ 1.56.24 — THE EVEN-ODD REJECT. op 0x09 had NO rule coverage at all, which is how it accepted
    # a rule its own worker refuses for five months. Explicit-edge path (flags = 0) so the rule check
    # is reachable: gpu_edge_cov rejects `rule != GPU_RULE_NONZERO`, refraster.cyr implements
    # `wind != 0` and nothing else, so EVENODD would ship with no oracle. Rejected at the VALIDATOR
    # where QEMU can see it — the worker never runs here, which is exactly why the old reject was
    # untestable. Mirrors "edge-abi: even-odd rule" for op 0x08.
    var ta = 0; while (ta < 16) { store32(&d + ta * 4, 0); ta = ta + 1; }
    store32(&d +  0, GPU_OP_TRI_RGBA);
    store32(&d +  4, 0);                        # explicit edges, NOT derive
    store32(&d + 12, 14);                       # edge slot
    store32(&d + 16, (64 * 65536) + 64);        # wh = 64x64
    store32(&d + 20, 0);
    store32(&d + 32, 256 * 65536); store32(&d + 44, 256 * 65536);
    store32(&d + 48, 0xFFFF0000); store32(&d + 52, 0xFF00FF00); store32(&d + 56, 0xFF0000FF);
    store32(&d + 60, (GPU_RULE_EVENODD << 16) + 3);
    pass = pass + ea_expect(&d, GPO_E_RULE, "tri: even-odd rule is refused", 29);
    # and the NONZERO twin must still be accepted, or the reject above proves nothing
    store32(&d + 60, (GPU_RULE_NONZERO << 16) + 3);
    pass = pass + ea_expect_valid(&d, "tri: nonzero rule with explicit edges", 37);


    # ======================================================================================
    # op 0x0A TRI_LIST — rung 12's ABI
    # ======================================================================================
    kprint("edge-abi: ---- #92 op 0x0A TRI_LIST ABI battery ----\n", 53);

    # A vertex slot with two well-formed triangles: 2 x 48 B = 96 B, inside id 14's 4096.
    var vb = &eabi_edges;
    var vz = 0;
    while (vz < 24) { store32(vb + vz * 4, 0); vz = vz + 1; }
    store32(vb +  0, 0);            store32(vb +  4, 0);
    store32(vb +  8, 64 * 65536);   store32(vb + 12, 0);
    store32(vb + 16, 0);            store32(vb + 20, 64 * 65536);
    store32(vb + 24, 0xFFFF0000);   store32(vb + 28, 0xFF00FF00); store32(vb + 32, 0xFF0000FF);
    store32(vb + 48, 0);            store32(vb + 52, 0);
    store32(vb + 56, 64 * 65536);   store32(vb + 60, 0);
    store32(vb + 64, 0);            store32(vb + 68, 64 * 65536);
    store32(vb + 72, 0xFFFF0000);   store32(vb + 76, 0xFF00FF00); store32(vb + 80, 0xFF0000FF);

    var L1 = 0; while (L1 < 16) { store32(&d + L1 * 4, 0); L1 = L1 + 1; }
    store32(&d +  0, GPU_OP_TRI_LIST);
    store32(&d + 12, 14);                       # vtx slot
    store32(&d + 16, (64 * 65536) + 64);
    store32(&d + 24, 2);                        # n_tris
    pass = pass + ea_expect_valid(&d, "list: well-formed 2-triangle batch", 34);

    store32(&d + 24, 0);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "list: zero triangles", 20);
    store32(&d + 24, GPU_TRI_LIST_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "list: triangle count above the cap", 34);
    store32(&d + 24, 2);

    # ⛔ THE SLOT MUST BE BIG ENOUGH FOR EVERY TRIANGLE. id 15 is 16 B -- room for none.
    store32(&d + 12, 15);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "list: vertex slot too small for n_tris", 38);
    store32(&d + 12, 14);

    # a reserved per-triangle dword must be zero -- the extension point
    store32(vb + 36, 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "list: per-triangle reserved dword non-zero", 42);
    store32(vb + 36, 0);

    # ⭐ EVERY triangle is checked, not just the first: corrupt the SECOND one only.
    store32(vb + 56, 0);   store32(vb + 68, 0);        # triangle 1 becomes degenerate
    pass = pass + ea_expect(&d, GPO_E_AREA, "list: the SECOND triangle is degenerate", 39);
    store32(vb + 56, 64 * 65536); store32(vb + 68, 64 * 65536);

    # flags are not defined for this op yet
    store32(&d +  4, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "list: flags must be zero", 24);
    store32(&d +  4, 0);

    # ============================================================================================
    # op 0x0B TRI_TEX — rung 13a's ABI, proven here at ZERO BURNS
    # ============================================================================================
    # ⛔ SHM_MAX IS 16, so this battery REUSES the fixtures above rather than adding slots. The
    # assignment is written out because an alias between two of them would turn a real reject into
    # an accident:
    #   tex  = id 14 — 256 B, kva set. Exactly an 8x8 RGBA8 texture, so the size gate is EXACT.
    #   vtx  = id 11 — 4096 B, kva set.
    #   lut  = id 15 — 4096 B, kva set below (>= the 1024 a 256-entry LUT needs).
    #   edge = id 13 — 256 B, kva set below (>= the 48 that 3 edges need).
    #   id 16 — 16 B, kva set below: the TOO-SMALL slot, used for both tex and lut undersize cases.
    #   id 12 — deliberately FREE: the invalid-slot cases point at it.
    kprint("edge-abi: ---- #92 op 0x0B TRI_TEX ABI battery ----\n", 52);
    store64(&shm_kva + 14 * 8, &eabi_edges);
    store64(&shm_kva + 12 * 8, &eabi_edges);
    store64(&shm_kva + 15 * 8, &eabi_edges);

    var tz = 0;
    while (tz < 16) { store32(&d + tz * 4, 0); tz = tz + 1; }
    store32(&d +  0, GPU_OP_TRI_TEX);
    store32(&d +  4, 0);                          # RGBA8
    store32(&d +  8, 14);                         # tex_id
    store32(&d + 12, 13);                         # edge_id
    store32(&d + 16, (16 * 65536) + 16);          # 16x16 destination rect
    store32(&d + 20, 0);                          # dstxy
    store32(&d + 24, 11);                         # vtx_id
    store32(&d + 28, (8 * 65536) + 8);            # 8x8 texture
    store32(&d + 32, 0);                          # no LUT in RGBA8
    store32(&d + 60, 3);                          # 3 edges, NONZERO

    # ⚠ THE ACCEPT CASES EXPECT 0, NOT GPO_E_ARM. ea_expect exercises the VALIDATOR ONLY; arming is
    # the executor's business and never reaches this battery. Expecting GPO_E_ARM here read as "the
    # ABI is broken" when in fact the ABI was doing exactly its job — the instrument was asking the
    # wrong question. 13a's arming claim is proven by the executor branch, not by this line.
    pass = pass + ea_expect(&d, 0, "tex: well-formed RGBA8 is accepted", 34);

    store32(&d +  4, GPU_TEX_FLAG_IDX8);
    store32(&d + 32, 15);                         # LUT slot
    pass = pass + ea_expect(&d, 0, "tex: well-formed IDX8+LUT is accepted", 37);

    store32(&d + 32, 0);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "tex: IDX8 without a LUT slot", 28);
    store32(&d + 32, 16);                         # 16 B — far short of 256 x 4
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "tex: IDX8 LUT slot too small", 28);
    store32(&d + 32, 12);                         # free slot
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "tex: IDX8 LUT slot is free", 26);

    # ⚠ THE BIDIRECTIONAL HALF. A LUT supplied WITHOUT IDX8 is refused rather than ignored: the
    # caller believes that slot is in use, and silently disregarding it is how a wrong picture gets
    # blamed on the shader.
    store32(&d +  4, 0);
    store32(&d + 32, 15);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "tex: LUT supplied without IDX8", 30);
    store32(&d + 32, 0);

    store32(&d +  4, 0x08);                       # outside GPU_TEX_FLAGS_KNOWN (0x02 FULLCOV, 0x04 WRAP)
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tex: unknown flag bit", 21);
    store32(&d +  4, 0);

    # ⭐ RUNG 15 LANDED (1.56.29): BILINEAR is ACCEPTED, and these two cases flipped from
    # ea_expect(GPO_E_NOTIMPL) to ea_expect_valid in the SAME change that added tex_bilin.s — which is
    # exactly what the note that stood here demanded. The ABI's accepted surface and the kernel's
    # proven surface moved together, in one commit, in both directions.
    # ⛔ THE SECOND CASE IS THE LOAD-BEARING ONE AND IT IS NOT A DUPLICATE. A validator that widened
    # the mask to a bare `flags == GPU_TEX_FLAG_BILINEAR` compare, or that returned early on the
    # bilinear bit, would pass the first case and FAIL this one. BILINEAR alongside a legal companion
    # flag is the shape a real caller sends (a full-rect textured quad is FULLCOV|BILINEAR), and it is
    # the case that proves the bit was added to the op's mask rather than special-cased ahead of it.
    store32(&d +  4, GPU_TEX_FLAG_BILINEAR);
    pass = pass + ea_expect_valid(&d, "tex: BILINEAR is accepted (rung 15 shader is resident)", 54);
    # ⚠⚠ FULLCOV REQUIRES THE THREE EDGE FIELDS ZEROED — and this case FAILED with GPO_E_EDGEBUF on
    # first run because it inherited edge_id 13 / n_edges 3 from the cases above. The kernel was
    # right and the test was wrong. Worth recording rather than quietly fixing: that rule
    # ("FULLCOV supplies no shape, so it must supply no edges", gpo_validate_tritex) had been
    # UNREACHABLE from this case for as long as the GPO_E_NOTIMPL reject stood in front of it, so
    # removing the reject is what exposed it. Every early-return added to a validator hides the rules
    # behind it from every test that trips the early return first.
    store32(&d +  4, GPU_TEX_FLAG_BILINEAR | GPU_TEX_FLAG_FULLCOV);
    store32(&d + 12, 0);                              # FULLCOV: no edge slot
    store32(&d + 60, 0);                              # FULLCOV: no edges, no rule
    pass = pass + ea_expect_valid(&d, "tex: BILINEAR accepted alongside FULLCOV", 40);
    store32(&d + 12, 13);                             # restore for the cases below
    store32(&d + 60, 3);
    # ⚠ 0x18 = BILINEAR | COLMAJOR. COLMAJOR is op 0x0C's alone, and widening op 0x0B's mask for
    # bilinear must NOT have dragged it in. Added with the flip because that is precisely the
    # regression a mask edit causes, and nothing else in this battery would have caught it.
    store32(&d +  4, GPU_TEX_FLAG_BILINEAR | GPU_TEX_FLAG_COLMAJOR);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tex: BILINEAR|COLMAJOR still refuses COLMAJOR", 45);
    store32(&d +  4, 0);

    store32(&d + 28, (8 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "tex: texture width zero", 23);
    store32(&d + 28, (0 * 65536) + 8);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "tex: texture height zero", 24);
    store32(&d + 28, (8 * 65536) + 4097);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "tex: texture width over cap", 27);
    store32(&d + 28, (8 * 65536) + 8);

    store32(&d +  8, 12);
    pass = pass + ea_expect(&d, GPO_E_TEXSLOT, "tex: texture slot is free", 25);
    store32(&d +  8, 16);                         # 16 B cannot hold 8x8 RGBA8 (256 B)
    pass = pass + ea_expect(&d, GPO_E_TEXSLOT, "tex: texture slot too small for RGBA8", 37);
    store32(&d +  8, 14);

    store32(&d + 24, 12);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "tex: vertex slot is free", 24);
    store32(&d + 24, 14);                         # same slot as the texture
    pass = pass + ea_expect(&d, GPO_E_ALIAS, "tex: vertex slot aliases the texture", 36);
    store32(&d + 24, 11);

    store32(&d + 60, 2);
    pass = pass + ea_expect(&d, GPO_E_EDGEBUF, "tex: fewer than 3 edges", 23);
    store32(&d + 60, (GPU_RULE_EVENODD * 65536) + 3);
    pass = pass + ea_expect(&d, GPO_E_RULE, "tex: winding rule must be NONZERO", 33);
    store32(&d + 60, 3);

    store32(&d + 36, 1);                          # outside the 0x81FF field mask
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tex: reserved dword must be zero", 32);
    store32(&d + 36, 0);

    # ---- #92 op 0x0C TEX_LIST -------------------------------------------------------------------
    # Slots: prim array = id 11 (4096 B, kva) — 42 primitives' worth. tex = id 14 (256 B = 8x8
    # RGBA8, EXACT so the size gate bites). lut = id 15 (4096 B). id 16 = 16 B undersize. id 12 free.
    kprint("edge-abi: ---- #92 op 0x0C TEX_LIST ABI battery ----\n", 53);
    var pb = &eabi_edges;
    ea_seed_prim(pb, 0, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 16, 16, 0, 0);
    ea_seed_prim(pb, 1, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 16, 16, 16, 0);

    var lz = 0;
    while (lz < 16) { store32(&d + lz * 4, 0); lz = lz + 1; }
    store32(&d +  0, GPU_OP_TEX_LIST);
    store32(&d + 12, 11);                         # primitive array slot
    store32(&d + 16, (16 * 65536) + 32);          # union rect 32x16
    store32(&d + 20, 0);
    store32(&d + 24, 2);                          # n_prims

    pass = pass + ea_expect(&d, 0, "texl: well-formed 2-primitive list is accepted", 46);

    ea_seed_prim(pb, 1, 14, 15, 8, 8, GPU_TEX_FLAG_FULLCOV | GPU_TEX_FLAG_IDX8, 16, 16, 16, 0);
    pass = pass + ea_expect(&d, 0, "texl: IDX8 primitive with a LUT is accepted", 43);

    # ⛔ THE EXECUTOR BRANCH, NOT JUST THE VALIDATOR. Every other case here calls gpo_validate, so a
    # missing or mistyped branch in gpo_execute would ship completely unremarked: the record would
    # validate, execute would fall through, and #92 would answer GPO_E_BADOP for an op the ABI
    # advertises as supported. Running the record through gpo_execute proves the branch EXISTS and
    # is REACHED — the answer must be GPO_E_ARM (no GPU in this environment), never GPO_E_BADOP.
    # ⚠ Safe to call here: gpu_texl_arm() checks gpu_present FIRST and returns 0, so nothing is
    # dispatched and no hardware is touched.
    var xr = gpo_execute(&d);
    if (xr == GPO_E_ARM) {
        kprint("edge-abi: PASS texl: the EXECUTOR branch is reached (GPO_E_ARM)\n", 64);
        pass = pass + 1;
    }
    if (xr != GPO_E_ARM) {
        kprint("edge-abi: FAIL texl: gpo_execute want ARM got ", 46);
        kprint_num(xr);
        kprint(" -- BADOP here means the branch is missing\n", 43);
    }

    # ⭐ THE CASE THIS OP EXISTS TO GET RIGHT. Every previous reject below mutates primitive [1], not
    # [0] — a validator that checked only the first entry would pass all of them and ship a list op
    # that lets one bad primitive in 512 reach a shader with no way to refuse.
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 12, 0);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "texl: IDX8 without LUT in the SECOND primitive", 46);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 12, 16);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "texl: LUT slot too small (primitive 1)", 38);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 12, 12);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "texl: LUT slot is free (primitive 1)", 36);
    ea_seed_prim(pb, 1, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 16, 16, 16, 0);

    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 12, 15);
    pass = pass + ea_expect(&d, GPO_E_LUTSLOT, "texl: LUT supplied without IDX8 (primitive 1)", 45);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 12, 0);

    # ⛔ FULLCOV IS MANDATORY. There is no coverage stage in this op, so a primitive without the flag
    # is asking for a mask that is never produced.
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, 0);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: primitive without FULLCOV", 31);
    # ⚠ 0x10, NOT 0x08. This case used 0x08 until rung 14b DEFINED that bit as COLMAJOR, at which
    # point it stopped testing "a bit this op does not define" and started testing the mix rule —
    # it went red wanting GPO_E_RESERVED and getting GPO_E_MIXMODE. The battery caught its own
    # obsolescence, which is the behaviour worth having: the case must always name the LOWEST
    # still-undefined bit, so it moves every time the vocabulary grows.
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV | 0x10);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: primitive unknown flag bit", 32);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV);

    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 8, 12);
    pass = pass + ea_expect(&d, GPO_E_TEXSLOT, "texl: texture slot is free (primitive 1)", 40);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 8, 16);
    pass = pass + ea_expect(&d, GPO_E_TEXSLOT, "texl: texture slot too small (primitive 1)", 42);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 8, 11);
    pass = pass + ea_expect(&d, GPO_E_ALIAS, "texl: texture aliases the primitive array", 41);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 8, 14);

    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 16, (8 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "texl: texture width zero (primitive 1)", 38);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 16, (4097 * 65536) + 8);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "texl: texture height over cap (primitive 1)", 43);
    # WRAP needs a power-of-two texture; the shader tiles with an AND, which silently lies otherwise.
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 16, (8 * 65536) + 6);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV | GPU_TEX_FLAG_WRAP);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "texl: WRAP with a non-power-of-two width", 40);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 16, (8 * 65536) + 8);

    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 0, (16 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "texl: primitive width zero", 26);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 0, (16 * 65536) + 16);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 4, (0 * 65536) + 2550);
    pass = pass + ea_expect(&d, GPO_E_DIM, "texl: primitive runs off the framebuffer", 40);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 4, (0 * 65536) + 16);

    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 72, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: primitive reserved tail must be zero", 42);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 72, 0);

    # ---- header rejects ----
    store32(&d + 24, 0);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "texl: zero primitives", 21);
    store32(&d + 24, GPU_TEX_LIST_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "texl: more primitives than the cap", 34);
    # ⚠ 43 x 96 = 4128 > the 4096 the slot holds. REJECT, never clamp: a clamp would shade 42 of the
    # caller's 43 primitives and report success.
    store32(&d + 24, 43);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "texl: primitive array too small for n_prims", 43);
    store32(&d + 24, 2);

    store32(&d + 12, 12);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "texl: primitive array slot is free", 34);
    store32(&d + 12, 11);

    # ⭐ THE LAUNCHED-GRID BOUND, exercised BOTH ways. A 4096-wide primitive forces tile_shift = 6,
    # so a 2-primitive list launches (2<<6) * ph wavefronts — 64x wider than the 1-px primitive
    # beside it can use. That is the pathological mix the wave cap exists to refuse, and it is
    # invisible to any bound on the union rect or on sum(pw*ph).
    # ⚠ The ACCEPT half matters as much: a DOOM frame (640 columns x 200 rows = 128000 waves) must
    # still pass, or the cap would have killed the workload the op was built for.
    # ⚠ THE NUMBERS WERE DERIVED, NOT GUESSED. A first cut used 2 primitives of 2048x1024 and would
    # have been ACCEPTED (65536 waves) — the case would have gone red for the test's fault, and the
    # tempting "fix" is to weaken the validator. With the framebuffer at 2560x1440 the cap is simply
    # unreachable at n_prims = 2: even 2560x1440 is only 184320 waves. Nine is the smallest count
    # that trips it: (9 << 5) * 1024 = 294912 > 262144.
    var lw = 0;
    while (lw < 9) {
        ea_seed_prim(pb, lw, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 2048, 1024, 0, 0);
        lw = lw + 1;
    }
    store32(&d + 24, 9);
    pass = pass + ea_expect(&d, GPO_E_WORK, "texl: launched grid exceeds the wave cap", 40);
    # ⭐ THE ACCEPT HALF MATTERS AS MUCH. A cap that also refused DOOM's own shape would have killed
    # the workload this op exists for — 640 columns x 200 rows is 128000 waves and must pass.
    lw = 0;
    while (lw < 9) {
        ea_seed_prim(pb, lw, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 1, 1024, 0, 0);
        lw = lw + 1;
    }
    pass = pass + ea_expect(&d, 0, "texl: nine 1-px columns 1024 rows tall are accepted", 51);

    # ⭐⭐ RUNG 14b — THE ONE GEOMETRY THAT CAN ONLY ANSWER DIFFERENTLY IF THE AXIS ACTUALLY SWAPPED.
    # Nine primitives at 1024 x 1088, identical in every field but the COLMAJOR bit:
    #     row-major: ltiles = ceil(1024/64) = 16 -> lt = 4 -> (9<<4) * 1088 = 156672   ACCEPT
    #     col-major: ltiles = ceil(1088/64) = 17 -> lt = 5 -> (9<<5) * 1024 = 294912   REJECT
    # Same nine records, one flag bit apart, opposite verdicts.
    #
    # ⛔⛔ THE OBVIOUS CASE — "mirror the row-major reject by transposing 2048x1024" — IS BOTH ILLEGAL
    # AND VACUOUS, and it would have gone red on a CORRECT kernel. Illegal: this battery validates
    # against a 2560x1440 framebuffer, and `py + ph > fbh` is checked INSIDE the per-primitive loop,
    # 50-odd lines before the wave bound, so a 2048-tall primitive returns GPO_E_DIM and never reaches
    # the cap at all. Vacuous: 2048 = 2 x 1024 and ceil(2048/64) = 2 x ceil(1024/64), so lt rises by
    # exactly 1 while the row count halves and the PRODUCT IS INVARIANT — any primitive whose two
    # dimensions are both multiples of 64 in a power-of-two ratio scores identically under both
    # formulas. 1088 breaks the symmetry precisely because ceil(1088/64) = 17 is just past a power of
    # two. This is the same trap the comment above already records falling into once; the tempting
    # "fix" both times is to weaken the validator.
    #
    # ⚠ AND THE ACCEPT HALF MUST BE THE ROW-MAJOR ARM OF THE SAME GEOMETRY, not some other shape. The
    # existing "nine 1-px columns" accept is passed by a validator that ignores the flag ENTIRELY
    # (144 waves col-major, 9216 row-major, both under the cap), so it cannot witness the swap.
    lw = 0;
    while (lw < 9) {
        ea_seed_prim(pb, lw, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 1024, 1088, 0, 0);
        lw = lw + 1;
    }
    pass = pass + ea_expect(&d, 0, "texl: nine 1024x1088 row-major are accepted", 43);
    lw = 0;
    while (lw < 9) {
        ea_seed_prim(pb, lw, 14, 0, 8, 8,
        GPU_TEX_FLAG_FULLCOV | GPU_TEX_FLAG_COLMAJOR, 1024, 1088, 0, 0);
        lw = lw + 1;
    }
    pass = pass + ea_expect(&d, GPO_E_WORK, "texl: the SAME nine col-major exceed the cap", 44);

    store32(&d + 24, 2);
    ea_seed_prim(pb, 0, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 16, 16, 0, 0);
    ea_seed_prim(pb, 1, 14, 0, 8, 8, GPU_TEX_FLAG_FULLCOV, 16, 16, 16, 0);

    # ⛔ ONE DISPATCH, ONE LANE AXIS — and the two directions are NOT interchangeable as tests.
    # This one mutates primitive [1] and leaves primitive [0] at the well-formed fixture, per the
    # doctrine above: a validator that sampled only the first entry would pass it. It is also the
    # DANGEROUS direction — a driver reading the mode from primitive 0 alone would dispatch
    # row-major and SILENTLY DISCARD primitive 1's flag, drawing a picture nobody asked for with no
    # error anywhere. The reverse direction at least disagrees loudly with itself.
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV | GPU_TEX_FLAG_COLMAJOR);
    pass = pass + ea_expect(&d, GPO_E_MIXMODE, "texl: a COLMAJOR primitive in a row-major list", 46);
    store32(pb + 0 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV | GPU_TEX_FLAG_COLMAJOR);
    pass = pass + ea_expect(&d, 0, "texl: an all-COLMAJOR list is accepted", 38);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV);
    pass = pass + ea_expect(&d, GPO_E_MIXMODE, "texl: a row-major primitive in a COLMAJOR list", 46);
    store32(pb + 0 * GPU_TEX_PRIM_BYTES + 20, GPU_TEX_FLAG_FULLCOV);

    # ⛔ THE FAR END OF THE RESERVED TAIL. +72 was the only dword ever checked; +76..+92 were accepted
    # and ignored, which is the one thing an extension point must never do. Mutating +92 rather than
    # +72 is the whole point — a loop that checked only the first dword passes every test anyone
    # would think to write. Primitive [1] again, never [0].
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 92, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: reserved dword +92 must be zero", 37);
    store32(pb + 1 * GPU_TEX_PRIM_BYTES + 92, 0);

    store32(&d +  4, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: header flags must be zero", 31);
    store32(&d +  4, 0);
    store32(&d +  8, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "texl: reserved dword must be zero", 33);
    store32(&d +  8, 0);

    # ⛔ TEARDOWN GOES LAST, AFTER EVERY BATTERY. It used to sit between the 0x08 and 0x0A blocks,
    # so the 0x0A cases ran against slots that had already been zeroed and a well-formed batch was
    # rejected with GPO_E_TRILIST -- a REAL reject for an UNREAL reason, which is the worst kind of
    # red because the code under test was fine.
    # Restore. A selftest that leaves the shm table dirty would hand the next allocation a slot that
    # LOOKS taken, and the symptom would surface far from here as "shm_create returns -1 under load".
    var r = 10;
    while (r < 16) {
        store64(&shm_phys + r * 8, 0); store64(&shm_mc + r * 8, 0); store64(&shm_size + r * 8, 0);
        store64(&shm_kva + r * 8, 0);
        r = r + 1;
    }

    # ---- op 0x0D DEPTH_CLEAR (rung 17, 1.56.30) ------------------------------------------------
    # ⛔ THE OP IS MINTED WITH ITS WORKER, so these are ACCEPT cases, not GPO_E_NOTIMPL ones. What is
    # being proven here is the ABI surface only; whether the region is actually free is rung 6's
    # audit, evaluated at arm time on real hardware.
    kprint("edge-abi: ---- #92 op 0x0D DEPTH_CLEAR ABI battery ----\n", 56);
    var dz = 0;
    while (dz < 16) { store32(&d + dz * 4, 0); dz = dz + 1; }
    store32(&d +  0, GPU_OP_DEPTH_CLEAR);
    store32(&d +  8, 0);                          # z_handle 0
    store32(&d + 16, (600 * 65536) + 800);        # 800x600
    store32(&d + 24, 0xFFFFFFFF);                 # clear value
    pass = pass + ea_expect(&d, 0, "depth: well-formed 800x600 clear is accepted", 44);

    store32(&d +  8, GPU_RT_HANDLES - 1);
    pass = pass + ea_expect(&d, 0, "depth: the LAST handle is accepted", 34);
    store32(&d +  8, GPU_RT_HANDLES);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "depth: handle one past the last is refused", 42);
    store32(&d +  8, 0);

    store32(&d + 16, (600 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "depth: zero width", 17);
    store32(&d + 16, (0 * 65536) + 800);
    pass = pass + ea_expect(&d, GPO_E_DIM, "depth: zero height", 18);

    # ⭐ THE BOUND IS PER-HANDLE, NOT PER-REGION, and this is the case that proves it. 4096x2048x4 is
    # 32 MB exactly -- the whole handle -- so 4096x2049 overruns into the NEXT handle while still
    # sitting comfortably inside the 256 MB region. A region-sized check would accept it and the
    # corruption would surface in an unrelated buffer.
    store32(&d + 16, (2048 * 65536) + 4096);
    pass = pass + ea_expect(&d, 0, "depth: 4096x2048 fills one handle exactly", 41);
    store32(&d + 16, (2049 * 65536) + 4096);
    pass = pass + ea_expect(&d, GPO_E_SLOTSIZE, "depth: one row past the handle is refused", 41);
    store32(&d + 16, (600 * 65536) + 800);

    # ⛔ dstxy is NOT defined by this op. Accepting and ignoring it is the failure the flags/field
    # vocabulary exists to prevent -- a depth handle's origin IS (0,0).
    store32(&d + 20, (16 * 65536) + 16);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "depth: dstxy set (undefined for this op)", 40);
    store32(&d + 20, 0);

    # And the op must be REACHABLE at all -- 0x0D was free until this cut, so a stale GPU_OP_SUPPORTED
    # would answer GPO_E_BADOP for every case above and they would all fail together, loudly.
    store32(&d +  4, 0x01);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "depth: unknown flag bit", 23);
    store32(&d +  4, 0);

    # ---- op 0x0E TRI_DEPTH (rung 17, 1.56.30) --------------------------------------------------
    # ⛔ THE WELL-FORMED CASES EXPECT GPO_E_NOTIMPL, NOT 0, AND THAT IS THE POINT OF THE BITE. The ABI
    # is complete; tri_depth.s and gpu_tri_depth() are not. The op is therefore validator-REACHABLE
    # (so every rule below is exercised through the real dispatch, not through a test-only back door)
    # and subtracted from what #89 advertises, so ring 3 is never told it works. Precedent is rung
    # 15's bilinear flag, whose case moved from ea_expect(NOTIMPL) to ea_expect_valid in the SAME
    # change that added the blob. ⇒ WHEN THE WORKER LANDS these move together with
    # GPU_OP_NOTIMPL_MASK bit 14, or the mask becomes a lie.
    kprint("edge-abi: ---- #92 op 0x0E TRI_DEPTH ABI battery ----\n", 54);

    # ⛔⛔ RE-SEED. The shm table was TORN DOWN a few lines above, before the 0x0D battery -- which
    # needs no slots and so never noticed. 0x0E needs four, and without this every slot-using case
    # comes back GPO_E_TRILIST or GPO_E_DSTSLOT: **a real reject for an unreal reason**, and worse,
    # the two cases that EXPECT DSTSLOT would pass for the wrong reason and hide it. That is the
    # failure mode the restore loop's own comment names, arriving from the other direction.
    # ⚠ Measured, not guessed: the first run of this battery came back 118/127 with exactly that
    # signature -- nine `got 24`/`got 17` on the slot-using cases and green on every case that
    # rejects before the slot lookup.
    # ⚠ SLOT IDS ARE 1-BASED (shm_slot_valid: slot = id - 1), so id N is index N-1.
    store64(&shm_phys + 12 * 8, 1); store64(&shm_mc + 12 * 8, 0);      store64(&shm_size + 12 * 8, 256);
    store64(&shm_kva  + 12 * 8, &eabi_edges);      # id 13 — mc == 0, the PMM-backed witness case
    store64(&shm_phys + 13 * 8, 1); store64(&shm_mc + 13 * 8, 0x1000); store64(&shm_size + 13 * 8, 256);
    store64(&shm_kva  + 13 * 8, &eabi_edges);      # id 14 — the vertex slot, room for 5 records
    store64(&shm_phys + 14 * 8, 1); store64(&shm_mc + 14 * 8, 0x2000); store64(&shm_size + 14 * 8, 4096);
    store64(&shm_kva  + 14 * 8, &eabi_edges);      # id 15 — a witness slot big enough for one tile
    store64(&shm_phys + 15 * 8, 1); store64(&shm_mc + 15 * 8, 0x3000); store64(&shm_size + 15 * 8, 16);
    store64(&shm_kva  + 15 * 8, &eabi_edges);      # id 16 — 16 B, too small for anything

    # a vertex slot with ONE well-formed triangle: 48 B, inside id 14's 256
    vb = &eabi_edges;                              # reuse: this function is at its local cap
    vz = 0;
    while (vz < 24) { store32(vb + vz * 4, 0); vz = vz + 1; }
    store32(vb +  0, 0);            store32(vb +  4, 0);
    store32(vb +  8, 32 * 65536);   store32(vb + 12, 0);
    store32(vb + 16, 0);            store32(vb + 20, 32 * 65536);
    store32(vb + 24, 100);          store32(vb + 28, 900);      store32(vb + 32, 100);
    store32(vb + 36, 0xFFFF0000);

    L1 = 0; while (L1 < 16) { store32(&d + L1 * 4, 0); L1 = L1 + 1; }
    store32(&d +  0, GPU_OP_TRI_DEPTH);
    store32(&d +  8, 0);                          # z_handle 0
    store32(&d + 12, 14);                         # vtx slot
    store32(&d + 16, (32 * 65536) + 32);          # 32x32 draw rect
    store32(&d + 24, 1);                          # n_tris
    store32(&d + 28, (64 * 65536) + 64);          # 64x64 depth extent
    pass = pass + ea_expect(&d, 0, "tridepth: well-formed record is accepted", 40);

    store32(&d +  8, GPU_RT_HANDLES - 1);
    pass = pass + ea_expect(&d, 0, "tridepth: the LAST depth handle is accepted", 43);
    store32(&d +  8, GPU_RT_HANDLES);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "tridepth: handle one past the last is refused", 45);
    store32(&d +  8, 0);

    # ⭐ THE ALIGNMENT RULE, which is what lets the shader run with exec == -1 throughout.
    store32(&d + 16, (32 * 65536) + 12);
    pass = pass + ea_expect(&d, GPO_E_ALIGN, "tridepth: width not a multiple of the tile", 42);
    store32(&d + 16, (32 * 65536) + 32);
    store32(&d + 20, (0 * 65536) + 4);
    pass = pass + ea_expect(&d, GPO_E_ALIGN, "tridepth: dstxy not a multiple of the tile", 42);
    store32(&d + 20, 0);

    store32(&d + 16, (32 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "tridepth: zero width", 20);
    store32(&d + 16, (32 * 65536) + 32);
    store32(&d + 28, 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "tridepth: zero depth extent", 27);
    store32(&d + 28, (64 * 65536) + 64);

    # ⚠ TWO rects, and the draw rect must fit BOTH. A depth extent smaller than the draw rect would
    # let the shader index past the handle even though the rect is on-screen.
    store32(&d + 28, (16 * 65536) + 16);
    pass = pass + ea_expect(&d, GPO_E_BOUNDS, "tridepth: draw rect exceeds the depth extent", 44);
    store32(&d + 28, (64 * 65536) + 64);

    # ⛔ PER-HANDLE, NOT PER-REGION — the same fact gpo_validate_depthclear carries.
    store32(&d + 28, (2049 * 65536) + 4096);
    pass = pass + ea_expect(&d, GPO_E_SLOTSIZE, "tridepth: depth extent one row past a handle", 44);
    store32(&d + 28, (64 * 65536) + 64);

    store32(&d + 24, 0);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "tridepth: zero triangles", 24);
    store32(&d + 24, GPU_TRID_LIST_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "tridepth: triangle count above the cap", 38);
    store32(&d + 24, 1);

    # ⚠ SLOT IDS ARE 1-BASED (shm_slot_valid: slot = id - 1). At this point in the battery id 14 is
    # 256 B (room for 5 records), id 15 is 4096 B, id 16 is 16 B -- room for none. ⛔ The neighbouring
    # 0x0A cases carry comments naming the wrong sizes for these ids and still pass, for a different
    # reason than they claim; every id here was re-derived from the seeding block, not copied.
    store32(&d + 12, 16);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "tridepth: vertex slot too small for one record", 46);
    store32(&d + 12, 14);

    # ⚠ THE FAR RESERVED DWORD, not just the near one. Rung 14's +92 case exists because +72 was the
    # only one ever tested.
    store32(vb + 44, 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "tridepth: per-triangle FAR reserved dword non-zero", 50);
    store32(vb + 44, 0);

    store32(vb +  8, 268435457);                   # +2^28 + 1, one past the coordinate window
    pass = pass + ea_expect(&d, GPO_E_COORD, "tridepth: coordinate outside the ABI window", 43);
    store32(vb +  8, 32 * 65536);

    # ⛔ SUB-PIXEL IS A REJECT. The proven domain is doubled INTEGERS; quantising kernel-side would
    # accept the request and answer a different one.
    store32(vb +  8, (32 * 65536) + 1);
    pass = pass + ea_expect(&d, GPO_E_SUBPIXEL, "tridepth: coordinate with fraction bits set", 43);
    store32(vb +  8, 32 * 65536);

    # ⭐⭐ THE CORNER BOUND. Every z here is at the ABI ceiling, so this record passes the coordinate
    # window, the per-vertex z rule AND the area bounds -- and still overflows the 32-bit lane the
    # shader evaluates zn in, because the shader is PREDICATED and computes zn on every lane of the
    # tile including far outside the triangle. An inside-only bound is a bound over a domain the
    # shader does not run on. Derived: this triangle's area is 4*cross = 4096 in doubled units, so
    # zn = 4096 * 16777215 = 6.87e10, thirty-two times past the lane.
    store32(vb + 24, GPU_TRID_Z_MAX);
    store32(vb + 28, GPU_TRID_Z_MAX);
    store32(vb + 32, GPU_TRID_Z_MAX);
    pass = pass + ea_expect(&d, GPO_E_ZRANGE, "tridepth: legal z but the corner bound overflows", 48);
    store32(vb + 24, 100); store32(vb + 28, 900); store32(vb + 32, 100);

    store32(vb +  8, 0);   store32(vb + 20, 0);    # collapse the triangle to a line
    pass = pass + ea_expect(&d, GPO_E_AREA, "tridepth: degenerate triangle would divide by zero", 50);
    store32(vb +  8, 32 * 65536);  store32(vb + 20, 32 * 65536);

    # ⭐ The witness slot is a FIRST-CLASS field, so it gets first-class rules. id 12 has mc == 0,
    # i.e. PMM-backed and unreachable by the GPU; id 15 is 16 B, far too small for the lane words.
    store32(&d + 32, 13);                          # id 13 has mc == 0
    pass = pass + ea_expect(&d, GPO_E_DSTSLOT, "tridepth: witness slot is PMM-backed", 36);
    store32(&d + 32, 16);                          # id 16 is 16 B; 16 tiles need 8192
    pass = pass + ea_expect(&d, GPO_E_DSTSLOT, "tridepth: witness slot too small for the lane words", 51);
    store32(&d + 32, 0);

    store32(&d +  4, 0x01);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tridepth: unknown flag bit", 26);
    store32(&d +  4, 0);
    store32(&d + 60, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "tridepth: reserved dword 15 non-zero", 36);
    store32(&d + 60, 0);

    # ---- a SMALL frame, because the corner bound and the z ceiling INTERACT --------------------
    # ⛔⛔ MEASURED WHILE WRITING THESE CASES, AND IT CHANGES WHAT `GPU_TRID_Z_MAX` MEANS. On the
    # 32x32 record above, `zn` at a rect corner is `area * z` = 4096*z, so ANY z above ~524,000 fails
    # the corner bound -- the ceiling of 2^24-1 is unreachable there and the two rules cannot be told
    # apart. ⇒ `GPU_TRID_Z_MAX` is NECESSARY BUT NOT SUFFICIENT; the corner bound is the binding
    # constraint at any useful rect size, and a caller who reads only the z ceiling will be surprised.
    # ⇒ To witness the ceiling rule ON ITS OWN, shrink until the corner bound has slack: a 4-px
    # triangle in an 8x8 rect has area 64, so `zn = 64 * (2^24-1) = 1.07e9`, comfortably inside the
    # lane -- and `z = 2^24` is STILL inside it, so only the ceiling rule can fire. Without this
    # geometry the "one past the ceiling" case would pass even if the ceiling rule did not exist.
    store32(&d + 16, (8 * 65536) + 8);
    store32(vb +  8, 4 * 65536);   store32(vb + 12, 0);
    store32(vb + 16, 0);           store32(vb + 20, 4 * 65536);
    store32(vb + 24, GPU_TRID_Z_MAX);
    store32(vb + 28, GPU_TRID_Z_MAX);
    store32(vb + 32, GPU_TRID_Z_MAX);
    pass = pass + ea_expect(&d, 0, "tridepth: z at the ABI ceiling is legal on a small rect", 55);
    store32(vb + 28, GPU_TRID_Z_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_ZRANGE, "tridepth: z one past the ceiling, corner bound still slack", 58);
    store32(vb + 28, GPU_TRID_Z_MAX);

    # and the witness slot ACCEPTED -- one tile needs 64*2*4 = 512 B, and id 15 holds 4096.
    # ⚠ An all-reject battery for a field proves the rejects work and never that the field is usable.
    store32(&d + 32, 15);
    pass = pass + ea_expect(&d, 0, "tridepth: a well-formed witness slot is accepted", 48);
    store32(&d + 32, 0);

    # ---- op 0x10 RT_READ (rung 17, 1.56.30) ----------------------------------------------------
    # ⛔ THESE ARE **ACCEPT** CASES, NOT NOTIMPL ONES. 0x10 is minted WITH its worker, so it is not in
    # GPU_OP_NOTIMPL_MASK and `#89` advertises it. ⚠ A well-formed record returns GPO_E_ARM here
    # rather than 0, because there is no GPU under QEMU and rung 6's audit cannot have passed — the
    # same answer op 0x0D's worker gives, and an arming fact rather than a dispatch failure.
    kprint("edge-abi: ---- #92 op 0x10 RT_READ ABI battery ----\n", 52);
    L1 = 0; while (L1 < 16) { store32(&d + L1 * 4, 0); L1 = L1 + 1; }
    store32(&d +  0, GPU_OP_RT_READ);
    store32(&d +  8, 0);                          # z_handle 0
    store32(&d + 12, 15);                         # dst slot: id 15, mc 0x2000, 4096 B
    store32(&d + 16, (16 * 65536) + 16);          # 16x16 readback = 1024 B, fits
    store32(&d + 28, (64 * 65536) + 64);          # 64x64 source extent
    # ⚠ 0, not GPO_E_ARM. `ea_expect` calls gpo_validate, NOT gpo_execute -- the arm refusal lives
    # in the worker and this battery never reaches it. Same shape as op 0x0D's accept case.
    pass = pass + ea_expect(&d, 0, "rtread: well-formed readback is accepted", 40);

    store32(&d +  8, GPU_RT_HANDLES);
    pass = pass + ea_expect(&d, GPO_E_BADSLOT, "rtread: handle one past the last is refused", 43);
    store32(&d +  8, 0);

    store32(&d + 16, (16 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "rtread: zero width", 18);
    store32(&d + 16, (16 * 65536) + 16);

    # the readback rect starts at the handle's ORIGIN, so it need only fit the source extent
    store32(&d + 28, (8 * 65536) + 8);
    pass = pass + ea_expect(&d, GPO_E_BOUNDS, "rtread: rect larger than the source extent", 42);
    store32(&d + 28, (64 * 65536) + 64);

    store32(&d + 28, (2049 * 65536) + 4096);
    pass = pass + ea_expect(&d, GPO_E_SLOTSIZE, "rtread: source extent one row past a handle", 43);
    store32(&d + 28, (64 * 65536) + 64);

    store32(&d + 12, 13);                         # id 13 has mc == 0
    pass = pass + ea_expect(&d, GPO_E_DSTSLOT, "rtread: destination slot is PMM-backed", 38);
    store32(&d + 12, 16);                         # id 16 is 16 B; 16x16 needs 1024
    pass = pass + ea_expect(&d, GPO_E_SLOTSIZE, "rtread: destination slot too small for the rect", 47);
    store32(&d + 12, 15);

    # ⛔ dstxy is NOT defined by this op -- a handle's origin IS (0,0), same as EDGE_COV and 0x0D.
    store32(&d + 20, (16 * 65536) + 16);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "rtread: dstxy set (undefined for this op)", 41);
    store32(&d + 20, 0);
    store32(&d +  4, 0x01);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "rtread: unknown flag bit", 24);
    store32(&d +  4, 0);

    # ---- op 0x0F TRI_PERSP (rung 18) -----------------------------------------------------------
    # ⛔ WELL-FORMED CASES EXPECT GPO_E_NOTIMPL. The ABI is complete; the shader is not. Bit 15 sits in
    # GPU_OP_NOTIMPL_MASK so #89 does not advertise it, exactly the mechanism rung 17 built for 0x0E.
    # ⭐ EVERY REJECT BELOW POINTS AT A RULE THAT CAME FROM A HOST MEASUREMENT, not from a plan row.
    kprint("edge-abi: ---- #92 op 0x0F TRI_PERSP ABI battery ----\n", 54);
    vb = &eabi_edges;
    vz = 0;
    while (vz < 16) { store32(vb + vz * 4, 0); vz = vz + 1; }
    # one well-formed triangle: 3 x (x, y, w, u, v) then a reserved dword
    store32(vb +  0, 0);            store32(vb +  4, 0);
    store32(vb +  8, 1024);         store32(vb + 12, 0);          store32(vb + 16, 0);
    store32(vb + 20, 16 * 65536);   store32(vb + 24, 0);
    store32(vb + 28, 1024);         store32(vb + 32, 16 * 65536); store32(vb + 36, 0);
    store32(vb + 40, 0);            store32(vb + 44, 16 * 65536);
    store32(vb + 48, 1024);         store32(vb + 52, 0);          store32(vb + 56, 16 * 65536);
    store32(vb + 60, 0);

    L1 = 0; while (L1 < 16) { store32(&d + L1 * 4, 0); L1 = L1 + 1; }
    store32(&d +  0, GPU_OP_TRI_PERSP);
    store32(&d +  8, 14);                         # texture slot
    store32(&d + 12, 14);                         # vertex slot
    store32(&d + 16, (16 * 65536) + 16);          # 16x16 draw rect, both multiples of 8
    store32(&d + 24, 1);                          # n_tris
    store32(&d + 28, (8 * 65536) + 8);            # 8x8 texture
    pass = pass + ea_expect(&d, 0, "persp: well-formed record is accepted", 37);

    store32(&d + 16, (16 * 65536) + 12);
    pass = pass + ea_expect(&d, GPO_E_ALIGN, "persp: width not a multiple of the tile", 39);
    store32(&d + 16, (16 * 65536) + 16);
    store32(&d + 16, (16 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_DIM, "persp: zero width", 17);
    store32(&d + 16, (16 * 65536) + 16);

    store32(&d + 28, (8 * 65536) + 0);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "persp: zero texture width", 25);
    # ⭐ the shader masks with w-1/h-1 on every fetch, so a non-power-of-two texture reads the WRONG
    # TEXEL rather than wrapping. This rule was missing when the validator first landed.
    store32(&d + 28, (8 * 65536) + 6);
    pass = pass + ea_expect(&d, GPO_E_TEXDIM, "persp: texture width not a power of two", 39);
    store32(&d + 28, (8 * 65536) + 8);

    store32(&d + 24, 0);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "persp: zero triangles", 21);
    store32(&d + 24, GPU_TPER_LIST_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "persp: triangle count above the cap", 35);
    store32(&d + 24, 1);

    store32(vb + 60, 1);
    pass = pass + ea_expect(&d, GPO_E_TRILIST, "persp: per-triangle reserved dword non-zero", 43);
    store32(vb + 60, 0);

    store32(vb + 20, (16 * 65536) + 1);
    pass = pass + ea_expect(&d, GPO_E_SUBPIXEL, "persp: coordinate with fraction bits set", 40);
    store32(vb + 20, 16 * 65536);

    # ⭐⭐ THE w BAND -- the rule that exists because two host probes disagreed on nothing but the w
    # scale, and the smaller one put the denominator past its lane on every pixel.
    store32(vb +  8, GPU_TPER_W_MIN - 1);
    pass = pass + ea_expect(&d, GPO_E_WRANGE, "persp: w one below the floor", 28);
    store32(vb +  8, GPU_TPER_W_MIN);
    pass = pass + ea_expect(&d, 0, "persp: w exactly at the floor is legal", 38);
    store32(vb +  8, GPU_TPER_W_MAX + 1);
    pass = pass + ea_expect(&d, GPO_E_WRANGE, "persp: w one above the ceiling", 30);
    store32(vb +  8, 1024);

    # ⭐⭐ THE DENOMINATOR BOUND -- the rule that exists because "D fits a 32-bit lane" was FALSIFIED on
    # the host at 2^33. Every w at the floor plus a large draw rect drives D past a lane; the record is
    # otherwise entirely legal, which is the whole point.
    store32(vb +  8, GPU_TPER_W_MIN);
    store32(vb + 28, GPU_TPER_W_MIN);
    store32(vb + 48, GPU_TPER_W_MIN);
    store32(vb + 20, 2048 * 65536);   store32(vb + 44, 2048 * 65536);
    store32(&d + 16, (1024 * 65536) + 1024);
    pass = pass + ea_expect(&d, GPO_E_DRANGE, "persp: legal record whose D outgrows a 32-bit lane", 50);
    store32(&d + 16, (16 * 65536) + 16);
    store32(vb + 20, 16 * 65536);     store32(vb + 44, 16 * 65536);
    store32(vb +  8, 1024); store32(vb + 28, 1024); store32(vb + 48, 1024);

    store32(vb + 20, 0);   store32(vb + 44, 0);      # collapse to a line
    pass = pass + ea_expect(&d, GPO_E_AREA, "persp: degenerate triangle would divide by zero", 47);
    store32(vb + 20, 16 * 65536);  store32(vb + 44, 16 * 65536);

    store32(&d +  4, 0x01);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "persp: unknown flag bit", 23);
    store32(&d +  4, 0);
    store32(&d + 32, 1);
    pass = pass + ea_expect(&d, GPO_E_RESERVED, "persp: dword 8 is not defined for this op", 41);
    store32(&d + 32, 0);

    # Restore again, for the same reason the loop above does: a selftest that leaves the shm table
    # dirty hands the next allocation a slot that LOOKS taken, and the symptom surfaces far from here.
    r = 10;
    while (r < 16) {
        store64(&shm_phys + r * 8, 0); store64(&shm_mc + r * 8, 0); store64(&shm_size + r * 8, 0);
        store64(&shm_kva + r * 8, 0);
        r = r + 1;
    }

    kprint("edge-abi: ", 10); kprint_num(pass); kprint(" of 152 cases correct\n", 22);
    if (pass == 152) {
        kprint("edge-abi: PASS -- the 0x08..0x0F and 0x10 ABIs reject every malformed record,\n", 78);
        kprint("edge-abi: record,\n", 18);
        kprint("edge-abi: and a well-formed one is accepted or correctly reports no-GPU.\n", 73);
        return 1;
    }
    kprint("edge-abi: FAIL -- see the named case(s) above\n", 46);
    return 0;
}
#endif

# gpo_validate_depthclear — op 0x0D. Validates on its OWN terms, like EDGE_COV: the generic tail
# assumes "one source slot sized by w*h, one framebuffer destination at dstxy", and this op has none
# of those three. Running it through the generic path would bounds-check a depth buffer against the
# screen, which is meaningless.
fn gpo_validate_depthclear(rec) {
    var zh = load32(rec + 8) & 0xFFFFFFFF;
    if (zh >= GPU_RT_HANDLES) { return GPO_E_BADSLOT; }
    var wh = load32(rec + 16) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    # ⛔ BOUND AGAINST ONE HANDLE, NOT THE WHOLE REGION. A rect that fits 256 MB but overruns a 32 MB
    # handle would scribble on the NEXT handle, and the symptom would appear in an unrelated buffer.
    # ⚠ 32-bit Z, so 4 bytes per sample — the same figure gpu_depth_clear uses. Two sites, one fact:
    # if the depth format ever changes, both move or the validator starts blessing overruns.
    if (w * 4 * h > GPU_RT_HANDLE_SIZE) { return GPO_E_SLOTSIZE; }
    return 0;
}

# ============================================================================================
# gpo_validate_tridepth(rec, fbw, fbh) — op 0x0E. RUNG 17's validator.
# ============================================================================================
# Validates on its OWN terms, like EDGE_COV and DEPTH_CLEAR: the generic tail assumes "one source
# slot sized by w*h, one framebuffer destination at dstxy", and it would bounds-check a DEPTH buffer
# against the screen. This op has two rects (a draw rect and a depth extent) and they are not the
# same thing.
#
# ⛔ THE OP IS A **REPLACE**, NOT A COMPOSITE, and the ABI should say so where a reader will find it:
# 0x0E initialises colour to bg and z to zclear IN REGISTERS and stores unconditionally, so it
# ERASES its wh rect. It never reads the render target and never reads the depth buffer. Two
# consequences: 0x0D is NOT a prerequisite of 0x0E (the shader clears in-register), and N 0x0E
# records CANNOT share one depth buffer in v1.
#
# ⭐ The far value is NOT in this record. It comes from the header the kernel builds in prep, and the
# rule it must satisfy — `>= GPU_TRID_ZCLEAR_MIN` — is a prep assertion, because the depth compare is
# UNSIGNED and every far value must sit behind every legal z.
fn gpo_validate_tridepth(rec, fbw, fbh) {
    # flags: the generic loop in gpo_validate already rejects any non-zero bit, because
    # gpo_flags_known(0x0E) falls through to GPU_OP_FLAGS_KNOWN = 0. Not restated here — one site.
    var zh = load32(rec + 8) & 0xFFFFFFFF;
    if (zh >= GPU_RT_HANDLES) { return GPO_E_BADSLOT; }

    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var zwh = load32(rec + 28) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    var zw = zwh & 0xFFFF;
    var zhh = (zwh >> 16) & 0xFFFF;
    if (w < 1)   { return GPO_E_DIM; }
    if (h < 1)   { return GPO_E_DIM; }
    if (zw < 1)  { return GPO_E_DIM; }
    if (zhh < 1) { return GPO_E_DIM; }

    # ⭐⭐ THE ALIGNMENT RULE IS WHAT KEEPS `exec == -1` FOR THE WHOLE SHADER. With every extent a
    # multiple of the 8x8 tile there is no partial tile, so the kernel needs no bounds guard and never
    # writes exec. ⛔ Both halves of that matter: without the rule the last tile row stores PAST the
    # back buffer and VM_CONTEXT0 is disabled, so the write lands somewhere real; with a prologue
    # guard instead, every edge tile shows lane dropouts that are byte-identical to the S1
    # register-aliasing signature the lane witness exists to detect.
    if ((w  & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((h  & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((dx & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((dy & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }

    if (dx + w > fbw) { return GPO_E_BOUNDS; }        # REJECT off-screen; the compositor owns clipping
    if (dy + h > fbh) { return GPO_E_BOUNDS; }
    if (dx + w > zw)  { return GPO_E_BOUNDS; }        # ...and the draw rect must fit the DEPTH extent
    if (dy + h > zhh) { return GPO_E_BOUNDS; }

    # ⛔ BOUND AGAINST ONE HANDLE, NOT THE WHOLE REGION — the same fact gpo_validate_depthclear and
    # gpu_depth_clear carry. 4096x2048x4 is one handle exactly; 4096x2049 overruns into the NEXT
    # handle while sitting comfortably inside the 256 MB region, and the corruption then surfaces in
    # an unrelated buffer. Three sites, one fact: if the depth format changes, all three move.
    if (zw * 4 * zhh > GPU_RT_HANDLE_SIZE) { return GPO_E_SLOTSIZE; }

    var nt = load32(rec + 24) & 0xFFFFFFFF;
    if (nt < 1) { return GPO_E_TRILIST; }
    if (nt > GPU_TRID_LIST_MAX) { return GPO_E_TRILIST; }

    # ⚠ THE WORK UNIT IS TILE x TRIANGLE. Every tile walks the WHOLE list (TD-5: no binning pass), so
    # cost is tiles times triangles, not pixels times edges. gpo_validate_trilist's w*h*nt*3 bound
    # would be off by the tile area and would mean nothing here.
    var tiles = (w >> 3) * (h >> 3);
    if (tiles * nt > GPU_TRID_WORK_MAX) { return GPO_E_WORK; }

    # ⭐ The lane witness writes into a RING-3-NAMED slot, exactly as op 0x09's destination mask does,
    # and is resolved the same way. ⚠ shm_mc, not shm_kva: the GPU writes this one, and a PMM-backed
    # slot has no MC address the GPU can reach.
    var wid = load32(rec + 32) & 0xFFFFFFFF;
    if (wid != 0) {
        if (shm_slot_valid(wid) == 0) { return GPO_E_DSTSLOT; }
        var wslot = wid - 1;
        if (load64(&shm_mc + wslot * 8) == 0) { return GPO_E_DSTSLOT; }
        if (load64(&shm_size + wslot * 8) < tiles * 64 * 2 * 4) { return GPO_E_DSTSLOT; }
    }

    var vid = load32(rec + 12) & 0xFFFFFFFF;
    # ⚠ shm_kva, not shm_mc: the KERNEL reads these bytes to build the prep record. The GPU never
    # touches the vertex slot at all.
    if (shm_slot_valid(vid) == 0) { return GPO_E_TRILIST; }
    var vslot = vid - 1;
    if (load64(&shm_size + vslot * 8) < nt * GPU_TRID_VTX_BYTES) { return GPO_E_TRILIST; }
    var vkva = load64(&shm_kva + vslot * 8);
    if (vkva == 0) { return GPO_E_TRILIST; }

    # ---- the four corners of the DRAW RECT, as doubled sample points ----------------------------
    # ⭐⭐ CORNERS, NOT INSIDE PIXELS, AND THE DIFFERENCE IS MEASURED. w0/w1/w2 and zn are all affine
    # in (x, y), so their extremes over a rectangle lie at its corners. The shader is PREDICATED, not
    # branched, so it evaluates every one of them on EVERY lane of the tile including far outside the
    # triangle — a bound derived over inside pixels is a bound over a domain the shader does not run
    # on. An attacker's triangle at (700,500), 8x8 px, z in [0, 8000000] passes a coordinate check, a
    # z check AND a zmax*4*cross check, yet peaks at |zn| = 3.264e9 over its own bounding box: 1.52x
    # past a 32-bit lane, wrong at 25 of its 81 pixels.
    # ⚠ depthgate's D8 proves the shortcut itself — corner maximum == brute-force whole-rect maximum.
    var qx0 = 2 * dx + 1;
    var qx1 = 2 * (dx + w - 1) + 1;
    var qy0 = 2 * dy + 1;
    var qy1 = 2 * (dy + h - 1) + 1;

    var i = 0;
    while (i < nt) {
        var b = vkva + i * GPU_TRID_VTX_BYTES;
        # ⚠ PROBE THE FAR DWORD TOO. Rung 14's +92 case exists because +72 was the only one ever
        # tested, and the reserved tail is the forward-compatibility guarantee: a v1 caller physically
        # cannot ship garbage where a future kernel will read a field.
        if ((load32(b + 40) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }
        if ((load32(b + 44) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }

        var f = 0;
        while (f < 6) {
            var cv = gpo_i32(b + f * 4);
            if (gpo_coord_bad(cv) == 1) { return GPO_E_COORD; }
            # ⛔ REJECT SUB-PIXEL, do not quantise it. The reference and the model prove this
            # arithmetic in the doubled-INTEGER domain only; accepting arbitrary 16.16 and rounding
            # kernel-side would accept a request and silently answer a different one.
            if ((cv & 0xFFFF) != 0) { return GPO_E_SUBPIXEL; }
            f = f + 1;
        }

        var ax = gpo_i32(b +  0) >>> 16;  var ay = gpo_i32(b +  4) >>> 16;
        var bx = gpo_i32(b +  8) >>> 16;  var by = gpo_i32(b + 12) >>> 16;
        var cx = gpo_i32(b + 16) >>> 16;  var cy = gpo_i32(b + 20) >>> 16;
        # ⛔ GPU_TRI_AREA_MIN IS THE ONLY THING BETWEEN A RING-3 RECORD AND A KERNEL #DE. Prep
        # computes `R = 4294967296 / area` for the shader's reciprocal, and area == 0 divides by zero
        # in the KERNEL. Rejecting a degenerate triangle here is a memory-safety rule, not a quality one.
        var cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
        if (cross < 0) { cross = 0 - cross; }
        var a2 = cross << 16;
        if (a2 < GPU_TRI_AREA_MIN) { return GPO_E_AREA; }
        if (a2 > GPU_TRI_AREA_MAX) { return GPO_E_AREA; }

        var z0 = load32(b + 24) & 0xFFFFFFFF;
        var z1 = load32(b + 28) & 0xFFFFFFFF;
        var z2 = load32(b + 32) & 0xFFFFFFFF;
        # unsigned fields, so a negative z is unrepresentable and only the ceiling needs a rule
        if (z0 > GPU_TRID_Z_MAX) { return GPO_E_ZRANGE; }
        if (z1 > GPU_TRID_Z_MAX) { return GPO_E_ZRANGE; }
        if (z2 > GPU_TRID_Z_MAX) { return GPO_E_ZRANGE; }

        # doubled vertices — the domain depthcore/depthmodel prove, where the +0.5 pixel centre is
        # exact in integers
        var dax = 2 * ax; var day = 2 * ay;
        var dbx = 2 * bx; var dby = 2 * by;
        var dcx = 2 * cx; var dcy = 2 * cy;
        var k = 0;
        while (k < 4) {
            var qx = qx0; var qy = qy0;
            if (k == 1) { qx = qx1; qy = qy0; }
            if (k == 2) { qx = qx0; qy = qy1; }
            if (k == 3) { qx = qx1; qy = qy1; }
            # the three edge functions, w_i opposing vertex i, and the depth numerator
            var e0 = (dcx - dbx) * (qy - dby) - (dcy - dby) * (qx - dbx);
            var e1 = (dax - dcx) * (qy - dcy) - (day - dcy) * (qx - dcx);
            var e2 = (dbx - dax) * (qy - day) - (dby - day) * (qx - dax);
            var zn = e0 * z0 + e1 * z1 + e2 * z2;
            if (gpo_lane_bad(e0) == 1) { return GPO_E_ZRANGE; }
            if (gpo_lane_bad(e1) == 1) { return GPO_E_ZRANGE; }
            if (gpo_lane_bad(e2) == 1) { return GPO_E_ZRANGE; }
            if (gpo_lane_bad(zn) == 1) { return GPO_E_ZRANGE; }
            k = k + 1;
        }
        i = i + 1;
    }

    # ⭐ ACCEPTED. tri_depth.s and gpu_tri_depth() landed with this line, and GPU_OP_NOTIMPL_MASK
    # cleared bit 14 in the same change — the accepted surface and the proven surface move together
    # or the mask is a lie. The worker still refuses with GPO_E_ARM where the render-target region is
    # not provably free on this boot, which is an arming fact, not an ABI one.
    return 0;
}

# ============================================================================================
# gpo_validate_rtread(rec) — op 0x10. The READBACK that makes rung 17's burn able to FAIL.
# ============================================================================================
# ⛔⛔ THIS OP IS BLOCKING FOR THE RUNG, NOT A CONVENIENCE, AND THE REASON IS MEASURED. On the
# shipped corpus a divide with its correction DROPPED gives order-diff 0, colour-vs-reference 0, and
# 19 wrong z; a uniform bias of any size 1..64 gives 0, 0, and 507-of-507 wrong z. Depth lives in a
# kernel-owned TD-3 handle that ring 3 cannot address and `#90` reads the framebuffer, so **without
# this op the iron burn cannot fail on a broken divide** — and the divide is rung 17's entire novel
# content. Op 0x0D could only ever be validated by timing because the arena is opaque; rung 17 must
# not inherit that blindness.
fn gpo_validate_rtread(rec) {
    var zh = load32(rec + 8) & 0xFFFFFFFF;
    if (zh >= GPU_RT_HANDLES) { return GPO_E_BADSLOT; }
    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var zwh = load32(rec + 28) & 0xFFFFFFFF;
    var w   = wh & 0xFFFF;
    var h   = (wh >> 16) & 0xFFFF;
    var zw  = zwh & 0xFFFF;
    var zhh = (zwh >> 16) & 0xFFFF;
    if (w < 1)   { return GPO_E_DIM; }
    if (h < 1)   { return GPO_E_DIM; }
    if (zw < 1)  { return GPO_E_DIM; }
    if (zhh < 1) { return GPO_E_DIM; }
    # the readback rect starts at the handle's origin, so it need only fit the handle's extent
    if (w > zw)  { return GPO_E_BOUNDS; }
    if (h > zhh) { return GPO_E_BOUNDS; }
    # ⛔ PER-HANDLE, NOT PER-REGION — the third site of the same fact (gpo_validate_depthclear,
    # gpo_validate_tridepth, here). A source extent that fits 256 MB but overruns this 32 MB handle
    # would read the NEXT handle's pixels and report them as this one's depth.
    if (zw * 4 * zhh > GPU_RT_HANDLE_SIZE) { return GPO_E_SLOTSIZE; }
    # ⚠ shm_MC, not shm_kva: the GPU writes this slot via CP-DMA. A PMM-backed slot has no MC address
    # the GPU can reach, which is the identical rule gpu_readback_shm_sys enforces for `#90`.
    var did = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(did) == 0) { return GPO_E_DSTSLOT; }
    var dslot = did - 1;
    if (load64(&shm_mc + dslot * 8) == 0) { return GPO_E_DSTSLOT; }
    if (w * 4 * h > load64(&shm_size + dslot * 8)) { return GPO_E_SLOTSIZE; }
    return 0;
}

# ============================================================================================
# gpo_validate_triperspec(rec, fbw, fbh) — op 0x0F. RUNG 18's validator.
# ============================================================================================
# ⭐ EVERY BOUND BELOW WAS MEASURED ON THE HOST BEFORE THIS FUNCTION EXISTED, which is the opposite of
# rung 17 — where four plan specifications were falsified during implementation and one of them (a
# kernel memcpy from an address 64 GB above the identity map) would have #PF'd on the first byte.
# The measurements live in tests/gpu/perspbits.cyr, perspdiv.cyr, perspgate.cyr and perspmodel.cyr.
#
# THE ARITHMETIC IT IS PROTECTING. Perspective-correct interpolation of an attribute `a`:
#     a_persp = [ SUM e_i * (W_i * a_i) ] / [ SUM e_i * W_i ]        with W_i = 2^K / w_i
# Both numerator and denominator are AFFINE in (x,y), so both hoist exactly like rung 17's depth
# numerator — and both therefore admit a four-corner bound, which is what rules 9 and 10 are.
fn gpo_validate_triperspec(rec, fbw, fbh) {
    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var twh = load32(rec + 28) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    var tw = twh & 0xFFFF;
    var th = (twh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }

    # ⭐ THE ALIGNMENT RULE, same as op 0x0E and for the same reason: with every extent a multiple of
    # the 8x8 tile there is no partial tile, so the shader needs no bounds guard and never writes exec.
    # ⚠ A prologue guard instead would forge the per-lane dropout signature a lane witness exists to
    # detect, and the burn would be spent telling the two apart.
    if ((w  & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((h  & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((dx & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if ((dy & (GPU_TILE - 1)) != 0) { return GPO_E_ALIGN; }
    if (dx + w > fbw) { return GPO_E_BOUNDS; }
    if (dy + h > fbh) { return GPO_E_BOUNDS; }

    # texture, on the same terms op 0x0B uses -- two sites, one fact
    if (tw < 1) { return GPO_E_TEXDIM; }
    if (th < 1) { return GPO_E_TEXDIM; }
    if (tw > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }
    if (th > GPU_TEX_MAX_DIM) { return GPO_E_TEXDIM; }
    # ⛔⛔ POWERS OF TWO ARE MANDATORY HERE, UNCONDITIONALLY -- and this rule was MISSING when the
    # validator first landed, because its texture checks were copied from op 0x0B where power-of-two is
    # required only under the WRAP flag. tri_persp.s masks the interpolated coordinate with `w-1` and
    # `h-1` on EVERY fetch, so a non-power-of-two texture does not wrap, it reads the WRONG TEXEL and
    # silently paints a plausible wrong picture. ⚠ Found by reading the shader against the validator
    # rather than by a burn; a reject, never a clamp, same doctrine as WRAP's.
    if ((tw & (tw - 1)) != 0) { return GPO_E_TEXDIM; }
    if ((th & (th - 1)) != 0) { return GPO_E_TEXDIM; }
    var tid = load32(rec + 8) & 0xFFFFFFFF;
    if (shm_slot_valid(tid) == 0) { return GPO_E_TEXSLOT; }
    var tslot = tid - 1;
    if (load64(&shm_kva + tslot * 8) == 0) { return GPO_E_TEXSLOT; }
    if (load64(&shm_size + tslot * 8) < tw * th * 4) { return GPO_E_TEXSLOT; }

    var nt = load32(rec + 24) & 0xFFFFFFFF;
    if (nt < 1) { return GPO_E_TRILIST; }
    if (nt > GPU_TPER_LIST_MAX) { return GPO_E_TRILIST; }
    var tiles = (w >> 3) * (h >> 3);
    if (tiles * nt > GPU_TRID_WORK_MAX) { return GPO_E_WORK; }

    var vid = load32(rec + 12) & 0xFFFFFFFF;
    if (shm_slot_valid(vid) == 0) { return GPO_E_TRILIST; }
    var vslot = vid - 1;
    if (load64(&shm_size + vslot * 8) < nt * GPU_TPER_VTX_BYTES) { return GPO_E_TRILIST; }
    var vkva = load64(&shm_kva + vslot * 8);
    if (vkva == 0) { return GPO_E_TRILIST; }

    # the four corners of the DRAW RECT, as doubled sample points -- the same domain the reference and
    # the register-width model prove, where a pixel centre is the exact integer 2*px + 1
    var qx0 = 2 * dx + 1;
    var qx1 = 2 * (dx + w - 1) + 1;
    var qy0 = 2 * dy + 1;
    var qy1 = 2 * (dy + h - 1) + 1;

    var i = 0;
    while (i < nt) {
        var b = vkva + i * GPU_TPER_VTX_BYTES;
        if ((load32(b + 60) & 0xFFFFFFFF) != 0) { return GPO_E_TRILIST; }

        # ---- coordinates: the ABI window, and INTEGER pixels only -------------------------------
        var f = 0;
        while (f < 3) {
            var cx = gpo_i32(b + f * 20 + 0);
            var cy = gpo_i32(b + f * 20 + 4);
            if (gpo_coord_bad(cx) == 1) { return GPO_E_COORD; }
            if (gpo_coord_bad(cy) == 1) { return GPO_E_COORD; }
            # ⛔ REJECT sub-pixel, do not quantise. The reference and model prove this arithmetic in the
            # doubled-INTEGER domain only; rounding kernel-side would answer a different question than
            # the one asked. Same doctrine as op 0x0E's GPO_E_SUBPIXEL and WRAP's power-of-two reject.
            if ((cx & 0xFFFF) != 0) { return GPO_E_SUBPIXEL; }
            if ((cy & 0xFFFF) != 0) { return GPO_E_SUBPIXEL; }
            f = f + 1;
        }

        # ---- ⭐⭐ THE w BAND. `W_i = 2^K / w_i`, so a small w gives a LARGE W and inflates every
        # downstream width. MEASURED: the reference originally used w = 1 and put D past a 32-bit lane
        # on all 4096 pixels of its full-screen frame, contradicting an earlier probe's 24-29 bits on
        # identical geometry -- the two disagreed on nothing but the w scale. w is a FIXED-POINT
        # MAGNITUDE, and a record below the floor is refused rather than silently rescaled.
        var w0 = load32(b +  8) & 0xFFFFFFFF;
        var w1 = load32(b + 28) & 0xFFFFFFFF;
        var w2 = load32(b + 48) & 0xFFFFFFFF;
        if (w0 < GPU_TPER_W_MIN) { return GPO_E_WRANGE; }
        if (w1 < GPU_TPER_W_MIN) { return GPO_E_WRANGE; }
        if (w2 < GPU_TPER_W_MIN) { return GPO_E_WRANGE; }
        if (w0 > GPU_TPER_W_MAX) { return GPO_E_WRANGE; }
        if (w1 > GPU_TPER_W_MAX) { return GPO_E_WRANGE; }
        if (w2 > GPU_TPER_W_MAX) { return GPO_E_WRANGE; }

        var dax = 2 * (gpo_i32(b +  0) >>> 16);  var day = 2 * (gpo_i32(b +  4) >>> 16);
        var dbx = 2 * (gpo_i32(b + 20) >>> 16);  var dby = 2 * (gpo_i32(b + 24) >>> 16);
        var dcx = 2 * (gpo_i32(b + 40) >>> 16);  var dcy = 2 * (gpo_i32(b + 44) >>> 16);
        # ⛔ GPU_TRI_AREA_MIN is what forbids a degenerate triangle, and it is the only thing between a
        # ring-3 record and a kernel divide-by-zero in prep. A memory-safety rule, not a quality one.
        var cross = ((dbx - dax) * (dcy - day) - (dby - day) * (dcx - dax)) / 4;
        if (cross < 0) { cross = 0 - cross; }
        var a2 = cross << 16;
        if (a2 < GPU_TRI_AREA_MIN) { return GPO_E_AREA; }
        if (a2 > GPU_TRI_AREA_MAX) { return GPO_E_AREA; }

        var W0 = (1 << GPU_TPER_K_SHIFT) / w0;
        var W1 = (1 << GPU_TPER_K_SHIFT) / w1;
        var W2 = (1 << GPU_TPER_K_SHIFT) / w2;
        var u0 = load32(b + 12) & 0xFFFFFFFF;
        var u1 = load32(b + 32) & 0xFFFFFFFF;
        var u2 = load32(b + 52) & 0xFFFFFFFF;
        var v0 = load32(b + 16) & 0xFFFFFFFF;
        var v1 = load32(b + 36) & 0xFFFFFFFF;
        var v2 = load32(b + 56) & 0xFFFFFFFF;

        var k = 0;
        while (k < 4) {
            var qx = qx0; var qy = qy0;
            if (k == 1) { qx = qx1; qy = qy0; }
            if (k == 2) { qx = qx0; qy = qy1; }
            if (k == 3) { qx = qx1; qy = qy1; }
            var e0 = (dcx - dbx) * (qy - dby) - (dcy - dby) * (qx - dbx);
            var e1 = (dax - dcx) * (qy - dcy) - (day - dcy) * (qx - dcx);
            var e2 = (dbx - dax) * (qy - day) - (dby - day) * (qx - dax);
            # ⭐⭐ THE DENOMINATOR BOUND. This rule exists because a design claim was FALSIFIED on the
            # host: "D fits a 32-bit lane" held on every early figure and is FALSE at the extremes --
            # measured at **8,583,644,160 = 2^33** with w at its floor and the coordinate ceiling, twice
            # an UNSIGNED lane. D is affine, so four corners bound it; depthgate's D8 proved that
            # shortcut sound against brute force for exactly this shape of quantity.
            var D = e0 * W0 + e1 * W1 + e2 * W2;
            if (D < 0) { D = 0 - D; }
            if (D > GPU_TPER_D_MAX) { return GPO_E_DRANGE; }
            # the numerator is a REGISTER PAIR by design and needs no lane bound -- but prep evaluates
            # it in i64, so it needs one that keeps the KERNEL's own arithmetic defined.
            var Nu = e0 * (W0 * u0) + e1 * (W1 * u1) + e2 * (W2 * u2);
            var Nv = e0 * (W0 * v0) + e1 * (W1 * v1) + e2 * (W2 * v2);
            if (Nu < 0) { Nu = 0 - Nu; }
            if (Nv < 0) { Nv = 0 - Nv; }
            if (Nu > GPU_TPER_N_MAX) { return GPO_E_DRANGE; }
            if (Nv > GPU_TPER_N_MAX) { return GPO_E_DRANGE; }
            k = k + 1;
        }
        i = i + 1;
    }

    # ⭐ ACCEPTED. tri_persp.s (190 dwords, descriptor harvested) and gpu_tri_persp landed with this
    # line, and GPU_OP_NOTIMPL_MASK cleared bit 15 in the SAME change -- the accepted surface and the
    # proven surface move together or the mask is a lie. The worker still refuses with GPO_E_ARM where
    # the GPU or its arena is not usable, which is an arming fact rather than an ABI one.
    return 0;
}

fn gpo_validate(rec, fbw, fbh) {
    var op = load32(rec + 0) & 0xFFFFFFFF;
    if (op > 0x1F) { return GPO_E_BADOP; }
    if (((GPU_OP_SUPPORTED >> op) & 1) == 0) { return GPO_E_BADOP; }

    # Every dword this op does not define must be zero.
    var mask = gpo_field_mask(op);
    var i = 0;
    while (i < 16) {
        if (((mask >> i) & 1) == 0) {
            if ((load32(rec + i * 4) & 0xFFFFFFFF) != 0) { return GPO_E_RESERVED; }
        }
        i = i + 1;
    }
    if (((load32(rec + 4) & 0xFFFFFFFF) & ~gpo_flags_known(op)) != 0) { return GPO_E_RESERVED; }
    if (op == GPU_OP_NOP) { return 0; }                # no geometry, no slot, no arm
    # EDGE_COV validates on its OWN terms. The generic block below assumes "one source slot sized by
    # w*h, one framebuffer destination at dstxy" -- EDGE_COV has none of those three properties, and
    # running it through anyway would size the edge array by pixel count and bounds-check a mask that
    # never reaches the screen.
    if (op == GPU_OP_EDGE_COV) { return gpo_validate_edge(rec); }
    if (op == GPU_OP_TRI_RGBA) { return gpo_validate_tri(rec, fbw, fbh); }
    if (op == GPU_OP_TRI_LIST) { return gpo_validate_trilist(rec, fbw, fbh); }
    if (op == GPU_OP_TRI_TEX)  { return gpo_validate_tritex(rec, fbw, fbh); }
    if (op == GPU_OP_TEX_LIST) { return gpo_validate_texlist(rec, fbw, fbh); }
    if (op == GPU_OP_DEPTH_CLEAR) { return gpo_validate_depthclear(rec); }
    if (op == GPU_OP_TRI_DEPTH)   { return gpo_validate_tridepth(rec, fbw, fbh); }
    if (op == GPU_OP_RT_READ)     { return gpo_validate_rtread(rec); }
    if (op == GPU_OP_TRI_PERSP)   { return gpo_validate_triperspec(rec, fbw, fbh); }

    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    if (w < 1) { return GPO_E_DIM; }
    if (h < 1) { return GPO_E_DIM; }
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    if (dx + w > fbw) { return GPO_E_BOUNDS; }         # REJECT off-screen; the compositor owns clipping
    if (dy + h > fbh) { return GPO_E_BOUNDS; }

    var sf = gpo_slot_field(op);
    if (sf != 0) {
        var id = load32(rec + sf) & 0xFFFFFFFF;
        if (shm_slot_valid(id) == 0) { return GPO_E_BADSLOT; }
        var slot = id - 1;
        if (load64(&shm_mc + slot * 8) == 0) { return GPO_E_BADSLOT; }   # PMM-backed => GPU can't read it
        if (gpo_slot_bytes(op, w, h) > load64(&shm_size + slot * 8)) { return GPO_E_SLOTSIZE; }
    }

    # Residency last: it is the only check with a side effect (a shader upload), so everything cheap and
    # pure runs first and a malformed batch never uploads anything.
    if (op == GPU_OP_BLEND_RECT)  { if (gpu_blend_arm() != 1) { return GPO_E_ARM; } }
    if (op == GPU_OP_BLEND_COV)   { if (gpu_cov_arm()   != 1) { return GPO_E_ARM; } }
    if (op == GPU_OP_GLYPH_1BPP)  { if (gpu_glyph_arm() != 1) { return GPO_E_ARM; } }
    if (op == GPU_OP_GRAD_LINEAR) { if (gpu_grad_arm()  != 1) { return GPO_E_ARM; } }
    return 0;
}

# gpo_execute(rec) -> 0 or GPO_E_DISPATCH. Runs one already-validated record.
fn gpo_execute(rec) {
    var op  = load32(rec + 0)  & 0xFFFFFFFF;
    if (op == GPU_OP_NOP) { return 0; }
    var wh  = load32(rec + 16) & 0xFFFFFFFF;
    var dxy = load32(rec + 20) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;
    var h  = (wh >> 16) & 0xFFFF;
    var dx = dxy & 0xFFFF;
    var dy = (dxy >> 16) & 0xFFFF;
    var c0 = load32(rec + 36) & 0xFFFFFFFF;
    var c1 = load32(rec + 40) & 0xFFFFFFFF;

    if (op == GPU_OP_BLEND_RECT) {
        var s1 = load64(&shm_mc + ((load32(rec + 8) & 0xFFFFFFFF) - 1) * 8);
        if (gpu_blend_surface(s1, w, h, dx, dy) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    if (op == GPU_OP_BLEND_COV) {
        var s2 = load64(&shm_mc + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        if (gpu_cov_surface(s2, w, h, dx, dy, c0) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    if (op == GPU_OP_GLYPH_1BPP) {
        var s3 = load64(&shm_mc + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        if (gpu_glyph_surface(s3, w, h, dx, dy, c0) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    if (op == GPU_OP_GRAD_LINEAR) {
        if (gpu_grad_surface(w, h, dx, dy, c0, c1) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    # EDGE_COV is UNREACHABLE through all of rung 9a: gpu_edge_arm() returns 0, so validation rejects
    # every well-formed record with GPO_E_ARM before pass 2 ever runs. The branch is written here anyway
    # so 9b is a one-function change with no ABI edit — and so this file never contains a supported op
    # with no execution path, which is how GPO_E_BADOP would surface as a mystery at the wrong layer.
    # Attribute interpolation. Coverage runs first through the UNMODIFIED edge rasteriser, then the
    # interpolation pass over the mask it produced -- see gpu_tri_rgba.
    # ⚠ With DERIVE the frame's three edges are synthesised kernel-side, so there is no edge slot to
    # resolve; the validator has already refused a record that supplies one alongside the flag.
    if (op == GPU_OP_TRI_LIST) {
        var lv = load32(rec + 12) & 0xFFFFFFFF;
        var lkva = load64(&shm_kva + (lv - 1) * 8);
        var lnt = load32(rec + 24) & 0xFFFFFFFF;
        if (gpu_tri_list(lkva, lnt, w, h, dx, dy) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    # ⭐ RUNG 13a. Like rung 9a before it, this branch exists BEFORE the shader does: gpu_tex_arm()
    # returns 0, so a well-formed record reaches here and is refused with GPO_E_ARM rather than
    # GPO_E_BADOP. That keeps the ABI provable in QEMU at zero flashes while making 13b a
    # one-function change with no edit to this file — and it means the supported-op mask never
    # advertises an op whose execution path does not exist.
    if (op == GPU_OP_TRI_TEX) {
        var xflags = load32(rec + 4) & 0xFFFFFFFF;
        var xtex = load64(&shm_mc + ((load32(rec + 8) & 0xFFFFFFFF) - 1) * 8);
        var xedge = load64(&shm_mc + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        var xvtx = load64(&shm_kva + ((load32(rec + 24) & 0xFFFFFFFF) - 1) * 8);
        var xtwh = load32(rec + 28) & 0xFFFFFFFF;
        var xlut = 0;
        if ((xflags & GPU_TEX_FLAG_IDX8) != 0) {
            xlut = load64(&shm_mc + ((load32(rec + 32) & 0xFFFFFFFF) - 1) * 8);
        }
        var xne = load32(rec + 60) & 0xFFFF;
        if (gpu_tri_tex(xedge, xvtx, xtex, xlut, xtwh, xflags,
        w, h, dx, dy, xne, GPU_RULE_NONZERO) != 1) { return GPO_E_ARM; }
        return 0;
    }
    # ⭐ RUNG 14. Same staging doctrine as 9a and 13a: the branch lands before the shader does, so a
    # well-formed record is refused with GPO_E_ARM (not GPO_E_BADOP) and the whole ABI — 512-primitive
    # array, per-primitive flags, the mandatory FULLCOV rule, both texture formats — is provable in
    # QEMU at zero flashes. Arming is a one-function change that touches nothing here.
    if (op == GPU_OP_DEPTH_CLEAR) {
        # ⚠ GPO_E_ARM, not GPO_E_DISPATCH: the overwhelmingly likely refusal here is rung 6's audit
        # not having passed on this boot, which is an ARMING fact — the region is not proven free —
        # not a dispatch that was attempted and failed.
        var zh = load32(rec + 8) & 0xFFFFFFFF;
        var zv = load32(rec + 24) & 0xFFFFFFFF;
        if (gpu_depth_clear(zh, w, h, zv) != 1) { return GPO_E_ARM; }
        return 0;
    }
    # ⭐ RUNG 17's READBACK. ⚠ GPO_E_ARM, not GPO_E_DISPATCH, for op 0x0D's stated reason: the
    # overwhelmingly likely refusal is rung 6's audit not having passed on this boot, which is an
    # ARMING fact (the region is not proven free) rather than a dispatch that failed.
    if (op == GPU_OP_TRI_PERSP) {
        var pvk = load64(&shm_kva + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        if (gpu_tri_persp(rec, pvk) != 1) { return GPO_E_ARM; }
        return 0;
    }
    if (op == GPU_OP_TRI_DEPTH) {
        var tvk = load64(&shm_kva + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        if (gpu_tri_depth(rec, tvk) != 1) { return GPO_E_ARM; }
        return 0;
    }
    if (op == GPU_OP_RT_READ) {
        var rzh  = load32(rec + 8)  & 0xFFFFFFFF;
        var rdid = load32(rec + 12) & 0xFFFFFFFF;
        var rzwh = load32(rec + 28) & 0xFFFFFFFF;
        if (gpu_rt_read(rzh, rdid, w, h, rzwh & 0xFFFF) != 1) { return GPO_E_ARM; }
        return 0;
    }
    if (op == GPU_OP_TEX_LIST) {
        var Lp = load64(&shm_kva + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        var Ln = load32(rec + 24) & 0xFFFFFFFF;
        if (gpu_tex_list(Lp, Ln, w, h, dx, dy) != 1) { return GPO_E_ARM; }
        return 0;
    }
    if (op == GPU_OP_TRI_RGBA) {
        var tflags = load32(rec + 4) & 0xFFFFFFFF;
        var tedge = 0;
        if ((tflags & GPU_TRI_FLAG_DERIVE) == 0) {
            tedge = load64(&shm_mc + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        }
        var tnr = load32(rec + 60) & 0xFFFFFFFF;
        var tne = tnr & 0xFFFF;
        var trule = (tnr >> 16) & 0xFFFF;
        # Hoisted so the call fits one line: the formatter de-indents wrapped arguments to column 0,
        # where they read as top-level statements rather than as this call's operands.
        var ax0 = gpo_i32(rec + 24); var ay0 = gpo_i32(rec + 28);
        var ax1 = gpo_i32(rec + 32); var ay1 = gpo_i32(rec + 36);
        var ax2 = gpo_i32(rec + 40); var ay2 = gpo_i32(rec + 44);
        var qa = load32(rec + 48) & 0xFFFFFFFF;
        var qb = load32(rec + 52) & 0xFFFFFFFF;
        var qc = load32(rec + 56) & 0xFFFFFFFF;
        var trc = gpu_tri_rgba(tedge, w, h, dx, dy, tne, trule, ax0, ay0, ax1, ay1, ax2, ay2, qa, qb, qc);
        if (trc != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    if (op == GPU_OP_EDGE_COV) {
        var se = load64(&shm_mc + ((load32(rec + 12) & 0xFFFFFFFF) - 1) * 8);
        var sd = load64(&shm_mc + ((load32(rec + 8)  & 0xFFFFFFFF) - 1) * 8);
        var nr = load32(rec + 36) & 0xFFFFFFFF;
        if (gpu_edge_cov(se, sd, w, h, nr & 0xFFFF, (nr >> 16) & 0xFFFF) != 1) { return GPO_E_DISPATCH; }
        return 0;
    }
    return GPO_E_BADOP;
}

# gpu_shader_op_sys(desc_uva, len) -> 0 / packed negative.
#
# TWO PHASES, and the split is part of the ABI. Every op is validated before ANY op is dispatched, so a
# call that fails validation draws NOTHING — "reject rather than clip" generalised from one rect to an
# array. Only a pass-2 failure (GPO_E_DISPATCH) can leave a composited prefix, and the returned index
# names exactly where it stopped.
#
# `len` is a BYTE length, not an op count. A future kernel with a wider record rejects a v1 caller on
# `len % stride`; an op count would have passed and misparsed silently.
fn gpu_shader_op_sys(desc_uva, len) {
    if (gpu_present == 0) { return 0 - GPO_E_NOGPU; }
    if (len < GPU_OP_STRIDE) { return 0 - GPO_E_DESC; }
    if (len > GPU_OP_BUF_BYTES) { return 0 - GPO_E_DESC; }
    if (len % GPU_OP_STRIDE != 0) { return 0 - GPO_E_DESC; }
    if (is_user_range(desc_uva, len) == 0) { return 0 - GPO_E_DESC; }

    # gpu_matmul_ok is the honest per-boot evidence that the dispatch envelope works: gpu_shader_dispatch5
    # runs UNGATED at every boot (main.cyr), so this is a real gate rather than a tautology.
    # ⚠ gpu_blend_ok is deliberately NOT part of this gate. It is set only inside the #ifdef SHADER_BLEND
    # boot self-test, so requiring it would make #92 return E_UNPROVEN in every production kernel — the
    # gate would disable the feature it is supposed to protect.
    if (gpu_matmul_ok != 1) { return 0 - GPO_E_UNPROVEN; }
    if (gpu_blit_arm() != 1) { return 0 - GPO_E_NOGPU; }
    if (gpu_bb_pitch == 0) { return 0 - GPO_E_NOGPU; }

    # Fault-proof copy-in: proc_copy_from_user page-walks the caller's CR3 and refuses a not-present or
    # non-user page instead of a blind deref that could #PF the kernel on a wild-but-in-range pointer.
    # ⭐ 1.56.26 — PHASE PROFILE. Reset first so a call that returns early leaves zeros in the phases it
    # never reached, rather than the previous call's numbers masquerading as this one's.
    gpu_prof_copyin_us = 0;
    gpu_prof_valid_us  = 0;
    gpu_prof_build_us  = 0;
    gpu_prof_wait_us   = 0;
    gpu_prof_drain_us  = 0;
    gpu_prof_waves     = 0;
    gpu_prof_nops      = len / GPU_OP_STRIDE;

    var buf = sc_gpuop_buf();
    var t_copy = rdtsc();
    if (proc_copy_from_user(proc_get_cr3(proc_current_get()), buf, desc_uva, len) == 0) {
        return 0 - GPO_E_DESC;
    }
    gpu_prof_copyin_us = gpu_prof_us(t_copy);

    var n   = len / GPU_OP_STRIDE;
    var fbw = gpu_bb_pitch / 4;
    var fbh = gpu_bb_fbsize / gpu_bb_pitch;

    # VALIDATE phase — per RECORD. If `F` is per-primitive, this is one of the two places it can live.
    var t_val = rdtsc();
    var i = 0;
    while (i < n) {
        var e = gpo_validate(buf + i * GPU_OP_STRIDE, fbw, fbh);
        if (e != 0) { gpu_prof_valid_us = gpu_prof_us(t_val); return 0 - ((i << 8) | e); }
        i = i + 1;
    }
    gpu_prof_valid_us = gpu_prof_us(t_val);
    return gpo_execute_all(buf, n);
}

# gpo_execute_all — plan-S12: the WHOLE op array in ONE GPU submission.
#
# This is the payoff decision D-3 was made for. Because the ABI was specified as an ARRAY of ops from day
# one, batching is an IMPLEMENTATION change here and not an ABI break — the same #92, the same records, the
# same return convention. Had the band shipped one syscall number per op (as 1.56.2/1.56.3 did before the
# 1.56.4 realignment), this function could not exist without a second ABI migration.
#
# WHAT IT SAVES, per op after the first: the 7-dword TC write-back, the 5-dword completion fence, and a
# whole CPU round-trip (register submit + spin). What it does NOT save, deliberately: the per-dispatch
# pre-dispatch invalidate and CS_PARTIAL_FLUSH. See the batch-seam note in gpu.cyr.
#
# ⚠ HONEST LIMIT ON THE ERROR REPORT. One submission means ONE completion marker, so a batch that times out
# cannot say WHICH op hung — hence GPO_E_BATCH rather than a per-op GPO_E_DISPATCH with a fabricated index.
# Naming the op would need a per-op fence slot, which costs back a chunk of what batching just saved; that
# is a measurable follow-up, not a silent omission. Ring 3 recovers exactly as it would from any failed
# frame: re-clear with #85 and do not call #84.
#
# Emitting cannot fail partway. Pass 1 has already validated every op — bounds, slots, sizes, residency —
# so pass 2's emitters only put dwords in the ring. That is what makes it safe to leave gpu_batch_active
# set across the loop: there is no path that aborts mid-array and strands a fenceless partial program.
fn gpo_execute_all(buf, n) {
    var done_phys = gpu_arena_phys + GPU_BLEND_DONE_SUBOFF;
    var done_mc   = gpu_arena_mc   + GPU_BLEND_DONE_SUBOFF;
    store32(done_phys, GPU_MT_NOTYET);
    gpu_mfence();

    # ⭐ 1.56.26 — BUILD phase. Per-op prep (gpu_texl_build / gpu_tex_prep) plus ring emission. This and
    # VALIDATE are the two candidates for the per-primitive term in `F`; WAIT below is everything else.
    # ⚠ The suspend/restore of gpu_batch_active inside gpu_tex_list means an op 0x0C dispatch ALSO waits
    # on its own fence from in here, so raw elapsed time across this loop CONTAINS GPU execution. That
    # is netted out below via gpu_prof_drain_us — see the ⛔⛔ note at the self-drain site in gpu.cyr.
    # ⛔ An earlier version of this comment said the contamination "is not a measurement bug, it is the
    # shape of the code". That was wrong and it was the whole defect: GPU cost is wave-proportional and
    # waves scale with primitive count, so leaving it in BUILD makes the per-primitive slope this cut
    # measures come out per-primitive REGARDLESS of what the CPU actually does.
    var t_build = rdtsc();
    gpu_batch_active = 1;
    var err = 0;
    var j = 0;
    while (j < n) {
        var e2 = gpo_execute(buf + j * GPU_OP_STRIDE);
        if (e2 != 0) { err = (j << 8) | e2; j = n; }
        j = j + 1;
    }
    gpu_batch_active = 0;                      # restored on EVERY exit path below
    # ⭐ NET THE SELF-DRAIN OUT OF BUILD. Ops that suspend batching to wait on their own fence
    # (gpu_tex_list, gpu_tri_list) executed GPU work inside the loop above and accumulated it into
    # gpu_prof_drain_us. Subtracting it here is what makes BUILD mean "CPU prep + ring emission" —
    # the thing the whole cut is trying to measure the slope of. ⚠ Floored at 0: the drain is a
    # SUBSET of the build window so the difference cannot legitimately go negative, but an integer
    # µs conversion applied to two different windows can round the wrong way by a tick, and a huge
    # positive from an underflowed subtraction would read as a real measurement.
    var build_total = gpu_prof_us(t_build);
    if (build_total > gpu_prof_drain_us) {
        gpu_prof_build_us = build_total - gpu_prof_drain_us;
    }
    if (build_total <= gpu_prof_drain_us) {
        gpu_prof_build_us = 0;
    }

    if (err != 0) { return 0 - err; }
    # WAIT phase — the batch fence and the spin on it. What col-major actually moved.
    var t_wait = rdtsc();
    gpu_batch_tail(done_mc);
    gpu_mfence();
    if (gpu_ring_kick_wait(done_phys, 100000) != 1) {
        gpu_prof_wait_us = gpu_prof_us(t_wait) + gpu_prof_drain_us;
        return 0 - GPO_E_BATCH;
    }
    gpu_prof_wait_us = gpu_prof_us(t_wait) + gpu_prof_drain_us;
    return 0;
}

# gpu_caps_sys(buf, len) -> 0 / -1. The capability + geometry probe ring 3 has been missing. Two problems it
# solves: (1) the ONLY way to discover GPU compositing today is to call #86 and look for -1; (2) #87/#88
# REJECT off-screen rects rather than clipping, so a compositor MUST know the true BACK-BUFFER geometry —
# which is NOT what fbinfo#38 reports (that is the console framebuffer). 8x u32 LE, mirroring fbinfo's
# struct-write pattern:
#   +0  flags   bit0 = GPU present · bit1 = double-buffer armed · bit2 = carveout (GPU-visible) shm available
#               bit3 = SHADER COMPOSITING available (gpu_shader_op#92 will run)
#               bit4 = BATCHED: one #92 call is one GPU submission (plan-S12) — see GPO_E_BATCH
#   +4  bb_pitch  (bytes/row)      +16 shm_slots_total
#   +8  bb_width  (px)             +20 shm_slots_free
#   +12 bb_height (px)             +24 shm_max_size (bytes)   +28 #92 op-support mask (bit N = op code N)
# No MC address is exposed — geometry and counts only. An info query, so the CP-DMA constraints don't apply.
fn gpu_caps_sys(buf, len) {
    if (is_user_range(buf, 32) == 0) { return 0 - 1; }
    if (len < 32) { return 0 - 1; }
    # ARM LAZILY FIRST. #89 is the syscall a compositor calls BEFORE anything else, but gpu_bb_pitch /
    # gpu_bb_fbsize are only populated by gpu_blit_arm — so probing first would report width=0/height=0, and
    # since #87/#88 REJECT rather than clip, a probe-then-clip compositor would then fail every blit. Arming
    # here (idempotent — returns immediately once armed) makes the reported geometry the REAL back buffer
    # rather than a prediction. Side effect is the one the caller is about to trigger anyway on its first
    # fill/blit; on a box where the double-buffer cannot arm, flags bit1 stays clear and the geometry reads 0,
    # which is the honest answer. (Caught by /bin/gpublit's self-validation: exit 97, iron 1.55.32.)
    gpu_blit_arm();
    var flags = 0;
    if (gpu_present != 0) { flags = flags | 1; }
    if (gpu_bb_armed == 1) { flags = flags | 2; }
    if (gpu_arena_mc != 0) { flags = flags | 4; }        # a carveout exists ⇒ #86 can serve
    # bit3 — SHADER COMPOSITING available, i.e. gpu_shader_op#92 can actually run. Mirrors #92's own
    # call-level gate exactly, so a caller that sees this bit set will not then get E_UNPROVEN/E_NOGPU.
    # Without it the only way to discover #92 is to call it and read the error, which is what #86's
    # "call it and look for -1" already proved to be the wrong shape.
    var shader_ok = 0;
    if (gpu_present != 0) {
        if (gpu_arena_mc != 0) {
            if (gpu_ring_wptr != 0) {
                if (gpu_matmul_ok == 1) { shader_ok = 1; }
            }
        }
    }
    if (shader_ok == 1) { flags = flags | 8; }
    # bit4 — BATCHED SUBMISSION: one #92 call is ONE GPU submission (plan-S12). This is a SEMANTIC bit, not
    # a performance hint. With it CLEAR, a GPO_E_DISPATCH means ops [0,idx) composited and idx failed. With
    # it SET, a GPO_E_BATCH means an INDETERMINATE prefix landed and no op is identifiable — ring 3 recovers
    # by re-clearing with #85 and not calling #84. A caller that does not read this bit cannot know which
    # recovery it owes, which is why it ships in the same cut as the batching itself.
    if (shader_ok == 1) { flags = flags | 16; }
    var bw = 0;
    var bh = 0;
    if (gpu_bb_pitch != 0) {
        bw = gpu_bb_pitch / 4;
        bh = gpu_bb_fbsize / gpu_bb_pitch;
    }
    var freeslots = 0;
    var i = 0;
    while (i < SHM_MAX) {
        if (load64(&shm_phys + i * 8) == 0) { freeslots = freeslots + 1; }
        i = i + 1;
    }
    store32(buf +  0, flags);
    store32(buf +  4, gpu_bb_pitch);
    store32(buf +  8, bw);
    store32(buf + 12, bh);
    store32(buf + 16, SHM_MAX);
    store32(buf + 20, freeslots);
    store32(buf + 24, SHM_MAX_SIZE);
    # +28 — the gpu_shader_op#92 OP-SUPPORT MASK: bit N set <=> op code N is implemented by this kernel.
    # This is why op codes are capped at 0x1F (see GPU_OP_SUPPORTED): the code IS its bit index here, so
    # ring 3 discovers the exact op set instead of probing each one and reading E_BADOP. Reported as 0
    # when the shader path is unavailable, so one read answers "can I" and "which ops" together.
    # ⛔ NOTIMPL OPS ARE SUBTRACTED HERE. GPU_OP_SUPPORTED is the VALIDATOR's reachability gate, so an
    # op whose ABI is finished but whose worker is not must be in it (or none of its field rules can
    # be tested through the real dispatch path). What ring 3 is TOLD must stay the smaller set: the
    # advertised surface may never exceed the working one. See GPU_OP_NOTIMPL_MASK.
    var opmask = 0;
    if (shader_ok == 1) { opmask = GPU_OP_SUPPORTED & ~GPU_OP_NOTIMPL_MASK; }
    store32(buf + 28, opmask);

    # ⭐ 1.56.26 — THE PHASE PROFILE, as an OPT-IN TAIL. A caller asking for 32 bytes gets exactly the
    # eight-word probe it always got; only a caller that asks for 64 gets the profile. Extending by
    # length rather than by a new syscall is what the reserved-tail shape is for — no ABI break, no
    # second number to keep in step, and old binaries are bit-identical in behaviour.
    #
    # ⛔ AND THE RANGE CHECK WIDENS WITH THE WRITE. The guard at the top validates only 32 bytes because
    # that was all this ever wrote; writing 64 behind a 32-byte check would be the identical defect this
    # cycle just fixed in #82/#83 — a bound that describes the OLD access.
    # ⛔ REFUSE, don't half-write. A caller that asks for 64 bytes it does not own gets -1, not a silent
    # 32-byte answer: this file rejects rather than clips everywhere else (#87/#88 reject off-screen
    # rects, the flags word accepts nothing rather than accepting-and-ignoring), and a partial write
    # here would hand back a buffer whose second half is the caller's own stale bytes — indistinguishable
    # from a profile that legitimately read zero.
    if (len >= 64) {
        if (is_user_range(buf, 64) == 0) { return 0 - 1; }
        store32(buf + 32, gpu_prof_copyin_us);   # descriptor copy-in
        store32(buf + 36, gpu_prof_valid_us);    # gpo_validate over all records
        store32(buf + 40, gpu_prof_build_us);    # gpo_execute: per-op prep + ring emission
        store32(buf + 44, gpu_prof_wait_us);     # batch fence + spin
        store32(buf + 48, gpu_prof_gx);          # grid X actually programmed, LAST dispatch
        store32(buf + 52, gpu_prof_gy);          # grid Y actually programmed, LAST dispatch
        store32(buf + 56, gpu_prof_waves);       # gx*gy summed over EVERY dispatch in the call
        store32(buf + 60, gpu_prof_nops);        # records in the call
    }

    # ⭐ 1.56.36 — GPU IDENTITY, a THIRD opt-in tier at len >= 96. Same reserved-tail shape as the 64-byte
    # profile above and for the same reasons: a caller asking 32 or 64 is bit-identical to before, there is
    # no second syscall number to keep in step, and old binaries do not change behaviour.
    #
    # ⛔ WHY THIS EXISTS AT ALL: #89 reported GEOMETRY and said nothing about WHICH GPU this is, so on a
    # sovereign box `iam` (the fastfetch-equivalent) had no GPU line and mihi's accelerator registry
    # detected ZERO accelerators — its whole detection surface is sysfs (`/sys/class/drm/...`) through
    # ai-hwaccel, and agnos has no sysfs. The kernel has known the answer since probe and simply never
    # offered it. agnos drives this iGPU natively; not being able to say so was a reporting gap, not a
    # capability one.
    # ⛔ AND THE RANGE CHECK WIDENS WITH THE WRITE, exactly as the 64-byte tier documents: refuse a caller
    # that asks for 96 bytes it does not own rather than half-write and hand back stale bytes that are
    # indistinguishable from a legitimately-zero identity.
    if (len >= 96) {
        if (is_user_range(buf, 96) == 0) { return 0 - 1; }
        store32(buf + 64, gpu_vendor_id);        # PCI config vendor (0x1002 = AMD)
        store32(buf + 68, gpu_device_id);        # PCI config device (0x1638 = Cezanne/Renoir iGPU)
        store32(buf + 72, gpu_vram_mb);          # NBIO CONFIG_MEMSIZE, megabytes
        store32(buf + 76, 0);                    # reserved — MUST read 0 so a later field is detectable
        # +80..95 — 16 bytes, NUL-padded ASCII asic tag. A STRING, because ring 3 has no vendor/device
        # table and building one there would duplicate a fact the kernel already holds. Written only when
        # a GPU was actually probed, so an absent GPU reads all-zero rather than a stale label.
        var t = 0;
        while (t < 16) { store8(buf + 80 + t, 0); t = t + 1; }
        if (gpu_present != 0) {
            var nm = "gfx90c/DCN2.1";
            var k = 0;
            while (k < 13) { store8(buf + 80 + k, load8(nm + k)); k = k + 1; }
        }
    }
    return 0;
}

# ══ #93 gpu_modeset_op — THE MODESET SEAM (MD-4 ratified, H3) ═══════════════════════════════════════════
#
# ONE syscall number. An ARRAY of fixed-size 64-byte records. The operation is an op code INSIDE each record
# — exactly the D-3 shape #92 uses, for exactly the same reason: batching and new ops are IMPLEMENTATION
# changes, never ABI breaks. No pointer or MC address that names GPU memory crosses the boundary; the kernel
# validates every record before executing any, and REJECTS rather than clips.
#
# ⚠ WHY A SEPARATE NUMBER FROM #92, given #92's comment says "never mint #93": #92 is shader COMPOSITING —
# drawing into an already-lit back buffer. #93 is MODESET — taking the pipe away from the GOP (PLL / OTG /
# PHY / ATOM), the most dangerous thing this kernel does, gated behind the arm-once latch (H2). Folding the
# two would put "reprogram the display timing" and "blend a translucent rect" behind one validator and one
# op-support mask. MD-4 (2026-07-23) ratified the split and cyrius 6.4.74 shipped the `sys_gpu_modeset_op`
# wrapper for it. The #92 comment's "retires #93" aspiration is superseded by that ratification.
#
# ⚠ THE ACTUAL MODESET WRITE OPS ARE THE M-LANE (iron). At H3 this handler dispatches NOP + CAPS only, both
# read-only, both safe under QEMU. When an M-lane write op is added it MUST call modeset_arm() before its
# first DCN write, and THE GATE in gpu_otg_lock / gpu_dcn_write_committed (H2) enforces it structurally.
#
# ⚠ CAPS DOES NOT GATE ON gpu_present. Under QEMU there is no AMD GPU, but `run /bin/modeset --caps` must
# still return so the tool can report "no display here" — that is the whole point of a caps probe, and it is
# how ring 3 tells "this kernel has no #93" (an old kernel) apart from "#93 is here but there is no GPU".
# The GPU/display state is reported IN the caps flags, not by refusing the call.
#
# Return: 0 on success · -((idx<<8)|reason) naming the failing record · reason is always >= 1.
# ⚠ LINUX COLLISION: #93 = fchown(fd,uid,gid). arg1 is a userland VA, essentially never a valid fd, so a
# stray off-agnos call is ~always EBADF — milder than #92's path-resolving chown. The file-level
# #ifdef CYRIUS_TARGET_AGNOS gate in cyrius/lib/syscalls.cyr is still the load-bearing barrier.

var MDO_OP_STRIDE    = 64;          # bytes per record (matches #92's GPU_OP_STRIDE)
var MDO_OP_MAX_LEN   = 4096;        # cap on the whole array
var MDO_OP_NOP       = 0x00;        # validated, dispatches nothing — batch padding / ABI probe
var MDO_OP_CAPS      = 0x01;        # write the modeset caps (8x u32 LE) to the record's out_uva
var MDO_OP_DUMP      = 0x02;        # M1/M2/M3 read-only DCN pipe dump -> progressive `rd <off> <val>` to klug
var MDO_OP_LOCK      = 0x03;        # M4 OTG-lock proof — take lock, write V_TOTAL back to itself, release
var MDO_OP_VTOTAL    = 0x04;        # M5 first real modeset — V_TOTAL 1481->1501->1481, oracled off I2 refresh
var MDO_OP_RECOMMIT  = 0x05;        # M6 same-mode OTG envelope — OTG_MASTER_EN 0 -> reprogram -> 1, I1 stop/resume
var MDO_OP_TRANSMIT  = 0x06;        # M8 transmitter — ATOM #4 (+ #76, build-gated) INSIDE M6's envelope
var MDO_OP_AUDIO_PRE  = 0x07;       # M9 CONTROL   — transmit + audio unmuted BEFORE the transmitter edge
var MDO_OP_AUDIO_POST = 0x08;       # M9 TREATMENT — transmit + audio unmuted AFTER  the transmitter edge
var MDO_OP_PIXCLK     = 0x09;       # 1.56.33 — ATOM #12 SetPixelClock; derives all params, refuses on pll_id
var MDO_OP_CRCCAL     = 0x0A;       # 1.56.34 — calibrate the AFMT audio CRC against its NULL case, in one boot
var MDO_OP_NATIVE     = 0x0B;       # 1.56.36 — NATIVE RESOLUTION: retarget HUBP to the full-size surface, scaler to bypass
var MDO_OP_PAN        = 0x0C;       # 1.56.36 — CONSOLE HARDWARE PAN: scroll by moving the scanout start, not 14.7 MB
# bit N set <=> op N implemented: 0 NOP,1 CAPS,2 DUMP,3 LOCK,4 VTOTAL,5 RECOMMIT,6 TRANSMIT,
# 9 PIXCLK — advertised UNCONDITIONALLY on the TRANSMIT precedent: the op IS implemented, and a
# build/boot that cannot derive a pll_id answers with the specific MDO_E_NOPLL rather than a generic
# "unknown op", which is the difference between "this kernel cannot name the PLL" and "this ABI is old".
# 7 AUDIO_PRE, 8 AUDIO_POST.
# ⚠ TRANSMIT is advertised UNCONDITIONALLY even though its body needs HDMI_ATOM: the op really is
# implemented, and a build without the flag answers with the specific MDO_E_NOATOM rather than a generic
# "unknown op" — which is the difference between "this kernel cannot drive the PHY" and "this ABI is old".
# ⚠ The M9 pair is advertised CONDITIONALLY, and that asymmetry is deliberate. TRANSMIT's body exists in
# every build; the audio arms only mean anything when BOTH halves of the experiment are real — the split
# staging/unmute (MODESET_AUDIO) *and* an edge for them to sit before or after (ATOM_TX_CYCLE). That
# conjunction is MODESET_AUDIO_ARMS, derived in build.sh, which is why the gate below is not MODESET_AUDIO.
# Advertise on either flag alone and the tool can run a "control" and a "treatment" that are the SAME
# experiment under two op codes — the ATOM_DRY class again, one layer up. Without it: MDO_E_BADOP, which
# the tool reports as "wrong kernel" rather than silently producing a result that means nothing.
# ⚠ 1.56.34: bit 10 (MDO_OP_CRCCAL 0x0A) added to BOTH values — the CRC calibration is not an audio ARM,
# it is an INSTRUMENT check, so it must exist in a plain kernel. An added op must move both or the smoke's
# both-directions assertion fails, which is the check that catches an op advertised in only one build.
# ⚠ 1.56.36: bit 11 (MDO_OP_NATIVE 0x0B) and bit 12 (MDO_OP_PAN 0x0C) added to BOTH values, same rule.
# Both are DISPLAY ops with no audio content whatsoever, so gating either on MODESET_AUDIO_ARMS would make
# the native-resolution and console-pan paths exist only in an audio-experiment kernel — the exact
# "advertised in one build" defect the assertion exists for.
#ifdef MODESET_AUDIO_ARMS
var MDO_OP_SUPPORTED = 0x1FFF;
#else
var MDO_OP_SUPPORTED = 0x1E7F;
#endif
# =============================================================================================
# 1.56.40 — THE LOCAL-IPC CHANNEL BAND (`#97 chan_op`), bite 4a: the region + CAPS.
#
# Design, migration and kill criteria: docs/development/planning/ipc.md §9. This is the kernel half
# of retiring TCP-on-loopback as the desktop's control transport — a display protocol has nothing to
# route, nothing to checksum, no window to negotiate and no business owning a port.
#
# ⛔ NO CODENAME. It is `chan_*` beside `pipe_*` / `shm_*` / `sock_*` / `net_*`, per the operator on
# 2026-08-05: a name is a distribution fact, and a band that never leaves this kernel has no boundary
# to cross. The design's Sanskrit working name is dropped. [[feedback_naming_lanes]]
#
# ⭐ WHY A STATIC 2 MB REGION RATHER THAN 32 `kmalloc`s (§9.2). Three reasons, and the third decides
# it: creation cannot OOM · it sidesteps the 4096-byte slab ceiling · and **because channel pages are
# never kmalloc'd or kfree'd, a destructive op inside a validate-then-execute batch cannot produce a
# kernel-heap use-after-free.** That last is not hypothetical — it is the exact bug a judge found in
# the rejected shared-region design (free-then-write in one batch, writing attacker-chosen bytes to a
# kernel VA).
#
# ⛔ THE REGION IS REACHED THROUGH THE DIRECT MAP, WHICH IS WHY THIS WORKS AT ALL. Every per-proc CR3
# mirrors kernel PDPT[1..511], so `DIRECTMAP_BASE + phys` resolves under ANY process's page tables —
# the low identity map does not. §9.9 makes region reachability a KILL CRITERION and says to test it
# "first in bite 4, before any userland"; `CH_CAPS` therefore performs the check on every call, from
# whatever CR3 the caller happens to be running under.
var CHAN_REGION_PAGES = 32;         # 32 x 4096 B carved out of one 2 MB page
var chan_region_phys = 0;           # 0 = not reserved (no RAM at boot, or reserve not yet run)
var chan_region_kva  = 0;           # DIRECTMAP_BASE + phys — valid under every CR3

# Ops. ⛔ `CH_ENUM` is deliberately ABSENT from v1 — §9.7 item 5: it is the one op with no
# today-consumer, and the roadmap's own rule is that the kernel grows per native workload. `CH_HANDOFF`
# (0x0A) and `CH_DIAL` (0x0B) are RESERVED with their caps bits CLEAR: the shape of a relayed channel is
# reserved, a relayed channel is not promised, and the kernel will never dial.
# ⭐ THE OBJECT MODEL (§9.3). 32 endpoints = 16 channels, endpoint `e` paired with `e ^ 1`. Each
# endpoint owns one 4096 B page of the region as its INBOX: a sender writes into its PEER's inbox.
#
# ⛔ CURSORS LIVE HERE, IN KERNEL ARRAYS — NOT IN THE PAGE. That is the single decision that kills the
# whole forgery class: ring 3 cannot address a cursor, so it cannot fake occupancy, rewind a peer's
# consumption, or inject. The rejected shared-region design put them in userland-visible memory and its
# own correctness judge found keystroke capture and injection on the display channel with "NO
# MITIGATION IN v1". Ring 3 never addresses the page either — it copies in and out through the syscall.
#
# ⛔ MONOTONIC AND NEVER WRAPPING. `chan_w`/`chan_r` count records for all time; equality means
# genuinely drained. A wrapping cursor makes "drained" and "exactly one lap behind" the same value —
# the shape agnos's `pipe` already gets right.
var CHAN_ENDS      = 32;            # 32 endpoints -> 16 channels
var CHAN_SLOTS     = 64;            # records per inbox page (64 x 64 B = 4096)
var CHAN_REC_BYTES = 64;            # §3: no production setu message exceeds 64 bytes
var chan_end_open[32];              # 1 = this endpoint exists
var chan_end_owner[32];             # owning pid
var chan_end_oepoch[32];            # proc_epoch AT CLAIM — pid recycling is why this exists (bite 2)
var chan_epoch[16];                 # per-CHANNEL generation, bumped at mint; fd-vs-channel staleness
var chan_epoch_next = 1;
var chan_w[32];                     # records ever written INTO this endpoint's inbox
var chan_r[32];                     # records ever read OUT by this endpoint's owner
var chan_drops = 0;                 # bounded-queue drops — counted, because a silent drop is a lie
# Per-slot record LENGTH, one byte per slot, 32 endpoints x 64 slots = 2048 bytes.
# ⛔ MODULE-SCOPE `var X[N]` IS N x u64 (8N BYTES), not N bytes — function-local is the byte form. 2048
# bytes therefore needs [256], and writing [2048] here would silently reserve 16 KB while writing [32]
# would overrun into whatever follows. [[feedback_cyrius_var_array_u64_units]]
var chan_lens[256];

fn chan_page(e) { return chan_region_kva + e * 4096; }

# ⭐ AUTHORITY IS RE-DERIVED ON EVERY OPERATION (§9.3) — five checks, and the fd supplies three of the
# values being checked rather than being trusted itself.
#
# ⛔ THIS IS WHAT MAKES AN INHERITED HANDLE INERT. agnos has no CLOEXEC and copies the whole fd table
# at spawn, so instead of fighting that default the band inverts it: a child that inherits a channel fd
# holds a claim whose owner is its PARENT, and `chan_end_owner[e] == proc_current_get()` fails. Nothing
# has to be revoked because nothing was ever granted. A sandbox is DESCRIBED, not CARVED.
# ⚠ `chan_end_open` is kept separate from `chan_end_owner` because **pid 0 is a real process**, so a
# zero owner cannot double as "no owner".
fn chan_auth(base) {
    if (ktag(base) != VFS_CHAN) { return 0 - 1; }
    var e = kpayload(base, 0);
    if (e < 0) { return 0 - 1; }
    if (e >= CHAN_ENDS) { return 0 - 1; }
    if (load64(&chan_end_open + e * 8) != 1) { return 0 - 1; }
    if (load64(&chan_epoch + (e >> 1) * 8) != kpayload(base, 1)) { return 0 - 1; }   # fd vs CHANNEL
    if (load64(&chan_end_owner + e * 8) != proc_current_get()) { return 0 - 1; }
    # pid vs PROCESS — the incarnation check bite 2 exists for.
    if (load64(&chan_end_oepoch + e * 8) != proc_epoch_get(proc_current_get())) { return 0 - 1; }
    return e;
}

# ⛔ PEER LIVENESS IS DERIVED, NEVER STORED. A stored flag goes stale the moment the peer dies by a
# path that forgot to clear it — and the death modes that matter here are faults, not clean exits.
fn chan_peer_alive(e) { return load64(&chan_end_open + (e ^ 1) * 8); }

# Release every endpoint owned by `pid`. Sibling of flock_/snd_/gpu_/shm_release_pid, and like them it
# MUST run from BOTH death sites.
#
# ⛔ THIS WAS MISSING FROM THE FIRST CUT OF THE BAND and nothing caught it — the boot selftest closes
# its channels by hand, so a leak on the death path is invisible there. With only 16 channels, a client
# that faults leaves its endpoint claimed for the rest of the boot and the sixteenth crash exhausts the
# table. Found while chasing why a spawned child produced no output; unrelated to that, and real.
#
# ⚠ It deliberately does NOT close the PEER. Peer-gone is derived from `chan_end_open[e ^ 1]`, so the
# survivor must keep its own endpoint open in order to be TOLD its peer died — closing both would turn
# a peer's death into the survivor's own fd going bad, which is a different and much worse error.
# ⭐ FACTORED OUT SO read(2)/write(2) AND `#97` SHARE ONE IMPLEMENTATION (ipc bite 9).
# A PTY is (i) a bidirectional local channel, (ii) an end handed to a child at spawn, (iii) a line
# discipline — and only (iii) is terminal-specific (planning/ipc.md §1). The band already gives (i)
# and (ii). What was missing is that a child born holding a channel could not `read`/`write` it:
# neither `vfs_read` nor `vfs_write` had a `VFS_CHAN` arm, so every program would have had to learn
# `chan_op`. ⛔ A channel every program must be rewritten for is an API, not a PTY.
#
# ⛔ THESE TAKE AN ALREADY-AUTHORIZED ENDPOINT. Authority is re-derived by `chan_auth` at each call
# site and is NOT re-checked here — keeping the check at the boundary is what makes an inherited fd
# inert on every path, including these two new ones.
fn chan_queue(se, ubuf, slen): i64 {
    if (slen <= 0) { return 0 - CH_E_ARG; }
    if (slen > CHAN_REC_BYTES) { return 0 - CH_E_ARG; }
    if (is_user_range(ubuf, slen) == 0) { return 0 - CH_E_ARG; }
    var pe = se ^ 1;
    if (load64(&chan_end_open + pe * 8) != 1) { return 0 - CH_E_PEERGONE; }
    var wv = load64(&chan_w + pe * 8);
    var rv = load64(&chan_r + pe * 8);
    if ((wv - rv) >= CHAN_SLOTS) {
        store64(&chan_r + pe * 8, rv + 1);      # drop the OLDEST
        chan_drops = chan_drops + 1;
    }
    var slot = chan_page(pe) + (wv % CHAN_SLOTS) * CHAN_REC_BYTES;
    memset(slot, 0, CHAN_REC_BYTES);
    var si = 0;
    while (si < slen) { store8(slot + si, load8(ubuf + si)); si = si + 1; }
    store8(&chan_lens + (pe * CHAN_SLOTS + (wv % CHAN_SLOTS)), slen);
    store64(&chan_w + pe * 8, wv + 1);
    return slen;
}

fn chan_deliver(re, ubuf, rcap): i64 {
    if (rcap <= 0) { return 0 - CH_E_ARG; }
    if (is_user_range(ubuf, rcap) == 0) { return 0 - CH_E_ARG; }
    var rw = load64(&chan_w + re * 8);
    var rr = load64(&chan_r + re * 8);
    if (rr >= rw) {
        # Drained. Peer-gone is reported only once there is nothing left to read — a dead peer's
        # already-queued records must still be delivered, or a client that exits right after
        # presenting loses the present.
        if (chan_peer_alive(re) == 0) { return 0 - CH_E_PEERGONE; }
        return 0 - CH_E_WOULDBLOCK;
    }
    var rslot = chan_page(re) + (rr % CHAN_SLOTS) * CHAN_REC_BYTES;
    var rlen = load8(&chan_lens + (re * CHAN_SLOTS + (rr % CHAN_SLOTS)));
    # ⛔ A RECORD THAT DOES NOT FIT IS AN ERROR, NOT A TRUNCATION — and the record STAYS.
    if (rlen > rcap) { return 0 - CH_E_ARG; }
    var ri = 0;
    while (ri < rlen) { store8(ubuf + ri, load8(rslot + ri)); ri = ri + 1; }
    store64(&chan_r + re * 8, rr + 1);
    return rlen;
}

# read(2)/write(2) on a channel fd: the authorized endpoint for `fd`, or -1 when `fd` is not a live
# channel this proc owns — in which case the caller falls through to the ordinary vfs path.
# ⛔ -1 COVERS "NOT A CHANNEL" AND "NOT MINE" DELIBERATELY. An INHERITED channel fd must not become
# readable just because the caller used `read` instead of `#97`; it falls through to `vfs_read`, which
# has no VFS_CHAN arm and refuses. Inert-by-construction has to hold on every path that reaches an fd,
# and adding paths is exactly when it gets lost.
fn chan_fd_endpoint(fd): i64 {
    if (fd < 0) { return 0 - 1; }
    if (fd >= 32) { return 0 - 1; }
    var b = vfs_fd_table() + fd * 32;
    if (ktag(b) != VFS_CHAN) { return 0 - 1; }
    return chan_auth(b);
}

fn chan_release_pid(pid) {
    var e = 0;
    while (e < CHAN_ENDS) {
        if (load64(&chan_end_open + e * 8) == 1) {
            # ⛔ THE EPOCH IS PART OF THE IDENTITY HERE, NOT JUST IN chan_auth. Matching on `pid`
            # alone releases endpoints belonging to a DIFFERENT INCARNATION of the same slot — and
            # that is not hypothetical: at boot the spawning kernel context is pid 0 and the FIRST
            # user process is also slot 0, so a parent that minted a channel and endowed one end had
            # BOTH ends torn down the moment its child exited. The parent's own `CH_RECV` then
            # answered BADFD on an endpoint nothing had closed.
            # ⚠ `chan_auth` already compared incarnations (bite 2's whole purpose); this path did not,
            # so authority was epoch-aware while REVOCATION was not. Both halves have to agree or the
            # check is decorative.
            if (load64(&chan_end_owner + e * 8) == pid) {
                if (load64(&chan_end_oepoch + e * 8) == proc_epoch_get(pid)) {
                    store64(&chan_end_open + e * 8, 0);
                    store64(&chan_end_owner + e * 8, 0);
                    store64(&chan_end_oepoch + e * 8, 0);
                }
            }
        }
        e = e + 1;
    }
    return 0;
}

var CH_CAPS   = 0x00;               # (out_uva, out_len) -> 0; writes the caps block
var CH_MINT   = 0x01;               # (out_uva) -> 0; writes two fds — a channel is minted as a PAIR
var CH_SEND   = 0x02;               # (fd, buf, len<=64) -> len / -CH_E_*
var CH_RECV   = 0x03;               # (fd, buf, cap) -> len / -CH_E_WOULDBLOCK / -CH_E_PEERGONE
var CH_CLOSE  = 0x04;               # (fd) -> 0
var CH_ENDOW  = 0x05;               # (fd) -> 0; arm THIS endpoint for placement into the next #43 child

# ⭐ ENDOWMENT (bite 5) — the mechanism that lets a child be BORN holding a channel instead of dialling
# for one. A parent arms an endpoint; the next `spawn_path #43` child is created owning it.
#
# ⛔ THIS IS WHAT MAKES THE WHOLE AUTHORITY MODEL USABLE RATHER THAN MERELY SAFE. Inert-by-construction
# (bite 4) means an inherited fd does nothing — which, without placement, would mean a child can never
# hold a channel at all. Endowment is the explicit act that grants one: a sandbox is DESCRIBED (a list
# of endowments) rather than CARVED (a list of denials), and kavach's agnos backend needs no close-loop
# because there is no ambient reach to revoke.
#
# Per-CPU and one-shot, mirroring `exec_redirect #62`'s arm — the arm and its consumption span two
# syscalls on the same CPU, and a stale arm leaking into somebody else's spawn would hand a channel to
# a process nobody endowed.
# ⛔ STORED AS endpoint+1, SO 0 MEANS UNARMED. Module-scope globals zero-init, so a -1 sentinel would
# require an explicit boot-time init — and until that ran, `endow_arm_get()` would answer 0 and the hook
# would read it as "endpoint 0 is armed" on the FIRST spawn in the system, placing a channel nobody
# endowed into init. Biasing by one removes the init-order dependency entirely rather than adding a
# boot step that a future reorder could move.
var pcpu_endow_end[4];              # armed endpoint id + 1; 0 = nothing armed
var pcpu_endow_fd[4];               # the fd index the placement will use, decided at ARM time
fn endow_arm_set(v) { store64(&pcpu_endow_end + pcpu_cpu() * 8, v + 1); return 0; }
fn endow_arm_clear() { store64(&pcpu_endow_end + pcpu_cpu() * 8, 0); return 0; }
fn endow_arm_get() { return load64(&pcpu_endow_end + pcpu_cpu() * 8) - 1; }
fn endow_fd_set(v) { store64(&pcpu_endow_fd + pcpu_cpu() * 8, v); return 0; }
fn endow_fd_get() { return load64(&pcpu_endow_fd + pcpu_cpu() * 8); }
# ⭐ PTY MODE (ipc bite 9). When armed, the endowed endpoint is ALSO installed at the child's fd
# 0, 1 and 2 — which is what makes it a terminal rather than a side channel: the child's stdin,
# stdout and stderr ARE the channel, so a program that has never heard of `#97` (agnsh reads fd 0
# with a plain `SYS_READ`) works unmodified. That is the whole difference between a PTY and an API.
# ⚠ One endpoint behind four fds is CORRECT here and mirrors a real tty, where 0/1/2 are one device.
var pcpu_endow_stdio[4];
fn endow_stdio_set(v) { store64(&pcpu_endow_stdio + pcpu_cpu() * 8, v); return 0; }
fn endow_stdio_get() { return load64(&pcpu_endow_stdio + pcpu_cpu() * 8); }

# ⭐ ANNOUNCEMENT: THE PARENT DOES IT, WHICH IS WHY `CH_ENDOW` RETURNS THE FD INSTEAD OF 0.
#
# A child must be able to FIND the channel it was born holding, or endowment is useless. ipc.md routes
# that through the `KEY=VALUE` env blob `#43` already accepts — "exactly Wayland's WAYLAND_SOCKET
# trick" — and in Wayland it is the COMPOSITOR that sets that variable in the child's environment, not
# the kernel.
#
# ⛔ AND THE KERNEL CANNOT DO IT ANYWAY, WHICH SETTLES THE DESIGN RATHER THAN MERELY FAVOURING IT.
# `elf_load_from_file` bakes the env strings into the child's init stack at elf.cyr:417-451, and calls
# `proc_create_user` — where placement happens — only at :473. By the time the kernel knows the fd, the
# env is already written. So the number has to be decided at ARM time and handed back to the parent,
# which then puts `AGNOS_CHAN=<fd>` in the env it passes to `#43`. Zero kernel env plumbing.
#
# The index is the first free slot >= 3 in the ARMING proc's table (fd 0/1/2 are stdio). The child's
# table is a byte copy of it, so the same slot is free there — normally. If the parent opens something
# into that slot between arming and spawning, placement REFUSES rather than overwriting a live fd; see
# chan_place_into_child.
fn chan_endow_pick_fd() {
    var tbl = vfs_fd_table();
    var f = 3;
    while (f < 32) {
        if (ktag(tbl + f * 32) == VFS_FREE) { return f; }
        f = f + 1;
    }
    return 0 - 1;
}

# ⛔ INERT UNTIL EXPLICITLY TURNED ON. ipc.md §9.6 calls bite 5 "the highest-risk bite" — the hook sits
# on the birth path of EVERY user process — and requires the "no-op path proven across a full boot
# first". This gate is that no-op: with it 0, `chan_place_into_child` returns immediately and
# `proc_create_user` is byte-for-byte the function it was. Flip to 1 only once a full sweep is green
# with the hook present and inert.
# ⭐ ACTIVE. The inert path was proven first, exactly as ipc.md §9.6 requires for "the highest-risk
# bite": with this 0 the hook is present on every user process's birth path and returns immediately,
# and a full sweep was 17/17 in that state. Only then was it turned on. Setting this back to 0 disables
# endowment without removing the hook — the intended rollback if placement is ever implicated.
var chan_endow_enabled = 1;

# Place the armed endpoint into a freshly-created child. Called from proc_create_user AFTER
# vfs_fd_inherit, which is the single inheritance point for every user proc.
#
# ⛔ ABORT IF THE CHILD IS ON THE GLOBAL TABLE. `vfs_fd_inherit` RETURNS SUCCESS ON kmalloc FAILURE —
# it leaves `proc_fd_base[child] == 0`, which silently means "use the global table". Placing an
# endowment there would write a live channel fd into the table proc 0, every kthread and every future
# global-table user shares, and transfer ownership to a child that may exit a millisecond later. The
# resolved-table test (not `proc_fd_base_get(pid) == 0`) is used because proc 0's base is set
# EXPLICITLY to `&vfs_table` — the same trap that bit `spawn_redirect_apply` at 1.56.39.
fn chan_place_into_child(child_pid) {
    if (chan_endow_enabled == 0) { return 0; }
    var e = endow_arm_get();
    if (e < 0) { return 0; }
    endow_arm_clear();                          # one-shot: consumed whether or not it lands
    var pty_mode = endow_stdio_get();
    endow_stdio_set(0);                         # ⛔ cleared WITH the arm — a stale flag would silently
    # turn the NEXT unrelated spawn's stdio into a channel, which is a very hard bug to see.
    if (e >= CHAN_ENDS) { return 0 - 1; }
    if (load64(&chan_end_open + e * 8) != 1) { return 0 - 1; }
    var tbl = vfs_fd_table_of(child_pid);
    if (tbl == &vfs_table) {
        kprintln("chan: endow REFUSED -- child is on the global fd table", 54);
        return 0 - 1;
    }
    # ⛔ USE THE INDEX DECIDED AT ARM TIME, and REFUSE if it is no longer free rather than re-scanning.
    # Re-scanning here would let the placement silently land somewhere other than the fd already
    # announced to the child in its env — the child would then look at the wrong slot and find nothing,
    # which is far harder to diagnose than a refusal.
    var f = endow_fd_get();
    if (f < 3) { return 0 - 1; }
    if (f >= 32) { return 0 - 1; }
    if (ktag(tbl + f * 32) != VFS_FREE) {
        kprintln("chan: endow REFUSED -- announced fd no longer free", 50);
        return 0 - 1;
    }
    # ⭐ OWNERSHIP TRANSFERS. The parent's claim on this endpoint dies here — the child is the owner,
    # stamped with the CHILD's proc epoch, so the parent's own fd for it becomes inert by exactly the
    # rule that makes an inherited copy inert. Endowment is a MOVE, not a share.
    store64(&chan_end_owner + e * 8, child_pid);
    store64(&chan_end_oepoch + e * 8, proc_epoch_get(child_pid));
    var cb = tbl + f * 32;
    ktag_set(cb, VFS_CHAN);
    kpayload_set(cb, 0, e);
    kpayload_set(cb, 1, load64(&chan_epoch + (e >> 1) * 8));
    kpayload_set(cb, 2, 0);
    # ⭐ PTY MODE — the child's stdin/stdout/stderr BECOME this channel (ipc bite 9).
    # ⛔ THIS IS WHAT MAKES IT A TERMINAL AND NOT A SIDE CHANNEL. agnsh reads fd 0 with a plain
    # `SYS_READ` and writes fd 1 with a plain `SYS_WRITE`; it has never heard of `#97` and must not
    # have to. Combined with the VFS_CHAN arms in the read/write dispatch, an unmodified program
    # spawned this way talks to its terminal exactly as it would to a pipe or a tty slave.
    # ⚠ Overwriting 0/1/2 (normally the console device) is the POINT, not a side effect — that is
    # precisely what a pty slave does to a child at setsid+TIOCSCTTY time on Linux.
    if (pty_mode != 0) {
        var sfd = 0;
        while (sfd < 3) {
            var sb = tbl + sfd * 32;
            var sk = 0;
            while (sk < 32) { store64(sb + sk, load64(cb + sk)); sk = sk + 8; }
            sfd = sfd + 1;
        }
    }
    chan_placed_fd = f;
    return f;
}
var chan_placed_fd = 0 - 1;         # the fd the last placement used — read by #43 to announce it
var CH_E_BADOP  = 2;                # unknown, reserved, or not implemented in this kernel
var CH_E_BADFD  = 5;                # not a channel fd, or authority failed (incl. an INHERITED claim)
var CH_E_ARG    = 6;                # bad buffer / length
var CH_E_FULL   = 7;                # no free channel
var CH_E_WOULDBLOCK = 8;            # ⛔ a per-record RESULT, not an error — a poll batch must not abort
var CH_E_PEERGONE   = 9;            # likewise per-record
var CH_E_OUTBUF = 3;                # CAPS out_uva/out_len invalid
var CH_E_NOREGION = 4;              # the 2 MB region is absent or unreachable from this CR3

# ⛔ ONE BIT PER IMPLEMENTED OP, and an op that is merely reserved MUST read 0 — a caller negotiates on
# this mask, so advertising an op the kernel does not run is how a client "works" against a kernel that
# cannot serve it. Bite 4a implements CAPS only. This is the `MDO_OP_SUPPORTED` pattern that grew `#93`
# across a whole arc under one number with no ABI break.
# ⭐ PTY-mode endowment sentinel for `CH_ENDOW`'s a4. > CHAN_REC_BYTES on purpose: a4 doubles as a
# record LENGTH for SEND/RECV and is not cleared between ops, so a value no length can take is the
# only safe way to read a mode out of it.
var CH_ENDOW_STDIO = 1000;

var CH_OP_SUPPORTED = 0x003F;       # bits 0-5 = CAPS/MINT/SEND/RECV/CLOSE/ENDOW. Reserved ops stay CLEAR.

# Reserve the region. Called once at boot, AFTER pmm_setup_directmap — the whole design rests on the
# direct-map alias, so reserving before it exists would hand back a VA that means something else.
fn chan_region_reserve() {
    if (chan_region_phys != 0) { return 0; }
    var p = pmm_alloc_2mb();
    if (p == 0) { return 0 - 1; }
    chan_region_phys = p;
    chan_region_kva  = DIRECTMAP_BASE + p;
    # Zero it once here rather than per-mint: a channel page must never hand a new owner the previous
    # occupant's bytes, and doing it at reserve makes that true before any channel can exist.
    memset(chan_region_kva, 0, 0x200000);
    return 0;
}

# ⭐ THE KILL-CRITERION CHECK, RUN ON EVERY `CH_CAPS` CALL. Write a sentinel through the direct-map
# alias and read it back, from whatever CR3 the caller is on. §9.9: "If the 2 MB region is not
# reachable from a spawned client's CR3, the static-region choice dies."
#
# ⚠ It writes to the LAST 8 bytes of the region, not the first: page 0 is the first channel page a
# real mint would hand out, and a probe that scribbles on it would be testing the region by corrupting
# the thing it is reserving. The tail stays out of the 32-page carve.
fn chan_region_reachable() {
    if (chan_region_kva == 0) { return 0; }
    var probe = chan_region_kva + 0x200000 - 8;
    var want = 0x4348414E4F4B4159;          # arbitrary non-zero, non-repeating
    store64(probe, want);
    if (load64(probe) != want) { return 0; }
    store64(probe, 0);
    return 1;
}

var MDO_E_NOGPU      = 1;           # call/op — GPU/display unavailable (write ops only, once they exist)
var MDO_E_BADOP      = 2;           # op    — unknown, reserved, or not implemented in this kernel
var MDO_E_OUTBUF     = 3;           # op    — CAPS out_uva/out_len invalid
var MDO_E_ARM        = 4;           # op    — M-lane: the H2 latch would not arm (blocked, or fs not writable)
var MDO_E_LOCK       = 5;           # op    — M4: gpu_otg_lock did not ack (the lock timed out)
var MDO_E_STALL      = 6;           # op    — M4: the OTG frame counter did not advance (pipe not scanning)
var MDO_E_UNDERFLOW  = 7;           # op    — M4: OPTC underflow bit10 NEWLY set (0->1) by the lock cycle
var MDO_E_NOTMODE    = 8;           # op    — M5: V_TOTAL is not the arc's calibrated 1480 (pipe not the known mode)
var MDO_E_DRR        = 9;           # op    — M5: V_TOTAL_CONTROL != 0 (DRR/VRR engaged) — untested path, refuse
var MDO_E_WEDGED     = 10;          # op    — M5: the frame-count WATCHDOG fired (pipe stopped); inherited V_TOTAL restored
var MDO_E_DESC       = 11;          # call  — bad desc_uva / len, or the copy-in failed
var MDO_E_RESERVED   = 12;          # op    — a reserved dword or an undefined field was non-zero
var MDO_E_NOCOMMIT   = 13;          # op    — M5: refresh did NOT move — the write landed in shadow, VUPDATE never swapped
var MDO_E_MODESET    = 14;          # op    — M5: refresh moved but not to the predicted value (totals/stride wrong)
var MDO_E_UNMEAS     = 15;          # op    — M5: refresh unmeasurable (pipe not scanning cleanly enough to count)
var MDO_E_NOSTOP     = 16;          # op    — M6: OTG_MASTER_EN=0 did not stop the frame counter — the disable never took
var MDO_E_NORESUME   = 17;          # op    — M6: OTG_MASTER_EN=1 did not resume the frame counter — the pipe is DARK (recover via H2)
var MDO_E_NOATOM     = 18;          # op    — M8: this kernel was not built with HDMI_ATOM, so no ATOM table can run
var MDO_E_ATOM       = 19;          # op    — M8: an ATOM step failed (vbios acquire/parse/init, or a table returned nonzero)
var MDO_E_BEFE       = 20;          # op    — M8: the BE<->FE routing bracket did not read back as written
var MDO_E_PHYDOWN    = 21;          # op    — M8e: #76 DISABLE took but ENABLE failed -> THE LINK IS DOWN (power-cycle)
var MDO_E_AUDIO      = 22;          # op    — M9: the DISPLAY survived but the audio half refused (staging or unmute)
# op — M9: the audio arm did not leave the link in HDMI signalling. MEASURED ON IRON 2026-07-24: ATOM #76
# ENABLE writes DIG_BE_CNTL back to DIG_MODE 2 itself (`atom w=566f v=10020200`), so the flip made at the
# disconnect does not survive the edge and the HDMI block is inert by the time any unmute runs. Distinct
# from MDO_E_MODESET on purpose: sharing 14 made the tool print "off-rate -- refresh did not return" for a
# SIGNALLING failure, which reads as a timing problem and sent the first M9 burn's diagnosis the wrong way.
var MDO_E_NOHDMI     = 23;
# ⭐ A NAMED REFUSAL, NOT A GENERIC FAILURE. PIXCLK derives every parameter in-kernel and one of them
# — the PLL instance — has no derivation rule yet. Returning this rather than picking a plausible
# integer is the whole point: pll_id 0/1/2 make ATOM #12 dispatch and BAIL with zero register writes,
# a clean return that is indistinguishable from success, which is exactly how phyid=0 survived six
# days pointed at a dead PHY. The tool reports "the kernel cannot name the PLL" and nobody guesses.
var MDO_E_NOPLL      = 24;
# ⭐ A DIFFERENT FACT FROM 24, AND SHARING A CODE WOULD HAVE HIDDEN IT. 24 says "this pipe has a PLL
# and the kernel cannot name which one". This says "this pipe has NO PLL — its pixel clock comes from
# the DTO, so ATOM #12 is the wrong command class entirely and no derivation rule would help." Not
# reachable on archaemenid's HDMI link (DP_DTO_ENABLE reads clear, which is why #12 IS right here),
# but a DP panel drives the DTO and would land on it. Minted with the refusal rather than after the
# first burn that hit it, on the same reasoning that put MDO_E_NOHDMI on its own number.
var MDO_E_DTOCLK     = 25;
# ── 1.56.36 NATIVE RESOLUTION. Four codes, not one, on the §1.4 rule that a red exit must name WHICH oracle
# fired. Every one of these refuses BEFORE the pipe is touched, so the panel is untouched when they return.
# op — boot_info does not describe a usable full-size 32bpp surface (no FB address, a pitch that is not a
# whole number of pixels, or a geometry outside the sane window). Means "gnoboot did not get a native mode
# from the GOP", NOT "the modeset failed" — the fix is on the bootloader side, so it must not share a code
# with anything DCN-side or the burn gets pointed at the wrong repo.
var MDO_E_NOTNATIVE  = 26;
# ⭐ THE NEVER-WRITE-BLIND CODE. The HUBP's live surface address must reconcile with boot_info's fb_phys
# through the SAME CPU->MC transform gpu_display_probe uses (fb_base + (fb_phys - BAR0)); a surface the
# kernel cannot explain is a surface the kernel must not re-point. Distinct from 26 because 26 says "there
# is no native surface to move to" and this says "there is one, but I cannot account for where the pipe is
# currently reading" — opposite diagnoses, and one shared code would hide which.
var MDO_E_SURFADDR   = 27;
# op — the viewport ALREADY reads the target geometry: the pipe is native, nothing to do. NOT a failure and
# NOT success either — the op deliberately does not blank a correct pipe to re-prove a state it can read.
# Its own code so a second `--native` in the same boot is visibly a no-op instead of a mysterious green.
var MDO_E_ALREADY    = 28;
# op — the target geometry does not EQUAL the link's active raster. With the scaler in bypass, source and
# raster must match exactly; anything else is a scaled mode wearing a bypass, which is how a "correct" pitch
# blacked this pipe once already. Refuse rather than write a mismatch and read the panel to find out.
var MDO_E_RASTER     = 29;
# op — PAN: the pan buffer could not be armed. Either the geometry is unusable, or the buffer would not fit
# below GPU_FB_PAN_LIMIT and arming it would scribble into the A/B back buffers. A refusal here leaves the
# console exactly where it was, still on the old scanout and still using the software scroll — the pan is
# a pure optimisation, so falling back to the slow path is always a correct answer.
var MDO_E_NOPAN      = 30;

# mdo_caps_write(out_uva) -> 0 / MDO_E_OUTBUF. Writes 8x u32 LE describing the modeset surface. READ-ONLY of
# kernel state; the ONLY write is to the validated user buffer, via the gpu_caps_sys direct-store idiom.
#   +0  flags  bit0 latch-armable (ext2 mounted + writable) · bit1 display lit (gpu_display_ok==1)
#              bit2 ATOM interpreter available (VBIOS acquired) · bit3 pixel clock measured
#              bit4 latch BLOCKED this boot (a previous modeset did not disarm — H2)
#   +4  op-support mask (MDO_OP_SUPPORTED)      +16 h_total          +24 pixclk_100hz
#   +8  h_active                                +20 v_total          +28 refresh milliHz (I2, 0 if unmeasured)
#   +12 v_active (0 at H3 — M1/M3 populate)
# ============================================================================================
# #94 gpu_recover_op — the rung-5 battery. One arm per call, so a wedge in one cannot be blamed
# on another, and the operator can stop after any arm.
# ============================================================================================
var RECOV_ARM_A = 1;   # controlled wedge -> the bracket must name the WAIT packet
var RECOV_ARM_B = 2;   # dequeue + re-map  -> CP_HQD_ACTIVE must read 0, then work must retire
var RECOV_ARM_C = 3;   # negative control  -> matmul bit-correct BEFORE and AFTER
var RECOV_ARM_D = 4;   # free              -> is the console still painting while wedged?
var RECOV_ARM_E = 5;   # the guard's own negative control
# ⭐ RUNG 6 (1.56.30). READ-ONLY: writes no memory and no register, so unlike arm E it is safe to run
# at any time and needs no audit of its own. It rides an existing flash at ZERO marginal burns.
var RECOV_ARM_F = 6;   # rung 6 -- audit TD-3's render-target region before anything is built there

fn gpu_recover_op_sys(arm) {
    if (gpu_present == 0) { return 0 - 1; }
    #ifdef GPU_RECOVER
    if (arm == RECOV_ARM_A) {
        kprintln("recover: ARM A -- controlled wedge; the bracket must name the WAIT packet", 73);
        gpu_breadcrumb_seq = 2;
        store32(gpu_arena_phys + GPU_BREADCRUMB_SUBOFF, 0);
        gpu_mfence();
        gpu_submit_wedge();
        gpu_ring_kick();
        # ⚠ A SHORT bound on purpose. R-1 is "distinguish slow from hung": 100 ms is ~1000x any
        # dispatch agnos has ever measured, so a timeout here is a hang, not slowness.
        var done_phys = gpu_arena_phys + GPU_SHADER_DONE_SUBOFF;
        store32(done_phys, 0);
        var ok = gpu_wait_done(done_phys, GPU_C2F_DONE, 100000);
        if (ok == 1) {
            kprintln("recover: ARM A FAILED -- the wedge RETIRED. The WAIT packet is wrong,", 69);
            kprintln("recover: so nothing was actually hung and arms B-E prove nothing.", 65);
            return 0 - 2;
        }
        kprintln("recover: ARM A -- wedged as designed; forensic block above is the oracle", 72);
        return 95;
    }
    if (arm == RECOV_ARM_B) {
        kprintln("recover: ARM B -- dequeue + re-map", 34);
        var r = gpu_recover_escalate();
        kprint("recover: ladder reached rung R-", 31); kprint_num(gpu_recover_rung);
        kprintln("", 0);
        if (r == 0) { return 0 - 4; }
        return 95;
    }
    #endif
    if (arm == RECOV_ARM_C) {
        # ⛔ THE NEGATIVE CONTROL, and it is the arm that decides whether recovery is WORTH
        # having: if the matmul is not bit-correct after a recovery, the recovery is worse than
        # the hang and R-4 (give up cleanly) becomes the default on any ambiguity.
        kprintln("recover: ARM C -- negative control, matmul must be bit-correct", 62);
        # ⚠ Re-run the REAL integer matmul and read gpu_matmul_ok — the same bit-correctness
        # check the compute arc proved on iron. Not a new oracle invented for this arm: reusing
        # the proven one is what makes "before and after" comparable.
        gpu_shader_dispatch5();
        if (gpu_matmul_ok != 1) {
            kprintln("recover: ARM C FAILED -- matmul NOT bit-correct. Recovery is worse than", 71);
            kprintln("recover: the hang; R-4 must become the default on any ambiguity.", 64);
            return 0 - 3;
        }
        kprintln("recover: ARM C -- matmul bit-correct", 36);
        return 95;
    }
    if (arm == RECOV_ARM_F) {
        # ⭐ RUNG 6 — TD-3's render-target region audit. Rung 17's depth buffer is the first buffer
        # too large for the 2 MB command arena, so this is the gate that has to pass before
        # GPU_RT_REGION_OFF is built on. READ-ONLY throughout.
        # ⚠ A REFUSAL IS A SUCCESSFUL RUN. The whole point is to find out here, for free, rather than
        # by corrupting the PSP TMR — whose ucode agnos re-loads only at boot.
        kprintln("recover: ARM F -- rung 6 render-target region audit", 51);
        if (gpu_rt_arena_audit() != 1) {
            kprintln("recover: ARM F -- the region is NOT provably free. TD-3 must not be built.", 74);
            return 0 - 6;
        }
        return 95;
    }
    if (arm == RECOV_ARM_E) {
        # ⛔⛔ ARM E — THE GUARD'S OWN NEGATIVE CONTROL, and it is the arm that has been owed
        # since S6. That bite shipped an EXEC guard at w=200 with NO unguarded arm, so
        # "the guard stopped the overrun" is INFERRED, not measured — and every ring-3-specified
        # triangle's memory safety rests on it (rung 12 onward).
        #
        # ⛔ IT FIRES AN UNGUARDED WRITE, so it may ONLY run at an address rung 6 has PROVEN
        # unclaimed. With VM_CONTEXT0 disabled there are no page tables: an out-of-bounds store
        # lands somewhere REAL — the console framebuffer at offset 0, or the PSP TMR whose ucode
        # agnos re-loads only at boot. Running the control arm without the audit would make the
        # control itself the accident.
        kprintln("recover: ARM E -- the EXEC guard's negative control", 51);
        if (gpu_arena_audit() != 1) {
            kprintln("recover: ARM E REFUSED -- the arena audit did not pass. Nothing written.", 72);
            return 0 - 5;
        }
        var sac = gpu_arena_phys + GPU_SACRIFICIAL_SUBOFF;
        store32(sac, 0);
        gpu_mfence();
        kprint("recover: sacrificial slot pre-state ", 36);
        kprint_hex(load32(sac) & 0xFFFFFFFF); kprintln("", 0);
        # ⚠ The two halves must be distinguishable in the log, because "both untouched" is a
        # REAL and uninformative outcome: it means the negative arm never fired and the guard
        # remains exactly as unmeasured as before.
        kprintln("recover: (guarded and unguarded dispatch arms are a rung-12 dependency --", 73);
        kprintln("recover:  this build proves the AUDIT gate and the slot, not the guard yet)", 75);
        var seen = load32(sac) & 0xFFFFFFFF;
        kprint("recover: sacrificial slot post-state ", 37);
        kprint_hex(seen); kprintln("", 0);
        return 95;
    }
    if (arm == RECOV_ARM_D) {
        # Free: it rides whatever state the box is already in.
        kprintln("recover: ARM D -- is the console still painting? EYE-CHECK the panel.", 69);
        kprint("recover: gpu_wedged=", 20); kprint_num(gpu_wedged);
        kprint(" recover_rung=", 14); kprint_num(gpu_recover_rung); kprintln("", 0);
        kprintln("recover: if you can read this ON THE PANEL, the console survived a dead GPU", 75);
        kprintln("recover: -- the load-bearing assumption under the whole GFX risk model.", 71);
        return 95;
    }
    return 0 - 1;
}

fn mdo_caps_write(out_uva) {
    if (is_user_range(out_uva, 32) == 0) { return MDO_E_OUTBUF; }
    var flags = 0;
    if (ext2_active != 0) { if (ext2_write_ok != 0) { flags = flags | 1; } }
    if (gpu_display_ok == 1) { flags = flags | 2; }
    if (gpu_vbios_va != 0) { flags = flags | 4; }
    if (gpu_pixclk_100hz != 0) { flags = flags | 8; }
    if (modeset_latch_blocked != 0) { flags = flags | 16; }
    store32(out_uva +  0, flags);
    store32(out_uva +  4, MDO_OP_SUPPORTED);
    store32(out_uva +  8, gpu_h_active);
    store32(out_uva + 12, gpu_v_active);
    store32(out_uva + 16, gpu_h_total);
    store32(out_uva + 20, gpu_v_total);
    store32(out_uva + 24, gpu_pixclk_100hz);
    store32(out_uva + 28, gpu_refresh_mhz);
    return 0;
}

# ── M1·M2·M3 read-only DCN pipe dump (MODESET_OP_DUMP) ───────────────────────────────────────────────
# Progressive `rd <off> <val>` (both DECIMAL, matching gpu_scanout_regdump) — one kprint PER register, so a
# read that hangs a power-gated domain localises to the LAST line printed (risk R1; the hang IS the finding).
# ⛔ NAMED OFFSETS ONLY, all H7-anchored, all in known-ungated domains — NEVER a blind range scan (a blind
# OTG/DCCG sweep locked archaemenid 2026-07-17). Captured on iron via `run /bin/klug > m1.txt`.
# The dump doubles as the H5 snapshot seed (a host script parses `rd <off> <val>` into the snapshot table).
# Pipe/instance 0 (archaemenid's live pipe; guarded below).
fn mdo_rd2(off) {                                    # BASE_IDX 2 (GPU_BASE_DCN_2) read + progressive print
    var v = gpu_reg32(GPU_BASE_DCN_2, off) & 0xFFFFFFFF;
    kprint("rd ", 3); kprint_num(off); kprint(" ", 1); kprint_num(v); kprintln("", 0);
    return 0;
}
fn mdo_rd1(off) {                                    # BASE_IDX 1 (GPU_BASE_DCN_1) — tagged `rd1` so the host decoder knows the base
    var v = gpu_reg32(GPU_BASE_DCN_1, off) & 0xFFFFFFFF;
    kprint("rd1 ", 4); kprint_num(off); kprint(" ", 1); kprint_num(v); kprintln("", 0);
    return 0;
}
# ⚠ mdo_rd2a — read a BASE_IDX 2 register named by its ABSOLUTE dword (the form the amdgpu / GOP-DVI
# captures print as `abs=0x5d2d`). gpu_reg32 ADDS the IP base (GPU_BASE_DCN_2 = 0x34C0), so an absolute
# offset must have the base SUBTRACTED first or it double-folds to (base + abs) — the exact bug that made
# the 1.56.11 M2 dump read garbage (0/0xFFFFFFFF) at 0x92B0 instead of the PHY at abs 0x5d2d. Prints the
# ABSOLUTE offset so the output diffs directly against the abs-labelled prior-art. Use ONLY for offsets the
# plan lists as "BASE_IDX 2 absolute" (the M2 PHY/RDPCS group); everything else is base-relative (mdo_rd2).
# ⛔⛔ TAG CHANGED `rd ` -> `rda ` AT 1.56.33. This printer emits an ABSOLUTE dword while mdo_rd2 emits a
# BASE_IDX-2-RELATIVE one, and for four groups (M2-PHY/RDPCS, M8-76readset, M8-digbe, M12-pixclk) they
# shared the tag `rd ` — in a scheme where `rd1` exists for no other reason than to tell the host decoder
# which base a line is in. m1-decode.py consequently wrote every `rd` line into the ATOM seed as absolute,
# so 87 of the last capture's 97 entries were RELATIVE offsets labelled ABSOLUTE (H_TOTAL's value filed at
# 0x1B2A when its absolute index is 0x4FEA).
# ⭐ Harmless until now purely by luck: #4, #76 and #12 read only the groups this printer emits, so every
# seed that ever mattered was correct. The cold path is the first consumer that needs raster registers —
# exactly the mislabelled ones — so the ambiguity is removed BEFORE a seed is trusted for a write.
# ⚠ Legacy captures stay decodable: with no `rda` line present, m1-decode.py resolves `rd` by GROUP HEADER
# (those same four groups are absolute) and says which rule it applied.
fn mdo_rd2a(abs) {
    var v = gpu_reg32(GPU_BASE_DCN_2, abs - GPU_BASE_DCN_2) & 0xFFFFFFFF;
    kprint("rda ", 4); kprint_num(abs); kprint(" ", 1); kprint_num(v); kprintln("", 0);
    return 0;
}
fn mdo_dump() {
    # Needs the GPU aperture mapped. On QEMU gpu_present == 0 -> refuse (no DCN to read).
    if (gpu_present == 0) { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) {
        # The offset list below is instance-0 (OTG0/HUBP0/MPCC0). On archaemenid the live pipe is 0; a
        # non-zero live pipe would need per-instance indexing, so refuse rather than dump the wrong pipe.
        kprintln("modeset: dump refused -- live pipe is not 0", 43);
        return MDO_E_NOGPU;
    }
    # ⭐ THE TAG CARRIES THE COORDINATE SYSTEM. Three of them, and a decoder needs all three:
    #   rd  = BASE_IDX 2 RELATIVE (add 0x34C0 for the absolute dword the ATOM tables use)
    #   rd1 = BASE_IDX 1 RELATIVE (add 0xC0)
    #   rda = ABSOLUTE already
    kprintln("modeset: dump begin (offset value, both decimal; rd=+0x34C0 rd1=+0xC0 rda=absolute)", 83);

    kprintln("modeset: dump group M1-OTG0", 27);
    mdo_rd2(0x1B2A); mdo_rd2(0x1B2B); mdo_rd2(0x1B2C); mdo_rd2(0x1B2D); mdo_rd2(0x1B2E);
    mdo_rd2(0x1B2F); mdo_rd2(0x1B30); mdo_rd2(0x1B31); mdo_rd2(0x1B33); mdo_rd2(0x1B36);
    mdo_rd2(0x1B37); mdo_rd2(0x1B38); mdo_rd2(0x1B39); mdo_rd2(0x1B41); mdo_rd2(0x1B44);
    mdo_rd2(0x1B82); mdo_rd2(0x1B86); mdo_rd2(0x1B87); mdo_rd2(0x1B88); mdo_rd2(0x1B89); mdo_rd2(0x1B8A);
    kprintln("modeset: dump group M1-VTG", 26);
    mdo_rd2(0x0528);
    kprintln("modeset: dump group M1-OPTC", 27);
    mdo_rd2(0x1ACA); mdo_rd2(0x1ACB); mdo_rd2(0x1ACC); mdo_rd2(0x1ACF); mdo_rd2(0x1AD0);
    kprintln("modeset: dump group M1-OPP/FMT", 30);
    mdo_rd2(0x183F); mdo_rd2(0x1840); mdo_rd2(0x1841); mdo_rd2(0x1845);
    mdo_rd2(0x1849); mdo_rd2(0x1854); mdo_rd2(0x1884); mdo_rd2(0x188C);
    kprintln("modeset: dump group M1-MPC", 26);
    mdo_rd2(0x1271); mdo_rd2(0x1272); mdo_rd2(0x1273); mdo_rd2(0x1274); mdo_rd2(0x127F); mdo_rd2(0x1385);
    kprintln("modeset: dump group M1-HUBP0", 28);
    mdo_rd2(0x05E5); mdo_rd2(0x05E7); mdo_rd2(0x05EA); mdo_rd2(0x05F3); mdo_rd2(0x05F4);
    mdo_rd2(0x0607); mdo_rd2(0x060A); mdo_rd2(0x060B); mdo_rd2(0x061A); mdo_rd2(0x066C);
    kprintln("modeset: dump group M1-PG", 25);
    mdo_rd2(0x0080); mdo_rd2(0x0082); mdo_rd2(0x00B2);
    kprintln("modeset: dump group M1-BASE1", 28);
    mdo_rd1(0x40); mdo_rd1(0x41); mdo_rd1(0x80); mdo_rd1(0x81); mdo_rd1(0x82); mdo_rd1(0x99);
    mdo_rd1(0x9A); mdo_rd1(0x9B); mdo_rd1(0x9C); mdo_rd1(0xB6); mdo_rd1(0xAB); mdo_rd1(0xAC); mdo_rd1(0xAD);

    # ⚠ M2 offsets are ABSOLUTE dwords (the plan lists them "BASE_IDX 2 absolute") — use mdo_rd2a, which
    # subtracts the base before gpu_reg32 re-adds it. Passing them to mdo_rd2 double-folds (the 1.56.11 bug).
    kprintln("modeset: dump group M2-PHY/RDPCS", 32);
    mdo_rd2a(0x5D2D); mdo_rd2a(0x5D2E); mdo_rd2a(0x5D2F); mdo_rd2a(0x5D30); mdo_rd2a(0x5DF0);
    mdo_rd2a(0x5E00); mdo_rd2a(0x5E06); mdo_rd2a(0x5EC8); mdo_rd2a(0x5ED8); mdo_rd2a(0x5EDE);

    kprintln("modeset: dump group M3-scaler", 29);
    mdo_rd2(0x0CEC); mdo_rd2(0x0CF1); mdo_rd2(0x0D03); mdo_rd2(0x016B);

    # ── M8b: the EXACT read-set ATOM #76 (DIG1TransmitterControl) touches ────────────────────────────
    # Provenance: `atom-interp.py --command transmitter --action enable --phyid 0` on the real VBIOS, which
    # reports `REG reads=21 REG writes=17 delays=5` over these 16 distinct indices. So these are NOT a range
    # scan — they are the precise offsets the firmware itself reads, which is the strongest possible warrant
    # for reading them (if a read here hung, #76 could never run at all).
    #
    # WHY THIS GROUP EXISTS: H5's snapshot-seeded DRY replays REAL captured values into atom_reg_read so the
    # interpreter takes the branches iron would take. With no seed the reads return 0 and the DRY proves only
    # that the decoder walks *a* path — not the path #76 will actually take. agnos has never validly read
    # this domain: M1's M2 group double-folded the IP base and read garbage at 0x92xx, so the PHY has NEVER
    # been seen from agnos. Capturing it here is what makes M8b's DRY meaningful BEFORE M8e runs #76 live.
    #
    # ⚠ Reads only, printed progressively (R1) — a hang localises to the last line and IS the finding. The
    # 0x55xx block (UNIPHY power/link) is outside the plan's stated vetted set {DCCG 0xC0-0x1FF, OTG/OPTC
    # 0x1A00-0x1BFF, DIG 0x2xxx, PHY 0x5Dxx-0x5Exx}; that set is INCOMPLETE for #76, which is itself a
    # finding — see the M8 tracker. Discovering it with a read-only dump is strictly safer than discovering
    # it mid-#76 with the pipe disabled.
    kprintln("modeset: dump group M8-76readset", 32);
    mdo_rd2a(0x5535); mdo_rd2a(0x556F); mdo_rd2a(0x5570); mdo_rd2a(0x55A1);
    mdo_rd2a(0x5DE9); mdo_rd2a(0x5DF7); mdo_rd2a(0x5DFC); mdo_rd2a(0x5E03);
    mdo_rd2a(0x5E0F); mdo_rd2a(0x5E10); mdo_rd2a(0x5E11); mdo_rd2a(0x5E12);

    # ── The per-instance DIG BACK END — what `phyid` actually indexes ───────────────────────────────
    # Added after the M8d seed could NOT derive phyid: it carried instance 0's BE registers (they came from
    # #76's own phyid=0 read-set) and nothing for instances 1-4, so both the kernel's gpu_phy_discover()
    # and the host tool had to fall back to the object-table GUESS — the guess that aimed #76 at a dead PHY.
    # With this group a captured seed is self-sufficient: the live link encoder is the instance that is
    # ENABLED (DIG_BE_EN_CNTL bit0), has a front end routed (FE_SOURCE_SELECT != 0) and carries a real
    # signalling mode (DIG_MODE 2=DVI / 3=HDMI). DIG_BE_CNTL abs = 0x556F + N*0x100, DIG_BE_EN_CNTL +1.
    # ⚠ Safe: the boot audio probe already reads exactly these ten registers on every boot.
    # Instances 1-4 only — 0x556F/0x5570 are already in the M8-76readset group above.
    kprintln("modeset: dump group M8-digbe", 28);
    mdo_rd2a(0x566F); mdo_rd2a(0x5670);
    mdo_rd2a(0x576F); mdo_rd2a(0x5770);
    mdo_rd2a(0x586F); mdo_rd2a(0x5870);
    mdo_rd2a(0x596F); mdo_rd2a(0x5970);

    # ── ATOM #12's READ SET — so a captured seed can actually drive SetPixelClock ────────────────
    # ⛔⛔ THIS GROUP EXISTS BECAUSE #76 TAUGHT THE LESSON THE EXPENSIVE WAY. M8b found that agnos had
    # NEVER validly read any of #76's sixteen indices, so a zero-seed dry run proved only that the
    # decoder walks *a* path — and it took a real snapshot to expose the poll storm at the wrong
    # phyid. #12 is at exactly that stage right now: its footprint is measured at ZERO SEED, and the
    # value of the next burn is entirely whether these registers come back with real contents.
    # ⭐ THE SET WAS FOUND BY SWEEPING, NOT BY ONE TRACE. A single run at crtc=0 shows only
    # 0x140/0x141; sweeping crtc_id 0..1 and pll_id 3..8 adds 0x144/0x145 (the per-pipe stride) plus
    # reads at 0x5001 and 0x5081. Both pipes are captured because the seed must be usable whichever
    # pipe is live, and 0x5001/0x5081 are captured even though their block is NOT yet identified —
    # ⚠ an unnamed register that the command reads is exactly the kind of thing a dump must carry,
    # since the alternative is discovering the gap during adjudication.
    # ⚠ LOWER BOUND, deliberately stated: every read in that sweep returned 0, so the table walked a
    # zeroed machine's branches. Real values may steer it somewhere with a wider read set.
    # ⛔ WIDENED AFTER BURN 1. The first version captured only the two indices #12 WRITES, and both
    # read ZERO on the live pipe — a true reading that told us almost nothing on its own. The live
    # value in this block turned out to sit one dword further on, at 0x142 (598,875,000, ~599 MHz),
    # which only the pre-existing M1-BASE1 group happened to catch. ⇒ Capture the NEIGHBOURHOOD, not
    # just the write set: a command's write targets and a block's live contents are different
    # questions, and a dump scoped to the former cannot answer the latter.
    kprintln("modeset: dump group M12-pixclk", 30);
    mdo_rd2a(0x0140); mdo_rd2a(0x0141); mdo_rd2a(0x0142); mdo_rd2a(0x0143);
    mdo_rd2a(0x0144); mdo_rd2a(0x0145); mdo_rd2a(0x0146); mdo_rd2a(0x0147);
    mdo_rd2a(0x5001); mdo_rd2a(0x5081);

    # ── M12-pllblk: the COMBO-PHY PLL instances #12's pll_id 20-24 actually select ──────────────────
    # ⭐⭐ DERIVED, NOT GUESSED, AND CONFIRMED TWO WAYS. The 2026-07-30 full-space sweep showed `pll_id`
    # 20-24 write five distinct blocks on a 0xD8 stride; that is the RDPCSTX per-instance stride the M2
    # group already uses (0x5EC8 - 0x5DF0 = 0xD8), so pll_id 20+N selects RDPCSTX instance N. The write
    # sets confirm it independently — pll_id 22 writes 0x5FA1/0x5FA3/0x5FA7/0x5FB0, exactly instance 2's
    # base 0x5FA0 neighbourhood; 23 lands on 0x6078; 24 on 0x6150.
    # ⛔ AND THIS GROUP EXISTS BECAUSE THE LAST SEED COULD NOT ADJUDICATE THEM. Re-running #12 against
    # the real snapshot, pll_id 22/23/24 poll 0x5FB0 / 0x6088 / 0x6160 — none of which the dump captured,
    # so they read 0 forever and storm. That storm is an ARTIFACT OF AN INCOMPLETE CAPTURE and carries no
    # information about silicon, which is a completely different fact from pll_id 20's storm (it polls
    # 0x5DFC and 0x5E03, both seeded with REAL values, i.e. the #76 wrong-instance signature).
    # ⇒ With instances 2-4 captured, the next seeded sweep can run the discriminator that settled `phyid`:
    # the correct instance completes clean while the wrong ones storm. Instances 0 and 1 are already in
    # the M2 group, so only 2-4 are added here — three registers each, mirroring M2's coverage exactly.
    # ⛔⛔ THE FIRST VERSION OF THIS GROUP CAPTURED 3 REGISTERS PER INSTANCE BY MIRRORING M2's GROUP,
    # AND THE 2026-07-30 BURN PROVED THAT WAS THE WRONG DERIVATION. `#12` reads NINETEEN registers per
    # instance, and M2's three (+0x00, +0x10, +0x16) are not the ones it polls. So all five candidates
    # still storm on unsatisfiable reads, and NONE of the five could be adjudicated — including the
    # three a tail-of-trace sample had made look like real evidence.
    # ⭐ THE LESSON, THIRD TIME IN THIS CUT: a SAMPLE IS NOT THE SHAPE. First `crtc_id` was swept when
    # `pll_id` was the axis; then `pll_id` 3-8 stood in for the whole space; then the last four reads of
    # a trace stood in for its read set. Each time the sample looked like an answer.
    # ⭐ SO THIS SET IS DERIVED FROM #12's OWN MEASURED READS, not from another command's group and not
    # by scanning: the union of relative offsets it reads inside an instance block is
    #   +01 +03 +05 +07 +0C +10 +12 +13 +14 +16 +1A +1B +1C +1D +1E +1F +20 +21 +22
    # identical across instances 0, 3 and 4 (1 and 2 read a subset only because their partial seeds
    # make the table bail sooner). Instance N sits at 0x5DF0 + N*0xD8 — verified against all five bases.
    # ⚠ NOT A BLIND RANGE SCAN, which is forbidden here and locked this box on 2026-07-17: every offset
    # is one the command demonstrably reads, and the 2026-07-30 burn already read 0x5FA0/0x5FB0/0x5FB6,
    # 0x6078/0x6088/0x608E and 0x6150/0x6160/0x6166 without a hang, so these blocks are reachable.
    # The per-register progressive print is retained, so a hang still localises to its last line.
    # ⚠ LOWER BOUND, stated as always: the read set was measured against a partly-zero seed, so seeding
    # these may steer the table further. If the next sweep still cannot adjudicate, re-derive from ITS
    # traces rather than assuming this set is final.
    # ⛔⛔⛔ THE 2026-07-30 WIDE BURN PROVED THIS GROUP CAN POISON THE REGISTER APERTURE, and the
    # trigger is named: **reading 0x5FA5 (instance 2, offset +05) returns 0xFFFFFFFF and every read
    # after it — for the WHOLE REST OF THE BOOT — returns 0xFFFFFFFF too.** Instances 0 and 1 read all
    # nineteen offsets cleanly; instance 2 read +01 and +03 cleanly and died at +05; instances 3 and 4
    # were all-ones from their first read. ⭐ It is NOT a property of those registers: the previous
    # burn read 0x5FB0/0x5FB6/0x6088/0x608E/0x6160/0x6166 and got REAL values from every one. The wide
    # read killed them.
    # ⛔ AND THE DAMAGE OUTLIVED THE DUMP: the very next command, `modeset --pixclk`, read
    # OTG_INTERLACE_CONTROL as garbage and reported "display timing is interlaced" — a pipe that is
    # progressive — so it refused with reason 1 instead of deriving the clock. The whole aperture was
    # returning all-ones by then. Non-fatal (console and shell survived), but every register read after
    # the trigger in that boot is VOID.
    # ⇒ THE JUSTIFICATION THAT FAILED, recorded so it is not repeated: the offsets were defended as
    # "not a blind range scan — every one is a register the command demonstrably reads". That is true
    # and it is NOT SUFFICIENT. The read set came from a DRY RUN over a snapshot: it says what the ATOM
    # bytecode WOULD read, not what is safe to touch on this silicon. Reachability must be established
    # per-register on iron, not inherited from an interpreter trace.
    #
    # ⭐ SO THE SET IS NOW BOUNDED BY WHAT IRON HAS ACTUALLY SURVIVED, on both sides:
    #   • instances 0 and 1 — the full offset set, every one of which read cleanly on the wide burn,
    #     plus +17 (0x5EDF), the ONE register `pll_id=21` still needs and which sits between two
    #     offsets (+16, +1A) that both read clean on instance 1.
    #   • instances 2, 3, 4 — ONLY +00, +10, +16, the three the PREVIOUS burn read and survived.
    #     ⛔ Do not extend these without a per-register iron probe; +05 is proven destructive.
    # ⚠ COST, STATED: `pll_id` 22/23/24 stay unadjudicable. That is the price of not poisoning the
    # aperture, and it is the right trade — `pll_id=20` is now fully seeded and ELIMINATED on evidence,
    # so 21 is the live candidate and it needs instance 1, not instances 2-4.
    kprintln("modeset: dump group M12-pllblk", 30);
    var pinst = 0;
    var pb = 0;
    while (pinst < 2) {
        pb = 0x5DF0 + pinst * 0xD8;
        mdo_rd2a(pb + 0x01); mdo_rd2a(pb + 0x03); mdo_rd2a(pb + 0x05); mdo_rd2a(pb + 0x07);
        mdo_rd2a(pb + 0x0C); mdo_rd2a(pb + 0x10); mdo_rd2a(pb + 0x12); mdo_rd2a(pb + 0x13);
        mdo_rd2a(pb + 0x14); mdo_rd2a(pb + 0x16); mdo_rd2a(pb + 0x17); mdo_rd2a(pb + 0x1A);
        mdo_rd2a(pb + 0x1B); mdo_rd2a(pb + 0x1C); mdo_rd2a(pb + 0x1D); mdo_rd2a(pb + 0x1E);
        mdo_rd2a(pb + 0x1F); mdo_rd2a(pb + 0x20); mdo_rd2a(pb + 0x21); mdo_rd2a(pb + 0x22);
        pinst = pinst + 1;
    }
    # ⛔ Instances 2-4: the previously-survived three offsets ONLY. Never the wide set.
    pinst = 2;
    while (pinst < 5) {
        pb = 0x5DF0 + pinst * 0xD8;
        mdo_rd2a(pb + 0x00); mdo_rd2a(pb + 0x10); mdo_rd2a(pb + 0x16);
        pinst = pinst + 1;
    }

    kprintln("modeset: dump end -- 160 registers (M1 67 + M2 10 + M3 4 + M8 12 + DIGBE 8 + PIXCLK 10 + PLLBLK 49)", 99);
    return 0;
}

# ── M4 OTG-lock proof (MODESET_OP_LOCK) ──────────────────────────────────────────────────────────────
# Prove the commit primitive on the LIVE pipe with NOTHING at stake, so the lock MECHANISM is what gets
# validated, isolated from any real mode change. The sequence is the full one M5/M7 build the timing writes
# on — take the OTG master update lock, write a register, re-arm the surface (VUPDATE trigger), release —
# but the register written is V_TOTAL set back to the EXACT bits it already holds. Every value is preserved,
# so a correct run is INVISIBLE on the panel: the evidence lives in the instruments, never in a readback (a
# DCN readback is a SHADOW read — see gpu_dcn_write_committed). Pass = all three of:
#   · the lock ACKED (gpu_otg_lock_acked == 1) — the poll is bounded and proceeds on timeout, so an unacked
#     lock is indistinguishable from a taken one unless it is reported (this cost burn 2 of the D lane);
#   · I1 (OTG_STATUS_FRAME_COUNT) ADVANCED across the hold — the pipe never froze under the lock (a lock
#     left held freezes the pipe on its last frame, which LOOKS exactly like a successful hold);
#   · OPTC underflow (sticky bit10) was not NEWLY set (0 -> 1) by the lock/unlock cycle.
# ⚠ SCOPE OF THE PROOF: a green M4 proves the lock ENGAGES and the live pipe SURVIVES the lock/unlock cycle —
# NOT that a write commits shadow -> VUPDATE -> live. Because V_TOTAL is written back to its OWN value,
# "committed", "reached shadow only" and "never left shadow" are indistinguishable to every M4 instrument (the
# readback is a shadow read; I1 advances regardless; an identical value cannot induce underflow). Proving a
# write actually COMMITS is M5's job (V_TOTAL 1480 -> 1500, measured as a refresh change on I2). Do not read a
# green M4 as "commit proven" — that conflation is the D-lane's "assumed committed" error.
# Arming happens HERE, at the ring-3 op (S12's preferred site): reaching this code proves the shell ran, so
# "the shell was reached" is a PRECONDITION of arming rather than a postcondition to prove. THE GATE inside
# gpu_dcn_write_committed refuses the write unless this arm set the token. Re-runnable in one boot (the arm
# overwrites in place); the operator disarms with `rm /.modeset-armed` when done.
fn mdo_lock() {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }      # QEMU: no DCN aperture to lock
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: lock refused -- live pipe is not 0", 43); return MDO_E_NOGPU; }
    var pipe = 0;
    # Arm the H2 latch. modeset_arm refuses if a previous boot did not disarm (blocked), or the fs is not
    # writable; on refusal nothing below runs and the pipe is untouched.
    if (modeset_arm(4) != 1)   { kprintln("modeset: lock refused -- latch would not arm", 44); return MDO_E_ARM; }

    # Instruments + the write-back source, BEFORE. The no-op property is that vt_raw is V_TOTAL's OWN current
    # value — NOT that "raw is safer": writing back the exact 32 bits just read (reserved included) reprograms
    # V_TOTAL to what it already was, so even a fully-latched VUPDATE changes nothing. ⛔ M5/M7 write DIFFERENT
    # values and must mask/derive deliberately — do not carry "write the raw dword" forward from here.
    var fc0    = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    var unf0   = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var vt_raw = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL) & 0xFFFFFFFF;

    kprint("modeset: lock begin pipe 0 vtotal ", 34); kprint_num(vt_raw & GPU_OTG_TOTAL_MASK);
    kprintln(" (written back unchanged)", 25);

    # Reset the ack BEFORE the committed write so it unambiguously reflects THIS op's lock, not a stale value
    # from a prior modeset op in the same boot (gpu_otg_lock_acked is a boot-persistent global; if the GATE
    # ever refused the write it would never call gpu_otg_lock, and a stale 1 would read as a phantom ack).
    gpu_otg_lock_acked = 0;
    # The whole lock -> write -> VUPDATE -> unlock cycle for V_TOTAL, to its own value. Carries THE GATE.
    var rb   = gpu_dcn_write_committed(pipe, GPU_R_OTG_V_TOTAL, GPU_DCN_OTG_STRIDE, vt_raw);
    # Hold ~120 ms (~7 frames at 60 Hz) so I1 has room to move even if a frame or two is missed.
    var held = gpu_dcn_hold_ms(120);

    # Instruments AFTER.
    var fc1  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    var unf1 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var advanced = 0;
    if (fc1 != fc0) { advanced = 1; }

    kprint("modeset: lock ack ", 18); kprint_num(gpu_otg_lock_acked);
    kprint(" readback ", 10); kprint_num(rb & GPU_OTG_TOTAL_MASK);
    kprint(" hold ", 6); kprint_num(held); kprintln(" ms", 3);
    kprint("modeset: I1 frames ", 19); kprint_num(fc0); kprint(" -> ", 4); kprint_num(fc1);
    kprint(" advanced ", 10); kprint_num(advanced); kprintln("", 0);
    kprint("modeset: underflow bit10 ", 25); kprint_num(unf0); kprint(" -> ", 4); kprint_num(unf1); kprintln("", 0);

    # Verdict. Lock first — an unacked lock invalidates every observation after it. Then pipe-alive.
    if (gpu_otg_lock_acked != 1) { kprintln("modeset: LOCK FAILED -- master update lock did not ack", 54); return MDO_E_LOCK; }
    if (advanced == 0)           { kprintln("modeset: STALL -- I1 did not advance across the lock cycle -- pipe wedged", 73); return MDO_E_STALL; }
    # ⚠ Underflow is a DELTA, not an absolute. OPTC bit10 is a STICKY latch nothing in the kernel clears, so
    # it may ALREADY read 1 from earlier boot/HUBP bring-up (it DID during the retired D lane — see
    # iron-nuc-zen-log Attempt 1: an absolute check there "passed by construction" on a pre-set bit; an
    # absolute check HERE would instead FALSE-FAIL). Convict M4 only when the lock/unlock cycle CAUSED the
    # underflow (0 -> 1). A pre-existing 1 is reported, not fatal — though it weakens the I1 survival proof
    # (the OTG counter advances on its own PLL even while the pipe underflows black), so the tracker reads a
    # 1 -> 1 as "disregard + note", never a clean pass.
    if (unf0 == 0) {
        if (unf1 != 0) { kprintln("modeset: UNDERFLOW -- lock cycle set OPTC bit10 (scanout corrupted)", 67); return MDO_E_UNDERFLOW; }
    }
    if (unf0 != 0) { kprintln("modeset: NOTE underflow bit10 was already set BEFORE the lock -- pre-existing, not M4", 85); }
    kprintln("modeset: LOCK OK -- acked, pipe survived the lock cycle, no underflow caused", 76);
    return 0;
}

# ── M5 the first REAL modeset (MODESET_OP_VTOTAL): V_TOTAL 1481 -> 1501 -> 1481, oracled off I2 ─────────
# This is the bite M4 sets up but cannot itself deliver: proof that a write COMMITS shadow -> VUPDATE -> live.
# It moves v_total (register field + 1) from 1481 to 1501 at CONSTANT pixel clock and CONSTANT H timing —
# the one raster field a sink tolerates moving without a re-lock — and the OTG's own frame counter is the
# proof: refresh = pixclk / (h_total * v_total), so 1481 -> 1501 drops the measured refresh 59.951 -> 59.152
# Hz, a ~13,300 ppm step against a 12-17 ppm noise floor. The operator looks at NOTHING; the oracle is I2
# (gpu_refresh_measure), printed to klug. ⚠ The prediction is computed from the WRITTEN v_total, never a
# read-back (a DCN read-back is a shadow read). Run as A (baseline, no write) / B (1501) / C (restore 1481).
#
# ⛔ NOT an "identity modeset" (disable -> same values -> enable): phase A is a pure MEASUREMENT of the
# inherited refresh, and the only writes are B (the real change) and C (the restore), so success and the two
# failure pictures are DISTINGUISHABLE by the number — the trap D-lane burn 1 fell into is avoided.
var mdo_wedged = 0;   # set 1 by mdo_vtotal_phase when the frame-count watchdog fires (and it restored)

# mdo_vtotal_phase — write V_TOTAL to vt_reg under the OTG lock, then run the SELF-RECOVERING FRAME-COUNT
# WATCHDOG: the pipe must keep scanning, so gpu_display_wait_vblank must see the counter advance. If it does
# NOT (a wedge), restore the inherited V_TOTAL immediately, set mdo_wedged, and return 0 — the console
# recovers in-kernel even though the operator cannot see it (I1 is the only thing that can, and it just did).
# On success, settle a few frames and return the measured refresh in milliHz (I2). vt_orig is the raw
# inherited register field, restored verbatim on a wedge. THE GATE lives inside gpu_dcn_write_committed.
fn mdo_vtotal_phase(pipe, vt_reg, vt_orig) {
    var rb = gpu_dcn_write_committed(pipe, GPU_R_OTG_V_TOTAL, GPU_DCN_OTG_STRIDE, vt_reg);
    var alive = gpu_display_wait_vblank(pipe);
    if (alive == 0) {
        kprintln("modeset: WATCHDOG -- frame counter STOPPED after write, restoring inherited V_TOTAL", 83);
        gpu_dcn_write_committed(pipe, GPU_R_OTG_V_TOTAL, GPU_DCN_OTG_STRIDE, vt_orig);
        # ⚠ The restore commits via VUPDATE, which needs a SCANNING pipe — the very thing that just stopped.
        # So re-check the counter and report HONESTLY: if it resumed, the console is back; if not, the restore
        # could not latch and only H2 (one bad boot + `rm /.modeset-armed`) recovers. Never claim "restored"
        # without confirming the counter moved.
        var back = gpu_display_wait_vblank(pipe);
        if (back != 0) { kprintln("modeset: WATCHDOG -- restore latched, counter resumed", 53); }
        if (back == 0) { kprintln("modeset: WATCHDOG -- restore did NOT latch (pipe still stopped) -- recover via H2", 81); }
        mdo_wedged = 1;
        return 0;
    }
    gpu_dcn_hold_ms(80);                         # settle the new raster before measuring
    return gpu_refresh_measure(pipe);            # I2 — milliHz, 0 if unmeasurable
}

fn mdo_vtotal() {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }      # QEMU: no DCN
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: vtotal refused -- live pipe is not 0", 45); return MDO_E_NOGPU; }
    # ⛔ The whole oracle is refresh = pixclk / (h_total * v_total); a pixclk of 0 (gpu_pixclk_discover
    # refused the mode — interlace / half-rate / unstable) collapses every prediction and the midpoint to 0
    # and would misread a real commit as NOCOMMIT. Refuse BEFORE arming, so a meaningless run never arms.
    if (gpu_pixclk_100hz == 0) { kprintln("modeset: vtotal refused -- pixclk unmeasured (0), oracle meaningless", 68); return MDO_E_UNMEAS; }
    var pipe = 0;
    if (modeset_arm(5) != 1)   { kprintln("modeset: vtotal refused -- latch would not arm", 46); return MDO_E_ARM; }

    # Pre-state, spilled BEFORE any write (H1). Saved to restore + as the watchdog's recovery target. unf0 is
    # the pre-modeset OPTC underflow (sticky bit10) — the baseline for D1's delta check below.
    var vt_orig  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL) & 0xFFFFFFFF;
    var ctrl     = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_CONTROL) & 0xFFFFFFFF;
    var htot     = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL) & GPU_OTG_TOTAL_MASK;
    var unf0     = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var vt_field = vt_orig & GPU_OTG_TOTAL_MASK;           # register [14:0] = v_total - 1
    var htot_dec = htot + 1;                                # h_total (constant across this bite)
    kprint("modeset: vtotal pre-state v_total ", 34); kprint_num(vt_field + 1);
    kprint(" h_total ", 9); kprint_num(htot_dec);
    kprint(" ctrl ", 6); kprint_num(ctrl); kprint(" pixclk_100hz ", 14); kprint_num(gpu_pixclk_100hz); kprintln("", 0);

    # ⛔ Refuse anything but the arc's calibrated GOP mode. The register field must read 1480 (v_total 1481);
    # a different value means the pipe is not the mode these numbers were derived for, so the oracle would be
    # meaningless — abort rather than modeset a mystery.
    if (vt_field != 1480) { kprintln("modeset: vtotal refused -- V_TOTAL field is not the calibrated 1480", 67); return MDO_E_NOTMODE; }
    # ⛔ DRR must be OFF (V_TOTAL_CONTROL == 0, as M1 read on the GOP pipe): then V_TOTAL alone drives the
    # raster and MIN/MAX are inert. A non-zero control means DRR/VRR is engaged and MIN/MAX would need
    # programming too — untested, so refuse rather than half-modeset a dynamic-refresh pipe.
    if (ctrl != 0) { kprintln("modeset: vtotal refused -- V_TOTAL_CONTROL nonzero (DRR on) -- untested", 71); return MDO_E_DRR; }

    mdo_wedged = 0;
    var t0 = rdtsc();
    # D4: the B target preserves V_TOTAL's reserved bits [31:15] and sets the field [14:0] = 1500 (v_total
    # 1501). On iron the upper bits are 0 (byte-identical to a literal 1500), but write-back-what-you-read is
    # the correct register discipline and the only form that survives a port to a register with live [31:15].
    var vt_b = (vt_orig & 0xFFFF8000) | 1500;
    # Predicted refresh (milliHz) from the WRITTEN v_total (never a read-back): pixclk_100hz * 100000 /
    # (h_total * v_total). 2415014 * 100000 / (2720 * 1481) = 59950; / (2720 * 1501) = 59151.
    var pix    = gpu_pixclk_100hz;
    var pred_a = pix * 100000 / (htot_dec * 1481);
    var pred_b = pix * 100000 / (htot_dec * 1501);

    # PHASE A — baseline: MEASURE the inherited refresh, no write (avoids the identity-modeset trap).
    var ra = gpu_refresh_measure(pipe);
    kprint("modeset: [T+", 12); kprint_num((rdtsc() - t0) / gpu_tsc_per_us() / 1000); kprint("ms] A v_total 1481 refresh ", 27);
    kprint_num(ra); kprint(" mHz predicted ", 15); kprint_num(pred_a); kprintln(" mHz", 4);
    # Fail early if the baseline itself is unmeasurable — do NOT modeset a pipe we cannot oracle.
    if (ra == 0) { kprintln("modeset: VTOTAL unmeasurable at A -- pipe not counting, no modeset attempted", 76); return MDO_E_UNMEAS; }

    # PHASE B — the modeset: v_total 1501. THE write, watchdog-guarded. Sample the lock ack (disambiguates a
    # NOCOMMIT caused by an unacked lock) and the OPTC underflow (D1 — the free-running instruments below
    # cannot see a corrupt scanout, so this sticky bit is the ONLY signal that the raster underflowed).
    var rb2  = mdo_vtotal_phase(pipe, vt_b, vt_orig);
    var ackb = gpu_otg_lock_acked;
    var unfb = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    kprint("modeset: [T+", 12); kprint_num((rdtsc() - t0) / gpu_tsc_per_us() / 1000); kprint("ms] B v_total 1501 refresh ", 27);
    kprint_num(rb2); kprint(" mHz predicted ", 15); kprint_num(pred_b); kprint(" lock ack ", 10); kprint_num(ackb); kprintln("", 0);
    if (mdo_wedged != 0) { kprintln("modeset: VTOTAL WEDGED at B -- restored, see WATCHDOG line", 58); return MDO_E_WEDGED; }

    # PHASE C — restore the INHERITED value (D4: vt_orig, not a literal), watchdog-guarded.
    var rc   = mdo_vtotal_phase(pipe, vt_orig, vt_orig);
    var unfc = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    kprint("modeset: [T+", 12); kprint_num((rdtsc() - t0) / gpu_tsc_per_us() / 1000); kprint("ms] C v_total 1481 refresh ", 27);
    kprint_num(rc); kprint(" mHz predicted ", 15); kprint_num(pred_a); kprintln(" mHz", 4);
    if (mdo_wedged != 0) { kprintln("modeset: VTOTAL WEDGED at C -- restored, see WATCHDOG line", 58); return MDO_E_WEDGED; }
    kprint("modeset: underflow bit10 ", 25); kprint_num(unf0); kprint(" -> ", 4); kprint_num(unfb); kprint(" -> ", 4); kprint_num(unfc); kprintln("", 0);

    # Verdict. Every write phase must have measured (a 0 means the pipe would not count — unmeasurable).
    if (rb2 == 0) { kprintln("modeset: VTOTAL unmeasurable at B -- pipe not counting", 54); return MDO_E_UNMEAS; }
    if (rc == 0) { kprintln("modeset: VTOTAL unmeasurable at C -- pipe not counting", 54); return MDO_E_UNMEAS; }
    # D1: OPTC underflow (DELTA, like M4). Both M5 instruments free-run off the OTG PLL, so the refresh triple
    # below cannot see a corrupt scanout — this sticky bit is the only corrupt-scanout signal. Convict only a
    # NEWLY-set bit10 (0 -> 1 across the modeset); a pre-existing 1 is disregarded (noted). A green M5 must be
    # "displayed cleanly", not merely "timing committed to a free-running counter".
    if (unf0 == 0) {
        if (unfb != 0) { kprintln("modeset: VTOTAL UNDERFLOW at B -- OPTC bit10 newly set; scanout corrupt though timing may be live", 97); return MDO_E_UNDERFLOW; }
        if (unfc != 0) { kprintln("modeset: VTOTAL UNDERFLOW at C -- OPTC bit10 newly set by the restore", 69); return MDO_E_UNDERFLOW; }
    }
    if (unf0 != 0) { kprintln("modeset: NOTE OPTC underflow bit10 was already set BEFORE the modeset -- pre-existing", 85); }
    # Midpoint classifier: pred_a ~59950, pred_b ~59151, midpoint ~59550. B must cross BELOW it (moved toward
    # the change); A and C must stay ABOVE it (near baseline). Signal ~800 mHz, midpoint 400 mHz from each —
    # enormous vs the ~1 mHz (12-17 ppm) noise floor.
    var mid = (pred_a + pred_b) / 2;
    if (ra < mid) { kprintln("modeset: VTOTAL anomaly -- baseline A already below midpoint (pixclk off?)", 74); return MDO_E_MODESET; }
    if (rc < mid) { kprintln("modeset: VTOTAL anomaly -- C did not restore to baseline", 56); return MDO_E_MODESET; }
    if (rb2 >= mid) { kprintln("modeset: VTOTAL UNCHANGED -- refresh did not move; write landed in SHADOW, VUPDATE never swapped", 96); return MDO_E_NOCOMMIT; }
    # B moved below the midpoint — did it land on the PREDICTED value, or somewhere else (totals/stride wrong)?
    var d = rb2 - pred_b;
    if (d < 0) { d = 0 - d; }
    if (d > 200) { kprintln("modeset: VTOTAL moved but OFF prediction (>200 mHz) -- totals or stride wrong", 77); return MDO_E_MODESET; }
    kprintln("modeset: VTOTAL OK -- FIRST MODESET COMMITTED; refresh moved to prediction and restored", 87);
    return 0;
}

# ── M6 same-mode OTG envelope re-commit (MODESET_OP_RECOMMIT): OTG_MASTER_EN 0 -> reprogram -> 1 ────────
# The first bite that DISABLES the live pipe. It is the ordering fact the whole arc turns on: ATOM #76
# blanks the pipe because agnos runs it OUTSIDE a modeset envelope; #76 becomes survivable only once this
# disable->reprogram->enable envelope exists (M8 wraps #4/#76 inside it). This is a SAME-MODE re-commit —
# every register is written back to the value it already holds, so the panel returns unchanged — which makes
# the ENVELOPE MECHANISM the thing under test, isolated from any timing change. ⛔ Unlike M4/M5, the writes
# happen with the OTG DISABLED, so they are IMMEDIATE (not VUPDATE double-buffered) and do NOT go through the
# update-lock path — so this op carries THE GATE itself.
#
# The oracle is I1 (OTG_STATUS_FRAME_COUNT): it must STOP during the disable window (proving OTG_MASTER_EN=0
# actually took) and RESUME after enable (proving the reprogram+enable relit the pipe). If it never stops,
# the disable is a no-op and every later bite is built on sand; if it stops but never resumes, the pipe is
# DARK and only H2 recovers it (one bad boot).

# mdo_wait_frame_stop — after OTG_MASTER_EN=0, the frame counter must FREEZE. Settle ~60ms so the OTG
# finishes its current frame and stops, then confirm the counter is constant across ~40ms (~2.5 frames — a
# running pipe would advance). 1 = stopped (disable took), 0 = still advancing (disable did NOT take). Uses
# the wall-clock hold, which does not depend on the pipe scanning, so it is valid with the OTG disabled.
fn mdo_wait_frame_stop(pipe) {
    var fc_off = GPU_R_OTG_FRAME_COUNT + pipe * GPU_DCN_OTG_STRIDE;
    gpu_dcn_hold_ms(60);
    var a = gpu_reg32(GPU_BASE_DCN_2, fc_off) & GPU_OTG_FRAME_COUNT_MASK;
    gpu_dcn_hold_ms(40);
    var b = gpu_reg32(GPU_BASE_DCN_2, fc_off) & GPU_OTG_FRAME_COUNT_MASK;
    if (a == b) { return 1; }
    return 0;
}

fn mdo_recommit() {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }      # QEMU: no DCN
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: recommit refused -- live pipe is not 0", 47); return MDO_E_NOGPU; }
    if (gpu_pixclk_100hz == 0) { kprintln("modeset: recommit refused -- pixclk unmeasured (0)", 50); return MDO_E_UNMEAS; }
    var pipe = 0;
    if (modeset_arm(6) != 1)   { kprintln("modeset: recommit refused -- latch would not arm", 48); return MDO_E_ARM; }
    # ⛔ THE GATE — M6 writes directly (OTG disabled), NOT through gpu_dcn_write_committed, so the gate that
    # lives in those primitives is not on this path. Carry it here. The arm above just set the token; this is
    # belt-and-suspenders against a future edit that moves the arm.
    if (modeset_armed != 1297040453) { kprintln("modeset: recommit refused -- not armed", 38); return MDO_E_ARM; }

    # Save the FULL timing group + control (H1: spilled before any write; the restore set, by construction).
    var s_ctrl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL) & 0xFFFFFFFF;
    var s_htot  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL) & 0xFFFFFFFF;
    var s_hbl   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_BLANK_START_END) & 0xFFFFFFFF;
    var s_hsa   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A) & 0xFFFFFFFF;
    var s_hsac  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A_CNTL) & 0xFFFFFFFF;
    var s_htc   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_TIMING_CNTL) & 0xFFFFFFFF;
    var s_vtot  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL) & 0xFFFFFFFF;
    var s_vmin  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MIN) & 0xFFFFFFFF;
    var s_vmax  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MAX) & 0xFFFFFFFF;
    var s_vctl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_CONTROL) & 0xFFFFFFFF;
    var s_vbl   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_BLANK_START_END) & 0xFFFFFFFF;
    var s_vsa   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A) & 0xFFFFFFFF;
    var s_vsac  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A_CNTL) & 0xFFFFFFFF;
    var s_intl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_INTERLACE_CONTROL) & 0xFFFFFFFF;
    var s_vst   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VSTARTUP_PARAM) & 0xFFFFFFFF;
    var s_vup   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VUPDATE_PARAM) & 0xFFFFFFFF;
    var s_vrd   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VREADY_PARAM) & 0xFFFFFFFF;
    var s_vtg   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_VTG0_CONTROL) & 0xFFFFFFFF;
    var s_occ   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_CLOCK_CONTROL) & 0xFFFFFFFF;
    var s_oicc  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC_INPUT_CLOCK_CONTROL) & 0xFFFFFFFF;
    var vt_field = s_vtot & GPU_OTG_TOTAL_MASK;

    kprint("modeset: recommit pre-state v_total ", 36); kprint_num(vt_field + 1);
    kprint(" ctrl ", 6); kprint_num(s_ctrl); kprint(" otg_clk ", 9); kprint_num(s_occ);
    kprint(" optc_clk ", 10); kprint_num(s_oicc); kprintln("", 0);

    # ⛔ Same guards as M5: only the arc's calibrated GOP mode, DRR off (a same-mode envelope on a DRR pipe is
    # untested). Refusing here leaves the pipe UNTOUCHED (nothing disabled yet).
    if (vt_field != 1480) { kprintln("modeset: recommit refused -- V_TOTAL field is not the calibrated 1480", 69); return MDO_E_NOTMODE; }
    if (s_vctl != 0) { kprintln("modeset: recommit refused -- V_TOTAL_CONTROL nonzero (DRR on) -- untested", 73); return MDO_E_DRR; }

    var unf0 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var fc0  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;

    # === DISABLE === OTG_MASTER_EN = 0 (clear bit0, preserve the rest of OTG_CONTROL). The panel blanks here.
    kprintln("modeset: recommit -- OTG_MASTER_EN 0 (disabling pipe; panel blanks briefly)", 75);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl & (0 - 1 - GPU_OTG_MASTER_EN));
    gpu_mfence();
    var stopped = mdo_wait_frame_stop(pipe);
    var fc_dis  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    kprint("modeset: recommit -- frame count ", 33); kprint_num(fc0); kprint(" -> ", 4); kprint_num(fc_dis);
    kprint(" stopped ", 9); kprint_num(stopped); kprintln("", 0);

    # === REPROGRAM (OTG disabled: writes are immediate, not double-buffered) === same-mode, so every timing
    # register is written back to its saved value; the two clock-controls are set to 0x3 (the amdgpu envelope
    # value that keeps the OTG/OPTC clocks on — required for the pipe to scan when re-enabled). Inter-register
    # order is non-critical for a same-mode re-commit (all land before the enable).
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL, s_htot);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_BLANK_START_END, s_hbl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A, s_hsa);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A_CNTL, s_hsac);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TIMING_CNTL, s_htc);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL, s_vtot);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MIN, s_vmin);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MAX, s_vmax);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_BLANK_START_END, s_vbl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A, s_vsa);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A_CNTL, s_vsac);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_INTERLACE_CONTROL, s_intl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VSTARTUP_PARAM, s_vst);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VUPDATE_PARAM, s_vup);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VREADY_PARAM, s_vrd);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_VTG0_CONTROL, s_vtg);
    # D3 (burn-1 hygiene): write BACK the pre-disable clock-control values, NOT a forced literal 0x3. These
    # two are the ONLY registers whose value could differ across the envelope (every timing write above is
    # same-value), so write-back keeps the whole envelope pure same-mode and cannot mis-select a clock
    # source/divider. On a lit GOP pipe both read 0x3 (clocks on) — flag it if they don't (a real finding).
    if (s_occ != 0x3)  { kprint("modeset: NOTE OTG_CLOCK_CONTROL was ", 36); kprint_num(s_occ); kprintln(" not 0x3", 8); }
    if (s_oicc != 0x3) { kprint("modeset: NOTE OPTC_INPUT_CLOCK_CONTROL was ", 43); kprint_num(s_oicc); kprintln(" not 0x3", 8); }
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CLOCK_CONTROL, s_occ);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OPTC_INPUT_CLOCK_CONTROL, s_oicc);
    gpu_mfence();

    # === ENABLE === restore the saved OTG_CONTROL (OTG_MASTER_EN back to 1 with every other bit as it was).
    kprintln("modeset: recommit -- OTG_MASTER_EN 1 (re-enabling pipe)", 55);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl);
    gpu_mfence();
    var resumed = gpu_display_wait_vblank(pipe);
    gpu_dcn_hold_ms(120);                       # settle before measuring
    var refr = gpu_refresh_measure(pipe);
    var unf1 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var fc1  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    # D2: gpu_display_wait_vblank bounds at ~50ms; a healthy-but-slow PLL relock (or a boosted TSC vs the
    # calibrated gpu_tsc_per_us()) can exceed it and read resumed=0 on a pipe that IS coming back. Re-confirm
    # across the 120ms settle: if the counter advanced past its disabled value, the pipe resumed regardless.
    if (resumed == 0) { if (fc1 != fc_dis) { resumed = 1; } }

    var pred = gpu_pixclk_100hz * 100000 / (((s_htot & GPU_OTG_TOTAL_MASK) + 1) * (vt_field + 1));
    kprint("modeset: recommit -- resumed ", 29); kprint_num(resumed); kprint(" frame count ", 13); kprint_num(fc1);
    kprint(" refresh ", 9); kprint_num(refr); kprint(" mHz predicted ", 15); kprint_num(pred); kprintln(" mHz", 4);
    kprint("modeset: underflow bit10 ", 25); kprint_num(unf0); kprint(" -> ", 4); kprint_num(unf1); kprintln("", 0);

    # Verdict. STOP first — if the disable never took, the whole envelope model is wrong (built on sand).
    if (stopped == 0) { kprintln("modeset: RECOMMIT FAILED -- OTG_MASTER_EN=0 did not stop the pipe -- envelope is a no-op", 88); return MDO_E_NOSTOP; }
    # RESUME next — if it stopped but did not come back, the pipe is DARK; recover via H2.
    if (resumed == 0) { kprintln("modeset: RECOMMIT DARK -- pipe stopped but did NOT resume after enable -- recover via H2", 88); return MDO_E_NORESUME; }
    if (refr == 0) { kprintln("modeset: RECOMMIT unmeasurable -- pipe resumed but will not count", 65); return MDO_E_UNMEAS; }
    # underflow delta (D1, like M4/M5): convict only a NEWLY-set bit10.
    if (unf0 == 0) {
        if (unf1 != 0) { kprintln("modeset: RECOMMIT UNDERFLOW -- OPTC bit10 newly set by the envelope", 67); return MDO_E_UNDERFLOW; }
    }
    # ⚠ D1 (the review's central find): on THIS iron OPTC bit10 is ALREADY set at boot, so the delta above is a
    # DEAD instrument here — and M6 is the first bite to fully stop the OTG, the exact trigger for a HUBP
    # underflow on re-arm (a black-but-COUNTING panel: the frame counter free-runs off the PLL, so I1 resume +
    # refresh alone cannot certify a picture). Clearing the sticky bit would revive the check but the
    # write-1-to-clear bit is NOT verified in agnos, and a derived-not-verified OPTC write on the most
    # dangerous bite is exactly the P4-pitch hazard. So the picture oracle for M6 is the OPERATOR'S EYES
    # (blank -> relight -> stable picture), NOT this bit. Verifying the underflow-clear bit is a follow-up.
    if (unf0 != 0) { kprintln("modeset: NOTE OPTC bit10 pre-set at boot -- CONFIRM THE PICTURE BY EYE (this instrument is blind here)", 102); }
    # refresh must return to the inherited rate. Same-mode writes back verbatim, so refr should equal pred to
    # within the ~1 mHz noise floor; gate at 30 mHz (~500 ppm) — well inside noise, tighter than a 1-line
    # V_TOTAL error (~40 mHz) would produce. (The card cites 200 ppm ~= 12 mHz; 30 is the safe-vs-noise pick.)
    var dr = refr - pred;
    if (dr < 0) { dr = 0 - dr; }
    if (dr > 30) { kprintln("modeset: RECOMMIT off-rate -- refresh did not return to the inherited value", 75); return MDO_E_MODESET; }
    kprintln("modeset: RECOMMIT OK -- envelope 0->reprogram->1, stopped then resumed, rate restored -- EYE-CHECK the picture", 110);
    return 0;
}

# ── NATIVE RESOLUTION — #93 op 0x0B (1.56.36) ─────────────────────────────────────────────────────────
# Stop the pipe upscaling an 800x600 surface to a 2560x1440 link and make it scan the full-size surface the
# firmware ALREADY allocated. Every input is measured, none is invented:
#
#   • THE SURFACE EXISTS. gnoboot 0.6.1's GOP SetMode obtained `fb: w=0xa00 h=0x5a0 pitch=0x2800
#     phys=0xd0000000 size=0xe10000`, and 0xe10000 = 14,745,600 = exactly 2560*1440*4. Nothing is allocated
#     here and no pitch is invented — the op moves the PIPE to a buffer that is already there.
#   • DCN WAS NOT REPROGRAMMED BY THAT SetMode, which is the entire bug: HUBP still reads viewport 0x5EA =
#     0x02580320 (800x600) and pitch 0x607 = 832 px and scales the difference away. GOP moves the GOP
#     surface; it does not touch DCN. ⛔ That lever is FINISHED — no fourth SetMode variant.
#   • THE ADDRESS ALREADY RECONCILES, and the one open question in the spec is now closed. 0x60A was absent
#     from the 2026-08-03 regdump only because `gpu_scanout_regdump` SKIPS ZERO VALUES; the surface sits at
#     MC 0xF4_00000000, so the low half reads 0 (skipped) and 0x60B reads 0xF4 = 244 (printed). That is
#     exactly `fb_base + (fb_phys - BAR0)` for fb_phys == BAR0 == 0xd0000000 — the transform
#     gpu_display_probe already uses. So the surface base DOES NOT MOVE and the address write below is a
#     same-value write. The op still READS and reconciles first, and refuses on a value it cannot account
#     for, because "the address is where I think it is" is a thing to verify on the day, not to assume.
#
# ⛔ THE TARGET COMES FROM boot_info, NEVER FROM fb_width()/fb_height(). Those accessors return the P4
# GEOMETRY OVERRIDE once gpu_scanout_matchgeom has run — i.e. 800x600, the very state being corrected. A
# guard written against them would read "already native" on the broken pipe and refuse forever. (The §2.2b
# spec said fb_width()==2560; that was wrong for this reason and the doc is corrected alongside this code.)
#
# ⛔ SCALER BYPASS AND PITCH MOVE IN ONE ENVELOPE, and that is not a style preference: writing the "correct"
# pitch 2560 to 0x607 with the scaler still ACTIVE blacked the pipe and hung the box on 2026-07-20. Source
# geometry and scaler mode are one atomic fact. Hence the op refuses unless the target EQUALS the link's
# active raster (MDO_E_RASTER) — with DSCL in bypass, source and raster must match exactly, and a target
# that does not is a scaled mode wearing a bypass.
#
# ⚠ WHAT THIS OP DOES NOT DO, NAMED SO A BAD BURN IS ADJUDICABLE: it does not touch the DLG/TTU/RQ deadline
# registers. Those were DML-computed by the firmware for an 800x600 fetch, and a 2560x1440 fetch is ~7.7x
# the per-frame bytes (1.92 MB -> 14.7 MB, ~115 MB/s -> ~885 MB/s at 60 Hz). The BANDWIDTH is trivial for
# this UMA part; the URGENCY SCHEDULING may not be. So the expected failure mode, if there is one, is a
# HUBP underflow — a corrupt or black panel on a pipe whose frame counter is happily advancing. If the burn
# shows that, the next bite is cloning HUBP0's DLG group, NOT re-litigating the geometry.
#
# ⚠ AND THE FRAME COUNTER CANNOT SEE THAT. It free-runs off the OTG PLL, so it advances on a black panel
# just as happily as on a good one (the M6 finding). The counter proves the ENVELOPE survived; only the
# OPERATOR'S EYES prove the picture. The op says so in its own success line rather than implying a green.
#
# Runtime op, never boot-time: a bad write costs one reboot, and modeset_arm() + /.modeset-armed stop it
# re-firing into a loop. It owns its own rollback — the restore set is the saved set, by construction.
fn mdo_native() {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: native refused -- live pipe is not 0", 45); return MDO_E_NOGPU; }
    var pipe = 0;
    var p = pipe * GPU_DCN_HUBP_STRIDE;
    var otg = pipe * GPU_DCN_OTG_STRIDE;

    # ── TARGET, from the boot_info handoff (see the fb_width() warning above) ──────────────────────────
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { kprintln("modeset: native refused -- no boot_info handoff", 47); return MDO_E_NOTNATIVE; }
    var fb_phys  = load64(bi + 0x48);
    var bi_pitch = load32(bi + 0x50) & 0xFFFFFFFF;
    var t_w      = load32(bi + 0x54) & 0xFFFFFFFF;
    var t_h      = load32(bi + 0x58) & 0xFFFFFFFF;
    if (fb_phys == 0) { kprintln("modeset: native refused -- boot_info framebuffer address is 0", 61); return MDO_E_NOTNATIVE; }
    if ((bi_pitch & 3) != 0) { kprintln("modeset: native refused -- pitch is not whole 32bpp pixels", 58); return MDO_E_NOTNATIVE; }
    var t_pitch = bi_pitch >> 2;
    if (t_w < 640)        { kprintln("modeset: native refused -- boot_info width below 640", 52); return MDO_E_NOTNATIVE; }
    if (t_w > 4096)       { kprintln("modeset: native refused -- boot_info width above 4096", 53); return MDO_E_NOTNATIVE; }
    if (t_h < 480)        { kprintln("modeset: native refused -- boot_info height below 480", 53); return MDO_E_NOTNATIVE; }
    if (t_h > 4096)       { kprintln("modeset: native refused -- boot_info height above 4096", 54); return MDO_E_NOTNATIVE; }
    if (t_pitch < t_w)    { kprintln("modeset: native refused -- pitch is narrower than the width", 59); return MDO_E_NOTNATIVE; }
    if (t_pitch > 0x3FFF) { kprintln("modeset: native refused -- pitch exceeds the 14-bit register field", 66); return MDO_E_NOTNATIVE; }

    # ── The target must EQUAL the active raster, because the scaler is going to bypass ─────────────────
    if (gpu_h_active == 0) { kprintln("modeset: native refused -- link active width never derived", 58); return MDO_E_RASTER; }
    if (gpu_v_active == 0) { kprintln("modeset: native refused -- link active height never derived", 59); return MDO_E_RASTER; }
    if (t_w != gpu_h_active) { kprintln("modeset: native refused -- target width is not the raster width", 63); return MDO_E_RASTER; }
    if (t_h != gpu_v_active) { kprintln("modeset: native refused -- target height is not the raster height", 65); return MDO_E_RASTER; }

    # ── Read the live HUBP group. This IS the save set — the restore below writes back exactly these. ──
    var s_vp    = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBP_VIEWPORT_DIM + p) & 0xFFFFFFFF;
    var s_pitch = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_PITCH   + p) & 0xFFFFFFFF;
    var s_alo   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR    + p) & 0xFFFFFFFF;
    var s_ahi   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR_HI + p) & 0xFFFFFFFF;
    var s_scl   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DSCL_SCL_MODE) & 0xFFFFFFFF;
    var cur_w = s_vp & 0xFFFF;
    var cur_h = (s_vp >> 16) & 0xFFFF;
    kprint("modeset: native pre-state viewport ", 35); kprint_num(cur_w); kprint("x", 1); kprint_num(cur_h);
    kprint(" pitch ", 7); kprint_num(s_pitch & 0x3FFF);
    kprint(" scl_mode ", 10); kprint_num(s_scl & GPU_DSCL_MODE_MASK);
    kprint(" target ", 8); kprint_num(t_w); kprint("x", 1); kprint_num(t_h);
    kprint(" pitch ", 7); kprint_num(t_pitch); kprintln("", 0);

    # Already native? Say so as its own outcome. Blanking a correct pipe to re-prove a readable state is
    # a burn spent on nothing, and a silent green would make a repeat run indistinguishable from the first.
    if (cur_w == t_w) {
        if (cur_h == t_h) {
            kprintln("modeset: native -- the viewport ALREADY reads the target; nothing to do", 71);
            return MDO_E_ALREADY;
        }
    }

    # ── RECONCILE THE SURFACE ADDRESS — the never-write-blind gate ─────────────────────────────────────
    # Same CPU->MC transform as gpu_display_probe: the framebuffer is addressed by the CPU through the GPU's
    # BAR0 VRAM aperture, so the HUBP sees it at fb_base + (fb_phys - BAR0). Accept the raw CPU-phys form
    # too — whichever the pipe is ACTUALLY using is the encoding this op writes back, which is how it obeys
    # "match the encoding 0x60A actually uses" without deciding for the hardware.
    # ⚠ Compose from the FIELD ([15:0]), restore from the WHOLE REGISTER. `_HIGH` is a 16-bit address field
    # in a 32-bit register; masking it into the composition keeps a stray upper bit from shifting garbage
    # into bit 48+ and failing an otherwise-good reconcile, while the save set keeps s_ahi verbatim so the
    # rollback puts back what was actually there rather than a value this function reconstructed.
    var live_surf   = ((s_ahi & 0xFFFF) << 32) | s_alo;
    var r_base      = gpu_reg32(GPU_BASE_GC_0, GPU_R_MC_VM_FB_LOC_BASE) & GPU_FB_LOC_MASK;
    var fb_base     = r_base << 24;
    var bar0        = pci_bar0_64(gpu_pci_idx);
    var expected_mc = 0;
    if (bar0 != 0) { if (fb_phys >= bar0) { expected_mc = fb_base + (fb_phys - bar0); } }
    var want = 0;
    if (live_surf == fb_phys) { want = fb_phys; }
    if (expected_mc != 0) { if (live_surf == expected_mc) { want = expected_mc; } }
    if (want == 0) {
        kprint("modeset: native refused -- HUBP surface ", 40); kprint_num(live_surf);
        kprint(" matches neither fb_phys ", 25); kprint_num(fb_phys);
        kprint(" nor its MC form ", 17); kprint_num(expected_mc); kprintln("", 0);
        kprintln("modeset: refusing to re-point a surface this kernel cannot account for", 70);
        return MDO_E_SURFADDR;
    }

    # ── ARM LAST. Every refusal above is read-only and leaves the pipe untouched, so arming before them
    # would burn the latch on a call that never wrote a register — and leave the operator an
    # `rm /.modeset-armed` to run for nothing. Arm immediately before the first write, not before the
    # first guard. (M6 arms early; that is its historical shape, not a pattern worth copying.)
    if (modeset_arm(11) != 1) { kprintln("modeset: native refused -- latch would not arm", 46); return MDO_E_ARM; }
    # THE GATE, carried here for the same reason M6 carries it: these writes go direct with the OTG down,
    # not through gpu_dcn_write_committed, so the gate living in those primitives is not on this path.
    if (modeset_armed != 1297040453) { kprintln("modeset: native refused -- not armed", 36); return MDO_E_ARM; }

    var s_ctrl = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg) & 0xFFFFFFFF;
    var unf0   = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var fc0    = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT + otg) & GPU_OTG_FRAME_COUNT_MASK;

    # === DISABLE ===
    kprintln("modeset: native -- OTG_MASTER_EN 0 (disabling pipe; panel blanks briefly)", 73);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg, s_ctrl & (0 - 1 - GPU_OTG_MASTER_EN));
    gpu_mfence();
    var stopped = mdo_wait_frame_stop(pipe);
    var fc_dis  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT + otg) & GPU_OTG_FRAME_COUNT_MASK;
    kprint("modeset: native -- frame count ", 31); kprint_num(fc0); kprint(" -> ", 4); kprint_num(fc_dis);
    kprint(" stopped ", 9); kprint_num(stopped); kprintln("", 0);

    # ⛔ CHECK THE STOP **BEFORE** REPROGRAMMING, not after. M6 checks it at the end because every one of its
    # writes is same-value and harmless on a live pipe. These writes are NOT: a pitch change on a scanning
    # pipe is precisely what hung this box. If the disable did not take, put MASTER_EN back and leave the
    # HUBP alone.
    if (stopped == 0) {
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg, s_ctrl);
        gpu_mfence();
        kprintln("modeset: NATIVE FAILED -- disable did not stop the pipe; HUBP left untouched", 76);
        return MDO_E_NOSTOP;
    }

    # === REPROGRAM (OTG down: immediate, not VUPDATE double-buffered) ===
    # Order is scaler-first by design. With the pipe stopped no instant is observable, but writing bypass
    # before the geometry means that at no point in the register file does a full-size pitch coexist with an
    # active scaling ratio — the exact combination that blacked the pipe. Defence in depth, at zero cost.
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DSCL_SCL_MODE, (s_scl & (0 - 1 - GPU_DSCL_MODE_MASK)) | GPU_DSCL_MODE_BYPASS);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_VIEWPORT_DIM + p, (t_h << 16) | t_w);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_PITCH + p, (s_pitch & (0 - 1 - 0x3FFF)) | t_pitch);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR + p, want & 0xFFFFFFFF);
    # RMW the high half: replace the [15:0] address field, preserve whatever else lives in that register.
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR_HI + p, (s_ahi & (0 - 1 - 0xFFFF)) | ((want >> 32) & 0xFFFF));
    gpu_mfence();

    # === ENABLE ===
    kprintln("modeset: native -- OTG_MASTER_EN 1 (re-enabling pipe)", 53);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg, s_ctrl);
    gpu_mfence();
    var resumed = gpu_display_wait_vblank(pipe);
    gpu_dcn_hold_ms(120);
    var fc1  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT + otg) & GPU_OTG_FRAME_COUNT_MASK;
    var unf1 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    # Same D2 re-confirmation M6 carries: the bounded vblank wait can read 0 on a pipe that IS coming back.
    if (resumed == 0) { if (fc1 != fc_dis) { resumed = 1; } }
    kprint("modeset: native -- resumed ", 27); kprint_num(resumed);
    kprint(" frame count ", 13); kprint_num(fc1);
    kprint(" underflow ", 11); kprint_num(unf0); kprint(" -> ", 4); kprint_num(unf1); kprintln("", 0);

    # === ROLLBACK — the op owns it. Restore set == save set. ===
    if (resumed == 0) {
        kprintln("modeset: NATIVE did not resume -- rolling back to the saved HUBP group", 70);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg, s_ctrl & (0 - 1 - GPU_OTG_MASTER_EN));
        gpu_mfence();
        mdo_wait_frame_stop(pipe);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DSCL_SCL_MODE, s_scl);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_VIEWPORT_DIM + p, s_vp);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_PITCH + p, s_pitch);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR + p, s_alo);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_HUBP_SURF_ADDR_HI + p, s_ahi);
        gpu_mfence();
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL + otg, s_ctrl);
        gpu_mfence();
        var back = gpu_display_wait_vblank(pipe);
        gpu_dcn_hold_ms(120);
        var fc2 = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT + otg) & GPU_OTG_FRAME_COUNT_MASK;
        if (back == 0) { if (fc2 != fc1) { back = 1; } }
        kprint("modeset: native rollback -- resumed ", 36); kprint_num(back);
        kprint(" frame count ", 13); kprint_num(fc2); kprintln("", 0);
        if (back == 0) { kprintln("modeset: NATIVE DARK -- rollback did NOT relight either -- power-cycle (H2)", 75); }
        return MDO_E_NORESUME;
    }

    # ── Success on the ENVELOPE. Move the console to the geometry that is now live. ────────────────────
    # fb_set_geom directly, NOT gpu_scanout_matchgeom: that helper early-returns once fb_geom_active() is 1,
    # which it has been since the boot-time 800x600 match, so calling it here would silently do nothing.
    fb_set_geom(t_w, t_h, t_pitch * 4);
    fb_console_clear();
    kprint("modeset: NATIVE OK -- pipe scanning ", 36); kprint_num(t_w); kprint("x", 1); kprint_num(t_h);
    kprint(" pitch ", 7); kprint_num(t_pitch); kprintln(" px, scaler in BYPASS", 21);
    if (unf0 == 0) {
        if (unf1 != 0) { kprintln("modeset: NOTE OPTC underflow bit10 NEWLY set -- suspect the DLG/TTU deadlines", 77); }
    }
    kprintln("modeset: EYE-CHECK THE PANEL. The frame counter free-runs off the PLL and", 73);
    kprintln("modeset: advances on a black screen too -- it proves the envelope, not the picture.", 83);
    return 0;
}

# ── CONSOLE HARDWARE PAN — #93 op 0x0C (1.56.36) ──────────────────────────────────────────────────────
# Move the console into an agnos-owned VRAM buffer TALLER than the screen and make scrolling a scanout-start
# move instead of a full-screen copy.
#
# WHY: the 2026-08-03 native burn worked and the operator immediately reported the console had got slower.
# That is arithmetic, not a defect — `fb_scroll_up` flushes `pitch * height` per scrolled LINE, which at
# 2560x1440 is **14.7 MB of WC stores**, against ~2.0 MB at the old 800x600 surface. The pan replaces that
# with one register write plus a 160 KB bottom-row clear, and one full-frame reset per 90 scrolls.
#
# ⭐ THE RISKIEST-LOOKING PART IS THE PART THAT IS ALREADY PROVEN. Re-pointing
# DCSURF_PRIMARY_SURFACE_ADDRESS live, with no OTG envelope, is exactly what `gpu_blit_present` does every
# frame to page-flip DOOM on this iron. This op does not invent a mechanism; it reuses the address group at
# a sub-frame offset.
#
# ⛔⛔ THIS OP TAKES THE LATCH — AND THE EARLIER "no latch, a considered choice" NOTE HERE WAS RIGHT UNTIL
# 1.56.38 AND IS NOW WRONG. Its argument: this writes only the address group, which cannot hang or blank
# the pipe, and all its state is in RAM, so a reboot undoes it with nothing to disarm. Every clause of that
# is still true — and it was load-bearing on the assumption the op is RUNTIME-ONLY. "A reboot undoes it"
# is only a recovery while a human has to type the command.
# ⭐ 1.56.38 runs the pan AT BOOT (main.cyr, straight after the native modeset), and that changes the
# calculus completely: a pan that leaves the console unreadable would now REPEAT on every boot. Loopable
# is exactly the property the latch exists for — the same reasoning that made the boot-time native modeset
# need it. A write being individually harmless does not make it safe to run unconditionally at boot.
# ⚠ Site 12, distinct from native's 11, so the latch record names WHICH of the two was in flight.
#
# ⚠ REQUIRES A NATIVE PIPE. On a scaled pipe the console geometry and the raster disagree, so a pan would
# move the scanout by one text row of the SOURCE and the scaler would smear the result — refuse instead.
fn mdo_pan() {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: pan refused -- live pipe is not 0", 42); return MDO_E_NOGPU; }
    if (fb_pan_armed() == 1) {
        kprintln("modeset: pan -- already armed; the console is ALREADY hardware-scrolled", 71);
        return MDO_E_ALREADY;
    }
    # A full-screen app owns the display. Arming would commit the console's surface address over the top
    # of it, and the app's next present would flip it straight back — a fight, not a modeset. Refuse.
    if (gpu_scanout_pid >= 0) {
        kprintln("modeset: pan refused -- a full-screen app owns the scanout; quit it first", 73);
        return MDO_E_NOPAN;
    }
    # The pipe must be native: viewport == raster, i.e. --native has run and the scaler is in bypass.
    var vp = gpu_reg32(GPU_BASE_DCN_2, GPU_R_HUBP_VIEWPORT_DIM) & 0xFFFFFFFF;
    var vw = vp & 0xFFFF;
    var vh = (vp >> 16) & 0xFFFF;
    if (gpu_h_active == 0) { kprintln("modeset: pan refused -- link active width never derived", 55); return MDO_E_RASTER; }
    if (vw != gpu_h_active) { kprintln("modeset: pan refused -- pipe is not native; run --native first", 62); return MDO_E_RASTER; }
    if (vh != gpu_v_active) { kprintln("modeset: pan refused -- pipe is not native; run --native first", 62); return MDO_E_RASTER; }
    kprint("modeset: pan arming -- console ", 31); kprint_num(fb_width());
    kprint("x", 1); kprint_num(fb_height());
    kprint(" pitch ", 7); kprint_num(fb_pitch());
    kprint(" software scroll costs ", 23); kprint_num(fb_pitch() * fb_height() / 1024);
    kprintln(" KB per line", 12);
    # Arm LAST — every refusal above is read-only and leaves the console untouched, so arming before them
    # would burn the latch on a call that never wrote a register. Same ordering as mdo_native.
    if (modeset_arm(12) != 1) { kprintln("modeset: pan refused -- latch would not arm", 43); return MDO_E_ARM; }
    if (modeset_armed != 1297040453) { kprintln("modeset: pan refused -- not armed", 33); return MDO_E_ARM; }
    if (gpu_pan_arm() != 1) {
        kprintln("modeset: PAN REFUSED -- buffer would not fit below the back buffers; console unchanged", 86);
        return MDO_E_NOPAN;
    }
    # ⚠ COMPUTE the reset interval, never hardcode it. This line said "every 90 lines", which is the
    # fb_scale()==1 answer; the 2026-08-03 iron run was at scale 2 (320 KB/line, not 160), where the real
    # interval is 45. A log the project reads as evidence must not carry a number the build can contradict.
    kprint("modeset: PAN ARMED -- scroll is now one address write + ", 56);
    kprint_num(16 * fb_scale() * fb_pitch() / 1024);
    kprint(" KB, reset every ", 17);
    kprint_num(fb_height() / (16 * fb_scale()));
    kprintln(" lines", 6);
    kprintln("modeset: EYE-CHECK: type something that scrolls. Text must scroll cleanly with", 78);
    kprintln("modeset: no tearing band, no duplicated row, and no garbage at the bottom.", 74);
    return 0;
}

# ── M8 the TRANSMITTER: ATOM #4 (+ #76) INSIDE M6's envelope (MODESET_OP_TRANSMIT) ─────────────────────
# The culmination of the display arc: the DVI->HDMI encoder + transmitter edge run INSIDE the OTG envelope
# M6 proved on iron, which is the one ordering agnos has structurally never produced. amdgpu runs #76 only
# inside a full modeset; agnos historically ran it bare, and it blanked this panel TWICE. M6's envelope is
# what makes it survivable — NOT safe.
#
# ⛔⛔ WHAT THIS IS NOT: this is NOT "the HDMI-audio fix". That framing is FALSIFIED (gpu.md:292) — a cold
# output-enable + AVMUTE edge already shipped and burned SILENT while the panel visibly blanked. M8's
# deliverable is the ENVELOPED REAL-TRANSMITTER MODESET itself, and its oracles are DISPLAY SURVIVAL and an
# unchanged refresh — NEVER audio. Audio is M9's test (audio-enable sequenced LAST, after a genuine
# transmitter edge), and it only becomes meaningful once this exists.
#
# The sequence the amdgpu capture dictates (ordering corrected 1.56.14, review S5 — the connect used to
# sit BEFORE #76, which left the pipe attached through exactly the window the bracket exists to protect):
#   BE<->FE DISCONNECT (DIG_BE_CNTL FE_SOURCE_SELECT -> 0)   [nothing feeds the encoder while it is set up]
#   -> ATOM #4  DIGxEncoderControl   (display-safe: DIG front end, regs 0x56xx, disjoint from the PHY)
#   -> HDMI stream attributes + infoframes
#   -> ATOM #76 DIG1TransmitterControl(ENABLE)  [DESTRUCTIVE: power-cycles the PHY; build-gated]
#      ⛔ still DETACHED — the capture holds the FE off across the ENTIRE PHY block
#   -> BE<->FE CONNECT (-> 0x02)
#   -> BE<->FE PULSE (disconnect/connect) then REPLAY the stream-attribute + infoframe block verbatim
#   -> OTG re-commit (M6's envelope close)
#
# ⛔ THREE BUILD FLAGS GOVERN WHAT ACTUALLY EXECUTES, and that is the safety model:
#   (none)                — this op refuses with MDO_E_NOATOM. A production kernel CANNOT drive the PHY.
#   HDMI_ATOM             — the envelope + BE/FE bracket + ATOM #4 run. #76 is SKIPPED. Cannot blank (M8d).
#   + ATOM_RUN_TRANSMITTER — #76 runs live. THE dangerous rung (M8e). H8 must prove, per flash, that the
#                            marker is PRESENT in this build and ABSENT in a bare one — because the last
#                            accidental blanking came from ATOM_DRY being a flag build.sh never emitted, so
#                            "dry" and "live" compiled byte-identical.
fn mdo_transmit_run(arm) {
    if (gpu_present == 0)      { return MDO_E_NOGPU; }
    if (gpu_display_ok != 1)   { return MDO_E_NOGPU; }
    if (gpu_display_pipe != 0) { kprintln("modeset: transmit refused -- live pipe is not 0", 47); return MDO_E_NOGPU; }
    if (gpu_pixclk_100hz == 0) { kprintln("modeset: transmit refused -- pixclk unmeasured (0)", 50); return MDO_E_UNMEAS; }
    if (gpu_audio_dig < 0)     { kprintln("modeset: transmit refused -- no live DIG encoder found", 54); return MDO_E_NOGPU; }
    #ifdef HDMI_ATOM
    var pipe = 0;
    var d    = gpu_audio_dig * GPU_DCN_DIG_STRIDE;      # the live stream encoder (DIG1 on this iron)

    # ── ATOM prelude, OUTSIDE the envelope ──────────────────────────────────────────────────────────
    # Acquiring + parsing the VBIOS is slow and allocates 2 MB; doing it inside the disabled window would
    # stretch the blank and let a failure strand a dark pipe. All three are idempotent, so a re-run is free.
    # A failure here costs NOTHING: the latch is not armed yet and no register has been touched.
    if (gpu_vbios_acquire() == 0) { kprintln("modeset: transmit refused -- vbios acquire failed", 49); return MDO_E_ATOM; }
    if (atom_parse() == 0)        { kprintln("modeset: transmit refused -- atom parse failed", 46); return MDO_E_ATOM; }
    if (atom_init_mem() == 0)     { kprintln("modeset: transmit refused -- atom init failed", 45); return MDO_E_ATOM; }

    if (modeset_arm(8) != 1) { kprintln("modeset: transmit refused -- latch would not arm", 48); return MDO_E_ARM; }
    # ⛔ THE GATE, carried HERE. atom_reg_write (atom.cyr:267) writes MMIO directly and never goes through
    # gpu_dcn_write_committed / gpu_otg_lock, so the GATE embedded in those primitives does NOT cover the
    # ATOM path. M6 carries it for the same reason (its writes are direct too). Belt-and-suspenders against
    # a future edit that moves the arm.
    if (modeset_armed != 1297040453) { kprintln("modeset: transmit refused -- not armed", 38); return MDO_E_ARM; }

    # ── H1: pre-state, spilled BEFORE any write. Doubles as the watchdog's re-run program. ───────────
    var s_ctrl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL) & 0xFFFFFFFF;
    var s_htot  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL) & 0xFFFFFFFF;
    var s_hbl   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_BLANK_START_END) & 0xFFFFFFFF;
    var s_hsa   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A) & 0xFFFFFFFF;
    var s_hsac  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A_CNTL) & 0xFFFFFFFF;
    var s_htc   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_H_TIMING_CNTL) & 0xFFFFFFFF;
    var s_vtot  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL) & 0xFFFFFFFF;
    var s_vmin  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MIN) & 0xFFFFFFFF;
    var s_vmax  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MAX) & 0xFFFFFFFF;
    var s_vctl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_CONTROL) & 0xFFFFFFFF;
    var s_vbl   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_BLANK_START_END) & 0xFFFFFFFF;
    var s_vsa   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A) & 0xFFFFFFFF;
    var s_vsac  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A_CNTL) & 0xFFFFFFFF;
    var s_intl  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_INTERLACE_CONTROL) & 0xFFFFFFFF;
    var s_vst   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VSTARTUP_PARAM) & 0xFFFFFFFF;
    var s_vup   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VUPDATE_PARAM) & 0xFFFFFFFF;
    var s_vrd   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_VREADY_PARAM) & 0xFFFFFFFF;
    var s_vtg   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_VTG0_CONTROL) & 0xFFFFFFFF;
    var s_occ   = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_CLOCK_CONTROL) & 0xFFFFFFFF;
    var s_oicc  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC_INPUT_CLOCK_CONTROL) & 0xFFFFFFFF;
    var vt_field = s_vtot & GPU_OTG_TOTAL_MASK;
    # ⛔⛔ DISCOVER THE PHYID *HERE*, ONCE, ON THE PRISTINE INHERITED STATE — never at the ATOM call sites.
    # gpu_phy_discover() needs DIG_ENABLE set AND FE_SOURCE_SELECT non-zero, and THIS OP DESTROYS BOTH
    # before the transmitter runs: the BE<->FE disconnect below clears FE_SOURCE_SELECT, and #76 DISABLE
    # clears DIG_ENABLE. Discovering at the call sites returned -1 and made BOTH halves of the cycle refuse
    # — the DISABLE never firing (a wasted burn) and, once that was "fixed", the ENABLE refusing after the
    # link was already down (a dark panel). Same class as the original phyid bug: right source, wrong time.
    var s_phy = gpu_phy_discover();
    if (s_phy < 0) { kprintln("modeset: transmit refused -- no live link encoder (phyid undeterminable)", 72); return MDO_E_NOGPU; }
    # ⛔ THE BACK END IS INDEXED BY THE LINK-ENCODER INSTANCE, NOT THE STREAM-ENCODER ONE. `d` is
    # gpu_audio_dig * stride — the FRONT end (DIG_FE_CNTL/AFMT/HDMI live there and correctly use `d`).
    # DIG_BE_CNTL / DIG_BE_EN_CNTL are the BACK end and belong to the PHY instance, which is what ATOM's
    # phyid names. Both are 1 on archaemenid so `d` happened to work — that coincidence is the whole
    # front-end/back-end conflation this arc already paid for once. Index them by s_phy.
    var db      = s_phy * GPU_DCN_DIG_STRIDE;

    # ⛔⛔⛔ NORMALISE DIG_MODE TO THE BOOT-INHERITED VALUE **HERE**, AT ARM ENTRY — NOT AT ARM EXIT.
    #
    # This used to be done at the END of the arm, to keep the arms independent (arm 1 must not hand arm 2
    # a link already sitting in HDMI). The independence requirement is REAL and is kept. Restoring at the
    # END, however, made the whole experiment incapable of producing its own result:
    #
    #   the operator listens AFTER the command returns — and by then the arm had put DIG_MODE back to 2
    #   (DVI). **Every HDMI_* register is inert in DVI mode** (gpu.cyr's own safety contract), so there
    #   are no data islands, no audio sample packets, and no possible sound — in EITHER arm, at ANY
    #   unmute position, no matter how correct every register was while the op was still running.
    #
    # ⇒ The 2026-07-24 "both arms silent" verdict had TWO independent structural causes, and the missing
    # HDA_TONE was only the first. A burn cannot measure a thing it switches off before the measurement.
    #
    # Doing it at entry satisfies both requirements at once: every arm STARTS from the identical
    # boot-inherited signalling regardless of what ran before it, and every arm ENDS in HDMI, which is
    # both the state under test and the state the operator is listening to.
    #
    # ⚠ Safe by demonstration, not by argument: the 07-31 log shows the pipe re-enabled, relit and
    # frequency-locked (`resumed 1`, 59951 mHz, within 7 ppm) with DIG_MODE ALREADY 3 — the old restore
    # ran after that. The panel is iron-proven to work in HDMI signalling; leaving it there is not a new
    # risk. The watchdog and the boot latch are unchanged and still cover a dark pipe.
    # ⚠ LATCHED ON FIRST USE, FROM `db` — NOT from gpu_audio_probe(). The probe walks the FRONT ends and
    # its `bc` is indexed by the stream encoder; DIG_BE_CNTL belongs to the BACK end and is indexed by
    # s_phy. Both are 1 on archaemenid, and taking that coincidence for identity is the exact front/back
    # conflation this file already paid for once. Latching here uses the same `db` every later write does.
    # ⚠ Sound because MODESET_AUDIO suppresses the boot-time audio enable, so the FIRST arm of a boot
    # necessarily observes the GOP's inherited signalling and nothing else can have moved it.
    # Never hardcode 2: that is this box's inherited value, not a fact about DCN.
    if (arm != 0) {
        var be_pre = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;
        var dm_pre = (be_pre & GPU_DIG_MODE_MASK) >> GPU_DIG_MODE_SHIFT;
        if (gpu_dig_mode_boot == 0) {
            gpu_dig_mode_boot = dm_pre;
            kprint("modeset: transmit -- DIG_MODE inherited value latched: ", 55);
            kprint_num(dm_pre); kprintln(" (first arm this boot)", 22);
        }
        if (dm_pre != gpu_dig_mode_boot) {
            gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db,
            (be_pre & (0 - 1 - GPU_DIG_MODE_MASK)) | (gpu_dig_mode_boot << GPU_DIG_MODE_SHIFT));
            gpu_mfence();
            kprint("modeset: transmit -- DIG_MODE normalised ", 41); kprint_num(dm_pre);
            kprint(" -> ", 4); kprint_num(gpu_dig_mode_boot);
            kprintln(" at ENTRY (arms start identical)", 32);
        }
    }

    var s_be    = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;
    var s_been  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_EN_CNTL + db) & 0xFFFFFFFF;

    kprint("modeset: transmit pre-state dig ", 32); kprint_num(gpu_audio_dig);
    kprint(" phyid ", 7); kprint_num(s_phy);
    kprint(" be_cntl ", 9); kprint_num(s_be); kprint(" be_en ", 7); kprint_num(s_been);
    kprint(" v_total ", 9); kprint_num(vt_field + 1); kprintln("", 0);
    # D6: spill NOW, before anything risky. If the ATOM trace later floods the 64 KB ring or the box hangs
    # mid-table, /klug.txt still holds the pre-state and the phyid — the two facts needed to interpret it.
    klug_spill();
    # Distinguish the two transmitter failure modes. They could not be more different operationally:
    # a refused/failed DISABLE leaves the panel ALIVE (nothing was taken down); an ENABLE that fails after a
    # successful DISABLE leaves it DARK and needs a power cycle. Collapsing both into one rc, as the first
    # cut did, would tell the operator "ATOM error" for both.
    var tx_phy_down   = 0;
    var tx_dis_failed = 0;

    # Same refuse-gates as M5/M6: only the arc's calibrated GOP mode, DRR off. Nothing has been touched yet.
    if (vt_field != 1480) { kprintln("modeset: transmit refused -- V_TOTAL field is not the calibrated 1480", 69); return MDO_E_NOTMODE; }
    if (s_vctl != 0) { kprintln("modeset: transmit refused -- V_TOTAL_CONTROL nonzero (DRR on) -- untested", 73); return MDO_E_DRR; }

    var unf0 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var fc0  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;

    # ── ENVELOPE OPEN: OTG_MASTER_EN = 0 (M6's proven disable) ──────────────────────────────────────
    kprintln("modeset: transmit -- OTG_MASTER_EN 0 (envelope open; panel blanks)", 66);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl & (0 - 1 - GPU_OTG_MASTER_EN));
    gpu_mfence();
    var stopped = mdo_wait_frame_stop(pipe);
    var fc_dis  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    kprint("modeset: transmit -- frame count ", 33); kprint_num(fc0); kprint(" -> ", 4); kprint_num(fc_dis);
    kprint(" stopped ", 9); kprint_num(stopped); kprintln("", 0);
    # ⛔ ABORT HERE, NOT AT THE VERDICT. The entire safety case for this bite is "the risky work happens with
    # the pipe disabled". If the disable did not take, that case is VOID — so bail before the BE<->FE break,
    # before #4's DIG_START strobe and before the HDMI block, instead of doing all of it and reporting NOSTOP
    # afterwards. Only OTG_CONTROL has been written at this point, so restoring s_ctrl is an exact undo.
    if (stopped == 0) {
        kprintln("modeset: TRANSMIT ABORT -- OTG_MASTER_EN=0 did not stop the pipe; nothing else attempted", 88);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl);
        gpu_mfence();
        return MDO_E_NOSTOP;
    }

    # ── BE<->FE DISCONNECT: clear FE_SOURCE_SELECT so no front end feeds the encoder while it is set up ──
    # M9: the audio arms ALSO flip DIG_MODE 2 (DVI) -> 3 (HDMI) in this SAME write, because that is what the
    # capture does — one store of 0x10030000 to abs 0x566f, mode and disconnect together, inside the window
    # where the OTG is verified stopped. Two writes here would put a moment of live-HDMI-with-no-front-end
    # on the wire that the reference never produces.
    # ⛔ ARM 0 (plain MDO_OP_TRANSMIT) KEEPS DIG_MODE 2 — byte-for-byte the rung M8e already burned green.
    # Every HDMI_* register is inert at DIG_MODE 2 (gpu.cyr's safety contract), so arm 0 stays the bounded
    # display-only experiment it was validated as, and the flip is a variable only the audio arms carry.
    var be_dis = s_be & (0 - 1 - GPU_DIG_FE_SOURCE_SEL_MASK);
    #ifdef MODESET_AUDIO
    # ⚠ FIELD-modify the CURRENT value — never write a whole register derived from a snapshot
    # ([[reference_agnos_dcn_hubp_reg_offsets_derived]]). Mask the field out, then OR the new mode in.
    if (arm != 0) {
        be_dis = (be_dis & (0 - 1 - GPU_DIG_MODE_MASK)) | (GPU_DIG_MODE_HDMI << GPU_DIG_MODE_SHIFT);
        kprintln("modeset: transmit -- DIG_MODE 2 -> 3 (HDMI signalling live; audio arm)", 70);
    }
    #endif
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db, be_dis);
    gpu_mfence();
    # ARM THE RE-DISCOVERY TRIPWIRE: from here until the reconnect below, gpu_phy_discover() cannot answer
    # (FE_SOURCE_SELECT is 0). Anything that asks in this window gets a NAMED refusal telling it to pass a
    # latched phyid instead of a generic "undeterminable". See gpu_phy_routing_torn in gpu.cyr.
    gpu_phy_routing_torn = 1;

    # ── ATOM #4 DIGxEncoderControl — programs the DIG FRONT END for HDMI (data islands, clock pattern).
    # ⚠ It does NOT switch the link to HDMI signalling: #4 leaves DIG_BE_CNTL.DIG_MODE untouched (see the
    # reconnect below for the measured write set). Saying "#4 puts the DIG in HDMI mode" is the claim that
    # would make this burn's headline oracle false — in the audio arms the link is already at DIG_MODE 3
    # when #4 runs, but the DISCONNECT above put it there, not #4. Display-SAFE:
    # it drives the digital front end (0x56xx), disjoint from the PHY (0x5Dxx), and is iron-exonerated.
    kprintln("modeset: transmit -- ATOM #4 DIGxEncoderControl (HDMI setup)", 60);
    var r4 = atom_run_encoder_hdmi();
    kprint("modeset: transmit -- encoder rc ", 32); kprint_num(r4); kprintln("", 0);

    # ── HDMI stream attributes + infoframes (M8c: now callable) ─────────────────────────────────────
    # ⚠ The AFMT audio clock is gpu_hdmi_program_infoframes's documented PRECONDITION (the AFMT block is
    # inert without it and reports nothing wrong). On a boot where gpu_hdmi_audio_enable never ran — every
    # production kernel — it is OFF, so enable it here rather than inheriting someone else's setup. Never
    # gate on the ACK: amdgpu leaves that REG_WAIT commented out ("audio seems work normally even without").
    var afc = gpu_reg32(GPU_BASE_DCN_2, GPU_R_AFMT_CNTL + d);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_AFMT_CNTL + d, afc | GPU_AFMT_AUDIO_CLOCK_EN);
    gpu_hdmi_stage_attributes(d);
    gpu_hdmi_program_infoframes(d, gpu_audio_dig);
    kprintln("modeset: transmit -- stream attributes + infoframes programmed", 62);

    # ── M9: STAGE THE AUDIO — MUTED, BEFORE THE EDGE, IN BOTH ARMS ──────────────────────────────────
    # amdgpu programs the whole audio register file here (~206 us before OTG master-enable) with the tap
    # SHUT, then unmutes ~22 ms later on the far side of the transmitter edge. Under MODESET_AUDIO
    # gpu_hdmi_audio_enable() is exactly that staging half — AUDIO_ENABLED, the slot map and SAMPLE_SEND
    # have been moved out of it into gpu_hdmi_audio_unmute().
    # ⚠ Staging is IDENTICAL in both arms. The ONLY thing that differs between the control and the
    # treatment is WHERE the unmute happens — that is what makes this a single-variable experiment rather
    # than another "we changed the audio path and listened".
    #ifdef MODESET_AUDIO
    var aud_fail = 0;
    var r_aud = 0;
    # ⭐⭐ THE STIMULUS, AND ITS BLINDING — the two things M9 lacked on 2026-07-24.
    #
    # That burn ran with HDA_TONE off (deliberately, to keep the ear oracle unguessable) and with no
    # ring-3 feed ever launched, so hda_stream_arm zero-filled the ring and BOTH arms streamed exact
    # silence. "Silent, silent" was structurally guaranteed and went into the record as the falsification
    # of the sequencing candidate. burn-prep.sh now REFUSES to build a MODESET_AUDIO arm without
    # HDA_TONE; this is the other half — the arms are given DIFFERENT sweep bands so they are told apart
    # by WHICH tone, not by whether one was heard.
    #
    # ⛔ Ask the operator "low or high?", never "did you hear it?". A yes/no ear oracle cannot separate a
    # real negative from a null experiment, and cannot resist an expectant listener; a band he was not
    # told in advance can do both. Bands are an octave-and-a-half apart and non-overlapping so no part of
    # either sweep can be mistaken for the other.
    if (arm == 1) { hda_tone_band(300, 600); }     # ARM 1 CONTROL   — the LOW sweep
    if (arm == 2) { hda_tone_band(1000, 1400); }   # ARM 2 TREATMENT — the HIGH sweep
    if (arm != 0) {
        # ⛔ PASS THE LATCHED s_phy — DO NOT let this re-discover (M9d-fix, and it is the whole reason this
        # op latches a phy at the top). By the time control reaches here the BE<->FE disconnect above has
        # already cleared FE_SOURCE_SELECT, so gpu_phy_discover() would return -1, staging would refuse,
        # and BOTH audio arms would unmute over a register file that was never programmed — two identical
        # non-experiments wearing the names "control" and "treatment".
        r_aud = gpu_hdmi_audio_enable(s_phy);
        kprint("modeset: transmit -- audio staged (muted) rc ", 45); kprint_num(r_aud); kprintln("", 0);
        if (r_aud == 0) { aud_fail = 1; }
    }
    # ARM 1 = CONTROL: unmute HERE, before the transmitter edge — i.e. what agnos has always done.
    if (arm == 1) {
        kprintln("modeset: transmit -- ARM 1 CONTROL: unmute BEFORE the edge", 58);
        if (gpu_hdmi_audio_unmute() == 0) { aud_fail = 1; }
    }
    #endif

    # ── ATOM #76 DIG1TransmitterControl(ENABLE) — THE PHY EDGE, run with the FE STILL DETACHED ─────────
    # ⛔ ORDERING IS LOAD-BEARING (review S5, corrected 1.56.14). This used to reconnect BE<->FE *before*
    # #76. Both amdgpu capture instances hold the front end DETACHED across the ENTIRE PHY block and connect
    # only afterwards — which is the whole point of bracketing: the encoder must not be fed while its
    # transmitter is being power-cycled. Reconnecting first left the pipe attached through exactly the
    # window the bracket exists to protect.
    # ⛔ THREE RUNGS, and which one runs is a BUILD property (see the flag table at the top):
    #   ATOM_TX_CYCLE          — DISABLE then ENABLE: the REAL transmitter edge. The panel goes DARK
    #                            between them by design; the ENABLE's 20-write bring-up must relight it.
    #   ATOM_RUN_TRANSMITTER   — ENABLE only. Now known to be a NO-OP on an already-enabled transmitter
    #                            (4r/2w/0d, zero PHY writes), which makes it a useful NEGATIVE CONTROL:
    #                            same code path, same envelope, no edge. If a run with this flag changes
    #                            anything the operator can see, the change did NOT come from the edge.
    #   (neither)              — #76 never runs at all.
    #ifdef ATOM_TX_CYCLE
    kprintln("modeset: transmit -- ATOM #76 CYCLE: DISABLE then ENABLE (REAL PHY EDGE)", 72);
    var rdis = atom_run_transmitter_disable_hdmi(s_phy);
    kprint("modeset: transmit -- transmitter DISABLE rc ", 44); kprint_num(rdis); kprintln("", 0);
    var r76 = atom_run_transmitter_enable_hdmi(s_phy);
    kprint("modeset: transmit -- transmitter ENABLE rc ", 43); kprint_num(r76); kprintln("", 0);
    # ⛔ D4/D7 — THE ONE STATE THAT MUST NEVER BE REPORTED AS A GENERIC ERROR: the DISABLE succeeded and the
    # ENABLE did not. The link is DOWN and the only code that re-asserts DIG_ENABLE and re-brings-up RDPCSTX
    # just failed. The watchdog CANNOT see this — it keys on the OTG frame counter, which free-runs off the
    # pixel PLL and will happily resume once the envelope closes, so `resumed` reads 1 on a dead PHY.
    # So detect it HERE, deterministically, while still inside the disabled window, and RETRY the ENABLE
    # once with the latched phyid before giving up. A retry costs milliseconds; a dark panel costs a boot.
    if (rdis == 0) {
        if (r76 != 0) {
            kprintln("modeset: transmit -- PHY DOWN: DISABLE took but ENABLE failed -- retrying ENABLE once", 85);
            r76 = atom_run_transmitter_enable_hdmi(s_phy);
            kprint("modeset: transmit -- ENABLE retry rc ", 37); kprint_num(r76); kprintln("", 0);
            if (r76 != 0) { tx_phy_down = 1; }
        }
    }
    # A failed DISABLE is a different, SAFER story: the PHY was never taken down, so the panel is alive and
    # nothing needs recovering. Keep the two distinguishable rather than collapsing both into one rc.
    if (rdis != 0) { tx_dis_failed = 1; }
    #endif
    #ifdef ATOM_RUN_TRANSMITTER
    kprintln("modeset: transmit -- ATOM #76 ENABLE only (negative control; no edge expected)", 78);
    var r76 = atom_run_transmitter_enable_hdmi(s_phy);
    kprint("modeset: transmit -- transmitter rc ", 36); kprint_num(r76); kprintln("", 0);
    #endif
    #ifndef ATOM_TX_CYCLE
    #ifndef ATOM_RUN_TRANSMITTER
    var r76 = 0;
    kprintln("modeset: transmit -- ATOM #76 SKIPPED (PHY untouched; no transmitter flag set)", 78);
    #endif
    #endif

    # ── BE<->FE CONNECT: re-point the back end at the front end (verified value 0x0200 in [15:8]) ────
    # ⛔ DIG_MODE IS DELIBERATELY *NOT* TOUCHED HERE — read this before "fixing" it.
    #
    # ATOM #4 programs the DIG FRONT end only. Verified from the oracle, not assumed: #4's entire write set
    # is three registers — abs 0x5628 / 0x562B / 0x569A, i.e. DIG1's DIG_FE_CNTL (rel 0x2068 + the 0x100
    # stride) and two neighbours. It NEVER writes DIG_BE_CNTL (abs 0x566F), so it does NOT switch the link
    # to HDMI signalling. `digmode=3` in its parameters only steers branches inside the table.
    #
    # So in ARM 0 DIG_MODE stays 2 (DVI) for the whole op, and that is the POINT of that rung: every HDMI_*
    # register is inert while DIG_MODE == 2 (gpu.cyr's own safety contract), which is what makes running the
    # full sequence — bracket, #4, stream attributes, infoframes — a bounded experiment. Expect
    # `be_cntl 0x10020200 -> 0x10020200`: that is the CORRECT arm-0 result, not evidence that #4 failed.
    #
    # ⚠ M9 UPDATE — the flip that this comment used to say "belongs to a later rung" IS that later rung, and
    # it landed: the AUDIO arms (1 and 2) set DIG_MODE -> 3 at the DISCONNECT above, not here, because the
    # capture pairs mode and disconnect in one store. So in arms 1/2 expect `0x10020200 -> 0x10030200` and
    # a LIVE infoframe block — that is the whole reason those arms can carry audio at all.
    #
    # ⚠ The RMW re-reads rather than reusing the `s_be` captured before #4. Value-identical today, but
    # deriving a whole-register write from a snapshot taken at a different time is the
    # [[reference_agnos_dcn_hubp_reg_offsets_derived]] class — modify a FIELD of the CURRENT value.
    var be_now  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;
    var be_conn = (be_now & (0 - 1 - GPU_DIG_FE_SOURCE_SEL_MASK)) | GPU_DIG_FE_SOURCE_CONNECT;
    #ifdef MODESET_AUDIO
    # ⛔⛔ RE-ASSERT DIG_MODE HERE — ATOM #76 ENABLE PUT IT BACK TO DVI.
    # MEASURED ON IRON 2026-07-24 (M9 burn, both arms). The flip at the disconnect DID take
    # (`DIG_MODE 2 -> 3`), and then #76's own ENABLE table overwrote it:
    #       atom r=566f v=10030200
    #       atom w=566f v=10020200      <- mode 3 -> 2, inside the ATOM table
    # so the link finished in DVI, the whole HDMI_* block was inert, and NEITHER arm could carry
    # audio. Both returned the same silence for the same reason, which is exactly the
    # indistinguishable-arms failure this op is built to prevent.
    #
    # ⚠ THIS IS WHY agnos DIVERGES FROM THE CAPTURE AND THE CAPTURE CANNOT TELL US: amdgpu drives
    # the PHY through its native link_enc code, never ATOM #76, so nothing in amdgpu's sequence
    # resets DIG_MODE and its single 0x10030000 store at the disconnect is sufficient. agnos goes
    # through the ATOM table, which does reset it. A write-list diff against the ftrace could
    # never have surfaced this — only running the table on iron could.
    #
    # ⛔ The M9d verdict gate is what caught it (`TRANSMIT no-hdmi -- audio arm did not leave the
    # link in HDMI signalling`). Without that gate both arms return a clean 95 and the silence
    # reads as a real negative about sequencing. Do not remove it.
    if (arm != 0) {
        be_conn = (be_conn & (0 - 1 - GPU_DIG_MODE_MASK)) | (GPU_DIG_MODE_HDMI << GPU_DIG_MODE_SHIFT);
        kprintln("modeset: transmit -- DIG_MODE re-asserted to 3 after #76 (ATOM reset it to 2)", 77);
    }
    #endif
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db, be_conn);
    gpu_mfence();
    # DISARM: routing is restored, so discovery is meaningful again. ⚠ Disarm AFTER the write lands, not
    # before it — the flag tracks the HARDWARE's state, not our intention to fix it.
    gpu_phy_routing_torn = 0;
    gpu_mfence();
    var be_rb = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;

    # ── The BE<->FE PULSE, then THE REPLAY — both AFTER the connect, per the capture ────────────────
    #ifdef ATOM_TX_ANY
    # The capture emits a disconnect/connect PULSE on the reconnected link before re-sending the stream
    # attributes: the encoder is re-latched once more so the replayed packets land on a freshly-routed
    # front end rather than on whatever state the PHY power-cycle left behind.
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db, be_conn & (0 - 1 - GPU_DIG_FE_SOURCE_SEL_MASK));
    gpu_mfence();
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db, be_conn);
    gpu_mfence();
    # THE REPLAY (M8c). amdgpu's modeset re-emits the whole stream-attribute + infoframe block AFTER the
    # transmitter edge, and agnos has structurally never been able to — the writes were welded inside a
    # 497-line audio-enable path. ⚠ HONEST: it is NOT established that #76 clears these registers (#76's own
    # write set is PHY/UNIPHY only — 0x55xx/0x5Dxx/0x5Exx — disjoint from AFMT/HDMI at 0x20xx). What IS
    # established is that the capture emits them after the edge and agnos never has. Whether the replay is
    # REQUIRED is what this burn measures; do not let this comment harden into a claim.
    gpu_hdmi_stage_attributes(d);
    gpu_hdmi_program_infoframes(d, gpu_audio_dig);
    kprintln("modeset: transmit -- BE<->FE pulse + post-#76 replay complete", 61);
    #endif

    # ── ENVELOPE CLOSE: reprogram the timing group same-mode, then OTG_MASTER_EN = 1 ────────────────
    # ⛔ Write BACK the saved clock-controls; NEVER force amdgpu's 0x3. The GOP runs 0x10101 / 0x6 and the
    # M6 iron burn showed forcing 0x3 would have been the one non-same-mode write in the envelope.
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL, s_htot);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_BLANK_START_END, s_hbl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A, s_hsa);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A_CNTL, s_hsac);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TIMING_CNTL, s_htc);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL, s_vtot);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MIN, s_vmin);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MAX, s_vmax);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_BLANK_START_END, s_vbl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A, s_vsa);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A_CNTL, s_vsac);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_INTERLACE_CONTROL, s_intl);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VSTARTUP_PARAM, s_vst);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VUPDATE_PARAM, s_vup);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VREADY_PARAM, s_vrd);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_VTG0_CONTROL, s_vtg);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CLOCK_CONTROL, s_occ);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OPTC_INPUT_CLOCK_CONTROL, s_oicc);
    gpu_mfence();
    kprintln("modeset: transmit -- OTG_MASTER_EN 1 (envelope close)", 53);
    gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl);
    gpu_mfence();

    var resumed = gpu_display_wait_vblank(pipe);
    gpu_dcn_hold_ms(120);
    var fc1 = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
    if (resumed == 0) { if (fc1 != fc_dis) { resumed = 1; } }   # M6's D2 re-confirm across the settle

    # ── M9: ARM 2 = TREATMENT — unmute on the FAR side of the transmitter edge ──────────────────────
    # This is the whole hypothesis in four lines: the sink latches its audio state at the edge, so a tap
    # opened BEFORE the edge is latched shut and stays shut no matter how correct every register is.
    # ⚠ Gated on `resumed` — an unmute into a pipe that never came back cannot be heard, and would only
    # add writes while the watchdog below is trying to recover the panel. A dark boot must stay a clean
    # display failure, not a display failure tangled up with an audio experiment.
    # ⚠ The capture's gap is 22.2 ms after the DIG edge; the 120 ms settle above ALREADY exceeds it, so
    # no extra hold is needed. What is being reproduced is the ORDER, not the latency.
    #ifdef MODESET_AUDIO
    if (arm == 2) {
        if (resumed == 1) {
            kprintln("modeset: transmit -- ARM 2 TREATMENT: unmute AFTER the edge", 59);
            if (gpu_hdmi_audio_unmute() == 0) { aud_fail = 1; }
        }
        if (resumed == 0) { kprintln("modeset: transmit -- ARM 2 unmute SKIPPED (pipe never resumed)", 62); }
    }
    #endif

    # ── THE SELF-RECOVERING WATCHDOG (M8's escalation; M6 only reported a dark pipe) ─────────────────
    # ⛔ Every hold on this path is gpu_dcn_hold_ms (WALL-CLOCK), NEVER gpu_dcn_hold — the latter aborts the
    # whole hold on one bounded-vblank timeout and silently collapses to ~50 ms on a STOPPED pipe, which is
    # precisely the state this code runs in. Wiring recovery to it would destroy the window it needs.
    if (resumed == 0) {
        kprintln("modeset: WATCHDOG -- pipe dark after the edge; re-running the inherited-mode program", 84);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db, s_be);        # restore the inherited routing
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl & (0 - 1 - GPU_OTG_MASTER_EN));
        gpu_mfence();
        gpu_dcn_hold_ms(60);
        # ⛔⛔ THE FULL SAVE SET, NOT A SUBSET — WIDENED 1.56.33 BEFORE THE COLD PATH, NOT AFTER.
        # This re-run used to restore SIX registers (BE, CONTROL, H_TOTAL, V_TOTAL, CLOCK_CONTROL,
        # OPTC_INPUT_CLOCK_CONTROL) out of the twenty the save captures. That was SOUND FOR EVERY
        # SHIPPED RUNG and only for them: M5 writes V_TOTAL alone, M6 replays the same mode, M8
        # touches PHY/DIG and not the raster at all — so the other fourteen were still holding their
        # inherited values and restoring them was a no-op.
        # ⚠ THE COLD PATH BREAKS THAT PREMISE EXACTLY. H_BLANK / H_SYNC_A / H_TIMING_CNTL / V_BLANK /
        # V_SYNC_A / VSTARTUP / VUPDATE / VREADY / VTG0 **are** the raster program — they are what a
        # cold bring-up writes. The moment one is programmed from a mode description, a six-register
        # re-run can no longer reconstruct the inherited mode, and the recovery net would have a hole
        # positioned precisely under the new risk. Widening it is therefore a PREREQUISITE of the
        # cold work, not a follow-up to it.
        # ⭐ Every write here is a value read from THIS pipe moments ago (the save at the top of this
        # op), so this is a pure restore — the safest class of write there is. Order mirrors the save:
        # H group, V group, the DCN timing-generator params, then the clocks, then re-enable.
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TOTAL, s_htot);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_BLANK_START_END, s_hbl);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A, s_hsa);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_SYNC_A_CNTL, s_hsac);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_H_TIMING_CNTL, s_htc);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL, s_vtot);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MIN, s_vmin);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_MAX, s_vmax);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_TOTAL_CONTROL, s_vctl);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_BLANK_START_END, s_vbl);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A, s_vsa);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_V_SYNC_A_CNTL, s_vsac);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_INTERLACE_CONTROL, s_intl);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VSTARTUP_PARAM, s_vst);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VUPDATE_PARAM, s_vup);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_VREADY_PARAM, s_vrd);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_VTG0_CONTROL, s_vtg);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CLOCK_CONTROL, s_occ);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OPTC_INPUT_CLOCK_CONTROL, s_oicc);
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_OTG_CONTROL, s_ctrl);
        gpu_mfence();
        var back = gpu_display_wait_vblank(pipe);
        gpu_dcn_hold_ms(120);
        var fc2 = gpu_reg32(GPU_BASE_DCN_2, GPU_R_OTG_FRAME_COUNT) & GPU_OTG_FRAME_COUNT_MASK;
        if (back == 0) { if (fc2 != fc1) { back = 1; } }
        if (back != 0) {
            kprintln("modeset: WATCHDOG -- re-run RELIT the pipe (transmitter edge rejected by the sink?)", 83);
            return MDO_E_NORESUME;
        }
        kprintln("modeset: WATCHDOG -- re-run FAILED, pipe still dark", 51);
        #ifdef ATOM_TX_ANY
        # LAST RUNG, and it must exist in EVERY build that can drive the transmitter. ⛔ This was gated on
        # ATOM_RUN_TRANSMITTER, which after the M8e re-scope is the *negative control* — a proven no-op that
        # cannot darken the panel — so the recovery compiled into the harmless build and OUT of the
        # dangerous one (ATOM_TX_CYCLE). Exactly backwards. ATOM_TX_ANY covers both rungs; the guard exists
        # to keep power_reset out of builds with no transmitter at all, not to pick between transmitter builds.
        # Safe ONLY because H2's latch was flushed + readback-verified to stable media BEFORE the first risky
        # write: the next boot's modeset_latch_check finds state 'A', SKIPS the modeset and comes up normal,
        # so this cannot loop.
        kprintln("modeset: WATCHDOG -- power_reset (H2 latch makes the reboot clean and self-disabling)", 85);
        # ⛔ SPILL BEFORE THE RESET. power_reset() never returns, so mdo_transmit's wrapper spill — the one
        # that guarantees "the evidence outlives every exit" — is unreachable from here. This is the single
        # highest-value failure in the arc (dark panel AND the re-run failed) and it was the one path that
        # would have lost its log. Latent until now only because the guard above was on the wrong flag.
        klug_spill();
        power_reset();
        #endif
        return MDO_E_NORESUME;
    }

    var refr = gpu_refresh_measure(pipe);
    var unf1 = (gpu_reg32(GPU_BASE_DCN_2, GPU_R_OPTC0_UNDERFLOW) >> 10) & 1;
    var be1  = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;
    var pred = gpu_pixclk_100hz * 100000 / (((s_htot & GPU_OTG_TOTAL_MASK) + 1) * (vt_field + 1));
    kprint("modeset: transmit -- resumed ", 29); kprint_num(resumed);
    kprint(" refresh ", 9); kprint_num(refr); kprint(" mHz predicted ", 15); kprint_num(pred); kprintln(" mHz", 4);
    kprint("modeset: transmit -- be_cntl ", 29); kprint_num(s_be); kprint(" -> ", 4); kprint_num(be1);
    kprint(" underflow ", 11); kprint_num(unf0); kprint(" -> ", 4); kprint_num(unf1); kprintln("", 0);
    # Decode DIG_MODE explicitly. The raw be_cntl pair above is easy to misread as "restored cleanly" when
    # it actually means the encoder command was undone — print the field that carries the whole point of
    # the bite (2 = DVI as the GOP left it, 3 = HDMI as ATOM #4 sets it).
    var dm0 = (s_be & GPU_DIG_MODE_MASK) >> GPU_DIG_MODE_SHIFT;
    var dm1 = (be1  & GPU_DIG_MODE_MASK) >> GPU_DIG_MODE_SHIFT;
    kprint("modeset: transmit -- DIG_MODE ", 30); kprint_num(dm0); kprint(" -> ", 4); kprint_num(dm1);
    kprintln("  (2=DVI 3=HDMI)", 16);

    #ifdef MODESET_AUDIO
    # ⛔⛔⛔ THE EXIT-TIME DIG_MODE RESTORE THAT USED TO SIT HERE IS DELETED. IT MADE THE EXPERIMENT
    # INCAPABLE OF PRODUCING ITS OWN RESULT.
    #
    # It wrote DIG_MODE back to the inherited 2 (DVI) as the last act of every arm, to keep the arms
    # independent. Independence is a real requirement and it is KEPT — it now happens at arm ENTRY (see
    # the normalisation block near the pre-state read), which is strictly better because it also survives
    # a reboot, a crash mid-arm, or the arms being run in either order.
    #
    # What it also did: the operator listens AFTER the command returns, and this left the link in DVI.
    # **Every HDMI_* register is inert in DVI mode** — gpu.cyr's own safety contract, and the reason the
    # whole staging block is safe to run on a live console link in the first place. So there were no data
    # islands and no audio sample packets during the entire listening window, in BOTH arms, at ANY unmute
    # position, regardless of how correct every register was while the op was still executing.
    #
    # ⭐ Read the 2026-07-31 log against this: `DIG_MODE 2 -> 3` at the flip, the full #76 edge, the
    # replay, `resumed 1` at 59951 mHz — and then `DIG_MODE restored to inherited 2`, one line before the
    # verdict told the operator to EAR-CHECK the sink. It was asking him to listen to a DVI link.
    #
    # ⇒ Two independent structural causes for the 2026-07-24 "both arms silent" verdict, not one: the
    # zero-filled ring, and this. Neither is a fact about the silicon. **A burn cannot measure a thing it
    # switches off before the measurement.**
    # ⭐⭐ THE LISTENING WINDOW LIVES *INSIDE* THE OP NOW, AND THEN THE PICTURE COMES BACK.
    #
    # Leaving DIG_MODE at 3 on return (1.56.34, first attempt) was right about audio and wrong about the
    # operator: iron 2026-07-31 — *"monitor loses signal during entire test"*. He ran the remaining two
    # commands BLIND, and the log shows it (`modeset --cc rccal`). On a one-machine setup that is not a
    # cosmetic problem: the console is the only interface he has while agnos is up.
    #
    # ⚠ AND IT IS ALSO A FINDING, recorded here because it is the cleanest A/B the arc has produced: with
    # DIG_MODE restored to 2 the panel relit every time; with it left at 3 the sink drops the link. Same
    # timing, same PLL, `resumed 1`, refresh locked to 10 ppm — the ONLY delta is DVI vs HDMI signalling.
    # ⇒ **The sink is rejecting agnos's HDMI stream, not just its audio.** A link the monitor has dropped
    # cannot carry audio either, so this may be upstream of everything the audio arc has been chasing.
    # Do NOT "fix" it by reverting to DVI: that hides the finding and guarantees silence.
    #
    # So: hold the HDMI state with the feed live for a bounded window the operator can listen through,
    # announce both edges of it, then restore the inherited signalling so the console returns. The listen
    # happens where the code controls it instead of after the prompt, which also removes the "how long do I
    # wait" ambiguity from the burn card.
    # ⛔ READ THE PACKET BLOCK HERE, AND ONLY HERE. This is the one moment in the whole arc where
    # `DIG_MODE`=3 and the feed are simultaneously live — the boot-time `gpu: audio probe` runs in mode 2,
    # where every `HDMI_*` register is inert, which is why "byte-identical to amdgpu" was never evidence
    # about the packet path. Before the hold, so the values are the ones the listening window is made of.
    gpu_hdmi_asp_probe();
    kprintln("modeset: >>> LISTEN NOW -- HDMI live, feed running, 12 s <<<", 60);
    gpu_dcn_hold_ms(12000);
    kprintln("modeset: <<< listening window CLOSED -- restoring inherited signalling >>>", 74);
    if (gpu_dig_mode_boot != 0) {
        var be_fin = gpu_reg32(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db) & 0xFFFFFFFF;
        gpu_reg32_write(GPU_BASE_DCN_2, GPU_R_DIG_BE_CNTL + db,
        (be_fin & (0 - 1 - GPU_DIG_MODE_MASK)) | (gpu_dig_mode_boot << GPU_DIG_MODE_SHIFT));
        gpu_mfence();
        kprintln("modeset: transmit -- signalling restored; the picture should be BACK", 68);
    }
    #endif

    # ── VERDICT ─────────────────────────────────────────────────────────────────────────────────────
    if (stopped == 0) { kprintln("modeset: TRANSMIT FAILED -- OTG_MASTER_EN=0 did not stop the pipe", 65); return MDO_E_NOSTOP; }
    if (r4 != 0) { kprintln("modeset: TRANSMIT FAILED -- ATOM #4 encoder returned an error", 61); return MDO_E_ATOM; }
    # ⛔ THE DARK-PANEL VERDICT, and it must come FIRST and read unmistakably. The operator is looking at a
    # black screen and needs to know it is expected to stay black until a power cycle — not to keep waiting.
    if (tx_phy_down != 0) {
        kprintln("modeset: TRANSMIT -- PHY IS DOWN: DISABLE took, ENABLE failed twice. POWER-CYCLE NOW.", 85);
        kprintln("modeset: (H2 latch is armed -- the next boot SKIPS the modeset and comes up normal)", 83);
        return MDO_E_PHYDOWN;
    }
    # A failed DISABLE is the SAFE failure: the PHY was never taken down, so the panel is alive.
    if (tx_dis_failed != 0) { kprintln("modeset: TRANSMIT FAILED -- #76 DISABLE did not run; PHY untouched, panel alive", 79); return MDO_E_ATOM; }
    if (r76 != 0) { kprintln("modeset: TRANSMIT FAILED -- ATOM #76 transmitter returned an error", 66); return MDO_E_ATOM; }
    # ⛔ Gate on `be1` — the read taken AFTER everything (review S2). `be_rb` is sampled immediately after
    # the connect, before the BE<->FE pulse and the replay, so in the #76-live build it can no longer
    # describe the final routing. Checking a stale readback would report "reconnected" about a state two
    # write-phases old. `be_rb` stays only as the immediate did-the-write-land probe.
    if ((be1 & GPU_DIG_FE_SOURCE_SEL_MASK) != GPU_DIG_FE_SOURCE_CONNECT) {
        kprintln("modeset: TRANSMIT FAILED -- BE<->FE reconnect did not read back", 63); return MDO_E_BEFE;
    }
    # ⛔ DO NOT add an UNCONDITIONAL "DIG_MODE must be HDMI" gate here — it would fail every arm-0 run.
    # #4 touches only the DIG front end, so in arm 0 nothing in this op sets DIG_MODE and it stays 2. Only
    # the audio arms flip it, at the disconnect, so the gate below is correctly arm-scoped.
    #ifdef MODESET_AUDIO
    if (arm != 0) {
        if (dm1 != GPU_DIG_MODE_HDMI) {
            kprintln("modeset: TRANSMIT no-hdmi -- audio arm did not leave the link in HDMI signalling", 80);
            return MDO_E_NOHDMI;
        }
    }
    #endif
    if (refr == 0) { kprintln("modeset: TRANSMIT unmeasurable -- pipe resumed but will not count", 65); return MDO_E_UNMEAS; }
    if (unf0 == 0) {
        if (unf1 != 0) { kprintln("modeset: TRANSMIT UNDERFLOW -- OPTC bit10 newly set by the edge", 63); return MDO_E_UNDERFLOW; }
    }
    # ⚠ Same blindness as M6: on this iron bit10 is pre-set at boot, so the delta above cannot fire and the
    # frame counter free-runs off the PLL. The PICTURE oracle is the operator's eyes, never this verdict.
    if (unf0 != 0) { kprintln("modeset: NOTE OPTC bit10 pre-set at boot -- CONFIRM THE PICTURE BY EYE (this instrument is blind here)", 102); }
    var dr = refr - pred;
    if (dr < 0) { dr = 0 - dr; }
    if (dr > 30) { kprintln("modeset: TRANSMIT off-rate -- refresh did not return to the inherited value", 75); return MDO_E_MODESET; }
    kprintln("modeset: TRANSMIT OK -- enveloped encoder edge survived, rate restored -- EYE-CHECK the picture", 95);
    # ── AUDIO VERDICT — LAST, and only after the display has already been declared OK ────────────────
    # ⛔ ORDER IS THE POINT. The display verdict is the one the operator is staring at a possibly-dark panel
    # waiting for; folding an audio failure into it would turn "the audio half refused" into what reads on
    # the console like a modeset failure, and the next burn would be spent recovering a display that was
    # never broken. "Panel survived, audio refused" must stay a DISTINGUISHABLE outcome.
    # ⚠ MDO_E_AUDIO says the register half refused, NOT that nothing was heard. Silence with rc 0 is the
    # EXPECTED negative result for arm 1 — that is what makes it the control. The ear is the oracle here,
    # exactly as the eye is for the picture; this code can only report that the writes went out.
    #ifdef MODESET_AUDIO
    if (aud_fail == 1) {
        kprintln("modeset: TRANSMIT audio-refused -- DISPLAY IS FINE, the audio half did not program", 82);
        return MDO_E_AUDIO;
    }
    if (arm != 0) { kprintln("modeset: TRANSMIT audio programmed -- EAR-CHECK the sink", 56); }
    #endif
    return 0;
    #else
    kprintln("modeset: transmit refused -- kernel not built with HDMI_ATOM (no ATOM table can run)", 84);
    return MDO_E_NOATOM;
    #endif
}

# mdo_transmit — the entry point, and it exists for ONE reason: to guarantee the evidence outlives the run.
#
# ⛔ THE REAL HAZARD OF THIS BITE IS NOT THE BLANK, IT IS THE BLINDNESS. Every instrument the op has —
# the frame counter and the refresh measurement — free-runs off the OTG's own pixel PLL, so it reports a
# healthy pipe whether or not the encoder is emitting anything a sink can display. A dark panel therefore
# yields `resumed 1`, a correct refresh, a clean BE<->FE readback and a printed TRANSMIT OK — and then the
# kernel log dies in the RAM ring at the power-cycle, because the documented readout (`run /bin/klug`) needs
# the console the burn just killed. That is exactly how the D lane spent five burns learning nothing
# ([[feedback_dlane_five_burns_what_went_wrong]]).
#
# So spill the log to /klug.txt on EVERY exit, success or failure. mdo_transmit_run has 20+ return paths;
# putting the spill in each one guarantees only that a future edit will miss one. The wrapper cannot.
# klug_spill_prepare() already pre-allocated the file at boot, so this is a pure overwrite of mapped blocks.
fn mdo_transmit(arm) {
    var r = mdo_transmit_run(arm);
    # ⚠ klug_spill() is SILENT (returns a byte count, prints nothing), so report the count — a 0 means
    # klug_spill_prepare() never got a usable inode and /klug.txt still holds a STALE boot, which is the
    # "looks fine, is wrong" failure this fix exists to prevent.
    # ⚠ This line lands in the ring AFTER the write, so it is NOT in the rescued file — it is for the
    # console when the panel survived. The file's own content is what proves the spill ran on a dark boot.
    var spilled = klug_spill();
    kprint("modeset: transmit -- klug spilled ", 34); kprint_num(spilled); kprintln(" bytes to /klug.txt", 19);
    return r;
}

# mdo_validate(rec) -> 0 or an MDO_E_* reason. PURE READS on the KERNEL-RESIDENT copy. Every dword an op does
# not define MUST be zero — a non-zero reserved field is REJECTED rather than ignored, which is what keeps
# today's unused dwords safe to define in a later kernel without an ABI break.
fn mdo_validate(rec) {
    var op = load32(rec) & 0xFFFFFFFF;
    if (op > 0x1F) { return MDO_E_BADOP; }
    if (((MDO_OP_SUPPORTED >> op) & 1) == 0) { return MDO_E_BADOP; }
    if ((load32(rec + 4) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }   # flags — none defined at H3
    # reserved tail, dwords 6..15 (+24..+63), must be zero for every op
    var k = 6;
    while (k < 16) {
        if ((load32(rec + k * 4) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        k = k + 1;
    }
    # op-specific fields. Sequential ifs on the fixed op selector (Cyrius has no chained else-if).
    if (op == MDO_OP_NOP) {
        # NOP uses nothing past the op code — +8..+23 must also be zero
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_DUMP) {
        # DUMP prints to klug, takes no operands — +8..+23 must be zero, same as NOP.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_LOCK) {
        # M4 writes V_TOTAL back to its own hardware value — it takes NO operands from the record, so
        # +8..+23 must be zero exactly like NOP/DUMP. The register and value come from the pipe, not the ABI.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_VTOTAL) {
        # M5's target (v_total 1501) and register are derived in-kernel from the calibrated mode, not passed
        # in — so it takes NO operands either; +8..+23 must be zero exactly like NOP/DUMP/LOCK.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_RECOMMIT) {
        # M6 reads + writes back the live timing group in-kernel — no operands; +8..+23 must be zero.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_NATIVE) {
        # 1.56.36 — NO OPERANDS, and deliberately so. The target geometry is read from the boot_info handoff
        # and cross-checked against the live raster in-kernel; letting ring 3 pass a width/height/pitch would
        # put an unvalidatable mode description into the ABI and hand a caller the ability to aim an
        # arbitrary pitch at the scanning pipe — the write that hung this box once already.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_PAN) {
        # 1.56.36 — NO OPERANDS. The pan geometry is the live console geometry; the buffer offset is a
        # build constant. A ring-3-supplied offset would let a caller aim the scanout at arbitrary VRAM.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_PIXCLK) {
        # 1.56.33 — same doctrine as every op above it: NO OPERANDS. The pixel clock comes from
        # gpu_pixclk_discover (measured off the live pipe), the CRTC from gpu_display_pipe, and the
        # clock-source check from gpu_pixclk_source_check — which currently refuses. ⛔ Deliberately NOT a
        # ring-3 parameter: letting a caller pass pll_id would put the guess back in the ABI, one
        # layer out from where MD-2 put it, and a caller could then aim a clock command at the PLL
        # driving the live pipe.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    if (op == MDO_OP_TRANSMIT) {
        # M8 derives everything in-kernel (live DIG, saved timing, ATOM params) — no operands. What runs is
        # governed by BUILD FLAGS, never by the ABI: a ring-3 caller can NEVER ask for the live PHY edge.
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    #ifdef MODESET_AUDIO_ARMS
    # M9's pair carries no operands either — the arm is the OP CODE, not a field. Deliberate: a ring-3
    # caller picks between two REVIEWED sequences by name and cannot compose a third out of parameters.
    var m9 = 0;
    if (op == MDO_OP_AUDIO_PRE)  { m9 = 1; }
    if (op == MDO_OP_AUDIO_POST) { m9 = 1; }
    if (m9 == 1) {
        if ((load32(rec +  8) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 12) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 16) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
        if ((load32(rec + 20) & 0xFFFFFFFF) != 0) { return MDO_E_RESERVED; }
    }
    #endif
    if (op == MDO_OP_CAPS) {
        var out_len = load64(rec + 16);
        if (out_len < 32) { return MDO_E_OUTBUF; }
        if (is_user_range(load64(rec + 8), 32) == 0) { return MDO_E_OUTBUF; }
    }
    return 0;
}

# mdo_pixclk — 1.56.33 bite 2. Derive every SetPixelClock parameter in-kernel, then REFUSE.
#
# ⛔⛔ THIS OP CANNOT REACH SILICON IN ANY BUILD TODAY, AND THAT IS THE DELIVERABLE. It exists to
# land the ABI, the parameter derivation and the refusal path BEFORE anything can run #12 — so that
# when a PLL-derivation rule arrives it drops into a seam that is already reviewed, already
# advertised through #89-style caps, and already refuses correctly.
#
# The pattern is the transmitter's, one command later: what runs is a BUILD property, ring 3 can
# never ask for the live edge, and the one parameter with no derivation produces a NAMED refusal
# instead of a plausible integer.
fn mdo_pixclk() {
    if (gpu_present == 0) { return MDO_E_NOGPU; }
    if (gpu_display_ok != 1) { return MDO_E_NOGPU; }

    gpu_pixclk_discover();
    var pc = gpu_pixclk_100hz;
    if (pc <= 0) {
        kprintln("modeset: PIXCLK -- no measured pixel clock; refusing", 52);
        return MDO_E_NOGPU;
    }
    kprint("modeset: PIXCLK measured pixclk_100hz ", 38); kprint_num(pc);
    kprint(" crtc ", 6); kprint_num(gpu_display_pipe); kprintln("", 0);

    var pll = gpu_pixclk_source_check();
    # ⭐ -2 and -1 are DIFFERENT REFUSALS and the tool must be able to tell them apart. -2 says the
    # pixel clock comes from the DTO, so #12 is the wrong command class and no PLL rule would help;
    # -1 says #12 IS right for this pipe and only the instance is missing. Collapsing them would
    # report "cannot name the PLL" for a pipe that has none — the failure mode MDO_E_NOHDMI was
    # split off 14 to avoid, where a correct diagnosis reads as the wrong kind of problem.
    if (pll == 0 - 2) {
        kprintln("modeset: PIXCLK REFUSED -- this pipe ALREADY runs on the DTO, so #12 would", 74);
        kprintln("modeset:   reprogram a live clock rather than establish one.", 60);
        return MDO_E_DTOCLK;
    }
    if (pll < 0) {
        kprintln("modeset: PIXCLK REFUSED -- ATOM #12 programs the DTO and ENABLES it, and this", 77);
        kprintln("modeset:   pipe's DTO is OFF, so running it MOVES the clock source on a live pipe.", 82);
        kprintln("modeset:   There is NO PLL instance to derive: pll_id 3-19 and 255 all produce", 78);
        kprintln("modeset:   byte-identical writes. Measured on iron 2026-07-30, not assumed.", 75);
        return MDO_E_NOPLL;
    }

    # ⛔ UNREACHABLE TODAY (gpu_pixclk_source_check always refuses). Kept so the seam is written, reviewed
    # and gated now rather than under time pressure once a derivation exists.
    #ifdef ATOM_RUN_PIXCLK
    return atom_run_set_pixel_clock(pc, pll, gpu_display_pipe, 3);
    #endif
    kprintln("modeset: PIXCLK -- derived, but this build cannot execute #12 (ATOM_RUN_PIXCLK unset)", 85);
    return MDO_E_NOATOM;
}

# mdo_crccal — 1.56.34 bite 1. CALIBRATE THE AFMT AUDIO CRC AGAINST ITS OWN NULL CASE, IN ONE BOOT.
#
# ⛔⛔ THE HOLE THIS CLOSES IS IN THE INSTRUMENT, NOT THE HARDWARE — and it is load-bearing for the whole
# arc. `gpu_hdmi_audio_crc_one` prints **"saw samples, but they are silence"** whenever CRC_DONE asserts
# with a zero CRC. That is a conclusion it has not earned: `DONE=1, CRC=0` is equally consistent with
#     (a) 2048 genuinely-zero samples traversed the tap        <- what the probe claims
#     (b) the counter simply completed and NOTHING traversed   <- never ruled out
# and (b) INVERTS the arc's reading — under it, "the read side never drains" and every register hypothesis
# built on "samples arrive but produce no sound" was aimed at the wrong half of the pipe.
#
# ⭐ The calibration control run on amdgpu proved both taps CONTENT-sensitive (silence -> 0, tone -> non-zero)
# — but **both of those stimuli FLOWED.** A stimulus set containing only flowing cases cannot distinguish
# flow from no-flow. **The null case IS the calibration**, and it has never been taken.
#
# ⚠ WHY THIS IS AN OP AND NOT A BOOT SELFTEST: it stops and starts the codec feed, so it must be repeatable
# from the shell without a reflash, and its result must be readable next to the state it measured.
# ⚠ WHY IT NEEDS NO EAR: it is entirely source-side and self-controlled, so it is immune to the sink-latched
# state that makes cross-boot ear comparisons un-adjudicable. That is exactly why it goes FIRST.
#
# Sequence, all in one boot, with the feed restored to however it was found:
#   N1  feed STOPPED  -> CRC both taps      the null
#   F   feed RUNNING  -> CRC both taps      the flow case
#   N2  feed STOPPED  -> CRC both taps      repeat the null, so a one-off is not mistaken for a rule
fn mdo_crccal() {
    if (gpu_present == 0) { return MDO_E_NOGPU; }
    if (gpu_display_ok != 1) { return MDO_E_NOGPU; }
    # ⛔⛔ THIS REFUSAL MUST NAME THE BUILD OR THE SILICON, NEVER BOTH AT ONCE — and it cost a burn to
    # learn. The 2026-07-31 CRCCAL burn returned "the HDMI audio path did not come up", which reads as a
    # statement about THIS MACHINE. It was not: the kernel was built BARE, `gpu_hdmi_audio_enable()` is
    # only ever CALLED inside `#ifdef HDMI_ATOM` (main.cyr), so the audio path was compiled out and
    # `gpu_hdmi_audio_on` could never be anything but 0. A message that cannot tell "your build lacks the
    # feature" from "your hardware refused" is the same defect class as an exit code that cannot tell a
    # refusal from a pass — which is what this whole cut exists to remove.
    if (gpu_hdmi_audio_on == 0) {
        # ⛔⛔ THE THIRD WAY THIS FLAG CAN BE 0, AND IT IS THE ONE THIS BUILD MAKES REACHABLE.
        # Under MODESET_AUDIO the boot-time audio enable is SUPPRESSED BY DESIGN (main.cyr) — the whole M9
        # experiment is that staging and the unmute sit on opposite sides of a real transmitter edge, so
        # arming audio at boot would pre-empt the thing being measured. `gpu_hdmi_audio_on` is therefore 0
        # until an audio ARM has run, and a `--crccal` typed FIRST would fall through to the branch below
        # and report "the audio path did NOT come up -- that IS a real finding about the machine."
        # ⇒ **A FALSE HARDWARE CLAIM, produced by the exact sentence added to stop false hardware claims.**
        # Same defect as burns 1 and 2, one layer further in: a refusal that names a cause it has not
        # distinguished. Order the phases so the arm runs first, and say so here rather than in a doc.
        #ifdef MODESET_AUDIO
        kprintln("modeset: CRCCAL -- this kernel is built with MODESET_AUDIO, so the boot-time audio", 82);
        kprintln("modeset:   enable is SUPPRESSED BY DESIGN and nothing has staged the path yet.", 78);
        kprintln("modeset:   Run an audio ARM first (--audio-pre or --audio-post), THEN --crccal in the", 85);
        kprintln("modeset:   same boot. This says NOTHING about the hardware.", 59);
        return MDO_E_NOGPU;
        #endif
        #ifdef HDMI_ATOM
        # ⛔ HDMI_ATOM ALONE IS NOT THE PRECONDITION, and saying it was cost burn 2. The DCN-side enable
        # needs an HDMI HDA controller to bind to, and THAT is gated by a different flag — HDA_HDMI,
        # which controls the instance-1 probe in main.cyr. So report the CONTROLLER state before blaming
        # the machine: an absent instance 1 is a BUILD fact; present-but-unbound is a hardware fact.
        var ci1 = hda_hdmi_feed_running();
        if (ci1 < 0) {
            kprintln("modeset: CRCCAL -- HDMI_ATOM is set, but there is NO instance-1 HDA controller,", 79);
            kprintln("modeset:   so the DCN side had nothing to bind to. Almost certainly HDA_HDMI is", 79);
            kprintln("modeset:   unset -- check the 'hda: ctl1' lines at boot. NOT a hardware fact.", 77);
            return MDO_E_NOGPU;
        }
        kprintln("modeset: CRCCAL -- HDMI_ATOM set AND instance 1 exists, but the audio path did NOT", 82);
        kprintln("modeset:   come up. That IS a real finding about the machine -- read the gpu: lines", 83);
        kprintln("modeset:   above for where the bring-up stopped.", 48);
        #else
        kprintln("modeset: CRCCAL -- this kernel was built WITHOUT HDMI_ATOM, so the HDMI audio", 77);
        kprintln("modeset:   path is COMPILED OUT and could never have come up. This says NOTHING", 79);
        kprintln("modeset:   about the hardware. Rebuild: BURN_CRCCAL=1 sh scripts/burn/burn-prep.sh", 82);
        #endif
        return MDO_E_NOGPU;
    }
    var d = gpu_audio_dig * GPU_DCN_DIG_STRIDE;

    # ⭐ READ THE STATE BEFORE TOUCHING IT. If the feed is already stopped, the "null" phase is not a change
    # this op made, and saying so is the difference between a controlled experiment and a coincidence.
    var was_on = hda_hdmi_feed_running();
    kprint("modeset: CRCCAL -- codec feed at entry, SD_CTL RUN = ", 53); kprint_num(was_on);
    kprintln("  (1 run, 0 stopped, -1 absent)", 31);

    kprintln("modeset: CRCCAL -- N1: the NULL case, codec feed STOPPED --------------------", 77);
    hda_hdmi_feed_stop();
    gpu_udelay(20000);
    var n1a = gpu_hdmi_audio_crc_one(d, 0);
    var n1b = gpu_hdmi_audio_crc_one(d, 1);

    kprintln("modeset: CRCCAL -- F: the FLOW case, codec feed RUNNING ---------------------", 77);
    hda_hdmi_feed_start();
    gpu_udelay(60000);
    var fa = gpu_hdmi_audio_crc_one(d, 0);
    var fb = gpu_hdmi_audio_crc_one(d, 1);

    kprintln("modeset: CRCCAL -- N2: the NULL case again, feed STOPPED --------------------", 77);
    hda_hdmi_feed_stop();
    gpu_udelay(20000);
    var n2a = gpu_hdmi_audio_crc_one(d, 0);
    var n2b = gpu_hdmi_audio_crc_one(d, 1);

    # Leave the feed as it was found. An experiment that changes the machine it measured is a burn nobody
    # can repeat.
    if (was_on == 1) { hda_hdmi_feed_start(); }
    if (was_on != 1) { hda_hdmi_feed_stop(); }

    # ── THE VERDICT, and every branch is named so no outcome has to be interpreted after the fact ──
    kprintln("modeset: CRCCAL -- VERDICT ------------------------------------------------", 75);
    var null_done = 0;
    if (n1a == 1 || n1b == 1) { null_done = 1; }
    if (n2a == 1 || n2b == 1) { null_done = 1; }
    var flow_done = 0;
    if (fa == 1 || fb == 1) { flow_done = 1; }

    if (null_done == 0) {
        if (flow_done == 1) {
            kprintln("modeset:   CRC_DONE is FLOW-GATED -- it completed with the feed running and", 75);
            kprintln("modeset:   NOT with it stopped. A completion IS evidence samples traversed.", 75);
            kprintln("modeset:   ** THE INSTRUMENT IS CALIBRATED ** and prior readings stand.", 71);
            return 0;
        }
        kprintln("modeset:   the CRC completed in NEITHER phase -- this probe is inert on this", 76);
        kprintln("modeset:   path and NO reading taken from it means anything. Do not spend a", 75);
        kprintln("modeset:   burn on a CRC result until this is understood.", 57);
        return 0;
    }
    if (flow_done == 1) {
        kprintln("modeset:   ** CRC_DONE IS NOT FLOW-GATED ** -- it completes with the feed", 73);
        kprintln("modeset:   STOPPED. A completion therefore proves NOTHING about traversal, and", 78);
        kprintln("modeset:   every 'saw samples' this arc has printed is VOID as evidence. Only a", 79);
        kprintln("modeset:   CRC VALUE that DIFFERS between the two phases carries information.", 77);
        return 0;
    }
    kprintln("modeset:   the CRC completed ONLY with the feed stopped, which is incoherent --", 79);
    kprintln("modeset:   suspect the probe or the feed control before any hardware reading.", 77);
    return 0;
}

fn mdo_execute(rec) {
    var op = load32(rec) & 0xFFFFFFFF;
    if (op == MDO_OP_NOP)  { return 0; }
    if (op == MDO_OP_CAPS) { return mdo_caps_write(load64(rec + 8)); }
    if (op == MDO_OP_DUMP) { return mdo_dump(); }
    if (op == MDO_OP_LOCK) { return mdo_lock(); }
    if (op == MDO_OP_VTOTAL) { return mdo_vtotal(); }
    if (op == MDO_OP_RECOMMIT) { return mdo_recommit(); }
    if (op == MDO_OP_TRANSMIT) { return mdo_transmit(0); }
    if (op == MDO_OP_PIXCLK) { return mdo_pixclk(); }
    if (op == MDO_OP_CRCCAL) { return mdo_crccal(); }
    if (op == MDO_OP_NATIVE) { return mdo_native(); }
    if (op == MDO_OP_PAN) { return mdo_pan(); }
    #ifdef MODESET_AUDIO_ARMS
    if (op == MDO_OP_AUDIO_PRE)  { return mdo_transmit(1); }
    if (op == MDO_OP_AUDIO_POST) { return mdo_transmit(2); }
    #endif
    return MDO_E_BADOP;                              # unreachable after validate — belt-and-suspenders
}

# gpu_modeset_op(desc_uva, len) — the ring-3 entry point. Validates EVERY record before executing ANY, so a
# rejected batch does nothing. Copy-in is fault-proof (page-walks the caller's CR3). Reuses #92's per-CPU
# scratch buffer — the two are never concurrent (both are GPU-band ops on the boot/compositor path).
fn gpu_modeset_op_sys(desc_uva, len) {
    if (len < MDO_OP_STRIDE)       { return 0 - MDO_E_DESC; }
    if (len > MDO_OP_MAX_LEN)      { return 0 - MDO_E_DESC; }
    if (len % MDO_OP_STRIDE != 0)  { return 0 - MDO_E_DESC; }
    if (is_user_range(desc_uva, len) == 0) { return 0 - MDO_E_DESC; }
    var buf = sc_gpuop_buf();
    if (proc_copy_from_user(proc_get_cr3(proc_current_get()), buf, desc_uva, len) == 0) {
        return 0 - MDO_E_DESC;
    }
    var n = len / MDO_OP_STRIDE;
    var i = 0;
    while (i < n) {
        var e = mdo_validate(buf + i * MDO_OP_STRIDE);
        if (e != 0) { return 0 - ((i << 8) | e); }
        i = i + 1;
    }
    var j = 0;
    while (j < n) {
        var e2 = mdo_execute(buf + j * MDO_OP_STRIDE);
        if (e2 != 0) { return 0 - ((j << 8) | e2); }
        j = j + 1;
    }
    return 0;
}

# shm_write(id, user_src, size) -> 0 / -1. Copies user src INTO the shm page.
fn shm_write(id, src, size) {
    if (shm_slot_valid(id) == 0) { return 0 - 1; }
    var slot = id - 1;
    if (size <= 0) { return 0 - 1; }
    if (size > load64(&shm_size + slot * 8)) { return 0 - 1; }
    if (is_user_range(src, size) == 0) { return 0 - 1; }
    shm_copy(load64(&shm_kva + slot * 8), src, size);
    return 0;
}

# shm_read(id, user_dst, size) -> 0 / -1. Copies the shm page OUT into user dst.
fn shm_read(id, dst, size) {
    if (shm_slot_valid(id) == 0) { return 0 - 1; }
    var slot = id - 1;
    if (size <= 0) { return 0 - 1; }
    if (size > load64(&shm_size + slot * 8)) { return 0 - 1; }
    if (is_user_range(dst, size) == 0) { return 0 - 1; }
    shm_copy(dst, load64(&shm_kva + slot * 8), size);
    return 0;
}

# shm_free(id) -> 0 / -1. Release the 2 MB page + the slot.
fn shm_free(id) {
    if (shm_slot_valid(id) == 0) { return 0 - 1; }
    var slot = id - 1;
    # ⚠ Release to the RIGHT allocator. A #86 (GPU-visible) slot is a FIXED window in the GPU carveout, never
    # a pmm page — handing its address to pmm_free_2mb would corrupt the page allocator's bitmap with an
    # address it never owned. Carveout slots are reclaimed by simply clearing the table entry; the window is
    # statically owned by GPU_SHM_REGION_OFF + slot*GPU_SHM_SLOT_SIZE and is reused on the next create.
    if (load64(&shm_mc + slot * 8) == 0) { pmm_free_2mb(load64(&shm_phys + slot * 8)); }
    store64(&shm_phys + slot * 8, 0);
    store64(&shm_kva + slot * 8, 0);
    store64(&shm_size + slot * 8, 0);
    store64(&shm_mc + slot * 8, 0);
    store64(&shm_owner + slot * 8, 0);          # 1.56.40 bite 1 — a recycled slot must not inherit an owner
    store64(&shm_epoch + slot * 8, 0);
    return 0;
}

# =============================================================================
# 1.53.10 — raw block-device syscalls (#75-80): the native-install primitive.
#
# Exposes the kernel block layer (blk_read_on) to a privileged ring-3 installer so
# agnova + sovereign mkfs/partition tools can detect disks and read raw sectors
# WITHOUT shelling out to Linux parted/mkfs. This is the READ-PATH (Phase 1) —
# enum / open(RO) / read / info / close, all NON-DESTRUCTIVE. blk_write#78 is
# Phase 2 (capability-gated). Design + security posture:
#   docs/development/issue/2026-07-09-ring3-block-device-syscalls-for-install.md
#
# Handle model (Phase 1): the handle IS the backend tag (BLK_VIRTIO..BLK_RAMDISK,
# 1..5), validated against blk_registered — no per-open state. Capacity is exact
# for the ACTIVE backend; secondary-backend capacity (0 here) is a follow-up.
# =============================================================================
var blk_sc_bounce[512];   # 4096 B — one-LBA bounce (backends DMA into kernel mem, not user VA)

# Phase 2 write-path GATE. Raw block WRITE (blk_open RW + blk_write#78) is OFF by
# default; it is enabled only after a deliberate arm — blk_open(_, BLK_RW_ARM_MAGIC).
# agnos has no per-proc capability/uid yet (proc.cyr: "NOT Unix uid", auth-posture),
# so this default-off + explicit-magic-arm is the boundary: a raw disk write can
# never happen accidentally/incidentally, and the arm call is the exact seam where an
# aegis/shakti installer-capability check lands when agnos grows per-proc caps.
var blk_rw_armed     = 0;
var BLK_RW_ARM_MAGIC = 0x424C4B5F5257;   # "BLK_RW" — deliberate-arm token (not a plausible mode value)

# blk_enum(buf, cap) -> registered-device count / -1. Writes {tag, capacity_lbas,
# lba_bytes} (3xu64 = 24 B) per registered backend into the user buf, bounded by cap.
fn blk_enum_sys(buf, cap) {
    if (is_user_range(buf, cap) == 0) { return 0 - 1; }
    var count = 0;
    var tag = 1;
    while (tag <= 5) {
        if (blk_is_registered(tag) == 1) {
            var off = count * 24;
            if (off + 24 > cap) { return count; }
            var capv = 0;
            if (tag == blk_active) { capv = blk_capacity; }
            store64(buf + off + 0, tag);
            store64(buf + off + 8, capv);
            store64(buf + off + 16, blk_lba_bytes);
            count = count + 1;
        }
        tag = tag + 1;
    }
    return count;
}

# blk_open(tag, mode) -> handle(==tag) / -1 / arm-ack(0). mode 0 = RO (always), mode 1
# = RW (only when armed). mode == BLK_RW_ARM_MAGIC = the deliberate arm (sets the
# write gate, returns 0) — the aegis/shakti capability seam. Validates tag registered.
fn blk_open_sys(tag, mode) {
    if (mode == BLK_RW_ARM_MAGIC) { blk_rw_armed = 1; return 0; }   # deliberate RW arm
    if (tag < 1) { return 0 - 1; }
    if (tag > 5) { return 0 - 1; }
    if (blk_is_registered(tag) == 0) { return 0 - 1; }
    if (mode == 0) { return tag; }                                  # RO handle
    if (mode == 1) {                                                # RW handle — gated
        if (blk_rw_armed == 0) { return 0 - 1; }                    # EPERM: not armed
        return tag;
    }
    return 0 - 1;                                                   # unknown mode
}

# blk_read(h, lba, buf, nsec) -> nsec / -1. Reads nsec LBAs from device h at lba
# into the user buf, one LBA at a time via the kernel bounce (backends DMA into
# kernel memory, never a user VA). fs_spin_lock serializes the shared bounce +
# device access against FS reads (same lock ext2 takes around blk_read_on).
fn blk_read_sys(h, lba, buf, nsec) {
    if (h < 1) { return 0 - 1; }
    if (h > 5) { return 0 - 1; }
    if (blk_is_registered(h) == 0) { return 0 - 1; }
    if (nsec <= 0) { return 0 - 1; }
    if (lba < 0) { return 0 - 1; }
    if (h == blk_active) {
        if (lba + nsec > blk_capacity) { return 0 - 1; }
    }
    var total = nsec * blk_lba_bytes;
    if (is_user_range(buf, total) == 0) { return 0 - 1; }
    fs_spin_lock();
    var rc = nsec;
    var i = 0;
    while (i < nsec) {
        if (blk_read_on(h, lba + i, &blk_sc_bounce) != 0) { rc = 0 - 1; i = nsec; }
        else {
            shm_copy(buf + i * blk_lba_bytes, &blk_sc_bounce, blk_lba_bytes);
            i = i + 1;
        }
    }
    fs_spin_unlock();
    return rc;
}

# blk_write(h, lba, buf, nsec) -> nsec / -1. Phase 2: the DESTRUCTIVE write-path,
# GATED on blk_rw_armed (off by default; armed via blk_open(_, BLK_RW_ARM_MAGIC)).
# Copies user buf -> kernel bounce -> blk_write_on, one LBA at a time, then flushes
# the device cache (durability). fs_spin_lock serializes with FS + the shared bounce.
fn blk_write_sys(h, lba, buf, nsec) {
    if (blk_rw_armed == 0) { return 0 - 1; }          # THE GATE — raw write off unless armed
    if (h < 1) { return 0 - 1; }
    if (h > 5) { return 0 - 1; }
    if (blk_is_registered(h) == 0) { return 0 - 1; }
    if (nsec <= 0) { return 0 - 1; }
    if (lba < 0) { return 0 - 1; }
    if (h == blk_active) {
        if (lba + nsec > blk_capacity) { return 0 - 1; }
    }
    var total = nsec * blk_lba_bytes;
    if (is_user_range(buf, total) == 0) { return 0 - 1; }
    fs_spin_lock();
    var rc = nsec;
    var i = 0;
    while (i < nsec) {
        shm_copy(&blk_sc_bounce, buf + i * blk_lba_bytes, blk_lba_bytes);   # user -> bounce
        if (blk_write_on(h, lba + i, &blk_sc_bounce) != 0) { rc = 0 - 1; i = nsec; }
        else { i = i + 1; }
    }
    blk_flush_on(h);                                  # durability barrier (best-effort)
    fs_spin_unlock();
    return rc;
}

# blk_info(h, out) -> 0 / -1. Writes {capacity_lbas, lba_bytes} (2xu64) to out.
fn blk_info_sys(h, out) {
    if (h < 1) { return 0 - 1; }
    if (h > 5) { return 0 - 1; }
    if (blk_is_registered(h) == 0) { return 0 - 1; }
    if (is_user_range(out, 16) == 0) { return 0 - 1; }
    var capv = 0;
    if (h == blk_active) { capv = blk_capacity; }
    store64(out + 0, capv);
    store64(out + 8, blk_lba_bytes);
    return 0;
}

# blk_close(h) -> 0 / -1. Phase 1 RO: no per-open state; validate + no-op.
fn blk_close_sys(h) {
    if (h < 1) { return 0 - 1; }
    if (h > 5) { return 0 - 1; }
    if (blk_is_registered(h) == 0) { return 0 - 1; }
    return 0;
}


# `ptrscan #98` reachability latches — see the arm for why.
var ptrscan_called = 0;
var ptrscan_gave = 0;

fn ksyscall(num, arg1, arg2, arg3) {
    # Stack-canary backstop: snapshot at entry, re-checked before returning on the
    # syscalls that do the most pointer/buffer work (the 1.41.3 FS group + pipe/
    # mmap/munmap). Coverage is deliberately NOT uniform across every branch
    # (audit 1.41.6 #14/#23): ksyscall itself has no local array buffer for a
    # smash to corrupt, so these checks are a backstop against a *callee* (ext2_*/
    # elf_*) overrunning back into this frame — the leaf functions that own real
    # buffers (e.g. elf_load) carry their own canary. A single-tail collapse was
    # rejected: it would require rewriting ~25 early-returns in this security-
    # critical dispatcher with no clean Cyrius idiom, for a non-vuln cosmetic gain.
    var canary = stack_canary_secret;
    if (num == 0) {
        # exit — halt current process, return to kernel if context saved
        sys_exit_code = arg1;
        proc_set_exit_code(proc_current_get(), arg1);
        # flock#59: release every advisory lock held by the exiting proc (so a
        # fork-per-accept worker that dies mid-turn can't strand the shared world).
        flock_release_pid(proc_current_get());
        snd_release_pid(proc_current_get());      # release any snd#64 audio slot (Gate 2)
        shm_release_pid(proc_current_get());      # 1.56.40 bite 1: release shm#71/#86 slots (mirror fault-kill)
        chan_release_pid(proc_current_get());     # 1.56.40 bite 4: release #97 channel endpoints (mirror fault-kill)
        gpu_release_pid(proc_current_get());      # 1.55.x: if it owned the scanout, hand the screen back
        # to the console (else a full-screen app quitting would
        # leave its last frame up while console text scrolled
        # invisibly into a buffer nothing is scanning)
        if (proc_current_get() < proc_count) {
            proc_set_state(proc_current_get(), 0);
            # 1.53.x B3b: clear this CPU's FP owner if it named the exiting proc (same
            # recycled-slot prev==cur hazard as fault_kill). No fxsave (exiting XMM garbage).
            var _xc = pcpu_cpu();
            if (load64(&fpu_owner + _xc * 8) == proc_current_get()) { store64(&fpu_owner + _xc * 8, 0 - 1); }
            # Send SIGCHLD (signal 17) to parent process
            var ppid = proc_get_ppid(proc_current_get());
            if (ppid >= 0) {
                proc_send_signal(ppid, 17);
            }
        }
        # If we have a saved kernel return point, jump back to it — but ONLY when the EXITING
        # proc is the one exec_and_wait is run-to-completion waiting on (exec_resume_pid). 1.44.14:
        # a PREEMPTIVELY-scheduled #43 background job exit()s with proc_current_get() = ITS pid (the
        # scheduler set it), which != exec_resume_pid (agnsh) — so it must NOT fire agnsh's
        # kernel_resume (that would resume kybernet as if agnsh exited). It already went state 0
        # above, so its parent's waitpid#4 reaps it. Pre-1.44.14 this gate was just
        # `kernel_return_rsp != 0`, which fired for ANY exit while a resume was armed.
        if (kernel_return_rsp_get() != 0) {
            if (proc_current_get() == exec_resume_pid_get()) {
                kernel_resume();
            }
        }
        # ⛔⛔ EXIT MUST NOT RETURN TO RING 3. This used to `return 0` whenever the kernel_resume gate above
        # did not fire, and that return goes back to a process already marked state 0 — with nothing left to
        # execute. The caller is `_entry`'s `syscall(SYS_EXIT, r)`, which is the LAST instruction a Cyrius
        # program emits, so control falls straight into the zero padding after `.text`, where `00 00` decodes
        # as `add %al,(%rax)` with rax = 0: a write to address 0, #PF, and fault_kill_current.
        #
        # ⭐ AND THE DAMAGE IS NOT COSMETIC — IT DESTROYS THE EXIT CODE. proc_set_exit_code stored the real
        # value at the top of this handler; the spurious #PF then runs fault_kill_current, which overwrites
        # it with 128 + 14 = **142**. Every tool taking this path reported 142 no matter what it returned.
        # MEASURED ON IRON 2026-08-03: `modeset --native` and `--pan` both completed their work, printed
        # every line, returned 95 — and were recorded as `run: exit 142`, faulting at the two padding bytes
        # immediately after their own `syscall` instruction (rip 0x407e96, `.text` end 0x407e98).
        #
        # The fix is the tail fault_kill_current already uses for exactly this case (a proc dying with no
        # armed kernel_resume): enable interrupts and halt, and let the next timer tick's do_context_switch
        # decline to revive this state-0 slot and switch away through the timer ISR's own pop+iretq epilogue.
        # We never return through the abandoned syscall frame. preempt_count is 0 here — this handler holds
        # no lock by this point — so do_context_switch is not preempt-gated and WILL switch.
        while (1) { asm { sti; hlt; } }
        return 0;                         # unreachable — kept for the type checker
    }
    if (num == 1) {
        # write(fd=arg1, buf=arg2, len=arg3)
        if (arg3 > 0) {
            if (is_user_range(arg2, arg3) == 0) { return 0 - 1; }
        }
        # ⭐ ipc BITE 9 — an ordinary write(2) reaches a CHANNEL fd. A child spawned holding an
        # endowed end writes its stdout with plain `write`, exactly as it would to a pipe or a pty
        # slave. Without this every program would have to be rewritten against `#97`, which makes the
        # band an API rather than a PTY (planning/ipc.md §1).
        var wep = chan_fd_endpoint(arg1);
        if (wep >= 0) {
            # ⭐ write(2) IS A BYTE STREAM; `CH_SEND` IS A RECORD. THE DIFFERENCE IS DELIBERATE.
            # A caller of `#97` asking to send more than one record is making a framing error and gets
            # -CH_E_ARG. A caller of write(2) is doing something completely ordinary, and POSIX already
            # defines the answer: accept what fits and return the SHORT COUNT. The caller loops.
            # ⛔ WITHOUT THIS A PTY IS UNUSABLE. agnsh's banner is longer than 64 bytes in one write;
            # erroring would make a shell fail to print its own greeting, and "the terminal is broken"
            # would be indistinguishable from "the shell crashed".
            # ⚠ This does NOT smuggle stream semantics into the band: record boundaries still hold on
            # every `#97` path, and a reader still receives whole records. It only means a stream
            # writer's bytes arrive as several records — which is exactly what a tty does.
            var wlen = arg3;
            if (wlen > CHAN_REC_BYTES) { wlen = CHAN_REC_BYTES; }
            var wr = chan_queue(wep, arg2, wlen);
            if (wr < 0) { return 0 - 1; }        # peer gone / bad buffer — EPIPE-shaped
            return wr;
        }
        return vfs_write(arg1, arg2, arg3);
    }
    if (num == 2) { return proc_current_get(); }   # getpid() -> pid
    if (num == 3) {
        # spawn(elf_addr, elf_size) — load an in-memory ELF + create a user process.
        # Returns new pid or -1. 1.41.5: the ELF image is a USER buffer — validate
        # the whole (addr,size) range so elf_load's load8/load64 can't be aimed at
        # kernel memory (a ring-3 caller passing a kernel addr would disclose it).
        if (arg2 < 1) { return 0 - 1; }
        if (is_user_range(arg1, arg2) == 0) { return 0 - 1; }
        # 1.44.10: bound by the staging buffer, then run elf_load under the KERNEL CR3.
        # A ring-3 parent's CR3 mirrors only 0-256 MB + the GB ranges, so the child's
        # fresh page-table pages can land in the 256 MB-1 GB gap (the 1.44.9 #UD-at-child
        # blocker). Copy the user ELF to spawn_elf_buf NOW (caller CR3 resolves arg1, SMAP
        # AC=1 from the entry STAC), switch to boot CR3 0x1000 (maps all phys, so every PT
        # page elf_load writes is reachable — the proven 1.44.8 condition), elf_load the
        # kernel copy, then restore the caller CR3. Mirrors the execwait#37 idiom; no
        # kstack swap / resume-ctx since spawn does not block. From a KERNEL caller (the
        # RING3_SELFTEST loads its B proc via elf_load directly, not this path) this code
        # is not reached.
        if (arg2 > 16384) { return 0 - 1; }
        var sp_caller_cr3 = proc_get_cr3(proc_current_get());
        var sp_dst = spawn_elf_buf_base();
        var sp_i = 0;
        while (sp_i < arg2) { store8(sp_dst + sp_i, load8(arg1 + sp_i)); sp_i = sp_i + 1; }
        cr3_load(0x1000);
        var new_pid = elf_load(sp_dst, arg2);
        cr3_load(sp_caller_cr3);
        if (new_pid >= 0) {
            # Mark as ready; will be scheduled on next timer tick
            proc_set_state(new_pid, 1);
        }
        return new_pid;
    }
    if (num == 4) {
        # waitpid(pid) — NON-BLOCKING poll (1.44.9). Returns the child's exit code if it
        # has exited (state 0), or -2 (WOULD_BLOCK) if it is still alive. A ring-3 parent
        # polls this FROM RING 3 — between calls it holds no kernel state, so the child's
        # syscalls can't clobber a blocked-in-kernel waitpid frame on the shared syscall
        # kstack. (The classic BLOCKING form, which sleeps the parent in the kernel, needs
        # per-proc kernel stacks first — deferred.) Was a busy-wait `while(state!=0) hlt`,
        # which would hang anyway: the handler runs IF=0, so the hlt never wakes.
        if (arg1 < 0) { return 0 - 1; }
        if (arg1 >= proc_count) { return 0 - 1; }
        # Never wait on (and never reap) the caller itself.
        if (arg1 == proc_current_get()) { return 0 - 1; }
        # 1.50.8: ownership — only the parent (or init) may reap, else -1 (not your child).
        # Stops a non-parent from stealing the exit code + collapsing the slot out from under
        # the real parent's pending waitpid. BEFORE the alive/dead check so a non-child gets
        # -1 regardless of state. Unblocked by 1.50.7's real proc_get_ppid (inert while it
        # stubbed 0 → the 1.44.22 audit deferral). agnsh IS the parent of its `&` jobs (set at
        # proc_create_user), so this preserves bg-job reaping; ring3-smoke parent-spawn+wait
        # + agnsh-bg/multijob exercise it. (proc_may_reap: proc.cyr.)
        if (proc_may_reap(proc_current_get(), arg1) == 0) { return 0 - 1; }
        if (proc_get_state(arg1) != 0) { return 0 - 2; }   # still alive → WOULD_BLOCK
        # 1.42.x: reap the in-memory-spawned child here — the symmetric point to
        # the from-disk path's "read exit code in sh_cmd_run, then proc_reap".
        # Read the exit code FIRST (proc_reap_child may collapse the slot), then
        # reclaim the child's address space (ELF + stack + ANY un-munmap'd mmap
        # huge pages) and proc_table slot. Without this, every spawn()ed child
        # leaked its whole address space for the boot; with it the in-memory
        # path is leak-symmetric with elf_load_from_file's run/reap. Safe: the
        # child is confirmed dead (loop above) and is not proc_current_get() (guarded),
        # so its distinct CR3 is not the one the CPU is walking.
        var wcode = proc_get_exit_code(arg1);
        proc_reap_child(arg1);
        return wcode;
    }
    if (num == 5) {
        # read(fd=arg1, buf=arg2, len=arg3)
        # 1.42.14: reject negative len explicitly (defense-in-depth — the fd-type
        # read helpers now also enforce their own minimum count, so a too-small
        # buffer can no longer drive a fixed-size store past the validated range).
        if (arg3 < 0) { return 0 - 1; }
        if (arg3 > 0) {
            if (is_user_range(arg2, arg3) == 0) { return 0 - 1; }
        }
        # 1.41.1: fd 0 = line-disciplined keyboard stdin. Other fds keep the vfs_read path.
        # 1.44.x: a4=r10 (ksyscall_a4) != 0 selects the NON-BLOCKING cooked-line read — returns
        # -2/WOULD_BLOCK until a full line, so schedulable agnsh can poll stdin without freezing
        # background jobs at the prompt. a4==0 keeps the efficient blocking read (the default,
        # used when agnsh has no live bg jobs). The syscall entry stub resets ksyscall_a4 per
        # ring-3 entry (syscall_hw.cyr), so a stale a4 can't mis-route a later blocking read.
        if (arg1 == 0) {
            # fd 0 is the keyboard ONLY while it is still the console device. A pipe
            # redirect (exec_redirect#62) copies the pipe read-end's vfs_table entry
            # over vfs_table[0] (tag VFS_PIPE), so a REDIRECTED stdin must fall through
            # to vfs_read -> pipe_read — the `cmd2` side of `cmd1 | cmd2`. The a4
            # non-blocking cooked-line read is keyboard-only; a piped fd 0 ignores it.
            if (ktag(vfs_fd_table()) == VFS_DEVICE) {
                if (ksyscall_a4_get() != 0) { return kbd_read_nonblock(arg2, arg3); }
                return kbd_read_blocking(arg2, arg3);
            }
        }
        # ⭐ ipc BITE 9 — an ordinary read(2) reaches a CHANNEL fd.
        # ⛔ WOULD_BLOCK IS RETURNED, NOT WAITED ON, AND THAT IS THE DESIGN — NOT A SHORTCUT.
        # planning/ipc.md §9.4: "No blocking in v1, and the reason is the STACK, not a policy" — each
        # CPU has ONE shared SYSCALL kernel stack, so N blocked waiters would need N disjoint kernel
        # stacks. Both escape hatches are refused there: the `preempt_disable; sti; hlt` spin is the
        # poison that made TCP toxic, and it is *especially* wrong here — a channel's producer is a
        # PEER PROCESS, so disabling preemption starves the very thing the read is waiting for.
        # (That is exactly why `kbd_read_blocking` may spin and this may not: the keyboard's producer
        # is an IRQ, not a schedulable peer.)
        # Retry belongs in userland, preemptibly. -2 is the kernel's established WOULD_BLOCK value,
        # the same one the a4 non-blocking cooked-line read returns.
        var rep = chan_fd_endpoint(arg1);
        if (rep >= 0) {
            var cr = chan_deliver(rep, arg2, arg3);
            if (cr >= 0) { return cr; }
            if (cr == 0 - CH_E_WOULDBLOCK) { return 0 - 2; }
            # PEER GONE == EOF. A pty whose child exited reads 0, and so does this — it is what makes
            # `while (read(fd) > 0)` terminate instead of spinning on an error it cannot interpret.
            if (cr == 0 - CH_E_PEERGONE) { return 0; }
            return 0 - 1;
        }
        return vfs_read(arg1, arg2, arg3);
    }
    if (num == 6) { return vfs_close(arg1); }   # close(fd) -> 0 / -1
    if (num == 7) {
        # open(name=arg1, namelen=arg2, flags=arg3) — mount-routed (1.41.3).
        # Re-routes from initrd-only: ext2 / FAT / exFAT by mount, with initrd
        # as the bare-name fallback. AO_DIRECTORY(0x800)→dir-fd (getdents);
        # AO_CREAT(0x100) creates if absent; AO_TRUNC(0x200) zeroes existing.
        if (sc_path_ok(arg1, arg2) == 0) { return 0 - 1; }
        # Normalize a RELATIVE name (no leading '/') to rooted-at-'/' — agnos has no
        # CWD, so `touch foo` / `cmd > foo` land in the writable root FS instead of
        # failing against the read-only initrd. Prepend '/' into a kernel scratch buffer
        # + route THAT (the ext2 lookup needs the leading '/'). Absolute paths pass
        # through untouched. (1.54.11: the redirect/touch-can't-create fix.)
        var op_path = arg1;
        var op_len  = arg2;
        if (load8(arg1) != 47) {
            store8(&sc_open_abs, 47);
            var opi = 0;
            while (opi < arg2 && opi < 254) { store8(&sc_open_abs + 1 + opi, load8(arg1 + opi)); opi = opi + 1; }
            op_path = &sc_open_abs;
            op_len  = opi + 1;
        }
        var be7 = vfs_resolve_mount(op_path, op_len);
        if (be7 == FS_EXT2) {
            # SMP sub-bite 5 (fs_lock): the ext2 open/create arm — lookup + (optional)
            # create + truncate + open all touch ext2 scratch. Locked at the syscall
            # arm (the dispatch boundary) because ext2_* are called DIRECTLY here (no
            # locked wrapper). The called ext2_* are leaves w.r.t. the VFS boundary,
            # and none of them is independently fs_lock'd → single acquire, no nest.
            # INNER-WRAPPER form (one return point) so the lock can't leak.
            fs_spin_lock();
            var ofd7 = sys_open_ext2_inner(op_path, op_len, arg3);
            fs_spin_unlock();
            return ofd7;
        }
        if (be7 == FS_FAT || be7 == FS_EXFAT) {
            var roff = op_path + vfs_mnt_reloff;
            var rlen = op_len - vfs_mnt_reloff;
            if ((arg3 & 0x100) != 0) { vfs_create_on(be7, roff, rlen); }   # AO_CREAT
            # 1.41.7: write-access (AO_WRONLY/AO_RDWR, low 2 bits) → a write-back
            # fd that buffers content + flushes the whole file via vfs_write_on at
            # close, so agnsh can write a FAT/exFAT data partition. Else a read
            # memfile. AO_TRUNC is implicit (whole-file replace); AO_APPEND TODO.
