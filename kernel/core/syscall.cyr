        if (fb_fb_phys() != 0) { fbi_present = 1; }
        store32(arg1 +  0, fb_width());
        store32(arg1 +  4, fb_height());
        store32(arg1 +  8, fb_pitch());
        store32(arg1 + 12, 32);                 # bpp — gnoboot only hands 32bpp
        store32(arg1 + 16, fb_pf());            # 0=RGBX / 1=BGRX
