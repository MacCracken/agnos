        # user RSP (not the child's leftovers). &ew37_ctx/&exec_ctx are fresh global
        # addresses (not carried locals).
        var r37 = ew37_ctx_base();
        var er  = exec_ctx_base();
        var ri  = 0;
        while (ri < 64) { store64(er + ri, load64(r37 + ri)); ri = ri + 8; }
        kernel_return_rsp_set(ew37_kr_rsp_get());             # re-arm (==1): agnsh's exit() resumes kybernet
        kernel_return_rip_set(ew37_kr_rip_get());
        store64(&pcpu_kpti_kernel_cr3 + pcpu_cpu() * 8, ew37_cr3_get());   # agnsh's CR3 (kernel-side); 4c per-CPU
        store64(&pcpu_kpti_user_cr3 + pcpu_cpu() * 8, ew37_cr3_get());      # the value the exit stub reloads into CR3 pre-SYSRET
        store64(&pcpu_kernel_rsp_save + pcpu_cpu() * 8, ew37_rsp_save_get());   # the exit stub reloads rsp from this CPU's pcpu_kernel_rsp_save slot pre-SYSRET (per-CPU 4b)
        ksyscall_a4_set(ew37_a4_get());
        proc_current_set(ew37_pid_get());                # agnsh's pid (its write/exit attribute to agnsh)
        exec_resume_pid_set(ew37_resume_pid_get());         # 1.44.14: agnsh is the resume target again, so
