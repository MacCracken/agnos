        # into the live scanout. Falls back to the direct live-FB base — byte-identical legacy behaviour —
        # whenever the GPU/DCN isn't usable (e.g. QEMU) or P0 never identified a pipe. Geometry/pitch are
        # the console FB's, so every bound proven below still holds for the back buffer.
        var bl_fb = gpu_blit_target(bl_fb_direct);
