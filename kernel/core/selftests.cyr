# === Boot self-tests (split from main.cyr at the 1.36.2 refactor) ===
# Compile-gated (#ifdef *_SELFTEST / *_SMOKE) hermetic + live checks that run
# after main.cyr boot init and BEFORE core/boot_finish.cyr launches kybernet.
# Production builds set no flags -> these compile to nothing. Included in order
# (main -> selftests -> boot_finish) so the production binary is byte-identical.

#ifdef DNS_SELFTEST
# DNS stub-resolver self-test (1.35.x bite 2, compile-gated via DNS_SELFTEST).
#   (1) Print the DHCP-captured resolver (bite 1 / option 6) — under QEMU
#       SLIRP this is 10.0.2.3, hermetic (no internet needed).
#   (2) HERMETIC parse test: feed dns_parse_answer a hand-built RFC 1035
#       response for example.com -> 93.184.216.34 whose answer NAME is a
#       0xC0 compression pointer back to the question. Asserts the extracted
#       A record — exercises dns_skip_name's pointer case + the answer walk
#       with zero network dependency. This is the load-bearing smoke gate.
#   (3) Best-effort live lookup (informational; needs SLIRP->host DNS).
{
    kprint("dns: resolver=", 14); dhcp_print_ip(net_dns_server); kprintln("", 0);

    var resp[64];
    # Header: id=0xABCD flags=0x8180 (QR|RD|RA) qd=1 an=1 ns=0 ar=0
    store8(&resp + 0, 0xAB); store8(&resp + 1, 0xCD);
    store8(&resp + 2, 0x81); store8(&resp + 3, 0x80);
    store8(&resp + 4, 0x00); store8(&resp + 5, 0x01);
    store8(&resp + 6, 0x00); store8(&resp + 7, 0x01);
    store8(&resp + 8, 0x00); store8(&resp + 9, 0x00);
    store8(&resp + 10, 0x00); store8(&resp + 11, 0x00);
    # Question: 07 "example" 03 "com" 00, QTYPE=A, QCLASS=IN
    store8(&resp + 12, 7);
    store8(&resp + 13, 101); store8(&resp + 14, 120); store8(&resp + 15, 97);
    store8(&resp + 16, 109); store8(&resp + 17, 112); store8(&resp + 18, 108);
    store8(&resp + 19, 101);
    store8(&resp + 20, 3);
    store8(&resp + 21, 99); store8(&resp + 22, 111); store8(&resp + 23, 109);
    store8(&resp + 24, 0);
    store8(&resp + 25, 0x00); store8(&resp + 26, 0x01);
    store8(&resp + 27, 0x00); store8(&resp + 28, 0x01);
    # Answer: NAME = 0xC0 0x0C (pointer to offset 12), A, IN, ttl=256, rdlen=4,
    # RDATA = 93.184.216.34
    store8(&resp + 29, 0xC0); store8(&resp + 30, 0x0C);
    store8(&resp + 31, 0x00); store8(&resp + 32, 0x01);
    store8(&resp + 33, 0x00); store8(&resp + 34, 0x01);
    store8(&resp + 35, 0x00); store8(&resp + 36, 0x00);
    store8(&resp + 37, 0x01); store8(&resp + 38, 0x00);
    store8(&resp + 39, 0x00); store8(&resp + 40, 0x04);
    store8(&resp + 41, 93); store8(&resp + 42, 184);
    store8(&resp + 43, 216); store8(&resp + 44, 34);

    var parsed = 0;
    if (dns_parse_answer(&resp, 45, 0xABCD, &parsed) == 0) {
        if (parsed == ip4(93, 184, 216, 34)) {
            kprintln("dns: parse PASS", 15);
        } else {
            kprintln("dns: parse FAIL", 15);
        }
    } else {
        kprintln("dns: parse FAIL", 15);
    }

    # Cache + TTL self-test (1.35.6). dns_parse_answer above set dns_last_ttl
    # from the hand-built answer (ttl=256). Then exercise the positive cache:
    # put→find hit, un-cached miss, and the not-expired gate. Runs BEFORE the
    # live lookup so it doesn't observe example.com's insertion.
    var cok = 1;
    if (dns_last_ttl != 256) { cok = 0; }                       # TTL extraction
    dns_cache_put("cachetst", 8, ip4(5, 6, 7, 8), 100);
    var cf = dns_cache_find("cachetst", 8);
    if (cf < 0) { cok = 0; }
    else { if (load64(&dns_cache_ip + cf * 8) != ip4(5, 6, 7, 8)) { cok = 0; } }
    if (dns_cache_find("notcached", 9) >= 0) { cok = 0; }       # miss: never inserted
    store64(&dns_cache_ip + 7 * 8, ip4(9, 9, 9, 9));            # hand-place an expired entry
    store64(&dns_cache_exp + 7 * 8, 0);                         # exp in the past
    store64(&dns_cache_len + 7 * 8, 3);
    store8(&dns_cache_names + 7 * 64 + 0, 101);                 # "exp"
    store8(&dns_cache_names + 7 * 64 + 1, 120);
    store8(&dns_cache_names + 7 * 64 + 2, 112);
    if (dns_cache_find("exp", 3) >= 0) { cok = 0; }             # miss: expired
    if (cok == 1) { kprintln("dns: cache PASS", 15); }
    if (cok == 0) { kprintln("dns: cache FAIL", 15); }

    var live = 0;
    if (dns_resolve("example.com", 11, &live) == 0) {
        kprint("dns: live=", 10); dhcp_print_ip(live); kprintln("", 0);
    } else {
        kprintln("dns: live skip", 14);
    }
}
#endif

#ifdef ICMP_SELFTEST
# ═══ 1.57.7 (S6) — the per-process reply slots (icmp: slots, M-S8) and the WK_ICMP wake (icmp: wake, M-S11).
# ⚠ MODULE SCOPE: icst_buf[16] = 128 B (a 50-byte eth + IPv4 + ICMP echo-reply frame).
var icst_buf[16];
# Build an echo REPLY net_ip -> net_ip with id icmp_id and sequence `seq` into icst_buf; returns the frame length.
fn icst_frame(seq) {
    var f = &icst_buf;
    var i = 0;
    while (i < 128) { store8(f + i, 0); i = i + 1; }
    store8(f + 12, 0x08); store8(f + 13, 0x00);
    store8(f + 14, 0x45); store8(f + 16, 0); store8(f + 17, 36);
    store8(f + 22, 64); store8(f + 23, 1);
    store8(f + 26, (net_ip >> 24) & 0xFF); store8(f + 27, (net_ip >> 16) & 0xFF);
    store8(f + 28, (net_ip >> 8) & 0xFF); store8(f + 29, net_ip & 0xFF);
    store8(f + 30, (net_ip >> 24) & 0xFF); store8(f + 31, (net_ip >> 16) & 0xFF);
    store8(f + 32, (net_ip >> 8) & 0xFF); store8(f + 33, net_ip & 0xFF);
    store8(f + 34, 0);                                           # type 0 = echo reply
    store8(f + 38, (icmp_id >> 8) & 0xFF); store8(f + 39, icmp_id & 0xFF);
    store8(f + 40, (seq >> 8) & 0xFF); store8(f + 41, seq & 0xFF);
    var ck = ip_checksum(f + 34, 16);
    store8(f + 36, (ck >> 8) & 0xFF); store8(f + 37, ck & 0xFF);
    var ick = ip_checksum(f + 14, 20);
    store8(f + 24, (ick >> 8) & 0xFF); store8(f + 25, ick & 0xFF);
    return 50;
}
fn icst_arm_slots() {
    net_tick_pause();
    var ok = 1;
    var rx0 = icmp_rx;
    icmp_slot_arm(14, 0x7101);
    icmp_slot_arm(15, 0x7102);
    icst_frame(0x7102);
    net_handle_icmp(&icst_buf, 34, 16, 0x0A000202, net_ip);
    if (load64(&icmp_slot_rtt + 15 * 8) < 0 || load64(&icmp_slot_rtt + 14 * 8) != 0 - 1) { ok = 0; }
    icst_frame(0x7101);
    net_handle_icmp(&icst_buf, 34, 16, 0x0A000203, net_ip);
    if (load64(&icmp_slot_rtt + 14 * 8) < 0) { ok = 0; }
    if (load64(&icmp_slot_from + 14 * 8) != 0x0A000203 || load64(&icmp_slot_from + 15 * 8) != 0x0A000202) { ok = 0; }
    icst_frame(0x7100);
    net_handle_icmp(&icst_buf, 34, 16, 0x0A000202, net_ip);
    if (icmp_rx != rx0 + 2) { ok = 0; }
    icmp_slot_clear(14);
    icmp_slot_clear(15);
    net_tick_resume();
    if (ok == 1) { kprintln("icmp: slots PASS", 16); } else { kprintln("icmp: slots FAIL", 16); }
    return ok;
}
# A pinger BLOCKED directly in icmp_block (no loop-top poll) is woken by the reply net_tick delivers from lo (M-S11).
fn icst_arm_wake() {
    if (net_ip == 0) { kprintln("icmp: wake SKIP (net_ip=0)", 26); return 0; }
    net_tick_pause();
    var ok = 1;
    var me = proc_current_get();
    if (me < 0 || me >= 16) { me = 0; }
    icmp_slot_arm(me, 0x7201);
    var len = icst_frame(0x7201);
    var tf = net_tx_begin();
    net_lo_enqueue(&icst_buf, len);
    net_tx_end(tf);
    var sf = kbd_irq_save();
    net_tick_resume();
    var t0 = sched_clock_us();
    var r = icmp_block(me, 0x7201, t0 + 2000000);
    var el = sched_clock_us() - t0;
    net_tick_pause();
    kbd_irq_restore(sf);
    if (r != 0 || el >= 500000 || load64(&icmp_slot_rtt + me * 8) < 0) { ok = 0; }
    icmp_slot_clear(me);
    net_tick_resume();
    kprint("icmp: wake us=", 14); kprint_num(el); kprint(" r=", 3); kprint_num(r); kprintln("", 0);
    if (ok == 1) { kprintln("icmp: wake PASS", 15); } else { kprintln("icmp: wake FAIL", 15); }
    return ok;
}
#endif

#ifdef ICMP_SELFTEST
# ICMP echo self-test (1.35.x, compile-gated via ICMP_SELFTEST).
#   (1) HERMETIC: build an echo request, store its checksum, then re-checksum
#       the whole message — a correct ICMP checksum makes the message sum to
#       0 (one's-complement property). Zero network dependency. Load-bearing.
#   (2) Best-effort live ping of the gateway (SLIRP = 10.0.2.2; informational,
#       depends on host ICMP permissions).
{
    var em[16];
    store8(&em + 0, 8); store8(&em + 1, 0);          # type 8 echo request
    store8(&em + 2, 0); store8(&em + 3, 0);          # checksum placeholder
    store8(&em + 4, 0x41); store8(&em + 5, 0x47);    # id
    store8(&em + 6, 0x00); store8(&em + 7, 0x01);    # seq
    store8(&em + 8, 0x68); store8(&em + 9, 0x69);    # "hi" payload
    store8(&em + 10, 0x00); store8(&em + 11, 0x00);
    var ck = ip_checksum(&em, 12);
    store8(&em + 2, (ck >> 8) & 0xFF); store8(&em + 3, ck & 0xFF);
    if (ip_checksum(&em, 12) == 0) {
        kprintln("icmp: build PASS", 16);
    } else {
        kprintln("icmp: build FAIL", 16);
    }
    var grtt = icmp_ping(net_gateway, 0);
    if (grtt < 0) {
        kprintln("icmp: gw no reply", 17);
    } else {
        kprint("icmp: gw reply ticks=", 21); kprint_num(grtt); kprintln("", 0);
    }
    icst_arm_slots();
    icst_arm_wake();
    kprintln("icmp: selftest done", 19);
}
#endif

#ifdef TCP_SELFTEST
# ═══ 1.57.7 (S4) — TCP_SELFTEST helpers + arms (scripts/smoke/tcp-smoke.sh; docs/architecture/net-concurrency.md).
# Every arm is IF-independent (nothing reaches net_wait_backoff's hlt: every wait below uses an EXPIRED deadline).
# Frames are injected through the REAL demux (net_demux_frame, which takes tcp_lock itself); replies to net_ip loop
# into the lo queue and match no conn, so the next drain drops them. Lo assertions use deltas of lo_count/lo_dropped.
# ⚠ MODULE SCOPE: `var tcpst_buf[16]` is 16 u64 = 128 BYTES (a function-local var[16] would be 16 bytes).
var tcpst_buf[16];
var tcpst_gen0[8];

fn tcpst_be16(p, v) { store8(p, (v >> 8) & 0xFF); store8(p + 1, v & 0xFF); return 0; }
fn tcpst_be32(p, v) {
    store8(p, (v >> 24) & 0xFF); store8(p + 1, (v >> 16) & 0xFF);
    store8(p + 2, (v >> 8) & 0xFF); store8(p + 3, v & 0xFF);
    return 0;
}

# Build eth + IPv4 (net_ip -> net_ip) + TCP (window 0x2000; a SYN carries MSS 1460) into tcpst_buf; returns the
# frame length. Checksums per critic C13: zero first, then the IP header sum and the TCP pseudo-header sum.
fn tcpst_frame(sport, dport, seq, ack, flags, data, dlen) {
    var f = &tcpst_buf;
    var i = 0;
    while (i < 128) { store8(f + i, 0); i = i + 1; }
    var hl = 20;
    if ((flags & 0x02) != 0) { hl = 24; }
    var tl = hl + dlen;
    store8(f + 12, 0x08); store8(f + 13, 0x00);
    store8(f + 14, 0x45);
    tcpst_be16(f + 16, 20 + tl);
    store8(f + 22, 64); store8(f + 23, 6);
    tcpst_be32(f + 26, net_ip); tcpst_be32(f + 30, net_ip);
    tcpst_be16(f + 34, sport); tcpst_be16(f + 36, dport);
    tcpst_be32(f + 38, seq); tcpst_be32(f + 42, ack);
    store8(f + 46, (hl / 4) << 4);
    store8(f + 47, flags);
    store8(f + 48, 0x20); store8(f + 49, 0x00);
    if (hl == 24) { store8(f + 54, 2); store8(f + 55, 4); store8(f + 56, 0x05); store8(f + 57, 0xB4); }
    var j = 0;
    while (j < dlen) { store8(f + 34 + hl + j, load8(data + j)); j = j + 1; }
    tcpst_be16(f + 24, ip_checksum(f + 14, 20));
    tcpst_be16(f + 50, tcp_checksum_compute(net_ip, net_ip, f + 34, tl));
    return 14 + 20 + tl;
}

# An ICMP echo request net_ip -> net_ip, id 0x5354 (never icmp_id), 8 payload bytes.
fn tcpst_echo(seq) {
    var f = &tcpst_buf;
    var i = 0;
    while (i < 128) { store8(f + i, 0); i = i + 1; }
    store8(f + 12, 0x08); store8(f + 13, 0x00);
    store8(f + 14, 0x45); tcpst_be16(f + 16, 36);
    store8(f + 22, 64); store8(f + 23, 1);
    tcpst_be32(f + 26, net_ip); tcpst_be32(f + 30, net_ip);
    store8(f + 34, 8);
    tcpst_be16(f + 38, 0x5354); tcpst_be16(f + 40, seq);
    var k = 0;
    while (k < 8) { store8(f + 42 + k, 0x61 + k); k = k + 1; }
    tcpst_be16(f + 36, ip_checksum(f + 34, 16));
    tcpst_be16(f + 24, ip_checksum(f + 14, 20));
    return 50;
}

fn tcpst_inject(len) { return net_demux_frame(&tcpst_buf, len); }
fn tcpst_lo(len) {
    var tf = net_tx_begin();
    var tr = net_lo_enqueue(&tcpst_buf, len);
    net_tx_end(tf);
    return tr;
}
fn tcpst_drain() {
    var n = 0;
    while (n < 4 && lo_count != 0) { net_poll(); n = n + 1; }
    return 0;
}
fn tcpst_lo_byte(k, off) { return load8(&lo_ring + ((lo_tail - 1 - k) & 7) * 1536 + off); }
fn tcpst_seq32(k) {
    return (tcpst_lo_byte(k, 38) << 24) | (tcpst_lo_byte(k, 39) << 16) | (tcpst_lo_byte(k, 40) << 8) | tcpst_lo_byte(k, 41);
}
fn tcpst_find(sport, dport) {
    var ff = tcp_lock();
    var fc = tcp_find_conn(sport, dport, net_ip, 0);
    tcp_unlock(ff);
    return fc;
}
fn tcpst_set_state(id, st) {
    var sf = tcp_lock();
    store64(tcp_conn_base(id), st);
    tcp_unlock(sf);
    return 0;
}
fn tcpst_gen(id) { return load64(&tcp_conn_gen + id * 8); }

# ARM 5 helper — one wrapper (w: 0 tcp_lock, 1 net_tx_begin, 2 lo_q_begin, 3 udp_begin). Inside: IF=0, the
# lock GLOBAL is 1 (the xchg hit the real global), preempt count = entry + 1. After: global 0, count back,
# IF equal to the entry IF.
fn tcpst_lk_one(w) {
    var e_if = dm_read_rflags() & 0x200;
    var pc0 = preempt_count_get();
    var ok = 1;
    var f = 0;
    if (w == 0) { f = tcp_lock(); }
    if (w == 1) { f = net_tx_begin(); }
    if (w == 2) { f = lo_q_begin(); }
    if (w == 3) { f = udp_begin(); }
    if ((dm_read_rflags() & 0x200) != 0) { ok = 0; }
    var g = 0;
    if (w == 0) { g = tcp_tab_lock; }
    if (w == 1) { g = net_tx_lock; }
    if (w == 2) { g = lo_q_lock; }
    if (w == 3) { g = udp_lock; }
    if (g != 1) { ok = 0; }
    if (preempt_count_get() != pc0 + 1) { ok = 0; }
    if (w == 0) { tcp_unlock(f); }
    if (w == 1) { net_tx_end(f); }
    if (w == 2) { lo_q_end(f); }
    if (w == 3) { udp_end(f); }
    g = 1;
    if (w == 0) { g = tcp_tab_lock; }
    if (w == 1) { g = net_tx_lock; }
    if (w == 2) { g = lo_q_lock; }
    if (w == 3) { g = udp_lock; }
    if (g != 0) { ok = 0; }
    if (preempt_count_get() != pc0) { ok = 0; }
    if ((dm_read_rflags() & 0x200) != e_if) { ok = 0; }
    return ok;
}

fn tcpst_arm_locks() {
    var ok = 1;
    var was_if = dm_read_rflags() & 0x200;
    if (was_if == 0) {
        asm { 0xFB; }                  # sti — inputs: none; outputs: RFLAGS.IF=1; clobbers: none
    }
    var w = 0;
    while (w < 4) {
        if (tcpst_lk_one(w) != 1) { ok = 0; }          # with IF=1 at entry
        var sf = kbd_irq_save();
        if (tcpst_lk_one(w) != 1) { ok = 0; }          # inside kbd_irq_save (IF=0 at entry)
        kbd_irq_restore(sf);
        w = w + 1;
    }
    if (was_if == 0) {
        asm { 0xFA; }                  # cli — inputs: none; outputs: RFLAGS.IF=0; clobbers: none
    }
    if (ok == 1) { kprintln("tcp: locks PASS", 15); } else { kprintln("tcp: locks FAIL", 15); }
    return ok;
}

# ARM 6 — the lo drain demuxes IN PLACE (N-2): with the queue full, the head frame's echo reply finds no room
# because its own slot is still occupied (exactly one drop); every later reply takes a freed slot.
fn tcpst_arm_loinplace() {
    if (net_ip == 0) { kprintln("net: lo-inplace SKIP (net_ip=0)", 31); return 0; }
    var ok = 1;
    tcpst_drain();
    if (lo_count != 0) { ok = 0; }
    var k = 0;
    while (k < 8) { tcpst_lo(tcpst_echo(k)); k = k + 1; }
    if (lo_count != 8) { ok = 0; }
    var d0 = lo_dropped;
    var r0 = icmp_replies_sent;
    net_lo_drain();
    if (lo_dropped != d0 + 1) { ok = 0; }
    if (icmp_replies_sent != r0 + 8) { ok = 0; }
    if (lo_count != 0) { ok = 0; }
    if (ok == 1) { kprintln("net: lo-inplace PASS", 20); } else { kprintln("net: lo-inplace FAIL", 20); }
    return ok;
}

# ARM 7 — virtio TX slots (N-1) + ring KVAs (N-6).
fn tcpst_txs_mark(slot, ch) {
    var tk = dma_kva(load64(vnet_tx_desc + slot * 16)) + 12 + 42;
    if (load8(tk) != 84) { return 0; }             # 'T'
    if (load8(tk + 1) != 88) { return 0; }         # 'X'
    if (load8(tk + 2) != 83) { return 0; }         # 'S'
    if (load8(tk + 3) != 45) { return 0; }         # '-'
    if (load8(tk + 4) != ch) { return 0; }
    return 1;
}
fn tcpst_arm_txslots() {
    if (vnet_active == 0) { kprintln("net: txslots SKIP (no virtio-net)", 33); return 0; }
    var ok = 1;
    if (vnet_rx_desc < DIRECTMAP_BASE || vnet_rx_avail < DIRECTMAP_BASE || vnet_rx_used < DIRECTMAP_BASE) { ok = 0; }
    if (vnet_tx_desc < DIRECTMAP_BASE || vnet_tx_avail < DIRECTMAP_BASE || vnet_tx_used < DIRECTMAP_BASE) { ok = 0; }
    var sf = kbd_irq_save();
    var ia = vnet_tx_idx;
    var ra = udp_send(ip4(10, 0, 2, 2), 40100, 9, "TXS-A-MARK", 10);
    var ib = vnet_tx_idx;
    var rb = udp_send(ip4(10, 0, 2, 2), 40100, 9, "TXS-B-MARK", 10);
    var ic = vnet_tx_idx;
    kbd_irq_restore(sf);
    if (ra <= 0 || rb <= 0) { ok = 0; }
    if (ib != ia + 1 || ic != ib + 1) { ok = 0; }
    var sa = ia & (vnet_tx_slots - 1);
    var sb = ib & (vnet_tx_slots - 1);
    if (load64(vnet_tx_desc + sa * 16) == load64(vnet_tx_desc + sb * 16)) { ok = 0; }
    if (load64(vnet_tx_desc + sa * 16) != load64(&vnet_tx_bufs + sa * 8)) { ok = 0; }
    if (tcpst_txs_mark(sa, 65) != 1) { ok = 0; }   # 'A'
    if (tcpst_txs_mark(sb, 66) != 1) { ok = 0; }   # 'B'
    if (ok == 1) { kprintln("net: txslots PASS", 17); } else { kprintln("net: txslots FAIL", 17); }
    return ok;
}

# ARM 8 — the pool, the claim (gen bump, publish last), hardening (a), C11, a SYN_RCVD close, C7(a).
fn tcpst_arm_claim() {
    if (net_ip == 0) { kprintln("tcp: claim SKIP (net_ip=0)", 26); return 0; }
    var ok = 1;
    if (tcp_pool_ready != 1) { ok = 0; }
    var pa = 0;
    while (pa < 16) {
        var pv = load64(&tcp_pool_rx + pa * 8);
        if (pa >= 8) { pv = load64(&tcp_pool_retx + (pa - 8) * 8); }
        if (pv == 0 || pv < DIRECTMAP_BASE) { ok = 0; }
        var pb = pa + 1;
        while (pb < 16) {
            var pw = load64(&tcp_pool_rx + pb * 8);
            if (pb >= 8) { pw = load64(&tcp_pool_retx + (pb - 8) * 8); }
            if (pv == pw) { ok = 0; }
            pb = pb + 1;
        }
        pa = pa + 1;
    }
    var l = tcp_listen(7778);
    if (l < 0) { ok = 0; }
    if (tcp_listen(7778) != 0 - 1) { ok = 0; }
    var gi = 0;
    while (gi < 8) { store64(&tcpst_gen0 + gi * 8, tcpst_gen(gi)); gi = gi + 1; }
    tcpst_inject(tcpst_frame(40001, 7778, 0x11223344, 0, 0x02, 0, 0));
    var c = tcpst_find(40001, 7778);
    if (c < 0 || l < 0) {
        ok = 0;
    } else {
        var cb = tcp_conn_base(c);
        if (load64(cb) != 6) { ok = 0; }
        if (load64(cb + 48) != load64(&tcp_pool_rx + c * 8)) { ok = 0; }
        if (load64(cb + 136) != load64(&tcp_pool_retx + c * 8)) { ok = 0; }
        if (load64(cb + 128) != 0x12) { ok = 0; }
        if (load64(cb + 144) != 1460) { ok = 0; }
        if (load64(cb + 72) != (0x200 | (l << 16))) { ok = 0; }
        if (tcpst_gen(c) != load64(&tcpst_gen0 + c * 8) + 1) { ok = 0; }
        var isn = load64(cb + 56);
        if (load64(cb + 32) != ((isn + 1) & 0xFFFFFFFF)) { ok = 0; }
        # (a) a retransmitted SYN re-sends the SYN-ACK at the held ISN, SND.NXT untouched.
        tcpst_drain();
        var q0 = lo_count;
        var nx0 = load64(cb + 32);
        tcpst_inject(tcpst_frame(40001, 7778, 0x11223344, 0, 0x02, 0, 0));
        if (lo_count != q0 + 1) { ok = 0; }
        if (tcpst_lo_byte(0, 47) != 0x12) { ok = 0; }
        if (tcpst_seq32(0) != isn) { ok = 0; }
        if (load64(cb + 32) != nx0) { ok = 0; }
        # C11: RST in SYN_RCVD -> CLOSED with the retransmit DISARMED.
        tcpst_inject(tcpst_frame(40001, 7778, 0x11223345, 0, 0x04, 0, 0));
        if (load64(cb) != 0) { ok = 0; }
        if (load64(cb + 128) != 0) { ok = 0; }
    }
    tcpst_drain();
    tcpst_inject(tcpst_frame(40003, 7778, 0x5000, 0, 0x02, 0, 0));
    var d = tcpst_find(40003, 7778);
    if (d < 0) {
        ok = 0;
    } else {
        var db = tcp_conn_base(d);
        tcp_close(d);
        if (load64(db) != 0 || load64(db + 48) != 0 || load64(db + 128) != 0) { ok = 0; }
        if (load64(db + 136) != load64(&tcp_pool_retx + d * 8)) { ok = 0; }
    }
    # C7(a): once the listener is closed, a state-6 claim naming it as parent is refused.
    if (l >= 0) {
        tcp_close(l);
        var cf = tcp_lock();
        var stale = tcp_slot_claim_locked(6, 7778, 40004, net_ip, 1, 1, 0x200 | (l << 16), 536, 0, net_ip);
        if (stale >= 0) { ok = 0; tcp_slot_release_locked(stale); }
        tcp_unlock(cf);
    }
    tcpst_drain();
    if (ok == 1) { kprintln("tcp: claim PASS", 15); } else { kprintln("tcp: claim FAIL", 15); }
    return ok;
}

# ARM 9 — the generation (N-4) and tcp_connect_wait's 2|4 / release_if rules (N-8). Expired deadlines only.
fn tcpst_arm_gen() {
    var ok = 1;
    var g = tcp_slot_claim(1, 0xEEE2, 0xEEE2, 0, 1, 0, 0, 536, 0, net_ip);
    if (g < 0) {
        ok = 0;
    } else {
        var gb = tcp_conn_base(g);
        var g0 = tcpst_gen(g);
        if (tcp_conn_check(g, g0) != 1) { ok = 0; }
        var dl = sched_clock_us() - 1;                             # 1.57.7 (S6): deadlines are µs
        tcpst_set_state(g, 4);                                     # (1) N-8: CLOSE_WAIT counts as connected
        if (tcp_connect_wait(g, 0, 0, g0, dl) != g) { ok = 0; }      # 1.57.7 S5: (tag, epoch, gen) snapshot; g is tag 0
        if (load64(gb) != 4) { ok = 0; }
        var gf = tcp_lock();                                       # (2) recycled: state 2, gen bumped
        store64(gb, 2);
        store64(&tcp_conn_gen + g * 8, tcpst_gen(g) + 1);
        tcp_unlock(gf);
        if (tcp_conn_check(g, g0) != 0 - 1) { ok = 0; }
        if (tcp_connect_wait(g, 0, 0, g0, dl) != 0 - 1) { ok = 0; }
        if (load64(gb) != 2) { ok = 0; }                           # not released: someone else's now
        var g1 = tcpst_gen(g);                                     # (3) still SYN_SENT + ours -> released
        tcpst_set_state(g, 1);
        if (tcp_connect_wait(g, 0, 0, g1, dl) != 0 - 1) { ok = 0; }
        if (load64(gb) != 0 || load64(gb + 48) != 0 || load64(gb + 128) != 0) { ok = 0; }
        if (load64(gb) != 0) { tcp_close(g); }
    }
    if (ok == 1) { kprintln("tcp: gen PASS", 13); } else { kprintln("tcp: gen FAIL", 13); }
    return ok;
}

# ARM 10 — the passive backlog: at most TCP_SYNRCVD_MAX (4) SYN_RCVD, and passive children never take the last
# free slot (TCP_PASSIVE_RESERVE); a LISTEN close RSTs its un-accepted ESTABLISHED children.
fn tcpst_arm_syncap() {
    if (net_ip == 0) { kprintln("tcp: syncap SKIP (net_ip=0)", 27); return 0; }
    var ok = 1;
    var l = tcp_listen(7780);
    if (l < 0) { kprintln("tcp: syncap FAIL", 16); return 0; }
    var sf = tcp_lock();
    var free0 = tcp_free_slots_locked();
    tcp_unlock(sf);
    var want = free0 - 1;
    if (want > 4) { want = 4; }
    var n = 0;
    var k = 0;
    while (k < 8) {
        tcpst_inject(tcpst_frame(40010 + k, 7780, 0x1000 * (k + 1), 0, 0x02, 0, 0));
        tcpst_drain();
        if (tcpst_find(40010 + k, 7780) < 0) { break; }
        n = n + 1;
        k = k + 1;
    }
    if (n != want) { ok = 0; }
    var h = 0;
    while (h < n) {                                                # complete the handshakes -> ESTABLISHED
        var hc = tcpst_find(40010 + h, 7780);
        if (hc >= 0) {
            var hisn = load64(tcp_conn_base(hc) + 56);
            tcpst_inject(tcpst_frame(40010 + h, 7780, 0x1000 * (h + 1) + 1, (hisn + 1) & 0xFFFFFFFF, 0x10, 0, 0));
            if (load64(tcp_conn_base(hc)) != 2) { ok = 0; }
        }
        h = h + 1;
    }
    tcpst_drain();
    var m = 0;
    while (m < 8) {                                                # keep offering SYNs: the reserve stops them
        tcpst_inject(tcpst_frame(40020 + m, 7780, 0x9000 + m, 0, 0x02, 0, 0));
        tcpst_drain();
        m = m + 1;
    }
    var kids = 0;
    var est = 0;
    var ci = 0;
    while (ci < tcp_conn_count) {
        var cm = load64(tcp_conn_base(ci) + 72);
        var cs = load64(tcp_conn_base(ci));
        if (cs != 0 && (cm & 0x200) != 0 && ((cm >> 16) & 0xFF) == l) {
            kids = kids + 1;
            if (cs == 2 || cs == 4) { est = est + 1; }
        }
        ci = ci + 1;
    }
    if (kids != free0 - 1) { ok = 0; }
    sf = tcp_lock();
    if (tcp_free_slots_locked() != 1) { ok = 0; }
    tcp_unlock(sf);
    tcpst_drain();
    var q0 = lo_count + lo_dropped;
    tcp_close(l);
    ci = 0;
    while (ci < tcp_conn_count) {
        var cm2 = load64(tcp_conn_base(ci) + 72);
        if ((cm2 & 0x200) != 0 && ((cm2 >> 16) & 0xFF) == l) {
            if (load64(tcp_conn_base(ci)) != 0) { ok = 0; }
        }
        ci = ci + 1;
    }
    if (lo_count + lo_dropped - q0 != est) { ok = 0; }
    tcpst_drain();
    if (ok == 1) { kprintln("tcp: syncap PASS", 16); } else { kprintln("tcp: syncap FAIL", 16); }
    return ok;
}

# ARM 11 — the EOF rule (issue 2026-09-23-sock-recv-never-reports-eof-after-peer-fin): {dead} ∪ {CLOSE_WAIT with
# an empty ring}; data always drains before EOF.
fn tcpst_arm_eof() {
    var ok = 1;
    var e = tcp_slot_claim(2, 0xEEED, 0xEEED, 0, 0, 0, 0, 536, 0, net_ip);
    if (e < 0) {
        ok = 0;
    } else {
        var eb = tcp_conn_base(e);
        if (tcp_conn_eof(e) != 0) { ok = 0; }                     # live + empty: not EOF
        tcpst_set_state(e, 4);
        if (tcp_conn_eof(e) != 1) { ok = 0; }                     # CLOSE_WAIT + empty: EOF
        var ef = tcp_lock();
        tcp_rx_append(eb, "HELLO", 5);
        tcp_unlock(ef);
        if (tcp_conn_eof(e) != 0) { ok = 0; }                     # data before EOF
        if (tcp_recv(e, &tcpst_buf, 16) != 5) { ok = 0; }
        if (tcp_conn_eof(e) != 1) { ok = 0; }
        ef = tcp_lock();
        tcp_slot_release_locked(e);
        tcp_unlock(ef);
        if (tcp_conn_eof(e) != 1) { ok = 0; }                     # dead: EOF
    }
    if (ok == 1) { kprintln("tcp: eof PASS", 13); } else { kprintln("tcp: eof FAIL", 13); }
    return ok;
}

# ARM 12 — half-close (D12(ii)): a FIN before accept keeps the child (CLOSE_WAIT, not reaped), accept returns it,
# its data then EOF are delivered, it can SEND in CLOSE_WAIT, a re-sent FIN is re-ACKed (N-5), our close from
# CLOSE_WAIT sends one FIN|ACK at SND.NXT, and a RST in CLOSE_WAIT closes it (N-5).
fn tcpst_arm_halfclose() {
    if (net_ip == 0) { kprintln("tcp: halfclose SKIP (net_ip=0)", 30); return 0; }
    var ok = 1;
    var l = tcp_listen(7779);
    if (l < 0) { kprintln("tcp: halfclose FAIL", 19); return 0; }
    var S = 0x7000;
    tcpst_inject(tcpst_frame(40002, 7779, S, 0, 0x02, 0, 0));
    var c = tcpst_find(40002, 7779);
    if (c < 0) {
        ok = 0;
    } else {
        var cb = tcp_conn_base(c);
        var isn = load64(cb + 56);
        tcpst_inject(tcpst_frame(40002, 7779, S + 1, isn + 1, 0x10, 0, 0));
        if (load64(cb) != 2) { ok = 0; }
        tcpst_inject(tcpst_frame(40002, 7779, S + 1, isn + 1, 0x18, "GET", 3));
        if (load64(cb + 64) - load64(cb + 80) != 3) { ok = 0; }
        var gc = tcpst_gen(c);
        tcpst_inject(tcpst_frame(40002, 7779, S + 4, isn + 1, 0x11, 0, 0));
        if (load64(cb) != 4) { ok = 0; }                           # kept, NOT reaped
        if (tcpst_gen(c) != gc) { ok = 0; }
        if (tcp_accept(l) != c) { ok = 0; }
        if ((load64(cb + 72) & 0x400) == 0) { ok = 0; }
        var rb = &tcpst_gen0;                                      # 64-byte module scratch (gens are done)
        if (tcp_recv(c, rb, 8) != 3) { ok = 0; }
        if (load8(rb) != 71 || load8(rb + 1) != 69 || load8(rb + 2) != 84) { ok = 0; }   # "GET"
        if (tcp_conn_eof(c) != 1) { ok = 0; }
        # SEND IN CLOSE_WAIT: the peer's ACK for our 2 bytes is pre-queued; tcp_send's first net_poll drains it.
        tcpst_drain();
        tcpst_lo(tcpst_frame(40002, 7779, S + 5, (isn + 3) & 0xFFFFFFFF, 0x10, 0, 0));
        var t0 = lo_tail;
        var dq0 = lo_dropped;
        if (tcp_send(c, "OK", 2) != 2) { ok = 0; }
        if (((lo_tail - t0) & 7) != 1 || lo_dropped != dq0) { ok = 0; }   # exactly one data frame
        # N-5: a re-sent FIN in CLOSE_WAIT is re-ACKed.
        tcpst_drain();
        var q0 = lo_count;
        tcpst_inject(tcpst_frame(40002, 7779, S + 4, (isn + 3) & 0xFFFFFFFF, 0x11, 0, 0));
        if (lo_count != q0 + 1) { ok = 0; }
        if (tcpst_lo_byte(0, 47) != 0x10) { ok = 0; }
        # Close from CLOSE_WAIT: one FIN|ACK at SND.NXT. 1.57.7 (S6, graceful close): the slot is now a kernel-held
        # LAST_ACK (state 3, PEER_FIN, the FIN ARMED, ring unbound) until the peer ACKs the FIN — then released.
        tcpst_drain();
        var lo0 = lo_count;
        var nxt = load64(cb + 32);
        tcp_close(c);
        if (lo_count != lo0 + 1) { ok = 0; }
        if (tcpst_lo_byte(0, 47) != 0x11) { ok = 0; }
        if (tcpst_seq32(0) != nxt) { ok = 0; }
        if (load64(cb) != 3 || load64(cb + 48) != 0 || load64(cb + 128) != 0x11) { ok = 0; }
        if ((load64(cb + 72) & TCP_META_PEER_FIN) == 0) { ok = 0; }
        tcpst_drain();
        tcpst_inject(tcpst_frame(40002, 7779, S + 5, (nxt + 1) & 0xFFFFFFFF, 0x10, 0, 0));   # the peer ACKs our FIN
        if (load64(cb) != 0 || load64(cb + 48) != 0) { ok = 0; }
        if (load64(cb + 136) != load64(&tcp_pool_retx + c * 8)) { ok = 0; }
    }
    # N-5: RST in CLOSE_WAIT (an un-accepted child).
    tcpst_drain();
    var S2 = 0x8000;
    tcpst_inject(tcpst_frame(40005, 7779, S2, 0, 0x02, 0, 0));
    var c2 = tcpst_find(40005, 7779);
    if (c2 < 0) {
        ok = 0;
    } else {
        var c2b = tcp_conn_base(c2);
        var isn2 = load64(c2b + 56);
        tcpst_inject(tcpst_frame(40005, 7779, S2 + 1, isn2 + 1, 0x10, 0, 0));
        tcpst_inject(tcpst_frame(40005, 7779, S2 + 1, isn2 + 1, 0x11, 0, 0));
        if (load64(c2b) != 4) { ok = 0; }
        tcpst_inject(tcpst_frame(40005, 7779, S2 + 2, isn2 + 1, 0x04, 0, 0));
        if (load64(c2b) != 0 || load64(c2b + 128) != 0) { ok = 0; }
    }
    tcp_close(l);
    tcpst_drain();
    if (ok == 1) { kprintln("tcp: halfclose PASS", 19); } else { kprintln("tcp: halfclose FAIL", 19); }
    return ok;
}

# ═══ 1.57.7 (S6) — the net-wait arms (docs/architecture/blocking-waits.md § Network waits). The whole TCP_SELFTEST
# block runs between net_tick_pause() and net_tick_resume(); the arms that exist to prove net_tick (tickretx, ticklo,
# ackwake, rstwake) resume it for their own window and pause again. Fake slots are net_ip <-> net_ip (crafted frames
# from tcpst_frame match them; our own looped frames go to ports nothing listens on and are dropped) or 127.0.0.2
# (resends that must be dropped). ⚠ MODULE SCOPE: tcpst_pat[16] = 128 B, tcpst_ls[8] = 8 ids.
var tcpst_pat[16];
var tcpst_ls[8];
fn tcpst_rel(id) {
    var rf = tcp_lock();
    tcp_slot_release_locked(id);
    tcp_unlock(rf);
    return 0;
}
fn tcpst_fake(lp, rp, own) { return tcp_slot_claim(2, lp, rp, net_ip, 0x1000, 0x2000, 0, 536, own, net_ip); }
fn tcpst_st(id) { return load64(tcp_conn_base(id)); }
# Rewrite the window of the frame in tcpst_buf (length `len`) and recompute its TCP checksum; returns len.
fn tcpst_setwnd(len, wnd) {
    var f = &tcpst_buf;
    tcpst_be16(f + 48, wnd);
    tcpst_be16(f + 50, 0);
    tcpst_be16(f + 50, tcp_checksum_compute(net_ip, net_ip, f + 34, len - 34));
    return len;
}
fn tcpst_verdict(ok, name, nlen) {
    kprint("tcp: ", 5);
    kprint(name, nlen);
    if (ok == 1) { kprintln(" PASS", 5); } else { kprintln(" FAIL", 5); }
    return ok;
}
fn tcpst_find_lr(lp, rp) {
    var fi = 0;
    while (fi < tcp_conn_count) {
        var fb = tcp_conn_base(fi);
        if (load64(fb + 8) == lp && load64(fb + 16) == rp) { return fi; }
        fi = fi + 1;
    }
    return 0 - 1;
}

# rebase — a stamp in the future (the tsc_calibrate step) is reset to now and becomes due one RTO later (M-REBASE).
fn tcpst_arm_rebase() {
    var ok = 1;
    var c = tcpst_fake(0xEE10, 0xEE11, 0);
    if (c < 0) { return tcpst_verdict(0, "rebase", 6); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x1000, 0x18, "X", 1);
    var now = sched_clock_us();
    store64(cb + 112, now + 5000000);
    var r1 = tcp_retx_due(cb, now);
    var st = load64(cb + 112);
    var r2 = tcp_retx_due(cb, now + 1000000);
    tcp_unlock(f);
    if (r1 != 0 || st != now || r2 != 1) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "rebase", 6);
}

# tickretx — a due segment is retransmitted by net_tick alone (no net_poll): a BLOCKED sender's resend (M-S5).
fn tcpst_arm_tickretx() {
    if ((dm_read_rflags() & 0x200) == 0) { kprintln("tcp: tickretx FAIL if0", 22); return 0; }
    var ok = 1;
    var c = tcp_slot_claim(2, 0xEE12, 0xEE13, 0x7F000002, 0x3000, 0x4000, 0, 536, 0, 0x7F000001);
    if (c < 0) { return tcpst_verdict(0, "tickretx", 8); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x3000, 0x18, "T", 1);
    store64(cb + 32, 0x3001);
    store64(cb + 112, sched_clock_us() - 2000000);
    tcp_unlock(f);
    net_tick_resume();
    var k = 0;
    while (k < 5 && load64(cb + 120) < 1) { arch_wait(); k = k + 1; }
    net_tick_pause();
    if (load64(cb + 120) < 1) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "tickretx", 8);
}

# ticklo — a loopback datagram nobody polls for is delivered by net_tick's lo drain (M-S6).
fn tcpst_arm_ticklo() {
    if ((dm_read_rflags() & 0x200) == 0) { kprintln("tcp: ticklo FAIL if0", 20); return 0; }
    var ok = 1;
    var lid = udp_bind(0xEE20);
    if (lid < 0) { return tcpst_verdict(0, "ticklo", 6); }
    net_tick_resume();
    udp_send(0x7F000001, 0xEE21, 0xEE20, "TICKLO", 6);
    var k = 0;
    while (k < 5 && load64(udp_listener_base(lid) + 24) == 0) { arch_wait(); k = k + 1; }
    net_tick_pause();
    if (load64(udp_listener_base(lid) + 24) != 6) { ok = 0; }
    udp_unbind(lid);
    return tcpst_verdict(ok, "ticklo", 6);
}

# wndopen — an ACK that opens a zero window makes the held probe due now with count 0 (M-S4).
fn tcpst_arm_wndopen() {
    var ok = 1;
    var c = tcpst_fake(0xEE30, 0xEE31, 0);
    if (c < 0) { return tcpst_verdict(0, "wndopen", 7); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x1000, 0x18, "P", 1);
    store64(cb + 32, 0x1001);
    store64(cb + 88, 0);
    store64(cb + 120, 3);
    tcp_unlock(f);
    tcpst_inject(tcpst_setwnd(tcpst_frame(0xEE31, 0xEE30, 0x2000, 0x1000, 0x10, 0, 0), 1000));
    f = tcp_lock();
    var cnt = load64(cb + 120);
    var due = tcp_retx_due(cb, sched_clock_us());
    var w = load64(cb + 88);
    var armed = load64(cb + 128);
    tcp_unlock(f);
    if (cnt != 0 || due != 1 || w != 1000 || armed != 0x18) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "wndopen", 7);
}

# persist — a zero-window ACK that does not cover the held data segment caps the retry count (M-S7).
fn tcpst_arm_persist() {
    var ok = 1;
    var c = tcpst_fake(0xEE32, 0xEE33, 0);
    if (c < 0) { return tcpst_verdict(0, "persist", 7); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x1000, 0x18, "PERSIST!", 8);
    store64(cb + 32, 0x1008);
    store64(cb + 120, 5);
    tcp_unlock(f);
    tcpst_inject(tcpst_setwnd(tcpst_frame(0xEE33, 0xEE32, 0x2000, 0x1000, 0x10, 0, 0), 0));
    if (load64(cb + 120) != 4 || load64(cb + 128) != 0x18) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "persist", 7);
}

# partack — a partial ACK trims the held segment to the unACKed tail (M-TRIM).
fn tcpst_arm_partack() {
    var ok = 1;
    var c = tcpst_fake(0xEE34, 0xEE35, 0);
    if (c < 0) { return tcpst_verdict(0, "partack", 7); }
    var cb = tcp_conn_base(c);
    var i = 0;
    while (i < 100) { store8(&tcpst_pat + i, (i * 7 + 3) & 0xFF); i = i + 1; }
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x1000, 0x18, &tcpst_pat, 100);
    store64(cb + 32, 0x1064);
    store64(cb + 88, 8192);
    tcp_unlock(f);
    tcpst_inject(tcpst_frame(0xEE35, 0xEE34, 0x2000, 0x1028, 0x10, 0, 0));
    var rb = load64(cb + 136);
    if (load64(cb + 96) != 0x1028 || load64(cb + 104) != 60 || load64(cb + 56) != 0x1028) { ok = 0; }
    if (load64(cb + 128) != 0x18) { ok = 0; }
    if (load8(rb) != ((40 * 7 + 3) & 0xFF) || load8(rb + 59) != ((99 * 7 + 3) & 0xFF)) { ok = 0; }
    tcpst_inject(tcpst_frame(0xEE35, 0xEE34, 0x2000, 0x1064, 0x10, 0, 0));
    if (load64(cb + 128) != 0) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "partack", 7);
}

# wndstale — a reordered ACK older than SND.UNA does not overwrite the window (M-WSTALE).
fn tcpst_arm_wndstale() {
    var ok = 1;
    var c = tcpst_fake(0xEE36, 0xEE37, 0);
    if (c < 0) { return tcpst_verdict(0, "wndstale", 8); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    store64(cb + 56, 0x1064);
    store64(cb + 32, 0x1064);
    store64(cb + 88, 100);
    tcp_unlock(f);
    tcpst_inject(tcpst_setwnd(tcpst_frame(0xEE37, 0xEE36, 0x2000, 0x1000, 0x10, 0, 0), 5000));
    if (load64(cb + 88) != 100) { ok = 0; }
    tcpst_inject(tcpst_setwnd(tcpst_frame(0xEE37, 0xEE36, 0x2000, 0x1064, 0x10, 0, 0), 5000));
    if (load64(cb + 88) != 5000) { ok = 0; }
    tcpst_rel(c);
    return tcpst_verdict(ok, "wndstale", 8);
}

# ackwake — a sender BLOCKED directly in tcp_block (no loop-top poll) is woken by the ACK net_tick delivers, well
# before its 2 s deadline (M-S1). The covering ACK is PRE-ENQUEUED in lo; IF=0 from before the resume to the arm, so
# at -smp 1 no tick can deliver it early.
fn tcpst_arm_ackwake() {
    var ok = 1;
    var c = tcpst_fake(0xEE38, 0xEE39, 0);
    if (c < 0) { return tcpst_verdict(0, "ackwake", 7); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    store64(cb + 88, 1000);
    tcp_arm_retx(cb, 0x1000, 0x18, "A", 1);
    store64(cb + 32, 0x1001);
    var g = tcp_conn_gen_get(c);
    tcp_unlock(f);
    tcpst_drain();
    tcpst_lo(tcpst_frame(0xEE39, 0xEE38, 0x2000, 0x1001, 0x10, 0, 0));
    var sf = kbd_irq_save();
    net_tick_resume();
    var t0 = sched_clock_us();
    var r = tcp_block(c, 2, 0, 0, g, t0 + 2000000);
    var el = sched_clock_us() - t0;
    net_tick_pause();
    kbd_irq_restore(sf);
    if (r != 0 || el >= 500000 || load64(cb + 128) != 0) { ok = 0; }
    kprint("tcp: ackwake us=", 16); kprint_num(el); kprint(" r=", 3); kprint_num(r); kprintln("", 0);
    tcpst_rel(c);
    return tcpst_verdict(ok, "ackwake", 7);
}

# rstwake — a #47 waiter blocked in SYN_SENT is woken by the RST (M-RSTWAKE).
fn tcpst_arm_rstwake() {
    var ok = 1;
    var c = tcp_slot_claim(1, 0xEE3A, 0xEE3B, net_ip, 0x5000, 0, 0, 536, 0, net_ip);
    if (c < 0) { return tcpst_verdict(0, "rstwake", 7); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x5000, 0x02, 0, 0);
    store64(cb + 32, 0x5001);
    var g = tcp_conn_gen_get(c);
    tcp_unlock(f);
    tcpst_drain();
    tcpst_lo(tcpst_frame(0xEE3B, 0xEE3A, 0, 0, 0x04, 0, 0));
    var sf = kbd_irq_save();
    net_tick_resume();
    var t0 = sched_clock_us();
    var r = tcp_block(c, 1, 0, 0, g, t0 + 2000000);
    var el = sched_clock_us() - t0;
    net_tick_pause();
    kbd_irq_restore(sf);
    if (r != 0 || el >= 500000 || tcpst_st(c) != 0) { ok = 0; }
    kprint("tcp: rstwake us=", 16); kprint_num(el); kprintln("", 0);
    tcpst_rel(c);
    return tcpst_verdict(ok, "rstwake", 7);
}

# legacyif — net_legacy_step leaves IF exactly as it found it, post-scheduler, both ways (M-LEGIF).
fn tcpst_arm_legacyif() {
    var ok = 1;
    var sf = kbd_irq_save();
    net_legacy_step(NET_BUSY_SPINS);
    if ((dm_read_rflags() & 0x200) != 0) { ok = 0; }
    kbd_irq_restore(sf);
    if ((dm_read_rflags() & 0x200) == 0) { ok = 0; }          # the block runs IF=1
    net_legacy_step(NET_BUSY_SPINS);
    if ((dm_read_rflags() & 0x200) == 0) { ok = 0; }
    return tcpst_verdict(ok, "legacyif", 8);
}

# finretx — graceful close: the close body holds a kernel-owned FIN slot with the FIN armed and retransmitted, and it
# is released on (FIN ACKed + peer FIN), at once from LAST_ACK, on exhaustion, and TCP_FINWAIT2_US after the ACK
# (M-FIN1).
fn tcpst_arm_finretx() {
    var ok = 1;
    tcpst_drain();
    var c = tcpst_fake(0xEE40, 0xEE41, 16);                     # owned by the synthetic tag 16 (pid 15)
    if (c < 0) { return tcpst_verdict(0, "finretx", 7); }
    var cb = tcp_conn_base(c);
    var q0 = lo_count + lo_dropped;
    var nx = load64(cb + 32);
    if (tcp_close_own(c, 16) != 0) { ok = 0; }
    if (tcpst_st(c) != 3 || load64(cb + 152) != 0 || load64(cb + 48) != 0 || load64(cb + 128) != 0x11) { ok = 0; }
    if (load64(cb + 32) != ((nx + 1) & 0xFFFFFFFF)) { ok = 0; }
    if (lo_count + lo_dropped != q0 + 1) { ok = 0; }
    if (tcp_close_own(c, 16) != 0 - 1) { ok = 0; }             # the caller's id is dead at once
    var f = tcp_lock();
    store64(cb + 112, sched_clock_us() - 2000000);
    tcp_unlock(f);
    tcp_retx_tick();
    if (load64(cb + 120) != 1 || tcpst_st(c) != 3) { ok = 0; }
    tcpst_drain();
    tcpst_inject(tcpst_frame(0xEE41, 0xEE40, load64(cb + 40), (nx + 1) & 0xFFFFFFFF, 0x10, 0, 0));
    if (tcpst_st(c) != 3 || load64(cb + 128) != 0) { ok = 0; }  # FIN_WAIT_2
    var q1 = lo_count;
    tcpst_inject(tcpst_frame(0xEE41, 0xEE40, load64(cb + 40), (nx + 1) & 0xFFFFFFFF, 0x11, 0, 0));
    if (lo_count != q1 + 1 || tcpst_lo_byte(0, 47) != 0x10) { ok = 0; }   # the peer's FIN is ACKed
    if (tcpst_st(c) != 0) { ok = 0; }
    tcpst_drain();
    # From CLOSE_WAIT (LAST_ACK): the ACK of our FIN releases at once.
    var c2 = tcpst_fake(0xEE42, 0xEE43, 0);
    if (c2 < 0) { ok = 0; } else {
        var cb2 = tcp_conn_base(c2);
        tcpst_set_state(c2, 4);
        var nx2 = load64(cb2 + 32);
        tcp_close(c2);
        if (tcpst_st(c2) != 3 || (load64(cb2 + 72) & TCP_META_PEER_FIN) == 0) { ok = 0; }
        tcpst_inject(tcpst_frame(0xEE43, 0xEE42, load64(cb2 + 40), (nx2 + 1) & 0xFFFFFFFF, 0x10, 0, 0));
        if (tcpst_st(c2) != 0) { ok = 0; }
    }
    tcpst_drain();
    # Retransmit exhaustion.
    var c3 = tcpst_fake(0xEE44, 0xEE45, 0);
    if (c3 < 0) { ok = 0; } else {
        var cb3 = tcp_conn_base(c3);
        tcp_close(c3);
        f = tcp_lock();
        store64(cb3 + 120, TCP_RTO_RETRIES);
        store64(cb3 + 112, sched_clock_us() - 20000000);
        tcp_unlock(f);
        tcp_retx_tick();
        if (tcpst_st(c3) != 0 || load64(cb3 + 128) != 0) { ok = 0; }
    }
    tcpst_drain();
    # FIN_WAIT_2 timeout.
    var c4 = tcpst_fake(0xEE46, 0xEE47, 0);
    if (c4 < 0) { ok = 0; } else {
        var cb4 = tcp_conn_base(c4);
        var nx4 = load64(cb4 + 32);
        tcp_close(c4);
        tcpst_inject(tcpst_frame(0xEE47, 0xEE46, load64(cb4 + 40), (nx4 + 1) & 0xFFFFFFFF, 0x10, 0, 0));
        if (tcpst_st(c4) != 3 || load64(cb4 + 128) != 0) { ok = 0; }
        tcp_retx_tick();
        if (tcpst_st(c4) != 3) { ok = 0; }                     # not yet
        f = tcp_lock();
        store64(cb4 + 112, sched_clock_us() - 9000000);
        tcp_unlock(f);
        tcp_retx_tick();
        if (tcpst_st(c4) != 0) { ok = 0; }
    }
    tcpst_drain();
    return tcpst_verdict(ok, "finretx", 7);
}

# finfold — (1.57.7 ENDFIX, S6-R1) a close with a DATA segment still held (D6's return with the chunk in flight, a
# lifecycle ABORT, a kill blocked in #48) FOLDS the FIN into that segment (0x19): retx_seq, retx_len and SND.UNA are
# kept, SND.NXT gains the FIN's phantom byte. Re-arming a flag-only FIN over it treated the unACKed bytes as ACKed:
# never resent, the peer's RCV.NXT stuck below the FIN, no EOF. Then a partial ACK trims the data+FIN segment, the
# ACK of the data alone leaves the FIN held, the ACK of the FIN disarms, and the peer's FIN releases the slot.
fn tcpst_arm_finfold() {
    var ok = 1;
    tcpst_drain();
    var c = tcpst_fake(0xEE4A, 0xEE4B, 0);
    if (c < 0) { return tcpst_verdict(0, "finfold", 7); }
    var cb = tcp_conn_base(c);
    var i = 0;
    while (i < 100) { store8(&tcpst_pat + i, (i * 5 + 1) & 0xFF); i = i + 1; }
    var f = tcp_lock();
    tcp_arm_retx(cb, 0x1000, 0x18, &tcpst_pat, 100);
    store64(cb + 32, 0x1064);
    store64(cb + 88, 8192);
    tcp_unlock(f);
    var q0 = lo_count + lo_dropped;
    tcp_close(c);
    if (tcpst_st(c) != 3 || load64(cb + 128) != 0x19) { ok = 0; }
    if (load64(cb + 96) != 0x1000 || load64(cb + 104) != 100 || load64(cb + 56) != 0x1000) { ok = 0; }
    if (load64(cb + 32) != 0x1065) { ok = 0; }
    if (lo_count + lo_dropped != q0 + 1) { ok = 0; }            # the data+FIN segment went out
    tcpst_drain();
    tcpst_inject(tcpst_frame(0xEE4B, 0xEE4A, load64(cb + 40), 0x1028, 0x10, 0, 0));
    if (load64(cb + 96) != 0x1028 || load64(cb + 104) != 60 || load64(cb + 128) != 0x19) { ok = 0; }
    if (load8(load64(cb + 136)) != ((40 * 5 + 1) & 0xFF)) { ok = 0; }
    tcpst_inject(tcpst_frame(0xEE4B, 0xEE4A, load64(cb + 40), 0x1064, 0x10, 0, 0));
    if (load64(cb + 128) != 0x19 || load64(cb + 104) != 0 || load64(cb + 96) != 0x1064) { ok = 0; }   # FIN still held
    tcpst_inject(tcpst_frame(0xEE4B, 0xEE4A, load64(cb + 40), 0x1065, 0x10, 0, 0));
    if (load64(cb + 128) != 0 || tcpst_st(c) != 3) { ok = 0; }  # FIN ACKed: FIN_WAIT_2
    tcpst_inject(tcpst_frame(0xEE4B, 0xEE4A, load64(cb + 40), 0x1065, 0x11, 0, 0));
    if (tcpst_st(c) != 0) { ok = 0; }                           # the peer's FIN: released
    if (tcpst_st(c) != 0) { tcpst_rel(c); }
    tcpst_drain();
    return tcpst_verdict(ok, "finfold", 7);
}

# finboth — a real loopback pair closes from both sides: the second FIN is ACKed and both slots are released with no
# retransmit (M-FW2: releasing on any ACK leaves the server's FIN un-ACKed).
fn tcpst_arm_finboth() {
    var ok = 1;
    tcpst_drain();
    var l = tcp_listen(0xEE50);
    var c = 0 - 1;
    var a = 0 - 1;
    if (l >= 0) { c = tcp_connect(net_ip, 0xEE50, 0xEE51); }
    if (c >= 0) { a = tcp_accept(l); }
    if (a < 0) {
        ok = 0;
        if (c >= 0) { tcp_close(c); }
    } else {
        var cbc = tcp_conn_base(c);
        var cba = tcp_conn_base(a);
        tcp_close(c);
        net_poll();
        if (tcpst_st(a) != 4) { ok = 0; }
        if (tcpst_st(c) != 3 || load64(cbc + 128) != 0) { ok = 0; }
        tcp_close(a);
        var k = 0;
        while (k < 5 && (tcpst_st(c) != 0 || tcpst_st(a) != 0)) { net_poll(); k = k + 1; }
        if (tcpst_st(c) != 0 || tcpst_st(a) != 0) { ok = 0; }
        if (load64(cbc + 120) != 0 || load64(cba + 120) != 0) { ok = 0; }
    }
    if (l >= 0) { tcp_close(l); }
    tcpst_drain();
    return tcpst_verdict(ok, "finboth", 7);
}

# orphan — a held FIN slot never blocks a claim (M-ORPHAN), and the free count uses the claim's predicates: the
# orphan counts, an owned HELD state-0 slot does not (M-FREECOUNT).
fn tcpst_arm_orphan() {
    var ok = 1;
    tcpst_drain();
    var o = tcpst_fake(0xEE60, 0xEE61, 0);
    if (o < 0) { return tcpst_verdict(0, "orphan", 6); }
    tcp_close(o);
    tcpst_drain();
    var n = 0;
    var fr = 0;
    while (n < 8) {
        var lf = tcp_lock();
        fr = tcp_free_slots_locked();
        tcp_unlock(lf);
        if (fr <= 1) { break; }
        var ln = tcp_listen(0xEE70 + n);
        if (ln < 0) { break; }
        store64(&tcpst_ls + n * 8, ln);
        n = n + 1;
    }
    if (fr != 1 || tcpst_st(o) != 3) { ok = 0; }
    var nl = tcp_listen(0xEE7F);
    if (nl < 0 || nl != o) { ok = 0; }
    var h = 0 - 1;
    if (n > 0) {
        tcp_close(load64(&tcpst_ls + (n - 1) * 8));
        n = n - 1;
        h = tcp_slot_claim(2, 0xEE62, 0xEE63, net_ip, 1, 1, 0, 536, 16, net_ip);
        if (h < 0) { ok = 0; } else {
            tcpst_set_state(h, 0);                                  # an owned dead conn: HELD (S5 Q1)
            var hf = tcp_lock();
            fr = tcp_free_slots_locked();
            tcp_unlock(hf);
            if (fr != 0) { ok = 0; }
            tcpst_rel(h);
        }
    } else { ok = 0; }
    while (n > 0) { n = n - 1; tcp_close(load64(&tcpst_ls + n * 8)); }
    if (nl >= 0) { tcp_close(nl); }
    tcpst_drain();
    return tcpst_verdict(ok, "orphan", 6);
}

# connfail — every -1 exit of #47 after its claim releases the slot (state 0 AND tag 0): a RST, and a timeout (M-LEAK).
fn tcpst_arm_connfail() {
    var ok = 1;
    tcpst_drain();
    tcpst_lo(tcpst_frame(0xEE81, 0xEE80, 0, 0, 0x04, 0, 0));
    var r = tcp_connect_ex(net_ip, 0xEE81, 0xEE80, 16, 300000);
    var s1 = tcpst_find_lr(0xEE80, 0xEE81);
    if (r != 0 - 1 || s1 < 0) { ok = 0; } else {
        if (tcpst_st(s1) != 0 || load64(tcp_conn_base(s1) + 152) != 0) { ok = 0; }
    }
    tcpst_drain();
    var t0 = sched_clock_us();
    var r2 = tcp_connect_ex(net_ip, 0xEE83, 0xEE82, 16, 300000);
    var el = sched_clock_us() - t0;
    var s2 = tcpst_find_lr(0xEE82, 0xEE83);
    if (r2 != 0 - 1 || s2 < 0 || el < 300000) { ok = 0; } else {
        if (tcpst_st(s2) != 0 || load64(tcp_conn_base(s2) + 152) != 0) { ok = 0; }
    }
    kprint("tcp: connfail timeout us=", 25); kprint_num(el); kprintln("", 0);
    tcpst_drain();
    return tcpst_verdict(ok, "connfail", 8);
}

# stall — D6 + one-in-flight at entry: a call that finds an earlier segment unACKed waits for it (never sends over it)
# and returns 0 committed after the progress bound (M-S2).
fn tcpst_arm_stall() {
    var ok = 1;
    var c = tcp_slot_claim(2, 0xEE90, 0xEE91, 0x7F000002, 0x6000, 0x7000, 0, 536, 0, 0x7F000001);
    if (c < 0) { return tcpst_verdict(0, "stall", 5); }
    var cb = tcp_conn_base(c);
    var f = tcp_lock();
    store64(cb + 88, 8192);
    tcp_arm_retx(cb, 0x6000, 0x18, "H", 1);
    store64(cb + 32, 0x6001);
    tcp_unlock(f);
    var t0 = sched_clock_us();
    var r = tcp_send_ex(c, &tcpst_pat, 100, 0, 300000);
    var el = sched_clock_us() - t0;
    if (r != 0 || el < 300000 || el > 1000000) { ok = 0; }
    if (load64(cb + 32) != 0x6001 || load64(cb + 96) != 0x6000) { ok = 0; }
    kprint("tcp: stall us=", 14); kprint_num(el); kprint(" r=", 3); kprint_num(r); kprintln("", 0);
    tcpst_rel(c);
    tcpst_drain();
    return tcpst_verdict(ok, "stall", 5);
}

fn tcpst_s6_arms() {
    tcpst_arm_rebase();
    tcpst_arm_tickretx();
    tcpst_arm_ticklo();
    if (net_ip == 0) { kprintln("tcp: s6 SKIP (net_ip=0)", 23); return 0; }
    tcpst_arm_wndopen();
    tcpst_arm_persist();
    tcpst_arm_partack();
    tcpst_arm_wndstale();
    tcpst_arm_ackwake();
    tcpst_arm_rstwake();
    tcpst_arm_legacyif();
    tcpst_arm_finretx();
    tcpst_arm_finfold();
    tcpst_arm_finboth();
    tcpst_arm_orphan();
    tcpst_arm_connfail();
    tcpst_arm_stall();
    return 0;
}
#endif

#ifdef TCP_SELFTEST
# TCP receive-ring self-test (1.35.1 B1). Hermetic: builds a fake ESTABLISHED
# conn and exercises tcp_rx_append + tcp_recv for (a) FIFO byte order and
# (b) a buffer wrap, asserting byte-exact delivery. Proves the in-order ring
# that replaced the 1.32.0 overwrite-latest path (which silently truncated
# any multi-segment stream). Zero network dependency.
# 1.57.7 (S4): the fake slot is CLAIMED (tcp_slot_claim — the pool buffers, no kmalloc, no hand
# tcp_conn_count or state store) and RELEASED through tcp_slot_release_locked; every white-box cb write is
# made under tcp_lock. Arms 5-12 follow (fns above); `tcp: selftest done` is always the LAST line.
{
    net_tick_pause();                  # 1.57.7 (S6): no CPU's net_tick drains lo / retransmits under an arm (§2.2.3)
    var cid = tcp_slot_claim(2, 0xEEEE, 0xEEEE, 0, 0, 0, 0, 536, 0, net_ip);
    if (cid < 0) {
        kprintln("tcp: ring FAIL", 14);
        kprintln("tcp: retx FAIL", 14);
        kprintln("tcp: mss FAIL", 13);
        kprintln("tcp: wnd FAIL", 13);
    } else {
        var cb = tcp_conn_base(cid);
        var src[64];
        var dbuf[64];
        var ok = 1;
        var tsf = 0;

        # Phase 1 — FIFO order, no wrap: append 20 'A' then 20 'B', drain 40.
        memset(&src, 0x41, 20);
        tsf = tcp_lock();
        if (tcp_rx_append(cb, &src, 20) != 20) { ok = 0; }
        memset(&src, 0x42, 20);
        if (tcp_rx_append(cb, &src, 20) != 20) { ok = 0; }
        tcp_unlock(tsf);
        if (tcp_recv(cid, &dbuf, 40) != 40) { ok = 0; }
        if (load8(&dbuf + 0) != 0x41) { ok = 0; }
        if (load8(&dbuf + 19) != 0x41) { ok = 0; }
        if (load8(&dbuf + 20) != 0x42) { ok = 0; }
        if (load8(&dbuf + 39) != 0x42) { ok = 0; }

        # Phase 2 — wrap: reposition the cursors 8 bytes shy of the ring end,
        # append 32 'C' (8 land at the tail, 24 wrap to the head), drain 32.
        memset(&src, 0x43, 32);
        tsf = tcp_lock();
        store64(cb + 64, 2040); store64(cb + 80, 2040);
        if (tcp_rx_append(cb, &src, 32) != 32) { ok = 0; }
        tcp_unlock(tsf);
        if (tcp_recv(cid, &dbuf, 32) != 32) { ok = 0; }
        if (load8(&dbuf + 0) != 0x43) { ok = 0; }
        if (load8(&dbuf + 7) != 0x43) { ok = 0; }    # last byte before wrap
        if (load8(&dbuf + 8) != 0x43) { ok = 0; }    # first byte after wrap
        if (load8(&dbuf + 31) != 0x43) { ok = 0; }

        if (ok == 1) { kprintln("tcp: ring PASS", 14); }
        if (ok == 0) { kprintln("tcp: ring FAIL", 14); }

        # --- B2 retransmit logic (hermetic) ---
        var ok2 = 1;
        # RTO backoff (fixed base, ×2, capped at ×16).
        if (tcp_retx_rto(0) != 1000000) { ok2 = 0; }             # 1.57.7 (S6): µs
        if (tcp_retx_rto(1) != 2000000) { ok2 = 0; }
        if (tcp_retx_rto(4) != 16000000) { ok2 = 0; }
        if (tcp_retx_rto(5) != 16000000) { ok2 = 0; }
        # Arm sets the held-segment fields + pins SND.UNA.
        tsf = tcp_lock();
        tcp_arm_retx(cb, 12345, 0x18, &src, 10);
        tcp_unlock(tsf);
        if (load64(cb + 96) != 12345) { ok2 = 0; }    # retx_seq
        if (load64(cb + 104) != 10) { ok2 = 0; }       # retx_len
        if (load64(cb + 128) != 0x18) { ok2 = 0; }     # retx_flags armed
        if (load64(cb + 56) != 12345) { ok2 = 0; }     # SND.UNA pinned
        # Force the segment "due" (now - (now-2000) = 2000 ≥ RTO via modular
        # subtraction) and confirm a resend bumps the retry count.
        tsf = tcp_lock();
        store64(cb + 112, sched_clock_us() - 20000000);
        tcp_unlock(tsf);
        tcp_retx_tick();
        if (load64(cb + 120) != 1) { ok2 = 0; }        # one resend
        # At the retry cap, the next due tick declares the conn dead + disarms.
        tsf = tcp_lock();
        store64(cb + 120, TCP_RTO_RETRIES);
        store64(cb + 112, sched_clock_us() - 20000000);
        tcp_unlock(tsf);
        tcp_retx_tick();
        if (load64(cb) != 0) { ok2 = 0; }              # CLOSED
        if (load64(cb + 128) != 0) { ok2 = 0; }        # disarmed
        if (ok2 == 1) { kprintln("tcp: retx PASS", 14); }
        if (ok2 == 0) { kprintln("tcp: retx FAIL", 14); }

        # --- B3 MSS option emit + parse + effective-MSS (hermetic) ---
        var ok3 = 1;
        # Emit: write the option into src[0..3] and verify the bytes (1460 = 0x05B4).
        if (tcp_write_mss_opt(&src) != 4) { ok3 = 0; }
        if (load8(&src + 0) != 2) { ok3 = 0; }
        if (load8(&src + 1) != 4) { ok3 = 0; }
        if (load8(&src + 2) != 0x05) { ok3 = 0; }
        if (load8(&src + 3) != 0xB4) { ok3 = 0; }
        # Parse: a 24-byte header (20 zero + the MSS option) → 1460; a bare
        # 20-byte header (no options) → 0 (absent).
        memset(&dbuf, 0, 24);
        store8(&dbuf + 20, 2); store8(&dbuf + 21, 4);
        store8(&dbuf + 22, 0x05); store8(&dbuf + 23, 0xB4);
        if (tcp_parse_mss(&dbuf, 24) != 1460) { ok3 = 0; }
        if (tcp_parse_mss(&dbuf, 20) != 0) { ok3 = 0; }
        # Effective MSS: clamp to ours, default when absent, honor a smaller peer.
        if (tcp_eff_mss(1460) != 1460) { ok3 = 0; }
        if (tcp_eff_mss(0) != 536) { ok3 = 0; }
        if (tcp_eff_mss(1000) != 1000) { ok3 = 0; }
        if (tcp_eff_mss(9000) != 1460) { ok3 = 0; }
        if (ok3 == 1) { kprintln("tcp: mss PASS", 13); }
        if (ok3 == 0) { kprintln("tcp: mss FAIL", 13); }

        # --- B4 peer-window send-chunk sizing (hermetic) ---
        var ok4 = 1;
        if (tcp_send_chunk(100, 1460, 65535) != 100) { ok4 = 0; }    # remaining-bound
        if (tcp_send_chunk(5000, 1460, 65535) != 1460) { ok4 = 0; }  # MSS-bound
        if (tcp_send_chunk(100, 1460, 30) != 30) { ok4 = 0; }        # window-bound
        if (tcp_send_chunk(100, 1460, 0) != 1) { ok4 = 0; }          # zero-window persist
        # Release through the discipline: CLOSED, rx ring unbound, the retx hold buffer still the pool's.
        tsf = tcp_lock();
        tcp_slot_release_locked(cid);
        tcp_unlock(tsf);
        if (load64(cb) != 0 || load64(cb + 48) != 0) { ok4 = 0; }
        if (load64(cb + 136) != load64(&tcp_pool_retx + cid * 8)) { ok4 = 0; }
        if (ok4 == 1) { kprintln("tcp: wnd PASS", 13); }
        if (ok4 == 0) { kprintln("tcp: wnd FAIL", 13); }
    }
    tcpst_arm_locks();
    tcpst_arm_loinplace();
    tcpst_arm_txslots();
    tcpst_arm_claim();
    tcpst_arm_gen();
    tcpst_arm_syncap();
    tcpst_arm_eof();
    tcpst_arm_halfclose();
    tcpst_s6_arms();
    net_tick_resume();
    kprintln("tcp: selftest done", 18);
}
#endif

#ifdef NTP_SELFTEST
# NTP parse self-test (1.35.x). Hermetic: a synthetic SNTP response whose
# Transmit Timestamp (offset 40) = NTP 3913056000 must parse to Unix
# 1704067200 (2024-01-01 00:00:00 UTC, via the 1900→1970 epoch delta), and a
# +3661 s value must break down to 01:01:01 UTC. Zero network dependency.
{
    var resp[48];
    var i = 0;
    while (i < 48) { store8(&resp + i, 0); i = i + 1; }
    store8(&resp, 0x1C);   # LI=0 VN=3 Mode=4 (server) — realistic, not checked here
    store8(&resp + 40, (3913056000 >> 24) & 0xFF);
    store8(&resp + 41, (3913056000 >> 16) & 0xFF);
    store8(&resp + 42, (3913056000 >> 8) & 0xFF);
    store8(&resp + 43, 3913056000 & 0xFF);
    var ok = 1;
    if (ntp_parse_unix(&resp) != 1704067200) { ok = 0; }
    var t = 1704070861;            # 1704067200 + 3661 s
    var tod = t % 86400;
    if (tod / 3600 != 1) { ok = 0; }
    if ((tod % 3600) / 60 != 1) { ok = 0; }
    if (tod % 60 != 1) { ok = 0; }
    if (ok == 1) { kprintln("ntp: parse PASS", 15); }
    if (ok == 0) { kprintln("ntp: parse FAIL", 15); }
}
#endif

#ifdef USERWIN_SELFTEST
user_window_selftest();
#endif
#ifdef DHCP_OPT_SELFTEST
dhcpopt_selftest();
#endif
#ifdef MMAP_SELFTEST
# Anonymous-mmap allocator self-test (1.35.3). Hermetic: exercises the new
# 2 MB-contiguous allocator (pmm_alloc_2mb / _free_2mb / _count) + the mmap
# length-rounding. The full sys_mmap map-into-process path reuses the iron-
# proven proc_map_page idiom (no live user proc at boot to drive it directly).
{
    var ok = 1;
    var before = pmm_count_2mb_free();
    var a = pmm_alloc_2mb();
    if (a == 0) { ok = 0; }
    if ((a & 0x1FFFFF) != 0) { ok = 0; }           # 2 MB-aligned
    var b = pmm_alloc_2mb();
    if (b == 0) { ok = 0; }
    if ((b & 0x1FFFFF) != 0) { ok = 0; }
    if (a == b) { ok = 0; }                          # distinct regions
    var d = a - b;
    if (d < 0) { d = 0 - d; }
    if (d < 0x200000) { ok = 0; }                    # non-overlapping (>= 2 MB apart)
    if (pmm_count_2mb_free() != before - 2) { ok = 0; }
    pmm_free_2mb(a);
    pmm_free_2mb(b);
    if (pmm_count_2mb_free() != before) { ok = 0; }  # frees restore the count
    # mmap length-rounding (the sys_mmap formula): 4 KB→2 MB, 2 MB→2 MB, +1→4 MB.
    if (((4096 + 0x1FFFFF) & 0xFFFFFFFFFFE00000) != 0x200000) { ok = 0; }
    if (((0x200000 + 0x1FFFFF) & 0xFFFFFFFFFFE00000) != 0x200000) { ok = 0; }
    if (((0x200001 + 0x1FFFFF) & 0xFFFFFFFFFFE00000) != 0x400000) { ok = 0; }
    if (ok == 1) { kprintln("mmap: pmm2mb PASS", 17); }
    if (ok == 0) { kprintln("mmap: pmm2mb FAIL", 17); }
}
# munmap self-test (1.35.4). Hermetic: the pmm_free_2mb guards sys_munmap leans
# on (reject misaligned / kernel-region / out-of-range) + an alloc→free→alloc
# reuse round-trip (freed physical must be allocatable again — the core munmap
# value). The full sys_munmap PD-walk + proc_unmap_page + invlpg path rides
# those proven primitives (no live user proc at boot to drive a real unmap).
{
    var m = 1;
    if (pmm_free_2mb(0x201000) == 0) { m = 0; }        # page 513 — not 2 MB-aligned → reject
    if (pmm_free_2mb(0x0) == 0) { m = 0; }             # kernel region (base 0 < 512) → reject
    # Out-of-range guard: was pmm_free_2mb(0x1000000) (16 MB) expecting a ">= pool" reject, but the 2 MB
    # pool grew from 16 MB to 256 MB+ (now the full machine RAM) so 16 MB is IN-pool. Use 64 GB — above
    # the bitmap's 64 GB cap, so base >= pmm_bitmap_pages always holds → reject.
    if (pmm_free_2mb(0x1000000000) == 0) { m = 0; }    # 64 GB — base ≥ bitmap → out-of-range reject
    var c0 = pmm_count_2mb_free();
    var x = pmm_alloc_2mb();
    if (x == 0) { m = 0; }
    pmm_free_2mb(x);
    if (pmm_count_2mb_free() != c0) { m = 0; }         # free restored the count
    var y = pmm_alloc_2mb();
    if (y == 0) { m = 0; }                             # reusable after free
    pmm_free_2mb(y);
    if (pmm_count_2mb_free() != c0) { m = 0; }
    if (m == 1) { kprintln("munmap: pmm-reuse PASS", 22); }
    if (m == 0) { kprintln("munmap: pmm-reuse FAIL", 22); }
}
#endif

#ifdef MMAP_HIMEM_SELFTEST
# Hermetic chain-verification of proc_map_page_hi (high user mmap arena, 1.50.2
# bite 1a). Builds a throwaway per-process address space, maps two SIBLING 128 GB
# VAs, and walks PML4->PDPT->PD to assert: the on-demand PDPT[128] entry came up
# present+user (the alloc-PD-on-miss path), the sibling reuses the SAME PD (one PD
# per 1 GB, no re-shatter), and each PDE is present+user+2MB+correct-phys. NOT wired
# into sys_mmap yet (bite 1b) — proves the mapper in isolation. Teardown of the high
# PDs is bite 1b, so this leaks the test AS + its one PD (acceptable one-shot); the
# two 2 MB data pages are returned. No CR3 switch — purely a structural page-walk via
# identity (all tables are pmm_alloc'd <=256 MB).
{
    var ok = 1;
    var cr3 = proc_create_address_space();
    if (cr3 == 0) { ok = 0; }
    var hva = 0x2000000000;                              # 128 GB — PDPT index 128
    var p1 = pmm_alloc_2mb();
    var p2 = pmm_alloc_2mb();
    if (p1 == 0) { ok = 0; }
    if (p2 == 0) { ok = 0; }
    if (cr3 != 0) {
        if (proc_map_page_hi(cr3, hva, p1) != 0) { ok = 0; }
        if (proc_map_page_hi(cr3, hva + 0x200000, p2) != 0) { ok = 0; }
        var pml4e = load64(pmm_kva_for_access(cr3));      # 1.56.51: direct-map walk
        var pdpt = pml4e & 0xFFFFFFFFF000;
        var pdpte = load64(pmm_kva_for_access(pdpt) + ((hva >> 30) & 0x1FF) * 8);
        if ((pdpte & 1) == 0) { ok = 0; }                # PDPT[128] present (on-demand alloc worked)
        if ((pdpte & 4) == 0) { ok = 0; }                # user
        var pd = pdpte & 0xFFFFFFFFF000;
        var pd_kva = pmm_kva_for_access(pd);
        var pde1 = load64(pd_kva + ((hva >> 21) & 0x1FF) * 8);
        if ((pde1 & 1) == 0) { ok = 0; }                 # present
        if ((pde1 & 4) == 0) { ok = 0; }                 # user
        if ((pde1 & 0x80) == 0) { ok = 0; }              # 2 MB page
        if ((pde1 & 0x000FFFFFFFE00000) != (p1 & 0x000FFFFFFFE00000)) { ok = 0; }   # correct phys (NX bit 63 masked out)
        if ((pde1 & 0x8000000000000000) == 0) { ok = 0; }                          # 1.50.5: NX set (W^X — anon arena is non-executable)
        var pde2 = load64(pd_kva + (((hva + 0x200000) >> 21) & 0x1FF) * 8);
        if ((pde2 & 0x000FFFFFFFE00000) != (p2 & 0x000FFFFFFFE00000)) { ok = 0; }   # sibling reused same PD
    }
    if (p1 != 0) { pmm_free_2mb(p1); }
    if (p2 != 0) { pmm_free_2mb(p2); }
    if (ok == 1) { kprintln("mmap-himem: chain PASS", 22); }
    if (ok == 0) { kprintln("mmap-himem: chain FAIL", 22); }
}
#endif

#ifdef MMAP_HIMEM_E2E_SELFTEST
# End-to-end (1.50.2 bite 1b): a >1 GB CONTIGUOUS high-arena allocation + teardown.
# Maps 513 sibling 2 MB pages (1.026 GB) at 128 GB via proc_map_page_hi — spanning
# PDPT[128] (512 pages) AND PDPT[129] (1 page), proving the >768 MB single-process
# cap is lifted and on-demand PD alloc works ACROSS a PDPT boundary — then tears the
# whole address space down (proc_free_address_space) and asserts the 2 MB free-count
# is restored (the leak fix). Gated on >=600 free regions so it SKIPS cleanly at
# small -m (boot at -m 4G to exercise it). Frees the test AS, so no leak.
{
    var e = 1;
    var before = pmm_count_2mb_free();
    if (before < 600) {
        kprintln("mmap-himem-e2e: skip (<1.2GB free)", 34);
    } else {
        var cr3 = proc_create_address_space();
        if (cr3 == 0) { e = 0; }
        var hva = 0x2000000000;                          # 128 GB
        var n = 513;                                     # 1.026 GB — spans PDPT[128] + PDPT[129]
        var mapped = 0;
        var bad = 0;
        if (cr3 != 0) {
            for (var k = 0; k < n; k = k + 1) {
                if (bad == 0) {
                    var ph = pmm_alloc_2mb();
                    if (ph == 0) { bad = 1; }
                    else {
                        if (proc_map_page_hi(cr3, hva + k * 0x200000, ph) != 0) { bad = 1; }
                        else { mapped = mapped + 1; }
                    }
                }
            }
        }
        if (bad != 0) { e = 0; }
        if (mapped != n) { e = 0; }
        if (pmm_count_2mb_free() != before - n) { e = 0; }    # all n actually allocated
        if (cr3 != 0) {
            var pml4e = load64(pmm_kva_for_access(cr3));          # 1.56.51: direct-map walk
            var pdpt_kva = pmm_kva_for_access(pml4e & 0xFFFFFFFFF000);
            if ((load64(pdpt_kva + 128 * 8) & 0x05) != 0x05) { e = 0; }   # PDPT[128] present + user
            if ((load64(pdpt_kva + 129 * 8) & 0x05) != 0x05) { e = 0; }   # PDPT[129] present + user (boundary)
            proc_free_address_space(cr3);                              # teardown: frees high PDs + pages
        }
        if (pmm_count_2mb_free() != before) { e = 0; }        # teardown restored the count → no leak
        if (e == 1) { kprintln("mmap-himem-e2e: >1GB map+free PASS", 34); }
        if (e == 0) { kprintln("mmap-himem-e2e: >1GB map+free FAIL", 34); }
    }
}
#endif

#ifdef MMAP_HIMUNMAP_SELFTEST
# Hermetic test of the HIGH-arena munmap path (1.50.3 proc_unmap_2mb_hi). Maps 4
# high pages, unmaps the middle two, asserts the 2 MB free-count rose by exactly 2,
# the unmapped PDEs are cleared while the kept ones stay present, and re-unmapping is
# idempotent (returns 0); then tears the AS down and asserts the count is fully
# restored. Only 8 MB — runs at any -m. Drives the helpers directly (no proc context).
{
    var u = 1;
    var before = pmm_count_2mb_free();
    var cr3 = proc_create_address_space();
    if (cr3 == 0) { u = 0; }
    var hva = 0x2000000000;
    var p0 = pmm_alloc_2mb();
    var p1 = pmm_alloc_2mb();
    var p2 = pmm_alloc_2mb();
    var p3 = pmm_alloc_2mb();
    if (p0 == 0) { u = 0; }
    if (p1 == 0) { u = 0; }
    if (p2 == 0) { u = 0; }
    if (p3 == 0) { u = 0; }
    if (cr3 != 0) {
        proc_map_page_hi(cr3, hva, p0);
        proc_map_page_hi(cr3, hva + 0x200000, p1);
        proc_map_page_hi(cr3, hva + 0x400000, p2);
        proc_map_page_hi(cr3, hva + 0x600000, p3);
        if (pmm_count_2mb_free() != before - 4) { u = 0; }       # 4 allocated
        if (proc_unmap_2mb_hi(cr3, hva + 0x200000) != 1) { u = 0; }   # unmap page 1
        if (proc_unmap_2mb_hi(cr3, hva + 0x400000) != 1) { u = 0; }   # unmap page 2
        if (pmm_count_2mb_free() != before - 2) { u = 0; }       # 2 freed back
        var pml4e = load64(pmm_kva_for_access(cr3));      # 1.56.51: direct-map walk
        var pd = load64(pmm_kva_for_access(pml4e & 0xFFFFFFFFF000) + 128 * 8) & 0xFFFFFFFFF000;
        var pd_kva = pmm_kva_for_access(pd);
        if ((load64(pd_kva + 0 * 8) & 0x01) == 0) { u = 0; }     # page 0 still present
        if ((load64(pd_kva + 1 * 8) & 0x01) != 0) { u = 0; }     # page 1 cleared
        if ((load64(pd_kva + 2 * 8) & 0x01) != 0) { u = 0; }     # page 2 cleared
        if ((load64(pd_kva + 3 * 8) & 0x01) == 0) { u = 0; }     # page 3 still present
        if (proc_unmap_2mb_hi(cr3, hva + 0x200000) != 0) { u = 0; }   # idempotent re-unmap
        proc_free_address_space(cr3);                            # frees pages 0,3 + the PD
    }
    if (pmm_count_2mb_free() != before) { u = 0; }               # teardown restored everything
    if (u == 1) { kprintln("mmap-himunmap: PASS", 19); }
    if (u == 0) { kprintln("mmap-himunmap: FAIL", 19); }
}
#endif

#ifdef MMAP_HIMEM_PERPROC_SELFTEST
# Hermetic test of the PER-PROCESS high cursor (1.50.4 himmap_reserve). Each pid has
# its OWN bump cursor (proc_himmap_next[pid]), so two processes both start at 128 GB
# independently — that's what stops a long-lived multi-proc system from globally
# exhausting the arena. Uses scratch pids 14/15 (reset before + after, so no real proc
# is perturbed; 0 = lazy-init to base). Pure cursor arithmetic — no allocation.
{
    var c = 1;
    store64(&proc_himmap_next + 14 * 8, 0);
    store64(&proc_himmap_next + 15 * 8, 0);
    var a14 = himmap_reserve(14, 0x200000);              # pid 14: first 2 MB
    var a15 = himmap_reserve(15, 0x400000);              # pid 15: first 4 MB — INDEPENDENT
    var a14b = himmap_reserve(14, 0x200000);             # pid 14: advances by its own 2 MB
    if (a14 != 0x2000000000) { c = 0; }                  # base
    if (a15 != 0x2000000000) { c = 0; }                  # pid 15 ALSO starts at base, not after pid 14
    if (a14b != 0x2000200000) { c = 0; }                 # pid 14 advanced by 2 MB only
    store64(&proc_himmap_next + 14 * 8, 0x7FFFE00000);   # 512 GB - 2 MB (near ceiling)
    if (himmap_reserve(14, 0x400000) != 0) { c = 0; }    # +4 MB passes 512 GB -> exhausted -> 0
    if (himmap_reserve(16, 0x200000) != 0) { c = 0; }    # bad pid -> 0
    store64(&proc_himmap_next + 14 * 8, 0);
    store64(&proc_himmap_next + 15 * 8, 0);
    if (c == 1) { kprintln("mmap-himem-perproc: PASS", 24); }
    if (c == 0) { kprintln("mmap-himem-perproc: FAIL", 24); }
}
#endif

# (1.57.7 S7: the PPID_SELFTEST block moved into ktest's [lifecycle] section — test_lifecycle, kernel/user/test.cyr
# T-L2/T-L7 — and the flag was deleted: a hand-run gate is not a gate.)

#ifdef RTC_SELFTEST
# RTC boot-clock self-test (1.35.5). Hermetic civil_to_unix anchors (shared with
# the NTP test) + BCD decode, plus a live-bounded rtc_read_unix() sanity check
# (QEMU's emulated CMOS returns the host time, so assert a plausible epoch only).
{
    var ok = 1;
    if (civil_to_unix(1970, 1, 1, 0, 0, 0) != 0)          { ok = 0; }   # epoch
    if (civil_to_unix(2024, 1, 1, 0, 0, 0) != 1704067200) { ok = 0; }   # 2024-01-01 00:00:00
    if (civil_to_unix(2024, 1, 1, 1, 1, 1) != 1704070861) { ok = 0; }   # +3661 s
    if (civil_to_unix(2024, 3, 1, 0, 0, 0) != 1709251200) { ok = 0; }   # leap-year boundary
    if (rtc_bcd(0x59) != 59) { ok = 0; }
    if (rtc_bcd(0x00) != 0)  { ok = 0; }
    if (rtc_bcd(0x99) != 99) { ok = 0; }
    var live = rtc_read_unix();
    if (live < 1577836800) { ok = 0; }                     # > 2020-01-01: read path works
    if (ok == 1) { kprintln("rtc: clock PASS", 15); }
    if (ok == 0) { kprintln("rtc: clock FAIL", 15); }
}
#endif

#ifdef JBD2_TX_SELFTEST
# 1.38.4 in-memory transaction lifecycle self-test. Exercises
# begin_tx / log_metadata / commit_tx + the negative paths (nested begin,
# log-without-begin, commit-without-begin). NOTE: with 1.38.5's real write
# path in commit_tx, this selftest now also exercises a real commit —
# logging a pointer to ext2_jbd2_data_buf to dummy target blocks 100/101/102
# (high free blocks on a fresh mkfs.ext4 67 MiB partition). For an isolated
# end-to-end write check on real source data, use JBD2_WP_SELFTEST=1 below.
ext2_jbd2_tx_selftest();
#endif

#ifdef JBD2_WP_SELFTEST
# 1.38.5 write-path end-to-end selftest. Reads a known-safe high FS
# block (300), logs it back via begin/log/commit (no-op data write), and
# calls ext2_sync at end so the smoke's host-side e2fsck sees a cleanly-
# unmounted FS. Validates the descriptor + data + commit + barrier +
# checkpoint + SB-clean sequence end-to-end.
ext2_jbd2_writepath_selftest();
#endif

#ifdef JBD2_INT_SELFTEST
# 1.38.6 integration selftest. Proves the metadata-write routing works:
# opens a tx → reads root inode (2) → calls put_inode (which routes its
# inode-table write through ext2_jbd2_log_metadata because the tx is
# active) → verifies tx_count incremented → commits + syncs. The smoke
# gates the "put_inode routed through journal" line — its presence proves
# the integration intercepted what would otherwise have been a direct write.
ext2_jbd2_integration_selftest();
#endif

#ifdef JBD2_CRASH_SELFTEST
# 1.38.7 crash-stress selftest. Runs 100 real put_inode commits over a
# ~3-second window (rdtsc busy-wait between iterations) so the companion
# jbd2-crash-smoke.sh can SIGKILL QEMU at varied points within the window
# and validate that AGNOS's replay on next boot leaves the FS host-e2fsck
# clean regardless of where the kill landed.
ext2_jbd2_crash_selftest();
#endif

#ifdef HARDENING_SELFTEST
# Arc-close hardening self-test (1.35.7 pass 1). Hermetic table over
# ip_safe_payload_len — the ingress clamp that stops a forged IPv4 total-length
# from over-reading net_rx_pkt across the ICMP/UDP/TCP handlers.
{
    var ok = 1;
    if (ip_safe_payload_len(84, 20, 84) != 64)         { ok = 0; }  # valid: total=84 ihl=20 -> 64
    if (ip_safe_payload_len(40, 20, 40) != 20)         { ok = 0; }  # exact-fit boundary
    if (ip_safe_payload_len(28, 20, 60) != 8)          { ok = 0; }  # padded frame (total < avail) untouched
    if (ip_safe_payload_len(65535, 20, 60) != 40)      { ok = 0; }  # forged total > avail -> clamp to 60 -> 40
    if (ip_safe_payload_len(84, 16, 84) != (0 - 1))    { ok = 0; }  # ihl < 20 -> reject
    if (ip_safe_payload_len(84, 0, 84) != (0 - 1))     { ok = 0; }  # ihl 0 -> reject
    if (ip_safe_payload_len(10, 20, 84) != (0 - 1))    { ok = 0; }  # total < ihl -> reject
    if (ip_safe_payload_len(1000, 60, 40) != (0 - 1))  { ok = 0; }  # truncated: ihl 60 claimed, 40 received
    if (ok == 1) { kprintln("hardening: ip-clamp PASS", 24); }
    if (ok == 0) { kprintln("hardening: ip-clamp FAIL", 24); }
}
#endif

#ifdef TCP_LISTEN_SMOKE
# TCP server-side smoke → PERSISTENT HTTP listener (rewritten 1.45.x).
#
# History: this was a 1.32.0-era ~8 s one-shot raw-banner probe whose banner was
# frozen at the literal "AGNOS 1.32.1" with a hardcoded 30-byte send length —
# stale by 13 minor versions, and the window was far too short for a human or a
# load generator to actually reach. The accept path itself is proven: the
# agnosticos docker net-sweep harness (host → docker → qemu/SLIRP → guest) gets
# the banner back, so LISTEN → SYN → SYN_RCVD → ESTABLISHED → accept → send →
# close all work under SLIRP, not only on iron. (The old "doesn't pass under
# SLIRP" note here was wrong / stale — net-sweep disproved it.)
#
# Now: a long-lived HTTP/1.0 server. Serves for as long as the box is up (the
# qemu timeout or a power-cycle ends it), net_poll()-ing every spin so ARP
# replies + ICMP echo stay answered too — the box is pingable AND curl-able the
# whole time. Banner is version-derived (_AGNOS_VERSION); every length is
# strlen-computed, never a literal. Build-flag-gated, so production is untouched.
{
    var m_start = "tcp_listen smoke: start";
    kprintln(m_start, strlen(m_start));
    # Gratuitous ARP up front so the switch / peer learns our MAC for inbound
    # delivery (helps SLIRP hostfwd + real-LAN; harmless if ignored).
    arp_request(net_ip);
    var lid = tcp_listen(8080);
    var m_lid = "tcp_listen(8080) lid=";
    kprint(m_lid, strlen(m_lid));
    kprint_num(lid);
    kprintln("", 0);
    if (lid >= 0) {
        var m_serv = "http: serving :8080 (persistent) -- curl + ping live";
        kprintln(m_serv, strlen(m_serv));
        var served = 0;
        # Serve forever: a human-driven curl, a load generator, or the docker
        # net-sweep harness can all reach us; harness qemu-timeout / power ends it.
        while (1 == 1) {
            net_poll();
            var c = tcp_accept(lid);
            if (c >= 0) {
                var m_acc = "tcp_accept: conn_id=";
                kprint(m_acc, strlen(m_acc));
                kprint_num(c);
                kprintln("", 0);
                # Minimal HTTP/1.0 200 so `curl http://<ip>:8080` returns a body
                # and closes. Version-derived + strlen-sized — no stale literal,
                # no hardcoded send length (the two bugs the old banner had).
                var hdr = "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nAGNOS ";
                var tail = " tcp_listen smoke\n";
                var ver = agnos_version_str();   # program-body-safe (not the gvar)
                tcp_send(c, hdr, strlen(hdr));
                tcp_send(c, ver, strlen(ver));
                tcp_send(c, tail, strlen(tail));
                tcp_close(c);
                served = served + 1;
                var m_served = "http: served conn=";
                kprint(m_served, strlen(m_served));
                kprint_num(served);
                kprintln("", 0);
            }
            arch_wait();
        }
    }
    var m_end = "tcp_listen smoke: done";
    kprintln(m_end, strlen(m_end));
}
#endif

# (1.57.7: the FLOCK_SELFTEST block that lived here is retired — its table asserts are ktest T9 (sched.cyr test_flock),
# which also covers the 1.57.7 codes: -2 table full, the blocking-conversion drop, the NB-conversion keep.)

#ifdef WINSIZE_SELFTEST
# winsize#60 console-grid math (1.45.13). Reads the LIVE framebuffer geometry (FB
# is up by the time selftests run — kprintln paints the console) and asserts
# fb_winsize() packs (cols<<16 | rows) matching fb_putc's own cell math
# (cols = w/(8*s), rows = (h - FB_CONSOLE_Y0)/(16*s)). Prints the grid so the
# QEMU/iron smoke can eyeball it against the known resolution. Compile-gated:
# WINSIZE_SELFTEST=1 sh scripts/build.sh.
{
    var ws_w = fb_width();
    var ws_h = fb_height();
    var ws_s = fb_scale();
    var ws_exp_cols = ws_w / (8 * ws_s);
    var ws_exp_rows = (ws_h - FB_CONSOLE_Y0) / (16 * ws_s);
    var ws_packed = fb_winsize();
    var ws_got_cols = (ws_packed >> 16) & 0xFFFF;
    var ws_got_rows = ws_packed & 0xFFFF;
    var wok = 1;
    if (ws_packed < 0) { wok = 0; }
    if (ws_got_cols != ws_exp_cols) { wok = 0; }
    if (ws_got_rows != ws_exp_rows) { wok = 0; }
    if (ws_got_cols <= 0) { wok = 0; }
    if (ws_got_rows <= 0) { wok = 0; }
    var ws_m = "winsize: cols=";
    kprint(ws_m, strlen(ws_m));
    kprint_num(ws_got_cols);
    var ws_m2 = " rows=";
    kprint(ws_m2, strlen(ws_m2));
    kprint_num(ws_got_rows);
    kprintln("", 0);
    if (wok == 1) {
        var ws_pass = "winsize: ALL PASS";
        kprintln(ws_pass, strlen(ws_pass));
    }
    if (wok == 0) {
        var ws_fail = "winsize: FAIL";
        kprintln(ws_fail, strlen(ws_fail));
    }
}
#endif

#ifdef SPAWN_SELFTEST
# ── 1.57.6 — spawn_path#43 / execwait#37 / exec_redirect#62 / CH_ENDOW / pipe-lifetime: the PURE checks ──
# (issues 2026-09-23-child-inherits-every-fd-and-spawn-arms-leak, -spawn-path-args-cannot-contain-spaces,
#  -spawn-path-failure-gives-no-reason). The RING-3 half — children that actually run concurrently, capture,
# CLEANFD, argv round trips, the table-full code, pipe crosstalk — is tests/spawn/spawnx.cyr seeded as
# /bin/agnsh on a PLAIN kernel; both are driven by scripts/smoke/spawn-smoke.sh.
# ⛔ RUNS HERE, AFTER THE PROC-TABLE BOOTSTRAP, AND THAT IS LOAD-BEARING: before it, the boot context is
# pid 0 and proc_alloc_slot hands the first slot out as 0 too (the degenerate case the slot-reuse guard
# exists for), so "per-process isolation" could not be told from "one pid". Here proc 0 is registered and
# a freshly allocated slot is >= 1.
# ⚠ The scheduler is live (sched_active = 1) and APs may be scheduling under -smp > 1. The pipe-lifetime
# checks therefore run with interrupts OFF on this CPU and assert on the SPECIFIC freed addresses (walking
# the slab free list), never on a global free counter another CPU could move.
# ⚠ ksyscall from kernel context runs under the boot CR3, where is_user_range takes its documented
# exemption and proc_copy_from_user (which requires USER pages) refuses — so the SPAWN_F_ARGV positive
# path is ring 3's to prove; here only the refusals that precede the copy are driven.
fn spk(s) { kprintln(s, strlen(s)); return 0; }
fn spk_num(s, n) { kprint(s, strlen(s)); kprint_num(n); kprintln("", 0); return 0; }
# How many times does `ptr` appear on the slab free list of `size`'s class? 0 = not freed, 1 = freed once,
# anything more = a DOUBLE FREE (the second push makes the block point at itself; the walk is bounded).
fn spawnk_fl_count(ptr, size) {
    var fcls = slab_class_for(size);
    if (fcls < 0) { return 0 - 1; }
    heap_spin_lock();
    var fp = load64(&slab_free + fcls * 8);
    var fcount = 0;
    var fsteps = 0;
    while (fp != 0) {
        if (fsteps >= 100000) { break; }
        if (fp == ptr) { fcount = fcount + 1; }
        fp = load64(fp);
        fsteps = fsteps + 1;
    }
    heap_spin_unlock();
    return fcount;
}
fn spawnk_arms_empty(pid) {
    if (redir_n_get(pid) != 0) { return 0; }
    if (endow_arm_get(pid) >= 0) { return 0; }
    if (endow_stdio_get(pid) != 0) { return 0; }
    return 1;
}
# Arm pid 0 with a redirect (1 <- 2) AND an endowment of `fb` (PTY mode when stdio != 0). -> 1 armed.
fn spawnk_arm(fb, stdio) {
    ksyscall(62, 0x200, 0, 0);                         # REDIR_CLEAR first — start from a known set
    ksyscall_a4_set(0);
    if (stdio != 0) { ksyscall_a4_set(CH_ENDOW_STDIO); }
    var af = ksyscall(97, CH_ENDOW, fb, 0);
    ksyscall_a4_set(0);
    if (af < 3) { return 0; }
    if (ksyscall(62, 1, 2, 0) != 0) { return 0; }
    if (redir_n_get(0) != 1) { return 0; }
    if (endow_arm_get(0) < 0) { return 0; }
    return 1;
}
# Copy a literal into the user-window scratch so the arm's sc_path_ok sees a real window address.
fn spawnk_put(dst, s) {
    var pl = strlen(s);
    var pi = 0;
    while (pi < pl) { store8(dst + pi, load8(s + pi)); pi = pi + 1; }
    return pl;
}
# #43 from kernel context with a4 (the env length) zeroed. -> the arm's return value.
fn spawnk_43(p, a2) {
    ksyscall_a4_set(0);
    return ksyscall(43, p, a2, 0);
}
# Release a slot proc_alloc_slot handed out and that NEVER RAN, the way the critique requires: state 0,
# ppid 0, cr3 0x1000 (proc_alloc_slot never writes the CR3 cell, so proc_reap_child would free garbage),
# then the LIFO collapse under proctab_spin_lock.
fn spawnk_release(s) {
    store64(&proc_table + s * 176 + 160, 0x1000);
    store64(&proc_ppid + s * 8, 0);
    store64(&proc_table + s * 176 + 8, 0);
    proctab_spin_lock();
    if (s == proc_count - 1) { proc_count = proc_count - 1; }
    proctab_spin_unlock();
    return 0;
}

fn spawn_kernel_selftest() {
    var all = 1;
    var u = pmm_alloc_2mb();
    if (u == 0) { spk("spawnk: VOID -- no 2 MB scratch"); return 0; }
    var line = u + 4096;                                # line / blob staging (sc_path_ok'd user-window VA)
    var ok = 1;

    # ── (1) elf_load_from_file's codes. The smoke seeds /bin/notelf (200 B of text) + /bin/tiny (10 B).
    var r = elf_load_from_file("/bin/nonexistent", 16, "/bin/nonexistent", 16);
    if (r != 0 - SPAWN_E_NOENT) { spk_num("spawnk: FAIL /bin/nonexistent rc=", r); ok = 0; }
    r = elf_load_from_file("/bin/notelf", 11, "/bin/notelf", 11);
    if (r != 0 - SPAWN_E_NOEXEC) { spk_num("spawnk: FAIL /bin/notelf rc=", r); ok = 0; }
    r = elf_load_from_file("/bin/tiny", 9, "/bin/tiny", 9);
    if (r != 0 - SPAWN_E_NOEXEC) { spk_num("spawnk: FAIL /bin/tiny rc=", r); ok = 0; }
    r = elf_load_from_file("/bin", 4, "/bin", 4);       # a DIRECTORY: vfs_file_size says -1 -> NOENT
    if (r != 0 - SPAWN_E_NOENT) { spk_num("spawnk: FAIL /bin (dir) rc=", r); ok = 0; }
    if (ok == 1) { spk("spawnk: elf codes OK"); } else { all = 0; }

    # ── (2) #43's own refusal codes, and EVERY failure kind clears BOTH arms (redirect + endowment,
    # PTY flag included). Channels minted as pid 0 in the user-window scratch.
    ok = 1;
    if (ksyscall(97, CH_MINT, u, 0) != 0) { spk("spawnk: VOID -- CH_MINT failed"); return 0; }
    var ca = load64(u);
    var cb = load64(u + 8);
    var k = 0;
    while (k < 200) { store8(line + k, 97); k = k + 1; }                     # 200 x 'a'
    var codes = 0;
    var ncase = 0;
    while (ncase < 11) {
        var stdio = 0;
        if (ncase == 3) { stdio = 1; }                                        # one case arms PTY mode
        if (spawnk_arm(cb, stdio) == 0) { spk_num("spawnk: FAIL could not arm, case ", ncase); ok = 0; }
        if (stdio == 1) { if (endow_stdio_get(0) != 1) { spk("spawnk: FAIL PTY flag not armed"); ok = 0; } }
        var want = 0 - SPAWN_E_ARGS;
        var got = 0;
        if (ncase == 0) { got = spawnk_43(line, 200); }                      # line > SPAWN_LINE_MAX
        if (ncase == 1) { got = spawnk_43(line, 0x40000 | 10); }             # unknown flag bit 18
        if (ncase == 2) { got = spawnk_43(line, 0 - 1); }                    # negative a2
        if (ncase == 3) { got = spawnk_43(line, SPAWN_F_ARGV | 1); }         # ARGV blob < 2 B
        if (ncase == 4) { got = spawnk_43(line, SPAWN_F_ARGV | 1025); }      # ARGV blob > SPAWN_ARGV_MAX
        if (ncase == 5) { got = spawnk_43(0x1000, 8); }                      # path below the user window
        if (ncase == 6) {                                                     # all-spaces line: empty path
            store8(line, 32); store8(line + 1, 32); store8(line + 2, 32);
            got = spawnk_43(line, 3);
        }
        if (ncase == 7) {                                                     # 17 tokens in 50 B
            var tl = spawnk_put(line, "/bin/spawnx a b c d e f g h i j k l m n o p");
            got = spawnk_43(line, tl);
        }
        if (ncase == 8) {
            var nl = spawnk_put(line, "/bin/nonexistent");
            want = 0 - SPAWN_E_NOENT;                                          # fails AFTER the CR3 switch
            got = spawnk_43(line, nl);
        }
        if (ncase == 9) {
            var xl = spawnk_put(line, "/bin/notelf x");
            want = 0 - SPAWN_E_NOEXEC;
            got = spawnk_43(line, xl);
        }
        if (ncase == 10) {                                                    # CLEANFD + bad env blob -> strict
            var cl = spawnk_put(line, "/bin/tiny");
            store8(line + 64, 88); store8(line + 65, 0);                      # "X\0": no '=' -> invalid
            ksyscall_a4_set(2);
            got = ksyscall(43, line, SPAWN_F_CLEANFD | cl, line + 64);
            ksyscall_a4_set(0);
        }
        if (got != want) { spk_num("spawnk: FAIL #43 code, case ", ncase); spk_num("spawnk:   got ", got); ok = 0; }
        if (spawnk_arms_empty(0) == 0) { spk_num("spawnk: FAIL arms survived #43 refusal, case ", ncase); ok = 0; }
        k = 0;
        while (k < 200) { store8(line + k, 97); k = k + 1; }             # re-fill: cases 6-10 wrote paths
        codes = codes + 1;
        ncase = ncase + 1;
    }
    if (ok == 1) { spk("spawnk: #43 refusal codes + arm clear OK"); } else { all = 0; }

    # ── (3) #37: every refusal clears the caller's arms (none did before 1.57.6), incl. D9's 17 tokens.
    ok = 1;
    var c37 = 0;
    while (c37 < 3) {
        if (spawnk_arm(cb, 0) == 0) { spk("spawnk: FAIL could not arm for #37"); ok = 0; }
        var g37 = 0;
        if (c37 == 0) { ksyscall_a4_set(0); g37 = ksyscall(37, line, 200, 0); }
        if (c37 == 1) { ksyscall_a4_set(0); g37 = ksyscall(37, 0x1000, 8, 0); }
        if (c37 == 2) {
            var t37 = spawnk_put(line, "/bin/spawnx a b c d e f g h i j k l m n o p");
            ksyscall_a4_set(0);
            g37 = ksyscall(37, line, t37, 0);
        }
        if (g37 != 0 - 1) { spk_num("spawnk: FAIL #37 refusal rc=", g37); ok = 0; }
        if (spawnk_arms_empty(0) == 0) { spk_num("spawnk: FAIL arms survived #37 refusal, case ", c37); ok = 0; }
        c37 = c37 + 1;
    }
    if (ok == 1) { spk("spawnk: #37 refusal clears arms OK"); } else { all = 0; }

    # ── (4) #62 ops: replace / ADD (append, re-point by src, cap 4) / CLEAR / refusals.
    ok = 1;
    if (ksyscall(62, 1, 5, 0) != 0) { ok = 0; }
    if (ksyscall(62, 0x100 | 2, 1, 0) != 0) { ok = 0; }
    if (redir_n_get(0) != 2) { ok = 0; }
    if (ksyscall(62, 0x100 | 2, 6, 0) != 0) { ok = 0; }                      # re-point src 2
    if (redir_n_get(0) != 2) { ok = 0; }
    if (redir_dst_get(0, 1) != 6) { ok = 0; }
    if (ksyscall(62, 0x100 | 3, 7, 0) != 0) { ok = 0; }
    if (ksyscall(62, 0x100 | 4, 7, 0) != 0) { ok = 0; }
    if (ksyscall(62, 0x100 | 8, 7, 0) != 0 - 1) { ok = 0; }                  # a 5th pair: full
    if (redir_n_get(0) != 4) { ok = 0; }
    if (ksyscall(62, 0x300, 0, 0) != 0 - 1) { ok = 0; }                      # op 3
    if (ksyscall(62, 0x201, 0, 0) != 0 - 1) { ok = 0; }                      # CLEAR with src bits
    if (ksyscall(62, 32, 1, 0) != 0 - 1) { ok = 0; }
    if (ksyscall(62, 1, 32, 0) != 0 - 1) { ok = 0; }
    if (ksyscall(62, 0 - 1, 1, 0) != 0 - 1) { ok = 0; }
    if (ksyscall(62, 0x100 | 40, 1, 0) != 0 - 1) { ok = 0; }
    if (redir_n_get(0) != 4) { ok = 0; }                                      # refusals left the set alone
    if (ksyscall(62, 1, 9, 0) != 0) { ok = 0; }                              # op 0 REPLACES the whole set
    if (redir_n_get(0) != 1) { ok = 0; }
    if (ksyscall(62, 0x200, 0, 0) != 0) { ok = 0; }
    if (redir_n_get(0) != 0) { ok = 0; }
    if (ok == 1) { spk("spawnk: #62 ops OK"); } else { spk("spawnk: FAIL #62 ops"); all = 0; }

    # ── (5) endowment <-> redirect collisions, CH_ENDOW(-1), CH_CLOSE of the armed end.
    ok = 1;
    ksyscall_a4_set(0);
    var ef = ksyscall(97, CH_ENDOW, cb, 0);
    if (ef < 3) { spk_num("spawnk: FAIL CH_ENDOW rc=", ef); ok = 0; }
    if (ksyscall(62, 0x100 | ef, 1, 0) != 0 - 1) { spk("spawnk: FAIL ADD onto the endowed fd accepted"); ok = 0; }
    else { spk("spawnk: redirect onto endowed fd refused OK"); }
    if (ksyscall(97, CH_ENDOW, 0 - 1, 0) != 0) { ok = 0; }
    if (endow_arm_get(0) >= 0) { spk("spawnk: FAIL CH_ENDOW(-1) left the arm"); ok = 0; }
    else { spk("spawnk: CH_ENDOW(-1) disarms OK"); }
    # the stale endow_fd must not refuse a now-legitimate ADD (critique)
    if (ksyscall(62, 0x100 | ef, 1, 0) != 0) { spk("spawnk: FAIL stale endow fd refused an ADD"); ok = 0; }
    # ...and CH_ENDOW must not pick an fd that is an armed redirect SRC
    var ef2 = ksyscall(97, CH_ENDOW, cb, 0);
    if (ef2 == ef) { spk("spawnk: FAIL CH_ENDOW picked an armed redirect src"); ok = 0; }
    if (ef2 < 3) { ok = 0; }
    ksyscall(62, 0x200, 0, 0);
    if (ksyscall(97, CH_CLOSE, cb, 0) != 0) { spk("spawnk: FAIL CH_CLOSE"); ok = 0; }
    if (endow_arm_get(0) >= 0) { spk("spawnk: FAIL CH_CLOSE of the armed end left the arm"); ok = 0; }
    else { spk("spawnk: CH_CLOSE of the armed end disarms OK"); }
    ksyscall(97, CH_CLOSE, ca, 0);
    if (ok == 0) { all = 0; }

    # ── (6) placement RE-CHECKS owner + channel epoch (the "P arms e, e is re-minted to Q" theft).
    ok = 1;
    var t15 = 0;
    if (proc_count > 15) { spk("spawnk: VOID -- slot 15 in use"); ok = 0; }
    if (proc_fd_base_get(15) != 0) { spk("spawnk: VOID -- slot 15 has a table"); ok = 0; }
    if (ok == 1) {
        if (ksyscall(97, CH_MINT, u, 0) != 0) { spk("spawnk: FAIL CH_MINT 2"); ok = 0; }
        var pa = load64(u);
        var pb = load64(u + 8);
        var pe = kpayload(vfs_fd_table() + pb * 32, 0);
        vfs_fd_inherit(15, 0);
        t15 = proc_fd_base_get(15);
        ksyscall_a4_set(0);                             # a4 == CH_ENDOW_STDIO would arm PTY mode
        # (a) owner changed under the arm
        var pf = ksyscall(97, CH_ENDOW, pb, 0);
        store64(&chan_end_owner + pe * 8, 7);
        if (chan_place_into_child(15) != 0 - 1) { spk("spawnk: FAIL placed a stolen endpoint"); ok = 0; }
        if (load64(&chan_end_owner + pe * 8) != 7) { ok = 0; }
        store64(&chan_end_owner + pe * 8, 0);
        # (b) channel re-minted under the arm
        pf = ksyscall(97, CH_ENDOW, pb, 0);
        var ep0 = load64(&chan_epoch + (pe >> 1) * 8);
        store64(&chan_epoch + (pe >> 1) * 8, ep0 + 1000);
        if (chan_place_into_child(15) != 0 - 1) { spk("spawnk: FAIL placed a re-minted channel"); ok = 0; }
        store64(&chan_epoch + (pe >> 1) * 8, ep0);
        # (c) the honest case still places, and records the placement for the fd shaping
        pf = ksyscall(97, CH_ENDOW, pb, 0);
        if (chan_place_into_child(15) != pf) { spk("spawnk: FAIL honest placement refused"); ok = 0; }
        if (load64(&chan_end_owner + pe * 8) != 15) { ok = 0; }
        if (endow_placed_get(0) != pf + 1) { spk("spawnk: FAIL placement not recorded"); ok = 0; }
        if (ktag(t15 + pf * 32) != VFS_CHAN) { ok = 0; }
        # give the endpoint back to pid 0 (current incarnation) so it can be closed normally
        store64(&chan_end_owner + pe * 8, 0);
        store64(&chan_end_oepoch + pe * 8, proc_epoch_get(0));
        ktag_clear(t15 + pf * 32, 32);
        proc_destroy_fd_table(15, 0);
        ksyscall(97, CH_CLOSE, pb, 0);
        ksyscall(97, CH_CLOSE, pa, 0);
        endow_placed_set(0, 0);
    }
    if (ok == 1) { spk("spawnk: placement re-checks owner + epoch OK"); } else { all = 0; }

    # ── (7) CLEANFD shaping: refused on the global table; on a private table the child keeps exactly
    # 0/1/2 (after redirects), the armed redirect srcs and nothing else — and the PARENT's entries are
    # untouched (a raw scrub, never vfs_close).
    ok = 1;
    ksyscall(62, 1, 2, 0);
    if (spawn_fd_shape(0, 0, 1) != 0 - 1) { ok = 0; }
    if (redir_n_get(0) != 0) { ok = 0; }
    if (ok == 1) { spk("spawnk: clean shape refused on global table OK"); } else { spk("spawnk: FAIL clean shape on global table"); all = 0; }
    ok = 1;
    if (vfs_create_pipe(u + 64) != 0) { spk("spawnk: VOID -- pipe"); ok = 0; }
    if (vfs_create_pipe(u + 80) != 0) { spk("spawnk: VOID -- pipe 2"); ok = 0; }
    if (ok == 1) {
        var qr = load64(u + 64);
        var qw = load64(u + 72);
        var xr = load64(u + 80);
        var xw = load64(u + 88);
        var gtab = vfs_fd_table();
        vfs_fd_inherit(15, 0);
        var ct = proc_fd_base_get(15);
        ksyscall(62, 1, qw, 0);                         # 1 <- qw
        ksyscall(62, 0x100 | 2, 1, 0);                  # 2 <- 1   (2>&1)
        ksyscall(62, 0x100 | 9, xw, 0);                 # 9 <- xw  (an explicitly passed fd)
        if (spawn_fd_shape(15, 0, 1) != 0) { ok = 0; }
        var kk = 0;
        while (kk < 32) {
            if (load64(ct + 1 * 32 + kk) != load64(gtab + qw * 32 + kk)) { ok = 0; }
            if (load64(ct + 2 * 32 + kk) != load64(gtab + qw * 32 + kk)) { ok = 0; }
            if (load64(ct + 9 * 32 + kk) != load64(gtab + xw * 32 + kk)) { ok = 0; }
            kk = kk + 8;
        }
        var sf = 3;
        while (sf < 32) {
            if (sf != 9) { if (ktag(ct + sf * 32) != VFS_FREE) { spk_num("spawnk: FAIL CLEANFD kept fd ", sf); ok = 0; } }
            sf = sf + 1;
        }
        if (ktag(gtab + qr * 32) != VFS_PIPE) { ok = 0; }   # the parent still holds all four ends
        if (ktag(gtab + qw * 32) != VFS_PIPE) { ok = 0; }
        if (ktag(gtab + xr * 32) != VFS_PIPE) { ok = 0; }
        if (ktag(gtab + xw * 32) != VFS_PIPE) { ok = 0; }
        if (redir_n_get(0) != 0) { ok = 0; }
        proc_destroy_fd_table(15, 0);
        # placed-endowment skip: pretend the endowment landed on fd 3, then an op-0 REPLACE onto 3
        vfs_fd_inherit(15, 0);
        ct = proc_fd_base_get(15);
        var before3 = load64(ct + 3 * 32);
        var before3b = load64(ct + 3 * 32 + 8);
        endow_placed_set(0, 3 + 1);
        ksyscall(62, 3, qw, 0);
        spawn_fd_shape(15, 0, 0);
        if (load64(ct + 3 * 32) != before3) { spk("spawnk: FAIL redirect overwrote the placed endowment fd"); ok = 0; }
        if (load64(ct + 3 * 32 + 8) != before3b) { ok = 0; }
        endow_placed_set(0, 0);
        proc_destroy_fd_table(15, 0);
        vfs_close(qr); vfs_close(qw); vfs_close(xr); vfs_close(xw);
    }
    if (ok == 1) { spk("spawnk: clean shape + 2>&1 + fd pass + endowed-fd skip OK"); } else { all = 0; }

    # ── (8) the argv blob validator and the line-token counter.
    ok = 1;
    spawnk_put(line, "a_bXc__");                        # 'a' NUL 'b' ' ' 'c' NUL NUL — built below
    store8(line + 1, 0); store8(line + 3, 32); store8(line + 5, 0); store8(line + 6, 0);
    if (sc_argv_blob_ok(line, 7) != 1) { spk("spawnk: FAIL argv: 3 entries (one empty) rejected"); ok = 0; }
    var e16 = 0;
    while (e16 < 32) { store8(line + e16, 120); store8(line + e16 + 1, 0); e16 = e16 + 2; }   # 16 x "x\0"
    if (sc_argv_blob_ok(line, 32) != 1) { spk("spawnk: FAIL argv: 16 entries rejected"); ok = 0; }
    store8(line + 32, 120); store8(line + 33, 0);                                           # 17th
    if (sc_argv_blob_ok(line, 34) != 0) { spk("spawnk: FAIL argv: 17 entries accepted"); ok = 0; }
    if (sc_argv_blob_ok(line, 33) != 0) { spk("spawnk: FAIL argv: no trailing NUL accepted"); ok = 0; }
    store8(line, 0);
    if (sc_argv_blob_ok(line, 4) != 0) { spk("spawnk: FAIL argv: empty argv[0] accepted"); ok = 0; }
    var e255 = 0;
    while (e255 < 255) { store8(line + e255, 112); e255 = e255 + 1; }
    store8(line + 255, 0);
    if (sc_argv_blob_ok(line, 256) != 255) { spk("spawnk: FAIL argv: 255 B argv[0] rejected"); ok = 0; }
    store8(line + 255, 112); store8(line + 256, 0);
    if (sc_argv_blob_ok(line, 257) != 0) { spk("spawnk: FAIL argv: 256 B argv[0] accepted"); ok = 0; }
    store8(line + 1024, 0);
    if (sc_argv_blob_ok(line, 1025) != 0) { spk("spawnk: FAIL argv: 1025 B accepted"); ok = 0; }
    if (sc_argv_blob_ok(line, 1) != 0) { ok = 0; }
    var tk = spawnk_put(line, "  a   b  ");
    if (spawn_line_tokens(line, tk) != 2) { ok = 0; }
    if (spawn_line_tokens(line, 0) != 0) { ok = 0; }
    tk = spawnk_put(line, "/bin/x a b c d e f g h i j k l m n o");
    if (spawn_line_tokens(line, tk) != 16) { spk("spawnk: FAIL 16-token line miscounted"); ok = 0; }
    tk = spawnk_put(line, "/bin/x a b c d e f g h i j k l m n o p");
    if (spawn_line_tokens(line, tk) != 17) { spk("spawnk: FAIL 17-token line miscounted"); ok = 0; }
    if (ok == 1) { spk("spawnk: argv blob validator OK"); } else { all = 0; }

    # ── (9) PER-PROCESS isolation, and the slot-recycle reset.
    ok = 1;
    ksyscall(62, 1, 2, 0);                              # pid 0 armed
    if (redir_n_get(5) != 0) { ok = 0; }
    # asm contract: `cli` — no inputs, no outputs, clobbers only RFLAGS.IF. No tick on this CPU while the
    # hand-allocated slots below exist (they never run); the matching `sti` restores IF=1.
    asm { cli; }
    var s1 = proc_alloc_slot();
    if (s1 < 1) { ok = 0; }
    if (s1 >= 1) {
        redir_arm_replace(s1, 1, 2);
        endow_arm_set(s1, 3);
        endow_placed_set(s1, 4);
        if (redir_n_get(0) != 1) { ok = 0; }            # a different pid's arm is untouched
        spawnk_release(s1);
        var s2 = proc_alloc_slot();
        if (s2 != s1) { spk_num("spawnk: VOID -- slot not reused, got ", s2); ok = 0; }
        if (spawnk_arms_empty(s2) == 0) { spk("spawnk: FAIL recycled slot inherited arms"); ok = 0; }
        if (endow_placed_get(s2) != 0) { ok = 0; }
        if (redir_n_get(0) != 1) { ok = 0; }
        spawnk_release(s2);
    }
    asm { sti; }                                        # asm contract: `sti` — no inputs/outputs, sets RFLAGS.IF
    if (ok == 1) { spk("spawnk: per-process arms isolated + reset on slot reuse OK"); } else { all = 0; }
    # The degenerate case the guard exists for: the CALLER is handed its own (dead) slot — the boot
    # context before the bootstrap. Its arms must survive until its placement consumes them.
    ok = 1;
    asm { cli; }                                        # contract as above: IF only — current is rewritten below
    var s3 = proc_alloc_slot();
    if (s3 >= 1) {
        spawnk_release(s3);
        proc_current_set(s3);
        redir_arm_replace(s3, 1, 2);
        var s4 = proc_alloc_slot();
        proc_current_set(0);
        if (s4 != s3) { spk_num("spawnk: VOID -- degenerate slot not reused, got ", s4); ok = 0; }
        if (redir_n_get(s3) != 1) { spk("spawnk: FAIL the caller's own slot lost its arms"); ok = 0; }
        redir_clear(s3);
        spawnk_release(s4);
    }
    if (s3 < 1) { ok = 0; }
    asm { sti; }                                        # asm contract: `sti` — no inputs/outputs, sets RFLAGS.IF
    ksyscall(62, 0x200, 0, 0);
    if (ok == 1) { spk("spawnk: caller's own slot keeps its arms OK"); } else { all = 0; }

    # ── (10) PIPE LIFETIME: the last reference anywhere frees the buffer, exactly once.
    ok = 1;
    if (proc_count > 15) { ok = 0; }
    if (proc_fd_base_get(15) != 0) { ok = 0; }
    if (ok == 0) { spk("spawnk: VOID -- slot 15 busy for the pipe checks"); }
    if (ok == 1) {
        # asm contract: `cli` — no inputs/outputs, clears RFLAGS.IF: no ISR and no preemption on this CPU
        # can allocate or free between a close and the free-list probe that follows it.
        asm { cli; }
        vfs_create_pipe(u + 96);
        var lr = load64(u + 96);
        var lw = load64(u + 104);
        var lpb = kpayload(vfs_fd_table() + lr * 32, 2);
        vfs_fd_inherit(15, 0);                          # "a child" holding copies of both ends
        var ltab = proc_fd_base_get(15);
        vfs_close(lr);
        vfs_close(lw);                                  # the OWNER's last close — the 1.47.x free point
        if (spawnk_fl_count(lpb, 4096) != 0) { spk("spawnk: FAIL pipe buffer freed while a child still held it"); ok = 0; }
        proc_destroy_fd_table(15, 0);                   # the child's table goes: last reference
        if (spawnk_fl_count(lpb, 4096) != 1) { spk_num("spawnk: FAIL pipe buffer free count ", spawnk_fl_count(lpb, 4096)); ok = 0; }
        if (spawnk_fl_count(ltab, 1024) != 1) { spk("spawnk: FAIL child table not freed exactly once"); ok = 0; }
        if (ok == 1) { spk("spawnk: pipe outlives owner close OK"); }
        # the other order: the child's table first, then the owner's two closes
        vfs_create_pipe(u + 96);
        lr = load64(u + 96);
        lw = load64(u + 104);
        lpb = kpayload(vfs_fd_table() + lr * 32, 2);
        vfs_fd_inherit(15, 0);
        proc_destroy_fd_table(15, 0);
        if (spawnk_fl_count(lpb, 4096) != 0) { spk("spawnk: FAIL child reap freed a buffer the owner holds"); ok = 0; }
        vfs_close(lr);
        if (spawnk_fl_count(lpb, 4096) != 0) { ok = 0; }
        vfs_close(lw);
        if (spawnk_fl_count(lpb, 4096) != 1) { spk("spawnk: FAIL last close did not free exactly once"); ok = 0; }
        # vfs_create_pipe's wfd-failure path: rfd is the only reference, vfs_close(rfd) frees it — the
        # explicit free that followed was a DOUBLE free. Fill the table to exactly one free fd.
        var gt = vfs_fd_table();
        var nfree = 0;
        var fz = 1;
        while (fz < 32) { if (ktag(gt + fz * 32) == VFS_FREE) { nfree = nfree + 1; } fz = fz + 1; }
        var filled = 0;
        while (nfree > 1) {
            var mf = vfs_create_memfile(u, 1);
            if (mf < 0) { nfree = 0; }
            if (mf >= 0) { store64(u + 256 + filled * 8, mf); filled = filled + 1; nfree = nfree - 1; }
        }
        if (nfree == 1) {
            var hf0 = heap_frees;
            var cr = vfs_create_pipe(u + 96);
            var fcls = slab_class_for(4096);
            var fhead = load64(&slab_free + fcls * 8);
            if (cr != 0 - 1) { spk("spawnk: FAIL pipe create with one free fd succeeded"); ok = 0; }
            if (heap_frees != hf0 + 1) { spk_num("spawnk: FAIL create-failure frees ", heap_frees - hf0); ok = 0; }
            if (spawnk_fl_count(fhead, 4096) != 1) { spk("spawnk: FAIL create-failure double free"); ok = 0; }
        }
        if (nfree != 1) { spk("spawnk: VOID -- could not fill the fd table to one slot"); ok = 0; }
        while (filled > 0) { filled = filled - 1; vfs_close(load64(u + 256 + filled * 8)); }
        asm { sti; }                                    # asm contract: `sti` — no inputs/outputs, sets RFLAGS.IF
    }
    if (ok == 1) { spk("spawnk: pipe freed by its last reference, exactly once OK"); } else { all = 0; }

    # ── (11′) 1.57.7 (S3b): a #37 child's table DROPS a child-made sole pipe reference exactly once. #37 applies its
    # redirects into the CHILD's private table (spawn_shape_strict -> spawn_fd_shape) and restores nothing; the
    # child owns its redirected slot while it runs, and if it closes that fd and a pipe of its own lands there, the
    # table's destruction at the reap (proc_reap_child -> proc_destroy_fd_table(c, 0)) removes that pipe's last
    # reference. Emulated on slot 15: shape (1 <- a creator pipe), then the slot is made to name a fresh buffer
    # nothing else references, then the table is destroyed exactly as the reap does it.
    ok = 1;
    if (proc_count > 15) { ok = 0; }
    if (proc_fd_base_get(15) != 0) { ok = 0; }
    if (ok == 0) { spk("spawnk: VOID -- slot 15 busy for the #37 child-table check"); }
    if (ok == 1) {
        # asm contract: `cli` — no inputs/outputs, clears RFLAGS.IF: nothing on this CPU allocates or frees
        # between the destroy and the free-list probes that follow it.
        asm { cli; }
        vfs_create_pipe(u + 128);
        var ar = load64(u + 128);
        var aw = load64(u + 136);
        var abuf = kpayload(vfs_fd_table() + ar * 32, 2);
        vfs_fd_inherit(15, 0);
        var rtab = proc_fd_base_get(15);
        ksyscall(62, 1, aw, 0);                         # 1 <- aw
        spawn_fd_shape(15, 0, 0);                       # #37's apply (spawn_shape_strict's private-table branch)
        if (ktag(rtab + 32) != VFS_PIPE) { ok = 0; }
        if (kpayload(rtab + 32, 2) != abuf) { spk("spawnk: FAIL #37 shape did not repoint fd 1"); ok = 0; }
        var bbuf = kmalloc(4096);
        if (bbuf == 0) { spk("spawnk: VOID -- kmalloc(4096)"); ok = 0; }
        # the child "closed fd 1 and its own pipe landed there" — a raw overwrite drops only a duplicate of
        # the creator's aw, which the creator still holds
        ktag_clear(rtab + 32, 32);
        ktag_set(rtab + 32, VFS_PIPE);
        kpayload_set(rtab + 32, 1, 1);
        kpayload_set(rtab + 32, 2, bbuf);
        proc_destroy_fd_table(15, 0);                   # what proc_reap_child does to every #37 child
        if (spawnk_fl_count(bbuf, 4096) != 1) { spk_num("spawnk: FAIL #37 child table freed the child's sole pipe this many times: ", spawnk_fl_count(bbuf, 4096)); ok = 0; }
        if (spawnk_fl_count(abuf, 4096) != 0) { spk("spawnk: FAIL #37 child table freed the creator's pipe"); ok = 0; }
        if (redir_n_get(0) != 0) { spk("spawnk: FAIL #37 shape left the redirect set armed"); ok = 0; }
        vfs_close(ar);
        vfs_close(aw);
        if (spawnk_fl_count(abuf, 4096) != 1) { spk("spawnk: FAIL the creator's pipe was not freed exactly once"); ok = 0; }
        asm { sti; }                                    # asm contract: `sti` — no inputs/outputs, sets RFLAGS.IF
    }
    if (ok == 1) { spk("spawnk: #37 child table drops a child-made sole pipe exactly once OK"); } else { all = 0; }

    # ── (12) an ORPHAN ZOMBIE's fd table is destroyed when its slot is handed out again, not leaked.
    # proc_alloc_slot reuses such a slot without touching its table; vfs_fd_inherit must sweep it (and the
    # pipe buffers only it still names) before giving the slot a fresh copy. Slot 15 plays the orphan.
    ok = 1;
    if (proc_count > 15) { ok = 0; }
    if (proc_fd_base_get(15) != 0) { ok = 0; }
    if (ok == 0) { spk("spawnk: VOID -- slot 15 busy for the orphan-table check"); }
    if (ok == 1) {
        # asm contract: `cli` — no inputs/outputs, clears RFLAGS.IF (boot A is -smp 1, so with IF=0 nothing
        # else can move heap_frees between the two reads below).
        asm { cli; }
        vfs_create_pipe(u + 144);
        var zr = load64(u + 144);
        var zw = load64(u + 152);
        var zbuf = kpayload(vfs_fd_table() + zr * 32, 2);
        vfs_fd_inherit(15, 0);                          # the orphan's table: copies of both ends
        vfs_close(zr);
        vfs_close(zw);                                  # now the orphan's table is the ONLY holder
        if (spawnk_fl_count(zbuf, 4096) != 0) { spk("spawnk: FAIL pipe freed while the orphan's table named it"); ok = 0; }
        var zf0 = heap_frees;
        vfs_fd_inherit(15, 0);                          # slot 15 handed to a new child
        # ⚠ The table's own free is counted, not probed: kmalloc(1024) right after the destroy pops that
        # very block back off the free list for the new table (LIFO), so its free-list count reads 0.
        if (heap_frees != zf0 + 2) { spk_num("spawnk: FAIL orphan table reuse freed ", heap_frees - zf0); ok = 0; }
        if (spawnk_fl_count(zbuf, 4096) != 1) { spk("spawnk: FAIL the orphan's sole pipe leaked (or double-freed)"); ok = 0; }
        if (proc_fd_base_get(15) == 0) { spk("spawnk: FAIL no fresh table after the orphan's"); ok = 0; }
        proc_destroy_fd_table(15, 0);
        asm { sti; }                                    # asm contract: `sti` — no inputs/outputs, sets RFLAGS.IF
    }
    if (ok == 1) { spk("spawnk: orphan zombie's fd table + sole pipe released on slot reuse OK"); } else { all = 0; }

    # ── (13) #43 step (f): a child on the global-table fallback is TORN DOWN (-SPAWN_E_NOMEM) — CLEANFD always, and
    # since 1.57.7 (operator OQ-7) a LEGACY one too (it used to run unredirected, sharing proc 0's fds concurrently).
    # vfs_fd_inherit's kmalloc failure is what produces the fallback in the field; the allocator has no fault
    # injection, so a really-loaded child's table is destroyed to force it.
    ok = 1;
    ksyscall(97, CH_ENDOW, 0 - 1, 0);
    var tc = elf_load_from_file("/bin/spawnx", 11, "/bin/spawnx", 11);
    if (tc < 1) { spk_num("spawnk: VOID -- could not load /bin/spawnx for the teardown check, rc=", tc); ok = 0; }
    if (tc >= 1) {
        var tcr3 = load64(&proc_table + tc * 176 + 160);
        var tpc = proc_count;
        if (tcr3 == 0x1000) { spk("spawnk: VOID -- loaded child has no address space"); ok = 0; }
        proc_destroy_fd_table(tc, 0);                   # the fallback: proc_fd_base == 0 -> the global table
        ksyscall(62, 1, 2, 0);                          # an armed redirect the refusal must clear too
        var tr = spawn_shape_or_teardown(tc, 0, 1);
        if (tr != 0 - SPAWN_E_NOMEM) { spk_num("spawnk: FAIL CLEANFD teardown rc=", tr); ok = 0; }
        if (load64(&proc_table + tc * 176 + 8) != 0) { spk("spawnk: FAIL torn-down child is not dead"); ok = 0; }
        if (load64(&proc_table + tc * 176 + 160) != 0x1000) { spk("spawnk: FAIL torn-down child kept its address space"); ok = 0; }
        if (load64(&proc_ppid + tc * 8) != 0) { ok = 0; }
        if (tc == tpc - 1) { if (proc_count != tpc - 1) { spk("spawnk: FAIL torn-down top slot not collapsed"); ok = 0; } }
        if (redir_n_get(0) != 0) { spk("spawnk: FAIL CLEANFD refusal left the redirect armed"); ok = 0; }
        # the legacy form on the same fallback: torn down too (1.57.7, OQ-7), no redirect armed
        var lc = elf_load_from_file("/bin/spawnx", 11, "/bin/spawnx", 11);
        if (lc < 1) { spk("spawnk: VOID -- second load"); ok = 0; }
        if (lc >= 1) {
            proc_destroy_fd_table(lc, 0);
            if (spawn_shape_or_teardown(lc, 0, 0) != 0 - SPAWN_E_NOMEM) { spk("spawnk: FAIL legacy child on the global table not refused"); ok = 0; }
            if (load64(&proc_table + lc * 176 + 8) != 0) { spk("spawnk: FAIL refused legacy child is not dead"); ok = 0; }
            if (load64(&proc_table + lc * 176 + 160) != 0x1000) { spk("spawnk: FAIL refused legacy child kept its address space"); ok = 0; }
        }
    }
    if (ok == 1) { spk("spawnk: CLEANFD and legacy children on the global table torn down (-3) OK"); } else { all = 0; }

    # ── (14) 1.57.7 (S3b): execwait#37's STRICT shape refuses a child on the global table — with a redirect armed AND
    # without one (DEP-1): a scheduled #37 child on the global vfs_table would share proc 0's fds while running
    # concurrently with kmain. Mirrors (13): the fallback forced by destroying a really-loaded child's table.
    ok = 1;
    var sc1 = elf_load_from_file("/bin/spawnx", 11, "/bin/spawnx", 11);
    if (sc1 < 1) { spk_num("spawnk: VOID -- could not load /bin/spawnx for the strict check, rc=", sc1); ok = 0; }
    if (sc1 >= 1) {
        var spc = proc_count;
        proc_destroy_fd_table(sc1, 0);
        ksyscall(62, 1, 2, 0);                          # armed: the refusal must clear it
        var sr1 = spawn_shape_strict(sc1, 0);
        if (sr1 != 0 - SPAWN_E_NOMEM) { spk_num("spawnk: FAIL strict shape on the global table rc=", sr1); ok = 0; }
        if (load64(&proc_table + sc1 * 176 + 8) != 0) { spk("spawnk: FAIL strict-refused child is not dead"); ok = 0; }
        if (load64(&proc_table + sc1 * 176 + 160) != 0x1000) { spk("spawnk: FAIL strict-refused child kept its address space"); ok = 0; }
        if (sc1 == spc - 1) { if (proc_count != spc - 1) { spk("spawnk: FAIL strict-refused top slot not collapsed"); ok = 0; } }
        if (redir_n_get(0) != 0) { spk("spawnk: FAIL strict refusal left the redirect armed"); ok = 0; }
        var sc2 = elf_load_from_file("/bin/spawnx", 11, "/bin/spawnx", 11);
        if (sc2 < 1) { spk("spawnk: VOID -- second strict load"); ok = 0; }
        if (sc2 >= 1) {
            proc_destroy_fd_table(sc2, 0);              # NO redirect armed this time
            if (spawn_shape_strict(sc2, 0) != 0 - SPAWN_E_NOMEM) { spk("spawnk: FAIL strict shape ran an unredirected child on the global table"); ok = 0; }
            if (load64(&proc_table + sc2 * 176 + 8) != 0) { spk("spawnk: FAIL second strict-refused child is not dead"); ok = 0; }
        }
    }
    if (ok == 1) { spk("spawnk: #37 strict shape refuses a child on the global table OK"); } else { all = 0; }

    ksyscall(62, 0x200, 0, 0);
    ksyscall(97, CH_ENDOW, 0 - 1, 0);
    pmm_free_2mb(u);
    if (all == 1) { spk("spawnk: ALL PASS"); } else { spk("spawnk: FAIL"); }
    spk("spawnk: done");
    return 0;
}
spawn_kernel_selftest();
#endif

#ifdef DMA_SHADOW_SELFTEST
# ═══ 1.57.8 DMA_SHADOW_SELFTEST — block + HDA DMA survives a SHADOWED identity window ═══
# (docs/development/issues/archived/2026-09-25-dma-cpu-pointers-still-use-identity-vas.md; docs/architecture/dma-cpu-pointers.md)
# pmm_alloc draws from [0x400000, 0x10000000). Under a per-process CR3 the loader writes a ring-3 PT_LOAD's PDEs over
# exactly that window, so a driver that reaches a DMA ring through phys == VA reads and writes the PROCESS's page. This
# test builds that CR3 by hand: a copy of the kernel's PML4/PDPT/PD with PD[2..127] (every 2 MB of [4 MB, 256 MB)) all
# pointing at ONE 2 MB region filled with 0xA5 — what a hostile ELF whose PT_LOADs cover the window does, except the
# PDEs are supervisor (0x83), so an identity access lands silently in the shadow (a real US=1 PT_LOAD turns the same
# access into a SMAP #PF at CPL0). Then, IF=0 and under that CR3: single-sector, 8-sector and FLUSH on every registered
# block backend (virtio-blk, NVMe, AHCI), the NVMe PRP-list path (24 sectors direct), and an HDA verb round-trip. Every
# transfer must be byte-exact and the verb must return the vendor id read before the switch. RED on a driver that still
# dereferences a pmm page's phys: its SQE/descriptor/CORB entry goes into the shadow, the device never sees it.
# DESTRUCTIVE: writes sectors 64..95 on virtio/AHCI and nsze/2.. on NVMe — QEMU scratch disks only.
# Buffers are .bss (kernel image: identity == phys, mapped in every CR3), so they serve AHCI's buf-is-DMA-address API too.
# 1.57.9 (CPUVA) adds the CPU-only pmm buffers — fb_console's shadow (arm 6, "dmash: fb") and, in a RAMDISK_ENABLE
# build, the ramdisk (arm 5) — checked ACROSS the switch, plus "dmash: window": the 0xA5 region must be untouched after
# every arm (a CPU store through an identity VA is exactly a store into the ring-3 process's page).
var dsh_a[512];            # 4 KB write pattern
var dsh_b[512];            # 4 KB read-back
var dsh_big[4096];         # 32 KB: two page-aligned 12 KB windows (NVMe PRP list)
var dsh_res[8];            # per-arm bad counts, measured under the shadow, printed after it
var dsh_ran[8];            # per-arm "the backend was there" flags
var dsh_s = 0;             # the 2 MB shadow region (phys)
var dsh_cr3 = 0;           # the shadow address space (PML4 phys)

fn dsh_word(tag, i) { return 0x44534800000000 | (tag << 24) | i; }
fn dsh_fill(p, n, tag) {
    for (var i = 0; i < n / 8; i = i + 1) { store64(p + i * 8, dsh_word(tag, i)); }
    return 0;
}
fn dsh_poison(p, n) {
    for (var i = 0; i < n / 8; i = i + 1) { store64(p + i * 8, 0xEEEEEEEEEEEEEEEE); }
    return 0;
}
fn dsh_bad(p, n, tag) {
    var nbad = 0;
    for (var i = 0; i < n / 8; i = i + 1) { if (load64(p + i * 8) != dsh_word(tag, i)) { nbad = nbad + 1; } }
    return nbad;
}
fn dsh_build() {
    dsh_s = pmm_alloc_2mb();
    var pml4 = pmm_alloc();
    var pdpt = pmm_alloc();
    var pd = pmm_alloc();
    if (dsh_s == 0) { return 0; }
    if (pml4 == 0) { return 0; }
    if (pdpt == 0) { return 0; }
    if (pd == 0) { return 0; }
    var sk = dma_kva(dsh_s);
    for (var i = 0; i < 262144; i = i + 1) { store64(sk + i * 8, 0xA5A5A5A5A5A5A5A5); }
    var k4 = dma_kva(pml4);
    var kp = dma_kva(pdpt);
    var kd = dma_kva(pd);
    for (var j = 0; j < 512; j = j + 1) {
        store64(k4 + j * 8, load64(dma_kva(0x1000) + j * 8));
        store64(kp + j * 8, load64(dma_kva(0x2000) + j * 8));
        store64(kd + j * 8, load64(dma_kva(0x3000) + j * 8));
    }
    store64(k4, pdpt | 0x03);
    store64(kp, pd | 0x03);
    for (var e = 2; e < 128; e = e + 1) { store64(kd + e * 8, dsh_s | 0x83); }
    dsh_cr3 = pml4;
    return 1;
}
# One backend: single sector, 8 sectors, FLUSH. A failed call adds its own weight (write 1000, read 2000, 8-sector
# write 4000, 8-sector read 8000, flush 16000) so the verdict names the call; bad words count 1 each (max 576).
fn dsh_blk(tag, arm, sector) {
    if (blk_is_registered(tag) == 0) { return 0; }
    store64(&dsh_ran + arm * 8, 1);
    var bad = 0;
    dsh_fill(&dsh_a, 4096, tag);
    dsh_poison(&dsh_b, 4096);
    if (blk_write_on(tag, sector, &dsh_a) != 0) { bad = bad + 1000; }
    if (blk_read_on(tag, sector, &dsh_b) != 0) { bad = bad + 2000; }
    bad = bad + dsh_bad(&dsh_b, 512, tag);
    dsh_fill(&dsh_a, 4096, tag + 8);
    dsh_poison(&dsh_b, 4096);
    if (blk_write_sectors_on(tag, sector + 8, 8, &dsh_a) != 0) { bad = bad + 4000; }
    if (blk_read_sectors_on(tag, sector + 8, 8, &dsh_b) != 0) { bad = bad + 8000; }
    bad = bad + dsh_bad(&dsh_b, 4096, tag + 8);
    if (blk_flush_on(tag) != 0) { bad = bad + 16000; }
    store64(&dsh_res + arm * 8, bad);
    return 0;
}
# NVMe direct 24 sectors = 3 pages: PRP1 + a PRP LIST (nvme_prp_list_kva).
fn dsh_prp(arm, sector) {
    if (blk_is_registered(BLK_NVME) == 0) { return 0; }
    store64(&dsh_ran + arm * 8, 1);
    var pa = (&dsh_big + 4095) & (0 - 4096);
    var pb = pa + 12288;
    var bad = 0;
    dsh_fill(pa, 12288, 13);
    dsh_poison(pb, 12288);
    if (blk_write_sectors_direct(BLK_NVME, sector, 24, pa) != 0) { bad = bad + 1000; }
    if (blk_read_sectors_direct(BLK_NVME, sector, 24, pb) != 0) { bad = bad + 2000; }
    bad = bad + dsh_bad(pb, 12288, 13);
    store64(&dsh_res + arm * 8, bad);
    return 0;
}
fn dsh_hda_vendor() {
    return hda_verb(load64(&hda_codec0), 0, (V_GET_PARAM << 8) | P_VENDOR);
}
fn dsh_verdict(name, nlen, arm) {
    kprint("dmash: ", 7);
    kprint(name, nlen);
    if (load64(&dsh_ran + arm * 8) == 0) { kprintln(" SKIP (backend absent)", 22); return 0; }
    if (load64(&dsh_res + arm * 8) == 0) { kprint(" PASS", 5); } else { kprint(" FAIL", 5); }
    kprint(" bad=", 5); kprint_num(load64(&dsh_res + arm * 8));
    kprintln("", 0);
    return 0;
}
# ─── 1.57.9 (CPUVA) — the CPU-only pmm buffers: fb_console's shadow and the ramdisk ─────────────────────────────
# (docs/development/issues/2026-09-25-cpu-only-pmm-buffers-still-use-identity-vas.md). Neither is DMA, so the
# arms above cannot see them: a device never reads them, and a store-then-load of the SAME identity VA under the
# shadow CR3 reads back what it wrote (both hit the one 0xA5 region), which is why these arms cross the CR3
# switch. Every check below reads, on the kernel CR3, what was written under the shadow (or the reverse).
# dsh_dirty: words of the shadow region that are no longer 0xA5 — each one a CPU store that went to an identity
# VA inside [4 MB, 256 MB) under the shadow CR3, i.e. a store a ring-3 PT_LOAD there would have received.
fn dsh_dirty() {
    var dk = dma_kva(dsh_s);
    var nd = 0;
    for (var i = 0; i < 262144; i = i + 1) { if (load64(dk + i * 8) != 0xA5A5A5A5A5A5A5A5) { nd = nd + 1; } }
    return nd;
}
var DSH_FB_INK = 0x00A1B2C3;   # a colour nothing else paints: its presence in a shadow cell is this arm's glyph
var dsh_fb_cx = 0;             # the cell fb_putc painted (column, row), recorded under the shadow
var dsh_fb_cy = 0;
# fb arm, UNDER the shadow CR3: paint one '#' in DSH_FB_INK through the real console painter (fb_putc — the
# write(1,..) path's painter, which mirrors every pixel into fb_shadow). Held under console_lock so an AP's
# kprint cannot interleave; nothing in here prints.
fn dsh_fb_paint() {
    if (fb_shadow == 0) { return 0; }
    if (fb_console_ready == 0) { return 0; }
    if (fb_defer != 0) { return 0; }
    if (fb_draw_base() == 0) { return 0; }
    store64(&dsh_ran + 6 * 8, 1);
    console_spin_lock();
    var ink = fb_fg_color;
    fb_fg_color = DSH_FB_INK;
    fb_putc(35);
    fb_fg_color = ink;
    dsh_fb_cx = fb_cur_x - 1;
    dsh_fb_cy = fb_cur_y;
    console_spin_unlock();
    return 0;
}
# fb arm, back on the kernel CR3: the shadow cell must equal the FB cell pixel for pixel and hold the ink. A
# shadow reached by identity VA took the glyph into the 0xA5 region instead, so its real cell keeps whatever it
# held before — never DSH_FB_INK. Returns the bad-pixel count (+100000 when no ink reached the shadow).
fn dsh_fb_check() {
    var fs = 1;
    if (fb_height() > 1200) { fs = 2; }
    var fpitch = fb_pitch();
    var foff = (FB_CONSOLE_Y0 + dsh_fb_cy * 16 * fs) * fpitch + dsh_fb_cx * 8 * fs * 4;
    var ffb = fb_draw_base();
    var nink = 0;
    var nbad = 0;
    for (var fy = 0; fy < 16 * fs; fy = fy + 1) {
        for (var fx = 0; fx < 8 * fs; fx = fx + 1) {
            var fa = foff + fy * fpitch + fx * 4;
            var sv = load32(fb_shadow + fa);
            if (sv != load32(ffb + fa)) { nbad = nbad + 1; }
            if (sv == DSH_FB_INK) { nink = nink + 1; }
        }
    }
    if (nink == 0) { nbad = nbad + 100000; }
    return nbad;
}
# ramdisk arm (RAMDISK_ENABLE), in three phases across the switch. PRE (kernel CR3): sector 64 := pattern 21.
# UNDER: sector 64 must read back pattern 21 (an identity-VA ramdisk reads the 0xA5 region: +bad), then sectors
# 72..79 := pattern 29 and FLUSH. POST (kernel CR3): 72..79 must read pattern 29 (an identity-VA ramdisk wrote
# them into the 0xA5 region, so the real pages still hold zeros: +bad). Weights as dsh_blk.
fn dsh_rd_pre() {
    if (blk_is_registered(BLK_RAMDISK) == 0) { return 0; }
    store64(&dsh_ran + 5 * 8, 1);
    dsh_fill(&dsh_a, 4096, 21);
    if (blk_write_on(BLK_RAMDISK, 64, &dsh_a) != 0) { store64(&dsh_res + 5 * 8, 1000); }
    return 0;
}
fn dsh_rd_under() {
    if (load64(&dsh_ran + 5 * 8) == 0) { return 0; }
    var rb = 0;
    dsh_poison(&dsh_b, 4096);
    if (blk_read_on(BLK_RAMDISK, 64, &dsh_b) != 0) { rb = rb + 2000; }
    rb = rb + dsh_bad(&dsh_b, 512, 21);
    dsh_fill(&dsh_a, 4096, 29);
    if (blk_write_sectors_on(BLK_RAMDISK, 72, 8, &dsh_a) != 0) { rb = rb + 4000; }
    if (blk_flush_on(BLK_RAMDISK) != 0) { rb = rb + 16000; }
    store64(&dsh_res + 5 * 8, load64(&dsh_res + 5 * 8) + rb);
    return 0;
}
fn dsh_rd_post() {
    if (load64(&dsh_ran + 5 * 8) == 0) { return 0; }
    var rp = 0;
    dsh_poison(&dsh_b, 4096);
    if (blk_read_sectors_on(BLK_RAMDISK, 72, 8, &dsh_b) != 0) { rp = rp + 8000; }
    rp = rp + dsh_bad(&dsh_b, 4096, 29);
    store64(&dsh_res + 5 * 8, load64(&dsh_res + 5 * 8) + rp);
    return 0;
}
fn dma_shadow_selftest() {
    if (dsh_build() == 0) { kprintln("dmash: FAIL no memory for the shadow", 36); kprintln("dmash: done", 11); return 0; }
    var probe = pmm_alloc();
    var pk = dma_kva(probe);
    store64(pk, 0x5A5A5A5A5A5A5A5A);
    var hsave = hda_active_ctl;
    hda_active_ctl = 0;
    var hda_on = 0;
    if (load64(&hda_present) != 0) { if (load64(&hda_codec_mask) != 0) { hda_on = 1; } }
    var v0 = 0;
    if (hda_on == 1) { v0 = dsh_hda_vendor(); }
    var nsec = nvme_ns1_nsze / 2;
    dsh_rd_pre();                                 # 1.57.9: ramdisk sector 64 written on the kernel CR3
    var old = dm_read_cr3();
    var fl = kbd_irq_save();                      # IF=0 for the whole window: no ISR, no preemption, no CR3 switch
    cr3_load(dsh_cr3);
    # ---- under the shadow: no kprint (the console path is not what is under test — the fb arm calls the
    #      painter directly, under console_lock) ----
    var id_v = load64(probe);                     # the identity VA of a pmm page: MUST read the shadow
    var dm_v = load64(pk);                        # its direct-map alias: MUST read the real page
    var dz0 = dsh_dirty();                        # 1.57.9: the shadow region before any arm (0: nothing ran yet)
    dsh_blk(BLK_VIRTIO, 0, 64);
    dsh_blk(BLK_NVME, 1, nsec);
    dsh_prp(2, nsec + 64);
    dsh_blk(BLK_AHCI, 3, 64);
    var v1 = 0;
    var v2 = 0;
    if (hda_on == 1) { v1 = dsh_hda_vendor(); v2 = dsh_hda_vendor(); }
    var dz1 = dsh_dirty();
    dsh_fb_paint();
    var dz2 = dsh_dirty();
    dsh_rd_under();
    var dz3 = dsh_dirty();
    cr3_load(old);
    kbd_irq_restore(fl);
    hda_active_ctl = hsave;
    # ---- back on the caller's CR3 ----
    if (load64(&dsh_ran + 6 * 8) != 0) { store64(&dsh_res + 6 * 8, dsh_fb_check() + (dz2 - dz1)); }
    dsh_rd_post();
    store64(&dsh_res + 5 * 8, load64(&dsh_res + 5 * 8) + (dz3 - dz2));
    var shok = 0;
    if (id_v == 0xA5A5A5A5A5A5A5A5) { shok = 1; }
    if (dm_v != 0x5A5A5A5A5A5A5A5A) { shok = 2; }
    kprint("dmash: shadow", 13);
    if (shok == 1) { kprintln(" PASS (identity VA shadowed, direct map intact)", 47); }
    if (shok == 0) { kprintln(" FAIL the identity window was not shadowed (the test proves nothing)", 68); }
    if (shok == 2) { kprintln(" FAIL the direct map read the shadow", 36); }
    dsh_verdict("virtio", 6, 0);
    dsh_verdict("nvme", 4, 1);
    dsh_verdict("nvme-prp", 8, 2);
    dsh_verdict("ahci", 4, 3);
    kprint("dmash: hda", 10);
    if (hda_on == 0) { kprintln(" SKIP (no codec)", 16); } else {
        if (v0 != 0 - 1) { if (v1 == v0) { if (v2 == v0) { store64(&dsh_res + 4 * 8, 1); } } }
        if (load64(&dsh_res + 4 * 8) == 1) { kprint(" PASS", 5); } else { kprint(" FAIL", 5); }
        kprint(" vendor=", 8); kprint_hex(v0);
        kprint(" shadowed=", 10); kprint_hex(v1);
        kprintln("", 0);
    }
    # 1.57.9 — the CPU-only buffers (bad = mismatches + shadow-region words the arm dirtied), and the whole window:
    # no arm, DMA or CPU-only, may have stored through an identity VA (dz0 must be 0 too — nothing ran before it).
    dsh_verdict("fb", 2, 6);
    dsh_verdict("ramdisk", 7, 5);
    kprint("dmash: window", 13);
    if (dz3 == 0) { kprint(" PASS", 5); } else { kprint(" FAIL", 5); }
    kprint(" dirty=", 7); kprint_num(dz3);
    kprint(" (dma ", 6); kprint_num(dz1 - dz0);
    kprint(" fb ", 4); kprint_num(dz2 - dz1);
    kprint(" ramdisk ", 9); kprint_num(dz3 - dz2);
    kprintln(")", 1);
    kprintln("dmash: done", 11);
    return 0;
}
dma_shadow_selftest();
#endif
