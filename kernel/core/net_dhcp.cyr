# === DHCP client (split from net.cyr — 1.36.1 refactor, net.cyr split part 2) ===
# Pure source reorg; included in original order in agnos.cyr so the compiled unit
# (and binary) is byte-identical to the pre-split net.cyr. Depends on the net.cyr core.

# === DHCP client (1.32.0 bite G) ===
# Minimal RFC 2131 client: DISCOVER → OFFER → REQUEST → ACK. Removes the
# hardcoded net_ip=10.0.2.15 in main.cyr's net_init call; instead the
# kernel asks the DHCP server (SLIRP in QEMU; iron's gateway later) for
# an IP at boot. Likely fixes the bite-A scenario-1 SLIRP-inbound gap
# as a side effect — SLIRP only properly registers a guest after seeing
# a DHCP exchange.

var DHCP_MAGIC_0 = 0x63;
var DHCP_MAGIC_1 = 0x82;
var DHCP_MAGIC_2 = 0x53;
var DHCP_MAGIC_3 = 0x63;

var DHCP_STATIC_IP_VAL = 0xC0A8012A;   # 192.168.1.42
var DHCP_STATIC_GW_VAL = 0xC0A80101;   # 192.168.1.1
var DHCP_STATIC_NM_VAL = 0xFFFFFF00;   # 255.255.255.0

var dhcp_xid = 0;
var dhcp_pkt_buf[300];

# Find the data offset of a DHCP option by tag within an options blob.
# Returns -1 if not found or malformed. Returned offset points at the
# option DATA byte (post-tag, post-len).
#
# ⛔⛔ `need` IS NOT OPTIONAL, AND ITS ABSENCE WAS A REMOTE RING-0 STACK READ. Until 1.56.52 this
# function validated only that the DECLARED length FITS (`i + 2 + olen > opts_len`) and never that it
# is large enough for whoever is about to read it. Every one of the five call sites then read a FIXED
# width off the returned offset — 1 byte for option 53, 4 bytes for options 54/1/3/6 through
# `dhcp_load_u32_be`, which is four unguarded `load8`s. So a server (or anyone who can spoof one
# on-link during the boot exchange — the xid/chaddr match is the only barrier) sends a 1024-byte reply
# whose LAST option declares `olen = 0`. The option sits at `i = opts_len - 2`, the bound above passes
# exactly, the returned offset IS `opts_len`, and the 4-byte read starts at `&rx + 240 + (n - 240)`
# = `&rx + n` — up to 4 bytes past the end of `var rx[1024]`, which is FUNCTION-LOCAL and therefore
# 1024 BYTES. Those bytes become `net_gateway` / `net_dns_server` and are PRINTED to the console and
# into the klug ring. That is remotely-triggered kernel-stack disclosure — the same class as the
# 1.56.51 `net_recv_udp` fix — and it was filed as a P2.
# ⚠ The short-option case mis-parses even when it stays in bounds: a 1-byte option 3 makes
# `assigned_gw` one real byte plus three bytes of the NEXT option.
# ⭐ THE BOUND BELONGS IN THE HELPER, NOT AT EACH SITE. Five callers exist today and each new arm
# would have to remember; the same reasoning is written out at length above `is_user_array` in
# syscall.cyr. A caller that genuinely wants a variable-length option passes `need` = the minimum it
# will actually touch — never 0 as a way of opting out.
fn dhcp_find_option(opts, opts_len, tag, need) {
    var i = 0;
    while (i < opts_len) {
        var t = load8(opts + i);
        if (t == 0) { i = i + 1; continue; }       # pad
        if (t == 255) { return 0 - 1; }            # end
        if (i + 1 >= opts_len) { return 0 - 1; }
        var olen = load8(opts + i + 1);
        if (i + 2 + olen > opts_len) { return 0 - 1; }
        if (t == tag) {
            # ⛔ The reader needs `need` bytes; the option carries `olen`. Refuse rather than hand back
            # an offset the caller will read past. Refusing looks to the caller exactly like "option
            # absent", which every call site already handles.
            if (olen < need) { return 0 - 1; }
            return i + 2;
        }
        i = i + 2 + olen;
    }
    return 0 - 1;
}


#ifdef DHCP_OPT_SELFTEST
# ⭐⭐ THE DHCP OPTION-LENGTH GATE — hermetic, no network, no server, no timing.
#
# `dhcp_find_option` is a pure function over a caller-supplied buffer, so the whole remote attack is
# reproducible as an in-memory blob. That matters: the real trigger needs a hostile DHCP server on
# the boot exchange, which no smoke can arrange, and it is exactly why this sat unfixed as a "P2".
#
# ⛔ THE ARM THAT MATTERS IS #3 — the LAST option declaring len 0. That is the one whose returned
# offset equals opts_len, so the caller's 4-byte read starts one past the end of the blob. Arms 1-2
# are the honesty arms: without them "return -1 always" scores a pass and DHCP silently stops working.
var dhcpopt_buf[16];      # module scope => 16 u64 = 128 bytes; the blobs below use at most 12
fn dhcpopt_selftest() {
    var fail = 0;
    var b = &dhcpopt_buf;
    var i = 0;
    while (i < 16) { store64(b + i * 8, 0); i = i + 1; }

    # --- ARM 1: a well-formed 4-byte option is FOUND, and at the right offset ------------------
    # [0]=tag 3, [1]=len 4, [2..5]=data. Data offset must be 2.
    store8(b + 0, 3); store8(b + 1, 4);
    store8(b + 2, 10); store8(b + 3, 0); store8(b + 4, 0); store8(b + 5, 1);
    if (dhcp_find_option(b, 6, 3, 4) != 2) {
        kprintln("dhcpopt: a well-formed option was refused", 41);
        fail = 1;
    }
    # ⚠ And a 1-byte reader must still accept a 4-byte option — `need` is a MINIMUM, not an equality.
    if (dhcp_find_option(b, 6, 3, 1) != 2) {
        kprintln("dhcpopt: need was treated as an equality, not a minimum", 55);
        fail = 1;
    }

    # --- ARM 2: absent tag is still -1, and a well-formed blob does not become unreadable -------
    if (dhcp_find_option(b, 6, 54, 4) != 0 - 1) {
        kprintln("dhcpopt: an absent tag was reported as present", 46);
        fail = 1;
    }

    # --- ARM 3: THE ATTACK — the last option declares len 0 for a 4-byte reader -----------------
    # ⛔ This is the shape that read past `var rx[1024]`. Laid out so the option sits at
    # i = opts_len - 2: two pads, then tag 6 with declared length 0, opts_len = 4. The OLD bound
    # `i + 2 + olen > opts_len` substitutes to `2 + 2 + 0 > 4` = `4 > 4` = FALSE, so it passes EXACTLY
    # and returns offset i + 2 = 4 — which IS opts_len. A 4-byte read from there is off the end.
    # ⚠ The general statement is `offset == opts_len whenever i == opts_len - 2 and olen == 0`; the
    # numbers above are this blob`s, not the two-byte {tag, 0} variant`s.
    store8(b + 0, 0);                       # pad, so the option is genuinely last
    store8(b + 1, 0);
    store8(b + 2, 6); store8(b + 3, 0);     # tag 6 (DNS), declared length 0
    if (dhcp_find_option(b, 4, 6, 4) != 0 - 1) {
        kprintln("dhcpopt: a zero-length option was handed to a 4-byte reader", 59);
        fail = 1;
    }

    # --- ARM 4: a SHORT-but-nonzero option is refused too --------------------------------------
    # ⚠ Not the same arm as #3: this one stays in bounds and would have mis-parsed SILENTLY. The blob
    # below declares tag 3 with length 2 and data {10, 1}, followed by a second option {3, 4, 1,2,3,4}.
    # Under the old code the returned offset is 2 and dhcp_load_u32_be reads b[2..5] = 10, 1, 3, 4 —
    # so assigned_gw becomes 10.1.3.4: TWO real data bytes plus the NEXT option`s tag and len bytes.
    # (The function header`s "one real byte plus three" describes the 1-byte case, not this one.)
    # In bounds is not the same as correct, and a gate that only tested #3 would have let this through.
    store8(b + 0, 3); store8(b + 1, 2);
    store8(b + 2, 10); store8(b + 3, 1);
    store8(b + 4, 3); store8(b + 5, 4);
    store8(b + 6, 1); store8(b + 7, 2); store8(b + 8, 3); store8(b + 9, 4);
    if (dhcp_find_option(b, 10, 3, 4) != 0 - 1) {
        kprintln("dhcpopt: a 2-byte option was handed to a 4-byte reader", 54);
        fail = 1;
    }

    # --- ARM 5: a declared length that RUNS OFF the blob is still refused ----------------------
    # The pre-existing upper bound. Kept in the gate so a future edit cannot trade one for the other.
    store8(b + 0, 3); store8(b + 1, 200);
    if (dhcp_find_option(b, 6, 3, 4) != 0 - 1) {
        kprintln("dhcpopt: an option running past the blob was accepted", 53);
        fail = 1;
    }

    if (fail == 0) {
        kprintln("dhcpopt: option lengths are checked against the reader OK", 57);
        return 1;
    }
    kprintln("dhcpopt: OPTION LENGTH FAIL", 27);
    return 0;
}
#endif

fn dhcp_load_u32_be(p) {
    return (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
}

fn dhcp_store_u32_be(p, v) {
    store8(p, (v >> 24) & 0xFF);
    store8(p + 1, (v >> 16) & 0xFF);
    store8(p + 2, (v >> 8) & 0xFF);
    store8(p + 3, v & 0xFF);
    return 0;
}

# Build the fixed 240-byte BOOTP/DHCP header into `buf` (followed by
# `opts_len` bytes of options at offset 240). Returns total packet
# length (240 + opts_len).
fn dhcp_build_packet(buf, xid, opts, opts_len) {
    memset(buf, 0, 240);
    store8(buf, 1);          # op = BOOTREQUEST
    store8(buf + 1, 1);      # htype = ethernet
    store8(buf + 2, 6);      # hlen
    # hops = 0
    dhcp_store_u32_be(buf + 4, xid);
    # secs (2) + flags (2): set broadcast flag 0x8000
    store8(buf + 10, 0x80);
    # ciaddr/yiaddr/siaddr/giaddr (16 bytes) = 0
    # chaddr (16 bytes, MAC at first 6). FIX #1: use the active NIC's MAC,
    # not vnet_mac (which is zero on iron without virtio — DHCP servers
    # drop zero-chaddr requests per RFC 2131 §4.1).
    var kmac[8];
    nic_mac(&kmac);
    memcpy(buf + 28, &kmac, 6);
    # sname (64) + file (128) = 0
    # magic cookie at offset 236
    store8(buf + 236, DHCP_MAGIC_0);
    store8(buf + 237, DHCP_MAGIC_1);
    store8(buf + 238, DHCP_MAGIC_2);
    store8(buf + 239, DHCP_MAGIC_3);
    memcpy(buf + 240, opts, opts_len);
    return 240 + opts_len;
}

fn dhcp_print_ip(ip) {
    kprint_num((ip >> 24) & 0xFF); kprint(".", 1);
    kprint_num((ip >> 16) & 0xFF); kprint(".", 1);
    kprint_num((ip >> 8) & 0xFF); kprint(".", 1);
    kprint_num(ip & 0xFF);
    return 0;
}

# Run a full DHCP exchange. On success, updates net_ip/net_gateway/
# net_netmask in place; returns 0. On failure: returns -1, leaves
# net_init's pre-set values untouched.
fn dhcp_init() {
    if (nic_ready() == 0) { return 0 - 1; }
    # 1.32.4 Item 9 — DHCP_STATIC_IP fallback. When build defines
    # DHCP_STATIC_IP=1, skip the wire-DHCP cycle and assign network
    # config from constants above. Escape-plan step 6: unblocks
    # downstream networking validation (TCP server reachability,
    # REST endpoint testing) without depending on DHCP server reply.
    #ifdef DHCP_STATIC_IP
    net_ip = DHCP_STATIC_IP_VAL;
    net_gateway = DHCP_STATIC_GW_VAL;
    net_netmask = DHCP_STATIC_NM_VAL;
    kprint("dhcp: STATIC ip=", 16); dhcp_print_ip(net_ip);
    kprint(" gw=", 4); dhcp_print_ip(net_gateway);
    kprint(" mask=", 6); dhcp_print_ip(net_netmask);
    kprintln("", 0);
    return 0;
    #endif
    dhcp_xid = (timer_ticks * 64017 + 31337) & 0xFFFFFFFF;
    var lid = udp_bind(68);
    if (lid < 0) {
        kprintln("dhcp: udp_bind(68) failed", 25);
        return 0 - 1;
    }

    # ---- DISCOVER ----
    var opts[16];
    store8(&opts, 53); store8(&opts + 1, 1); store8(&opts + 2, 1);  # msg=DISCOVER
    store8(&opts + 3, 55); store8(&opts + 4, 3);                    # param-list
    store8(&opts + 5, 1); store8(&opts + 6, 3); store8(&opts + 7, 6);
    store8(&opts + 8, 255);                                          # end
    var plen = dhcp_build_packet(&dhcp_pkt_buf, dhcp_xid, &opts, 9);
    udp_send_from(0, 0xFFFFFFFF, 68, 67, &dhcp_pkt_buf, plen);
    kprintln("dhcp: DISCOVER", 14);

    # FIX #1 prep — capture our own MAC once so OFFER/ACK chaddr-match (FIX #4)
    # doesn't redo nic_mac() inside the per-iter loop.
    var our_mac[8];
    nic_mac(&our_mac);

    # ---- wait OFFER ----
    # (1.32.2 FIX #8) rx[1024] — function-local var X[N] is N bytes per
    # [[feedback_cyrius_var_array_u64_units]]. Matches udp_bind's
    # kmalloc(1024) and net_handle_udp's new 1016-byte cap.
    var rx[1024];
    var src_ip = 0;
    var src_port = 0;
    var offered_ip = 0;
    var server_id = 0;
    var got = 0;
    # FIX #5: budget bumped 200 → 800 iter (~2s → ~8s) — RFC 2131 §4.4.1
    # specifies 4s minimum × retries. Full exponential backoff deferred
    # to a later cycle; this is the minimum-viable extension.
    # (1.32.2 FIX #9) Retransmit DISCOVER at the midpoint of the wait
    # window. Same xid means the server treats both as the same DHCP
    # session and replies once; we just get a second window to catch the
    # reply if the first frame dropped (link not yet up post-autoneg)
    # or the first OFFER was lost in transit.
    var discover_plen = plen;
    for (var ti = 0; ti < 800; ti = ti + 1) {
        if (ti == 400) {
            udp_send_from(0, 0xFFFFFFFF, 68, 67, &dhcp_pkt_buf, discover_plen);
        }
        net_poll();
        var n = udp_recv_from(lid, &rx, 1024, &src_ip, &src_port);
        if (n >= 240) {
            # 1.32.4 Fix A (Item 3) — BOOTP op MUST be 2 (BOOTREPLY) per
            # RFC 2131 §4.1; 5-of-5 reference sources enforce. Without
            # this gate, a looped-back DISCOVER (op=1) with the right xid
            # would pass the matcher despite being structurally wrong.
            if (load8(&rx + 0) != 2) { arch_wait(); continue; }
            # 1.32.4 Fix B (Item 4) — Magic cookie {0x63,0x82,0x53,0x63}
            # MUST appear at offset +236 per RFC 2131 §3. Byte-by-byte
            # compare (NEVER a u32 literal — endianness trap per
            # dhcp-offer-downstream-audit.md § 7 silent-drop #5).
            # 4-of-5 reference sources validate (Linux/OpenBSD/FreeBSD/Plan 9).
            if (load8(&rx + 236) != DHCP_MAGIC_0) { arch_wait(); continue; }
            if (load8(&rx + 237) != DHCP_MAGIC_1) { arch_wait(); continue; }
            if (load8(&rx + 238) != DHCP_MAGIC_2) { arch_wait(); continue; }
            if (load8(&rx + 239) != DHCP_MAGIC_3) { arch_wait(); continue; }
            if (dhcp_load_u32_be(&rx + 4) == dhcp_xid) {
                # FIX #4: verify chaddr matches our hardware address
                # (RFC 2131 §4.1.1 — MUST). Without this, a colliding xid
                # from another client on the LAN could be accepted as ours.
                var chaddr_match = 1;
                for (var ci = 0; ci < 6; ci = ci + 1) {
                    if (load8(&rx + 28 + ci) != load8(&our_mac + ci)) {
                        chaddr_match = 0;
                    }
                }
                if (chaddr_match == 1) {
                    var oo = 240;
                    var mt_off = dhcp_find_option(&rx + oo, n - oo, 53, 1);
                    if (mt_off >= 0 && load8(&rx + oo + mt_off) == 2) {
                        offered_ip = dhcp_load_u32_be(&rx + 16);
                        var sid_off = dhcp_find_option(&rx + oo, n - oo, 54, 4);
                        if (sid_off >= 0) { server_id = dhcp_load_u32_be(&rx + oo + sid_off); }
                        got = 1;
                        break;
                    }
                }
            }
        }
        arch_wait();
    }
    if (got == 0) {
        kprintln("dhcp: OFFER timeout", 19);
        return 0 - 1;
    }
    kprint("dhcp: OFFER ip=", 15); dhcp_print_ip(offered_ip); kprintln("", 0);

    # ---- REQUEST ----
    store8(&opts, 53); store8(&opts + 1, 1); store8(&opts + 2, 3);  # msg=REQUEST
    store8(&opts + 3, 50); store8(&opts + 4, 4);                    # requested IP
    dhcp_store_u32_be(&opts + 5, offered_ip);
    store8(&opts + 9, 54); store8(&opts + 10, 4);                   # server id
    dhcp_store_u32_be(&opts + 11, server_id);
    store8(&opts + 15, 255);
    plen = dhcp_build_packet(&dhcp_pkt_buf, dhcp_xid, &opts, 16);
    udp_send_from(0, 0xFFFFFFFF, 68, 67, &dhcp_pkt_buf, plen);
    kprintln("dhcp: REQUEST", 13);

    # ---- wait ACK ----
    var assigned_mask = 0;
    var assigned_gw = 0;
    var assigned_dns = 0;
    got = 0;
    # FIX #5: same 800-iter budget for ACK; FIX #4: same chaddr match.
    # (1.32.2 FIX #9) Same midpoint REQUEST retransmit as DISCOVER.
    var request_plen = plen;
    for (var ti = 0; ti < 800; ti = ti + 1) {
        if (ti == 400) {
            udp_send_from(0, 0xFFFFFFFF, 68, 67, &dhcp_pkt_buf, request_plen);
        }
        net_poll();
        var n = udp_recv_from(lid, &rx, 1024, &src_ip, &src_port);
        if (n >= 240) {
            # 1.32.4 Item 10 — mirror Fix A + Fix B into ACK matcher.
            # Without these, post-REQUEST silent-drop has the same
            # shape as the OFFER silent-drop the cycle's audit framed.
            if (load8(&rx + 0) != 2) { arch_wait(); continue; }
            if (load8(&rx + 236) != DHCP_MAGIC_0) { arch_wait(); continue; }
            if (load8(&rx + 237) != DHCP_MAGIC_1) { arch_wait(); continue; }
            if (load8(&rx + 238) != DHCP_MAGIC_2) { arch_wait(); continue; }
            if (load8(&rx + 239) != DHCP_MAGIC_3) { arch_wait(); continue; }
            if (dhcp_load_u32_be(&rx + 4) == dhcp_xid) {
                var chaddr_match = 1;
                for (var ci = 0; ci < 6; ci = ci + 1) {
                    if (load8(&rx + 28 + ci) != load8(&our_mac + ci)) {
                        chaddr_match = 0;
                    }
                }
                if (chaddr_match == 1) {
                    var oo = 240;
                    var mt_off = dhcp_find_option(&rx + oo, n - oo, 53, 1);
                    if (mt_off >= 0) {
                        var mt = load8(&rx + oo + mt_off);
                        if (mt == 5) {
                            var nm_off = dhcp_find_option(&rx + oo, n - oo, 1, 4);
                            if (nm_off >= 0) { assigned_mask = dhcp_load_u32_be(&rx + oo + nm_off); }
                            var gw_off = dhcp_find_option(&rx + oo, n - oo, 3, 4);
                            if (gw_off >= 0) { assigned_gw = dhcp_load_u32_be(&rx + oo + gw_off); }
                            # Option 6 (RFC 2132 §3.8) — DNS server list; take the
                            # first 4-byte address. Requested in the DISCOVER
                            # param-list; captured here for the 1.35.x DNS stub.
                            var dns_off = dhcp_find_option(&rx + oo, n - oo, 6, 4);
                            if (dns_off >= 0) { assigned_dns = dhcp_load_u32_be(&rx + oo + dns_off); }
                            got = 1;
                            break;
                        }
                        if (mt == 6) {
                            kprintln("dhcp: NAK", 9);
                            return 0 - 1;
                        }
                    }
                }
            }
        }
        arch_wait();
    }
    if (got == 0) {
        kprintln("dhcp: ACK timeout", 17);
        return 0 - 1;
    }
    net_ip = offered_ip;
    net_netmask = assigned_mask;
    net_gateway = assigned_gw;
    # DNS resolver: prefer the lease's option 6; fall back to the gateway
    # (a LAN router almost always proxies DNS) when the lease omits it.
    if (assigned_dns != 0) { net_dns_server = assigned_dns; }
    if (assigned_dns == 0) { net_dns_server = assigned_gw; }
    kprint("dhcp: ACK ip=", 13); dhcp_print_ip(offered_ip);
    kprint(" gw=", 4); dhcp_print_ip(assigned_gw);
    kprint(" mask=", 6); dhcp_print_ip(assigned_mask);
    kprint(" dns=", 5); dhcp_print_ip(net_dns_server);
    kprintln("", 0);
    return 0;
}

fn net_copy_buf(dst, src, len) {
    memcpy(dst, src, len);
    return 0;
}

