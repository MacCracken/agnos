# === Orderly shutdown ========================================================
#
# agnos has never had one. `arch_halt()` is `cli; hlt; jmp $` — an unrecoverable
# spin, not a power state — and syscall #13 ("reboot") prints a line and calls it,
# so a userland reboot() today freezes the box with a DIRTY ext2 superblock. When
# the shell exits, kybernet returns and boot_finish spins in the same halt. Every
# one of those paths loses un-synced filesystem state.
#
# This file is the shutdown sequence, built as a ladder. Bite 1 is ONLY the
# durability barrier: make stopping safe before making it stop. Device quiesce
# (storage / net / USB / audio / GPU), the ACPI FADT + \_S5 decode, reset and
# S5 poweroff all land in later bites on top of power_flush().
#
# Deliberately NOT here, both decided against on evidence:
#   - a jbd2 commit. The journal is inert on this tree (ext2_write_at_journaled
#     has no callers, ext2_jbd2_tx_active is 0 on real writes), so commit_tx would
#     log an error that means nothing, and "fixing" that would rewrite the journal
#     superblock of the dev box's root on every shutdown.
#   - IOMMU teardown. VT-d never runs on this box (AMD publishes IVRS, not DMAR,
#     so acpi_iommu_base stays 0) and amd_iommu_disable() already ran at boot.

# The durability barrier: everything write() has acknowledged reaches stable media.
#
# Order is load-bearing. The write-back sweep runs FIRST because it calls
# vfs_write_on — it produces new dirty filesystem state, so flushing before it
# would flush a snapshot that is immediately made stale. ext2_sync() then marks
# EXT2_VALID_FS and writes the superblock, and its own trailing blk_flush_on()
# pushes the controller-acked data through the drive's volatile cache. The
# remaining backends are flushed after, because a box can have ext2 + FAT/exFAT
# mounted on different devices and only ext2's own flush is implicit.
#
# fs_lock is taken ONCE around the sweep and the sync together: the syscall paths
# hold it across exactly these calls, neither routine takes it internally, and it
# is not reentrant. Device flushes go outside it — block/nvme/ahci take their own
# locks, and fs < ahci is the established forward order.
fn power_flush() {
    var b0 = 0 - 1;
    var b1 = 0 - 1;
    var b2 = 0 - 1;
    var b3 = 0 - 1;

    fs_spin_lock();
    vfs_wfile_sweep_all();
    # 1.57.12 B11 — the ZFS pool's pending policy-B txg COMMITTED before the machine stops (zfs_write.cyr zfs_wp_sync:
    # its own two device flushes; the per-backend flushes below find nothing of ZFS's left volatile)
    # (B11 review) WITHOUT interrupt windows (zfs_wirq_no): power_stop_final's teardown runs IF=0 on purpose — the tick's
    # hid_poll / net / wq must not run across it — and every power_flush caller is a terminus, so the latch stays set
    zfs_wirq_no = 1;
    if (zfs_wp_sync() != 0) { kprintln("power: a ZFS commit failed - its pending writes are lost", 56); }
    if (ext2_active != 0) { ext2_sync(); }
    fs_spin_unlock();

    # Flush each DISTINCT active backend. vfs_sync_secondary() is not used: it
    # early-returns after its FAT branch, so a box with FAT and exFAT mounted at
    # once would silently flush only FAT.
    b0 = blk_active;
    if (ext2_active  != 0) { b1 = ext2_backend; }
    if (fatfs_active != 0) { b2 = fat_backend; }
    if (exfat_active != 0) { b3 = exfat_backend; }

    if (b0 >= 0) { blk_flush_on(b0); }
    if (b1 >= 0) { if (b1 != b0) { blk_flush_on(b1); } }
    if (b2 >= 0) { if (b2 != b0) { if (b2 != b1) { blk_flush_on(b2); } } }
    if (b3 >= 0) { if (b3 != b0) { if (b3 != b1) { if (b3 != b2) { blk_flush_on(b3); } } } }

    kprintln("power: filesystems flushed", 26);
    return 0;
}

# Bite 4 — stop the storage DMA engines. Runs AFTER power_flush(), never before:
# every one of these calls ends the controller's ability to service I/O, so a flush
# issued afterwards would have nothing to run on. The ordering is the whole point of
# splitting the two.
#
# Best-effort by design. A controller that refuses to stop must not wedge the
# shutdown — it reports and the sequence continues, because a box that will not
# power off is worse than one that powers off with a port still running. What it
# must NOT do is pretend: ahci_port_stop() returns a real status precisely so a
# failure is visible rather than silently assumed.
fn power_storage_quiesce() {
    var port = 0;
    var stopped = 0;
    var failed = 0;

    # NVMe first: it is the primary block device on this box, and its shutdown
    # notification is the one that makes the drive commit its own write cache.
    nvme_shutdown();

    # Then every AHCI port that was actually brought up. A zero command-list
    # address means the port was never initialised, so there is nothing running.
    if (ahci_present != 0) {
        port = 0;
        while (port < AHCI_MAX_PORTS) {
            if (load64(&ahci_port_cl_kva + port * 8) != 0) {
                if (ahci_port_stop(port) == 1) { stopped = stopped + 1; }
                else { failed = failed + 1; }
            }
            port = port + 1;
        }
    }

    if (failed != 0) {
        kprint("power: ", 7); kprint_num(failed);
        kprintln(" storage ports would not stop", 29);
    }
    # Terminal marker for the sequence so far. A test can gate on this instead of
    # racing the poll budgets above — without it, a harness that kills the machine a
    # couple of seconds after the flush line simply truncates the log before any of
    # this appears, and the absence looks like the code never ran.
    kprintln("power: storage quiesced", 23);
    return 0;
}

# Bite 5 — the full device teardown, in the order that matters.
#
# THE ORDER IS THE DESIGN, not a style choice:
#   1. filesystems      — must precede everything; every step below ends some
#                         controller's ability to serve the I/O a flush would need.
#   2. audio            — the HDA controllers are DMA engines AND the RIRB is a
#                         device-WRITE target; stopping them before memory is
#                         reclaimed is what prevents async scribbles into reused
#                         pages. (This is also what stops the amp popping.)
#   3. GPU              — a mapped MEC queue with a live doorbell and a PQ base in
#                         DRAM outlives a warm reset, so it must be deactivated
#                         before any reset hands that memory to the next boot.
#                         Display/scanout deliberately untouched — the console has
#                         to stay readable through the rest of the sequence.
#   4. network          — mask, ack, detach MSI, reset.
#   5. storage          — the NVMe shutdown notification lets the drive commit.
#   6. USB              — LAST, because on this box it is also the KEYBOARD. Taking
#                         it down earlier means an operator watching a stalled step
#                         has no way to interact with the machine.
fn power_quiesce_devices() {
    power_flush();
    # Bite 11 — the HDMI audio teardown, gated OFF by default. It runs FIRST among
    # the device steps: the mute has to reach the sink before the data island stops.
    # It is opt-in because the shutdown pop is still the A4 sub-arc's only sink-side
    # instrument, and a silent unconditional teardown would remove it before A4 closes.
    #ifdef BURN_AUDIO_TEARDOWN
    gpu_hdmi_audio_disable();
    #endif
    hda_quiesce_all();
    gpu_quiesce();
    r8169_quiesce();
    power_storage_quiesce();
    xhci_stop();
    # ⭐ REPORT THE HID HALT TALLY ON EVERY STOP PATH. Until now `hid_halt_flagged` was printed ONLY
    # from the DECLINED branch in hid_recover_halted — so an operator trying to PROVOKE an endpoint
    # stall on iron got silence when the provocation missed, and silence is indistinguishable from
    # "a stall happened and something swallowed it". That made the roadmapped HID burn unfalsifiable
    # in the one way that matters: you could not tell a failed attempt from a failed driver.
    # ⇒ Printing it here, after xhci_stop and before the quiesce line, means ANY deliberate stop
    # (`poweroff`, `reboot`, `halt`, or agnsh `exit`) answers the burn's first question — did a
    # halting completion code EVER reach the driver this boot — with a number instead of an absence.
    # ⚠ Thread context, post-teardown: kprint is legal here. The ISR only ever increments.
    # ⚠ flagged 0 on a burn attempt means THE PROVOCATION FAILED, not that recovery is broken. That
    #   is a VOID result and must be recorded as one.
    kprint("power: hid halt tally (flagged/confirmed/declined) ", 51);
    kprint_num(hid_halt_flagged);
    kprint("/", 1);
    kprint_num(hid_halt_confirmed);
    kprint("/", 1);
    kprint_num(hid_halt_declined);
    kprintln("", 0);
    # The stolen-event counter answers the OTHER half — whether any HID Transfer Event was consumed
    # by a synchronous xHCI waiter and handed back. 0 means the reclaim path never ran, so a clean
    # keyboard proves nothing about it.
    kprint("power: hid stolen-event reclaims ", 33);
    kprint_num(hid_stolen_events);
    kprintln("", 0);
    kprintln("power: devices quiesced", 23);
    return 0;
}

# === Bite 7 — the reset ladder ==============================================
#
# Four methods, tried in the order Linux tries them, each falling through to the
# next. None of them returns if it works, so the code after a step only runs
# because that step did nothing.
#
# ⚠ CF9 HAZARD, and it is the reason the ladder is ordered this way: on the AMD FCH
# a CF9 write of 0x0E is a genuine S5 POWER-CYCLE, not a warm reset — the box goes
# off and stays off. So the manual CF9 fallback here writes 0x02 then 0x06 and NEVER
# 0x0E. (The FADT's own RESET_VALUE is a separate matter: that is the firmware's
# advertised value and following it is the spec-sanctioned path, which is why it is
# tried first. QEMU advertises 0xf there. If archaemenid's firmware advertises an
# 0x0E-shaped value, the first rung will power the box off rather than reboot it —
# the read-only FADT report from bite 2 prints the exact value, so check it in the
# burn log BEFORE flashing a kernel that can reach this function.)
#
# ⚠ CF9 also sits inside the 0xCF8 CONFIG_ADDRESS dword window. Linux gates that
# write behind positive identification of PCI mechanism 1. agnos's whole PCI layer
# is mechanism-1 config cycles (pci_read32/pci_write32 use 0xCF8/0xCFC and the bus
# enumerated), so mechanism 1 is proven by the fact that we found any device at all
# — gate on that rather than assuming it.
fn power_reset() {
    var i = 0;
    var st = 0;

    kprintln("power: resetting", 16);

    # 1. ACPI RESET_REG — the firmware's own advertised method. Only meaningful from
    #    FADT revision 2, only when the RESET_REG_SUP flag is set, and only for an
    #    address space we can actually write.
    if (acpi_reset_ok == 1) {
        if (acpi_reset_space == 1) {                  # SystemIO
            outb(acpi_reset_addr, acpi_reset_value);
            gpu_udelay(15000);                        # spec allows 15 ms to take effect
        }
        if (acpi_reset_space == 0) {                  # SystemMemory
            # ⛔⛔ 1.56.52 — SKIP THE RUNG RATHER THAN FAULT ON IT. `acpi_reset_addr` comes straight out
            # of the FADT GAS (`acpi_gas_addr(116)`) and is never translated; the arming logic gates on
            # FADT revision, RESET_REG_SUP and non-zero, but never on `< 4 GB`. A bare
            # `store8(acpi_reset_addr, …)` on firmware advertising a SystemMemory RESET_REG at or above
            # 4 GB writes an address the page tables do not map, and a CPL0 #PF here is a HANG on the
            # last-ditch reboot path — so rungs 3 (CF9) and 4 (triple fault) never run.
            # ⛔ AND `acpi_va` IS NOT THE FIX, THOUGH IT LOOKS LIKE ONE — that was this code for an hour.
            # Two independent reasons, either fatal: (a) `acpi_va` only takes its DIRECTMAP_BASE branch
            # when the live CR3 is the kernel PML4 (0x1000), and `power_reset` reaches here through
            # syscall #13 running on the CALLING PROCESS`s CR3, so it falls to `return phys` and hands
            # back exactly the raw address it was called to translate; (b) even under CR3 0x1000 the
            # direct map only covers `pmm_memmap_ram_top`, which is EfiConventionalMemory only — and a
            # SystemMemory RESET_REG at >= 4 GB is by construction a device register OUTSIDE type-7
            # RAM, i.e. precisely the class the direct map does not carry. Mapping it properly means
            # `vmm_remap_uc_2mb` (which also gives it the UC attribute the WB direct-map PDEs lack).
            # ⭐ SO: REFUSE THE RUNG AND FALL THROUGH. `iommu.cyr` sets the precedent for exactly this
            # ("amdvi: mmio above 4 GB (rare), skipping"). Skipping costs nothing a working box wanted —
            # CF9 is right below and works on every PC-compatible chipset — while faulting costs the
            # reboot entirely. A UC remap would be the complete answer if a box ever needs it.
            # ⚠ Unexercisable on this bench: archaemenid`s boot log prints `acpi: reset register
            # space 1 address b2` — SystemIO, the other arm entirely.
            if (acpi_reset_addr >= 0x100000000) {
                kprintln("acpi: SystemMemory RESET_REG >= 4 GB is unmapped - skipping to CF9", 66);
            } else {
                store8(acpi_reset_addr, acpi_reset_value);
            }
            gpu_udelay(15000);
        }
    }

    # ⛔ RUNG 2 WAS THE 8042 KEYBOARD-CONTROLLER PULSE and is DELETED (2026-08-08, operator ruling: no
    #    i8042 in agnos in any capacity). It polled status port 0x64 and pulsed command 0xFE. Its own
    #    comment already conceded it was "very likely dead on this box (USB-only, no PS/2 chip)".
    # ⚠ The ladder is not weakened: rung 1 (ACPI RESET_REG) is live on archaemenid — the boot log prints
    #    `acpi: reset register space 1 address b2 value be` — and rung 3 (CF9) remains behind it.

    # 3. CF9 two-step, warm only. Gated on PCI mechanism 1 being proven.
    if (pci_count > 0) {
        outb(0xCF9, 0x02);                            # RST_CPU armed
        gpu_udelay(1000);
        outb(0xCF9, 0x06);                            # SYS_RST | RST_CPU  (NEVER 0x0E)
        gpu_udelay(15000);
    }

    # 4. Triple fault. A zero-limit IDT means the next interrupt cannot be dispatched,
    #    cannot be escalated to a double fault handler either, and the CPU shuts down
    #    and resets. Crude, universally effective, and the reason there is no fifth rung.
    asm {
        0x48; 0x31; 0xC0;                             # xor rax, rax
        0x50;                                         # push rax  (base 0)
        0x66; 0x50;                                   # push ax   (limit 0)
        0x0F; 0x01; 0x1C; 0x24;                       # lidt [rsp]
        0xCC;                                         # int3 -> no IDT -> triple fault
    }

    kprintln("power: platform did not reset", 29);
    return 0;
}

# === Bite 9 — ACPI S5 soft-off ==============================================
#
# ⚠ THE SINGLE MOST DANGEROUS FUNCTION IN THIS ARC. SLP_TYP does not mean "power
# off" — it selects WHICH sleep state. A value the platform reads as S1/S3 SUSPENDS
# the machine with interrupts already disabled, no wake vector armed and no resume
# path: indistinguishable from a hard hang, recoverable only by holding the power
# button. That is why the values are not guessed. They come from the DSDT's own
# \_S5_ package (bite 3), were cross-checked against `iasl -d` on archaemenid's real
# firmware (SLP_TYPa=5, SLP_TYPb=0), and are refused outright if the decode looks
# wrong. QEMU CANNOT validate any of this — its _S5_ is all zeroes, so a broken
# decode "works" there by construction.
#
# The device teardown runs BEFORE this (power_sys calls power_quiesce_devices), so
# even a wrong S-state costs a power-button hold rather than the filesystem.
fn power_off() {
    var cnt = 0;
    var spins = 0;
    var base = 0;

    if (acpi_fadt_addr == 0) {
        kprintln("acpi: no FADT -- cannot power off", 33);
        return 0;
    }
    if (acpi_s5_valid == 0) {
        kprintln("acpi: no _S5_ values -- cannot power off", 40);
        return 0;
    }
    if (acpi_pm1a_cnt == 0) {
        kprintln("acpi: no power control block -- cannot power off", 48);
        return 0;
    }
    # A hardware-reduced platform has no fixed PM hardware at all; driving PM1 there
    # would be writing to something that is not the power controller.
    if (acpi_hw_reduced == 1) {
        kprintln("acpi: hardware-reduced platform -- PM1 soft-off does not apply", 62);
        return 0;
    }
    # SLP_TYP is a 3-bit field. bite 3 already range-checks, but this is the last
    # gate before the write actually happens, so it checks again rather than trusting.
    if (acpi_slp_typa > 7) {
        kprintln("acpi: sleep type out of range -- refusing to write", 50);
        return 0;
    }
    # ⭐ 1.56.60 — THE PARSED PM1_CNT_LEN IS NOW LOAD-BEARING INSTEAD OF DECORATIVE. It was parsed
    # (acpi.cyr, FADT offset 89) and printed and used for NOTHING: every access below hardcodes
    # inw/outw, i.e. 16 bits. That is correct for the spec-mandated width of 2, but the kernel was
    # asserting nothing and would have driven a 16-bit write at a differently-sized register while
    # printing the real width to the console.
    # ⚠ REFUSE ONLY ON A PRESENT-AND-WRONG VALUE. A zero means the field was absent or unparsed, in
    # which case this gate must not fire — refusing there would stop a box that powers off correctly
    # today, and "no measurement" is not "a bad measurement".
    # ⚠ MEASURED BEFORE SHIPPING, on both platforms this tree can verify: archaemenid iron reports
    # `acpi: power control pm1a 804 pm1b 0 width 2`, and QEMU/OVMF reports `... pm1a 604 pm1b 0
    # width 2`. Neither can trip this gate. Re-measure before tightening it further.
    if (acpi_pm1_cnt_len != 0) {
        if (acpi_pm1_cnt_len != 2) {
            kprintln("acpi: PM1_CNT_LEN is not 2 -- refusing a 16-bit soft-off write", 62);
            return 0;
        }
    }

    # 1. Clear WAK_STS (PM1a_STS bit15, write-1-clear) — status hygiene before the sleep write,
    #    so the platform does not enter S5 with a stale "already woken" bit latched.
    # ⚠ 1.56.60 — THIS COMMENT USED TO SAY "so the post-write poll below means something". THERE IS
    #    NO POST-WRITE POLL. Step 5 is a bare bounded counter that never reads PM1a_STS, and the
    #    `var done = 0;` this function declared for that poll had exactly one occurrence in the whole
    #    body — its own declaration — so it has been removed. The clear itself is kept because it is
    #    correct on its own terms; only the claim about it was false. If a real poll is ever written,
    #    keep it BOUNDED for the reason step 5 states.
    if (acpi_pm1a_evt != 0) { outw(acpi_pm1a_evt, 0x8000); }

    # 2. Make sure we are actually in ACPI mode. If SCI_EN is clear the firmware is
    #    still in legacy/SMI mode and will IGNORE the SLP_TYP write entirely — the
    #    machine would just sit there. The handshake is the SMI_CMD port + the FADT's
    #    ACPI_ENABLE value, then poll for SCI_EN to come up.
    cnt = inw(acpi_pm1a_cnt);
    if ((cnt & 0x1) == 0) {
        if (acpi_smi_cmd != 0) {
            outb(acpi_smi_cmd, acpi_enable_val);
            spins = 0;
            while (spins < 300000) {
                cnt = inw(acpi_pm1a_cnt);
                if ((cnt & 0x1) != 0) { spins = 300000; }
                else { spins = spins + 1; }
            }
        }
    }

    # 3. THE WRITE, as a two-step split — SLP_TYP first, then SLP_TYP|SLP_EN. Some
    #    firmware latches the type on the first write and acts on the enable edge;
    #    a single combined store is accepted by most and ignored by some.
    #
    #    ⚠ READ-MODIFY-WRITE, never a blind store. A bare `outw(port, typ<<10|EN)`
    #    would zero SCI_EN (bit0) and BM_RLD (bit1) in the same instruction, dropping
    #    the machine out of ACPI mode mid-shutdown — after which the firmware ignores
    #    the very write that just disabled it. Clear ONLY SLP_TYP + SLP_EN.
    base = inw(acpi_pm1a_cnt) & (0 - 1 - 0x1C00) & (0 - 1 - 0x2000);
    outw(acpi_pm1a_cnt, base | (acpi_slp_typa << 10));
    outw(acpi_pm1a_cnt, base | (acpi_slp_typa << 10) | 0x2000);

    # 4. PM1b, ONLY if the platform actually has one.
    #    ⚠ An unconditional write here targets I/O port 0 on every box whose PM1b is
    #    absent (QEMU and the AMD FCH both) — and port 0 is the 8237 DMA channel-0
    #    address latch, not a void. It also carries SLP_TYPb, which is a DIFFERENT
    #    value from SLP_TYPa; copying A into B is a common and silent bug.
    # ⛔ 1.56.51 — A SEPARATE `baseb`, NOT A REASSIGNMENT OF `base`. This block used to overwrite
    # `base` with the value read from PM1b_CNT, and step 6 below then re-issued its retry pulse to
    # PM1a_CNT carrying PM1b's bits. That is precisely what the read-modify-write comment above
    # forbids: the two registers hold DIFFERENT SCI_EN/BM_RLD state, so the retry could clear
    # SCI_EN on PM1a and drop the machine out of ACPI mode — after which the firmware ignores the
    # very write meant to power it off. `base` is now PM1a's for the whole function.
    if (acpi_pm1b_cnt != 0) {
        var baseb = inw(acpi_pm1b_cnt) & (0 - 1 - 0x1C00) & (0 - 1 - 0x2000);
        outw(acpi_pm1b_cnt, baseb | (acpi_slp_typb << 10));
        outw(acpi_pm1b_cnt, baseb | (acpi_slp_typb << 10) | 0x2000);
    }

    # 5. Wait for the platform to go. This is a bounded DELAY, not a status poll — see step 1.
    #    ⚠ ACPICA's equivalent poll is UNBOUNDED; ours
    #    must not be — interrupts are off and the filesystem is already quiesced, so
    #    an infinite spin here is a silently bricked session with no console output.
    #    A machine that is going to power off does so in microseconds; this budget is
    #    generous by orders of magnitude.
    spins = 0;
    while (spins < 2000000) { spins = spins + 1; }

    # 6. ACPICA's documented retry: re-issue a bare SLP_EN edge. Some firmware wants
    #    the enable pulse a second time after the type has settled.
    outw(acpi_pm1a_cnt, base | (acpi_slp_typa << 10) | 0x2000);
    spins = 0;
    while (spins < 2000000) { spins = spins + 1; }

    kprintln("acpi: platform did not power off", 32);
    return 0;
}

# === The syscall body ========================================================
#
# WHY MAGIC NUMBERS, and it is not cargo-culting Linux. Syscall #13 already exists
# and cyrius already exposes it as a NULLARY `sys_reboot()`. The cyrius `syscall()`
# builtin pops exactly the N argument registers its call site names, so every
# already-compiled caller of the old nullary form delivers GARBAGE in rdi/rsi/rdx.
# Without a token the first such caller to run would halt or reset the box at
# random. The magic pair makes that garbage fail closed. That is the same reason
# Linux's reboot(2) carries them, and it applies here verbatim.
#
# It is also the privilege gate, deliberately: `getuid` is hardcoded 0 and there is
# no uid model, so a uid check would be a gate that is always open.
# ⭐ 1.56.56 — AND THAT IS PERMANENT, NOT PROVISIONAL. agnosticos
# `planning/identity-and-authorization-model.md` (2026-05-12) rejects "Account/uid as multi-user
# primitive" outright in favour of "fine-grained by capability (kavach, t-ron)", and rejects
# "Sudo-and-retype-password for privilege" in favour of "physical presence + capability token".
# `getuid` returning 0 is the decision, not a gap awaiting one — so this magic-token gate is not
# waiting to be replaced by a uid check. Its eventual successor is a kavach capability gate in
# userland. An init-only
# (pid == 0) check would make a shell builtin a silent no-op, since agnsh runs as
# its own pid. Magic-token arming is the established idiom in this tree — the same
# shape as blk_rw_armed.
var PWR_MAGIC1 = 0x50575231;   # "PWR1"
var PWR_MAGIC2 = 0x50575232;   # "PWR2"
var PWR_HALT   = 1;
var PWR_OFF    = 2;
var PWR_REBOOT = 3;

fn power_sys(magic1, magic2, cmd, arg) {
    if (magic1 != PWR_MAGIC1) { return 0 - 1; }
    if (magic2 != PWR_MAGIC2) { return 0 - 1; }

    # ⭐ 1.56.60 — REJECT AN UNKNOWN cmd HERE, BEFORE ANYTHING IS TORN DOWN. Until now the three
    # cmd tests were the only ones and everything else FELL THROUGH to the halt terminus at the
    # bottom — so a correctly-magicked call with cmd=0 or cmd=99 disarmed the modeset latch, flushed,
    # quiesced every device including the USB keyboard, and then wedged the box. A caller that asked
    # for something this kernel does not implement deserves -1 and a live machine, which is what
    # Linux reboot(2) does with -EINVAL.
    # ⚠ THE DISTINCTION IS "cmd 1 IS halt" (keep) vs "anything unknown IS halt" (reject). PWR_HALT
    # reaching arch_halt() below is a live, documented agnsh verb — agnoshi/src/commands.cyr:36
    # "Stop the machine without powering off", matching Linux's LINUX_REBOOT_CMD_HALT — and is NOT a
    # fall-through. Do not collapse the two.
    if (cmd != PWR_HALT) {
        if (cmd != PWR_OFF) {
            if (cmd != PWR_REBOOT) { return 0 - 1; }
        }
    }

    # ⭐ 1.56.38 — THE MODESET LATCH IS RELEASED HERE, AND NOWHERE ELSE THE OPERATOR CAN REACH.
    #
    # The latch arms before a risky modeset so a write that blanks the panel cannot repeat on the next
    # boot. It needs a disarm, and the disarm needs an oracle that can tell a working display from a dead
    # one. ⛔ "The modeset returned success" CANNOT: the OTG frame counter free-runs off the PLL and reads
    # perfectly healthy on a black panel, so disarming on it would clear the latch for the exact failure it
    # exists to catch — a boot loop, with a boot-time modeset.
    #
    # ⭐ A CLEAN SHUTDOWN IS THAT ORACLE. Reaching here means the operator drove the machine to a
    # deliberate stop: the display worked well enough to use it. A modeset that blanked the panel makes
    # this unreachable — the operator holds the power button instead, the latch survives untouched, and the
    # next boot refuses the modeset and comes up on the inherited mode with a working console.
    #
    # ⇒ The latch's state now means exactly one thing: **the previous session did not end cleanly.** That
    # is a system-lifecycle fact, not a file for a human to manage. `rm /.modeset-armed` still works as an
    # escape hatch, but it is no longer the routine path and the kernel no longer instructs anyone to use
    # it — a recovery mechanism the operator has to remember to run by hand is a mechanism that gets run at
    # the wrong times, and it was run before all six burns of the 1.56.36/37 arc.
    #
    # ⚠ BEFORE power_quiesce_devices(), deliberately: the disarm unlinks and FLUSHES the filesystem, so it
    # must happen while the block device is still live. Quiescing first would leave the write nowhere to go.
    modeset_disarm_on_shutdown();

    # Every command shares the teardown. Getting the machine into a safe state is
    # not conditional on which way it is being stopped.
    power_quiesce_devices();

    if (cmd == PWR_REBOOT) {
        power_reset();
        # power_reset() only returns when every rung failed.
        kprintln("power: halted (reset unavailable)", 33);
        arch_halt();
        return 0;
    }
    if (cmd == PWR_OFF) {
        power_off();
        # power_off() only returns when the platform declined or refused a gate; it
        # has already said which on the console. Halting is then the honest outcome.
        kprintln("power: halted (soft-off unavailable)", 36);
        arch_halt();
        return 0;
    }

    kprintln("power: halted", 13);
    arch_halt();
    return 0;
}

# === The non-syscall stop terminus ===========================================
#
# ⭐ 1.56.60 — WHERE THE MACHINE ENDS UP WHEN NOBODY ASKED IT TO STOP.
#
# core/boot_finish.cyr's tail is reached whenever kybernet() RETURNS: agnsh `exit`/`quit`, the
# emergency shell falling out of its loop, or agnsh failing to exec at all. It is not a power
# request — halting is the recorded intent (agnosticos iron-nuc-zen-log.md:3429, "the machine is
# deliberately unusable after `exit` until a power cycle — that is the intended new behavior") —
# but until now that tail was a bare `power_quiesce_devices(); arch_halt();` with two defects:
#
#   1. IT NEVER DISARMED THE MODESET LATCH. modeset_disarm_on_shutdown() had exactly ONE caller
#      tree-wide, power_sys():406, so a deliberate stop through this path left /.modeset-armed set
#      and the NEXT boot printed "last session did not end cleanly -- modeset SKIPPED this boot".
#      Backwards: reaching a shell and typing a stop verb IS the display-worked oracle the latch
#      design depends on. CHANGELOG.md:5088 claimed the disarm "covers reboot, poweroff and halt
#      alike" — true only of agnsh's cmd-1 halt, and false here.
#   2. IT SAID NOTHING. The operator's last console line was "power: devices quiesced", a normal
#      progress line, on a box that was already dead and still powered. Every power_sys terminus
#      names itself ("power: halted", ":415", ":423"); this one did not, which is a large part of
#      why "halt doesn't shutdown completely" read as a mystery rather than as a state.
#
# ⚠ NOT a power_sys() call. power_sys validates a magic pair meant for a ring-3 caller and would
# route cmd 1 through the same teardown — but this path must stay callable with no arguments,
# because scripts/ktest.sh and scripts/bench.sh rewrite boot_finish's launch line by sed and a
# nullary terminus is what keeps that rewrite a one-token substitution.
# ⚠ ORDER IS LOAD-BEARING: disarm BEFORE quiesce. The disarm unlinks and FLUSHES the filesystem,
# so the block device must still be live — quiescing first would leave the write nowhere to go.
# Same constraint power_sys:404-405 documents.
fn power_stop_final() {
    # ⛔ 1.57.6 (Path 2, S3.3): interrupts OFF first. kmain now reaches this terminus IF=1 (every exec_and_wait
    # caller hands kmain its own IF back), and the teardown below assumes the SYSCALL environment power_sys
    # runs in — IF=0, so the tick's hid_poll / do_context_switch cannot run across the xhci_stop and the
    # final flush (io.cyr arch_cli's banner). Contract: arch_cli touches only RFLAGS.IF.
    arch_cli();
    modeset_disarm_on_shutdown();
    power_quiesce_devices();
    kprintln("power: stopped -- hold the power button to remove power", 55);
    arch_halt();
    return 0;
}

# === The power source: power_source#114 (1.57.18) ============================
#
# Issue 2026-11-06-no-way-to-read-the-power-source (daimon 2.5.4: crab's index "pauses on battery"). Operator
# ruling 2026-11-08: answer from an ACPI NAMESPACE SCAN at boot. No AML interpreter and no EC driver this cut.
#
# WHAT MAINSTREAM KERNELS DO, AND WHERE THIS DEPARTS. Linux binds drivers/acpi/battery.c to every PNP0C0A device
# and drivers/acpi/ac.c to every ACPI0003 one; the answer comes from EVALUATING AML — acpi_bus_get_status runs _STA,
# ac.c runs _PSR (1 = on line), battery.c runs _BST — through ACPICA, which walks the namespace it built by loading
# the DSDT and every SSDT (acpi_ns_walk_namespace). FreeBSD's acpi_acad.c / acpi_cmbat.c do the same through the same
# ACPICA. systemd's on_ac_power() then reads /sys/class/power_supply: an online Mains supply says AC, an offline one
# says battery, and NO Mains supply at all says AC (the desktop case); upower's on-battery needs a discharging battery.
# agnos has no interpreter, so it PATTERN-MATCHES the bytes instead of evaluating them, like acpi_find_s5 does for
# \_S5_. That can answer exactly one of the three questions honestly:
#   no battery device declared anywhere          -> MAINS (inferred: nothing else could power the machine — the
#                                                   on_ac_power / upower answer for a box with no battery);
#   every declared battery's _STA is a CONSTANT  -> MAINS (desktop firmware declares a disabled battery this way);
#     with bit 0 (present) clear
#   any other battery                            -> CANNOT SAY: only _PSR / _BST evaluation could answer, and the
#                                                   BATTERY state (2) stays reserved for that interpreter;
#   no usable ACPI tables, or a table fails a    -> CANNOT SAY.
#     bound check
# An AC adapter (ACPI0003) is REPORTED, never decisive: without a battery the machine cannot be off mains, and with
# one only _PSR could say whether the line is up (upower likewise derives on-battery from the batteries).
#
# THE SCAN. DSDT (FADT X_DSDT/DSDT) + every SSDT the XSDT (else the RSDT) lists. Per table: signature, length in
# [36, 1 MB], checksum; then one pass over the AML body that does two independent things:
#   1. FLAT: counts every battery-ID constant anywhere (EISAID PNP0C0A as DWordConst 0x0A0CD041 or a QWordConst of
#      it; the strings "PNP0C0A" and "ACPI0002" — the smart-battery subsystem, Linux sbs.c, is a battery too).
#   2. DEVICES: every DeviceOp (5B 82) with a well-formed PkgLength and NameString is scanned for its OWN direct
#      objects (nested Devices are skipped — the outer pass scans them for themselves): Name(_HID/_CID, <id>) with
#      _CID as one id or a Package of them, and every _STA — Name(_STA, k), or Method(_STA) whose whole body is
#      Return(k).
# A battery counts as ABSENT only when its body names "_STA" exactly once (a device that Stores to or otherwise
# names its own _STA is not constant) and every reading of that _STA is a constant with bit 0 clear. Any battery-ID
# constant the device pass did not attribute to a _HID/_CID (a Method(_HID), an id in a Scope, a byte-scan
# ambiguity) counts as a PRESENT battery. So every doubt lands on "cannot say", never on "mains".
# ⚠ Departures recorded: (a) Linux reads battery presence from _STA bit 4 (acpi_battery_present); a slot whose _STA
#   is a constant with bit 0 set and bit 4 clear is "cannot say" here, where Linux would report no battery inserted.
#   (b) A Name(_STA, 0) that a method in ANOTHER scope Stores into is read as absent: only evaluation sees that.
#   (c) Tables loaded at run time (Load / LoadTable from _OSC or _PDC) are not scanned; firmware ships batteries in
#   the static DSDT/SSDTs.
# ⛔ Every read is bounded by the table it is in (a device's objects by the device's own extent), every PkgLength is
#   checked against its container, and the total scanned is capped (16 MB, 256 SSDTs): a malformed table can make the
#   answer "cannot say" (PSRC_F_MALFORMED), never fault or loop. Runs from acpi_init (BSP, boot, pre-scheduler, IF
#   either way, no lock); re-run by TSC_SELFTEST's acpi_fadt_reset_selftest, so it is a pure function of the tables.
#
# THE ANSWER IS ONE WORD, CACHED: psrc_word, published by ONE aligned 8-byte store at the end of the scan.
# power_source#114 returns it — no pointer, no lock, no blocking — so a 10 s poll costs one load.
var PSRC_UNKNOWN    = 0;       # w & 0xFF: cannot say
var PSRC_MAINS      = 1;       #           on mains
var PSRC_BATTERY    = 2;       #           on battery — RESERVED for an AML _PSR/_BST evaluator; never produced in 1.57.18
var PSRC_F_TABLES   = 0x100;   # the DSDT was found and passed its checks (signature, length, checksum)
var PSRC_F_BATTERY  = 0x200;   # a battery is declared (PNP0C0A / ACPI0002, by _HID or _CID)
var PSRC_F_PRESENT  = 0x400;   # a declared battery is NOT ruled absent (the reason for "cannot say")
var PSRC_F_AC       = 0x800;   # an AC adapter (ACPI0003) is declared (informational)
var PSRC_F_INFERRED = 0x1000;  # the state is inferred from what is declared, not read from _PSR (every MAINS this cut)
var PSRC_F_MALFORMED = 0x2000; # a table or an AML package length failed a bound check: the answer is "cannot say"
var PSRC_TABLE_MAX  = 0x100000;    # 1 MB per table (acpi_find_s5's DSDT bound)
var PSRC_BUDGET_MAX = 0x1000000;   # 16 MB scanned in total
var PSRC_SSDT_MAX   = 256;

var psrc_word = 0;          # THE ANSWER (#114). 0 = cannot say, nothing scanned — also every pre-acpi_init read.
# Scan accumulators (boot-only scratch: written only by psrc_scan on the BSP; the report line prints them).
var psrc_dsdt = 0;          # 1 = the DSDT was scanned
var psrc_ssdt = 0;          # SSDTs scanned
var psrc_raw_batt = 0;      # battery-ID constants anywhere (the FLAT count)
var psrc_attr_batt = 0;     # battery IDs the device pass attributed to a _HID/_CID
var psrc_batt_dev = 0;      # devices declaring a battery
var psrc_batt_absent = 0;   # ... of which ruled absent by a constant _STA
var psrc_ac = 0;            # devices declaring an AC adapter
var psrc_bad = 0;           # 1 = a bound check failed somewhere
var psrc_budget = 0;        # bytes of tables accepted so far
# Per-device scratch (psrc_scan_device) and decoder out-params (Cyrius has no out-params; acpi_aml_cursor precedent).
var psrc_d_batt = 0;
var psrc_d_ac = 0;
var psrc_d_sta_raw = 0;     # "_STA" NameSegs in the device's own body
var psrc_d_sta_n = 0;       # _STA definitions read (Name or Method)
var psrc_d_sta_abs = 0;     # ... of which a constant with bit 0 clear
var psrc_pl_nb = 0;         # psrc_pkglen: bytes of the PkgLength encoding
var psrc_dev_body = 0;      # psrc_dev_end: where the device's TermList starts
var psrc_dev_over = 0;      # psrc_dev_end: 1 = a well-formed Device header whose package runs past its container
var psrc_int_ok = 0;        # psrc_int_at: 1 = an integer constant was decoded
var psrc_cur = 0;           # psrc_int_at: the position after it

# AML PkgLength at p (ACPI 6.5 §20.2.4): lead byte bits 7-6 = how many bytes follow (0-3). With none, bits 5-0 are
# the length; otherwise bits 3-0 are its low nibble, bits 5-4 must be 0, and each following byte adds 8 more bits.
# Returns the length (it counts from p, the PkgLength's own first byte) or -1; psrc_pl_nb = the encoding's bytes.
fn psrc_pkglen(p, end) {
    if (p >= end) { return 0 - 1; }
    var b0 = acpi_load8(p);
    var n = (b0 >> 6) & 3;
    if (p + 1 + n > end) { return 0 - 1; }
    psrc_pl_nb = n + 1;
    if (n == 0) { return b0 & 0x3F; }
    if ((b0 & 0x30) != 0) { return 0 - 1; }
    var v = b0 & 0x0F;
    var i = 0;
    while (i < n) {
        v = v | (acpi_load8(p + 1 + i) << (4 + 8 * i));
        i = i + 1;
    }
    return v;
}

# NameSeg at p (the caller has bounded p + 4): LeadNameChar 'A'-'Z' | '_', then three of those or '0'-'9'.
fn psrc_namechar(c, lead) {
    if (c == 0x5F) { return 1; }
    if (c >= 0x41) { if (c <= 0x5A) { return 1; } }
    if (lead == 0) { if (c >= 0x30) { if (c <= 0x39) { return 1; } } }
    return 0;
}
fn psrc_seg_ok(p) {
    if (psrc_namechar(acpi_load8(p), 1) == 0) { return 0; }
    if (psrc_namechar(acpi_load8(p + 1), 0) == 0) { return 0; }
    if (psrc_namechar(acpi_load8(p + 2), 0) == 0) { return 0; }
    if (psrc_namechar(acpi_load8(p + 3), 0) == 0) { return 0; }
    return 1;
}

# NameString at p (§20.2.2): '\' or any run of '^', then a NameSeg, DualNamePath (2E) or MultiNamePath (2F count).
# NullName is refused (a Device is always named). Returns its length in bytes, or -1.
fn psrc_namestr_len(p, end) {
    var q = p;
    if (q >= end) { return 0 - 1; }
    if (acpi_load8(q) == 0x5C) { q = q + 1; }
    else {
        while (q < end) {
            if (acpi_load8(q) == 0x5E) { q = q + 1; } else { break; }
        }
    }
    if (q >= end) { return 0 - 1; }
    var b = acpi_load8(q);
    var segs = 1;
    if (b == 0x00) { return 0 - 1; }
    if (b == 0x2E) { segs = 2; q = q + 1; }
    if (b == 0x2F) {
        if (q + 1 >= end) { return 0 - 1; }
        segs = acpi_load8(q + 1);
        if (segs == 0) { return 0 - 1; }
        q = q + 2;
    }
    if (q + segs * 4 > end) { return 0 - 1; }
    var i = 0;
    while (i < segs) {
        if (psrc_seg_ok(q + i * 4) == 0) { return 0 - 1; }
        i = i + 1;
    }
    return q + segs * 4 - p;
}

# DeviceOp at s (5B 82 PkgLength NameString TermList). Returns the device's end (exclusive) with psrc_dev_body set,
# or 0 when the bytes are not a well-formed Device header or the package runs past `end` (then psrc_dev_over = 1).
fn psrc_dev_end(s, end) {
    psrc_dev_over = 0;
    if (s + 2 >= end) { return 0; }
    var pl = psrc_pkglen(s + 2, end);
    if (pl < 0) { return 0; }
    var nb = psrc_pl_nb;
    var ns = s + 2 + nb;
    var nl = psrc_namestr_len(ns, end);
    if (nl < 0) { return 0; }
    if (pl < nb + nl) { return 0; }                   # the package cannot end inside its own name
    if (s + 2 + pl > end) { psrc_dev_over = 1; return 0; }
    psrc_dev_body = ns + nl;
    return s + 2 + pl;
}

# Do the n bytes of firmware memory at p equal the kernel string s?
fn psrc_bytes_eq(p, s, n) {
    var i = 0;
    while (i < n) {
        if (acpi_load8(p + i) != load8(s + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# THE ONE ID MATCHER — the flat count and the device pass both call it, so a constant it misses is missed by both.
# The data object at p: 1 = a battery (EISAID PNP0C0A as DWordConst / QWordConst, or the string "PNP0C0A" or
# "ACPI0002"), 2 = an AC adapter (the string "ACPI0003"; ACPI0003 has no EISAID form), 0 = anything else.
fn psrc_id_kind(p, end) {
    if (p >= end) { return 0; }
    var op = acpi_load8(p);
    if (op == 0x0C) {
        if (p + 5 <= end) { if (acpi_load32(p + 1) == 0x0A0CD041) { return 1; } }
        return 0;
    }
    if (op == 0x0E) {
        if (p + 9 <= end) { if (acpi_load32(p + 1) == 0x0A0CD041) { if (acpi_load32(p + 5) == 0) { return 1; } } }
        return 0;
    }
    if (op == 0x0D) {
        if (p + 9 <= end) {
            if (acpi_load8(p + 8) == 0) { if (psrc_bytes_eq(p + 1, "PNP0C0A", 7) == 1) { return 1; } }
        }
        if (p + 10 <= end) {
            if (acpi_load8(p + 9) == 0) {
                if (psrc_bytes_eq(p + 1, "ACPI0002", 8) == 1) { return 1; }
                if (psrc_bytes_eq(p + 1, "ACPI0003", 8) == 1) { return 2; }
            }
        }
    }
    return 0;
}

# An integer constant at p (ZeroOp, OneOp, OnesOp, Byte/Word/DWord/QWordConst). Sets psrc_int_ok and psrc_cur (the
# position after it); OnesOp is all bits set (-1 here), so its bit 0 reads "present".
fn psrc_int_at(p, end) {
    psrc_int_ok = 0;
    psrc_cur = 0 - 1;
    if (p >= end) { return 0; }
    var op = acpi_load8(p);
    var w = 0;
    var v = 0;
    if (op == 0x00) { w = 1; v = 0; }
    if (op == 0x01) { w = 1; v = 1; }
    if (op == 0xFF) { w = 1; v = 0 - 1; }
    if (op == 0x0A) { w = 2; }
    if (op == 0x0B) { w = 3; }
    if (op == 0x0C) { w = 5; }
    if (op == 0x0E) { w = 9; }
    if (w == 0) { return 0; }
    if (p + w > end) { return 0; }
    if (op == 0x0A) { v = acpi_load8(p + 1); }
    if (op == 0x0B) { v = acpi_load16(p + 1); }
    if (op == 0x0C) { v = acpi_load32(p + 1); }
    if (op == 0x0E) { v = acpi_load64(p + 1); }
    psrc_int_ok = 1;
    psrc_cur = p + w;
    return v;
}

# The position after the simple data object at p (an integer constant, or a string up to its NUL), or -1.
fn psrc_obj_skip(p, end) {
    psrc_int_at(p, end);
    if (psrc_int_ok == 1) { return psrc_cur; }
    if (p >= end) { return 0 - 1; }
    if (acpi_load8(p) != 0x0D) { return 0 - 1; }
    var q = p + 1;
    while (q < end) {
        if (acpi_load8(q) == 0) { return q + 1; }
        q = q + 1;
    }
    return 0 - 1;
}

fn psrc_d_count(k) {
    if (k == 1) { psrc_d_batt = psrc_d_batt + 1; }
    if (k == 2) { psrc_d_ac = psrc_d_ac + 1; }
    return 0;
}

# NameOp at q inside a device body ending at dend: _HID / _CID (one id, or a Package of ids) / _STA (a constant?).
fn psrc_d_name(q, dend) {
    if (q + 5 > dend) { return 0; }
    if (acpi_sig_match(q + 1, 0x5F, 0x48, 0x49, 0x44) == 1) {          # _HID
        psrc_d_count(psrc_id_kind(q + 5, dend));
        return 0;
    }
    if (acpi_sig_match(q + 1, 0x5F, 0x43, 0x49, 0x44) == 1) {          # _CID
        if (q + 6 <= dend) {
            if (acpi_load8(q + 5) == 0x12) {                           # PackageOp PkgLength NumElements elements
                var pl = psrc_pkglen(q + 6, dend);
                if (pl < 0) { return 0; }              # undecodable: its ids stay unattributed (-> present)
                var pe = q + 6 + pl;
                if (pe > dend) { psrc_bad = 1; return 0; }
                var e = q + 6 + psrc_pl_nb;
                if (e >= pe) { return 0; }
                var cnt = acpi_load8(e);
                var pos = e + 1;
                var i = 0;
                while (i < cnt) {
                    if (pos >= pe) { break; }
                    psrc_d_count(psrc_id_kind(pos, pe));
                    pos = psrc_obj_skip(pos, pe);
                    if (pos < 0) { break; }
                    i = i + 1;
                }
                return 0;
            }
        }
        psrc_d_count(psrc_id_kind(q + 5, dend));
        return 0;
    }
    if (acpi_sig_match(q + 1, 0x5F, 0x53, 0x54, 0x41) == 1) {          # _STA
        psrc_d_sta_n = psrc_d_sta_n + 1;
        var v = psrc_int_at(q + 5, dend);
        if (psrc_int_ok == 1) { if ((v & 1) == 0) { psrc_d_sta_abs = psrc_d_sta_abs + 1; } }
        return 0;
    }
    return 0;
}

# MethodOp at q (14 PkgLength NameString MethodFlags TermList): a constant only when the NameString is _STA and the
# TermList is exactly ReturnOp (A4) and one integer constant, ending at the method's end. Returns that end when it
# is (the caller then steps over the whole method, so its PkgLength byte is never re-read as a NameOp: a 0x08
# PkgLength followed by "_STA" is also the bytes of Name(_STA, <MethodFlags>)), else 0.
fn psrc_d_method(q, dend) {
    var pl = psrc_pkglen(q + 1, dend);
    if (pl < 0) { return 0; }
    var ns = q + 1 + psrc_pl_nb;
    if (ns + 5 > dend) { return 0; }
    if (acpi_sig_match(ns, 0x5F, 0x53, 0x54, 0x41) == 0) { return 0; }
    psrc_d_sta_n = psrc_d_sta_n + 1;
    var me = q + 1 + pl;
    if (me > dend) { return 0; }                       # cannot be bounded: not a constant
    var bp = ns + 5;                                   # past the name and MethodFlags
    if (bp >= me) { return 0; }
    if (acpi_load8(bp) != 0xA4) { return 0; }
    var v = psrc_int_at(bp + 1, me);
    if (psrc_int_ok == 0) { return 0; }
    if (psrc_cur != me) { return 0; }                  # something follows the Return: not the whole body
    if ((v & 1) == 0) { psrc_d_sta_abs = psrc_d_sta_abs + 1; }
    return me;
}

# One device's OWN objects, [body, dend). A nested DeviceOp that fits inside dend is skipped whole (the outer pass
# scans it for itself); one that does not fit is not a device of this body and is read through.
fn psrc_scan_device(body, dend) {
    psrc_d_batt = 0;
    psrc_d_ac = 0;
    psrc_d_sta_raw = 0;
    psrc_d_sta_n = 0;
    psrc_d_sta_abs = 0;
    var q = body;
    while (q < dend) {
        var b = acpi_load8(q);
        var adv = 1;
        if (b == 0x5B) {
            if (q + 1 < dend) {
                if (acpi_load8(q + 1) == 0x82) {
                    var ne = psrc_dev_end(q, dend);
                    if (ne > 0) { adv = ne - q; }
                }
            }
        }
        if (adv == 1) {
            if (b == 0x5F) {
                if (q + 4 <= dend) {
                    if (acpi_sig_match(q, 0x5F, 0x53, 0x54, 0x41) == 1) { psrc_d_sta_raw = psrc_d_sta_raw + 1; }
                }
            }
            if (b == 0x08) { psrc_d_name(q, dend); }
            if (b == 0x14) {
                var mj = psrc_d_method(q, dend);
                if (mj > 0) { adv = mj - q; psrc_d_sta_raw = psrc_d_sta_raw + 1; }   # stepped over: count its own "_STA"
            }
        }
        q = q + adv;
    }
    if (psrc_d_batt > 0) {
        psrc_batt_dev = psrc_batt_dev + 1;
        psrc_attr_batt = psrc_attr_batt + psrc_d_batt;
        if (psrc_d_sta_raw == 1) {
            if (psrc_d_sta_n >= 1) {
                if (psrc_d_sta_abs == psrc_d_sta_n) { psrc_batt_absent = psrc_batt_absent + 1; }
            }
        }
    }
    if (psrc_d_ac > 0) { psrc_ac = psrc_ac + 1; }
    return 0;
}

# A table the scan may read: signature, length in [36, PSRC_TABLE_MAX], inside the total budget, checksum 0.
# Returns its length, or 0 (psrc_bad set) — the bytes past the header are never read unless all four hold.
fn psrc_table_ok(t, c0, c1, c2, c3) {
    if (acpi_sig_match(t, c0, c1, c2, c3) == 0) { psrc_bad = 1; return 0; }
    var len = acpi_load32(t + 4);
    if (len < 36) { psrc_bad = 1; return 0; }
    if (len > PSRC_TABLE_MAX) { psrc_bad = 1; return 0; }
    if (psrc_budget + len > PSRC_BUDGET_MAX) { psrc_bad = 1; return 0; }
    psrc_budget = psrc_budget + len;
    var sum = 0;
    var i = 0;
    while (i < len) {
        sum = sum + acpi_load8(t + i);
        i = i + 1;
    }
    if ((sum & 0xFF) != 0) { psrc_bad = 1; return 0; }
    return len;
}

# One definition block's AML body [t+36, t+len): the FLAT count and the DEVICE pass in one walk.
fn psrc_scan_table(t, len) {
    var end = t + len;
    var p = t + 36;
    while (p < end) {
        var b = acpi_load8(p);
        if (b == 0x0C) { if (psrc_id_kind(p, end) == 1) { psrc_raw_batt = psrc_raw_batt + 1; } }
        if (b == 0x0D) { if (psrc_id_kind(p, end) == 1) { psrc_raw_batt = psrc_raw_batt + 1; } }
        if (b == 0x0E) { if (psrc_id_kind(p, end) == 1) { psrc_raw_batt = psrc_raw_batt + 1; } }
        if (b == 0x5B) {
            if (p + 1 < end) {
                if (acpi_load8(p + 1) == 0x82) {
                    var de = psrc_dev_end(p, end);
                    var dov = psrc_dev_over;                       # read BEFORE the device pass: its nested probes reuse it
                    if (de > 0) { psrc_scan_device(psrc_dev_body, de); }
                    if (dov == 1) { psrc_bad = 1; }                # a well-formed Device whose package overruns its table
                }
            }
        }
        p = p + 1;
    }
    return 0;
}

# A root table (XSDT / RSDT) the SSDT walk may trust: signature, length in [36, 0x10000] (acpi_xsdt_find's bound),
# checksum 0. Returns its length or 0. Not counted against the budget (a 64 KB pointer array).
fn psrc_root_ok(t, c0, c1, c2, c3) {
    if (t == 0) { return 0; }
    if (acpi_sig_match(t, c0, c1, c2, c3) == 0) { return 0; }
    var len = acpi_load32(t + 4);
    if (len < 36) { return 0; }
    if (len > 0x10000) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < len) {
        sum = sum + acpi_load8(t + i);
        i = i + 1;
    }
    if ((sum & 0xFF) != 0) { return 0; }
    return len;
}

# Every accumulator AND the published word back to "cannot say, nothing scanned". acpi_init calls it first, so its
# no-RSDP return answers "cannot say" — never a previous scan's answer (the acpi_fadt_clear rule, 1.57.7 S1b).
fn psrc_clear() {
    psrc_word = 0;
    psrc_dsdt = 0;
    psrc_ssdt = 0;
    psrc_raw_batt = 0;
    psrc_attr_batt = 0;
    psrc_batt_dev = 0;
    psrc_batt_absent = 0;
    psrc_ac = 0;
    psrc_bad = 0;
    psrc_budget = 0;
    return 0;
}

# The scan (acpi_init's last step, after acpi_find_fadt has set acpi_dsdt_addr). Publishes psrc_word.
fn psrc_scan() {
    psrc_clear();
    var len = 0;
    if (acpi_dsdt_addr != 0) {
        len = psrc_table_ok(acpi_dsdt_addr, 0x44, 0x53, 0x44, 0x54);        # 'DSDT'
        if (len > 0) { psrc_scan_table(acpi_dsdt_addr, len); psrc_dsdt = 1; }
    }
    # Every SSDT the XSDT lists — the RSDT only when there is no usable XSDT (ACPI 6.5 §5.2.8: an OS uses the XSDT).
    var root = 0;
    var esz = 8;
    var rlen = psrc_root_ok(acpi_xsdt_addr, 0x58, 0x53, 0x44, 0x54);        # 'XSDT'
    if (rlen > 0) { root = acpi_xsdt_addr; }
    else {
        rlen = psrc_root_ok(acpi_rsdt_addr, 0x52, 0x53, 0x44, 0x54);        # 'RSDT'
        if (rlen > 0) { root = acpi_rsdt_addr; esz = 4; }
    }
    if (root == 0) {
        if (acpi_rsdp_addr != 0) { psrc_bad = 1; }   # an RSDP whose root tables both fail: the SSDT set is unknown
    } else {
        var n = (rlen - 36) / esz;
        var i = 0;
        while (i < n) {
            var ta = 0;
            if (esz == 8) { ta = acpi_load64(root + 36 + i * 8); }
            else { ta = acpi_load32(root + 36 + i * 4); }
            if (ta != 0) {
                if (acpi_sig_match(ta, 0x53, 0x53, 0x44, 0x54) == 1) {      # 'SSDT'
                    if (psrc_ssdt >= PSRC_SSDT_MAX) { psrc_bad = 1; }
                    else {
                        len = psrc_table_ok(ta, 0x53, 0x53, 0x44, 0x54);
                        if (len > 0) { psrc_scan_table(ta, len); psrc_ssdt = psrc_ssdt + 1; }
                    }
                }
            }
            i = i + 1;
        }
    }

    var w = 0;
    var present = 0;
    if (psrc_dsdt == 1) { w = w | PSRC_F_TABLES; }
    if (psrc_raw_batt > 0) { w = w | PSRC_F_BATTERY; }
    if (psrc_batt_dev > 0) { w = w | PSRC_F_BATTERY; }
    if (psrc_raw_batt != psrc_attr_batt) { present = 1; }     # an id no _HID/_CID accounts for (or one counted twice)
    if (psrc_batt_absent < psrc_batt_dev) { present = 1; }
    if (present == 1) { w = w | PSRC_F_PRESENT; }
    if (psrc_ac > 0) { w = w | PSRC_F_AC; }
    if (psrc_bad == 1) { w = w | PSRC_F_MALFORMED; }
    if (psrc_dsdt == 1) {
        if (psrc_bad == 0) {
            if (present == 0) { w = w | PSRC_MAINS | PSRC_F_INFERRED; }
        }
    }
    psrc_word = w;                                             # ONE store: #114 reads it on any CPU, unlocked
    return w;
}

# The boot line (main.cyr, once, after acpi_init): what the scan found and why it answered as it did.
#   power: source mains (no battery declared; dsdt 1 ssdt 0 battery 0 absent 0 ids 0 ac 0) word 0x1101
fn psrc_report() {
    var w = psrc_word;
    kprint("power: source ", 14);
    if ((w & 0xFF) == PSRC_MAINS) { kprint("mains (", 7); } else { kprint("cannot say (", 12); }
    if ((w & PSRC_F_MALFORMED) != 0) { kprint("a table failed a bound check", 28); }
    else {
        if ((w & PSRC_F_TABLES) == 0) { kprint("no usable ACPI tables", 21); }
        else {
            if ((w & PSRC_F_PRESENT) != 0) { kprint("a battery may be present", 24); }
            else {
                if ((w & PSRC_F_BATTERY) != 0) { kprint("every battery absent by a constant _STA", 39); }
                else { kprint("no battery declared", 19); }
            }
        }
    }
    kprint("; dsdt ", 7);    kprint_num(psrc_dsdt);
    kprint(" ssdt ", 6);     kprint_num(psrc_ssdt);
    kprint(" battery ", 9);  kprint_num(psrc_batt_dev);
    kprint(" absent ", 8);   kprint_num(psrc_batt_absent);
    kprint(" ids ", 5);      kprint_num(psrc_raw_batt);
    kprint(" ac ", 4);       kprint_num(psrc_ac);
    kprint(") word 0x", 9);  kprint_hex(w);
    kprintln("", 0);
    return 0;
}

# power_source#114's body: the cached word. a1..a4 are never read (the arm passes none).
fn power_source_sys() { return psrc_word; }
