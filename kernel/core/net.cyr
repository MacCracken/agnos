# === Network Stack (IP/UDP) ===
var net_ip = 0;
var net_gateway = 0;
var net_netmask = 0;
# Resolver address for the DNS stub (1.35.x). Captured from DHCP option 6
# (RFC 2132 §3.8) in the ACK handler; falls back to the gateway when the
# lease supplies none. 0 = unset. Consumed by dns_resolve.
var net_dns_server = 0;
var net_pkt[256];
var arp_cache_ip = 0;
var arp_cache_mac[8];
var arp_pending_ip = 0;  # Security: track which IP we sent an ARP request for

# 1.49.0 loopback (lo) — frames destined to 127.0.0.0/8 or our own net_ip are queued here by net_tx
# and drained through net_demux_frame by net_lo_drain on the poll loop, instead of hitting the wire
# via nic_send. 8 slots × 1536 B (module-global var[N] = N×u64 = 8N bytes, so lo_ring = 8×1536).
var lo_ring[1536];
var lo_lens[8];
var lo_head = 0;
var lo_tail = 0;
var lo_count = 0;
var lo_dropped = 0;
# Count of ARP replies the responder has TX'd. A live signal for the boot
# self-test: a non-zero value is proof the full inbound path fired (RX
# delivered a request -> net_handle_arp matched our IP -> we sent a reply).
# 1325 attempt_4 pcap (pre-1.32.7): the inbound round-trip fired on iron
# while the gateway-unicast-reply gate still timed out, so the FB self-test
# reports this counter. The r8169 unicast-RX arc closed at 1.32.7 (RX ring
# 16->64) and the gate now succeeds on iron; the counter stays as a signal.
var net_arp_replies_sent = 0;
var net_rx_pkt[256];
var net_udp_buf[256];
var net_udp_buf_len = 0;
# Persistent gateway-MAC slot — populated by main.cyr after the boot-time
# ARP-to-gateway probe succeeds. route_next_hop_mac consults this for off-LAN
# destinations. Independent of arp_cache_* so later ARP traffic doesn't
# clobber it. (dhcp-and-outbound-l3-audit-2026-05-24 § 7.1)
var net_gateway_mac[8];
var net_gateway_mac_valid = 0;

# ═══ 1.57.7 (S4) — net lock wrappers (docs/architecture/net-concurrency.md; smp.cyr GLOBAL LOCK ORDER) ═══
# The ONLY way to take net_tx_lock / lo_q_lock / udp_lock: kbd_irq_save() FIRST (the holder runs IF=0, so the
# timer/NIC ISR drain on this CPU can never spin on a lock this CPU holds), then the xchg. net_tx_begin keeps
# the overlap witness (net_tx_inside, declared in r8169.cyr above nic_send). Chain: tcp_tab < net_tx < lo_q;
# udp_lock is a sibling leaf never held with another net lock. Under any of them: no net_poll, no
# heap/pmm/console/fs lock, no kmalloc/kfree, no kprint.
fn net_tx_begin() {
    var ntb_f = kbd_irq_save();
    net_tx_spin_lock();
    net_tx_inside = net_tx_inside + 1;
    if (net_tx_inside != 1) { net_lk_latch(1, "net: lock overlap - two CPUs inside one net lock", 48); }
    return ntb_f;
}
fn net_tx_end(nte_f) {
    net_tx_inside = net_tx_inside - 1;
    net_tx_spin_unlock();
    kbd_irq_restore(nte_f);
    return 0;
}
fn lo_q_begin() {
    var lqb_f = kbd_irq_save();
    lo_q_spin_lock();
    return lqb_f;
}
fn lo_q_end(lqe_f) {
    lo_q_spin_unlock();
    kbd_irq_restore(lqe_f);
    return 0;
}
fn udp_begin() {
    var ub_f = kbd_irq_save();
    udp_spin_lock();
    return ub_f;
}
fn udp_end(ue_f) {
    udp_spin_unlock();
    kbd_irq_restore(ue_f);
    return 0;
}

fn net_init(ip, gw, mask) {
    net_ip = ip;
    net_gateway = gw;
    net_netmask = mask;
    arp_cache_ip = 0;
    return 0;
}

fn ip4(a, b, c, d) {
    return (a << 24) | (b << 16) | (c << 8) | d;
}

fn ip_checksum(buf, len) {
    var sum = 0;
    var i = 0;
    while (i < len) {
        sum = sum + (load8(buf + i) << 8);
        if (i + 1 < len) { sum = sum + load8(buf + i + 1); }
        i = i + 2;
    }
    while (sum > 0xFFFF) {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }
    return (0 - 1 - sum) & 0xFFFF;
}

# ⛔⛔ 1.56.52 — RECEIVE-SIDE CHECKSUM VERIFICATION. Until this cut agnos verified NOTHING on ingress:
# every checksum call site in the tree was on the TX path, and net_demux_frame handed a frame to the
# IP, ICMP, UDP and TCP handlers with no read, recompute or compare of any kind. A corrupted TCP
# segment whose seq happened to equal RCV.NXT was appended to the receive ring, advanced RCV.NXT, and
# was ACKed — i.e. corruption was acknowledged to the peer as delivered.
# ⚠ These counters are written from thread context AND from the timer ISR (net_rx_drain_isr). An
# aligned u64 increment is a single store on x86_64, and they are DIAGNOSTICS ONLY — no lock, and do
# not build control flow on them. Same rationale as the icmp counters in net_icmp.cyr.
var net_csum_drop_ip   = 0;
var net_csum_drop_icmp = 0;
var net_csum_drop_udp  = 0;
var net_csum_drop_tcp  = 0;
# 1.56.52 — IPv4 fragments, neither reassembled nor (until now) rejected. See net_demux_frame.
var net_drop_ip_frag   = 0;
# 1.57.7 (S5) — wire martians dropped by net_wire_frame (127/8 source or destination, a >= 224 source, our own
# address as a source). Diagnostic only, written from ISR and thread context (same rationale as above).
var net_drop_martian   = 0;

# l4_pseudo_csum — one's-complement checksum over the IPv4 pseudo-header + an L4 segment.
# ⚠ A DELIBERATE NEAR-DUPLICATE of tcp_checksum_compute (net_tcp.cyr), which hardcodes proto = 6 and
# lives on the TX path. That function is NOT refactored to call this one: the transmit path is the
# single thing this change must not perturb, and ~120 bytes of duplication is a cheap price for
# leaving every outbound segment byte-identical. If they ever need to converge, do it in its own cut
# with the TX smokes as the gate.
# ⚠ Verification is `recompute == 0`, which holds for this one's-complement form INCLUDING the
# RFC-768 transmit convention of sending 0xFFFF for a computed zero — one's-complement -0 == 0.
fn l4_pseudo_csum(src_ip, dst_ip, proto, buf, len) {
    var sum = 0;
    sum = sum + ((src_ip >> 16) & 0xFFFF);
    sum = sum + (src_ip & 0xFFFF);
    sum = sum + ((dst_ip >> 16) & 0xFFFF);
    sum = sum + (dst_ip & 0xFFFF);
    sum = sum + proto;
    sum = sum + len;
    var i = 0;
    while (i < len) {
        var hi = load8(buf + i) << 8;
        var lo = 0;
        if (i + 1 < len) { lo = load8(buf + i + 1); }
        sum = sum + hi + lo;
        i = i + 2;
    }
    while (sum > 0xFFFF) { sum = (sum & 0xFFFF) + (sum >> 16); }
    return (0 - 1 - sum) & 0xFFFF;
}

fn eth_build(pkt, dst_mac, src_mac, ethertype) {
    memcpy(pkt, dst_mac, 6);
    memcpy(pkt + 6, src_mac, 6);
    store8(pkt + 12, (ethertype >> 8) & 0xFF);
    store8(pkt + 13, ethertype & 0xFF);
    return 14;
}

fn ip_build(pkt, src_ip, dst_ip, proto, payload_len) {
    var total = 20 + payload_len;
    store8(pkt, 0x45);
    store8(pkt + 1, 0);
    store8(pkt + 2, (total >> 8) & 0xFF);
    store8(pkt + 3, total & 0xFF);
    store16(pkt + 4, 0);
    store16(pkt + 6, 0);
    store8(pkt + 8, 64);
    store8(pkt + 9, proto);
    store16(pkt + 10, 0);
    store8(pkt + 12, (src_ip >> 24) & 0xFF);
    store8(pkt + 13, (src_ip >> 16) & 0xFF);
    store8(pkt + 14, (src_ip >> 8) & 0xFF);
    store8(pkt + 15, src_ip & 0xFF);
    store8(pkt + 16, (dst_ip >> 24) & 0xFF);
    store8(pkt + 17, (dst_ip >> 16) & 0xFF);
    store8(pkt + 18, (dst_ip >> 8) & 0xFF);
    store8(pkt + 19, dst_ip & 0xFF);
    var cksum = ip_checksum(pkt, 20);
    store8(pkt + 10, (cksum >> 8) & 0xFF);
    store8(pkt + 11, cksum & 0xFF);
    return 20;
}

fn udp_build(pkt, src_port, dst_port, data, data_len) {
    var udp_len = 8 + data_len;
    store8(pkt, (src_port >> 8) & 0xFF);
    store8(pkt + 1, src_port & 0xFF);
    store8(pkt + 2, (dst_port >> 8) & 0xFF);
    store8(pkt + 3, dst_port & 0xFF);
    store8(pkt + 4, (udp_len >> 8) & 0xFF);
    store8(pkt + 5, udp_len & 0xFF);
    store16(pkt + 6, 0);
    memcpy(pkt + 8, data, data_len);
    return udp_len;
}

fn arp_request(target_ip) {
    if (nic_ready() == 0) { return 0 - 1; }
    var ar_f = net_tx_begin();                 # 1.57.7 (S4): net_pkt + arp_pending_ip + nic_send under net_tx_lock
    # Security: record pending request BEFORE sending (avoid race with fast reply)
    arp_pending_ip = target_ip;
    var p = &net_pkt;
    var bcast[8];
    memset(&bcast, 0xFF, 6);
    var kmac[8];
    nic_mac(&kmac);   # FIX #1: backend-agnostic kernel MAC, not vnet_mac
    var off = eth_build(p, &bcast, &kmac, 0x0806);
    # ARP: htype=1(eth) ptype=0x0800(ipv4) hlen=6 plen=4 oper=1(request).
    # Fields are network-byte-order (big-endian); store16 is host-order
    # (little-endian on x86), so write byte pairs explicitly. Attempt 102
    # pcap showed a single AGNOS-MAC ARP egressed but with htype=0x0100 /
    # ptype=0x0008 / oper=0x0100 — switch dropped it as malformed.
    store8(p + off,     0x00); store8(p + off + 1, 0x01);   # htype = ethernet
    store8(p + off + 2, 0x08); store8(p + off + 3, 0x00);   # ptype = IPv4
    store8(p + off + 4, 6);    store8(p + off + 5, 4);
    store8(p + off + 6, 0x00); store8(p + off + 7, 0x01);   # oper  = request
    memcpy(p + off + 8, &kmac, 6);
    store8(p + off + 14, (net_ip >> 24) & 0xFF);
    store8(p + off + 15, (net_ip >> 16) & 0xFF);
    store8(p + off + 16, (net_ip >> 8) & 0xFF);
    store8(p + off + 17, net_ip & 0xFF);
    memset(p + off + 18, 0, 6);
    store8(p + off + 24, (target_ip >> 24) & 0xFF);
    store8(p + off + 25, (target_ip >> 16) & 0xFF);
    store8(p + off + 26, (target_ip >> 8) & 0xFF);
    store8(p + off + 27, target_ip & 0xFF);
    var ar_r = nic_send(p, off + 28);
    net_tx_end(ar_f);
    return ar_r;
}

# Minimal route lookup. Returns 0 on success (out_mac filled with the L2
# next-hop MAC for dst_ip), -1 if no MAC is available. On-LAN destinations
# match (dst_ip & netmask) == (net_ip & netmask); off-LAN destinations use
# the cached gateway MAC. Convergent shape across Linux / lwIP / iPXE /
# *BSD / U-Boot / Plan 9 per dhcp-and-outbound-l3-audit-2026-05-24 § 3.
fn route_next_hop_mac(dst_ip, out_mac) {
    if (net_netmask != 0) {
        if ((dst_ip & net_netmask) == (net_ip & net_netmask)) {
            # On-LAN. For MVP the only on-LAN dst we send to (outside the
            # broadcast DHCP path which calls udp_send_from with dst=0xFFFFFFFF)
            # is the gateway itself, which we have cached.
            if (net_gateway_mac_valid == 1) {
                if (dst_ip == net_gateway) {
                    memcpy(out_mac, &net_gateway_mac, 6);
                    return 0;
                }
            }
            return 0 - 1;
        }
    }
    # Off-LAN — route via the default gateway.
    if (net_gateway_mac_valid == 1) {
        memcpy(out_mac, &net_gateway_mac, 6);
        return 0;
    }
    return 0 - 1;
}

# An IPv4 dst that loops back: 127.0.0.0/8 (canonical loopback) or our OWN assigned net_ip (a packet
# to self short-circuits the wire). 1.49.0 loopback bite 1.
fn net_is_loopback(dst_ip) {
    if (((dst_ip >> 24) & 0xFF) == 127) { return 1; }
    if (net_ip != 0 && dst_ip == net_ip) { return 1; }
    return 0;
}

# net_src_for(dst_ip) — the SOURCE address to put on a packet headed for dst_ip.
#
# ⛔ THIS EXISTS BECAUSE EVERY OUTBOUND SEGMENT USED TO CLAIM `net_ip` AS ITS SOURCE, INCLUDING
# LOOPBACK ONES, AND THAT BREAKS 127.0.0.1 ENTIRELY. A SYN to 127.0.0.1 went out with src = net_ip,
# so the passive open recorded the peer as net_ip and sent its SYN-ACK back to net_ip — while the
# connecting side's conn holds dst_ip = 127.0.0.1. `tcp_find_conn(..., src_ip)` then finds no match,
# the reply lands on an unknown 4-tuple, and `sock_connect` #47 returns -1 with its own slot zeroed.
#
# ⛔ POST-MORTEM (2026-08-03) — HOW THIS WENT UNNOTICED, AND WHAT IT COST. BEFORE THIS FIX (agnos
# 1.56.34), on-device loopback TCP could not complete on an ordinary boot. The one place anyone
# tested it BEFORE THIS FIX was the `AETHERSAFHA_SETU_SELFTEST` / `MISHRAN_DUPLEX_SELFTEST` kernel
# hooks, which assigned `net_ip = 0x7F000001` before launching their peer — making src and dst agree
# BY ACCIDENT. Every "green" produced under those hooks was a FALSE GREEN and must not be cited as
# proof of anything. Those hooks are DELETED (main.cyr) and must never be reintroduced; a
# kernel-side `net_ip` assignment is rigging, not a fix.
#
# ⭐ AFTER THIS FIX IT DID WORK, UN-RIGGED — scope it honestly, do not over-retract. On 2026-08-02,
# on 1.56.34+, `scripts/harness/aethersafha-clients-test.py` reached "connected: 2, presented: 2":
# setu's slim `present_probe` (staged as /bin/puka) AND the real dhancha `crab` both connected and
# presented. That harness byte-scans `build/agnos` and HARD-EXITS if the kernel carries any selftest
# hook ("a kernel carrying any such hook does not fail this test, it INVALIDATES it"), and attaches
# a virtio NIC so DHCP yields a real `net_ip` — it is the harness that CAUGHT the rigging. ⚠ Scope:
# that run was QEMU at `-smp 1`. It was never shown on iron, and `-smp 4` fault-kills.
#
# ⛔ THE TRANSPORT IS RETIRED ANYWAY — AND NOT FOR THAT REASON. TCP-on-loopback as the display
# protocol is the WRONG PRIMITIVE for local display IPC (operator ruling, 2026-08-03): a local
# channel has nothing to route, nothing to checksum, no window to negotiate, no RTO, and no business
# owning a port. The replacement is the agnos socket (`anu`).
# See docs/development/planning/ipc.md §9-§10.
#
# ⚠ `net_src_for` itself is CORRECT AND STAYS. Route-derived source selection is right regardless of
# who first needed it, and TCP stays too — agnos is A General NETWORKED Operating System and TCP is
# correct FOR THE NETWORK. What died is a display protocol riding it, not the stack.
#
# ⭐ Every other stack does this and it is not novel: the source address comes from the ROUTE, and
# the loopback route's source is 127.0.0.1. Only the destination's shape decides it.
#
# ⚠ ONLY 127.x REWRITES. `net_is_loopback` is deliberately NOT the test here — it also answers 1 for
# `dst == net_ip` (a host dialling its own real address), and that case must keep net_ip as the
# source so the 4-tuple stays (net_ip -> net_ip). Using net_is_loopback here would rewrite it to
# 127.0.0.1 and break the case that already worked.
#
# ⭐ Fixes the NIC-less box too: with no DHCP `net_ip` is 0, so a loopback packet used to carry
# src = 0 and the reply went to dst = 0, which is not loopback and got handed to a NIC that is not
# there. A loopback source is correct with or without a NIC.
fn net_src_for(dst_ip) {
    if (((dst_ip >> 24) & 0xFF) == 127) { return 0x7F000001; }
    return net_ip;
}

# Copy a fully-framed eth frame into the loopback queue (drop + count on full). 1.49.0 loopback bite 1.
# 1.57.7 (S4): the caller holds net_tx_lock (net_tx is only reached from inside a TX bracket); the queue
# itself is lo_q_lock's (chain order net_tx < lo_q).
fn net_lo_enqueue(buf, len) {
    if (net_tx_inside != 1) { net_lk_latch(2, "net: lock missing - frame sent without net_tx_lock", 50); }
    var le_f = lo_q_begin();
    var le_r = 0;
    if (lo_count >= 8) {
        lo_dropped = lo_dropped + 1;
        le_r = 0 - 1;
    } else {
        var le_len = len;
        if (le_len > 1536) { le_len = 1536; }
        var slot = &lo_ring + lo_tail * 1536;
        memcpy(slot, buf, le_len);
        store64(&lo_lens + lo_tail * 8, le_len);
        lo_tail = (lo_tail + 1) & 7;
        lo_count = lo_count + 1;
    }
    lo_q_end(le_f);
    return le_r;
}

# Drain the loopback queue through net_demux_frame (the SAME demux the NIC ring uses). Bounded budget;
# the loop also processes frames the demux just enqueued (a TCP SYN's SYN-ACK, etc.), so a full
# handshake completes here without net_tx ever recursing. 1.49.0 loopback bite 1.
# ⛔ 1.57.7 (S4, N-2) — THE SLOT IS FREED AFTER ITS DEMUX, NOT BEFORE. The old body advanced lo_head and
# decremented lo_count BEFORE net_demux_frame(slot), so any enqueue during the demux — a reply the demux itself
# sends when the queue was full, or another CPU's net_tx — could land in the very slot being parsed. Now the
# demux runs IN PLACE while the slot still counts as occupied, and lo_drain_lock (a TRY-lock) makes this the
# single consumer. DRAIN-UNLOCK-RECHECK: a frame enqueued while we held the try-lock (whose own drainer lost
# the try) is picked up by the re-check after the unlock, so nothing is stranded.
fn net_lo_drain() {
    if (lo_count == 0) { return 0; }               # lock-free pre-check (a racing enqueue: the re-check or the next poll)
    var ld_total = 0;
    var ld_pass = 0;
    while (ld_pass < 2) {
        ld_pass = ld_pass + 1;
        if (lo_drain_trylock() != 0) { return ld_total; }   # another context drains; its post-unlock re-check delivers
        var ld_budget = 64;
        while (ld_budget > 0) {
            ld_budget = ld_budget - 1;
            var ld_f = lo_q_begin();
            if (lo_count == 0) { lo_q_end(ld_f); break; }
            var slot = &lo_ring + lo_head * 1536;
            var slen = load64(&lo_lens + lo_head * 8);
            lo_q_end(ld_f);
            net_demux_frame(slot, slen);           # IN PLACE: the slot still counts as occupied
            var ld_g = lo_q_begin();
            lo_head = (lo_head + 1) & 7;           # free AFTER the demux (N-2)
            lo_count = lo_count - 1;
            lo_q_end(ld_g);
            ld_total = ld_total + 1;
        }
        lo_drain_unlock();
        if (lo_count == 0) { return ld_total; }
    }
    return ld_total;
}

# net_tx — the TX chokepoint. An IPv4 frame whose dst is loopback (net_is_loopback) is queued for the
# loopback drain instead of the wire; everything else (ARP, off-box IP) goes to nic_send. 1.49.0
# loopback bite 1. The dst IP sits at eth(14) + ip-dst-offset(16) = frame offset 30.
fn net_tx(buf, len) {
    if (len >= 34) {
        var ethertype = (load8(buf + 12) << 8) | load8(buf + 13);
        if (ethertype == 0x0800) {
            var dst = (load8(buf + 30) << 24) | (load8(buf + 31) << 16) | (load8(buf + 32) << 8) | load8(buf + 33);
            # 1.57.7 (S5, D21): the loopback path returns the FRAME LENGTH like both drivers (virtio_net/r8169
            # return the length they queued) — it returned 0, so udp_send#52 to 127.x read as "0 bytes". A full
            # lo queue still returns -1 (dropped).
            if (net_is_loopback(dst) == 1) {
                var lo_r = net_lo_enqueue(buf, len);
                if (lo_r < 0) { return lo_r; }
                return len;
            }
        }
    }
    return nic_send(buf, len);
}

fn udp_send(dst_ip, src_port, dst_port, data, data_len) {
    # 1.49.0 loopback: a loopback dst doesn't need a NIC up; only gate non-loopback sends on nic_ready.
    if (nic_ready() == 0 && net_is_loopback(dst_ip) == 0) { return 0 - 1; }
    # Default to broadcast MAC — correct for QEMU SLIRP and any actual
    # broadcast destination. For non-broadcast dst_ip, consult the route
    # helper; if resolved, use the next-hop MAC instead.
    var dst_mac[8];
    memset(&dst_mac, 0xFF, 6);
    if (dst_ip != 0xFFFFFFFF) {
        route_next_hop_mac(dst_ip, &dst_mac);
    }
    var kmac[8];
    nic_mac(&kmac);   # FIX #1
    var us_f = net_tx_begin();                 # 1.57.7 (S4): build + send in one net_tx_lock hold
    var p = &net_pkt;
    var off = eth_build(p, &dst_mac, &kmac, 0x0800);
    var udp_len = udp_build(p + off + 20, src_port, dst_port, data, data_len);
    ip_build(p + off, net_src_for(dst_ip), dst_ip, 17, udp_len);   # route-derived source (see net_src_for)
    var us_r = net_tx(p, off + 20 + udp_len);
    net_tx_end(us_f);
    return us_r;
}

# Send a UDP datagram with an explicit src_ip override (for DHCP, where
# the kernel doesn't have an assigned IP yet — src_ip=0.0.0.0). Bypasses
# net_ip. Identical to udp_send otherwise. (1.32.0 bite G — DHCP needs this.)
fn udp_send_from(src_ip, dst_ip, src_port, dst_port, data, data_len) {
    if (nic_ready() == 0) { return 0 - 1; }
    var dst_mac[8];
    memset(&dst_mac, 0xFF, 6);
    var kmac[8];
    nic_mac(&kmac);   # FIX #1
    var usf_f = net_tx_begin();                # 1.57.7 (S4): build + send in one net_tx_lock hold
    var p = &net_pkt;
    var off = eth_build(p, &dst_mac, &kmac, 0x0800);
    var udp_len = udp_build(p + off + 20, src_port, dst_port, data, data_len);
    ip_build(p + off, src_ip, dst_ip, 17, udp_len);
    var usf_r = nic_send(p, off + 20 + udp_len);
    net_tx_end(usf_f);
    return usf_r;
}

# === UDP listener table (1.32.0 bite F — server-side UDP) ===
# 8 listeners × 64 bytes per entry (1.57.7 S5: 48 → 64 for the owner fields). Layout per entry:
#   offset 0:  state (0=free, 1=bound)
#   offset 8:  local_port (u16 effective; stored as u64)
#   offset 16: buf_ptr — the slot's 1024-byte BOOT-POOL buffer (udp_pool_buf[id]; 1.57.7 S5: never freed)
#   offset 24: buf_len (0 if no datagram pending; else bytes received)
#   offset 32: peer_ip (src ip of most-recent received datagram)
#   offset 40: peer_port (src port of most-recent received datagram)
#   offset 48: owner tag (1.57.7 S5) — pid+1 of the binding incarnation; 0 = kernel (DHCP 68, the DNS and NTP
#              client ports) or free
#   offset 56: owner epoch — proc_epoch[tag-1] at bind time; 0 when the tag is 0
# Module-global `var X[N]` = N×u64 = 8N bytes per [[feedback_cyrius_var_array_u64_units]]
# → var udp_listeners[64] = 64*8 = 512 bytes = 8 × 64 byte entries. ✓
var udp_listeners[64];
var udp_listener_count = 0;
# 1.57.7 (S5) — the UDP BOOT POOL: slot i's 1024-byte receive buffer, kmalloc'd ONCE by udp_pool_init (main.cyr,
# after tcp_pool_init, before dhcp_init's bind). bind/unbind/udp_release_pid never touch the heap, so the death
# release is legal from any context (S7's ring-3-tick ISR included) and no listener buffer is ever freed under
# an ISR copy.
var udp_pool_buf[8];
var udp_pool_ready = 0;

fn udp_listener_base(listener_id) {
    return &udp_listeners + listener_id * 64;
}

fn udp_pool_init() {
    if (udp_pool_ready == 1) { return 0; }
    var up_ok = 1;
    for (var upi = 0; upi < 8; upi = upi + 1) {
        var up_b = kmalloc(1024);
        store64(&udp_pool_buf + upi * 8, up_b);
        if (up_b == 0) { up_ok = 0; }
    }
    if (up_ok == 0) {
        for (var upj = 0; upj < 8; upj = upj + 1) {
            var up_c = load64(&udp_pool_buf + upj * 8);
            if (up_c != 0) { kfree_sized(up_c, 1024); }
            store64(&udp_pool_buf + upj * 8, 0);
        }
        return 0 - 1;
    }
    udp_pool_ready = 1;
    return 0;
}

# 1.57.7 (S5, D13) — UDP listener ownership: tcp_owner_is's shape over +48/+56. Lock-free = prefilter only.
fn udp_owner_is(uo_lid, uo_own) {
    if (uo_lid < 0) { return 0; }
    if (uo_lid >= udp_listener_count) { return 0; }
    var uo_lb = udp_listener_base(uo_lid);
    if (load64(uo_lb + 48) != uo_own) { return 0; }
    if (uo_own == 0) { return 1; }
    if (uo_own > 16) { return 0; }
    if (load64(uo_lb + 56) != proc_epoch_get(uo_own - 1)) { return 0; }
    return 1;
}
fn udp_auth(ua_lid) {
    if (udp_owner_is(ua_lid, proc_current_get() + 1) == 1) { return ua_lid; }
    return 0 - 1;
}

fn udp_find_listener(port) {
    for (var i = 0; i < udp_listener_count; i = i + 1) {
        var lb = udp_listener_base(i);
        if (load64(lb) == 1) {
            if (load64(lb + 8) == port) { return i; }
        }
    }
    return 0 - 1;
}

# Allocate a UDP listener slot (1.45.3): reuse a free slot (state 0) below the
# high-water mark, else extend the mark (cap 8). Returns listener_id or -1.
# Mirrors the TCP tcp_alloc_conn_slot reclaim — without it (and udp_unbind),
# a ring-3 consumer that binds an ephemeral port per query (dig) leaks one of
# the 8 listener slots per query and exhausts the table.
fn udp_alloc_listener_slot() {
    for (var i = 0; i < udp_listener_count; i = i + 1) {
        if (load64(udp_listener_base(i)) == 0) { return i; }
    }
    if (udp_listener_count >= 8) { return 0 - 1; }
    var id = udp_listener_count;
    udp_listener_count = udp_listener_count + 1;
    return id;
}

# 1.57.7 (S4): the listener table is udp_lock's; the dup check, the slot claim and the field stores (state LAST)
# are one hold, so two CPUs cannot bind one port. 1.57.7 (S5): owned by `ub_own` (0 = kernel, else pid+1 —
# the epoch is stamped in the same hold) and the 1024-byte receive buffer is the slot's BOOT-POOL buffer (no
# heap on bind/unbind). (1.32.2 FIX #8: 1024 bytes carries any realistic DHCP OFFER/ACK — the old 256 truncated
# server-id / subnet / gateway.)
fn udp_bind_owned(ub_port, ub_own) {
    if (udp_pool_ready != 1) { return 0 - 1; }
    if (ub_own < 0 || ub_own > 16) { return 0 - 1; }
    var ub_ep = 0;
    if (ub_own != 0) { ub_ep = proc_epoch_get(ub_own - 1); }
    var ubd_f = udp_begin();
    var listener_id = 0 - 1;
    if (udp_find_listener(ub_port) < 0) {      # not already bound
        listener_id = udp_alloc_listener_slot();
    }
    if (listener_id >= 0) {
        var lb = udp_listener_base(listener_id);
        store64(lb + 8, ub_port);
        store64(lb + 16, load64(&udp_pool_buf + listener_id * 8));
        store64(lb + 24, 0);       # no pending datagram
        store64(lb + 32, 0);
        store64(lb + 40, 0);
        store64(lb + 48, ub_own);  # owner stamp (S5), before the publish
        store64(lb + 56, ub_ep);
        store64(lb, 1);            # bound — published LAST
    }
    udp_end(ubd_f);
    return listener_id;
}
fn udp_bind(port) { return udp_bind_owned(port, 0); }   # in-kernel callers (DHCP, DNS, NTP)

# Drain the most-recent datagram from the listener's buffer. CALLER HOLDS udp_lock (1.57.7 S5); no poll. -2 when
# `tk_own` does not own it; else the bytes copied (0 if none pending). On success the out-params (either may
# be 0 to skip) get the peer's addressing. buf/ipo/po: kernel memory or ranges #53 validated (mapped).
fn udp_take_own(tk_lid, buf, maxlen, src_ip_out, src_port_out, tk_own) {
    if (udp_owner_is(tk_lid, tk_own) == 0) { return 0 - 2; }
    var lb = udp_listener_base(tk_lid);
    var copy_len = 0;
    if (load64(lb) == 1) {
        var rx_len = load64(lb + 24);
        if (rx_len > 0) {
            var rx_buf = load64(lb + 16);
            copy_len = rx_len;
            if (copy_len > maxlen) { copy_len = maxlen; }
            net_copy_buf(buf, rx_buf, copy_len);
            if (src_ip_out != 0) { store64(src_ip_out, load64(lb + 32)); }
            if (src_port_out != 0) { store64(src_port_out, load64(lb + 40)); }
            store64(lb + 24, 0);  # consumed
        }
    }
    return copy_len;
}
# The polling receive (1.57.7 S5: owned): the lock-free owner prefilter BEFORE net_poll, then the check + copy +
# consume in one udp_lock hold (S4). Returns n, 0 (none / bad id), or -2 (not `ur_own`'s).
fn udp_recv_from_own(listener_id, buf, maxlen, src_ip_out, src_port_out, ur_own) {
    if (listener_id < 0) { return 0; }
    if (listener_id >= udp_listener_count) { return 0; }
    if (udp_owner_is(listener_id, ur_own) == 0) { return 0 - 2; }
    net_poll();   # absorb any pending packets first — OUTSIDE udp_lock (a demux under it would self-deadlock)
    var urf_f = udp_begin();
    var urf_n = udp_take_own(listener_id, buf, maxlen, src_ip_out, src_port_out, ur_own);
    udp_end(urf_f);
    return urf_n;
}
fn udp_recv_from(listener_id, buf, maxlen, src_ip_out, src_port_out) {   # in-kernel callers (own 0)
    var urk = udp_recv_from_own(listener_id, buf, maxlen, src_ip_out, src_port_out, 0);
    if (urk < 0) { return 0; }
    return urk;
}

# Release a UDP listener (1.45.3): mark the slot free so udp_alloc_listener_slot can reuse it (the reclaim pair
# for udp_bind — dig binds an ephemeral port per query). 1.57.7 (S5): owned — 0 when `uu_own` owned the bound
# slot (pending datagram dropped, owner unstamped, state 0 LAST; +16 stays bound to the pool), 0 for a kernel
# re-unbind of an already-free tag-0 slot (idempotent), else -1.
fn udp_unbind_own(uu_lid, uu_own) {
    if (uu_lid < 0) { return 0 - 1; }
    if (uu_lid >= udp_listener_count) { return 0 - 1; }
    var lb = udp_listener_base(uu_lid);
    var uub_f = udp_begin();
    var uu_r = 0 - 1;
    if (load64(lb) == 1 && udp_owner_is(uu_lid, uu_own) == 1) {
        store64(lb + 24, 0);       # drop any pending datagram
        store64(lb + 48, 0);
        store64(lb + 56, 0);
        store64(lb, 0);            # state = free (reclaimable) — LAST
        uu_r = 0;
    } elif (uu_own == 0 && load64(lb) == 0 && load64(lb + 48) == 0) {
        uu_r = 0;
    }
    udp_end(uub_f);
    return uu_r;
}
fn udp_unbind(listener_id) { return udp_unbind_own(listener_id, 0); }   # in-kernel callers

# Both death sites (S7: proc_death_release). Heap-free, IRQ-safe; one hold per slot. Idempotent.
fn udp_release_pid(ur_pid) {
    if (ur_pid < 0) { return 0; }
    if (ur_pid >= 16) { return 0; }
    for (var uri = 0; uri < udp_listener_count; uri = uri + 1) {
        var ur_f = udp_begin();
        if (load64(udp_listener_base(uri)) == 1 && udp_owner_is(uri, ur_pid + 1) == 1) {
            var urb = udp_listener_base(uri);
            store64(urb + 24, 0);
            store64(urb + 48, 0);
            store64(urb + 56, 0);
            store64(urb, 0);       # LAST
        }
        udp_end(ur_f);
    }
    return 0;
}

# #52's source-port rule (1.57.7 S5, EADDRINUSE semantics): 1 when `ss_sport` is unbound or bound by `ss_own`;
# 0 when another owner (a kernel port included) holds it.
fn udp_sport_ok(ss_sport, ss_own) {
    var ss_f = udp_begin();
    var ss_r = 0;
    var ss_lid = udp_find_listener(ss_sport);
    if (ss_lid < 0) { ss_r = 1; }
    elif (udp_owner_is(ss_lid, ss_own) == 1) { ss_r = 1; }
    udp_end(ss_f);
    return ss_r;
}

# === per-protocol + ingress + TCP split into siblings (1.36.x net.cyr refactor) ===
# net.cyr now holds only the L2/L3 core: Ethernet / ARP-build / IPv4 / UDP transport
# + the UDP listener table. Included after this file in agnos.cyr, in order:
#   net_dhcp -> net_icmp -> net_dns -> net_ntp -> net_rtc -> net_ingress -> net_tcp.
