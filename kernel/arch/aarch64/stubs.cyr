# rdtsc equivalent — use ARM counter
fn rdtsc() {
    var count = 0;
    # MRS x0, CNTVCT_EL0
    asm { 0x42; 0xE0; 0x3B; 0xD5; 0xE0; 0x03; 0x00; 0xF9; }
    return count;
}

# rdrand stub — aarch64 doesn't have a direct RDRAND equivalent; use
# CNTVCT_EL0 as the entropy source. Lower quality than RDRAND but
# acceptable for KASLR's "different layout per boot" property. v1.28.0.
fn rdrand_u64() {
    return rdtsc();
}

# 1.56.60 — mirror of the x86_64 halt-exclusion bracket (arch/x86_64/io.cyr). `wfi` is the same
# parked state as `hlt`: the core is blocked, not working, so the tick must not be charged.
fn arch_wait() {
    var aw_c = pcpu_cpu();
    if (aw_c < 4) { store64(&cpu_in_halt + aw_c * 8, 1); }
    wfi();
    if (aw_c < 4) { store64(&cpu_in_halt + aw_c * 8, 0); }
    return 0;
}
fn arch_halt() { wfi(); return 0; }

# ⭐ 1.56.60 — stubs for the recovery shell's stop verbs. kernel/user/shell.cyr is included
# UNCONDITIONALLY (agnos.cyr:72) but core/power.cyr lives inside #ifdef ARCH_X86_64 (:117),
# so the shell's reboot/poweroff/halt arms reference symbols this port does not have. PSCI is
# the real aarch64 answer (SYSTEM_OFF 0x84000008 / SYSTEM_RESET 0x84000009 via SMC); until
# that is written, refuse rather than pretend: returning -1 is exactly what power_sys returns
# on a magic mismatch, which the callers already treat as "did not stop the machine".
fn arch_cli() { return 0; }
fn power_sys(magic1, magic2, cmd, arg) { return 0 - 1; }

# 1.57.7 (S7) — the lifecycle names shared code reaches. The death chain, the tick path and the signal delivery live
# in x86-only files (syscall.cyr / sched.cyr); this port has no ring-3 processes to end, stop or continue.
# proc_create_user (shared proc.cyr) asks proc_birth_check: always "born". The klug lock is uncontended on one core
# (trylock always wins). The signal-bit atomics are plain RMWs (no second CPU runs ring-3 code here).
fn proc_birth_check(child, creator) { return 1; }
fn klug_trylock() { return 0; }
fn klug_unlock() { return 0; }
fn atomic_or64(addr, v) { store64(addr, load64(addr) | v); return 0; }
fn atomic_and64(addr, v) { store64(addr, load64(addr) & v); return 0; }

# 1.57.11 — read-only ZFS (core/zfs.cyr) lives inside #ifdef ARCH_X86_64 like ext2/exFAT, but shared vfs.cyr reaches
# two of its names: zfs_active (the mount table) and zfs_fd_read (the read arm). This port never imports a pool:
# never active, and a ZFS fd cannot exist, so the read arm refuses. 1.57.12 B5: the write arm (vfs.cyr) and lseek's
# SEEK_END (syscall.cyr) reach zfs_fd_write and zfs_fd_size — refused the same way.
var zfs_active = 0;
fn zfs_fd_read(slot, buf, count) { return 0 - 1; }
fn zfs_fd_write(slot, buf, count) { return 0 - 1; }
fn zfs_fd_size(slot) { return 0 - 1; }
# 1.57.12 B6 review: vfs.cyr's write arm logs a refused ZFS write (zfs_wr_say over zfs_wr_lit) — never reached here.
var zfs_wr_lit = 0;
fn zfs_wr_say(verb) { return 0; }
# 1.57.12 B11: vfs.cyr's close#6 and fd-table teardown commit a ZFS fd's pending policy-B txg (zfs_wp_close) — no ZFS fd
# exists on this port, so there is never one to commit.
fn zfs_wp_close(base) { return 0; }

# ── 1.57.13 — THE COMPILE DEBT ───────────────────────────────────────────────────────────────────────────────────────────
# `sh scripts/build.sh --aarch64` had failed since the per-CPU / direct-map / FS-in-the-shell work of 1.46.x–1.57.x reached
# the SHARED files (pmm / heap / proc / vfs / klug / kprint / shell / init) while the subsystems those names live in stayed
# inside agnos.cyr's x86_64 block: 32 undefined functions and 17 undefined variables the compiler REPORTED, plus 40 more
# undefined functions it did NOT (below). Every name here is the x86 interface the shared caller already uses, given the
# value the x86 code itself returns when the hardware or the subsystem is ABSENT — the Linux shape for a configured-out
# subsystem (include/linux/*.h `#else static inline … { return -ENODEV; }`, e.g. of.h / blkdev.h), so the shared callers'
# own "not mounted / no NIC / not loaded" arms run. A pure byte helper gets the x86 body verbatim instead (a caller never
# reads a made-up value). ⛔ This makes the port COMPILE AND LINK; it does not make it work: the port (MMU, atomics, SMP,
# a block driver, ring 3) is the 1.6x arc, and the x86 machine code the shared files still emit into this image (pmm's
# xchg locks, cr3_load, klug's and proc's PAUSE) is listed in roadmap.md's aarch64 row — an aarch64 boot would run it.
#
# ⛔ THE 40 THE COMPILER DID NOT REPORT (measured 2026-10-13, cyrius 6.6.6, both backends). cycc counts an undefined
# function as "reachable" only when its FIRST reference sits in a reachable function: a name first called from a dead fn
# is dropped from the refusal even when a LATER call site is live — and cycc_aarch64 does not even warn. The live call is
# emitted as the unresolved placeholder (aarch64 `udf #0`, x86 `ud2; ud2`) and the build prints OK. Before this block,
# kprint's fb_print (first referenced in klug's dead klug_replay_fb) would have been `udf #0` on the first kernel line,
# and vfs.cyr's fs_spin_lock (first referenced in the dead proc_destroy_fd_table) on every vfs_*_on path. 13 of the 40 had a
# live call site; all 40 are stubbed, so this image carries no unresolved call at all. Repro + the upstream filing
# owed: CHANGELOG [1.57.13] § Fixed. The check that does not trust the compiler's count: scripts/check/placeholder-check.sh
# (no all-zero word in .text; fail-closed). build.sh runs it after every build and REFUSES a holed image, so after adding a
# name here `sh scripts/build.sh --aarch64` going green is the proof (test.sh --aarch64 and check.sh gate 39 score it too).

# MEMORY — flat physical. pt_init (paging.cyr) leaves the MMU off, so a physical address IS its own address and this
# port's "direct map" is the identity, base 0 (asm-generic/page.h without an MMU: PAGE_OFFSET 0, __va(x) = x).
# ⚠ THE IDENTITY IS RIGHT ONLY FOR AN ADDRESS THAT IS RAM ON THIS PORT — on QEMU virt, RAM starts at 0x40000000 (this
# file's tss_kernel_stack 0x40800000, main.cyr's initrd at 0x40700000). The SHARED callers compute x86 PHYSICAL-LAYOUT
# addresses, which on virt are flash and GIC / UART / PCIe MMIO, not RAM: proc.cyr's per-slot RSP0 (DIRECTMAP_BASE +
# region 7: proc_alloc_slot stores proc_rsp0[0] = 0xE10000 under main.cyr's proc_create(0)) and kthread_stack_top
# (0xF10000 +), and pmm.cyr's frames (i * 0x1000 from phys 4 MB, which heap.cyr's slab_grow and kfont map through
# pmm_kva_for_access). No DIRECTMAP_BASE value fixes that: the LAYOUT is x86's. Inert today — pmm's xchg lock traps
# before a frame is handed out, and nothing here reads proc_rsp0 or calls kthread_create / proc_rsp0_top — and listed
# as 1.6x port work in roadmap.md's aarch64 row (a pmm / region map based at this port's RAM).
# The page-table-page tripwires (proc.cyr, x86 ELF_PDE_PROBE) have no page tables to guard — their non-probe twins' 0;
# dm_read_cr3 (klug's covered spill) reads a CR3 this port does not have — 0, as with the MMU off.
var DIRECTMAP_BASE = 0;
fn pmm_kva_for_access(phys) { return phys; }
fn ptpage_alarm_if_live(a) { return 0; }
fn ptpage_alarm_if_live_2mb(base) { return 0; }
fn dm_read_cr3() { return 0; }

# CPU IDENTITY + LOCKS — one core (cpu_count = 1 above). x86's pcpu_cpu / tss_get_current_cpu_id read the per-CPU GS / APIC
# id; here every per-CPU slot is slot 0 (proc.cyr's accessors take their cpu_count < 2 fast path anyway). tss_get_cpu_stack
# (proc_rsp0_top's fallback) answers this file's tss_kernel_stack — the one kernel stack top this port has. The heap,
# proc-table, console, fs, vfs and sched locks are no-ops like spin_lock / flock_spin_lock / pipe_spin_lock above.
fn pcpu_cpu() { return 0; }
fn tss_get_current_cpu_id() { return 0; }
fn tss_get_cpu_stack(cpu_id) { return tss_kernel_stack; }
fn heap_spin_lock() { return 0; }
fn heap_spin_unlock() { return 0; }
fn proctab_spin_lock() { return 0; }
fn proctab_spin_unlock() { return 0; }
fn console_spin_lock() { return 0; }
fn console_spin_unlock() { return 0; }
fn fs_spin_lock() { return 0; }
fn fs_spin_unlock() { return 0; }
fn fs_spin_trylock() { return 0; }   # always won (one core) — klug_spill_owed_run (1.57.14), zfs_wp_owed_run, proc_orphan_owed_run
fn vfs_spin_lock() { return 0; }
fn vfs_spin_unlock() { return 0; }
fn sched_spin_lock() { return 0; }
