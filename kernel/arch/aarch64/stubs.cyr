# Pure byte helpers, not a subsystem: the x86 bodies (ext2.cyr), the 32-bit loads spelled with the 16-bit one.
fn ext2_load16_le(ptr, off) { return load8(ptr + off) | (load8(ptr + off + 1) << 8); }
fn ext2_inode_mode(inode) { return ext2_load16_le(inode, 0); }
fn ext2_inode_filesize(inode) {
    var lo = ext2_load16_le(inode, 4) | (ext2_load16_le(inode, 6) << 16);
    var hi = ext2_load16_le(inode, 108) | (ext2_load16_le(inode, 110) << 16);
    return lo | (hi << 32);
}
