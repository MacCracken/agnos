# === Intel VT-d IOMMU (DMA Remapping) ===
# Restricts DMA so a PCI device can reach only memory a driver GRANTED. Needs an ACPI DMAR table: acpi.cyr's
# acpi_parse_dmar picks the remapping unit (the only DRHD, or the INCLUDE_PCI_ALL one) and collects the RMRRs.
#
# ⭐ 1.57.10 (VTD) — THIS FILE RUNS NOW. Until 1.57.10 no boot had ever turned translation on, not even in QEMU: q35 +
# `-device intel-iommu` publishes a DMAR, and iommu_init returned -1 at its first step (the old iommu_map_mmio refused
# PDPT[3]'s 1 GB page, which is pt_init's normal layout, so "IOMMU: init failed" was the only line any boot ever printed).
# scripts/smoke/vtd-smoke.sh now boots it with translation ON — q35 + intel-iommu with caching-mode on and off, 3- and
# 4-level tables, a controller behind a root port — and requires xHCI / NVMe / virtio / AHCI / HDA DMA to keep working
# with zero DMAR faults. docs/architecture/dma-cpu-pointers.md § "VT-d: the grant model" is the model; the prior art is
# Linux drivers/iommu/intel (iommu.c, cache.c, dmar.c), FreeBSD sys/x86/iommu and the VT-d spec Rev 5.20.
#
# VT-d registers (MMIO at iommu_base; spec §11.4, Linux intel/iommu.h DMAR_*_REG):
#   0x00 VER   0x08 CAP   0x10 ECAP   0x18 GCMD (WRITE-ONLY: reads 0)   0x1C GSTS   0x20 RTADDR   0x28 CCMD
#   0x34 FSTS  0x38 FECTL 0x64 PMEN   0x80 IQH  0x88 IQT  0x90 IQA   0x9C ICS   0xB0 IQER
#   ECAP.IRO*16 = IVA, +8 = IOTLB (register-based invalidation); CAP.FRO*16 = the fault-recording registers, 16 B each.
#   (⛔ until 1.57.10 this banner put CCMD at 0x24, FSTS at 0x28 and IQH/IQT at 0x58/0x60. The code used 0x28 for CCMD.)
#
# Translation structures (legacy mode): root table (4 KB = 256 x 16 B, one entry per BUS) -> context table (4 KB =
# 256 x 16 B, one entry per DEVFN) -> the domain's second-level (SL) table, `iommu_levels` deep (3 = 39-bit, 4 = 48-bit
# AGAW), EPT-format entries (R bit 0, W bit 1, PS bit 7), 2 MB leaves.
# ⛔ Until 1.57.10 the context entry said AW=1 and a comment called that "30-bit AGAW, 2-level" — but AW=1 IS 39-bit /
# 3-level (spec §9.3; 000b, the old 2-level, is Reserved since Rev 2.5 and QEMU rejects it), while the SLPTPTR named ONE
# PD-shaped table of 2 MB leaves. Every DMA would have walked that table as a PML3 of 1 GB "pages" with reserved bits set.
#
# ⭐ THE GRANT MODEL (docs/architecture/dma-cpu-pointers.md). ONE domain, DID 1 (DID 0 is reserved when CAP.CM is set,
# spec §9.3), that EVERY device shares, IOVA == phys: a device may DMA into a 2 MB region only if a driver called
# iommu_register_dma(phys) for a page in it, it is the first 16 MB (the kernel image with its .bss DMA buffers), or it
# is a firmware RMRR. 2 MB granularity: a grant opens the rest of its region too. Every devfn on every bus pci_scan
# populated points at the domain, so requester-ID aliasing (a PCIe-to-PCI bridge, a phantom function) cannot miss.
#   - BEFORE iommu_init a grant is RECORDED in iommu_pend[] and REPLAYED into the tables before TE. ⛔ Until 1.57.10 it
#     was a no-op: xhci_rings_init, xhci_ctx, hid and msc all grant before iommu_init runs (main.cyr brings the keyboard
#     up first), so with translation on every xHCI ring outside the first 16 MB would have faulted (issue 2026-09-26).
#   - AFTER TE the leaf is written and then invalidated as the hardware requires (iommu_after_new_leaf).
#   - After an init that did not enable translation (or no DMAR at all): a no-op, as before.
#   - NEVER the unit's own memory (1.57.13, the VTD review): its tables and queue pages live in own 2 MB chunks that
#     iommu_map_2mb and iommu_register_dma refuse (iommu_own) — no device can reach what the unit reads untranslated.
#
# CR3 AUDIT (1.57.9, extended 1.57.10): the tables are written through their direct-map KVA (dma_kva), never phys, so a
# grant is correct under ANY CR3 — which matters now: after TE a grant can come from a syscall (msc's lazily allocated data
# page, hda's stream buffers) under a process's CR3, or from the xHCI event path on an AP. iommu_base is the identity VA of
# the register block in PDPT[3], which vmm_remap_uc_2mb shatters at boot, before any process exists, and every
# per-process PDPT copies. The grant path holds iommu_lock (smp.cyr, IRQ-saved) across the table edit + invalidation.
#
# ⭐ 1.57.13 (QI) — QUEUED INVALIDATION (issue 2026-09-26-vt-d-queued-invalidation; spec §6.5.2). Whenever ECAP.QI is set,
# every context-cache and IOTLB invalidation goes through the invalidation queue, the Linux way (intel/dmar.c
# dmar_enable_qi / __dmar_enable_qi / qi_submit_sync / qi_check_fault, iommu.c qi_flush_context / qi_flush_iotlb), with
# FreeBSD sys/x86/iommu/intel_qi.c as the second reference (its IQH-based room check and its sequence-numbered status
# word): ONE 4 KB queue page (256 x 128-bit descriptors: IQA.QS = 0, DW = 0), GCMD.QIE with a GSTS.QIES wait, every
# invalidation followed by an invalidation-wait descriptor whose Status Write lands in a status page, and FSTS's IQE / ITE
# / ICE checked on every poll. The register interface stays as the FALLBACK (no ECAP.QI, no memory for the queue, or a
# VTD_REGISTER_INV test build), CAIG / IAIG checks included; at VER major >= 6 it is refused, because there every
# register invalidation is an incorrect one (spec §6.5.1). Until 1.57.13 such a unit was refused outright.
# ⚠ Linux uses QI under Caching Mode too; FreeBSD's dmar_init_qi forces the register interface when CAP.CM is set. This
# file follows Linux (the issue's ruling): vtd-smoke's CM=1 boot runs the queue, including the post-TE page-selective
# invalidation.

var iommu_base = 0;        # MMIO base of the remapping unit (identity VA — vmm_remap_uc_2mb maps its 2 MB chunk UC)
var iommu_active = 0;      # 1 once GSTS.TES confirmed translation ON (ext2.cyr keeps its direct-to-caller DMA off then)
var iommu_init_ran = 0;    # 1 once iommu_init ran (success or not): closes the pre-init grant log
var iommu_ver = 0;         # VER (major 7:4, minor 3:0)
var iommu_cap = 0;         # CAP
var iommu_ecap = 0;        # ECAP
var iommu_cm = 0;          # CAP.CM (bit 7): the unit may cache NOT-PRESENT entries -> every new grant needs an invalidation
var iommu_rwbf = 0;        # CAP.RWBF (bit 4): a write-buffer flush is needed where no invalidation is
var iommu_levels = 0;      # SL table depth: 4 (48-bit AGAW) if SAGAW offers it, else 3 (39-bit), else 5 (57-bit)
var iommu_sp2m = 0;        # CAP.SLLPS bit 0 (CAP bit 34): 2 MB SL leaves; 0 = a 4 KB-leaf table per granted 2 MB
var iommu_iova_top = 0;    # exclusive bound on a grantable address: min(2^(12 + 9 * levels), 2^MGAW)
var iommu_iotlb_off = 0;   # ECAP.IRO * 16: the IVA register; the IOTLB register is at +8
var iommu_drain = 0;       # IOTLB DR (bit 49) / DW (bit 48), set when CAP.DRD (55) / CAP.DWD (54) say they are honoured
var iommu_fro = 0;         # CAP.FRO * 16: the first fault-recording register
var iommu_nfr = 0;         # CAP.NFR + 1: how many there are
var IOMMU_DID = 1;         # the one domain id (0 is reserved under CM)

# ⛔ 1.57.9 (CPUVA) — every table is held TWICE, the Linux intel-iommu way (iommu->root_entry is a KVA, virt_to_phys()
# only at the register): *_phys goes ONLY into what the hardware walks — RTADDR, a root entry's context-table pointer, a
# context entry's SLPTPTR, an SL non-leaf entry — and *_kva (dma_kva, the direct map) is the only address the CPU memsets,
# loads or stores. Lower-level tables are reached by dma_kva(entry & mask), Linux phys_to_virt(dma_pte_addr(pte)).
var iommu_root_phys = 0;   # root table (bus 0..255) — physical, for RTADDR
var iommu_root_kva = 0;    #   ... its direct-map CPU pointer
var iommu_top_phys = 0;    # the domain's top SL table (level iommu_levels) — physical, for every context entry's SLPTPTR
var iommu_top_kva = 0;     #   ... its direct-map CPU pointer
var iommu_ctx_buses = 0;   # context tables installed (one per bus pci_scan found a function on)
# ⛔ 1.57.13 (the VTD review) — THE UNIT'S OWN MEMORY IS NEVER GRANTED. The root, context and SL tables and the queue and
# status pages live in whole 2 MB "own chunks" that no grant can open. Until 1.57.13 each was a pmm_alloc page, and
# pmm_alloc hands pages out top-down — into the very 2 MB region the replayed xHCI grant had opened read/write, in the one
# domain EVERY device shares. Measured (vtd-smoke boot A): RTADDR 0xffe1000, queue 0xffe3000, status 0xffe2000, all under
# the leaf 0xfe00083 virtio-net translated through. A device could rewrite the SL tables (the whole grant model, since
# 1.57.10), write the status word early (an invalidation "done" before it ran), or forge a wait descriptor whose Status
# Address the unit then writes UNTRANSLATED. iommu_table_new now carves pages from an own chunk (iommu_own_grow takes one:
# a whole free 2 MB region no grant can ever cover), and iommu_map_2mb / iommu_register_dma refuse a chunk. Linux and
# FreeBSD need no such rule — a per-device domain maps only what the DMA API handed out — but a 2 MB identity grant opens
# its whole region, so here the unit's memory must own whole regions.
var iommu_own[8];          # module scope = 8 x u64: the own chunks' 2 MB-aligned bases
var iommu_own_n = 0;       # chunks taken: the first at iommu_init, another only when the newest is used up
var iommu_own_used = 0;    # pages carved from the newest chunk (0..512)
var iommu_own_pages = 0;   # pages carved in all (the own-structures line)
var iommu_own_rej[8];      # module scope = 8 x u64: candidates one take refused, held so the search moves past them
# ECAP.C (Extended Capability bit 0, "Coherency"): 1 = the remapping hardware snoops the CPU caches when it walks these
# tables; 0 = it reads memory, so every table write must be clflushed out first (Linux __iommu_flush_cache). Read before
# the first table write; 0 (the safe answer) until then. QEMU reports 0, so the smoke runs the clflush path.
var iommu_coherent = 0;

# The pre-init grant log (issue 2026-09-26): the 2 MB-aligned base of every region granted before iommu_init, dedup'd.
# A boot records a handful (xHCI's DCBAA / scratchpad / command + event rings / ERST, each slot's contexts and EP rings,
# the HID and MSC buffers — pmm_alloc hands them out top-down, so they share few 2 MB regions). A grant that does not
# fit is counted in iommu_pend_lost and iommu_init then REFUSES to enable translation: a lost grant is a certain fault.
var iommu_pend[64];        # module scope = 64 x u64
var iommu_pend_n = 0;
var iommu_pend_lost = 0;

# What the grant path did — printed by iommu_init (the enable line) and iommu_boot_report (the late check line).
var iommu_n_leaf = 0;      # 2 MB SL leaves written (every grant that was new, default + RMRR + replay + late)
var iommu_n_replayed = 0;  # pre-init log entries replayed into the tables at iommu_init
var iommu_n_rmrr = 0;      # 2 MB leaves written for firmware RMRRs
var iommu_n_late = 0;      # new leaves written AFTER translation was on
var iommu_n_psi = 0;       # page-selective IOTLB invalidations issued for those (CM = 1)
var iommu_n_dsi = 0;       # domain-selective fallbacks (CM = 1 without PSI, or MAMV < 9)
var iommu_n_wbf = 0;       # write-buffer flushes for those (CM = 0, RWBF = 1)
var iommu_n_inv_fail = 0;  # an invalidation / flush that timed out or reported granularity 0
var iommu_n_refused = 0;   # grants refused: past the table, no memory for a table, or the pre-init log full
var iommu_refused_said = 0;
var iommu_n_faults = 0;    # fault records drained by iommu_fault_scan

# 1.57.13 (QI) — the invalidation queue (see the banner). Every field is touched only under iommu_lock, or by iommu_init
# before any grant can reach the tables (the register interface's rule).
var iommu_qi = 0;          # 1 = every invalidation goes through the queue (GSTS.QIES latched); 0 = the register interface
var iommu_qi_phys = 0;     # the queue page (256 x 16 B descriptors) — physical, for IQA only
var iommu_qi_kva = 0;      #   ... its direct-map CPU pointer: every descriptor store goes through it
var iommu_qi_st_phys = 0;  # the status page: a wait descriptor's Status Address (the u32 at +0) — physical, descriptor only
var iommu_qi_st_kva = 0;   #   ... its direct-map CPU pointer: the poll reads it
var iommu_qi_tail = 0;     # the software tail: the next slot to fill (0..255); IQT = tail << 4
var iommu_qi_seq = 0;      # the last Status Data issued (FreeBSD inv_waitd_seq): only THIS wait's write can match a poll
var iommu_qi_drain = 0;    # IOTLB descriptor DR (bit 7) / DW (bit 6), from CAP.DRD / CAP.DWD (Linux qi_flush_iotlb)
var iommu_qi_dead = 0;     # 1 = a submission could be neither completed nor recovered: nothing more is submitted
var iommu_qi_why = 0;      # its first reason: 1 wait timed out, 2 QIES clear, 3 IQE unrecoverable, 4 ITE, 5 no room
var iommu_n_qi = 0;        # submissions completed (each = its descriptor + one wait, or a bare wait)
var iommu_n_iqe = 0;       # Invalidation Queue Errors seen (FSTS.IQE)
var iommu_n_ite = 0;       # Invalidation Time-out Errors seen (FSTS.ITE — device-TLB only; this kernel issues none)
var iommu_n_ice = 0;       # Invalidation Completion Errors seen (FSTS.ICE — device-TLB only)
# 1.57.13 (the VTD review) — a wait that outlasts the bound STALLS the queue instead of killing it: Linux qi_submit_sync and
# FreeBSD wait without a bound, a hypervisor's vIOMMU can be preempted, a DR/DW drain can queue behind heavy DMA. The
# stalled submission stays the in-flight record below; the NEXT submission first gives it one more full bound
# (iommu_qi_settle), and only a wait still incomplete then is DEAD.
var iommu_qi_bound = 1000000;  # polls per bound (the bound every wait in this file uses); vtdst_qi_stall shortens it once
var iommu_qi_cur_first = 0;    # the in-flight submission: its first slot,
var iommu_qi_cur_wi = 0;       #   its wait's slot,
var iommu_qi_cur_seq = 0;      #   its wait's Status Data,
var iommu_qi_cur_iqe = 0;      #   1 once an IQE was recovered in it (a second one is not recoverable)
var iommu_qi_stalled = 0;      # 1 = the in-flight wait outlasted a bound (its caller was told NOT performed)
var iommu_n_stall = 0;         # waits that outlasted a bound
var iommu_qi_told = 0;         # what the grant path has said lock-free, once each: bit 0 STALLED, bit 1 DEAD
var iommu_qi_hold = 0;         # TEST-ONLY (vtdst_qi_stall): 1 = submit does not write IQT, so its wait cannot complete
# VTD_REGISTER_INV (TEST-ONLY, scripts/smoke/vtd-smoke.sh boot AR): never enable the queue, so the register interface — the
# fallback a unit without ECAP.QI gets — is booted on QEMU, whose unit always offers QI. Production prefers the queue.
#ifdef VTD_REGISTER_INV
var iommu_qi_forbid = 1;
#endif
#ifndef VTD_REGISTER_INV
var iommu_qi_forbid = 0;
#endif

# VT-d register read/write. ⚠ iommu_write64 is ONE 8-byte store: QEMU runs a CCMD / IOTLB command only on the 8-byte
# write or on the write of the HIGH dword, and the spec starts it on "the uppermost byte" (ICC / IVT live in bit 63).
fn iommu_read32(off) {
    return load32(iommu_base + off);
}

fn iommu_write32(off, val) {
    store32(iommu_base + off, val);
    return 0;
}

fn iommu_read64(off) {
    return load64(iommu_base + off);
}

fn iommu_write64(off, val) {
    store64(iommu_base + off, val);
    return 0;
}

# The grant lock (smp.cyr iommu_spin_lock, a byte-copy of heap_spin_lock): IRQs off FIRST, so an ISR on this CPU can never
# spin on a lock this CPU holds. Nothing prints under it.
fn iommu_lock() {
    var il_f = kbd_irq_save();
    iommu_spin_lock();
    return il_f;
}

fn iommu_unlock(iu_f) {
    iommu_spin_unlock();
    kbd_irq_restore(iu_f);
    return 0;
}

# Wait for GSTS bit `bit` to read `val` (1 = set, 0 = clear). 0 on success, -1 on timeout.
fn iommu_wait_gsts(bit, val) {
    var timeout = 0;
    while (timeout < 1000000) {
        var gsts = iommu_read32(0x1C);
        if (val == 1) {
            if ((gsts & bit) != 0) { return 0; }
        } else {
            if ((gsts & bit) == 0) { return 0; }
        }
        timeout = timeout + 1;
    }
    return 0 - 1;
}

# VT-d §11.4.4.1: GCMD is WRITE-ONLY (reads 0 — spec, and QEMU's vtd_define_long_wo) and every write is a whole command:
# the persistent enables (TE 31, QIE 26, IRE 25, CFI 23) must be re-sent each time and the one-shot bits (SRTP 30, SFL 29,
# WBF 27, SIRTP 24) must not be. The spec's recipe: Status = GSTS & 96FFFFFFh, Command = Status | bit (or & ~bit), then
# wait for GSTS. ⛔ Until 1.57.10 this file wrote `iommu_read32(0x18) | bit` — a read of the write-only register, i.e. 0 —
# which drops every persistent enable the unit already had (QEMU compares the write against GSTS: a TE write without IRE
# turns interrupt remapping off). Linux keeps a software copy seeded from GSTS; this reads GSTS each time instead.
fn iommu_gcmd_status() {
    return iommu_read32(0x1C) & 0x96FFFFFF;
}

# Register-based invalidation (spec §6.5.1; Linux __iommu_flush_context / __iommu_flush_iotlb, FreeBSD dmar_inv_ctx_glob
# / dmar_inv_iotlb_glob). One 64-bit store each, then poll the busy bit (ICC / IVT, bit 63) clear, then check the ACTUAL
# granularity the unit reports: 0 means it did NOT perform the request (the spec's answer to every register invalidation at
# VER major >= 6, which iommu_init already refuses; Linux prints "Flush IOTLB failed" for IAIG == 0). 0 ok, -1 failed.
fn iommu_inv_context_global() {
    iommu_write64(0x28, (1 << 63) | (1 << 61));             # CCMD: ICC | CIRG = 01 (global)
    var t = 0;
    while (t < 1000000) {
        var v = iommu_read64(0x28);
        if ((v & (1 << 63)) == 0) {
            if (((v >> 59) & 3) == 0) { return 0 - 1; }      # CAIG (60:59) = 0: not performed
            return 0;
        }
        t = t + 1;
    }
    return 0 - 1;
}

# kind: 1 = global, 2 = domain-selective (DID 1), 3 = page-selective (iova 2^am x 4 KB, naturally aligned; IH = 0 so the
# unit also drops any cached NON-leaf entry that maps the range — a table the grant just linked in included).
fn iommu_inv_iotlb(kind, iova, am) {
    var cmd = (1 << 63) | (kind << 60) | iommu_drain;       # IVT | IIRG | DR/DW
    if (kind != 1) { cmd = cmd | (IOMMU_DID << 32); }
    if (kind == 3) { iommu_write64(iommu_iotlb_off, (iova & 0xFFFFFFFFFFFFF000) | am); }   # IVA: ADDR | IH = 0 | AM
    iommu_write64(iommu_iotlb_off + 8, cmd);
    var t = 0;
    while (t < 1000000) {
        var v = iommu_read64(iommu_iotlb_off + 8);
        if ((v & (1 << 63)) == 0) {
            if (((v >> 57) & 3) == 0) { return 0 - 1; }      # IAIG (58:57) = 0: not performed
            return 0;
        }
        t = t + 1;
    }
    return 0 - 1;
}

# Spec §6.8 / Linux iommu_flush_write_buffer: only on RWBF hardware, which may hold a table write in the chipset write
# buffer where the remapping walk cannot see it. WBF is one-shot and WBFS CLEARS when the flush is done (FreeBSD's
# dmar_flush_write_bufs waits for it to SET — inverted polarity, not copied). 1 flushed, 0 not needed, -1 timeout.
fn iommu_flush_write_buffer() {
    if (iommu_rwbf == 0) { return 0; }
    iommu_write32(0x18, iommu_gcmd_status() | (1 << 27));   # GCMD.WBF
    if (iommu_wait_gsts(1 << 27, 0) != 0) { return 0 - 1; }
    return 1;
}

# 1.57.9 — Linux __iommu_flush_cache: on remapping hardware that does NOT snoop (ECAP.C == 0) its table walk reads memory,
# so a table store still sitting dirty in a CPU cache is invisible to it. Write back every cache line of [kva, kva + len)
# — clflush(addr) is io.cyr's documented single-line helper — then mfence so the write-backs are globally visible before
# the caller's next register write (RTADDR, SRTP/TE, an invalidation) or the next device access. No-op when ECAP.C == 1.
fn iommu_flush_cache(kva, len) {
    if (iommu_coherent != 0) { return 0; }
    var a = kva & (0 - 64);
    var end = kva + len;
    while (a < end) {
        clflush(a);
        a = a + 64;
    }
    arch_mfence();
    return 0;
}

# Is `pa` inside one of the unit's own chunks (1.57.13)? Such an address is never grantable.
fn iommu_is_own(pa) {
    var oc = pa & 0xFFFFFFFFFFE00000;
    for (var i = 0; i < iommu_own_n; i = i + 1) {
        if (load64(&iommu_own + i * 8) == oc) { return 1; }
    }
    return 0;
}

# Is the 2 MB region holding `pa` granted? iommu_map_2mb's walk, read-only. 0 before the tables exist, and past the
# table's reach (iommu_map_2mb refuses that).
fn iommu_granted(pa) {
    if (iommu_top_kva == 0) { return 0; }
    if (pa < 0) { return 0; }
    if (pa >= iommu_iova_top) { return 0; }
    var tk = iommu_top_kva;
    var lvl = iommu_levels;
    while (lvl > 2) {
        var e = load64(tk + ((pa >> (12 + 9 * (lvl - 1))) & 0x1FF) * 8);
        if ((e & 3) == 0) { return 0; }
        tk = dma_kva(e & 0x000FFFFFFFFFF000);
        lvl = lvl - 1;
    }
    if ((load64(tk + ((pa >> 21) & 0x1FF) * 8) & 3) == 0) { return 0; }
    return 1;
}

# May the 2 MB region at `c` hold the unit's own structures? Only if no grant can EVER cover it: outside the default
# 16 MB, not a pre-init grant waiting for the replay, in no RMRR's range, not granted already (a grant is never revoked),
# and inside the direct map (the CPU reaches every own page through dma_kva).
fn iommu_own_fits(c) {
    if (c < 0x1000000) { return 0; }
    for (var i = 0; i < iommu_pend_n; i = i + 1) {
        if (load64(&iommu_pend + i * 8) == c) { return 0; }
    }
    for (var ri = 0; ri < acpi_dmar_rmrr_n; ri = ri + 1) {
        var ra = load64(&acpi_dmar_rmrr + ri * 16) & 0xFFFFFFFFFFE00000;
        var rl = load64(&acpi_dmar_rmrr + ri * 16 + 8);
        if (c >= ra) {
            if (c <= rl) { return 0; }
        }
    }
    if (iommu_granted(c) != 0) { return 0; }
    var ck = dma_kva(c);
    if (dma_kva_ok(ck) == 0) { return 0; }
    if (dma_kva_ok(ck + 0x1FF000) == 0) { return 0; }
    return 1;
}

# Take one more own chunk: a whole free 2 MB region (pmm_alloc_2mb_run_under over the live bitmap, top-down — away from the
# low regions sys_mmap's pmm_alloc_2mb scans first, as room_init's fallback). A candidate that does not fit is held while
# the search moves on (freeing it at once would hand it straight back), then freed. Under iommu_lock at runtime (lock order
# iommu < pmm), or in iommu_init. 1 = taken, 0 = none: the table allocation that needed it fails, which its caller reports.
fn iommu_own_grow() {
    if (iommu_own_n >= 8) { return 0; }
    var got = 0;
    var nrej = 0;
    while (nrej < 8) {
        var c = pmm_alloc_2mb_run_under(1, pmm_2mb_top_region);
        if (c == 0) { break; }
        if (iommu_own_fits(c) != 0) {
            got = c;
            break;
        }
        store64(&iommu_own_rej + nrej * 8, c);
        nrej = nrej + 1;
    }
    for (var i = 0; i < nrej; i = i + 1) { pmm_free_2mb(load64(&iommu_own_rej + i * 8)); }
    if (got == 0) { return 0; }
    store64(&iommu_own + iommu_own_n * 8, got);
    iommu_own_n = iommu_own_n + 1;
    iommu_own_used = 0;
    return 1;
}

# A zeroed, flushed page for one of the unit's own structures, carved from the newest own chunk (another is taken when it
# is used up — one chunk is 512 pages: the root, a context table per bus, the SL tables and the two queue pages). Returns
# its PHYS (0 = no memory); the caller reaches it through dma_kva(phys). Own pages are never returned to pmm.
fn iommu_table_new() {
    if (iommu_own_n == 0 || iommu_own_used >= 512) {
        if (iommu_own_grow() == 0) { return 0; }
    }
    var tp = load64(&iommu_own + (iommu_own_n - 1) * 8) + iommu_own_used * 4096;
    iommu_own_used = iommu_own_used + 1;
    iommu_own_pages = iommu_own_pages + 1;
    var tn_kva = dma_kva(tp);
    memset(tn_kva, 0, 4096);
    iommu_flush_cache(tn_kva, 4096);
    return tp;
}

# === Queued invalidation (1.57.13; spec §6.5.2) ===
# The queue page and the status page are read and written by the REMAPPING UNIT ITSELF, never through translation (IQA and
# a wait's Status Address are physical; QEMU fetches and writes them through address_space_memory). So, like the root /
# context / SL tables, they must lie where no DEVICE can reach them: both are own-chunk pages (iommu_table_new), and no
# grant can open an own chunk. ⛔ This comment first said "neither is granted" while both were pmm_alloc pages inside the
# 2 MB region the replayed xHCI grant had opened (the VTD review; see iommu_own). Both are held twice
# (docs/architecture/dma-cpu-pointers.md): the phys goes only into IQA and the wait descriptor's Status Address; every
# descriptor store and every status poll goes through the dma_kva pointer, correct under any CR3 (a grant after TE can
# submit from a syscall or from an AP). Neither is clflushed: Linux qi_submit_sync and FreeBSD dmar_qi_emit store
# descriptors with plain writes (ECAP.C describes the translation-structure walk, not the queue fetch); the mfence before
# the IQT write orders them ahead of the hand-over, the job Linux's writel barrier does.

# Store one 128-bit descriptor into queue slot `slot` (the high qword first; the unit fetches nothing before IQT moves).
fn iommu_qi_put(slot, lo, hi) {
    var qd = iommu_qi_kva + (slot & 0xFF) * 16;
    store64(qd + 8, hi);
    store64(qd, lo);
    return 0;
}

# Free slots between the software tail and the unit's own head (FreeBSD dmar_qi_ensure reads IQH the same way). One slot
# always stays empty, so head == tail means EMPTY.
fn iommu_qi_room() {
    var qh = (iommu_read32(0x80) >> 4) & 0xFF;
    return (qh - iommu_qi_tail - 1) & 0xFF;
}

# The queue can no longer be trusted: a head that stopped never moves again, and register-based invalidation is not
# allowed while QIE is set, so nothing is submitted from here on and every later invalidation counts as failed (fail
# closed: translation stays as it is; a grant made after this may fault, which the boot DMA check reports). Returns -1.
fn iommu_qi_die(why) {
    if (iommu_qi_dead == 0) { iommu_qi_why = why; }
    iommu_qi_dead = 1;
    return 0 - 1;
}

# Linux qi_check_fault, for one submission whose descriptors are slots [first, wi], the wait at wi. FSTS:
#   IQE (bit 4) — the unit stopped AT the descriptor IQH names (it was malformed) and fetches nothing until IQE is clear.
#        If that slot is one of ours BEFORE the wait: overwrite it with a copy of the wait (Linux's recovery — the re-fetch
#        finds a well-formed descriptor whose status write is ours, and nothing behind it is skipped), clear IQE (W1C), and
#        write IQT again, unchanged: a no-op on hardware, which resumes on the clear, and the only thing that restarts
#        QEMU's fetch (its FSTS handler does not — "FIXME: when IQE is Clear, should we try to fetch"). Returns 1:
#        recovered, but that descriptor was NOT performed (a SECOND IQE in the same submission means the recovery did not
#        take: the caller declares the queue dead). An IQE at the wait itself, or outside this submission: -3.
#   ITE (bit 6) — a device-TLB invalidation timed out and every pending wait was aborted. This kernel issues no device-TLB
#        invalidation (no ATS), so it is not ours to retry: clear it (W1C) and fail, -4.
#   ICE (bit 5) — an invalidation completion error (a device-TLB ITag): clear it (W1C) and keep waiting, as Linux does, 0.
fn iommu_qi_fault(first, wi) {
    var fs = iommu_read32(0x34);
    if ((fs & 0x70) == 0) { return 0; }
    if ((fs & 0x10) != 0) {
        iommu_n_iqe = iommu_n_iqe + 1;
        var qh = (iommu_read32(0x80) >> 4) & 0xFF;
        if (((qh - first) & 0xFF) >= ((wi - first) & 0xFF)) { return 0 - 3; }
        var ws = iommu_qi_kva + wi * 16;
        iommu_qi_put(qh, load64(ws), load64(ws + 8));
        arch_mfence();
        iommu_write32(0x34, 0x10);                           # FSTS.IQE (W1C)
        iommu_write32(0x88, iommu_qi_tail << 4);             # IQT, unchanged: resume the fetch
        return 1;
    }
    if ((fs & 0x40) != 0) {
        iommu_n_ite = iommu_n_ite + 1;
        iommu_write32(0x34, 0x40);                           # FSTS.ITE (W1C)
        return 0 - 4;
    }
    iommu_n_ice = iommu_n_ice + 1;
    iommu_write32(0x34, 0x20);                               # FSTS.ICE (W1C)
    return 0;
}

# Poll the in-flight submission (iommu_qi_cur_*) for up to one bound, iommu_qi_fault on every turn (Linux qi_submit_sync's
# loop). drained = 1 also requires IQH == IQT (a stall settling: nothing may be left queued behind it). 0 = its wait wrote
# its status; 1 = it did, but an IQE was recovered in it (that descriptor was NOT performed); -1 = the queue died here;
# -2 = the bound ran out.
fn iommu_qi_wait(drained) {
    var t = 0;
    while (t < iommu_qi_bound) {
        if (load32(iommu_qi_st_kva) == iommu_qi_cur_seq) {
            var done = 1;
            if (drained != 0) {
                if (iommu_read32(0x80) != iommu_read32(0x88)) { done = 0; }
            }
            if (done != 0) { return iommu_qi_cur_iqe; }
        }
        var r = iommu_qi_fault(iommu_qi_cur_first, iommu_qi_cur_wi);
        if (r == 1) {
            if (iommu_qi_cur_iqe != 0) {                     # a SECOND IQE in one submission: the recovery did not take
                iommu_qi_die(3);
                return 0 - 1;
            }
            iommu_qi_cur_iqe = 1;
        }
        if (r < 0) {
            iommu_qi_die(0 - r);
            return 0 - 1;
        }
        t = t + 1;
    }
    return 0 - 2;
}

# A STALLED submission gets ONE more full bound — its status word must carry its sequence and the queue be drained — before
# anything else is queued behind it. 0 = it completed late (the stall is over); -1 = the queue is dead: "the wait descriptor
# never completed (timeout)" now means two full bounds, with the caller's own work done in between.
fn iommu_qi_settle() {
    var sr = iommu_qi_wait(1);
    if (sr == 0 - 2) { return iommu_qi_die(1); }
    if (sr < 0) { return 0 - 1; }
    iommu_qi_stalled = 0;
    return 0;
}

# Linux qi_submit_sync: `n` descriptors (0 or 1: lo / hi), then an invalidation-wait descriptor — type 5 | SW (Status
# Write, bit 5), Status Data = a fresh sequence number in bits 63:32, Status Address = the status page — the tail moved
# ONCE, then the status word polled with iommu_qi_fault on every turn. Synchronous, under iommu_lock (or in iommu_init
# before any grant can reach the tables), so one submission is in flight at a time and the sequence number alone tells
# this wait's write from any older one (FreeBSD's inv_waitd_seq). IF is never set: QEMU asserts SW and IF are not both
# set, and a polled wait needs no interrupt. A stall left by the previous submission is settled first. 0 = performed.
# -1 = NOT performed (the caller counts it): the queue is dead; the previous stall did not settle in a second bound (DEAD);
# GSTS.QIES is clear (posting into a queue the unit does not fetch waits forever — QIE not set before submit); no room
# (the head never moved); an IQE (recovered or not); an ITE; or this wait did not write its status within the bound
# (1 M polls) — then the queue is STALLED, not dead (1.57.13, the VTD review: until then that was the timeout death, and a
# slow but working unit lost the queue for the rest of the boot).
fn iommu_qi_submit(lo, hi, n) {
    if (iommu_qi_dead != 0) { return 0 - 1; }
    if (iommu_qi_stalled != 0) {
        if (iommu_qi_settle() != 0) { return 0 - 1; }
    }
    if ((iommu_read32(0x1C) & (1 << 26)) == 0) { return iommu_qi_die(2); }
    var spin = 0;
    while (iommu_qi_room() < n + 1) {
        spin = spin + 1;
        if (spin > 1000000) { return iommu_qi_die(5); }
    }
    var first = iommu_qi_tail;
    if (n != 0) { iommu_qi_put(first, lo, hi); }
    var wi = (first + n) & 0xFF;
    iommu_qi_seq = (iommu_qi_seq + 1) & 0x7FFFFFFF;
    if (iommu_qi_seq == 0) { iommu_qi_seq = 1; }
    iommu_qi_put(wi, (iommu_qi_seq << 32) | (1 << 5) | 5, iommu_qi_st_phys);
    iommu_qi_tail = (wi + 1) & 0xFF;
    iommu_qi_cur_first = first;
    iommu_qi_cur_wi = wi;
    iommu_qi_cur_seq = iommu_qi_seq;
    iommu_qi_cur_iqe = 0;
    arch_mfence();
    if (iommu_qi_hold == 0) { iommu_write32(0x88, iommu_qi_tail << 4); }   # IQT: hand the descriptors to the unit
    var w = iommu_qi_wait(0);
    if (w == 0) {
        iommu_n_qi = iommu_n_qi + 1;
        return 0;
    }
    if (w == 0 - 2) {
        iommu_qi_stalled = 1;
        iommu_n_stall = iommu_n_stall + 1;
    }
    return 0 - 1;
}

# Linux dmar_disable_qi (FreeBSD dmar_disable_qi): turn off a queue firmware or a previous kernel left on. First give the
# unit the chance to finish what is queued (IQH == IQT, bounded) — the spec forbids disabling with requests pending, and
# QEMU refuses it ("improper state when disable QI") and leaves QIES set. ⛔ Until 1.57.13 iommu_init cleared QIE without
# that wait. 0 = off, -1 = QIES would not clear.
fn iommu_qi_disable() {
    var dq = 0;
    while (dq < 1000000) {
        if (iommu_read32(0x80) == iommu_read32(0x88)) { break; }
        dq = dq + 1;
    }
    iommu_write32(0x18, iommu_gcmd_status() & 0xFBFFFFFF);  # GCMD.QIE off
    return iommu_wait_gsts(1 << 26, 0);
}

# Linux dmar_enable_qi + __dmar_enable_qi, FreeBSD dmar_init_qi: the queue page and the status page (zeroed, so the status
# word matches no sequence number), stale IQE / ICE / ITE cleared first (Linux intel_iommu_init_qi clears old faults),
# IQT = 0 BEFORE IQA (Linux: "write zero to the tail reg"), IQA = base | DW = 0 (128-bit descriptors: scalable mode is not
# used) | QS = 0 (one page, 256 descriptors), then GCMD.QIE and the GSTS.QIES wait. 1 = the queue is on; 0 = no memory
# for it (the register interface stays — Linux falls back when dmar_enable_qi fails); -1 = QIES never latched.
fn iommu_qi_enable() {
    var qp = iommu_table_new();
    if (qp == 0) { return 0; }
    var sp = iommu_table_new();
    if (sp == 0) { return 0; }                               # (qp stays carved: own-chunk pages are never returned)
    iommu_qi_phys = qp;
    iommu_qi_kva = dma_kva(qp);
    iommu_qi_st_phys = sp;
    iommu_qi_st_kva = dma_kva(sp);
    iommu_qi_tail = 0;
    iommu_qi_seq = 0;
    iommu_qi_dead = 0;
    iommu_write32(0x34, 0x70);                               # FSTS: W1C a stale ITE / ICE / IQE
    iommu_write32(0x88, 0);                                  # IQT = 0
    iommu_write64(0x90, qp & 0x000FFFFFFFFFF000);            # IQA: base | DW = 0 | QS = 0
    iommu_write32(0x18, iommu_gcmd_status() | (1 << 26));   # GCMD.QIE
    if (iommu_wait_gsts(1 << 26, 1) != 0) { return 0 - 1; }
    iommu_qi = 1;
    return 1;
}

# Why the queue died, that it is stalled, or that an IQE was recovered — one line, never under iommu_lock. LOCK-FREE (klug +
# COM1 directly, the shape of iommu_register_dma's REFUSED line) for every caller: iommu_init's refusals, the boot DMA
# check, and since 1.57.13's VTD review the grant path, which can run in interrupt context where kprint's console lock may
# be held by the very code the interrupt stopped. ⛔ Until then only the first two said it, so a queue that stalled or
# died on a grant AFTER the one-shot boot DMA check was never reported at all.
fn iommu_qi_tell() {
    if (iommu_qi == 0) { return 0; }
    if (iommu_qi_dead == 0) {
        if (iommu_qi_stalled != 0) {
            klug_append("iommu: queued invalidation STALLED - a wait outlasted the bound; the next submission settles it", 95);
            klug_putc(10);
            serial_println("iommu: queued invalidation STALLED - a wait outlasted the bound; the next submission settles it", 95);
            return 0;
        }
        if (iommu_n_iqe != 0) {
            klug_append("iommu: queued invalidation - IQE recovered: a malformed descriptor was NOT performed", 84);
            klug_putc(10);
            serial_println("iommu: queued invalidation - IQE recovered: a malformed descriptor was NOT performed", 84);
        }
        return 0;
    }
    if (iommu_qi_why == 1) {
        klug_append("iommu: queued invalidation DEAD - the wait descriptor never completed (timeout)", 79);
        klug_putc(10);
        serial_println("iommu: queued invalidation DEAD - the wait descriptor never completed (timeout)", 79);
    }
    if (iommu_qi_why == 2) {
        klug_append("iommu: queued invalidation DEAD - GSTS.QIES clear at submit: QIE was never set", 78);
        klug_putc(10);
        serial_println("iommu: queued invalidation DEAD - GSTS.QIES clear at submit: QIE was never set", 78);
    }
    if (iommu_qi_why == 3) {
        klug_append("iommu: queued invalidation DEAD - an IQE that could not be recovered", 68);
        klug_putc(10);
        serial_println("iommu: queued invalidation DEAD - an IQE that could not be recovered", 68);
    }
    if (iommu_qi_why == 4) {
        klug_append("iommu: queued invalidation DEAD - an ITE (device-TLB invalidation time-out)", 75);
        klug_putc(10);
        serial_println("iommu: queued invalidation DEAD - an ITE (device-TLB invalidation time-out)", 75);
    }
    if (iommu_qi_why == 5) {
        klug_append("iommu: queued invalidation DEAD - no room: the queue head never moved", 69);
        klug_putc(10);
        serial_println("iommu: queued invalidation DEAD - no room: the queue head never moved", 69);
    }
    return 0;
}

# The invalidations iommu_init and the grant path need, through whichever interface is in use. 0 performed, -1 not.
# Linux qi_flush_context (QI_CC_TYPE | QI_CC_GRAN(global)) / __iommu_flush_context.
fn iommu_flush_context_global() {
    if (iommu_qi != 0) { return iommu_qi_submit((1 << 4) | 1, 0, 1); }      # type 1, G (5:4) = 01 global
    return iommu_inv_context_global();
}

# Linux qi_flush_iotlb / __iommu_flush_iotlb. kind as iommu_inv_iotlb: 1 global, 2 domain (DID 1), 3 page-selective (iova,
# 2^am x 4 KB, IH = 0).
fn iommu_flush_iotlb(kind, iova, am) {
    if (iommu_qi != 0) {
        var lo = 2 | (kind << 4) | iommu_qi_drain;           # type 2, G (5:4), DR (7) / DW (6)
        if (kind != 1) { lo = lo | (IOMMU_DID << 16); }      # DID (31:16)
        var hi = 0;
        if (kind == 3) { hi = (iova & 0xFFFFFFFFFFFFF000) | am; }   # ADDR (63:12) | IH (6) = 0 | AM (5:0)
        return iommu_qi_submit(lo, hi, 1);
    }
    return iommu_inv_iotlb(kind, iova, am);
}

# Map the 2 MB region holding `pa` to itself (IOVA == phys) in the shared domain. The caller holds iommu_lock, or is
# iommu_init before any grant can reach the tables. 1 = a new leaf, 0 = already granted, -1 = refused (past the table's
# reach or MGAW, or no memory for a table). Intermediate tables are created on demand — the walk Linux pfn_to_dma_pte does —
# and linked only AFTER they are zeroed and flushed, so the hardware can never walk a half-built table.
# ⛔ 1.56.52 refused phys >= 1 GB because the old table was ONE page (512 x 2 MB) and its index mask wrapped a high address
# onto an existing grant. The walked table has no such wrap: every level's index comes from its own address bits.
fn iommu_map_2mb(pa) {
    if (iommu_top_kva == 0) { return 0 - 1; }
    if (pa < 0) { return 0 - 1; }
    if (iommu_is_own(pa) != 0) { return 0 - 1; }             # the unit's own chunk (1.57.13): never grantable
    if (pa >= iommu_iova_top) { return 0 - 1; }
    var chunk = pa & 0xFFFFFFFFFFE00000;
    var tk = iommu_top_kva;                                  # CPU pointer of the table being walked (the direct map)
    var lvl = iommu_levels;
    while (lvl > 2) {
        var slot = tk + ((chunk >> (12 + 9 * (lvl - 1))) & 0x1FF) * 8;
        var e = load64(slot);
        if ((e & 3) == 0) {
            var np = iommu_table_new();
            if (np == 0) { return 0 - 1; }
            e = np | 3;                                      # non-leaf: R | W (a walk needs the rights at every level)
            store64(slot, e);
            iommu_flush_cache(slot, 8);
        }
        tk = dma_kva(e & 0x000FFFFFFFFFF000);
        lvl = lvl - 1;
    }
    var leaf_slot = tk + ((chunk >> 21) & 0x1FF) * 8;
    if ((load64(leaf_slot) & 3) != 0) { return 0; }          # already granted (a 2 MB leaf, or a 4 KB table of one)
    var leaf = chunk | 0x83;                                 # R | W | PS: a 2 MB page (bits 20:12 zero — it is aligned)
    if (iommu_sp2m == 0) {
        var pt = iommu_table_new();                          # no 2 MB leaves on this unit: 512 x 4 KB instead
        if (pt == 0) { return 0 - 1; }
        var pt_kva = dma_kva(pt);
        for (var j = 0; j < 512; j = j + 1) {
            store64(pt_kva + j * 8, (chunk + j * 4096) | 3);
        }
        iommu_flush_cache(pt_kva, 4096);
        leaf = pt | 3;
    }
    store64(leaf_slot, leaf);
    iommu_flush_cache(leaf_slot, 8);
    iommu_n_leaf = iommu_n_leaf + 1;
    return 1;
}

# Record a grant made before iommu_init (caller holds iommu_lock). 1 recorded, 0 already recorded, -1 log full.
fn iommu_pend_add(pa) {
    if (pa < 0) { return 0 - 1; }
    var chunk = pa & 0xFFFFFFFFFFE00000;
    for (var i = 0; i < iommu_pend_n; i = i + 1) {
        if (load64(&iommu_pend + i * 8) == chunk) { return 0; }
    }
    if (iommu_pend_n >= 64) {
        iommu_pend_lost = iommu_pend_lost + 1;
        return 0 - 1;
    }
    store64(&iommu_pend + iommu_pend_n * 8, chunk);
    iommu_pend_n = iommu_pend_n + 1;
    return 1;
}

# After a NEW leaf is written while translation is ON (caller holds iommu_lock) — the not-present -> present rule of spec
# §6.1 / §6.8, as Linux applies it (cache.c cache_tag_flush_range_np; v6.1 __mapping_notify_one: "It's a non-present to
# present mapping. Only flush if caching mode and second level.") and FreeBSD's dmar_map_buf:
#   CM = 1 (the unit may have CACHED the not-present entry — QEMU caching-mode=on, any vIOMMU a hypervisor shadows):
#          invalidate the 2 MB range page-selectively (AM = 9, 2^9 x 4 KB), or the whole domain when the unit has no PSI or
#          its MAMV cannot express 9 — Linux's and FreeBSD's fallback;
#   CM = 0 with RWBF: flush the write buffer; CM = 0 otherwise: nothing (hardware never caches a not-present entry).
# ⛔ Until 1.57.10 nothing followed a runtime grant (issue 2026-09-26): on a CM=1 unit a device could keep faulting on a
# region it had just been granted. ⚠ QEMU cannot show that failure — it never caches a failed translation — so the gate is
# the n_psi / n_dsi counters against QEMU's own trace (scripts/smoke/vtd-smoke.sh): of the IOTLB register on the register
# interface, of the IOTLB descriptor (vtd_inv_desc_iotlb_pages) on the queue (1.57.13).
fn iommu_after_new_leaf(pa) {
    if (iommu_cm != 0) {
        var r = 0;
        if (((iommu_cap >> 39) & 1) != 0 && ((iommu_cap >> 48) & 0x3F) >= 9) {
            r = iommu_flush_iotlb(3, pa & 0xFFFFFFFFFFE00000, 9);
            iommu_n_psi = iommu_n_psi + 1;
        } else {
            r = iommu_flush_iotlb(2, 0, 0);
            iommu_n_dsi = iommu_n_dsi + 1;
        }
        if (r != 0) { iommu_n_inv_fail = iommu_n_inv_fail + 1; }
        return 0;
    }
    var w = iommu_flush_write_buffer();
    if (w > 0) { iommu_n_wbf = iommu_n_wbf + 1; }
    if (w < 0) { iommu_n_inv_fail = iommu_n_inv_fail + 1; }
    return 0;
}

# Grant a device DMA to the 2 MB region holding `phys` (identity). The one entry point every driver calls, at allocation.
# Before iommu_init: recorded for the replay. Translation on: mapped + invalidated now. Otherwise: nothing to do.
# Returns 0 always (the callers' contract since S10); a refusal is counted and said once. An address inside the unit's own
# chunk is refused whenever it comes (1.57.13; iommu_map_2mb refuses it too). After the lock is dropped, a queue that has
# STALLED or DIED since the last grant is said once each (1.57.13, the VTD review: the boot DMA check is one-shot, and this
# is the path that submits after it) — decided under the lock, said lock-free.
fn iommu_register_dma(phys) {
    var f = iommu_lock();
    var r = 0;
    if (iommu_is_own(phys) != 0) {
        r = 0 - 1;
    } else {
        if (iommu_init_ran == 0) {
            r = iommu_pend_add(phys);
        } else {
            if (iommu_active != 0) {
                r = iommu_map_2mb(phys);
                if (r == 1) {
                    iommu_n_late = iommu_n_late + 1;
                    iommu_after_new_leaf(phys);
                }
            }
        }
    }
    if (r < 0) { iommu_n_refused = iommu_n_refused + 1; }
    var tell = 0;
    if (iommu_qi_dead != 0) {
        if ((iommu_qi_told & 2) == 0) {
            iommu_qi_told = iommu_qi_told | 2;
            tell = 1;
        }
    } else {
        if (iommu_qi_stalled != 0) {
            if ((iommu_qi_told & 1) == 0) {
                iommu_qi_told = iommu_qi_told | 1;
                tell = 1;
            }
        }
    }
    iommu_unlock(f);
    if (tell != 0) { iommu_qi_tell(); }
    if (r < 0) {
        if (iommu_refused_said == 0) {
            iommu_refused_said = 1;
            # Once, and LOCK-FREE (klug + COM1 directly, the net_lk_latch shape): a grant can come from interrupt context,
            # where kprint's console lock may be held by the very code the interrupt stopped.
            klug_append("iommu: DMA grant REFUSED - a device DMA there will fault (refused= in the boot DMA check)", 89);
            klug_putc(10);
            serial_print("iommu: DMA grant REFUSED for phys ", 34);
            kfmt_hex0x(phys);
            serial_println(" - a device DMA there will fault", 32);
        }
    }
    return 0;
}

# Point every devfn of `bus` at the shared domain (Linux domain_context_mapping_one, one context per device; here all 256,
# so a DMA alias of any device on the bus — a PCIe-to-PCI bridge's secondary-bus requester id, a phantom function — hits
# the same grants). Only before TE (iommu_init): no context changes afterwards, so the CM context flush is never needed.
# 1 = installed, 0 = the bus already has one, -1 = no memory.
# ⛔ 1.56.52 made iommu_init REFUSE a machine with any device off bus 0, because only bus 0's root entry existed — and
# then every real box refused (NVMe behind a root port is the ordinary layout). Per-bus tables are that "right end
# state" it named; vtd-smoke puts the xHCI behind a pcie-root-port to exercise one.
fn iommu_bus_context(bus) {
    if (bus < 0) { return 0 - 1; }
    if (bus > 255) { return 0 - 1; }
    var re = iommu_root_kva + bus * 16;
    if ((load64(re) & 1) != 0) { return 0; }
    var cp = iommu_table_new();
    if (cp == 0) { return 0 - 1; }
    var cx_kva = dma_kva(cp);
    var lo = (iommu_top_phys & 0x000FFFFFFFFFF000) | 1;      # SLPTPTR | P; FPD = 0 (faults recorded); TT = 00 (translate)
    var hi = (iommu_levels - 2) | (IOMMU_DID << 8);          # AW: 1 = 39-bit 3-level, 2 = 48-bit 4-level, 3 = 57-bit 5-level
    for (var d = 0; d < 256; d = d + 1) {
        store64(cx_kva + d * 16 + 8, hi);
        store64(cx_kva + d * 16, lo);
    }
    iommu_flush_cache(cx_kva, 4096);
    store64(re + 8, 0);
    store64(re, (cp & 0x000FFFFFFFFFF000) | 1);              # CTP | P
    iommu_flush_cache(re, 16);
    iommu_ctx_buses = iommu_ctx_buses + 1;
    return 1;
}

# Drain the fault-recording registers (Linux dmar_fault, FreeBSD dmar_fault_intr): each record's F bit (127) is
# write-1-to-clear; FSTS.PFO (overflow — more faults than records) is too. `say` = print up to four records. Returns how
# many were pending (an overflow counts as one more). Reads only registers that no other path writes.
fn iommu_fault_scan(say) {
    if (iommu_base == 0) { return 0; }
    if (iommu_fro == 0) { return 0; }
    var n = 0;
    for (var i = 0; i < iommu_nfr; i = i + 1) {
        var fr = iommu_fro + i * 16;
        var hi = iommu_read32(fr + 12);
        if ((hi & 0x80000000) != 0) {
            n = n + 1;
            if (say != 0) {
                if (n <= 4) {
                    var sid = iommu_read32(fr + 8) & 0xFFFF;
                    kprint("iommu: FAULT dev ", 17);
                    kprint_byte((sid >> 8) & 0xFF);
                    kprint(":", 1);
                    kprint_byte((sid >> 3) & 0x1F);
                    kprint(".", 1);
                    kprint_num(sid & 7);
                    kprint(" addr 0x", 8);
                    kprint_hex(iommu_read64(fr) & 0xFFFFFFFFFFFFF000);
                    kprint(" reason 0x", 10);
                    kprint_byte(hi & 0xFF);
                    if (((hi >> 30) & 1) != 0) { kprintln(" (read)", 7); } else { kprintln(" (write)", 8); }
                }
            }
            iommu_write32(fr + 12, 0x80000000);
        }
    }
    var fsts = iommu_read32(0x34);
    if ((fsts & 1) != 0) {
        n = n + 1;
        if (say != 0) { kprintln("iommu: FAULT overflow (FSTS.PFO) - more faults than fault records", 65); }
    }
    iommu_write32(0x34, 0x03);                               # FSTS: W1C PFO (and PPF, as Linux writes it)
    return n;
}

# Close the pre-init log without enabling translation (no DMAR, or an init that refused): later grants are no-ops.
fn iommu_close_log() {
    var f = iommu_lock();
    iommu_init_ran = 1;
    iommu_unlock(f);
    return 0;
}

# Every refusal site prints its own reason first (a literal kprintln, so scripts/check/kprint-len-check.sh counts it).
fn iommu_fail() {
    iommu_close_log();
    return 0 - 1;
}

# Linux iommu_disable_protect_mem_regions, after TE: only where CAP.PLMR / CAP.PHMR exist and firmware left PMEN.EPM set
# (a TXT launch). Clear EPM, wait PRS clear. 1 disabled, 0 nothing to do, -1 timeout.
fn iommu_disable_pmr() {
    if (((iommu_cap >> 5) & 3) == 0) { return 0; }
    var pm = iommu_read32(0x64);
    if ((pm & 0x80000000) == 0) { return 0; }
    iommu_write32(0x64, pm & 0x7FFFFFFF);
    var t = 0;
    while (t < 1000000) {
        if ((iommu_read32(0x64) & 1) == 0) { return 1; }
        t = t + 1;
    }
    return 0 - 1;
}

# Bring the unit up with translation ON. Order (Linux init_dmars + iommu_set_root_entry + iommu_enable_translation; spec
# §6.6): quiesce what firmware left on, build the tables (default 16 MB, RMRRs, the per-bus contexts), point RTADDR at
# them, SRTP, global context-cache then global IOTLB invalidation, write-buffer flush, then — under iommu_lock, so no
# grant can slip between the two — replay the pre-init log and set TE. Every wait is checked; any failure leaves
# translation OFF (the state every boot before 1.57.10 was in) and says why. 0 = translation on, -1 = not.
fn iommu_init() {
    iommu_active = 0;
    if (acpi_iommu_base == 0) {
        iommu_close_log();
        return 0 - 1;
    }
    iommu_base = acpi_iommu_base;
    # The register block (0x230 bytes on QEMU, a page on iron) sits in the 2 MB chunk shared with the IOAPIC and HPET
    # (0xFEC00000-0xFEDFFFFF) under PDPT[3], which pt_init installs as a 1 GB PAGE. vmm_remap_uc_2mb is the path every
    # other MMIO driver maps through (xhci, nvme, ahci, amd_iommu_disable): it shatters PDPT[3] once (idempotently) and marks
    # the chunk UC; at boot, before any process exists, so every per-process PDPT copies the result.
    # ⛔ Until 1.57.10 iommu_map_mmio REFUSED exactly this PDPT[3] 1 GB page (1.56.52: "refuse rather than shatter" on a
    # path no test could reach) — which is why no boot ever got past this line.
    if (vmm_remap_uc_2mb(iommu_base) == 0) { kprintln("iommu: translation NOT enabled - could not map the register block UC", 68); return iommu_fail(); }
    iommu_ver = iommu_read32(0x00);
    if (iommu_ver == 0) { kprintln("iommu: translation NOT enabled - VER reads 0", 44); return iommu_fail(); }
    if (iommu_ver == 0xFFFFFFFF) { kprintln("iommu: translation NOT enabled - VER reads all-ones", 51); return iommu_fail(); }
    # ⭐ 1.57.13 (QI) — VER major >= 6 is no longer refused here: it is refused below only when the queue is NOT in use (the
    # register interface is an incorrect request at that version, spec §6.5.1). Until 1.57.13 every such unit was refused.
    iommu_cap = iommu_read64(0x08);
    iommu_ecap = iommu_read64(0x10);
    # 1.57.9 — ECAP.C BEFORE the first table write: it decides whether iommu_flush_cache must clflush.
    iommu_coherent = iommu_ecap & 1;
    iommu_cm = (iommu_cap >> 7) & 1;
    iommu_rwbf = (iommu_cap >> 4) & 1;
    iommu_sp2m = (iommu_cap >> 34) & 1;
    var sagaw = (iommu_cap >> 8) & 0x1F;
    iommu_levels = 0;
    if ((sagaw & 8) != 0) { iommu_levels = 5; }
    if ((sagaw & 2) != 0) { iommu_levels = 3; }
    if ((sagaw & 4) != 0) { iommu_levels = 4; }
    if (iommu_levels == 0) { kprintln("iommu: translation NOT enabled - SAGAW offers no 3/4/5-level table", 66); return iommu_fail(); }
    var aw = 12 + 9 * iommu_levels;
    var mgaw = ((iommu_cap >> 16) & 0x3F) + 1;
    if (mgaw < aw) { aw = mgaw; }
    if (aw > 57) { aw = 57; }
    iommu_iova_top = 1 << aw;
    iommu_iotlb_off = ((iommu_ecap >> 8) & 0x3FF) * 16;     # needed by the register interface only (refused below if 0)
    iommu_drain = 0;
    if (((iommu_cap >> 55) & 1) != 0) { iommu_drain = iommu_drain | (1 << 49); }
    if (((iommu_cap >> 54) & 1) != 0) { iommu_drain = iommu_drain | (1 << 48); }
    iommu_qi_drain = 0;                                      # the same two capabilities, in the IOTLB descriptor's bits
    if (((iommu_cap >> 55) & 1) != 0) { iommu_qi_drain = iommu_qi_drain | (1 << 7); }
    if (((iommu_cap >> 54) & 1) != 0) { iommu_qi_drain = iommu_qi_drain | (1 << 6); }
    iommu_fro = ((iommu_cap >> 24) & 0x3FF) * 16;
    iommu_nfr = ((iommu_cap >> 40) & 0xFF) + 1;

    # What firmware (or a previous kernel) left on. Linux turns a pre-enabled TE off outside kdump; a queue left on is turned
    # off too (Linux intel_iommu_init_qi -> dmar_disable_qi, "start from the sane iommu hardware state"): this kernel's queue
    # gets its own IQA below, which may only be programmed while QIE is clear — and the register fallback must not run with
    # QIE set (QEMU drops a register command then and leaves ICC / IVT set). Interrupt remapping, if on, is carried along
    # untouched by iommu_gcmd_status's persistent bits.
    var gs = iommu_read32(0x1C);
    if ((gs & (1 << 31)) != 0) {
        iommu_write32(0x18, iommu_gcmd_status() & 0x7FFFFFFF);          # TE off
        if (iommu_wait_gsts(1 << 31, 0) != 0) { kprintln("iommu: translation NOT enabled - firmware left TE on and it would not clear", 75); return iommu_fail(); }
    }
    if ((gs & (1 << 26)) != 0) {
        if (iommu_qi_disable() != 0) { kprintln("iommu: translation NOT enabled - firmware left QI on and it would not clear", 75); return iommu_fail(); }
    }

    # ⛔ 1.57.13 (the VTD review) — the own chunk, BEFORE the first of the unit's own structures is made (the queue below):
    # every one of them is carved from it, and no grant can open it (iommu_own).
    if (iommu_own_n == 0) {
        if (iommu_own_grow() == 0) { kprintln("iommu: translation NOT enabled - no free 2 MB region for the unit's own tables", 78); return iommu_fail(); }
    }

    # ⭐ 1.57.13 (QI) — pick the invalidation interface BEFORE the first invalidation (Linux init_dmars ->
    # intel_iommu_init_qi runs ahead of iommu_set_root_entry, so the root-entry flushes below already use the queue).
    iommu_qi = 0;
    if ((iommu_ecap & 2) != 0) {                             # ECAP.QI (bit 1)
        if (iommu_qi_forbid == 0) {
            if (iommu_qi_enable() < 0) { kprintln("iommu: translation NOT enabled - queued invalidation not latched (GSTS.QIES)", 76); return iommu_fail(); }
        } else {
            kprintln("iommu: queued invalidation OFF - forced by VTD_REGISTER_INV (test build): register interface", 92);
        }
    }
    if (iommu_qi == 0) {
        # The register interface — no ECAP.QI, no memory for the queue, or the test knob. Spec §6.5.1: at VER major >= 6 every
        # register invalidation is an incorrect request; and the IOTLB register must exist.
        if (((iommu_ver >> 4) & 0xF) >= 6) { kprintln("iommu: translation NOT enabled - VER >= 6.0 and queued invalidation is not in use", 81); return iommu_fail(); }
        if (iommu_iotlb_off == 0) { kprintln("iommu: translation NOT enabled - ECAP.IRO is 0 (no IOTLB register)", 66); return iommu_fail(); }
    }

    # 1.57.9 (CPUVA) — each table: pmm_alloc gives the PHYS (for the hardware), dma_kva the CPU's pointer (memset/store go
    # through it only), and iommu_table_new's dma_kva_ok refuses a KVA outside the direct map.
    iommu_root_phys = iommu_table_new();
    if (iommu_root_phys == 0) { kprintln("iommu: translation NOT enabled - no memory for the root table", 61); return iommu_fail(); }
    iommu_root_kva = dma_kva(iommu_root_phys);
    iommu_top_phys = iommu_table_new();
    if (iommu_top_phys == 0) { kprintln("iommu: translation NOT enabled - no memory for the top SL table", 63); return iommu_fail(); }
    iommu_top_kva = dma_kva(iommu_top_phys);

    # The default grant: the first 16 MB — the kernel image (< 4 MB) with its .bss DMA buffers (vblk_dma_buf, vnet_rx_buf,
    # AHCI's .bss callers), the boot stacks and the region-7 kstack pool; pmm pages that land there are covered too.
    for (var i = 0; i < 8; i = i + 1) {
        if (iommu_map_2mb(i * 0x200000) < 0) { kprintln("iommu: translation NOT enabled - no memory for the default 16 MB grant", 70); return iommu_fail(); }
    }
    # Firmware RMRRs (spec §8.4: memory a device may DMA to before and after the OS takes over — USB legacy emulation, an
    # integrated GPU's stolen memory, a BMC): identity-granted before TE, as Linux IOMMU_RESV_DIRECT and FreeBSD
    # domain_init_rmrr do. acpi_parse_dmar keeps segment-0 ranges of at most 1 GB. QEMU publishes none (static gate).
    for (var ri = 0; ri < acpi_dmar_rmrr_n; ri = ri + 1) {
        var ra = load64(&acpi_dmar_rmrr + ri * 16) & 0xFFFFFFFFFFE00000;
        var rl = load64(&acpi_dmar_rmrr + ri * 16 + 8);
        while (ra <= rl) {
            var rm = iommu_map_2mb(ra);
            if (rm < 0) { kprintln("iommu: translation NOT enabled - an RMRR could not be granted", 61); return iommu_fail(); }
            if (rm == 1) { iommu_n_rmrr = iommu_n_rmrr + 1; }
            ra = ra + 0x200000;
        }
    }
    # Context tables: every bus pci_scan found a function on (the 256-bus sweep, so bridges' secondary buses included).
    for (var k = 0; k < pci_count; k = k + 1) {
        var cbus = (load64(pci_busfunc + k * 8) >> 8) & 0xFF;
        if (iommu_bus_context(cbus) < 0) { kprintln("iommu: translation NOT enabled - no memory for a context table", 62); return iommu_fail(); }
    }
    iommu_flush_cache(iommu_root_kva, 4096);                 # every entry was flushed at its store; the page once more

    # Point the unit at the tables (legacy mode: RTADDR bits 11:10 = 00), latch with SRTP, then — spec §6.6, Linux
    # iommu_set_root_entry — a global context-cache and a global IOTLB invalidation (QEMU sets ESRTPS, which makes them
    # redundant there; iron without it needs them), and a write-buffer flush on RWBF hardware. 1.57.13: the two
    # invalidations go through the queue when it is on (iommu_flush_*), the register interface otherwise.
    iommu_write64(0x20, iommu_root_phys & 0x000FFFFFFFFFF000);
    iommu_write32(0x18, iommu_gcmd_status() | (1 << 30));   # GCMD.SRTP (one-shot)
    if (iommu_wait_gsts(1 << 30, 1) != 0) { kprintln("iommu: translation NOT enabled - root table pointer not latched (RTPS)", 70); return iommu_fail(); }
    # 1.57.13 (the VTD review): a flush whose wait STALLED is issued once more — that submission first settles the stall
    # (a second full bound), so a slow unit is refused only when a wait outlasts two bounds (the queue is then DEAD).
    var icx = iommu_flush_context_global();
    if (icx != 0) {
        if (iommu_qi_stalled != 0) { icx = iommu_flush_context_global(); }
    }
    if (icx != 0) {
        iommu_qi_tell();
        kprintln("iommu: translation NOT enabled - global context-cache invalidation failed", 73);
        return iommu_fail();
    }
    var itl = iommu_flush_iotlb(1, 0, 0);
    if (itl != 0) {
        if (iommu_qi_stalled != 0) { itl = iommu_flush_iotlb(1, 0, 0); }
    }
    if (itl != 0) {
        iommu_qi_tell();
        kprintln("iommu: translation NOT enabled - global IOTLB invalidation failed", 65);
        return iommu_fail();
    }
    if (iommu_flush_write_buffer() < 0) { kprintln("iommu: translation NOT enabled - write-buffer flush timed out", 61); return iommu_fail(); }
    iommu_fault_scan(0);                                      # stale records from before this kernel: drop them quietly

    # Replay + TE, atomically with respect to every other granter: a grant from an ISR (or, later, an AP) either lands in
    # the log before this reads it, or finds iommu_init_ran = 1 and takes the live path after TE. The replayed leaves need
    # no invalidation — translation is still off and the caches were just invalidated globally.
    var f = iommu_lock();
    var bad = 0;
    for (var p = 0; p < iommu_pend_n; p = p + 1) {
        if (iommu_map_2mb(load64(&iommu_pend + p * 8)) < 0) { bad = bad + 1; }
        iommu_n_replayed = iommu_n_replayed + 1;
    }
    iommu_init_ran = 1;
    var te = 0;
    if (bad == 0) {
        if (iommu_pend_lost == 0) {
            iommu_write32(0x18, iommu_gcmd_status() | (1 << 31));   # GCMD.TE
            if (iommu_wait_gsts(1 << 31, 1) == 0) {
                te = 1;
                iommu_active = 1;
            } else {
                iommu_write32(0x18, iommu_gcmd_status() & 0x7FFFFFFF);   # never leave a half-enabled unit behind
            }
        }
    }
    iommu_unlock(f);
    if (bad != 0) { kprintln("iommu: translation NOT enabled - a pre-init grant could not be replayed", 71); return iommu_fail(); }
    if (iommu_pend_lost != 0) { kprintln("iommu: translation NOT enabled - the pre-init grant log overflowed (grants lost)", 80); return iommu_fail(); }
    if (te == 0) { kprintln("iommu: translation NOT enabled - translation enable not latched (TES)", 69); return iommu_fail(); }
    iommu_disable_pmr();

    kprint("IOMMU: VT-d unit 0x", 19);
    kprint_hex(iommu_base);
    kprint(" ver ", 5);
    kprint_num((iommu_ver >> 4) & 0xF);
    kprint(".", 1);
    kprint_num(iommu_ver & 0xF);
    kprint(" levels=", 8);
    kprint_num(iommu_levels);
    kprint(" cm=", 4);
    kprint_num(iommu_cm);
    kprint(" rwbf=", 6);
    kprint_num(iommu_rwbf);
    kprint(" coherent=", 10);
    kprint_num(iommu_coherent);
    kprint(" sp2m=", 6);
    kprint_num(iommu_sp2m);
    kprint(" buses=", 7);
    kprint_num(iommu_ctx_buses);
    kprint(" rmrr=", 6);
    kprint_num(iommu_n_rmrr);
    kprint(" replayed=", 10);
    kprint_num(iommu_n_replayed);
    kprint(" iotlb=0x", 9);
    kprint_hex(iommu_iotlb_off + 8);
    if (iommu_qi != 0) { kprintln(" inv=queued", 11); } else { kprintln(" inv=register", 13); }
    if (iommu_qi != 0) {
        kprint("IOMMU: queued invalidation - queue 0x", 37);
        kprint_hex(iommu_qi_phys);
        kprint(" status 0x", 10);
        kprint_hex(iommu_qi_st_phys);
        kprint(" submitted=", 11);
        kprint_num(iommu_n_qi);
        kprintln("", 0);
    }
    kprint("IOMMU: own structures - chunk 0x", 32);
    kprint_hex(load64(&iommu_own));
    kprint(" chunks=", 8);
    kprint_num(iommu_own_n);
    kprint(" pages=", 7);
    kprint_num(iommu_own_pages);
    kprintln(" - never granted", 16);
    return 0;
}

# The late check (main.cyr, after every boot-time DMA user — xHCI/HID/MSC, NVMe, virtio, AHCI, HDA, the mounts, DHCP): any
# DMA a grant missed has been recorded in the unit's fault registers by now. One line, faults first; silent when VT-d is
# off. Returns the faults drained.
fn iommu_boot_report() {
    if (iommu_active == 0) { return 0; }
    var nf = iommu_fault_scan(1);
    iommu_n_faults = iommu_n_faults + nf;
    kprint("IOMMU: boot DMA check - faults=", 31);
    kprint_num(iommu_n_faults);
    kprint(" leaves=", 8);
    kprint_num(iommu_n_leaf);
    kprint(" late=", 6);
    kprint_num(iommu_n_late);
    kprint(" psi=", 5);
    kprint_num(iommu_n_psi);
    kprint(" dsi=", 5);
    kprint_num(iommu_n_dsi);
    kprint(" wbf=", 5);
    kprint_num(iommu_n_wbf);
    kprint(" inv_fail=", 10);
    kprint_num(iommu_n_inv_fail);
    kprint(" refused=", 9);
    kprint_num(iommu_n_refused);
    kprint(" qi=", 4);                                       # 1.57.13: queue submissions completed, and FSTS's queue errors
    kprint_num(iommu_n_qi);
    kprint(" iqe=", 5);
    kprint_num(iommu_n_iqe);
    kprint(" ite=", 5);
    kprint_num(iommu_n_ite);
    kprint(" ice=", 5);
    kprint_num(iommu_n_ice);
    kprint(" stall=", 7);                                    # 1.57.13 (the VTD review): waits that outlasted a bound
    kprint_num(iommu_n_stall);
    kprintln("", 0);
    if (iommu_qi_dead != 0 || iommu_qi_stalled != 0) { iommu_qi_tell(); }
    return nf;
}


#ifdef VTD_SELFTEST
# ⭐ 1.57.10 (VTD) — TEST-ONLY: does translation ENFORCE, and does a grant made AFTER TE work? (scripts/smoke/vtd-smoke.sh)
# A QEMU boot never makes a post-TE grant that needs a NEW leaf on its own (measured, 1.57.10: late=0) — pmm_alloc hands
# pages out top-down, so every driver after iommu_init lands in the 2 MB region the replayed xHCI grants already opened,
# and the boot's one pmm_alloc_2mb user (HDA's PCM ring) gets a low region inside the default 16 MB — so without this the
# runtime path (iommu_after_new_leaf, the CM invalidation) would never run in a gate. (A long-running box does reach it.)
# On an NVMe controller (BSP, late in boot, after every boot DMA user and before iommu_boot_report):
#   A. BLOCKED — a fresh 2 MB region nothing has granted, filled 0xA5; IDENTIFY CONTROLLER is told to DMA its 4 KB there.
#      The command must FAIL, the page must still be all 0xA5, and the unit must have RECORDED the fault: source = the
#      NVMe's bus:dev.fn, address = the page, a write. That is the proof the domain is really enforced (not a pass-through).
#   B. GRANT after TE — iommu_register_dma(region): exactly ONE new leaf (late +1), and exactly the invalidation the unit
#      needs (CM=1: one PSI — or DSI without PSI; CM=0: none, a write-buffer flush only on RWBF hardware).
#   C. ALLOWED — the same IDENTIFY into the now-granted page must succeed and equal, byte for byte, the IDENTIFY data read
#      into the always-granted page the driver uses (nvme_ident_phys). No fault may be recorded.
#   D. (1.57.13, the queue only) QI RECOVERY — vtdst_qi_recovery below.
#   E. (1.57.13, the VTD review) OWN STRUCTURES — vtdst_own below: no device can reach the unit's own memory.
#   F. (1.57.13, the VTD review, the queue only) QI STALL — vtdst_qi_stall below: a slow wait stalls the queue, never kills it.
# ⚠ QEMU never caches a failed translation, so C passes on QEMU even with the CM invalidation deleted: B's count, and the
# smoke's check of QEMU's own trace (the IVA / IOTLB registers, or the queue's IOTLB descriptors), catch that mutant.
fn vtdst_granted(pa) { return iommu_granted(pa); }

# D. QI RECOVERY (1.57.13; only when the queue is in use). A malformed descriptor — type 0, which no VT-d revision defines —
# must raise IQE and take Linux's qi_check_fault recovery: that submission reports NOT performed, exactly one IQE is
# counted, the queue is NOT declared dead, and it keeps working — a bare wait submitted behind it completes, IQH == IQT
# (drained) and FSTS's IQE / ICE / ITE are clear. On QEMU the malformed descriptor is one "invalid inv desc: hi=0, lo=0
# (unknown type)" error on stderr, which the harness requires. Returns 0 pass, 1 fail.
fn vtdst_qi_recovery() {
    if (iommu_qi == 0) {
        kprintln("vtdst: qi recovery SKIP the register interface is in use", 56);
        return 0;
    }
    var e0 = iommu_n_iqe;
    var q0 = iommu_n_qi;
    var qf = iommu_lock();
    var r1 = iommu_qi_submit(0, 0, 1);
    var r2 = iommu_qi_submit(0, 0, 0);
    var qh = iommu_read32(0x80);
    var qt = iommu_read32(0x88);
    var qfs = iommu_read32(0x34);
    iommu_unlock(qf);
    var np = 0;
    if (r1 < 0) { np = 1; }
    var wok = 0;
    if (r2 == 0) { wok = 1; }
    kprint("vtdst: qi recovery not_performed=", 33);
    kprint_num(np);
    kprint(" iqe=+", 6);
    kprint_num(iommu_n_iqe - e0);
    kprint(" wait_ok=", 9);
    kprint_num(wok);
    kprint(" qi=+", 5);
    kprint_num(iommu_n_qi - q0);
    kprint(" iqh=0x", 7);
    kprint_hex(qh);
    kprint(" iqt=0x", 7);
    kprint_hex(qt);
    kprint(" fsts=0x", 8);
    kprint_hex(qfs);
    kprint(" dead=", 6);
    kprint_num(iommu_qi_dead);
    kprintln("", 0);
    var ok = 0;
    if (np == 1) {
        if (iommu_n_iqe - e0 == 1) {
            if (wok == 1) {
                if (iommu_n_qi - q0 == 1) {
                    if (qh == qt) {
                        if ((qfs & 0x70) == 0) {
                            if (iommu_qi_dead == 0) { ok = 1; }
                        }
                    }
                }
            }
        }
    }
    if (ok == 1) { kprintln("vtdst: qi recovery PASS", 23); return 0; }
    kprintln("vtdst: qi recovery FAIL", 23);
    return 1;
}

# E. OWN STRUCTURES (1.57.13, the VTD review). Every structure the unit reads or writes untranslated — the root table, each
# bus's context table, every SL table reached from the top (a 4 KB-leaf table included), the queue and status pages — must
# lie in an own chunk; every context entry must point at the one top table; and no grant may open a chunk: each is not
# granted, iommu_map_2mb REFUSES it (no leaf written) and iommu_register_dma REFUSES it — refused +1, the one deliberate
# refusal of a VTD_SELFTEST boot (as arm A makes the one deliberate fault; the harness requires exactly that one, at an own
# address). RED on the pre-review kernel, whose tables were pmm_alloc pages inside the replayed xHCI grant. 0 pass, 1 fail.
var vtdst_wk[8];           # the SL walk's stack: per level, the table being walked (its dma_kva) ...
var vtdst_wi[8];           #   ... and the next index in it
var vtdst_own_tables = 0;  # SL tables found below the top

# Walk every SL table below the top, without recursion. Returns how many lie OUTSIDE the own chunks.
fn vtdst_sl_walk() {
    var bad = 0;
    var top = iommu_levels;
    var lvl = top;
    store64(&vtdst_wk + lvl * 8, iommu_top_kva);
    store64(&vtdst_wi + lvl * 8, 0);
    while (lvl <= top) {
        var i = load64(&vtdst_wi + lvl * 8);
        if (i >= 512) {
            lvl = lvl + 1;
        } else {
            store64(&vtdst_wi + lvl * 8, i + 1);
            var e = load64(load64(&vtdst_wk + lvl * 8) + i * 8);
            if ((e & 3) != 0) {
                var sub = 1;
                if (lvl == 2) {
                    if ((e & 0x80) != 0) { sub = 0; }        # a 2 MB leaf, not a table
                }
                if (sub != 0) {
                    var tp = e & 0x000FFFFFFFFFF000;
                    vtdst_own_tables = vtdst_own_tables + 1;
                    if (iommu_is_own(tp) == 0) { bad = bad + 1; }
                    if (lvl > 2) {
                        lvl = lvl - 1;
                        store64(&vtdst_wk + lvl * 8, dma_kva(tp));
                        store64(&vtdst_wi + lvl * 8, 0);
                    }
                }
            }
        }
    }
    return bad;
}

fn vtdst_own() {
    var outside = 0;
    if (iommu_is_own(iommu_root_phys) == 0) { outside = outside + 1; }
    if (iommu_is_own(iommu_top_phys) == 0) { outside = outside + 1; }
    if (iommu_qi != 0) {
        if (iommu_is_own(iommu_qi_phys) == 0) { outside = outside + 1; }
        if (iommu_is_own(iommu_qi_st_phys) == 0) { outside = outside + 1; }
    }
    var nctx = 0;
    var badptr = 0;
    for (var b = 0; b < 256; b = b + 1) {
        var rte = load64(iommu_root_kva + b * 16);
        if ((rte & 1) != 0) {
            nctx = nctx + 1;
            var ctp = rte & 0x000FFFFFFFFFF000;
            if (iommu_is_own(ctp) == 0) { outside = outside + 1; }
            var cx = dma_kva(ctp);
            for (var d = 0; d < 256; d = d + 1) {
                var ce = load64(cx + d * 16);
                if ((ce & 1) != 0) {
                    if ((ce & 0x000FFFFFFFFFF000) != iommu_top_phys) { badptr = badptr + 1; }
                }
            }
        }
    }
    vtdst_own_tables = 0;
    outside = outside + vtdst_sl_walk();
    var c0 = load64(&iommu_own);
    var granted = 0;
    var mapped = 0;
    var of = iommu_lock();
    for (var k = 0; k < iommu_own_n; k = k + 1) {
        var ck = load64(&iommu_own + k * 8);
        if (iommu_granted(ck) != 0) { granted = granted + 1; }
        if (iommu_map_2mb(ck + 0x1000) >= 0) { mapped = mapped + 1; }   # must be REFUSED (-1): never a leaf, never "already"
        if (iommu_granted(ck) != 0) { granted = granted + 1; }
    }
    iommu_unlock(of);
    var rf0 = iommu_n_refused;
    iommu_register_dma(c0 + 0x1000);                         # the driver entry point: the one deliberate refusal
    var rfd = iommu_n_refused - rf0;
    if (iommu_granted(c0) != 0) { granted = granted + 1; }
    kprint("vtdst: own structures chunk=0x", 30);
    kprint_hex(c0);
    kprint(" chunks=", 8);
    kprint_num(iommu_own_n);
    kprint(" pages=", 7);
    kprint_num(iommu_own_pages);
    kprint(" ctx=", 5);
    kprint_num(nctx);
    kprint(" sl_tables=", 11);
    kprint_num(vtdst_own_tables);
    kprint(" outside=", 9);
    kprint_num(outside);
    kprint(" badptr=", 8);
    kprint_num(badptr);
    kprint(" granted=", 9);
    kprint_num(granted);
    kprint(" mapped=", 8);
    kprint_num(mapped);
    kprint(" refused=+", 10);
    kprint_num(rfd);
    kprintln("", 0);
    var ok = 0;
    if (iommu_own_n >= 1) {
        if (outside == 0) {
            if (badptr == 0) {
                if (nctx == iommu_ctx_buses) {
                    if (granted == 0) {
                        if (mapped == 0) {
                            if (rfd == 1) { ok = 1; }
                        }
                    }
                }
            }
        }
    }
    if (ok == 1) { kprintln("vtdst: own structures PASS", 26); return 0; }
    kprintln("vtdst: own structures FAIL", 26);
    return 1;
}

# F. QI STALL (1.57.13, the VTD review; the queue only). A wait the unit is never handed (iommu_qi_hold: IQT not written)
# must outlast a short bound and leave the queue STALLED — that submission NOT performed, the queue NOT dead. Then the unit
# is handed it late (the IQT write a slow unit would have acted on long ago): the next submission must settle the stall
# (the late status write seen, IQH == IQT), complete its own wait, and leave the queue drained, FSTS clear, not dead.
# RED on the pre-review kernel, which declared the queue DEAD at the first timeout and never looked again. Last, one grant
# of an already-granted page: when the queue is healthy the grant path says nothing (with the late hand-over deleted, the
# second bound runs out and THIS grant says `DEAD` lock-free, before the boot DMA check). 0 pass, 1 fail.
fn vtdst_qi_stall(sreg) {
    if (iommu_qi == 0) {
        kprintln("vtdst: qi stall SKIP the register interface is in use", 53);
        return 0;
    }
    var q0 = iommu_n_qi;
    var s0 = iommu_n_stall;
    var b0 = iommu_qi_bound;
    var sf = iommu_lock();
    iommu_qi_hold = 1;                                        # the unit is not handed this wait: it cannot complete
    iommu_qi_bound = 4096;                                    # (a short bound: this one is meant to run out)
    var r1 = iommu_qi_submit(0, 0, 0);
    iommu_qi_bound = b0;
    iommu_qi_hold = 0;
    var st1 = iommu_qi_stalled;
    var dd1 = iommu_qi_dead;
    iommu_write32(0x88, iommu_qi_tail << 4);                  # ... and is handed it late: a slow unit, still working
    var r2 = iommu_qi_submit(0, 0, 0);                        # settles the stall first, then its own wait
    var st2 = iommu_qi_stalled;
    var qh = iommu_read32(0x80);
    var qt = iommu_read32(0x88);
    var qfs = iommu_read32(0x34);
    iommu_unlock(sf);
    iommu_register_dma(sreg);
    var np = 0;
    if (r1 < 0) { np = 1; }
    var lok = 0;
    if (r2 == 0) { lok = 1; }
    kprint("vtdst: qi stall not_performed=", 30);
    kprint_num(np);
    kprint(" stalled=", 9);
    kprint_num(st1);
    kprint(" dead=", 6);
    kprint_num(dd1);
    kprint(" then late_ok=", 14);
    kprint_num(lok);
    kprint(" stalled=", 9);
    kprint_num(st2);
    kprint(" stall=+", 8);
    kprint_num(iommu_n_stall - s0);
    kprint(" qi=+", 5);
    kprint_num(iommu_n_qi - q0);
    kprint(" iqh=0x", 7);
    kprint_hex(qh);
    kprint(" iqt=0x", 7);
    kprint_hex(qt);
    kprint(" fsts=0x", 8);
    kprint_hex(qfs);
    kprint(" dead=", 6);
    kprint_num(iommu_qi_dead);
    kprintln("", 0);
    var ok = 0;
    if (np == 1) {
        if (st1 == 1) {
            if (dd1 == 0) {
                if (lok == 1) {
                    if (st2 == 0) {
                        if (iommu_n_stall - s0 == 1) {
                            if (iommu_n_qi - q0 == 1) {
                                if (qh == qt) {
                                    if ((qfs & 0x70) == 0) {
                                        if (iommu_qi_dead == 0) { ok = 1; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if (ok == 1) { kprintln("vtdst: qi stall PASS", 20); return 0; }
    kprintln("vtdst: qi stall FAIL", 20);
    return 1;
}

fn vtd_selftest() {
    kprintln("vtdst: start", 12);
    if (iommu_active == 0) {
        kprintln("vtdst: SKIP translation is off", 30);
        kprintln("vtdst: done", 11);
        return 0;
    }
    if (nvme_admin_ready == 0) {
        kprintln("vtdst: SKIP no NVMe admin queue", 31);
        kprintln("vtdst: done", 11);
        return 0;
    }
    var reg = pmm_alloc_2mb_run(1);
    if (reg == 0) {
        kprintln("vtdst: SKIP no free 2 MB region", 31);
        kprintln("vtdst: done", 11);
        return 0;
    }
    var bad = 0;
    if (vtdst_granted(reg) != 0) {
        kprintln("vtdst: FAIL the test region is already granted - the blocked arm would prove nothing", 84);
        bad = bad + 1;
    }
    var sbf = load64(pci_busfunc + nvme_pci_idx * 8);
    var nsid = (((sbf >> 8) & 0xFF) << 8) | (PciDev_slot(pci_devs + nvme_pci_idx * 32) << 3) | (sbf & 7);
    var rg_kva = dma_kva(reg);
    memset(rg_kva, 0xA5, 4096);
    iommu_fault_scan(0);                                      # start from an empty fault log

    # A. blocked
    var s1 = nvme_admin_poll(nvme_admin_submit(0x06, 0, reg, 0x01, 0));
    var dirty = 0;
    for (var i = 0; i < 4096; i = i + 1) {
        if (load8(rg_kva + i) != 0xA5) { dirty = dirty + 1; }
    }
    var fsid = 0 - 1;
    var faddr = 0;
    var fwhy = 0;
    var fread = 0;
    for (var fi = 0; fi < iommu_nfr; fi = fi + 1) {
        var fhi = iommu_read32(iommu_fro + fi * 16 + 12);
        if ((fhi & 0x80000000) != 0) {
            if (fsid < 0) {
                fsid = iommu_read32(iommu_fro + fi * 16 + 8) & 0xFFFF;
                faddr = iommu_read64(iommu_fro + fi * 16) & 0xFFFFFFFFFFFFF000;
                fwhy = fhi & 0xFF;
                fread = (fhi >> 30) & 1;
            }
        }
    }
    var nf1 = iommu_fault_scan(0);
    kprint("vtdst: blocked status=0x", 24);
    kprint_hex(s1);
    kprint(" dirty=", 7);
    kprint_num(dirty);
    kprint(" faults=", 8);
    kprint_num(nf1);
    kprint(" sid=0x", 7);
    kprint_hex(fsid);
    kprint(" nvme=0x", 8);
    kprint_hex(nsid);
    kprint(" addr=0x", 8);
    kprint_hex(faddr);
    kprint(" reason=0x", 10);
    kprint_hex(fwhy);
    kprint(" read=", 6);
    kprint_num(fread);
    kprintln("", 0);
    # ⚠ The command's STATUS is reported, not required: QEMU's NVMe completes an IDENTIFY whose data write the IOMMU
    # rejected with status 0 (measured, 1.57.10). The proof of enforcement is the page (untouched) and the unit's own
    # fault record (this device, this page, a write).
    var aok = 0;
    if (dirty == 0) {
        if (nf1 >= 1) {
            if (fsid == nsid) {
                if (faddr == reg) {
                    if (fread == 0) { aok = 1; }
                }
            }
        }
    }
    if (aok == 1) { kprintln("vtdst: blocked PASS", 19); } else { kprintln("vtdst: blocked FAIL", 19); bad = bad + 1; }

    # B. grant after TE
    var l0 = iommu_n_late;
    var p0 = iommu_n_psi;
    var d0 = iommu_n_dsi;
    var w0 = iommu_n_wbf;
    iommu_register_dma(reg);
    var dl = iommu_n_late - l0;
    var dp = iommu_n_psi - p0;
    var dd = iommu_n_dsi - d0;
    var dw = iommu_n_wbf - w0;
    kprint("vtdst: grant after TE new_leaf=", 31);
    kprint_num(dl);
    kprint(" psi=+", 6);
    kprint_num(dp);
    kprint(" dsi=+", 6);
    kprint_num(dd);
    kprint(" wbf=+", 6);
    kprint_num(dw);
    kprint(" cm=", 4);
    kprint_num(iommu_cm);
    kprint(" rwbf=", 6);
    kprint_num(iommu_rwbf);
    kprintln("", 0);
    var bok = 0;
    if (dl == 1) {
        if (vtdst_granted(reg) == 1) {
            if (iommu_cm != 0) {
                if (dp + dd == 1) { bok = 1; }
            } else {
                if (dp + dd == 0) {
                    if (dw == iommu_rwbf) { bok = 1; }
                }
            }
        }
    }
    if (bok == 1) { kprintln("vtdst: grant PASS", 17); } else { kprintln("vtdst: grant FAIL", 17); bad = bad + 1; }

    # C. allowed, byte-exact against the driver's own (always-granted) IDENTIFY page
    var s2 = nvme_admin_poll(nvme_admin_submit(0x06, 0, nvme_ident_phys, 0x01, 0));
    var s3 = nvme_admin_poll(nvme_admin_submit(0x06, 0, reg, 0x01, 0));
    var diff = 0;
    for (var j = 0; j < 512; j = j + 1) {
        if (load64(rg_kva + j * 8) != load64(nvme_ident_kva + j * 8)) { diff = diff + 1; }
    }
    var nf2 = iommu_fault_scan(1);
    kprint("vtdst: allowed status=0x", 24);
    kprint_hex(s3);
    kprint(" ref_status=0x", 14);
    kprint_hex(s2);
    kprint(" diff_qwords=", 13);
    kprint_num(diff);
    kprint(" vid=0x", 7);
    kprint_hex(load16(rg_kva));
    kprint(" faults=", 8);
    kprint_num(nf2);
    kprintln("", 0);
    var cok = 0;
    if (s2 == 0) {
        if (s3 == 0) {
            if (diff == 0) {
                if (nf2 == 0) {
                    if (load16(rg_kva) == nvme_ctrl_vid) { cok = 1; }
                }
            }
        }
    }
    if (cok == 1) { kprintln("vtdst: allowed PASS", 19); } else { kprintln("vtdst: allowed FAIL", 19); bad = bad + 1; }

    # D. queued-invalidation recovery (1.57.13)
    bad = bad + vtdst_qi_recovery();
    # E. the unit's own structures, out of every device's reach (1.57.13, the VTD review)
    bad = bad + vtdst_own();
    # F. a slow wait stalls the queue and settles; it does not kill it (1.57.13, the VTD review)
    bad = bad + vtdst_qi_stall(reg);
    if (bad == 0) { kprintln("vtdst: PASS", 11); } else { kprintln("vtdst: FAIL", 11); }
    kprintln("vtdst: done", 11);
    return bad;
}
#endif

# === AMD-Vi IOMMU Disable — Repair (GG), 2026-05-17 ===
#
# Everything above this line is Intel VT-d. Archaemenid is AMD Renoir
# 1022:1639 — uses AMD-Vi (a different IOMMU). The VT-d path no-ops on
# AMD because ACPI DMAR is Intel-specific; AMD publishes IVRS instead.
# But AMD-Vi is enabled by firmware on consumer Zen platforms; without
# OS-side DTE setup, every device DMA gets translated against an
# undefined Device Table Entry and silently blocked.
#
# Symptom (Attempts 56+57): `events_seen=0` over the full timeout window
# regardless of IMAN.IE state. xHCI CPU-side MMIO works (port reset
# succeeds — PORTSC is CPU→device); xHCI device-side DMA does not
# (cmd-ring TRB read + event-ring TRB write both blocked).
#
# MVP fix: disable AMD-Vi globally. Proper passthrough/DTE setup is
# v6.x territory. This function:
#   1. Walks PCI 0:0.2 capability list for cap ID 0x0F (Secure Device).
#   2. Confirms cap type bits [18:16] == 0x3 (IOMMU).
#   3. Extracts MMIO base from cap+4 (low) and cap+8 (high), masking off
#      the Enable bit + reserved bits per AMD I/O Virt §3.1.1.
#   4. Maps the 2 MB region containing the MMIO as UC.
#   5. Writes IOMMU Control Register (MMIO+0x18) = 0 to disable
#      translation, command buffer, event log — effectively passthrough.
#
# Call from main.cyr BEFORE xhci_probe.

fn amd_iommu_find_cap(bus, slot, func) {
    var sts_cmd = pci_read32(bus, slot, func, 4);
    if (((sts_cmd >> 16) & 0x10) == 0) { return 0; }
    var cap_ptr_dw = pci_read32(bus, slot, func, 0x34);
    var off = cap_ptr_dw & 0xFC;
    var safety = 0;
    while (off != 0) {
        if (safety > 48) { return 0; }
        safety = safety + 1;
        var hdr = pci_read32(bus, slot, func, off);
        if ((hdr & 0xFF) == 0x0F) {
            if (((hdr >> 16) & 0x7) == 0x3) { return off; }
        }
        off = (hdr >> 8) & 0xFC;
    }
    return 0;
}

fn amd_iommu_disable() {
    var bus  = 0;
    var slot = 0;
    var func = 2;
    var cap  = amd_iommu_find_cap(bus, slot, func);
    if (cap == 0) {
        kprintln("amdvi: cap 0x0F absent at 0:0.2 (not AMD-Vi)", 44);
        return 0;
    }
    var base_lo = pci_read32(bus, slot, func, cap + 4);
    var base_hi = pci_read32(bus, slot, func, cap + 8);
    var enable  = base_lo & 0x1;
    var mmio_lo = base_lo & 0xFFFFC000;
    var mmio    = mmio_lo | (base_hi << 32);

    kprint("amdvi: cap@", 11);
    kprint_num(cap);
    kprint(" mmio=", 6);
    kprint_num(mmio);
    kprint(" en=", 4);
    kprint_num(enable);
    kprintln("", 0);

    if (enable == 0) {
        kprintln("amdvi: already off; DMA not gated by IOMMU", 42);
        return 0;
    }
    if (mmio == 0) {
        kprintln("amdvi: mmio base zero, cannot disable", 37);
        return 0;
    }
    if (mmio >= 0x100000000) {
        kprintln("amdvi: mmio above 4 GB (rare), skipping", 39);
        return 0;
    }

    if (vmm_is_mapped(mmio) == 0) { vmm_map(mmio, mmio, 0x83); }
    vmm_remap_uc_2mb(mmio);

    # IOMMU Control Register at MMIO+0x18 (64-bit). Bit 0 = IommuEn;
    # writing 0 disables translation, cmd buffer, event log, everything.
    store64(mmio + 0x18, 0);
    var ctrl_rb = load64(mmio + 0x18);
    kprint("amdvi: disabled, ctrl_rb=", 25);
    kprint_num(ctrl_rb);
    kprintln("", 0);

    return 1;
}
