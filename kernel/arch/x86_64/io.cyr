# === Port I/O helpers ===
fn outb(port, val) {
    # port=-0x08 val=-0x10
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x8B; 0x45; 0xF0;
        0xEE;
    }
    return 0;
}

fn outw(port, val) {
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x8B; 0x45; 0xF0;
        0x66; 0xEF;
    }
    return 0;
}

fn outl(port, val) {
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x8B; 0x45; 0xF0;
        0xEF;
    }
    return 0;
}

fn inb(port) {
    # port=-0x08 result=-0x10
    var result = 0;
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x31; 0xC0;
        0xEC;
        0x48; 0x89; 0x45; 0xF0;
    }
    return result;
}

fn inw(port) {
    var result = 0;
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x31; 0xC0;
        0x66; 0xED;
        0x48; 0x89; 0x45; 0xF0;
    }
    return result;
}

fn inl(port) {
    var result = 0;
    asm {
        0x48; 0x8B; 0x55; 0xF8;
        0x48; 0x31; 0xC0;
        0xED;
        0x48; 0x89; 0x45; 0xF0;
    }
    return result;
}

fn rdtsc() {
    var result = 0;
    asm {
        0x0F; 0x31;
        0x48; 0xC1; 0xE2; 0x20;
        0x48; 0x09; 0xD0;
        0x48; 0x89; 0x45; 0xF8;
    }
    return result;
}

# Microseconds since the first statement of the boot body — the kernel log timebase (1.56.58).
#
# ⛔ THIS IS A FUNCTION, NOT AN INLINE READ IN kprint.cyr, BECAUSE kprint.cyr IS UNCONDITIONAL.
# core/kprint.cyr is included at agnos.cyr:57, OUTSIDE both #ifdef ARCH_X86_64 blocks (10-27 and
# 76-131), so it compiles on aarch64 too — while klog_tsc_boot / klog_tsc_per_us and rdtsc are
# x86-only. Referencing them from kprint.cyr directly is exactly the cross-arch leak class already
# filed at docs/development/issues/archived/2026-08-28-p1-audit-sweep-backlog.md. The seam is the one
# proc.cyr already uses for its x86 page-walk helpers: a real definition here, a no-op twin in
# arch/aarch64/stubs.cyr.
#
# Returns 0 — not a negative sentinel — before calibration lands, so early lines render
# [    0.000000]. That is deliberately what Linux prints for its own pre-timekeeping lines, and a
# log prefix has nowhere to put an error code.
fn klog_uptime_us() {
    if (klog_tsc_per_us == 0) { return 0; }
    if (klog_tsc_boot == 0)   { return 0; }
    var kd = rdtsc() - klog_tsc_boot;
    if (kd < 0) { return 0; }               # TSC went backwards — clamp, never wrap into a huge number
    return kd / klog_tsc_per_us;
}

# Read 64-bit value of an x86 MSR. ecx = msr number; rdmsr returns
# edx:eax (high32:low32); combine into rax. Used by Repair (V) to
# stamp MTRR_DEF_TYPE (0x2FF) + PAT (0x277) for the MMIO cache-attribute
# post-mortem. msr=-0x08, result=-0x10.
fn rdmsr(msr) {
    var result = 0;
    asm {
        0x48; 0x8B; 0x4D; 0xF8;       # mov  rcx, [rbp-0x08]   ; ecx = msr#
        0x0F; 0x32;                    # rdmsr                  ; edx:eax = MSR
        0x48; 0xC1; 0xE2; 0x20;        # shl  rdx, 32
        0x48; 0x09; 0xD0;              # or   rax, rdx          ; rax = combined u64
        0x48; 0x89; 0x45; 0xF0;        # mov  [rbp-0x10], rax   ; result = rax
    }
    return result;
}

# ⭐ 1.57.12 B11 — INTERRUPT WINDOWS for ONE CPU's long kernel path that holds only plain spinlocks (today: the ZFS commit,
# core/zfs_write.cyr zfs_commit — design 2026-10-09-zfs-write.md § b.3 "Hold time", k.126 (B11)). The path opts in
# (kirqw_begin, on its own CPU only) and calls kirqw_point where it holds no lock an interrupt handler could want — the
# commit between its device writes, the NVMe / AHCI completion polls it waits in (nvme_io_poll_n, ahci_poll_slot0: they
# are POLLED, no ISR takes nvme_lock / ahci_lock). A point at least KIRQW_GAP µs after the last one opens a window when the
# path asked for live ones — `pushfq; clac; sti; nop; cli; popfq`: one pending interrupt (and any that follows at the
# iretq) is taken with AC clear (the ISR never runs with SMAP lifted — idt.cyr's exception stub clacs for the same
# reason), and the caller's IF and AC come back exactly (a syscall's IF=0, kybernet's IF=1). The path holds
# preempt_count > 0 (a plain spinlock, smp.cyr), so the timer ISR never switches it out. Every point also MEASURES: the
# longest stretch between two points (kirqw_max) is the interrupt latency the path imposes with windows open — the
# whole path without them. kirqw_cpu 0 = nobody opted in: a point is one load and a return.
var KIRQW_GAP  = 20;         # µs between windows (a completion poll spins far faster than interrupts arrive)
var kirqw_cpu  = 0;          # pcpu_cpu() + 1 of the CPU whose path opted in, 0 = none
var kirqw_live = 0;          # 1 = the points OPEN interrupts; 0 = they only measure
var kirqw_last = 0;          # klog_uptime_us of the last point (or the path's start)
var kirqw_max  = 0;          # the longest stretch between two points (or the start / end), µs
var kirqw_n    = 0;          # windows opened
fn kirqw_begin(live) {
    # never inside an interrupt handler (apic_in_service: the timer ISR's death chain reaches a process's fd-table
    # teardown, which may commit): an `sti` there would nest interrupts on the handler before its EOI — measure only
    if (live == 1 && apic_in_service() == 1) { live = 0; }
    kirqw_live = live;
    kirqw_last = klog_uptime_us();
    kirqw_max = 0;
    kirqw_n = 0;
    kirqw_cpu = pcpu_cpu() + 1;
    return 0;
}
fn kirqw_point() {
    if (kirqw_cpu == 0) { return 0; }
    if (kirqw_cpu != pcpu_cpu() + 1) { return 0; }
    var now = klog_uptime_us();
    var d = now - kirqw_last;
    if (d < KIRQW_GAP) { return 0; }
    if (d > kirqw_max) { kirqw_max = d; }
    kirqw_last = now;
    if (kirqw_live == 1) {
        # REGISTER CONTRACT: no GPR read or written. pushfq saves RFLAGS on the stack; clac clears AC; sti sets IF (its
        # one-instruction shadow covers the nop, so a pending interrupt is delivered after it); cli clears IF; popfq
        # restores the saved RFLAGS — IF and AC exactly as the caller had them. RSP is back where it was.
        asm {
            0x9C;                     # pushfq
            0x0F; 0x01; 0xCA;         # clac
            0xFB;                     # sti
            0x90;                     # nop  (the interrupt shadow ends here: a pending interrupt is taken)
            0xFA;                     # cli
            0x9D;                     # popfq
        }
        kirqw_n = kirqw_n + 1;
    }
    return 0;
}
# The path's end: the last stretch measured, the opt-in withdrawn. 0.
fn kirqw_end() {
    if (kirqw_cpu == 0) { return 0; }
    var d = klog_uptime_us() - kirqw_last;
    if (d > kirqw_max) { kirqw_max = d; }
    kirqw_cpu = 0;
    return 0;
}

# Hardware random 64-bit via RDRAND. Returns 0 on failure (Intel SDM
# specifies destination is zeroed on RDRAND failure); callers should
# check val==0 and fall back to a mixer. Extracted from the
# stack_canary_init asm to give KASLR + canary one entropy source.
# v1.28.0.
fn rdrand_u64() {
    var result = 0;
    asm {
        0x48; 0x0F; 0xC7; 0xF0;       # rdrand rax
        0x48; 0x89; 0x45; 0xF8;       # mov [rbp-0x08], rax (result)
    }
    return result;
}

# Write 64-bit value to an x86 MSR. ecx=msr, edx:eax=value (high:low).
# Generic helper; msr=-0x08, val=-0x10. (No current caller: framebuffer
# write-combining is done via PAT in the leaf PTE — see vmm_remap_wc_2mb /
# fb_console.cyr — not via an MTRR, which would #GP under AMD MtrrLock once
# firmware has locked the variable-MTRR set.)
fn wrmsr(msr, val) {
    asm {
        0x48; 0x8B; 0x4D; 0xF8;       # mov rcx, [rbp-0x08]   ; ecx = msr#
        0x48; 0x8B; 0x45; 0xF0;       # mov rax, [rbp-0x10]   ; rax = val
        0x48; 0x89; 0xC2;             # mov rdx, rax
        0x48; 0xC1; 0xEA; 0x20;       # shr rdx, 32           ; edx = high32
        0x0F; 0x30;                   # wrmsr                 ; MSR[ecx] = edx:eax
    }
    return 0;
}

# Write-back + invalidate all CPU caches. Required around MTRR variable
# range writes per Intel SDM Vol 3A §11.11.8 to evict stale lines tagged
# with the old effective cache type.
fn wbinvd() {
    asm {
        0x0F; 0x09;                   # wbinvd
    }
    return 0;
}

# Flush (write-back + invalidate) the cache line containing `addr` in all caches, so a later read of that
# line misses and refetches from memory. Scoped alternative to wbinvd for DMA-buffer coherence — used by
# gpu_readback_shm_sys to evict a stale ghost of a REUSED readback slot before the GPU DMA overwrites it,
# without flushing the whole cache. First arg is at [rbp-8] (same marshaling as outb above).
fn clflush(addr) {
    asm {
        0x48; 0x8B; 0x45; 0xF8;       # mov rax, [rbp-8]   ; addr
        0x0F; 0xAE; 0x38;             # clflush [rax]
    }
    return 0;
}

# ⭐ 1.56.60 — THE ONE CHOKEPOINT FOR "THIS CORE IS BLOCKED, NOT WORKING".
#
# Every PREEMPT-HELD wait in the kernel parks here: the legacy sti windows the refused contexts keep (sleep_ms#41's,
# the keyboard's kbd_read_blocking_held, snd_write_held / snd_drain_held — since 1.57.7 each of those blocks its caller
# in the wq primitive whenever it can), and the dozen net polls (dhcp/dns/ntp/icmp/tcp, core/devs.cyr). (The idle and
# the #14/#44 park halt through sched_idle_step / sched_halt_window + arch_sti_hlt, which set the same flag.) That is exactly
# why the flag goes HERE and not at each caller — a per-site flag is a list that rots, and the sites
# are the same ~dozen arch_wait() callers that made a per-core `idle` field undecidable.
#
# asm contract: `hlt` — no inputs, no outputs, no clobbers. Halts until the next unmasked interrupt.
# ⛔ REQUIRES IF=1. An IF=0 hlt never wakes (the waitpid hard-hang); callers own that — the legacy sleep_ms#41
# loop does `sti` before its loop for exactly this reason. Unchanged by this edit.
#
# ⚠ THE FLAG IS SET BEFORE THE hlt AND CLEARED AFTER, so the timer ISR that WAKES us observes it
# still set — which is the whole point: that tick paid for halted time, not for work.
# ⚠ The few instructions of window on either side (flag set → hlt, and wake → flag clear) can
# mis-attribute at most one tick per wait, in the conservative direction. Charging the whole tick to
# whoever is current is already the standard sampling model (see timer_handler); this does not make
# it exact, it removes a systematic bias that made a blocked process read 100%.
# ⭐ 1.57.7 (Path 2, S3.4) — THE hlt IS A MIGRATION POINT NOW. A process halted here with IF=1 and preempt_count 0
# (a kmain wait, a kthread, the #14 preempt point) can be switched out by the tick that wakes it and resumed on
# ANOTHER CPU, so the post-hlt clear re-reads the CPU index instead of reusing aw_c — clearing the old CPU's flag
# would eat an unrelated tick there and leave this CPU's armed.
fn arch_wait() {
    var aw_c = pcpu_cpu();
    if (aw_c < 4) { store64(&cpu_in_halt + aw_c * 8, 1); }
    asm { hlt; }
    var aw_c2 = pcpu_cpu();
    if (aw_c2 < 4) { store64(&cpu_in_halt + aw_c2 * 8, 0); }
    return 0;
}
fn arch_halt() { asm { cli; hlt; 0xEB; 0xFE; } return 0; }

# ⭐ 1.57.7 (Path 2, S3.6/S3.8) — THE HALT PROTOCOL'S TWO PRIMITIVES (sched_halt_window, sched_idle_step).
# asm contract: `sti; hlt` — no inputs, no outputs, no clobbers; leaves IF=1. The STI shadow covers the HLT, so an
# interrupt that became pending while the caller ran with IF=0 (a 0xE1 kick sent after the caller's flag store) ends
# the hlt at once instead of being taken before it. Caller runs IF=0 and publishes its flags first.
fn arch_sti_hlt() { asm { 0xFB; 0xF4; } return 0; }
# asm contract: `mfence` — no inputs, no outputs, no clobbers; orders every earlier store before every later load
# (the halter half of the Dekker pair with sched_kick_for: cpu_kickable store -> mfence -> READY scan).
fn arch_mfence() { asm { 0x0F; 0xAE; 0xF0; } return 0; }

# ⭐ 1.56.60 — MASK INTERRUPTS ON THIS CORE, WITHOUT STOPPING IT.
#
# asm contract: no inputs, no outputs, no clobbers. `cli` clears RFLAGS.IF and touches
# nothing else — not CF/ZF, not a GPR — so it is safe to drop in front of any call.
#
# WHY IT EXISTS: power_off's bounded-spin rationale (core/power.cyr:335-339) is written
# assuming "interrupts are off and the filesystem is already quiesced". That held only
# because power_sys was reachable from exactly ONE place — the SYSCALL path, where SFMASK
# 0xC0000084 = 0x40700 clears IF on entry. Anything ELSE that calls into the power path
# must establish the same environment by hand, or the teardown runs preemptible: the
# 100 Hz tick calls hid_poll() then do_context_switch() on every CPU (pic.cyr:127-129),
# which would poll a USB controller across the xhci_stop that is halting it.
fn arch_cli() { asm { cli; } return 0; }
