# === Ring 3 Transition ===

# Globals for exec_and_wait to pass to enter_ring3 without param clobbering.
# 1.46.x SMP STEP-2 (#3, 2026-06-26): PER-CPU. exec_and_wait runs OUT-OF-BAND (entered via
# enter_ring3, not do_context_switch) and sets these between the _set below and the enter_ring3
# read at the bottom; with smp_sched_aps=1 two CPUs each in exec_and_wait would clobber one
# another's params (CPU A's enter_ring3 reading CPU B's entry → iretq into the wrong RIP). Per-CPU
# cell (cpu c at byte c*8); pcpu_cpu()'s cpu_count<2 fast path = slot 0 → single-core byte-identical.
# (The same per-CPU shape the syscall a4 cell had until 1.57.7 moved it per-process, proc_sc_a4 in proc.cyr —
# these stay per-CPU: exec_and_wait never blocks between its set and its read.) All loads happen post-CR3-switch under the per-proc CR3,
# which maps the kernel .bss (these arrays) + the APIC (pcpu_cpu()'s id read) — same residency the
# pre-per-CPU plain-global read already required.
var pcpu_exec_entry_g[4];
fn exec_entry_g_set(v) { store64(&pcpu_exec_entry_g + pcpu_cpu() * 8, v); return 0; }
fn exec_entry_g_get() { return load64(&pcpu_exec_entry_g + pcpu_cpu() * 8); }
var pcpu_exec_rsp_g[4];
fn exec_rsp_g_set(v) { store64(&pcpu_exec_rsp_g + pcpu_cpu() * 8, v); return 0; }
fn exec_rsp_g_get() { return load64(&pcpu_exec_rsp_g + pcpu_cpu() * 8); }
var pcpu_exec_cr3_g[4];
fn exec_cr3_g_set(v) { store64(&pcpu_exec_cr3_g + pcpu_cpu() * 8, v); return 0; }
fn exec_cr3_g_get() { return load64(&pcpu_exec_cr3_g + pcpu_cpu() * 8); }
# (1.57.7 S3b-F4: pcpu_exec_preempt / exec_preempt_set / exec_preempt_get are GONE. They were kybernet's 1.44.14 arm
# for an IF=1 /bin/agnsh started out of band here; agnsh is a scheduled child of kmain now (kernel_run_child), and
# every program this path still enters is a pre-scheduler boot-selftest child, which runs IF=0.)
# 1.44.14: the proc whose exit() should fire kernel_resume (the run-to-completion FOREGROUND proc
# exec_and_wait is waiting on). Set at exec_and_wait entry; gated in exit#0 so a preemptively-
# scheduled #43 background job's exit() never hijacks agnsh's resume. Saved/restored by execwait#37.
# 1.46.x SMP STEP-2 (#3): PER-CPU. Each CPU's foreground exec has its OWN resume target (CPU A's
# agnsh, CPU B's bg-proc #37 child). Set at exec_and_wait entry, read in exit#0; both run in the
# context of the foreground proc's (pinned) CPU. pcpu_cpu() cpu_count<2 fast path = single-core identical.
var pcpu_exec_resume_pid[4];
fn exec_resume_pid_set(v) { store64(&pcpu_exec_resume_pid + pcpu_cpu() * 8, v); return 0; }
fn exec_resume_pid_get() { return load64(&pcpu_exec_resume_pid + pcpu_cpu() * 8); }

# 1.40.4: full kernel resume context (setjmp/longjmp). Saved by exec_and_wait
# before entering ring 3; restored by kernel_resume when the program exits, so
# exec_and_wait "returns" exactly as a normal call — including the callee-saved
# registers (rbx/r12-r15) the ring-3 program clobbers. Layout (u64):
#   [0]=rbx [1]=r12 [2]=r13 [3]=r14 [4]=r15 [5]=caller rbp [6]=return rsp [7]=return rip
# 1.46.x SMP STEP-2 (#3): PER-CPU. exec_ctx IS a kernel-stack continuation — it holds THIS CPU's
# kernel stack rbx/r12-r15/rbp/rsp/rip for the foreground exec parked here. A foreground proc is
# pinned to its launch CPU (idle_owner), so its continuation is only ever saved/restored on that
# CPU; per-CPU exec_ctx is therefore exactly the right model (CPU c's block = CPU c's continuation).
# 8 u64 per CPU × 4 = pcpu_exec_ctx[32]; block for cpu c starts at byte c*64. exec_ctx_base() folds
# pcpu_cpu()*64 so the hand-asm's +0/+8/.../+56 cell offsets read VERBATIM into this CPU's block.
var pcpu_exec_ctx[32];
fn exec_ctx_base() { return &pcpu_exec_ctx + pcpu_cpu() * 64; }

# Execute a user process and wait for it to exit — OUT OF BAND (IF=0, run to completion, entered by enter_ring3's
# iretq and left by the child's exit#0 / fault kill longjmp'ing through kernel_resume). Saves the kernel return
# context so the exit syscall returns here.
# ⭐ 1.57.7 (S3b-F4) — BOOT-ONLY. After `sched_active = 1` every kernel launch is a scheduled child kmain blocks for
# (kernel_run_child, via kernel_exec_foreground) and execwait#37 is a blocking wait, so this path serves only the
# pre-scheduler `sh_exec("run …")` selftest hooks (kernel_exec_boot), bote, and a KTEST-build kybernet. A call after
# the scheduler starts is REFUSED (-1, the latched `exec: exec_and_wait is boot-only -- refused after sched_active`,
# denied by every smoke) with current restored to kmain — see the check below. Retiring the path entirely (moving
# those hooks after the scheduler) is a planned 1.58 step (OQ-11). docs/architecture/foreground-exec.md.
fn exec_and_wait(entry, rsp, cr3) {
    # 1.40.4: FIRST thing — snapshot the full kernel resume context into exec_ctx
    # (callee-saved regs still hold the CALLER's values here; the body below may
    # clobber them). kernel_resume restores these on the program's exit() so the
    # caller (sh_cmd_run / the shell) continues cleanly and can run more programs.
    # `var ctxp = &exec_ctx` lands the array address in rax (the proven idiom);
    # rdx is a scratch temp. [rbp]=caller rbp, [rbp+8]=return addr, [rbp+16]=
    # caller's post-call rsp.
    var ctxp = exec_ctx_base();
    asm {
        0x48; 0x89; 0x18;             # mov [rax], rbx
        0x4C; 0x89; 0x60; 0x08;       # mov [rax+8], r12
        0x4C; 0x89; 0x68; 0x10;       # mov [rax+16], r13
        0x4C; 0x89; 0x70; 0x18;       # mov [rax+24], r14
        0x4C; 0x89; 0x78; 0x20;       # mov [rax+32], r15
        0x48; 0x8B; 0x55; 0x00;       # mov rdx, [rbp]      (caller rbp)
        0x48; 0x89; 0x50; 0x28;       # mov [rax+40], rdx
        0x48; 0x8D; 0x55; 0x10;       # lea rdx, [rbp+16]   (caller post-call rsp)
        0x48; 0x89; 0x50; 0x30;       # mov [rax+48], rdx
        0x48; 0x8B; 0x55; 0x08;       # mov rdx, [rbp+8]    (return addr)
        0x48; 0x89; 0x50; 0x38;       # mov [rax+56], rdx
    }
    # ⭐ 1.57.7 (S3b-F4): BOOT-ONLY. After the scheduler starts the only kernel context that can get here is kmain
    # (pid 0), and every caller has just set current = the child: restore it so kmain does not continue under a stale
    # pid (the hazard kernel_resume's proc_current_set(0) exists for). Nothing else has changed yet — no FG-1, no
    # kstack_install, no CR3 — so -1 leaves everything consistent; the caller reaps its child as on any failure.
    if (sched_active != 0) {
        fg_latch(16, "exec: exec_and_wait is boot-only -- refused after sched_active", 62);
        proc_current_set(0);
        return 0 - 1;
    }
    # ⭐ 1.57.6 (Path 2, S3.3): the out-of-band entry's invariants, asserted (latched, klug + COM1): IF must be 0
    # (every caller brackets with kbd_irq_save; a tick between its proc_current_set(child) and the pin below
    # would save the CALLER's registers into the child's slot) and preempt_count must be 0 (a process only
    # leaves or arrives at 0). After the snapshot asm, which must stay first — it reads the caller's rbx/r12-r15.
    sched_assert_oob(1);
    kernel_return_rsp_set(1);   # nonzero = "a kernel resume context is armed" (ksyscall exit checks this)
    kernel_return_rip_set(0);
    # 1.44.14: remember WHICH proc this resume context belongs to (the foreground proc being
    # run-to-completion — proc_current_get() is it at entry: agnsh for kybernet's launch, the child for
    # execwait#37). exit#0 fires kernel_resume ONLY for this proc, so a PREEMPTIVELY-scheduled
    # background job (#43) that exit()s while agnsh is the armed resume target does NOT hijack
    # agnsh's resume (it just goes state 0 for waitpid#4). Saved/restored across execwait#37 nesting.
    exec_resume_pid_set(proc_current_get());

    # (1.57.7 S3b-F4: the idle_owner PIN that stood here is gone — this path runs only before `sched_active = 1`,
    # when nothing schedules, so no other CPU can pick the child; FG-1 below keeps INV-11/INV-RUN true for it.)
    # ⭐ 1.57.6 (Path 2, S3.3) — FG-1: THE OUT-OF-BAND CHILD IS RUNNING HERE, AND SAYS SO. A foreground child
    # used to sit at state 3 (execwait#37, elf_load_from_file's CLAIMING) or 1 with on_cpu == -1 while it
    # ran, so "on_cpu == -1 ⇔ nobody is on its stack or CR3" (INV-11) and INV-RUN (the proc current on a
    # CPU is state 2 with on_cpu == that CPU) were false for exactly these processes — kept safe only by the
    # pin above. Now they hold by construction. The reap fence's self-owned path clears on_cpu at the
    # kernel_resume exit; a real switch-out (an IF=1 agnsh) publishes it in the switch tail as for anyone.
    proc_set_state(proc_current_get(), 2);
    on_cpu_set(proc_current_get(), pcpu_cpu());
    kst_note_switch_in(proc_current_get());   # KSTACK_SELFTEST: the underfoot witness (no-op twin)

    # Pass params to enter_ring3 via globals (avoid param clobber in asm).
    exec_entry_g_set(entry);
    exec_rsp_g_set(rsp);
    exec_cr3_g_set(cr3);

    # 1.40.3: re-assert the SYSCALL MSRs right before ring 3. Ring 3 had never executed,
    # so the SYSCALL MSRs (STAR / LSTAR / SFMASK / EFER.SCE) set at boot were
    # never exercised — at the first real SYSCALL, SCE read clear (#UD) and RIP
    # landed at 0x1000 (a bad LSTAR). Re-asserting them here (idempotent) guarantees
    # SYSCALL vectors to our stub. Safe after the frame-save asm above.
    # ⛔ 1.57.6 (Path 2, S3.3): syscall_init used to REBUILD the shared entry stub on every exec, on whichever
    # CPU ran it, while other CPUs could be executing those very bytes (cross-modifying code). It is
    # once-guarded now (syscall_hw.cyr): the stub is built by the FIRST call and never rewritten, and every
    # later call only reprograms this CPU's MSRs. ⚠ It must stay syscall_init here and not
    # syscall_msr_init: a boot selftest can exec BEFORE main.cyr's own syscall_init (DOOM_SELFTEST's
    # `run /bin/doom` does), and then THIS call is the one that builds the stub — measured at S3.3: with
    # syscall_msr_init here, doom's first SYSCALL vectored into an empty entry buffer and the boot died
    # silently after "exec: running /bin/doom". That first build always precedes the AP wake (smp_start_aps
    # runs after main.cyr's syscall_init), so no other CPU can be executing the stub while it is written.
    syscall_init();

    # 1.40.3: run ring 3 AND the SYSCALL stub under the SAME full per-process
    # CR3 (exec_cr3_g, which maps kernel supervisor + user U/S + the stub 0-2MB +
    # APIC). The old code ran the program under proc_get_user_cr3(exec_cr3_g) (a
    # DIFFERENT, minimal CR3) while the stub switched to exec_cr3_g — so the
    # stub's `mov cr3` landed in a CR3 that didn't map the stub → fault. Making
    # both the same makes that switch a safe no-op. (KPTI-proper is a later arc.)
    store64(&pcpu_kpti_kernel_cr3 + pcpu_cpu() * 8, exec_cr3_g_get());   # 4c per-CPU
    store64(&pcpu_kpti_user_cr3 + pcpu_cpu() * 8, exec_cr3_g_get());

    # 1.40.3: re-assert IA32_EFER.SCE (SYSCALL enable, bit 0) right before ring 3.
    # syscall_init sets it at boot, but ring 3 had never run, so the SYSCALL path
    # was never exercised — at the first real ring-3 SYSCALL, EFER read back 0xd00
    # (NXE set, SCE clear) → #UD. Re-asserting here guarantees SYSCALL works for
    # the program we're about to enter. (rdmsr/or-eax-1/wrmsr on MSR 0xC0000080.)
    asm {
        0xB9; 0x80; 0x00; 0x00; 0xC0;   # mov ecx, 0xC0000080 (IA32_EFER)
        0x0F; 0x32;                       # rdmsr
        0x0D; 0x01; 0x00; 0x00; 0x00;     # or eax, 1 (SCE)
        0x0F; 0x30;                       # wrmsr
    }

    # 1.40.3: do all kernel-data work BEFORE switching to the minimal user CR3.
    # tss_set_rsp0 reads the Local APIC (0xFEE00020) for the CPU id, which the
    # user CR3 does not map — reading it AFTER the switch faulted (→ #PF → #DF →
    # triple fault, the ring-3 bring-up blocker). Done here under the kernel CR3.
    # 1.46.1: per-proc RSP0 — the foreground proc (proc_current_get(): agnsh for kybernet's
    # launch, the child for execwait#37) takes its CPL3->CPL0 interrupts on ITS OWN
    # region-7 stack. Falls back to 0x3C0000 (= tss_kernel_stack) for an unassigned
    # slot, so this is byte-identical where it used to pass tss_kernel_stack. Inert
    # at IF=0 (foreground run-to-completion takes no timer interrupt); forward-correct
    # for when exec_preempt=1 makes agnsh preemptible. Kept BEFORE the CR3 switch (the
    # APIC-read rule above).
    # ⭐ 1.57.6 (Path 2, S3.3): kstack_install — TSS.RSP0 AND this CPU's syscall top: the child's syscalls run
    # on the child's OWN kernel stack, so an execwait#37 child can no longer grow down through its parent's
    # suspended #37 frame (the old "H2" hazard, which needed a second per-CPU stack). Still BEFORE the CR3
    # switch — tss_set_rsp0 reads the LAPIC.
    kstack_install(proc_current_get());

    # Switch CR3 and enter ring 3 (use user CR3 for KPTI). After the switch
    # enter_ring3 only writes the iretq frame at 0x7000 + cpu*0x40 (in the 0-2 MB
    # trampoline the user CR3 maps) + iretqs — no kernel-data access remains.
    var cr3_load = load64(&pcpu_kpti_user_cr3 + pcpu_cpu() * 8);   # 4c per-CPU
    asm { mov cr3, rax; }
    enter_ring3(exec_entry_g_get(), exec_rsp_g_get());
    return 0;
}

fn enter_ring3(entry, user_rsp) {
    # (TSS RSP0 is set by exec_and_wait BEFORE the CR3 switch — see note there.
    # It must NOT be touched here: under the user CR3 the APIC read would fault.)

    # Write the iretq frame using the function params.
    # Layout: [0]=RIP [8]=CS [16]=RFLAGS [24]=RSP [32]=SS
    #
    # ⛔⛔ 1.56.51 — PER-CPU. This frame was at the FIXED address 0x7000 — a single global cell in
    # the 0-2 MB identity region that every per-process CR3 mirrors, so all CPUs wrote and read the
    # same five words. That is the exact hazard the top of this file already fixed ONE LEVEL UP:
    # pcpu_exec_entry_g / _rsp_g / _cr3_g / _ctx / _resume_pid were all converted to per-CPU arrays
    # with the rationale "two CPUs each in exec_and_wait would clobber one another's params (CPU A's
    # enter_ring3 reading CPU B's entry -> iretq into the wrong RIP)". The frame those per-CPU
    # params FEED was left shared, so the class was only half closed.
    # ⚠ It is reachable: smp_sched_aps=1, and #37's re-entrancy guard is itself per-CPU
    # (pcpu_ew37_busy), so it does not exclude a second CPU. CPU A writes its five words, CPU B
    # overwrites all five, then A executes `mov rsp,<frame>; iretq` and enters ring 3 at B's RIP on
    # B's RSP with B's RFLAGS — under A's CR3 and A's TSS.RSP0. Because every agnos ELF links at
    # 0x400000 and stacks at 0x3FC00000, those addresses are VALID in both address spaces, so it
    # does not fault cleanly: A's process simply begins executing at a foreign offset on a foreign
    # stack inside its own image.
    # ⭐ 0x40 stride x 4 CPUs = 0x7000..0x70FF, all inside the same identity page and clear of
    # everything else in the tree (grepped: nothing else addresses 0x7000-0x70FF).
    var fp = 0x7000 + pcpu_cpu() * 0x40;
    store64(fp + 0, entry);
    store64(fp + 8, 0x23);
    # RFLAGS: bit 1 (reserved) always set; IF (bit 9) CLEAR (0x002) — the pre-scheduler run-to-completion model:
    # exec_and_wait blocks until exit()/kernel_resume and nothing schedules yet. SYSCALL is IF-independent, so
    # write()/exit() still work with IF=0. (1.57.7 S3b-F4: the exec_preempt IF=1 arm kybernet used for /bin/agnsh is
    # gone — agnsh is a scheduled child now — so this is the ONLY IF=0 ring-3 entry, and it is pre-scheduler only:
    # INV-FG-1, whose tripwire is fg_if0_tripwire at #14/#44.)
    store64(fp + 16, 0x002);
    store64(fp + 24, user_rsp);
    store64(fp + 32, 0x1B);

    # CMOS CP 0x20: about to enter ring 3 via iretq. Last instruction
    # executed in ring 0 before the userspace transition. If CMOS[0x50]
    # never reaches 0x20 on iron, no ring-3 transition was attempted.
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x20; 0xE6; 0x71; }

    # 1.53.x B3b: arm #NM for this proc — its first SSE op in ring 3 FXRSTORs its own FP
    # area. This is the single choke point for the out-of-band exec/spawn entries
    # (proc_current_set(pid) → exec_and_wait → enter_ring3) that NEVER pass through the
    # scheduler's fpu_set_ts; without it two sequential f64 procs would leak XMM across
    # the exec boundary. rax clobber is harmless — the GPR-zeroing block below zeros it.
    fpu_set_ts();

    # 1.44.19: zero ALL GPRs before entering ring 3 — a fresh exec'd program otherwise
    # inherits whatever the kernel left in them. Two payoffs: (1) hand-assembled callers
    # that set only the regs they use (the selftest ELFs; legacy 3-arg agnsh syscalls)
    # now deliver DETERMINISTIC a3/rdx = a4/r10 = 0 instead of kernel garbage — the env
    # fallback gate sees a clean 0, not a random pointer; (2) no kernel register contents
    # leak to ring 3 (aligns the foreground exec path with #43's zeroed proc-slot regs).
    # Placed LAST: params entry/user_rsp were consumed by the frame stores above.
    # 1.56.51: the zero-and-iretq is now iretq_to_ring3(fp) — the frame address is a RUNTIME value
    # (per-CPU), so it can no longer be baked into a `mov rsp, imm32`.
    iretq_to_ring3(fp);

    return 0;
}

# iretq_to_ring3(fp) — zero every GPR, point RSP at this CPU's five-word iretq frame, and enter
# ring 3. Does not return.
#
# ⚠ REGISTER CONTRACT. Input: `fp` (the frame's physical/identity address) read from [rbp-8] —
# the FIRST-PARAMETER idiom, which is the form this repo trusts across cyrius regalloc versions
# (cr3_load, io.cyr's outb/inb; see the note above cr3_load in proc.cyr for why the
# "last assigned value lands in RAX" shape is NOT trusted). Outputs: none. Clobbers: every GPR
# and RSP; control does not come back.
# ⛔ ORDER IS LOAD-BEARING: `mov rsp,[rbp-8]` must execute BEFORE `xor rbp,rbp`, or the frame
# address is read through an already-zeroed base. rbp is therefore the LAST register zeroed.
# ⚠ WHY A SEPARATE FUNCTION: the old form baked the address into `mov rsp, 0x7000` (imm32). A
# per-CPU frame needs a runtime value, and reading enter_ring3's own local through a guessed
# [rbp-N] offset is precisely the mistake aarch64's timer.cyr made ([sp,#0] was frame padding).
# A one-parameter function has a frame this repo has already proven.
#
# 1.44.19: zeroing ALL GPRs before ring 3 — a fresh exec'd program otherwise inherits whatever the
# kernel left in them. Two payoffs: (1) hand-assembled callers that set only the regs they use (the
# selftest ELFs; legacy 3-arg agnsh syscalls) deliver DETERMINISTIC a3/rdx = a4/r10 = 0 instead of
# kernel garbage — the env fallback gate sees a clean 0, not a random pointer; (2) no kernel
# register contents leak to ring 3.
fn iretq_to_ring3(fp) {
    asm {
        0x48; 0x31; 0xC0;          # xor rax, rax
        0x48; 0x31; 0xDB;          # xor rbx, rbx
        0x48; 0x31; 0xC9;          # xor rcx, rcx
        0x48; 0x31; 0xD2;          # xor rdx, rdx
        0x48; 0x31; 0xF6;          # xor rsi, rsi
        0x48; 0x31; 0xFF;          # xor rdi, rdi
        0x4D; 0x31; 0xC0;          # xor r8, r8
        0x4D; 0x31; 0xC9;          # xor r9, r9
        0x4D; 0x31; 0xD2;          # xor r10, r10
        0x4D; 0x31; 0xDB;          # xor r11, r11
        0x4D; 0x31; 0xE4;          # xor r12, r12
        0x4D; 0x31; 0xED;          # xor r13, r13
        0x4D; 0x31; 0xF6;          # xor r14, r14
        0x4D; 0x31; 0xFF;          # xor r15, r15
        0x48; 0x8B; 0x65; 0xF8;    # mov rsp, [rbp-8]   (fp) — BEFORE rbp is zeroed
        0x48; 0x31; 0xED;          # xor rbp, rbp
        0x48; 0xCF;                # iretq
    }
    return 0;
}

# ═══════════════ 1.57.7 (S3b) — THE KMAIN FOREGROUND LAUNCH (docs/architecture/foreground-exec.md) ═══════════════
# After `sched_active = 1` kmain (pid 0: the emergency shell's `run`, kybernet's /bin/agnsh, the post-scheduler boot
# selftest hooks) launches a program as an ORDINARY SCHEDULED CHILD and BLOCKS until it exits — the same model
# execwait#37 uses — instead of entering it out of band (exec_and_wait: IF=0, pinned, kmain's continuation in
# per-CPU cells). kmain may block: it is a real proc (state 2, on_cpu = BSP) on its own region-1 stack and the boot
# CR3, and it stays BSP-pinned (idle_owner 0) because that stack is the BSP boot stack (D22).
# kernel_run_child_keep(pid, pin): `pid` is elf_load_from_file's state-3 child of the CURRENT kernel context (kmain).
# Blocks until it exits; returns its RAW exit code with the child DEAD BUT UNREAPED and proc_fgwait[me] still naming
# it (INV-FG-2: its slot cannot be reused, so its page is still mapped — the KSTACK fallback phase reads it).
# -1 with kr_refused = 1 = refused (the child was already reaped) or a defensive abnormal end (child orphaned).
# ⚠ kr_refused exists because a child may itself exit(-1): the caller must never mistake that code for a refusal
# (and skip or double the reap). Only kmain calls these (BSP-pinned, one at a time), so one module cell is exact.
var kr_refused = 0;
fn kernel_run_child_keep(pid, pin) {
    var kr_me = proc_current_get();
    kr_refused = 0;
    if (sched_active == 0) { proc_reap(pid); kr_refused = 1; return 0 - 1; }
    if (preempt_count_get() != 0) { proc_reap(pid); kr_refused = 1; fg_latch(2, "fg: kernel_run_child cannot block here -- child reaped, -1", 58); return 0 - 1; }
    if (wq_can_block() == 0) { proc_reap(pid); kr_refused = 1; fg_latch(2, "fg: kernel_run_child cannot block here -- child reaped, -1", 58); return 0 - 1; }
    # Belt-and-braces, NOT load-bearing for R1 (proc_wait_child_exit brackets IF itself): keeps the BSP-pinned child
    # off this CPU until we have parked, so CP 0x20 -> 0x21 and the first dispatch are ordered deterministically.
    var kr_f = kbd_irq_save();
    syscall_msr_init();                # the per-launch STAR/LSTAR/SFMASK/EFER.SCE re-assert exec_and_wait always did
    #                                    (1.40.3 history); this CPU only — the entry stub is never rebuilt (D-34)
    proc_set_ring3(pid);
    if (pin >= 0) { idle_owner_set(pid, pin); }   # D22: BSP-pinned (pin 0) for every kmain launch
    proc_fgwait_set(kr_me, pid + 1);   # INV-FG-2: before the child can run
    fg_first_entry_pid = pid + 1;      # arm the CP 0x21 breadcrumb (sched.cyr fg_note_first_entry)
    # CMOS CP 0x20: a kernel-launched ring-3 program is about to become runnable (was: enter_ring3's iretq).
    # asm contract: no inputs/outputs; clobbers al only (outb 0x70 <- 0x50, outb 0x71 <- 0x20).
    asm { 0xB0; 0x50; 0xE6; 0x70; 0xB0; 0x20; 0xE6; 0x71; }
    pd_audit(proc_get_cr3(pid), 5);    # tag 5 = kernel_run_child, just before READY
    proc_set_state(pid, 1);
    var kr_w = proc_wait_child_exit(pid);   # kmain is never signalled (non-user); 2/3 = cannot block / collapsed
    kbd_irq_restore(kr_f);
    if (kr_w != 0) {                   # defensive: unreachable after the prechecks. The child is left as an orphan.
        fg_first_entry_pid = 0;
        proc_fgwait_set(kr_me, 0);
        kr_refused = 1;
        return 0 - 1;
    }
    return proc_get_exit_code(pid);
}
# The second half: reap the child kernel_run_child_keep left dead-unreaped, THEN clear the fgwait cell (INV-FG-2:
# only after the reap). flush 1 = proc_reap's foreground door (flushes the child's write-back fds), 0 = proc_reap_child.
fn kernel_run_child_done(pid, flush) {
    if (flush != 0) { proc_reap(pid); } else { proc_reap_child(pid); }
    proc_fgwait_set(proc_current_get(), 0);
    return 0;
}
fn kernel_run_child(pid, pin) {
    var krc = kernel_run_child_keep(pid, pin);
    if (kr_refused != 0) { return 0 - 1; }       # refused paths already reaped (or orphaned); never reap twice
    kernel_run_child_done(pid, 1);
    return krc;
}
# Pre-scheduler (sched_active == 0) only: the out-of-band IF=0 run-to-completion path every boot selftest hook uses
# (exec_and_wait -> the child's exit#0 -> kernel_resume back here). Restores the caller's IF. Returns the RAW code.
fn kernel_exec_boot(pid) {
    var kb_ep = &proc_table + pid * 176;
    var kb_rf = kbd_irq_save();
    proc_current_set(pid);
    exec_and_wait(load64(kb_ep + 24), load64(kb_ep + 16), load64(kb_ep + 160));
    var kb_code = proc_get_exit_code(pid);
    proc_reap(pid);
    kbd_irq_restore(kb_rf);
    return kb_code;
}
# The ONE entry the SHARED shell.cyr / init.cyr use (aarch64 has a stub): scheduled + blocking after sched_active,
# the boot path before it.
fn kernel_exec_foreground(pid, pin) {
    if (sched_active != 0) { return kernel_run_child(pid, pin); }
    return kernel_exec_boot(pid);
}

# spawn_user_proc: create a user process from a kernel function address.
# Allocates per-process address space, maps code+stack pages, returns pid.
# Security (S1): kernel PD entries stay supervisor-only. User code is copied
# to a separate physical page mapped at a user-accessible virtual address.
fn spawn_user_proc(entry_fn) {
    var new_cr3 = proc_create_address_space();
    if (new_cr3 == 0) { return 0 - 1; }

    # Allocate a physical page for user code and copy kernel function to it.
    # 1.44.4: pmm_alloc_2mb (NOT pmm_alloc) — proc_map_page maps a 2 MB huge page,
    # so the backing phys MUST be 2 MB-aligned or code_va aliases to the 2 MB base
    # (a 4 KB pmm_alloc page sits at a sub-2MB offset → the user proc fetches the
    # region base = zeros and #PFs at entry). This is the aliasing hazard pmm.cyr's
    # pmm_alloc_2mb comment warns about; spawn_user_proc inherited it (latent — its
    # only caller before RING3_SELFTEST never actually ran the spawned proc).
    var code_phys = pmm_alloc_2mb();
    if (code_phys == 0) { return 0 - 1; }
    # Map in kernel space for copying
    if (vmm_is_mapped(code_phys) == 0) {
        vmm_map(code_phys, code_phys, 0x83);
    }
    # Copy up to 4KB of function code from kernel to the new page
    memcpy(code_phys, entry_fn, 4096);
    # Map at user-visible VA in process address space (user+exec). 1.44.x page-table
    # VA-collision fix: code at a FIXED 0x400000 (PD[2]), NOT the old pid-striped
    # 0x400000 + pid*0x200000 — that put pid>=6 code at >=16 MB (PD[8..63]), where
    # proc_map_page OVERWROTE the identity-SUPERVISOR map of the pmm pool (proc.cyr:290)
    # with a USER mapping, so a later kernel load64 of a page-table page physically in
    # 16-128 MB SMAP-faulted on context switch (proc_get_user_cr3). Each proc has its OWN
    # CR3, so a fixed VA is safe (no inter-proc aliasing) — same VA elf_load_from_file's
    # segment uses (elf.cyr:163).
    var code_va = 0x400000;
    proc_map_page(new_cr3, code_va, code_phys);

    # Allocate user stack (2 MB-aligned — same huge-page aliasing rule as code). 1.44.x:
    # FIXED 0x3FC00000 (PD[510], top of the non-identity mmap arena), NOT the old striped
    # 0x800000 + pid*0x400000 (>=16 MB for pid>=2, inside PD[8..63]). Mirrors
    # elf_load_from_file (elf.cyr:291); the arena ceiling (0x3FA00000) sits one guard slot
    # below, so no mmap collision.
    var stack_base = 0x3FC00000;
    var stack_phys = pmm_alloc_2mb();
    if (stack_phys == 0) { return 0 - 1; }
    if (vmm_is_mapped(stack_phys) == 0) {
        vmm_map(stack_phys, stack_phys, 0x83);
    }
    proc_map_page(new_cr3, stack_base, stack_phys);
    # S6: unmap guard page below stack to trap overflow
    proc_unmap_page(new_cr3, stack_base - 0x200000);
    var stack_top = stack_base + 0x4000;

    # Create process with user VA entry point (not kernel address). 1.46.x #2: proc_create_USER
    # leaves it state=3 (NOT schedulable) until the per-proc CR3 is wired below; flip ready last so a
    # woken AP can't pick it mid-build (these run via the scheduler).
    var new_pid = proc_create_user(code_va, stack_top);
    if (new_pid >= 0) {
        proc_set_cr3(new_pid, new_cr3);
        proc_set_state(new_pid, 1);   # 1.46.x #2: CR3 wired — NOW schedulable
    }
    return new_pid;
}
