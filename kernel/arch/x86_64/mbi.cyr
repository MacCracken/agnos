# === Boot-info capture (Path C — sovereign UEFI bootloader) ===
#
# The AGNOS sovereign UEFI bootloader, `gnoboot`, hands off to the
# kernel with **RDI = physical address of the AGNOS boot-info
# struct** (magic `0x41474E4F = 'AGNO'`, layout in
# agnosticos/docs/development/path-c-sovereign-uefi.md § Handoff).
# The ELF64 boot shim (boot_shim.cyr `#ifdef ELF64_KERNEL` branch)
# preserves RDI through its entry (stack setup + UART init touch
# RAX/RCX/RSP/RBP/RDX — RCX since 1.57.12's .bss stack load — not RDI). Immediately after the
# shim, a top-level call to `boot_info_capture_rdi()` captures that
# register into the kernel global `boot_info_ptr` (declared in
# boot_data.cyr).
#
# Why a function call instead of inline asm at top level:
#
# Cyrius top-level `var p = &X;` is a gvar *declaration with deferred
# init* — the address-load emits at EMIT_GVAR_INITS time (end of the
# kernel image), not in source order. A function CALL, by contrast,
# emits in source order during PARSE_PROG, and inside the function
# the `var p = &X;` becomes an immediate local-var init that loads
# RAX = &X right away.
#
# RDI is a SysV scratch register (caller-saved) — cyrius's normal
# fn-call setup writes to RDI when passing arg 0. So why does it
# survive into this fn? Because `boot_info_capture_rdi()` takes NO
# ARGS — cyrius doesn't touch RDI at the call site. RDI from
# firmware/gnoboot/shim flows through unmolested to the asm below.
#
# `mov [rax], rdi` encodes as 3 bytes: REX.W (0x48) + opcode 0x89
# (MOV r/m64, r64) + ModR/M 0x38 (mod=00 reg=RDI rm=RAX).
#
# History: pre-Path-C builds used `mbi_capture_rbx()` and expected
# RBX = MBI physical address per multiboot2 § 8.4.3. The Path A
# multiboot2-via-GRUB experiment died under GRUB's strict-W^X EFI
# relocator (see agnosticos/docs/development/iron-nuc-zen-log.md
# § Diagnosis 2). Path C replaces GRUB with gnoboot entirely and
# changes the handoff protocol to a sovereign struct addressed
# through RDI.

#ifdef ELF64_KERNEL
fn boot_info_capture_rdi(): i64 {
    var p = &boot_info_ptr;          # mov rax, <abs_addr_of_boot_info_ptr>
    asm {
        0x48; 0x89; 0x38;            # mov [rax], rdi
    }
    # boot_info_ptr now holds gnoboot's &boot_info — the runtime load address
    # of gnoboot's PE image, which UEFI places >=4 GB on a RAM-rich Zen box.
    # Reading it in place works HERE (UEFI's all-RAM identity map is still the
    # live CR3) but the per-process CR3 used during exec maps only 0-4 GB
    # (pt_init's ceiling), so fb_fb_phys's load64(boot_info+0x48) #PF'd during
    # prog2's first write (1.40.9 iron #PF, RIP=fb_fb_phys, CR2 ~0x140006190).
    # Copy the struct into a LOW (<4 GB) kernel buffer and repoint, so every
    # later read is CR3-independent. The copy must run now, before any
    # per-process CR3 is loaded — this top-level call is the first thing after
    # the boot shim, long before exec. memcpy(dst, src, n).
    # ⛔⛔ 1.56.51 — VALIDATE BEFORE TRUSTING, AND THE VALIDATION MUST BE HERE, NOT 370 LINES LATER.
    # This used to be `if (src != 0) { memcpy(&boot_info_copy, src, 128); ... }` — gated on nothing
    # but non-zero. RDI at kernel entry is whatever the loader left there, and the only place in the
    # tree that ever checked the magic was a DIAGNOSTIC PRINT at main.cyr:429, whose own comment
    # claims "bi==0 or a wrong magic => not a gnoboot Path-C boot ... report and skip rather than
    # print garbage". True of that print, and false of the kernel: by the time it runs the struct
    # has already been trusted three times — main.cyr:52 dereferences +0x70 for the KASLR base,
    # main.cyr:59 hands the pointer to pmm_probe_memmap, acpi.cyr reads the RSDP at +0x38.
    # pmm_probe_memmap is the dangerous one: its gates are only mm!=0 / count!=0 / entsize>=40, and
    # `count` is a load32, so a garbage struct walks up to 4294967295 entries of load32/load64
    # across arbitrary physical addresses until it leaves the identity map and #PFs in boot context,
    # where nothing catches it.
    # ⚠ The fixed 128 was also 8 bytes LONGER than the struct it copies (gnoboot's is 120 / 0x78,
    # as boot_data.cyr's own comment concedes), so even a well-formed boot over-read by 8 bytes.
    # Copy min(struct_size, 128) instead — which accepts a future LARGER gnoboot struct by taking
    # its prefix, rather than rejecting the boot outright.
    # ⭐ On any failure boot_info_ptr is left ZERO, which is what makes every downstream
    # `if (bi == 0)` guard engage instead of parsing garbage.
    var src = load64(&boot_info_ptr);
    store64(&boot_info_ptr, 0);                  # nothing is trusted until it validates
    if (src != 0) {
        if ((load32(src) & 0xFFFFFFFF) == 0x41474E4F) {     # 'AGNO' — the Path C handoff magic
            var ssz = load64(src + 8);                       # struct_size @ +0x08
            if (ssz >= 0x78) {                               # at least the v2 struct we know
                var n = ssz;
                if (n > 128) { n = 128; }                    # never past boot_info_copy's 128 B
                memcpy(&boot_info_copy, src, n);
                store64(&boot_info_ptr, &boot_info_copy);
            }
        }
    }
    return 0;
}

# ⭐ 1.57.12 — WHAT THE UEFI MAP gnoboot HANDED OVER SAYS ABOUT A PHYSICAL SPAN. Replaces 1.57.7's
# bootstack_window_check (IMG-fix, review A3/B2), which asked one question about one fixed span — was
# region 1's BSP stack window [0x3D0000, 0x400000) ([0x390000, 0x3C0000) at 1.57.7-1.57.10) free RAM? —
# because the boot stack was live there from the shim's first push and nothing reserved it. 1.57.12
# vacated that window (the boot stack is the image's .bss array bsp_boot_stack, the BSP's RSP0 is
# region-7 slot 0), so main.cyr asks two questions of this one function:
#   mode 1 — PINNED BY THE LOADER: every descriptor meeting [lo, hi) is EfiLoaderCode (type 1), the type
#     gnoboot allocates the kernel image as (one AllocatePages(AllocateAddress) at 0x100000 sized from
#     p_memsz; it zeroes every [p_filesz, p_memsz) gap). Asked of the image span, which holds the boot stack.
#   mode 0 — FREE RAM ONCE ExitBootServices RETURNS: types 3 (BootServicesCode), 4 (BootServicesData) and
#     7 (Conventional). Asked of region 7 [0xE00000, 0x1000000), the home of EVERY kernel stack —
#     per-process, kthread, IST1, and the per-CPU RSP0 slots (the BSP's included). pmm_init keeps the
#     kernel's own allocator out of it, but only the firmware decides whether it was RAM to begin with,
#     and nothing looked before 1.57.12.
# In both modes the descriptors must COVER the span (a hole is not RAM) and the map buffer itself must lie
# outside it. Returns 0 = OK, 1 = not (uefi_span_type / uefi_span_start name the first offender; type
# 0xFFFF = a hole, or the map buffer inside the span), -1 = no usable map (nothing checked). It repairs
# nothing (both spans are in use by the time it runs); it REPORTS, once, and the smokes deny the violation
# lines (SMOKE_INVARIANT_DENY). On iron this is the one part of the layout QEMU cannot exercise.
# ⚠ main.cyr's region-7 bounds and OK line are read by scripts/check/image-layout-check.sh (its region-7 map).
var uefi_span_type = 0;
var uefi_span_start = 0;
fn uefi_span_check(bi, lo, hi, mode): i64 {
    if (bi == 0) { return 0 - 1; }
    if (hi <= lo) { return 0 - 1; }
    var mm = load64(bi + 0x28);
    var count = load32(bi + 0x30);
    var entsize = load32(bi + 0x34);
    if (mm == 0) { return 0 - 1; }
    if (count == 0) { return 0 - 1; }
    if (entsize < 40) { return 0 - 1; }       # EFI_MEMORY_DESCRIPTOR is >= 40 bytes (as pmm_probe_memmap)
    if (count > 4096) { return 0 - 1; }       # a garbage count: pmm_probe_memmap's hazard, not walked here
    if (mm < hi) {
        if (mm + count * entsize > lo) {
            uefi_span_type = 0xFFFF;
            uefi_span_start = mm;
            return 1;
        }
    }
    var covered = 0;
    var i = 0;
    while (i < count) {
        var e = mm + i * entsize;
        var etype = load32(e);
        var pstart = load64(e + 8);
        var pend = pstart + load64(e + 24) * 4096;
        if (pend > lo) {
            if (pstart < hi) {
                var ok = 0;
                if (mode == 0) {
                    if (etype == 7) { ok = 1; }
                    if (etype == 3) { ok = 1; }
                    if (etype == 4) { ok = 1; }
                }
                if (mode == 1) {
                    if (etype == 1) { ok = 1; }
                }
                if (ok == 0) {
                    uefi_span_type = etype;
                    uefi_span_start = pstart;
                    return 1;
                }
                var a = pstart;
                if (a < lo) { a = lo; }
                var b = pend;
                if (b > hi) { b = hi; }
                covered = covered + (b - a);
            }
        }
        i = i + 1;
    }
    if (covered < hi - lo) {
        uefi_span_type = 0xFFFF;
        uefi_span_start = lo;
        return 1;
    }
    return 0;
}

# ⭐ 1.57.12 — the kernel image's span [0x100000, LOAD end), read from the ELF header the loader put at the
# image base: the image is ONE flat PT_LOAD, file offset 0 -> VA = phys 0x100000 (image-layout-check.sh
# asserts that shape at build time), so its header is the image's first bytes. LOAD end = p_vaddr + p_memsz,
# the whole range gnoboot allocated (memsz includes .bss and cycc's zero-fill). Returns 0 when the header is
# not the one expected, and the caller then checks nothing.
fn kernel_image_end(): i64 {
    var kb = 0x100000;
    if ((load32(kb) & 0xFFFFFFFF) != 0x464C457F) { return 0; }   # "\x7FELF"
    var phoff = load64(kb + 0x20);
    var phentsize = load16(kb + 0x36) & 0xFFFF;
    var phnum = load16(kb + 0x38) & 0xFFFF;
    if (phoff > 0x1000) { return 0; }
    if (phentsize < 56) { return 0; }
    if (phnum > 16) { return 0; }
    var i = 0;
    while (i < phnum) {
        var ph = kb + phoff + i * phentsize;
        if ((load32(ph) & 0xFFFFFFFF) == 1) {                    # PT_LOAD
            if (load64(ph + 0x10) != kb) { return 0; }           # p_vaddr: the flat image starts at its header
            return kb + load64(ph + 0x28);                       # + p_memsz
        }
        i = i + 1;
    }
    return 0;
}

# 1.57.12 — an address inside the CALLER's stack: this function's own local, one frame below it. main.cyr
# uses it to show that kmain is running on bsp_boot_stack (top-level `var`s are globals, so it needs a frame).
fn bsp_rsp_sample(): i64 {
    var brs = 0;
    return &brs;
}
#endif
