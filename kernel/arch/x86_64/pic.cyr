# === PIC + Timer ===

fn pic_init() {
    # Remap PIC: IRQ 0-7 → INT 32-39, IRQ 8-15 → INT 40-47
    # ICW1: init + ICW4 needed
    asm { 0xB0; 0x11; 0xBA; 0x20; 0x00; 0x00; 0x00; 0xEE; }  # out 0x20, 0x11
    asm { 0xB0; 0x11; 0xBA; 0xA0; 0x00; 0x00; 0x00; 0xEE; }  # out 0xA0, 0x11
    # ICW2: vector offsets
    asm { 0xB0; 0x20; 0xBA; 0x21; 0x00; 0x00; 0x00; 0xEE; }  # out 0x21, 0x20 (IRQ0=INT32)
    asm { 0xB0; 0x28; 0xBA; 0xA1; 0x00; 0x00; 0x00; 0xEE; }  # out 0xA1, 0x28 (IRQ8=INT40)
    # ICW3: master has slave on IRQ2, slave ID=2
    asm { 0xB0; 0x04; 0xBA; 0x21; 0x00; 0x00; 0x00; 0xEE; }  # out 0x21, 0x04
    asm { 0xB0; 0x02; 0xBA; 0xA1; 0x00; 0x00; 0x00; 0xEE; }  # out 0xA1, 0x02
    # ICW4: 8086 mode
    asm { 0xB0; 0x01; 0xBA; 0x21; 0x00; 0x00; 0x00; 0xEE; }  # out 0x21, 0x01
    asm { 0xB0; 0x01; 0xBA; 0xA1; 0x00; 0x00; 0x00; 0xEE; }  # out 0xA1, 0x01
    # ⛔ MASK EVERY 8259 LINE. This used to be 0xFC — IRQ0 (PIT) and IRQ1 (PS/2 keyboard) unmasked.
    # The PS/2 keyboard is deleted (2026-08-08, operator ruling) and the LAPIC timer owns the timebase,
    # so nothing on this chip has a consumer: the NIC and xHCI are MSI-X, which bypasses the 8259.
    # ⚠ MASKING IS NOT OPTIONAL NOW THAT VECTOR 33 IS GONE. Without a gate, a delivered IRQ1 lands on
    # `idt_init`'s default `isr_stub` — a bare `iretq` that sends NO EOI — and the in-service bit latches
    # forever. QEMU's q35 always has a real i8042 that can assert it, so this line is what keeps an
    # unowned interrupt from wedging the chip.
    # ⚠ The PIT COUNTER still free-runs below (mode-2 rate generator): masking the IRQ does not stop the
    # counter, and `pit_ch0_read()` still feeds the GPU timebase and lapic_calibrate — since 1.57.7 (S1b)
    # only the PM-LESS fallback of the LAPIC reload (the ACPI PM timer measures it when the early probe finds one).
    asm { 0xB0; 0xFF; 0xBA; 0x21; 0x00; 0x00; 0x00; 0xEE; }  # out 0x21, 0xFF (all master lines masked)
    asm { 0xB0; 0xFF; 0xBA; 0xA1; 0x00; 0x00; 0x00; 0xEE; }  # out 0xA1, 0xFF
    # Program PIT channel 0: mode 2 (rate generator), ~100 Hz
    # Command: channel 0, lobyte/hibyte, mode 2, binary
    # out 0x43, 0x34
    asm { 0xB0; 0x34; 0xBA; 0x43; 0x00; 0x00; 0x00; 0xEE; }
    # Divisor = 1193180 / 100 = 11932 = 0x2E9C
    # out 0x40, low byte
    asm { 0xB0; 0x9C; 0xBA; 0x40; 0x00; 0x00; 0x00; 0xEE; }
    # out 0x40, high byte
    asm { 0xB0; 0x2E; 0xBA; 0x40; 0x00; 0x00; 0x00; 0xEE; }
    return 0;
}

# ⛔ `pic_mask_pit()` IS DELETED (2026-08-08). It masked IRQ0 so a PIT tick could not wedge the 8259's
# in-service register and block the lower-priority **IRQ1 keyboard** — a workaround that existed only to
# keep the PS/2 path deliverable. With that path gone, `pic_init` masks the whole chip outright and there
# is nothing left to protect. ⚠ It had also been refuted on its own terms: CHANGELOG 1.44.25 records it
# as "a NO-OP, not the fix", the real cause being the xHCI keyboard ring armed one TRB deep.

# Timer ISR handler — called from the ISR bytecode after regs are pushed.
# rsp_after_push is the stack pointer with all 9 regs + hardware frame on it.
fn timer_handler(rsp_after_push) {
    # ⭐ 1.57.6 (Path 2, S3.2) — THE ISR BODY IS NON-PREEMPTIBLE: preempt_count is raised for everything this
    # handler does before the switch decision (hid_poll's key pushes, the NIC drain, the tick accounting) and
    # dropped IMMEDIATELY before do_context_switch, so the count the switch sees is the interrupted
    # context's own. Anything in the body that asks "may I block / switch here?" therefore hears NO — a
    # wait or wake reached from interrupt context can never switch the ISR frame away before its EOI (that
    # CPU would keep the timer vector in service and lose its tick). The net effect on the interrupted
    # context's count is zero.
    preempt_disable();
    kst_isr_hook(rsp_after_push);                      # 1.57.6 (S3.3) KSTACK_SELFTEST: ISR-body preempt sample + the park wake + (1.57.7) the AC sample (no-op twin)
    pd510_tick_watch();
    # ⭐ CHARGE THIS TICK TO THE RUNNING PROCESS (1.56.59, telemetry §4) — the per-process CPU time a
    # monitor's CPU% column is built from.
    # ⛔ OUTSIDE THE pcpu_cpu()==0 GATE BELOW, DELIBERATELY, AND THIS IS THE WHOLE CORRECTNESS ARGUMENT.
    # That gate exists because `timer_ticks` is ONE GLOBAL wall clock and the NIC ring has ONE consumer,
    # so only the BSP may touch them. CPU time is the opposite shape: each CPU runs a DIFFERENT process
    # and must charge its OWN. Gating this would silently attribute every AP's work to nobody, and the
    # bug would look like "the monitor says the box is idle while it is busy" — the exact symptom that
    # is hardest to trace back to an accounting line.
    # ⚠ `proc_current_get()` is already per-CPU (it reads the APIC id once cpu_count>=2), so there is no
    # second CPU-identity mechanism here to keep in step with the first.
    # ⚠ Charging the WHOLE tick to whoever is running at the boundary is the standard sampling model
    # (Linux jiffy accounting does the same). It is statistical, not exact: a process that always
    # yields just before the tick is undercounted. Over a monitor's sampling window that is noise, and
    # the alternative — reading the TSC on every context switch — puts an rdtsc + divide in the
    # scheduler's hot path to sharpen a number nobody reads at that resolution.
    # ⭐ 1.56.60 — DO NOT CHARGE A TICK THAT PAID FOR A HALT. `cpu_in_halt[cpu]` is set around the
    # `hlt` in arch_wait() (arch/x86_64/io.cyr), which is where every blocking wait in the kernel
    # parks. Without this the counter measured WALL time, not CPU time: sleep_ms#41 halted with the
    # caller still current (preempt_disable, so do_context_switch early-returns), so a process
    # blocked in a syscall accrued at wall-clock rate and a monitor rendered it at 100% while asleep.
    # (1.57.7: #41 now BLOCKS its caller — a blocked process is not current and accrues no ticks. The
    # legacy preempt-held sti window (sleep_ms#41's pre-1.57.7 body) still halts with the caller current,
    # for the contexts that cannot block, and the other preempt-held waits still use the same shape.)
    # Measured and reported by chakshu v0.9.9, which built the CPU% column and backed it out.
    # ⚠ THIS DOES NOT RE-CHARGE THE TICK ELSEWHERE. Halted time belongs to no process — it is the
    # box being idle — and inventing an owner for it is what produced the wrong number.
    # ⚠ Read for THIS cpu only. tk_c below recomputes pcpu_cpu() for the per-core band; both calls
    # are `if (cpu_count < 2) return 0;` cheap, and keeping them separate leaves that band's
    # carefully-argued shape untouched.
    # ⛔⛔ THE ISR *CONSUMES* THE FLAG — READ THEN CLEAR — AND THAT IS NOT AN OPTIMISATION.
    # MEASURED 2026-09-03: clearing it only in arch_wait() after the `hlt` WEDGED THE COUNTER FOR
    # THE WHOLE BOOT (telemetry §4 exit 84, "ticks never moved"). The wake path does not reliably
    # return through arch_wait's tail: this ISR calls do_context_switch a few lines below, which on
    # a tick that woke a halt switches to a DIFFERENT process — so the post-hlt store never runs,
    # the flag stays 1, and EVERY subsequent tick on that core is suppressed forever. The idle loop
    # (core/sched.cyr) parks in arch_wait, so this happens almost immediately on any real boot.
    # ⇒ Consuming it here makes the suppression ONE-SHOT: one `hlt` cancels exactly the one tick
    # that woke it, which is the correct accounting anyway. A long wait re-arms it on every loop
    # iteration (the legacy sleep_ms#41 loop does ~30 hlts for 300 ms, cancelling ~30 ticks).
    # ⚠ arch_wait's post-hlt clear is STILL REQUIRED and is not redundant: a wait woken by a
    # NON-timer interrupt leaves the flag armed with no ISR here to consume it, and it would then
    # eat the next unrelated tick.
    var tk_hc = pcpu_cpu();
    var tk_halted = 0;
    if (tk_hc < 4) {
        tk_halted = load64(&cpu_in_halt + tk_hc * 8);
        if (tk_halted != 0) { store64(&cpu_in_halt + tk_hc * 8, 0); }
        # ⭐ 1.57.7 (Path 2, S3.8): the tick ends any halt on this CPU and may switch the halted context out (the same
        # reason this ISR consumes cpu_in_halt above), so the kick-target flag is cleared here too: a flag left at 1 on
        # a CPU that now runs another process would draw 0xE1 kicks it cannot serve. (Forward &var into proc.cyr — the
        # &cpu_in_halt precedent.) The idle step / park set it again before their next hlt.
        store64(&cpu_kickable + tk_hc * 8, 0);
    }
    var tk_p = proc_current_get();
    if (tk_halted == 0) {
        if (tk_p >= 0) {
            if (tk_p < 16) { store64(&proc_ticks + tk_p * 8, load64(&proc_ticks + tk_p * 8) + 1); }
        }
    }
    # ⭐ PER-CORE user/kernel split (telemetry §8) — decided by the PRIVILEGE OF THE INTERRUPTED
    # CONTEXT, not by which process is scheduled. `proc_current_get()` above says who would run next;
    # it says nothing about whether the CPU was executing user code when the tick landed, which is the
    # question a per-core utilisation bar asks.
    # ⚠ CS lives at frame+128 — the same offset `proc_save_context` reads it from (core/sched.cyr),
    # cited rather than re-derived so the two cannot drift apart. RPL is the low 2 bits.
    # ⚠ Charged on EVERY CPU (no BSP gate): this is per-core by definition.
    var tk_cs = load64(rsp_after_push + 128);
    var tk_c  = pcpu_cpu();
    if (tk_c < 4) {
        if ((tk_cs & 3) == 3) { store64(&cpu_user_ticks + tk_c * 8, load64(&cpu_user_ticks + tk_c * 8) + 1); }
        if ((tk_cs & 3) != 3) { store64(&cpu_kern_ticks + tk_c * 8, load64(&cpu_kern_ticks + tk_c * 8) + 1); }
    }
    # 1.46.x SMP sub-bite 6b: the BSP owns the wall clock + the single NIC ring. An AP's
    # timer tick must NOT bump timer_ticks (one global clock) nor re-enter net_rx_drain (one
    # shared r8169 ring, single-consumer). Gate both behind pcpu_cpu()==0. (1.57.7: wq_tick, the wait-deadline
    # expiry, is deliberately OUTSIDE this gate — below — every CPU runs it.) ALWAYS-TRUE
    # single-core (pcpu_cpu()==0), so this is byte-identical there; LOAD-BEARING on multi-core since
    # sub-bite 7 — a woken AP arms its own APIC timer (smp.cyr) and takes ticks, and this gate keeps
    # that AP tick off the BSP-owned wall clock + single NIC ring. do_context_switch runs on EVERY
    # CPU (each schedules its own).
    if (pcpu_cpu() == 0) {
        timer_ticks = timer_ticks + 1;
        # Service the NIC RX ring every tick (100 Hz) so it stays drained even when no
        # ring-3 tool is in a poll loop. Otherwise LAN broadcast/multicast chatter
        # overruns the 64-deep r8169 ring during sleep_ms / idle gaps and the NIC drops
        # replies (the iron 50%-loss; QEMU's quiet point-to-point SLIRP never showed
        # it). The drain is self-guarded (net_rx_lock atomic try-lock, 1.46.x #5), so it no-ops
        # (trylock fails) rather than re-enter a tool's in-flight drain — now correct cross-CPU.
        # ⭐ 1.57.7 (S4): net_rx_drain_isr() is the named interrupt-context seam into the RX demux. It
        # TRANSMITS (ARP/ICMP replies, TCP ACK/SYN-ACK/FIN/RST) and serves passive opens, and everything it
        # reaches takes only IRQ-saved net locks or try-locks and never allocates (the TCP conn pool is
        # kmalloc'd at boot) — see its header in net_ingress.cyr. Runs before the context switch so it executes in the kernel context
        # established at ISR entry (pre-CR3-swap); nic_ready() gates it to a no-op
        # until the NIC is up, so early-boot ticks are safe.
        net_rx_drain_isr();
        # B5 audio: service the output stream's double-buffer refill (polled, no IRQ,
        # like the NIC drain). No-op until a producer arms hda_stream_on (the HDA_TONE
        # sweep, or snd_write#66 at Gate 2), so early-boot + audio-idle ticks pay only
        # a load+compare. BSP-only: the single stream/ring is BSP-owned like the NIC.
        hda_stream_service();
        # 1.53.7: belt-and-suspenders keyboard drain. The xHCI RX MSI-X ISR (vector 0x51) is the
        # primary path once armed post-enum; this tick drain keeps the keyboard alive if the MSI is
        # missed/masked on real Zen (net kept both the tick drain + the MSI path too).
        # ⛔ 1.56.52 — THIS COMMENT NAMED TWO GUARANTEES THAT DO NOT EXIST, and the second was already
        # corrected 165 lines below in this same file without this copy being touched.
        #   (a) "hid_poll self-gates (hid_kbd_slot_id==0 → no-op pre-enum)" — that guard was DELETED,
        #       and hid.cyr says why in the four lines above its replacement: on a box with a mouse and
        #       no keyboard it drained nothing AND never cleared IMAN.IP, so the controller sent no
        #       further MSI-X and every device went quiet. hid_poll now gates on `hid_ep_count == 0`,
        #       which proves xHCI init ran without asserting anything about a keyboard.
        #   (b) "is cli-first RX-only, so it is safe early-boot and non-re-entrant" — FALSE on SMP, and
        #       the MSI-X arm at the bottom of this file already carries the correction: `cli` on one
        #       CPU does not exclude this handler running on another. hid_poll is re-entrancy-safe
        #       because it takes its own try-lock (`hid_poll_trylock`), not because of `cli`.
        # ⚠ A comment promising a guard that was removed is worse than no comment: it tells the next
        # reader the caller is already protected, which is exactly the reasoning that leaves the real
        # protection out.
        hid_poll();
    }
    # ⭐ 1.57.7 (Path 2, S3.4): expire wait deadlines — on EVERY CPU, deliberately OUTSIDE the BSP-only block above.
    # A deadline is a property of a waiter, not of the wall clock, and a waiter pinned to or halted on an AP must
    # time out even while the BSP runs a long IF=0 syscall (in TSC mode the deadlines are on sched_clock_us, which
    # every CPU can read). Inside the preempt bracket: wq_tick only wakes, never switches (sched.cyr).
    wq_tick();
    # ⭐ 1.57.7 (S6): the timer-driven half of the net stack — retransmits for BLOCKED senders, the held-FIN-slot
    # timers, and the loopback drain — on EVERY CPU (net_ingress.cyr; one CPU runs its body at a time, a busy tick
    # skips). Inside the preempt bracket: it only wakes (wq_wake), never switches.
    net_tick();
    preempt_enable();                                  # 1.57.6 (S3.2): end of the ISR body — the switch decision sees the interrupted count
    # 1.57.6 (Path 2, S3.1): do_context_switch returns 0 (no switch — the stub's own epilogue resumes the
    # interrupted context) or old + 1 (a real switch: the frame holds NEW's context but sits on OLD's
    # stack, so this handler must leave through sched_leave_old, which moves off that stack, publishes
    # on_cpu(old) = -1 and iretqs into new — it never returns here). The EOI stays BEFORE the tail, so
    # the LAPIC in-service bit is clear whichever way this tick leaves.
    # ⭐ 1.57.7 (S7) — THE LIFECYCLE TICK (boundary B): a kill or stop pending on a CPL3-interrupted, unpinned current
    # takes effect here, on every CPU, before the switch decision (INV-L2 — sched.cyr proc_tick_lifecycle). Per tick:
    # 1 call + 2 loads (the pid is tk_p, read above: no second LAPIC read).
    proc_tick_lifecycle(rsp_after_push, tk_p);
    var tk_sw = do_context_switch(rsp_after_push);
    # EOI: APIC if enabled, otherwise legacy PIC
    if (apic_enabled == 1) {
        apic_eoi();
    } else {
        asm { 0xB0; 0x20; 0xBA; 0x20; 0x00; 0x00; 0x00; 0xEE; }
    }
    if (tk_sw != 0) { sched_leave_old(rsp_after_push, tk_sw - 1); }
    return 0;
}

fn timer_isr_build() {
    # Build timer ISR in data buffer.
    # Strategy: push ALL 15 general-purpose regs (9 caller-saved + 6 callee-saved)
    # so the full proc state is captured by proc_save_context. Pre-Attempt-15
    # this ISR only pushed the 9 caller-saved regs despite a stale comment
    # claiming otherwise; the missing callee-saved push leaked rbx/rbp/r12-r15
    # between procs, corrupting frame-pointer-relative locals (idle_count etc.)
    # when the kernel idle proc was finally re-selected. See iron-boot Attempt
    # 15 § Repair (C) — sub-case 2 territory.
    var p = &timer_isr;
    var handler_addr = &timer_handler;
    var off = 0;
    # 1.57.7 (S3.4) — clac FIRST: no inputs/outputs; clears RFLAGS.AC. Hardware does not clear AC on interrupt
    # delivery, so without it this ISR body would run with SMAP OFF whenever it lands on ring 3 that set AC with
    # popf, or inside a syscall after the entry stub's stac. The saved RFLAGS keeps the interrupted AC; iretq
    # restores it. (kstack-smoke's "isr clac" phase checks every gate's first three bytes.)
    store8(p + off, 0x0F); store8(p + off + 1, 0x01); store8(p + off + 2, 0xCA); off = off + 3;   # clac

    # Caller-saved: rax rcx rdx rsi rdi r8 r9 r10 r11
    store8(p + off, 0x50); off = off + 1;  # push rax
    store8(p + off, 0x51); off = off + 1;  # push rcx
    store8(p + off, 0x52); off = off + 1;  # push rdx
    store8(p + off, 0x56); off = off + 1;  # push rsi
    store8(p + off, 0x57); off = off + 1;  # push rdi
    store8(p + off, 0x41); store8(p + off + 1, 0x50); off = off + 2;  # push r8
    store8(p + off, 0x41); store8(p + off + 1, 0x51); off = off + 2;  # push r9
    store8(p + off, 0x41); store8(p + off + 1, 0x52); off = off + 2;  # push r10
    store8(p + off, 0x41); store8(p + off + 1, 0x53); off = off + 2;  # push r11

    # Callee-saved: rbx rbp r12 r13 r14 r15 (Attempt-15 Repair C addition).
    # After these pushes, [rsp+0..47] = {r15,r14,r13,r12,rbp,rbx} and
    # [rsp+48..119] = {r11,r10,r9,r8,rdi,rsi,rdx,rcx,rax}; hw frame moves
    # from [rsp+72..104] to [rsp+120..152]. proc_save/restore_context are
    # updated to read/write these new offsets.
    store8(p + off, 0x53); off = off + 1;  # push rbx
    store8(p + off, 0x55); off = off + 1;  # push rbp
    store8(p + off, 0x41); store8(p + off + 1, 0x54); off = off + 2;  # push r12
    store8(p + off, 0x41); store8(p + off + 1, 0x55); off = off + 2;  # push r13
    store8(p + off, 0x41); store8(p + off + 1, 0x56); off = off + 2;  # push r14
    store8(p + off, 0x41); store8(p + off + 1, 0x57); off = off + 2;  # push r15

    # rdi = rsp (pass stack pointer as first arg to timer_handler)
    # mov rdi, rsp (48 89 E7)
    store8(p + off, 0x48); store8(p + off + 1, 0x89); store8(p + off + 2, 0xE7); off = off + 3;

    # call timer_handler: mov rax, imm64; call rax
    # mov rax, handler_addr (48 B8 imm64)
    store8(p + off, 0x48); store8(p + off + 1, 0xB8); off = off + 2;
    store64(p + off, handler_addr); off = off + 8;
    # call rax (FF D0)
    store8(p + off, 0xFF); store8(p + off + 1, 0xD0); off = off + 2;

    # Pop callee-saved first (reverse of push): r15 r14 r13 r12 rbp rbx
    store8(p + off, 0x41); store8(p + off + 1, 0x5F); off = off + 2;  # pop r15
    store8(p + off, 0x41); store8(p + off + 1, 0x5E); off = off + 2;  # pop r14
    store8(p + off, 0x41); store8(p + off + 1, 0x5D); off = off + 2;  # pop r13
    store8(p + off, 0x41); store8(p + off + 1, 0x5C); off = off + 2;  # pop r12
    store8(p + off, 0x5D); off = off + 1;  # pop rbp
    store8(p + off, 0x5B); off = off + 1;  # pop rbx

    # Pop caller-saved: r11 r10 r9 r8 rdi rsi rdx rcx rax (reverse of push)
    store8(p + off, 0x41); store8(p + off + 1, 0x5B); off = off + 2;  # pop r11
    store8(p + off, 0x41); store8(p + off + 1, 0x5A); off = off + 2;  # pop r10
    store8(p + off, 0x41); store8(p + off + 1, 0x59); off = off + 2;  # pop r9
    store8(p + off, 0x41); store8(p + off + 1, 0x58); off = off + 2;  # pop r8
    store8(p + off, 0x5F); off = off + 1;  # pop rdi
    store8(p + off, 0x5E); off = off + 1;  # pop rsi
    store8(p + off, 0x5A); off = off + 1;  # pop rdx
    store8(p + off, 0x59); off = off + 1;  # pop rcx
    store8(p + off, 0x58); off = off + 1;  # pop rax
    # iretq
    store8(p + off, 0x48); store8(p + off + 1, 0xCF);
    return 0;
}

# 1.51.6 — one-shot RX-interrupt "LIVE" latch. The vector-0x50 ISR (nic_rx_handler)
# sets nic_rx_irq_seen on its FIRST delivery — a safe single-word write; NO print in
# interrupt context. net_poll() (non-ISR) prints the LIVE line exactly once. This is the
# DISPOSITIVE proof the NIC RX MSI/MSI-X actually FIRES on silicon: on iron the r8169 MSI
# path never runs in QEMU (virtio there), and both the 1.51.3 busy-poll and the 100 Hz
# timer-tick drain would otherwise mask a dead MSI (working-net ≠ MSI-fired). It's a
# permanent product log line (the always-on `pmm: bitmap-dm OK` guard is the precedent),
# not throwaway burn instrumentation.
var nic_rx_irq_seen = 0;
var nic_rx_irq_printed = 0;

# 1.51.5 — NIC RX MSI-X interrupt handler. Same body the 100 Hz timer tick runs
# (net_rx_drain), but triggered by the NIC on packet arrival so a blocked hlt wakes
# immediately instead of on the next tick — the proper fix for the tick-paced net
# latency floor (obsoletes the 1.51.3 busy-poll for the common case). Self-guarded
# (net_rx_lock trylock); it may TRANSMIT replies under the IRQ-saved net locks (1.57.7 S4 —
# net_rx_drain_isr's contract), and NEVER schedules — it only WAKES: since 1.57.7 (S6) a
# demuxed ACK / SYN-ACK / RST / echo reply wakes the #47/#48/#55/#100 caller BLOCKED on it
# (wq_wake after the net locks are released; the kick reaches a halted CPU). nic_ready() gates net_rx_drain to
# a no-op before the NIC is up. LAPIC-EOI (MSI-X delivers via the LAPIC).
fn nic_rx_handler() {
    preempt_disable();                                 # 1.57.6 (S3.2): an ISR body is non-preemptible (see timer_handler)
    # r8169 (iron) needs a device-side W1C ISR ack BEFORE the drain so the chip
    # re-arms and can post the next edge MSI — ack-then-drain (1.51.6). No-op when
    # r8169 is absent (QEMU/virtio: r8169_present==0 → returns immediately, no MMIO),
    # so the virtio-net MSI-X path is untouched (its used/avail ring self-re-arms).
    r8169_irq_ack();
    net_rx_drain_isr();
    nic_rx_irq_seen = 1;   # latch — this ISR only runs on a real MSI/MSI-X delivery; printed once from net_poll (non-ISR)
    preempt_enable();
    apic_eoi();
    return 0;
}

# Build the NIC RX ISR stub (machine code) into nic_rx_isr. Mirrors timer_isr_build
# EXACTLY (15-register push → 16-byte-aligned call, the proven layout) minus the
# `mov rdi,rsp` (nic_rx_handler takes no arg) and the do_context_switch (no schedule).
fn nic_rx_isr_build() {
    var p = &nic_rx_isr;
    var handler_addr = &nic_rx_handler;
    var off = 0;
    # 1.57.7 (S3.4) — clac FIRST: no inputs/outputs; clears RFLAGS.AC. Hardware does not clear AC on interrupt
    # delivery, so without it this ISR body would run with SMAP OFF whenever it lands on ring 3 that set AC with
    # popf, or inside a syscall after the entry stub's stac. The saved RFLAGS keeps the interrupted AC; iretq
    # restores it. (kstack-smoke's "isr clac" phase checks every gate's first three bytes.)
    store8(p + off, 0x0F); store8(p + off + 1, 0x01); store8(p + off + 2, 0xCA); off = off + 3;   # clac
    # caller-saved: rax rcx rdx rsi rdi r8 r9 r10 r11
    store8(p + off, 0x50); off = off + 1;  # push rax
    store8(p + off, 0x51); off = off + 1;  # push rcx
    store8(p + off, 0x52); off = off + 1;  # push rdx
    store8(p + off, 0x56); off = off + 1;  # push rsi
    store8(p + off, 0x57); off = off + 1;  # push rdi
    store8(p + off, 0x41); store8(p + off + 1, 0x50); off = off + 2;  # push r8
    store8(p + off, 0x41); store8(p + off + 1, 0x51); off = off + 2;  # push r9
    store8(p + off, 0x41); store8(p + off + 1, 0x52); off = off + 2;  # push r10
    store8(p + off, 0x41); store8(p + off + 1, 0x53); off = off + 2;  # push r11
    # callee-saved: rbx rbp r12 r13 r14 r15 (→ 15 pushes, matches timer's alignment)
    store8(p + off, 0x53); off = off + 1;  # push rbx
    store8(p + off, 0x55); off = off + 1;  # push rbp
    store8(p + off, 0x41); store8(p + off + 1, 0x54); off = off + 2;  # push r12
    store8(p + off, 0x41); store8(p + off + 1, 0x55); off = off + 2;  # push r13
    store8(p + off, 0x41); store8(p + off + 1, 0x56); off = off + 2;  # push r14
    store8(p + off, 0x41); store8(p + off + 1, 0x57); off = off + 2;  # push r15
    # call nic_rx_handler: mov rax, imm64; call rax
    store8(p + off, 0x48); store8(p + off + 1, 0xB8); off = off + 2;
    store64(p + off, handler_addr); off = off + 8;
    store8(p + off, 0xFF); store8(p + off + 1, 0xD0); off = off + 2;  # call rax
    # pop callee-saved: r15 r14 r13 r12 rbp rbx
    store8(p + off, 0x41); store8(p + off + 1, 0x5F); off = off + 2;  # pop r15
    store8(p + off, 0x41); store8(p + off + 1, 0x5E); off = off + 2;  # pop r14
    store8(p + off, 0x41); store8(p + off + 1, 0x5D); off = off + 2;  # pop r13
    store8(p + off, 0x41); store8(p + off + 1, 0x5C); off = off + 2;  # pop r12
    store8(p + off, 0x5D); off = off + 1;  # pop rbp
    store8(p + off, 0x5B); off = off + 1;  # pop rbx
    # pop caller-saved: r11 r10 r9 r8 rdi rsi rdx rcx rax
    store8(p + off, 0x41); store8(p + off + 1, 0x5B); off = off + 2;  # pop r11
    store8(p + off, 0x41); store8(p + off + 1, 0x5A); off = off + 2;  # pop r10
    store8(p + off, 0x41); store8(p + off + 1, 0x59); off = off + 2;  # pop r9
    store8(p + off, 0x41); store8(p + off + 1, 0x58); off = off + 2;  # pop r8
    store8(p + off, 0x5F); off = off + 1;  # pop rdi
    store8(p + off, 0x5E); off = off + 1;  # pop rsi
    store8(p + off, 0x5A); off = off + 1;  # pop rdx
    store8(p + off, 0x59); off = off + 1;  # pop rcx
    store8(p + off, 0x58); off = off + 1;  # pop rax
    # iretq
    store8(p + off, 0x48); store8(p + off + 1, 0xCF);
    return 0;
}

# 1.53.7 — xHCI RX (USB-HID keyboard) MSI-X interrupt. The DIRECT analog of the NIC
# RX-IRQ fix (1.51.5): the same body the 100 Hz timer tick runs (hid_poll — drain the
# xHCI event ring, diff the HID report, push scancodes to kb_buf, re-arm the TRB), but
# triggered by the controller on report DMA so a blocked hlt wakes immediately instead of
# on the next ~10 ms tick. hid_poll is RX-only, self-guarded (hid_poll_lock atomic try-lock), issues
# ⚠ THAT USED TO SAY "input_lock, cli-first" AND IT WAS FALSE. `input_lock` is taken only by
# `hid_kb_push` and `kb_read_scancode`, and guards `kb_buf` alone — it never covered the event-ring
# dequeue or the mouse accumulator that `hid_poll` also touches, and `cli` on one CPU does not exclude
# this handler running on another. hid_poll now owns a real `xchg` try-lock; the claim is true as of
# 1.56.42. A comment asserting a lock that does not exist is worse than no comment at all, because the
# next reader stops looking. [[feedback_audit_re_derive_dont_validate_comments]]
# no TX and NEVER schedules — safe in interrupt context (keyboard.cyr:47-50 anticipates this).
# MUST only be ARMED after enumeration (the MSI-X vector stays masked until post
# hid_kbd_configure) so this hid_poll can't steal EP0 Transfer Events from the synchronous
# xhci_wait_transfer_event EP0 consumer used during control transfers. LAPIC-EOI (MSI-X via LAPIC).
fn xhci_rx_handler() {
    preempt_disable();        # 1.57.6 (S3.2): an ISR body is non-preemptible (see timer_handler)
    hid_poll();               # drain the event ring + W1C IMAN.IP (re-arm, 1.53.14) + ERDP.EHB
    preempt_enable();
    apic_eoi();
    return 0;
}

# Build the xHCI RX ISR stub into xhci_rx_isr. Byte-for-byte clone of nic_rx_isr_build
# (15-register push -> 16-byte-aligned call -> 15-register pop -> iretq; no `mov rdi,rsp`
# since xhci_rx_handler takes no arg, no do_context_switch since it never schedules).
fn xhci_rx_isr_build() {
    var p = &xhci_rx_isr;
    var handler_addr = &xhci_rx_handler;
    var off = 0;
    # 1.57.7 (S3.4) — clac FIRST: no inputs/outputs; clears RFLAGS.AC. Hardware does not clear AC on interrupt
    # delivery, so without it this ISR body would run with SMAP OFF whenever it lands on ring 3 that set AC with
    # popf, or inside a syscall after the entry stub's stac. The saved RFLAGS keeps the interrupted AC; iretq
    # restores it. (kstack-smoke's "isr clac" phase checks every gate's first three bytes.)
    store8(p + off, 0x0F); store8(p + off + 1, 0x01); store8(p + off + 2, 0xCA); off = off + 3;   # clac
    # caller-saved: rax rcx rdx rsi rdi r8 r9 r10 r11
    store8(p + off, 0x50); off = off + 1;  # push rax
    store8(p + off, 0x51); off = off + 1;  # push rcx
    store8(p + off, 0x52); off = off + 1;  # push rdx
    store8(p + off, 0x56); off = off + 1;  # push rsi
    store8(p + off, 0x57); off = off + 1;  # push rdi
    store8(p + off, 0x41); store8(p + off + 1, 0x50); off = off + 2;  # push r8
    store8(p + off, 0x41); store8(p + off + 1, 0x51); off = off + 2;  # push r9
    store8(p + off, 0x41); store8(p + off + 1, 0x52); off = off + 2;  # push r10
    store8(p + off, 0x41); store8(p + off + 1, 0x53); off = off + 2;  # push r11
    # callee-saved: rbx rbp r12 r13 r14 r15 (-> 15 pushes, matches timer's alignment)
    store8(p + off, 0x53); off = off + 1;  # push rbx
    store8(p + off, 0x55); off = off + 1;  # push rbp
    store8(p + off, 0x41); store8(p + off + 1, 0x54); off = off + 2;  # push r12
    store8(p + off, 0x41); store8(p + off + 1, 0x55); off = off + 2;  # push r13
    store8(p + off, 0x41); store8(p + off + 1, 0x56); off = off + 2;  # push r14
    store8(p + off, 0x41); store8(p + off + 1, 0x57); off = off + 2;  # push r15
    # call xhci_rx_handler: mov rax, imm64; call rax
    store8(p + off, 0x48); store8(p + off + 1, 0xB8); off = off + 2;
    store64(p + off, handler_addr); off = off + 8;
    store8(p + off, 0xFF); store8(p + off + 1, 0xD0); off = off + 2;  # call rax
    # pop callee-saved: r15 r14 r13 r12 rbp rbx
    store8(p + off, 0x41); store8(p + off + 1, 0x5F); off = off + 2;  # pop r15
    store8(p + off, 0x41); store8(p + off + 1, 0x5E); off = off + 2;  # pop r14
    store8(p + off, 0x41); store8(p + off + 1, 0x5D); off = off + 2;  # pop r13
    store8(p + off, 0x41); store8(p + off + 1, 0x5C); off = off + 2;  # pop r12
    store8(p + off, 0x5D); off = off + 1;  # pop rbp
    store8(p + off, 0x5B); off = off + 1;  # pop rbx
    # pop caller-saved: r11 r10 r9 r8 rdi rsi rdx rcx rax
    store8(p + off, 0x41); store8(p + off + 1, 0x5B); off = off + 2;  # pop r11
    store8(p + off, 0x41); store8(p + off + 1, 0x5A); off = off + 2;  # pop r10
    store8(p + off, 0x41); store8(p + off + 1, 0x59); off = off + 2;  # pop r9
    store8(p + off, 0x41); store8(p + off + 1, 0x58); off = off + 2;  # pop r8
    store8(p + off, 0x5F); off = off + 1;  # pop rdi
    store8(p + off, 0x5E); off = off + 1;  # pop rsi
    store8(p + off, 0x5A); off = off + 1;  # pop rdx
    store8(p + off, 0x59); off = off + 1;  # pop rcx
    store8(p + off, 0x58); off = off + 1;  # pop rax
    # iretq
    store8(p + off, 0x48); store8(p + off + 1, 0xCF);
    return 0;
}
