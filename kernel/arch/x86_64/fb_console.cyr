# === Framebuffer text console (Phase 2 of fb.cyr) ===
#
# Companion to fb.cyr's cp_fb() cell grid. Where cp_fb paints colored
# marker cells at fixed positions for boot-progress diagnostics, this
# module renders 8x16 glyph text in a scrolling region below the cell
# grid. Required for iron-MVP (typeable shell on hardware without a
# serial cable).
#
# Layout (v1.30.1: simplified — kernel boots reliably enough that the
# stage-bisection apparatus came down):
#   y =   0..    text console (this module). 8x16 glyphs, software scroll.
#
# Prior layouts kept rows reserved for a boot_shim canary stripe and the
# cp_fb marker-cell grid; both are gone. The full-screen clear at the
# top of `fb_console_init()` also wipes whatever gnoboot painted on its
# way out (gnoboot's `efi_clear` + handoff banner) so the kernel log is
# the only thing on the framebuffer once shell comes up.
#
# Font: IBM VGA BIOS 8x16 ROM font (public domain, IBM 1981; same byte
# table Linux's lib/fonts/font_8x16.c carries). Covers CP437 0x20..0xFF plus kashi's
# extension cells (U+2026, U+FFFD) since kashi 1.1.0. Each glyph is 16 bytes top-to-bottom;
# bit 7 = leftmost pixel of that row. As of agnos 1.37.5 the glyph data
# + accessors live in the **kashi** freestanding font-data core
# (`../kashi/src/font_data.cyr`, pulled via `[deps.kashi]` in cyrius.cyml);
# this module only renders. `kashi_font_init()` populates kashi's BSS once
# from packed u64 literals, then per-glyph render queries `kashi_glyph_ptr`/
# `kashi_glyph_row` against `KASHI_FONT_VGA_8X16`. Cell dimensions stay
# non-square: cell_w = 8*scale, cell_h = 16*scale. The 8x16 source replaced
# the hand-drawn 8x8 CGA bitmap because at 2K+ native HDMI the 8x8 source
# was illegible (~0.55% of screen height per row at 1440p); the 8x8 table
# is retained in kashi (`KASHI_FONT_CGA_8X8`) for future low-res / dense-grid
# uses but agnos's kernel console doesn't render it.
#
# Color: white foreground on black background by default (SGR changes both, since 1.43.1). Both pixels are
# painted per glyph cell (no transparency) so the console area paints fully even over whatever the UEFI firmware
# left there.
#
# 1.57.18 — the console is a terminal for full-screen programs (issue 2026-11-06-the-console-is-short-of-a-terminal):
# UTF-8 through kashi's CP437 cells (kashi_cp437_from_unicode; one U+FFFD cell where there is none), EL / ED in the
# active background, a drawn cursor (?25h / ?25l), 32 CSI parameters, SGR 7 / 27, OSC / DCS / APC / PM / SOS
# swallowed, Tab, the last-column pending wrap and DECAWM — agnos-userland-abi.md's "console escape support" table.
# The scroll is `rep movsq` through the RAM shadow, and the framebuffer is really write-combined (vmm.cyr
# pat_init_cpu): 194 ms -> ~2 ms per scrolled line at 2048x2048 under KVM.
#
# Geometry comes from boot_info (Path C struct) every fb_putc call —
# kept dynamic because cold boots can reassign the GOP BAR between burns.
#   boot_info + 0x48 (u64) = fb_phys
#   boot_info + 0x50 (u32) = fb_pitch  (bytes per scanline)
#   boot_info + 0x54 (u32) = fb_width  (pixels)
#   boot_info + 0x58 (u32) = fb_height (pixels)
#
# Must be included AFTER fb.cyr (uses boot_info_ptr) and BEFORE
# kprint.cyr (which wraps fb_putc into the kernel-wide print API).
# Ordering enforced by kernel/agnos.cyr include order.

# Glyph BSS + per-glyph init lives in kashi (1.37.5 fold-in). Accessors used:
#   kashi_font_init()                          # called once below
#   kashi_glyph_ptr(KASHI_FONT_VGA_8X16, ch)   # base of 16 row bytes for `ch`
var fb_cur_x = 0;        # cursor column (in 8*scale-px cells from x=0)
var fb_cur_y = 0;        # cursor row (in 16*scale-px cells from FB_CONSOLE_Y0)
var fb_console_ready = 0;
# 1.53.7 — kernel-private WB RAM shadow buffer (0 = none → every writer keeps its
# original direct-to-WC-FB path). When set (fb_shadow_init succeeds post-pmm), each
# writer MIRRORS its pixels here at the SAME byte offset (shadow uses the FB pitch),
# so fb_scroll_up becomes a pure RAM memmove + one WRITE-ONLY flush instead of
# reading the WC framebuffer back (~1M uncached WC loads/newline at 1080p).
# ⛔ 1.57.9 (CPUVA) — fb_shadow is the run's DIRECT-MAP pointer (dma_kva), never its phys.
# It was phys == VA "because every CR3 maps the 0-256 MB identity window", and that was
# the false premise: under a per-process CR3, PD[2..127] is where the loader puts the
# ring-3 PT_LOADs, so fb_putc on the write(1,..) path painted into the process's pages
# and scrolled the process's bytes onto the screen. See fb_shadow_init.
var fb_shadow = 0;
var fb_shadow_size = 0;  # bytes reserved (n * 2 MB); 0 until fb_shadow_init succeeds

# P4 console-redirect (2026-07-20): 0 = paint the GOP framebuffer (default, unchanged). Nonzero = paint THIS
# agnos-owned linear buffer instead, which the GPU scanout has been re-pointed at. The GOP's own console
# surface bands on this box (register-truth proved it's surface-specific, not scan-geometry — an agnos buffer
# scans band-free); redirecting fb_console's paint base to that buffer is the fix. Set via fb_set_scanout_base.
var fb_scanout_base = 0;

# Write one byte to the CMOS extended bank (slots 0x80..0xFF, addressed
# via port pair 0x72=index / 0x73=data). The hardware index is the
# logical slot minus 0x80 per the CC fix 2026-05-17 documented in
# agnosticos/scripts/src/read-boot-log.cyr.
#
# Used by fb_console_init to stamp FB geometry to virgin scratch
# (0x90..0x9F) for post-mortem decode via read-boot-log on iron (no
# serial). Standard-bank writes use raw asm + 0xE6/0x71 inline (see
# boot_shim.cyr's checkpoint pattern); extended-bank needs the offset
# math, so it's worth a helper.
fn cmos_ext_write(slot, val) {
    outb(0x72, slot - 0x80);
    outb(0x73, val);
    return 0;
}

fn fb_console_init() {
    # Boot-time diagnostic: log the GOP geometry that gnoboot captured
    # from firmware. Three purposes:
    #   1. Ground truth on mode parameters when the FB itself may be
    #      garbled (post-mortem from serial / read-boot-log captures).
    #   2. Confirms boot_info pointer is alive and fb_present is set.
    #   3. First diagnostic for vendor-specific FB-handoff bugs (e.g.
    #      the AMD Zen quiet-boot scanout residue per memory pin
    #      project_amd_zen_scanout_residue): pf / pitch / geometry /
    #      mode reported here is what differentiates "firmware leaves
    #      scanout linear" from "firmware leaves scanout tiled/DCC".
    var diag_phys  = fb_fb_phys();
    var diag_pf    = fb_pf();
    var diag_w     = fb_width();
    var diag_h     = fb_height();
    var diag_pitch = fb_pitch();
    var diag_mode  = fb_mode_current();
    var diag_mmax  = fb_mode_max();
    var diag_size  = fb_fb_size();
    serial_print("fb: mode=", 9);
    kfmt_int(diag_mode);
    serial_print("/", 1);
    kfmt_int(diag_mmax);
    serial_print(" phys=", 6);
    kfmt_hex0x(diag_phys);
    serial_print(" pf=", 4);
    kfmt_int(diag_pf);
    serial_print(" w=", 3);
    kfmt_int(diag_w);
    serial_print(" h=", 3);
    kfmt_int(diag_h);
    serial_print(" pitch=", 7);
    kfmt_int(diag_pitch);
    serial_print(" size=", 6);
    kfmt_hex0x(diag_size);
    serial_println("", 0);

    # ⭐ ALSO to the klug ring (2026-08-03). The block above is serial-ONLY, and archaemenid has NO
    # serial channel — the build host IS the target. So on the box this diagnostic actually matters
    # on, the `fb:` line has never once been readable: it is absent from every iron spill while being
    # the FIRST line in every QEMU log. That is exactly backwards, because this is the line that says
    # whether the console started at the SURFACE geometry or the OUTPUT geometry — the difference
    # between a clean early boot and the sheared text the 2026-08-03 burn photographed.
    # ⛔ EVERY FIELD IS HEX AND LABELLED 0x. Without the prefix `w=800` reads as 800 decimal — which is
    # precisely the wrong-geometry value being hunted on this box, so an unprefixed hex 0x800 (=2048)
    # would look like a confirmed fault. Do not remove the prefixes.
    # klug is a kernel-resident ring readable after the fact with `run /bin/klug > /f.txt`, and it is
    # pure store8 + integer math, safe this early (same property the #PF recorder relies on).
    var fbk[24];   # 1.56.52: fmt_hex_buf writes 17 B (16 digits + NUL) — [16] was a 1-byte OOB stack write
    var fbn = 0;
    klug_append("fb: w=0x", 8);
    fbn = fmt_hex_buf(diag_w, &fbk);      klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_append(" h=0x", 5);
    fbn = fmt_hex_buf(diag_h, &fbk);      klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_append(" pitch=0x", 9);
    fbn = fmt_hex_buf(diag_pitch, &fbk);  klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_append(" phys=0x", 8);
    fbn = fmt_hex_buf(diag_phys, &fbk);   klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_append(" size=0x", 8);
    fbn = fmt_hex_buf(diag_size, &fbk);   klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_append(" mode=0x", 8);
    fbn = fmt_hex_buf(diag_mode, &fbk);   klug_append(&fbk, fbn);
    if (fbn == 0) { klug_append("0", 1); }
    klug_putc(10);

    # Mirror the geometry to CMOS extended-bank scratch [0x90..0x9F] so
    # post-mortem read-boot-log can recover it on iron (single-machine
    # archaemenid setup, no serial cable). 16 contiguous bytes, virgin
    # range (standard bank 0x50-0x7F is full of checkpoints / PMM / xhci
    # stamps; extended bank 0x80-0xFF only uses 0x86 today). Layout:
    #   [0x90..0x93] fb_width  (u32 LE)
    #   [0x94..0x97] fb_height (u32 LE)
    #   [0x98..0x9B] fb_pitch  (u32 LE)
    #   [0x9C]       fb_pf     (u8 — pixel format enum)
    #   [0x9D]       fb_mode_current low byte
    #   [0x9E]       fb_mode_max     low byte
    #   [0x9F]       0xFB sentinel (kernel reached fb_console_init)
    # Extended bank addressed by port pair 0x72 (index) / 0x73 (data);
    # index is `slot - 0x80`. Width/height/pitch typically fit comfortably
    # in their low 16 bits (max ~8192 px / ~32 KB) so we don't dedicate
    # diagnostics for the upper halves — if any read back nonzero, the
    # detail will show up in serial anyway.
    cmos_ext_write(0x90, diag_w & 0xFF);
    cmos_ext_write(0x91, (diag_w >> 8) & 0xFF);
    cmos_ext_write(0x92, (diag_w >> 16) & 0xFF);
    cmos_ext_write(0x93, (diag_w >> 24) & 0xFF);
    cmos_ext_write(0x94, diag_h & 0xFF);
    cmos_ext_write(0x95, (diag_h >> 8) & 0xFF);
    cmos_ext_write(0x96, (diag_h >> 16) & 0xFF);
    cmos_ext_write(0x97, (diag_h >> 24) & 0xFF);
    cmos_ext_write(0x98, diag_pitch & 0xFF);
    cmos_ext_write(0x99, (diag_pitch >> 8) & 0xFF);
    cmos_ext_write(0x9A, (diag_pitch >> 16) & 0xFF);
    cmos_ext_write(0x9B, (diag_pitch >> 24) & 0xFF);
    cmos_ext_write(0x9C, diag_pf & 0xFF);
    cmos_ext_write(0x9D, diag_mode & 0xFF);
    cmos_ext_write(0x9E, diag_mmax & 0xFF);
    cmos_ext_write(0x9F, 0xFB);

    # FB-absent guard. No GOP at handoff (text-only firmware, headless
    # server, or LocateProtocol failure in gnoboot) leaves fb_phys = 0
    # and pf = 0 in boot_info — the pf > 1 guard below does NOT catch
    # that case (0 > 1 is false), and we'd otherwise fall through and
    # set fb_console_ready = 1, lying to upper-layer routing about an
    # FB console being live. Downstream paint ops all early-return on
    # fb_phys == 0 (so no segfault), but the readiness signal needs to
    # be honest. Set ready=0 and bail.
    if (diag_phys == 0) {
        serial_println("fb: no framebuffer present, serial-only console", 47);
        fb_console_ready = 0;
        return 0;
    }

    # No MTRR-WC install here. PAT-based WC mapping (vmm_remap_wc_2mb,
    # called from kernel/core/main.cyr) is the cache-typing path. A
    # prior MTRR install attempt on archaemenid Quiet Boot triggered
    # #GP via AMD SYS_CFG_MSR MtrrLock — wrmsr to MTRR PHYSBASE/PHYSMASK
    # is unsafe post-firmware-init on locked-down platforms. PAT bits
    # in the leaf PTE are the modern equivalent and don't require MSR
    # writes. See fb_verify_wc() for the PAT-state confirmation gate.

    # PixelFormat guard. EFI_GRAPHICS_PIXEL_FORMAT values:
    #   0 = PixelRedGreenBlueReserved8BitPerColor (RGBX 32bpp)
    #   1 = PixelBlueGreenRedReserved8BitPerColor (BGRX 32bpp) ← what
    #       the kernel's monochrome glyph paint implicitly assumes
    #   2 = PixelBitMask (custom layout via PixelInformation bitmask)
    #   3 = PixelBltOnly (no direct framebuffer — Blt() service only)
    # White (0x00FFFFFF) and black (0x00000000) are symmetric in those
    # channels under both RGBX and BGRX — so pf == 0 is safe for the
    # current text console too. PixelBitMask / BltOnly are NOT safe:
    # bit layout is firmware-defined, or direct writes are silently
    # ignored. Refuse to paint, fall to serial-only console with a
    # warning. Linux ref: drivers/video/fbdev/efifb.c rejects modes
    # outside the two 8-bit-per-channel-with-reserved formats.
    if (diag_pf > 1) {
        serial_println("fb: WARN unsupported PixelFormat, FB paint disabled, serial-only console", 72);
        fb_console_ready = 0;
        return 0;
    }

    # Full-screen clear before any glyphs render. Gnoboot calls
    # `efi_clear(st)` pre-banner and then prints its handoff line, so
    # row 0 of the framebuffer carries firmware-font text on entry; the
    # kernel's first 8-px-glyph row would otherwise overlay that line.
    # One linear sweep of the framebuffer paints over both gnoboot's
    # banner and any residual UEFI logo.
    #
    # Pitch-aware extent: inner loop walks `pitch / 4` u32s per row, not
    # `width`. When PixelsPerScanLine > HorizontalResolution (firmware
    # pads scanlines for alignment), the padding u32s carry stale
    # firmware paint forever otherwise — invisible behind the arcade
    # cabinet bezel on archaemenid but real and right-edge-visible on
    # QEMU / direct-attach displays.
    #
    # Cost at 1080p with pitch=7680 bytes: 1920 u32 writes per row × 1080
    # rows = ~2.07M store32. WC-mapped (per vmm_remap_wc_range called
    # from core/main.cyr before this init) these burst to the controller
    # without paying WB cache eviction artifacts.
    var fb_clr = fb_fb_phys();
    if (fb_clr != 0) {
        var pitch_clr  = fb_pitch();
        var height_clr = fb_height();
        # u64 block-zero: 2 pixels per qword. pitch is 8-aligned at 1080p (7680 = 8*960); a non-8-aligned
        # pitch would leave 4-7 bytes per row dirty (right-edge), same failure mode as a non-4-aligned pitch
        # under the prior u32 loop. 1.57.18: one `rep stosq` per scanline (fb_stosq; the bulk-store banner).
        var stride_u64 = pitch_clr / 8;
        for (var py = 0; py < height_clr; py = py + 1) {
            fb_stosq(fb_clr + py * pitch_clr, 0, stride_u64);
        }
    }
    # Glyph data lives in kashi (1.37.5 fold-in). One init populates kashi's
    # BSS for both VGA 8x16 and CGA 8x8 from the packed u64 literals; agnos
    # only renders the 8x16 face via kashi_glyph_ptr below.
    kashi_font_init();
    fb_cur_x = 0;
    fb_cur_y = 0;
    fb_console_ready = 1;
    # 1.56.37: hold the PANEL until the geometry is verified against hardware. boot_info reports the
    # display OUTPUT (2560x1440), which on this box is NOT the surface DCN scans (800x600 pitch 832), so
    # every line drawn before gpu_scanout_matchgeom smears. serial and klug are unaffected — only the draw
    # waits, and the release replays the ring. fb_defer_rescue in main.cyr guarantees the wait ends.
    fb_defer_begin();
    # 1.45.16: stash the FB base for the idt.cyr CPU-exception fault-bar (it runs
    # in a raw asm stub that can't call fb_fb_phys()). 0 until here → the stub's
    # null-guard skips the paint, so an early-boot fault still just CMOS-stamps.
    fb_dbg_phys = fb_fb_phys();
    # PAT-state confirmation is deferred to fb_verify_wc(), called from
    # kernel/core/main.cyr AFTER pmm_init returns. The early WC remap
    # at main.cyr line 17 takes effect immediately for FBs in the 32-bit
    # hole (iron archaemenid <1GB path = inline PDE rewrite at 0x3000)
    # but needs pmm_alloc for the >=1GB path (QEMU q35 places the FB BAR
    # at 0x80000000 = 2GB). pmm isn't ready at line 17. Verifying WC
    # before the post-pmm_init retry would false-WARN on q35 and on any
    # future iron target with a high FB BAR. Single authoritative line
    # emitted post-retry.
    return 0;
}

# Verify the framebuffer is WC-mapped by reading back the controlling
# cache-mapping leaf entry (2MB PDE or 1GB PDPT entry, depending on
# whether vmm_remap_wc_2mb shattered the page) and decoding its PAT
# bits against the firmware-default PAT MSR. Called from
# kernel/core/main.cyr after pmm_init + the post-pmm WC remap retry.
# Logs one line: either `fb: WC verified (PAT entry 1)` (the green
# gate) or a WARN with the actual PAT entry index and the raw PDE
# bytes so iron post-mortem can tell silent-WC-drop from accessor-
# coverage-miss. Linux ref: arch/x86/mm/pat.c.
fn fb_verify_wc() {
    var phys = fb_fb_phys();
    if (phys == 0) { return 0; }
    var pde = vmm_get_pde_2mb(phys);
    # PAT-index = PWT(bit3) | PCD(bit4)<<1 | PAT-page(bit12)<<2
    var pat_idx = ((pde >> 3) & 1) | (((pde >> 4) & 1) << 1) | (((pde >> 12) & 1) << 2);
    # ⛔ 1.57.18 — THE INDEX ALONE NEVER PROVED WC. This line printed "WC verified" for years while PAT entry 1 held the
    # firmware's 0x04 = WT (vmm.cyr pat_init_cpu). Decode the entry's TYPE from the live MSR too.
    var pat_ty = (rdmsr(0x277) >> (pat_idx * 8)) & 0xFF;
    if (pat_idx == 1 && pat_ty == 1) {
        serial_println("fb: WC verified (PAT entry 1)", 29);
        serial_print("fb: PAT entry 1 = 0x01 WC (firmware PAT ", 40);
        kfmt_hex0x(pat_fw_value);
        serial_println(")", 1);
    } elif (pat_idx == 1) {
        serial_print("fb: WARN PAT entry 1 is type ", 29);
        kfmt_hex0x(pat_ty);
        serial_println(", not 0x01 WC -- framebuffer stores are not write-combined", 58);
    } else {
        serial_print("fb: WARN expected PAT entry 1 (WC), got entry ", 46);
        kfmt_int(pat_idx);
        serial_print(" PDE=", 5);
        kfmt_hex0x(pde);
        serial_println("", 0);
    }
    return 0;
}

# 1.53.7 — allocate the kernel-private WB RAM shadow buffer that backs the text
# console, killing the WC framebuffer READ-BACK on every scroll. Called ONCE from
# kernel/core/main.cyr, after pmm_init + the post-pmm WC-remap retry + fb_verify_wc
# (the one-time read-back sync below must copy the real WC console image).
#
# Model: Linux simpledrm / BSD rasops CPU-shadow. Sized to pitch*height rounded up
# to whole 2 MB regions and allocated as one contiguous top-down run
# (pmm_alloc_2mb_run).
#
# ⛔ 1.57.9 (CPUVA) — THE STORED POINTER IS THE DIRECT-MAP ALIAS (dma_kva), not the phys.
# fb_putc runs on the syscall path under the CALLER's CR3, and a per-process CR3 gives
# PD[2..127] = [4 MB, 256 MB) — the whole pool this run comes from — to the ring-3 image
# (elf.cyr). The phys == VA shadow was therefore the PROCESS's page there: glyph stores
# corrupted it (and leaked console text into it), the scroll copied its bytes onto the
# screen, and with the loader's US=1 PDEs a CPL0 access was a SMAP #PF ring 3 could
# trigger. The direct map (kernel PDPT[8+]) is mirrored into every CR3 and no user
# mapping reaches it (Linux page_address / FreeBSD PHYS_TO_DMAP). The phys is kept
# nowhere: nothing but the CPU ever touches this buffer. ⚠ ORDERING: the alias is live
# only after cr3_load(0x1000) + pmm_bitmap_use_directmap() (CLAUDE.md) — main.cyr calls
# this after them; a KEEP_GNOBOOT build gets phys == VA from dma_kva, as it always did.
#
# FALLBACK: FB absent, paint-disabled, or alloc failure (headless / low-RAM /
# fragmented pool) leaves fb_shadow = 0 and every writer keeps its original
# direct-to-FB path — the console degrades to today's behavior, never breaks.
fn fb_shadow_init() {
    var phys = fb_fb_phys();
    if (phys == 0) { return 0; }               # no framebuffer → nothing to shadow
    if (fb_console_ready == 0) { return 0; }   # FB paint disabled (bad pf) → skip
    var pitch  = fb_pitch();
    var height = fb_height();
    var need = pitch * height;
    if (need <= 0) { return 0; }
    # Round the frame byte-size up to whole 2 MB regions.
    var n = (need + 0x1FFFFF) / 0x200000;
    var base = pmm_alloc_2mb_run(n);
    if (base == 0) {
        serial_println("fb: shadow alloc failed, direct-paint (scroll reads WC FB)", 58);
        return 0;
    }
    # Boot assert (1.57.9): the stored pointer must lie in the direct map, the only alias
    # every CR3 shares. Refuse the shadow rather than store an address a per-proc CR3 can own.
    var kva = dma_kva(base);
    if (dma_kva_ok(kva) == 0) {
        serial_println("fb: shadow KVA outside the direct map, direct-paint", 51);
        return 0;
    }
    # One-time sync: copy the current FB image (boot log already painted) into the
    # shadow so the first post-init scroll's flush is consistent with what's on
    # screen. This is the ONLY WC read-back the shadow ever performs — one frame, at
    # boot. u64 block copy (2 px/cycle); ceil to cover a non-8-aligned frame tail
    # (the extra <=7 B stay within the FB's 2 MB-aligned WC region). The FB side is
    # device memory at its identity VA (PDPT[2..3], mirrored into every CR3).
    var words = (need + 7) / 8;
    fb_movsq(kva, phys, words);
    fb_shadow = kva;
    fb_shadow_size = n * 0x200000;
    serial_print("fb: shadow ", 11);
    kfmt_int(n * 2);
    serial_print(" MB @ ", 6);
    kfmt_hex0x(base);
    serial_print(" kva ", 5);
    kfmt_hex0x(kva);
    serial_println(" (scroll WC read-back eliminated)", 33);
    return 0;
}

# Get framebuffer geometry from boot_info. Returns 0 if unavailable
# (boot_info_ptr unset, fb_phys=0, or pixel-format incompatible). Callers
# should early-return on 0.
fn fb_fb_phys() {
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load64(bi + 0x48);
}
# fb_draw_base — where fb_console PAINTS. Same as fb_fb_phys (the GOP FB) until the P4 console-redirect points
# it at an agnos-owned buffer. Only the paint sites use this; WC-remap / fault-bar / P0 diag keep fb_fb_phys.
# The shadow stays consistent automatically: sh_delta = fb_shadow - fb is recomputed from this same base.
# === 1.56.36 — HARDWARE PAN state ======================================================================
# When armed, the console lives in an agnos-owned VRAM buffer TALLER than the screen and "scrolls" by
# moving the scanout start address down one text row instead of copying the whole console region. See
# GPU_FB_PAN_OFF in gpu_regs.cyr for why it is a separate region and why the mechanism is already proven.
#
# ⛔ EVERY CONSUMER GOES THROUGH fb_draw_base(). Adding the pan there — rather than at each call site —
# means every existing writer (fb_putc, fb_console_clear, the scroll's own clear, blit#39) follows the pan
# for free, because they all compute `base + y * pitch` from it. A pan bolted on per-writer would need
# every one of them found, and the one that was missed would paint into the off-screen slack.
var fb_pan_bytes = 0;   # current scanout offset into the pan buffer, in BYTES (0 = top)
var fb_pan_limit = 0;   # max value fb_pan_bytes may take; 0 = pan DISARMED (software scroll)
fn fb_pan_armed() {
    if (fb_pan_limit != 0) { return 1; }
    return 0;
}
# fb_pan_arm — called by the #93 PAN op once the scanout has been flipped to the pan buffer AND
# fb_set_scanout_base points at it. limit_bytes = slack rows * pitch.
fn fb_pan_arm(limit_bytes) {
    fb_cursor_undraw();                 # 1.57.18: never let the bar ride a base change (the cursor banner)
    fb_pan_bytes = 0;
    fb_pan_limit = limit_bytes;
    return 0;
}
# fb_pan_disarm — fall back to the software scroll. The caller MUST have re-pointed the scanout first.
fn fb_pan_disarm() {
    fb_cursor_undraw();
    fb_pan_bytes = 0;
    fb_pan_limit = 0;
    return 0;
}
fn fb_pan_bytes_get() {
    return fb_pan_bytes;
}
fn fb_draw_base() {
    if (fb_scanout_base != 0) { return fb_scanout_base + fb_pan_bytes; }
    return fb_fb_phys();
}
# fb_set_scanout_base — the redirect switch (called from gpu_scanout_redirect once scanout is re-pointed).
fn fb_set_scanout_base(b) {
    fb_cursor_undraw();                 # 1.57.18: never let the bar ride a base change (the cursor banner)
    fb_scanout_base = b;
    return 0;
}
# P4 geometry-match (2026-07-20): in BIOS quiet-boot the firmware scans a SMALL surface (iron: 800x600, pitch
# 832px) upscaled by DCN to the 2560x1440 link, but boot_info reports the 2560x1440 OUTPUT. So fb_console must
# render at the REAL surface geometry, not boot_info's. When these overrides are nonzero (set by
# gpu_scanout_matchgeom after reading the HW viewport/pitch), the accessors return them instead of boot_info.
# 0 = use boot_info (default / quiet-boot-OFF native path, unchanged).
var fb_geom_w     = 0;
var fb_geom_h     = 0;
var fb_geom_pitch = 0;   # BYTES per scanline (= surface pitch-px * bytes-per-pixel)
# ⭐ 1.57.13 — THE ONE PLACE THE CONSOLE GRID CHANGES, SO THE ONE PLACE THAT DECIDES WHETHER SIGWINCH IS DUE. Every
# geometry move goes through here (mdo_native's live modeset, gpu_scanout_matchgeom's early AND late match, the
# TTY_SELFTEST knob), and winsize#60's (cols, rows) is derived from these three cells plus fb_scale (itself a function
# of the height). The grid is compared before and after: 1 = it REALLY changed, 0 = it did not (Linux tty_do_resize),
# so the matcher's idempotent second call and a same-grid modeset stay silent.
# ⛔ It RETURNS the verdict and never posts: the CALLER posts (sched.cyr console_winch_post — to signalfd watchers of
# bit 28, nobody else) once its console is settled. Posted from here, before mdo_native's fb_console_clear and
# matchgeom's clear + klug replay, a watcher on another CPU could redraw on the signal and have the redraw wiped by the
# clear that followed (1.57.13 review).
# ⭐ 1.57.18 — under the console lock: the cursor bar comes off at the OLD geometry (its recorded offset is only right
# there), and no kprint on another CPU paints between the cells changing (every caller runs outside the emitters).
# ⛔ And a geometry the RAM shadow cannot hold turns the shadow off (direct paint, the fb_shadow_init fallback): it was
# sized for the boot geometry, and every mirror store, clear and scroll would otherwise run past its end.
fn fb_set_geom(w, h, pitch_bytes) {
    console_spin_lock();
    fb_cursor_undraw();
    var sg_before = fb_winsize();
    fb_geom_w = w;
    fb_geom_h = h;
    fb_geom_pitch = pitch_bytes;
    if (fb_shadow != 0) {
        if (fb_pitch() * fb_height() > fb_shadow_size) {
            fb_shadow = 0;
            serial_println("fb: shadow smaller than the new geometry -- direct paint", 56);
        }
    }
    var sg_r = 0;
    if (fb_winsize() != sg_before) { sg_r = 1; }
    console_spin_unlock();
    return sg_r;
}
# fb_geom_active — 1 once the geometry has been matched to the real surface (lets the matcher run idempotently
# from an early AND a late call site without double-clearing).
fn fb_geom_active() {
    if (fb_geom_pitch != 0) { return 1; }
    return 0;
}
fn fb_pitch() {
    if (fb_geom_pitch != 0) { return fb_geom_pitch; }
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x50);
}
fn fb_width() {
    if (fb_geom_w != 0) { return fb_geom_w; }
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x54);
}
fn fb_height() {
    if (fb_geom_h != 0) { return fb_geom_h; }
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x58);
}
# EFI_GRAPHICS_PIXEL_FORMAT enum value (0=RGBX 1=BGRX 2=BitMask 3=BltOnly).
# Stored by gnoboot at boot_info + 0x5C; see gnoboot/src/main.cyr step 10c.
# Returns 0 (PixelRedGreenBlueReserved8BitPerColor — also safe for the
# monochrome paint) if boot_info is unavailable, so callers reading
# this without a boot_info pointer don't false-positive into the
# unsupported branch.
fn fb_pf() {
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x5C);
}
# 1.45.16 net-stage canary beacon. Paints a 32x32 px solid block in the TOP-RIGHT
# FB corner, colored by `code`, so the LAST net stage a ring-3 tool reached is
# visible on the framebuffer photo (FB-over-CMOS). Called from the low-frequency
# net-syscall entry points (net_config#61 / udp_send#52 / sock_connect#47 /
# sock_send#48 / icmp_echo#55) — NOT the recv poll loops. Normal kernel context
# (post-SYSCALL; the FB is mapped under the per-process CR3, like the console), so
# a plain store32 is safe. If the box FREEZES showing a given corner color, that is
# the stage it hung in: a SPIN shows ONLY this beacon; a caught CPU FAULT ALSO
# paints the idt.cyr fault-bar across the top. Diagnostic — strip once the net path
# is iron-clean (cf. the 1.44.x kbd_read FB markers). The color is a raw 0x00RRGGBB
# dword; under a BGRX FB (fb_pf==1) R/B swap but each stays a distinct bright hue.
#
# 1.53.7 SHADOW EXEMPT: writes the WC FB directly, NOT the shadow — a diagnostic
# repainted on every low-frequency net syscall, so a scroll flush that transiently
# clears it is immediately corrected by the next paint. Deliberately not mirrored.
fn fb_dbg_beacon(code) {
    var fb = fb_draw_base();
    if (fb == 0) { return 0; }
    var pitch = fb_pitch();
    var w = fb_width();
    if (w < 32) { return 0; }
    var color = 0x00FFFFFF;                  # white   — unknown code
    if (code == 1) { color = 0x0000FF00; }   # green   — resolver fetched (net_config#61)
    if (code == 2) { color = 0x00FFFF00; }   # yellow  — DNS/UDP tx (udp_send#52)
    if (code == 3) { color = 0x00FF8000; }   # orange  — TCP connect (sock_connect#47)
    if (code == 4) { color = 0x0000FFFF; }   # cyan    — TCP send / TLS+HTTP (sock_send#48)
    if (code == 5) { color = 0x00FF00FF; }   # magenta — ICMP echo / ping (icmp_echo#55)
    var x0 = (w - 32) * 4;
    var y = 0;
    while (y < 32) {
        var rowp = fb + y * pitch + x0;
        var x = 0;
        while (x < 32) {
            store32(rowp + x * 4, color);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
# GOP Mode->Mode (UINT32) — which mode the firmware booted with. Primary
# signal for the quiet-boot-vs-VGA-spec divergence: if the two paths land
# on different mode numbers, the firmware exposed different geometry under
# each setting and downstream FB rendering inherits that difference.
# Stored by gnoboot at boot_info + 0x60. Reserved-slot overlay (not a v3
# struct bump) — v2 readers got zeros there, new readers get the mode #.
fn fb_mode_current() {
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x60);
}
# GOP Mode->MaxMode (UINT32) — how many modes the firmware enumerates.
# Helps tell "1 mode only — firmware doesn't expose mode-set" from "N
# modes — firmware ran QueryMode iteration internally."
fn fb_mode_max() {
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load32(bi + 0x64);
}
# GOP Mode->FrameBufferSize (UINTN/u64) — authoritative FB extent per
# UEFI 2.10 §11.9.1: "amount of memory required to hold the frame
# buffer". Returns 0 if boot_info unavailable, gnoboot didn't populate
# the slot (END-tag zero), or GOP couldn't be located. Callers should
# pair with fb_size_or_fallback() rather than reading this directly.
fn fb_fb_size() {
    var bi = load64(&boot_info_ptr);
    if (bi == 0) { return 0; }
    return load64(bi + 0x68);
}
# Return the WC-remap extent for the FB BAR. Prefers the firmware-
# authoritative FrameBufferSize when populated; falls back to the
# computed pitch*height otherwise. Single source of truth so the WC
# remap site and any future verify paths agree.
fn fb_size_or_fallback() {
    var sz = fb_fb_size();
    if (sz != 0) { return sz; }
    return fb_pitch() * fb_height();
}

# Console origin. The entire screen is text-console territory; no
# reserved canary stripe or marker grid above the text. Bump
# FB_CONSOLE_Y0 if a top-of-screen visual diagnostic ever needs to
# come back — one-line change, no other call sites depend on a
# specific value.
var FB_CONSOLE_Y0 = 0;
var FB_FG = 0x00FFFFFF;  # white (default foreground)
var FB_BG = 0x00000000;  # black (default background)

# === ANSI/CSI/SGR state (1.43.1) ===
# The console now interprets the escape sequences userland emits — SGR colour
# (anuenue's per-char rainbow, any coloured tool), ED/`ESC[2J` (agnsh `clear`),
# and CUP/`ESC[H` cursor positioning — instead of dropping the escape bytes as
# sub-0x20 non-printables (which printed nothing for `clear` and raw garbage for
# colour). fb_ansi_feed() is a small 3-state machine in front of fb_putc's glyph
# path; the *current* fg/bg are packed pixel values the glyph render reads
# directly (no per-pixel cost added). Defaults match the historical white-on-black.
var fb_fg_color = 0x00FFFFFF;   # current foreground, PACKED for the FB pixel format
var fb_bg_color = 0x00000000;   # current background,  PACKED for the FB pixel format
# ⭐ 1.57.18 — THE CONSOLE AS A TERMINAL (issue 2026-11-06-the-console-is-short-of-a-terminal; thoth's TUI carried a
# filter that stood in for all of this). Prior art: Linux drivers/tty/vt/vt.c (do_con_trol's states, csi_J / csi_K,
# vc_con_write_normal, the UTF-8 decoder and its U+FFFD, vc_need_wrap) with xterm's ctlseqs for the semantics. The
# "console escape support" table in agnos-userland-abi.md lists every sequence; the states:
#   0 NORMAL · 1 ESC seen (intermediates 0x20-0x2F stay here until the final byte) · 2 CSI (parameters) ·
#   3 a control STRING — OSC `ESC ]`, DCS `ESC P`, APC `ESC _`, PM `ESC ^`, SOS `ESC X` — swallowed whole up to BEL or
#     ST (`ESC \`), CAN / SUB cancel it, and after FB_STR_MAX body bytes it ENDS (the next byte draws): an
#     unterminated string must not eat the console for good (VTE caps a string at 4096 bytes, VTE_SEQ_STRING_MAX_CAPACITY)
#   4 a string's ESC (`\` ends it as ST; any other byte starts a new sequence, as vt.c's ESesc does).
# C0 controls inside states 1 and 2 are EXECUTED and the sequence goes on (ECMA-48 / vt.c "control characters can be
# used in the middle of an escape sequence"); a byte >= 0x80 abandons the sequence and is drawn.
var FB_NPAR = 32;               # CSI parameters kept (vt.c NPAR 16, xterm NPARAM 30, VTE 32); later ones are ignored
var FB_STR_MAX = 4096;          # control-string body bytes swallowed before the string is ended
var fb_ansi_state = 0;          # 0..4, above
var fb_ansi_params[32];         # CSI numeric params (module-global -> 32 x u64), each clamped to 65535
var fb_ansi_nparam = 0;         # index of the param currently being accumulated
var fb_ansi_have_digit = 0;     # 1 if the current param slot has seen >= 1 digit
var fb_ansi_priv = 0;           # the CSI private marker ('?' '>' '<' '=') when it led the parameters, else 0
var fb_ansi_inter = 0;          # 1 once a CSI intermediate byte (0x20-0x2F) was seen (no such final is handled)
var fb_ansi_ovf = 0;            # 1 once a CSI ran past FB_NPAR parameters (the rest are ignored, not folded into the last)
var fb_str_n = 0;               # control-string body bytes swallowed so far
# UTF-8 (Unicode 15 Table 3-7 well-formed sequences). One replacement cell per MAXIMAL SUBPART of an ill-formed
# sequence (Unicode 15 § 3.9 U+FFFD substitution, "best practice"; vt.c's vc_sanitize_unicode / rescan): a lone
# continuation byte, a byte that is never a lead (C0 C1 F5..FF), an overlong / surrogate / > U+10FFFF second byte, and
# a sequence cut short by any non-continuation byte (which is then processed on its own). The state persists across
# write calls, so a codepoint split between two writes still decodes.
var fb_u8_need = 0;             # continuation bytes still expected (0 = none in flight)
var fb_u8_cp = 0;               # codepoint accumulated so far
var fb_u8_lo = 0x80;            # the next continuation byte's allowed range (E0: A0.., ED: ..9F, F0: 90.., F4: ..8F)
var fb_u8_hi = 0xBF;
var fb_rev = 0;                 # SGR 7 (reverse video) — 27 / 0 clear it
var fb_awm = 1;                 # DECAWM (?7h, the default) — 0 after ?7l: the last column is overwritten, never wrapped

# Pack an (r,g,b) triple (each 0..255) into the 32bpp FB pixel value, honouring
# the EFI pixel format: pf 1 = BGRX (byte0=B,1=G,2=R) → 0x00RRGGBB; pf 0 = RGBX
# (byte0=R,1=G,2=B) → R and B swapped. White/black are symmetric (why the old
# fixed FB_FG/FB_BG worked under both), but real colours need this.
fn fb_pack(r, g, b) {
    if (fb_pf() == 0) { return (b << 16) | (g << 8) | r; }   # RGBX
    return (r << 16) | (g << 8) | b;                          # BGRX (and pf default)
}

# The 16 standard ANSI colours (xterm/VGA-ish palette), idx 0..15 → packed pixel.
# 0-7 normal, 8-15 bright. Used by SGR 30-37/40-47/90-97/100-107 and 256-idx 0-15.
fn fb_ansi16(idx) {
    if (idx == 0)  { return fb_pack(0, 0, 0); }
    if (idx == 1)  { return fb_pack(170, 0, 0); }
    if (idx == 2)  { return fb_pack(0, 170, 0); }
    if (idx == 3)  { return fb_pack(170, 85, 0); }
    if (idx == 4)  { return fb_pack(0, 0, 170); }
    if (idx == 5)  { return fb_pack(170, 0, 170); }
    if (idx == 6)  { return fb_pack(0, 170, 170); }
    if (idx == 7)  { return fb_pack(170, 170, 170); }
    if (idx == 8)  { return fb_pack(85, 85, 85); }
    if (idx == 9)  { return fb_pack(255, 85, 85); }
    if (idx == 10) { return fb_pack(85, 255, 85); }
    if (idx == 11) { return fb_pack(255, 255, 85); }
    if (idx == 12) { return fb_pack(85, 85, 255); }
    if (idx == 13) { return fb_pack(255, 85, 255); }
    if (idx == 14) { return fb_pack(85, 255, 255); }
    return fb_pack(255, 255, 255);   # 15 bright white
}

# 256-colour index → packed pixel. 0-15 = the base 16; 16-231 = 6×6×6 cube;
# 232-255 = 24-step grayscale ramp (standard xterm 256 layout). This is the
# path anuenue's `ESC[38;5;Nm` rainbow drives.
fn fb_256_rgb(n) {
    if (n < 16) { return fb_ansi16(n); }
    if (n < 232) {
        var c = n - 16;
        var r6 = (c / 36) % 6;
        var g6 = (c / 6) % 6;
        var b6 = c % 6;
        var r = 0;
        if (r6 != 0) { r = 55 + r6 * 40; }
        var g = 0;
        if (g6 != 0) { g = 55 + g6 * 40; }
        var b = 0;
        if (b6 != 0) { b = 55 + b6 * 40; }
        return fb_pack(r, g, b);
    }
    var gray = 8 + (n - 232) * 10;
    return fb_pack(gray, gray, gray);
}

# Glyph scale factor derived from display height. With the 1.30.12 swap
# to a real 8x16 bitmap font, scale=1 is already legible at 1080p (cell
# 8x16 = ~1.5% of screen height) and scale=2 covers 2K+. Pre-1.30.12 used
# four tiers because the 8x8 source needed more scaling to be visible at
# all; the real font collapsed that to two tiers. Render expands each
# font bit into an S x S pixel block, so cell_w = 8*S and cell_h = 16*S.
#
#   h ≤ 1200  → scale = 1   (8x16 text, ~128 cols at 1024x768, ~240 at 1080p)
#   h >  1200 → scale = 2   (16x32 text, ~160 cols at 2560x1440, ~240 at 4K)
fn fb_scale() {
    var h = fb_height();
    if (h <= 1200) { return 1; }
    return 2;
}

# Console character grid (cols × rows) of the live framebuffer, packed for the
# winsize#60 syscall. Mirrors fb_putc's own cell math EXACTLY — cell = 8*scale ×
# 16*scale, same FB_CONSOLE_Y0 top offset — so a ring-3 TUI that sizes itself to
# this value lays out against the real console geometry rather than a hardcoded
# 80×24. The two 16-bit counts are returned packed in one i64: high 16 = cols,
# low 16 = rows (cols = rax>>16 & 0xFFFF, rows = rax & 0xFFFF). Both fit in 16
# bits with enormous margin (8K = 960 cols / 135 rows). Returns -1 if the
# framebuffer isn't up yet (boot_info absent → fb_width()/fb_height() == 0). The
# packed return avoids a user-buffer write — no pointer to validate, no SMAP
# window — matching uptime_ms#40's bufferless style. (1.45.13 — darshana tty_winsize.)
fn fb_winsize() {
    var w = fb_width();
    var h = fb_height();
    if (w == 0) { return 0 - 1; }
    if (h == 0) { return 0 - 1; }
    var s = fb_scale();
    var cols = w / (8 * s);
    var rows = (h - FB_CONSOLE_Y0) / (16 * s);
    # Defensive 16-bit clamp before packing. Each count gets a 16-bit field, so a
    # pathological boot_info reporting an absurd geometry (cols>0xFFFF needs width
    # >524280 px — ~68× beyond 8K, reachable only via corrupt firmware data, never
    # real hardware) must not overflow cols into the rows field. Mirrors blit#39's
    # memory-safety-gate posture; a no-op on every real display.
    if (cols > 0xFFFF) { cols = 0xFFFF; }
    if (rows > 0xFFFF) { rows = 0xFFFF; }
    return (cols << 16) | rows;
}

# ═══════════════ 1.57.18 — bulk stores, the grid, span fills ═══════════════
# ⭐ WHERE A SCROLL'S 194 ms WENT (measured with the TSC, 2048x2048 under KVM, issue 2026-11-06): the shadow memmove
# was 4.8 ms (a cyrius store64 loop; `rep movsq` 1.1 ms), the bottom-row clear 0.07 ms, and the FLUSH of 16 MB to the
# framebuffer 190 ms — 183 ms even with `rep movsq`, i.e. the stores themselves, ~90 MB/s. That is a write-through
# mapping: PAT entry 1 was the firmware's 0x04 = WT, not WC (vmm.cyr pat_init_cpu). With entry 1 WC the same
# `rep movsq` flush is 0.8 ms. The scroll is therefore: the PAT fix + one `rep movsq` memmove in the RAM shadow + one
# `rep stosq` clear + one `rep movsq` flush (Linux memmove_64.S takes the same forward `rep movs` for dst < src;
# vidya graphics/framebuffer_rendering: bulk string stores, never per-pixel loops).
#
# fb_movsq(dst, src, n): copy n qwords, ascending. ⚠ Overlap is safe only with dst BELOW src (the scroll's shape):
# rep movs is architecturally an in-order element loop, which fast-string hardware preserves for overlapping operands.
# asm register contract — in: rdi = dst ([rbp-0x08]), rsi = src ([rbp-0x10]), rcx = n ([rbp-0x18]); out: none;
# clobbers: rdi, rsi, rcx, DF (cleared by cld; the kernel never runs with DF set).
fn fb_movsq(dst, src, n) {
    if (n <= 0) { return 0; }
    asm {
        0x48; 0x8B; 0x7D; 0xF8;       # mov rdi, [rbp-0x08]   ; dst
        0x48; 0x8B; 0x75; 0xF0;       # mov rsi, [rbp-0x10]   ; src
        0x48; 0x8B; 0x4D; 0xE8;       # mov rcx, [rbp-0x18]   ; n (qwords)
        0xFC;                         # cld
        0xF3; 0x48; 0xA5;             # rep movsq
    }
    return 0;
}
# fb_stosq(dst, v, n): store the qword v n times, ascending.
# asm register contract — in: rdi = dst ([rbp-0x08]), rax = v ([rbp-0x10]), rcx = n ([rbp-0x18]); out: none;
# clobbers: rdi, rcx, rax, DF (cleared).
fn fb_stosq(dst, v, n) {
    if (n <= 0) { return 0; }
    asm {
        0x48; 0x8B; 0x7D; 0xF8;       # mov rdi, [rbp-0x08]   ; dst
        0x48; 0x8B; 0x45; 0xF0;       # mov rax, [rbp-0x10]   ; v
        0x48; 0x8B; 0x4D; 0xE8;       # mov rcx, [rbp-0x18]   ; n (qwords)
        0xFC;                         # cld
        0xF3; 0x48; 0xAB;             # rep stosq
    }
    return 0;
}

# The live text grid, read once per byte (fb_putc / fb_ctrl / fb_ansi_dispatch) into these cells, which every helper
# below uses: the paint base, pitch, scale, cell size, cols and rows (winsize#60's math). -> 0 when there is no grid
# (no framebuffer, or a geometry smaller than one cell). Written under the console lock like every fb_* cell.
var fb_g_fb = 0;
var fb_g_pitch = 0;
var fb_g_h = 0;
var fb_g_s = 1;
var fb_g_cw = 8;
var fb_g_ch = 16;
var fb_g_cols = 0;
var fb_g_rows = 0;
fn fb_grid() {
    var fb = fb_draw_base();
    if (fb == 0) { return 0; }
    var h = fb_height();
    var s = 1;
    if (h > 1200) { s = 2; }
    fb_g_fb = fb;
    fb_g_pitch = fb_pitch();
    fb_g_h = h;
    fb_g_s = s;
    fb_g_cw = 8 * s;
    fb_g_ch = 16 * s;
    fb_g_cols = fb_width() / fb_g_cw;
    fb_g_rows = (h - FB_CONSOLE_Y0) / fb_g_ch;
    if (fb_g_cols <= 0) { return 0; }
    if (fb_g_rows <= 0) { return 0; }
    return 1;
}

# Fill cells [c0, c1) of text row `row` with `color` (two packed pixels per qword), framebuffer and shadow alike.
# The erase primitive of EL / ED / BS / the live-line blank. Needs fb_grid().
fn fb_fill_span(row, c0, c1, color) {
    if (c1 > fb_g_cols) { c1 = fb_g_cols; }
    if (c0 < 0) { c0 = 0; }
    if (c0 >= c1) { return 0; }
    if (row < 0) { return 0; }
    if (row >= fb_g_rows) { return 0; }
    var c64 = (color << 32) | color;
    var nq = (c1 - c0) * fb_g_cw / 2;                  # cw pixels per cell, 2 per qword
    var a = fb_g_fb + (FB_CONSOLE_Y0 + row * fb_g_ch) * fb_g_pitch + c0 * fb_g_cw * 4;
    var sh_delta = 0;
    if (fb_shadow != 0) { sh_delta = fb_shadow - fb_g_fb; }
    var y = 0;
    while (y < fb_g_ch) {
        fb_stosq(a, c64, nq);
        if (fb_shadow != 0) { fb_stosq(a + sh_delta, c64, nq); }
        a = a + fb_g_pitch;
        y = y + 1;
    }
    return 0;
}
# Fill whole text rows [r0, r1) — every scanline, pitch padding included, as the ED 2 clear does; through the bottom
# of the framebuffer when r1 is the last row (the band below the grid takes the colour too). Needs fb_grid().
fn fb_fill_rows(r0, r1, color) {
    if (r0 < 0) { r0 = 0; }
    if (r1 > fb_g_rows) { r1 = fb_g_rows; }
    if (r0 >= r1) { return 0; }
    var y0 = FB_CONSOLE_Y0 + r0 * fb_g_ch;
    var y1 = FB_CONSOLE_Y0 + r1 * fb_g_ch;
    if (r1 == fb_g_rows) { y1 = fb_g_h; }
    var c64 = (color << 32) | color;
    var nq = (y1 - y0) * fb_g_pitch / 8;
    fb_stosq(fb_g_fb + y0 * fb_g_pitch, c64, nq);
    if (fb_shadow != 0) { fb_stosq(fb_shadow + y0 * fb_g_pitch, c64, nq); }
    return 0;
}

# ═══════════════ 1.57.18 — THE CURSOR (DECTCEM ?25h / ?25l) ═══════════════
# Prior art: Linux fbcon's default CUR_UNDERLINE — the bottom 2 font rows of the cursor cell drawn inverted
# (fbcon_cursor / soft_cursor XOR the cursor mask into the glyph) — and vt.c's discipline: do_con_write HIDES the
# cursor before it touches the screen (hide_cursor) and con_flush_chars / vt_console_print SET it again once the
# batch is done (set_cursor). Here: the bar is a pixel XOR (0x00FFFFFF) of those 2*s scanlines, sourced from the RAM
# shadow when there is one (so a blit#39 that painted over the cell cannot be XORed twice into a smear) and written to
# the framebuffer and the shadow alike; XORing it again takes it off exactly. ⛔ NO GHOST, BY CONSTRUCTION: fb_putc
# takes the bar off before ANY byte can move the cursor, scroll or erase; fb_console_clear forgets it (the clear wiped
# it); fb_set_geom / fb_set_scanout_base / the pan arm-disarm take it off before the geometry or the base moves under
# it (gpu.cyr's two seed copies take it off before they copy the screen into a new buffer). The kprint emitters
# (kputc / kprint / kprintln / kprint_user) and klug_replay_fb draw it again — ONCE per batch, never per byte.
# Shown by default (every VT is); at the pending wrap it sits on the last column, where xterm draws it.
var fb_cur_on = 1;              # DECTCEM: 1 = shown
var fb_cur_drawn = 0;           # 1 = the bar is on the glass at the cells below
var fb_cur_dfb = 0;             # the paint base it was drawn into
var fb_cur_doff = 0;            # byte offset of its first scanline
var fb_cur_dw = 0;              # its width in pixels
var fb_cur_dh = 0;              # its height in scanlines
var fb_cur_dpitch = 0;
fn fb_cursor_xor() {
    var sh_delta = 0;
    if (fb_shadow != 0) { sh_delta = fb_shadow - fb_cur_dfb; }
    var row = fb_cur_dfb + fb_cur_doff;
    var y = 0;
    while (y < fb_cur_dh) {
        var a = row;
        var x = 0;
        while (x < fb_cur_dw) {
            var v = 0;
            if (fb_shadow != 0) { v = load32(a + sh_delta); } else { v = load32(a); }
            v = v ^ 0x00FFFFFF;
            store32(a, v);
            if (fb_shadow != 0) { store32(a + sh_delta, v); }
            a = a + 4;
            x = x + 1;
        }
        row = row + fb_cur_dpitch;
        y = y + 1;
    }
    return 0;
}
fn fb_cursor_undraw() {
    if (fb_cur_drawn == 0) { return 0; }
    fb_cur_drawn = 0;
    fb_cursor_xor();
    return 0;
}
# Draw the bar at the cursor cell (the end of a batch). A no-op while the console is not drawing or ?25l is in force.
fn fb_cursor_sync() {
    if (fb_console_ready == 0) { return 0; }
    if (fb_defer != 0) { return 0; }
    fb_cursor_undraw();
    if (fb_cur_on == 0) { return 0; }
    if (fb_grid() == 0) { return 0; }
    var col = fb_cur_x;
    if (col >= fb_g_cols) { col = fb_g_cols - 1; }     # the pending wrap: on the last column
    var row = fb_cur_y;
    if (row >= fb_g_rows) { row = fb_g_rows - 1; }
    fb_cur_dfb = fb_g_fb;
    fb_cur_dpitch = fb_g_pitch;
    fb_cur_dw = fb_g_cw;
    fb_cur_dh = 2 * fb_g_s;
    fb_cur_doff = (FB_CONSOLE_Y0 + row * fb_g_ch + fb_g_ch - fb_cur_dh) * fb_g_pitch + col * fb_g_cw * 4;
    fb_cursor_xor();
    fb_cur_drawn = 1;
    return 0;
}

# ═══════════════ 1.57.18 — the parser state, saved around output that is not the program's stream ═══════════════
# A ring-3 program's escape / UTF-8 state persists across its write calls. KERNEL lines (kprint / kprintln), the
# keystroke echo (kputc) and the live-line replay are not part of that stream: each runs on a parser in the NORMAL
# state and the program's state comes back after it. Without that, a kernel line arriving between two writes of one
# split sequence would break the sequence AND be eaten by it (Linux vt_console_print writes printk text without
# going through do_con_trol at all; the colours, as there, are the console's current ones). Slot 0 = the kprint
# bracket, slot 1 = fb_oob_end's replay (which runs inside it). 16 qwords of state + the 32 parameters per slot.
var fb_ps[96];
fn fb_pstate_push(slot) {
    var p = &fb_ps + slot * 48 * 8;
    store64(p, fb_ansi_state);
    store64(p + 8, fb_ansi_nparam);
    store64(p + 16, fb_ansi_have_digit);
    store64(p + 24, fb_ansi_priv);
    store64(p + 32, fb_ansi_inter);
    store64(p + 40, fb_str_n);
    store64(p + 48, fb_u8_need);
    store64(p + 56, fb_u8_cp);
    store64(p + 64, fb_u8_lo);
    store64(p + 72, fb_u8_hi);
    store64(p + 80, fb_ansi_ovf);
    if (fb_ansi_state == 2) { fb_movsq(p + 128, &fb_ansi_params, 32); }
    fb_ansi_state = 0;
    fb_u8_need = 0;
    fb_u8_lo = 0x80;
    fb_u8_hi = 0xBF;
    return 0;
}
fn fb_pstate_pop(slot) {
    var p = &fb_ps + slot * 48 * 8;
    fb_ansi_state = load64(p);
    fb_ansi_nparam = load64(p + 8);
    fb_ansi_have_digit = load64(p + 16);
    fb_ansi_priv = load64(p + 24);
    fb_ansi_inter = load64(p + 32);
    fb_str_n = load64(p + 40);
    fb_u8_need = load64(p + 48);
    fb_u8_cp = load64(p + 56);
    fb_u8_lo = load64(p + 64);
    fb_u8_hi = load64(p + 72);
    fb_ansi_ovf = load64(p + 80);
    if (fb_ansi_state == 2) { fb_movsq(&fb_ansi_params, p + 128, 32); }
    return 0;
}
# The kprint emitters' bracket (kprint.cyr): kernel text and the echo draw on a NORMAL-state parser.
fn fb_kern_begin() { fb_pstate_push(0); return 0; }
fn fb_kern_end() { fb_pstate_pop(0); return 0; }

# Scroll the console area up by one cell row (16*scale pixels). Copy the
# rectangle from y=FB_CONSOLE_Y0+cell_h..height down to
# y=FB_CONSOLE_Y0..(height-cell_h), then clear the new bottom row.
#
# Pitch-aware: the copies and clears cover `pitch` bytes per scanline, not
# `width` pixels. Same rationale as fb_console_init's clear — when ppl > hres,
# the padding columns carry stale firmware paint that the scroll body
# was previously leaving untouched. Copy is byte-stable either way; the
# bottom-row clear specifically needs the pitch extent.
# 1.57.18: whole-region `rep movsq` / `rep stosq` (the rows are contiguous at the pitch), see the bulk-store banner.
fn fb_scroll_up() {
    var fb = fb_draw_base();
    if (fb == 0) { return 0; }
    var pitch = fb_pitch();
    var height = fb_height();
    var cell_h = 16 * fb_scale();
    var q = pitch / 8;                     # qwords per scanline
    var rows_to_copy = height - FB_CONSOLE_Y0 - cell_h;
    if (rows_to_copy <= 0) { return 0; }
    var clear_y = FB_CONSOLE_Y0 + rows_to_copy;
    var top = FB_CONSOLE_Y0 * pitch;
    # Two packed pixels per u64 for the bottom-row clear (1.43.1: current bg, not a
    # hardcoded FB_BG=0; black → 0, identical to before).
    var bg64 = (fb_bg_color << 32) | fb_bg_color;

    # ═══ PAN PATH (1.56.36) — O(one text row) instead of O(whole screen) ═══════════════════════════════
    # The scroll becomes: move the scanout start DOWN one text row, clear the row that has just come into
    # view at the bottom, and commit the new address. No console-region copy at all.
    #
    # Cost per scrolled line at 2560x1440: ONE register write + cell_h * pitch = 16 * 10240 = **160 KB** of
    # WC stores, against 14.7 MB for the software scroll. The reset below is the only full-frame copy, and
    # it happens once per `slack / cell_h` = 90 scrolls, so the amortised traffic is ~30x lower.
    if (fb_pan_armed() == 1) {
        var base = fb_scanout_base;             # buffer origin (NOT fb_draw_base — that already adds the pan)
        var step = cell_h * pitch;
        var vis  = height * pitch;              # bytes in one visible screenful
        var next = fb_pan_bytes + step;
        # ── RESET. The scanout cannot walk past the end of the buffer, so when the next step would leave
        # less than a full screen behind it, fold the content that WILL remain visible back to offset 0 and
        # restart the pan there. Source and destination cannot overlap: a reset only triggers once
        # next + vis > buffer end, i.e. next >= vis, so [next, next+vis-step) starts at or after
        # [0, vis-step). A forward copy is therefore safe without a temp — same argument the shadow
        # memmove below relies on, in the opposite direction.
        if (next > fb_pan_limit) {
            fb_movsq(base, base + next, (vis - step + 7) / 8);   # rows that survive the scroll, i.e. everything but the top one
            fb_pan_bytes = 0;
            next = 0;
            # The bottom row is cleared below, at the post-reset offset.
        }
        # ── Clear the cell_h rows that are about to become the bottom line. At the new pan offset these sit
        # at [next + vis - step, next + vis) — off-screen right up until the address commit below makes them
        # the last visible row, so there is no flash of stale content.
        fb_stosq(base + next + vis - step, bg64, (step + 7) / 8);
        fb_pan_bytes = next;
        # ── Commit. gpu_pan_commit writes DCSURF_PRIMARY_SURFACE_ADDRESS live — the same address-group
        # write gpu_blit_present does every frame for DOOM, which is why this needs no OTG envelope.
        gpu_pan_commit(fb_pan_bytes);
        return 0;
    }

    if (fb_shadow != 0) {
        # SHADOW PATH (1.53.7). The killer optimization: the OLD path read the WC
        # framebuffer back (~1M uncached WC loads/newline at 1080p) to source the
        # scrolled pixels. With a WB RAM shadow the scroll is a pure RAM memmove +
        # ONE write-only flush — zero FB reads.
        var sh = fb_shadow;
        # 1. Shift the shadow up by one cell row. dst is BELOW src and the ranges overlap: the ascending copy reads
        #    each source word before any later store can clobber it — safe without a temp.
        fb_movsq(sh + top, sh + top + cell_h * pitch, rows_to_copy * q);
        # 2. Clear the new bottom cell_h rows in the shadow.
        fb_stosq(sh + clear_y * pitch, bg64, cell_h * q);
        # 3. Flush the whole console region [FB_CONSOLE_Y0 .. height) shadow→FB, WRITE-ONLY (the reads hit the WB
        #    shadow; the WC stores are the same volume the old path wrote, minus every FB read).
        fb_movsq(fb + top, sh + top, (height - FB_CONSOLE_Y0) * q);
        return 0;
    }

    # FALLBACK PATH (no shadow): the original in-place WC FB copy — reads the FB
    # back. Top-down (src is below dst), so the ascending copy is safe.
    fb_movsq(fb + top, fb + top + cell_h * pitch, rows_to_copy * q);
    fb_stosq(fb + clear_y * pitch, bg64, cell_h * q);
    return 0;
}

# Read CSI param `i`. Module-global `var X[N]` is N×u64, accessed by explicit
# load64(&X + i*8) (the kernel's exec_ctx convention; `X[i]` indexing isn't a
# thing for module globals here).
fn fb_ansi_p(i) {
    if (i >= FB_NPAR) { return 0; }
    return load64(&fb_ansi_params + i * 8);
}

# Clear the whole framebuffer to the current background colour + home the
# cursor. Backs `ESC[2J`. Mirrors fb_console_init's clear but packs the
# current bg into the u64 block-store (black today → 0, identical to before).
# ⚠ ED 2 HOMES THE CURSOR here (since 1.43.1; agnsh's `clear` and the FB_ANSI_SELFTEST rely on it) — xterm and vt.c
# leave it where it was. 1.57.18: one `rep stosq` per buffer, and the cursor bar is FORGOTTEN, not XORed (the clear
# overwrote it — callers outside fb_putc, the geometry matchers and fb_defer_rescue, reach here with it drawn).
fn fb_console_clear() {
    fb_cur_drawn = 0;
    var fb = fb_draw_base();
    if (fb == 0) { fb_cur_x = 0; fb_cur_y = 0; return 0; }
    var nq = fb_pitch() * fb_height() / 8;
    var bg64 = (fb_bg_color << 32) | fb_bg_color;   # two packed pixels per u64
    fb_stosq(fb, bg64, nq);
    # Mirror the clear into the WB shadow so a later scroll flush doesn't repaint
    # stale content over a cleared screen (1.53.7).
    if (fb_shadow != 0) { fb_stosq(fb_shadow, bg64, nq); }
    fb_cur_x = 0;
    fb_cur_y = 0;
    return 0;
}

# Apply an SGR (`ESC[…m`) parameter list to the current fg/bg colour state.
# Supports: 0/bare = reset, 30-37/90-97 fg + 40-47/100-107 bg (16 colours),
# 39/49 default fg/bg, 38;5;N / 48;5;N (256-colour), 38;2;R;G;B / 48;2;R;G;B
# (truecolour), and since 1.57.18 7 / 27 (reverse video on / off: the glyph swaps fg and bg; an erase still uses the
# background, as vt.c's erase character does). Other attributes (bold, underline, blink) are skipped.
# `np` is the param count (0 == bare `ESC[m`).
fn fb_ansi_sgr(np) {
    if (np == 0) { fb_fg_color = FB_FG; fb_bg_color = FB_BG; fb_rev = 0; return 0; }
    var i = 0;
    while (i < np) {
        var p = fb_ansi_p(i);
        if (p == 0) { fb_fg_color = FB_FG; fb_bg_color = FB_BG; fb_rev = 0; }
        elif (p == 7) { fb_rev = 1; }
        elif (p == 27) { fb_rev = 0; }
        elif (p == 38) {
            if (i + 1 < np) {
                var m = fb_ansi_p(i + 1);
                if (m == 5) {
                    if (i + 2 < np) { fb_fg_color = fb_256_rgb(fb_ansi_p(i + 2) & 0xFF); }
                    i = i + 2;
                } elif (m == 2) {
                    if (i + 4 < np) { fb_fg_color = fb_pack(fb_ansi_p(i + 2) & 0xFF, fb_ansi_p(i + 3) & 0xFF, fb_ansi_p(i + 4) & 0xFF); }
                    i = i + 4;
                }
            }
        }
        elif (p == 48) {
            if (i + 1 < np) {
                var m2 = fb_ansi_p(i + 1);
                if (m2 == 5) {
                    if (i + 2 < np) { fb_bg_color = fb_256_rgb(fb_ansi_p(i + 2) & 0xFF); }
                    i = i + 2;
                } elif (m2 == 2) {
                    if (i + 4 < np) { fb_bg_color = fb_pack(fb_ansi_p(i + 2) & 0xFF, fb_ansi_p(i + 3) & 0xFF, fb_ansi_p(i + 4) & 0xFF); }
                    i = i + 4;
                }
            }
        }
        elif (p == 39) { fb_fg_color = FB_FG; }
        elif (p == 49) { fb_bg_color = FB_BG; }
        elif (p >= 30 && p <= 37)   { fb_fg_color = fb_ansi16(p - 30); }
        elif (p >= 40 && p <= 47)   { fb_bg_color = fb_ansi16(p - 40); }
        elif (p >= 90 && p <= 97)   { fb_fg_color = fb_ansi16(p - 90 + 8); }
        elif (p >= 100 && p <= 107) { fb_bg_color = fb_ansi16(p - 100 + 8); }
        i = i + 1;
    }
    return 0;
}

# DEC private modes (`ESC[?Nh` / `ESC[?Nl`): 25 DECTCEM (the cursor shown / hidden) and 7 DECAWM (autowrap at the
# last column on / off). Every other mode is ignored.
fn fb_ansi_decset(np, on) {
    var i = 0;
    while (i < np) {
        var m = fb_ansi_p(i);
        if (m == 25) { fb_cur_on = on; }
        if (m == 7) { fb_awm = on; }
        i = i + 1;
    }
    return 0;
}

# Dispatch a completed CSI sequence by its final byte: SGR (`m`), ED (`J`: 0 cursor to the end, 1 the start to the
# cursor inclusive, 2 the whole screen + home; 3 has no scrollback to erase), EL (`K`: 0 cursor to the end of the
# line, 1 its start to the cursor inclusive, 2 the whole line), CUP (`H` / `f`), and the DEC private modes `?h` / `?l`.
# EL and ED fill with the ACTIVE background (xterm's bce, vt.c's erase character) and leave the pending wrap (the
# cursor column is clamped to the last one — xterm ResetWrap, vt.c csi_K). A private final other than h / l, and
# every other final, no-ops (safer than mis-rendering).
fn fb_ansi_dispatch(cmd, np) {
    if (cmd == 0x6D) {                                   # 'm' (SGR; a private ?m / >m is something else)
        if (fb_ansi_priv == 0) { fb_ansi_sgr(np); }
        return 0;
    }
    if (cmd == 0x68) { if (fb_ansi_priv == 0x3F) { fb_ansi_decset(np, 1); } return 0; }   # 'h'
    if (cmd == 0x6C) { if (fb_ansi_priv == 0x3F) { fb_ansi_decset(np, 0); } return 0; }   # 'l'
    if (fb_ansi_priv != 0) { return 0; }
    if (fb_grid() == 0) { return 0; }
    var p0 = 0;
    if (np > 0) { p0 = fb_ansi_p(0); }
    var cx = fb_cur_x;
    if (cx >= fb_g_cols) { cx = fb_g_cols - 1; }
    var cy = fb_cur_y;
    if (cy >= fb_g_rows) { cy = fb_g_rows - 1; }
    if (cmd == 0x4A) {                                   # 'J' (ED)
        if (p0 == 0) {
            fb_cur_x = cx;
            fb_fill_span(cy, cx, fb_g_cols, fb_bg_color);
            fb_fill_rows(cy + 1, fb_g_rows, fb_bg_color);
        } elif (p0 == 1) {
            fb_cur_x = cx;
            fb_fill_rows(0, cy, fb_bg_color);
            fb_fill_span(cy, 0, cx + 1, fb_bg_color);
        } elif (p0 == 2) {
            fb_console_clear();
        }
        return 0;
    }
    if (cmd == 0x4B) {                                   # 'K' (EL)
        if (p0 == 0) { fb_cur_x = cx; fb_fill_span(cy, cx, fb_g_cols, fb_bg_color); }
        elif (p0 == 1) { fb_cur_x = cx; fb_fill_span(cy, 0, cx + 1, fb_bg_color); }
        elif (p0 == 2) { fb_cur_x = cx; fb_fill_span(cy, 0, fb_g_cols, fb_bg_color); }
        return 0;
    }
    if (cmd == 0x48 || cmd == 0x66) {                    # 'H' / 'f' (CUP)
        var row = 1;
        var col = 1;
        if (np > 0 && fb_ansi_p(0) > 0) { row = fb_ansi_p(0); }
        if (np > 1 && fb_ansi_p(1) > 0) { col = fb_ansi_p(1); }
        var ry = row - 1;
        var rx = col - 1;
        if (ry >= fb_g_rows) { ry = fb_g_rows - 1; }
        if (rx >= fb_g_cols) { rx = fb_g_cols - 1; }
        fb_cur_y = ry;
        fb_cur_x = rx;
        return 0;
    }
    return 0;
}

# Feed one byte to the escape parser (the states are in the banner above fb_ansi_params). Returns 1 if the byte was
# CONSUMED by a sequence (the caller must not render it — a C0 control inside a CSI was executed here), 0 if it is
# a normal byte the caller should render: state 0 and not ESC, or a sequence just abandoned by a byte >= 0x80, or the
# first byte past a control string's FB_STR_MAX bound.
fn fb_ansi_feed(ch) {
    var b = ch & 0xFF;
    var st = fb_ansi_state;
    if (st == 0) {
        if (b == 0x1B) { fb_ansi_state = 1; return 1; }
        return 0;
    }
    if (st >= 3) { return fb_str_feed(b); }
    # ESC or CSI: a C0 control is executed in place (ESC restarts the sequence, CAN / SUB cancel it)
    if (b < 0x20) {
        if (b == 0x1B) { fb_ansi_state = 1; return 1; }
        if (b == 0x18 || b == 0x1A) { fb_ansi_state = 0; return 1; }
        fb_ctrl(b);
        return 1;
    }
    if (b >= 0x80) { fb_ansi_state = 0; return 0; }
    if (b == 0x7F) { return 1; }                         # DEL inside a sequence: ignored
    if (st == 1) {
        if (b == 0x5B) {                                 # '[' -> CSI
            fb_ansi_state = 2;
            fb_ansi_nparam = 0;
            store64(&fb_ansi_params, 0);
            fb_ansi_have_digit = 0;
            fb_ansi_priv = 0;
            fb_ansi_inter = 0;
            fb_ansi_ovf = 0;
            return 1;
        }
        # ']' OSC, 'P' DCS, '_' APC, '^' PM, 'X' SOS -> a control string
        if (b == 0x5D || b == 0x50 || b == 0x5F || b == 0x5E || b == 0x58) {
            fb_ansi_state = 3;
            fb_str_n = 0;
            return 1;
        }
        if (b < 0x30) { return 1; }                      # an intermediate (ESC ( B, ESC # 8): wait for the final byte
        fb_ansi_state = 0;                               # an ESC final (ESC c, ESC 7, ...): consumed, none acted on
        return 1;
    }
    # st == 2: collecting a CSI sequence
    if (b >= 0x30 && b <= 0x39) {                        # digit -> the current param (clamped)
        if (fb_ansi_ovf == 0) {
            var pa = &fb_ansi_params + fb_ansi_nparam * 8;
            var v = load64(pa) * 10 + (b - 0x30);
            if (v > 65535) { v = 65535; }
            store64(pa, v);
        }
        fb_ansi_have_digit = 1;
        return 1;
    }
    if (b == 0x3B) {                                     # ';' -> the next param slot
        if (fb_ansi_nparam < FB_NPAR - 1) {
            fb_ansi_nparam = fb_ansi_nparam + 1;
            store64(&fb_ansi_params + fb_ansi_nparam * 8, 0);
        } else {
            fb_ansi_ovf = 1;
        }
        fb_ansi_have_digit = 0;
        return 1;
    }
    if (b >= 0x3C && b <= 0x3F) {                        # '<' '=' '>' '?': a private marker, only before any param
        if (fb_ansi_nparam == 0 && fb_ansi_have_digit == 0) { fb_ansi_priv = b; }
        return 1;
    }
    if (b == 0x3A) { return 1; }                         # ':' sub-parameters (ITU T.416) are not taken
    if (b < 0x30) { fb_ansi_inter = 1; return 1; }       # 0x20-0x2F intermediate
    # 0x40-0x7E: the final byte
    var np = 0;
    if (fb_ansi_have_digit == 1 || fb_ansi_nparam > 0) { np = fb_ansi_nparam + 1; }
    fb_ansi_state = 0;
    if (fb_ansi_inter == 0) { fb_ansi_dispatch(b, np); }
    return 1;
}

# Inside a control string (state 3) or at its ESC (state 4). BEL ends it (xterm's OSC terminator; vt.c accepts it for
# every string), ST (ESC \) ends it, CAN / SUB cancel it, an ESC followed by anything else starts that sequence;
# every other byte — C0, UTF-8, text — is swallowed, up to FB_STR_MAX of them.
fn fb_str_feed(b) {
    if (fb_ansi_state == 4) {
        if (b == 0x5C) { fb_ansi_state = 0; return 1; }  # ESC \ = ST
        fb_ansi_state = 1;
        return fb_ansi_feed(b);
    }
    if (b == 0x07) { fb_ansi_state = 0; return 1; }
    if (b == 0x1B) { fb_ansi_state = 4; return 1; }
    if (b == 0x18 || b == 0x1A) { fb_ansi_state = 0; return 1; }
    fb_str_n = fb_str_n + 1;
    if (fb_str_n > FB_STR_MAX) { fb_ansi_state = 0; return 0; }
    return 1;
}

# === 1.56.37 — DEFERRED PAINT: never draw a line at a geometry we have not verified ====================
# ⛔ THE REPLAY ALONE DID NOT FIX THE REPORTED SYMPTOM, and the reason is worth keeping. A text console has
# NO SCROLLBACK: repainting the ring after the clear only redraws the last ~18 rows that fit at 800x600,
# and every earlier line scrolls straight off. So `klug_replay_fb` made the log *complete* in a sense
# nobody can look at, while the thing the operator actually sees — the banded lines being drawn to the
# panel for ~0.2 s BEFORE the switch — was untouched, because the replay runs after they are already up.
# ⇒ To stop banding being seen, it must never be DRAWN. Everything still reaches serial and klug, so
# nothing is lost; only the panel waits.
#
# ⚠ THE COST, STATED: between fb_console_init and the release point the panel shows whatever the firmware
# left. A ring-0 boot fault still paints its canary bar (that path writes the FB directly, not through
# fb_putc), so a dead box is still visibly dead — but the text leading up to it is not on the panel, and on
# a box with no serial the klug spill (log line ~115) is the only other copy. The window this matters in is
# a fault before the geometry is known, where today's alternative is unreadable banding anyway.
#
# ⚠ FAIL-SAFE DIRECTION IS *PAINT*. fb_defer starts at 0, so a build that never calls fb_defer_begin
# behaves exactly as before. The release is called from TWO sites — gpu_scanout_matchgeom, and an
# unconditional rescue in main.cyr — so a box where matchgeom bails still gets its console.
var fb_defer = 0;
fn fb_defer_begin() { fb_defer = 1; return 0; }
fn fb_defer_off()   { fb_defer = 0; return 0; }   # geometry now known; caller does its own clear+replay
# fb_defer_rescue — THE GUARANTEE. Called unconditionally past every geometry decision: if painting is
# still deferred, nothing verified the geometry, so accept boot_info's and paint anyway. Without this a
# headless/QEMU/no-DCN box would defer forever and show a blank panel for the whole session.
fn fb_defer_rescue() {
    if (fb_defer == 0) { return 0; }
    fb_defer = 0;
    fb_console_clear();
    klug_replay_fb();
    # ⭐ SAY WHICH PATH RELEASED THE PANEL. Two very different boots reach a working console — one where
    # the DCN read verified the geometry (matchgeom, silent) and one where nothing could (this). They look
    # identical on screen, and only this line separates "the geometry is measured" from "the geometry is
    # boot_info's and unchecked". Printed AFTER the replay so it lands at the end of the restored log.
    kprintln("fb: geometry unverified -- painting at boot_info geometry", 57);
    return 0;
}
# ============================================================================================
# ⭐⭐ THE LIVE LINE — so an asynchronous log never eats what the operator is typing
# ============================================================================================
# ⛔⛔ THIS WAS RULED "WORKING AS INTENDED" AND THAT RULING WAS WRONG.
# `issues/archived/2026-08-11-hid-drain-rearm-and-isr-console-lock.md` explained why a one-shot lands mid-prompt
# and then closed the question: *"This is working as intended and should not be fixed: a boot-phase mute
# would hide exactly the lines you need when a session goes wrong."* ⚠ THE MUTE WAS A STRAW MAN — it was
# never the only alternative, and the operator had already said so. What the operator actually sees is
# their own command destroyed mid-keystroke:
#     [ASSIST] > ahid: first mouse report accumulated
#     ether      aethersafha --opacity 128 --client /present_probe
# The `a` of `aethersafha` is stranded before the log and the rest resumes on the next row.
#
# ⭐ THE THIRD OPTION LOSES NOTHING, and it is what every line editor on every OS does: SAVE the line,
# ERASE it, print the log, REPLAY it. Every log byte still reaches serial, klug and the screen in order;
# the typed line survives; nothing is muted, deferred or hidden.
#
# ⛔ CAPTURE IS FRAMEBUFFER-ONLY, ON PURPOSE. serial and klug are TRANSCRIPTS with no cursor — replaying
# there would print the prompt twice in the log and corrupt the very evidence this console exists to
# preserve. Only the fb has a cursor, so only the fb erases and replays.
# ⚠ It follows the DRAW, not the byte: `fb_defer` and `fb_console_ready` gate both, so the buffer always
# describes what is actually on the glass. A capture that ran while the draw was deferred would replay a
# line the screen never showed.
var FB_LINE_MAX = 512;      # 2560 px / 8 px per cell = 320 columns at scale 1; 512 is headroom
var fb_line_buf[64];        # module scope => 64 x u64 = 512 BYTES, addressed with store8/load8
var fb_line_n = 0;          # bytes drawn on the current row since the last newline / CR
var fb_line_hold = 0;       # 1 = do not capture: we are printing out-of-band, or replaying
# ⛔⛔ 1 = THE OPERATOR IS MID-LINE. Set by the two line-read echo sites in `core/syscall.cyr`, cleared
# the moment a newline is drawn — or, when the reader ends the line without drawing one (a hidden Enter, a Ctrl-D),
# by fb_line_end (1.57.13). **Erase-and-replay happens ONLY when this is 1**, and that gate is not
# an optimisation — without it the fix is a severe REGRESSION, caught by the sweep on its first run:
#   `kprint_num` calls `kprint`, so a kernel line like "  PASS: n of m" is assembled from ~4 separate
#   kprint calls. Erasing and replaying on each one turns an O(len) line into O(calls x len) glyph
#   draws — at scale 2 that is ~1024 pixel stores PER CHARACTER, per call. The `#92` ABI battery
#   (167 cases) starved and its verdict never printed: sweep went 19/19 -> 18/1.
# ⇒ A kernel line under construction is a CONTINUATION, not an interruption. Only a line the OPERATOR
# is typing can be interrupted, and only the line-read loops know that is happening.
var fb_line_live = 0;

# A line READER ended the operator's line WITHOUT drawing a newline: a hidden Enter under console_mode#110 NOECHO
# (syscall.cyr kbd_echo) or a Ctrl-D (EOF, or a mid-line delivery — never echoed). fb_line_note below is the only other
# place `live` drops, and it needs a DRAWN LF/CR, so without this the line stayed live: every later kprint (every
# ring-3 write(1/2) included) erased the row and replayed the prompt captured before the hidden line — a ghost prompt
# following the cursor, at the per-print cost the `live` gate exists to prevent (1.57.13 review).
# ⚠ Clears ONLY `live`, never fb_line_n: the count still describes what is ON THE ROW (the prompt is still drawn there,
# the cursor after it), so a second reader on the same row re-arms `live` and replays exactly the truth, and the
# program's own "\n" resets the count the ordinary way. Under the console lock, like kputc's capture.
fn fb_line_end(): i64 {
    console_spin_lock();
    fb_line_live = 0;
    console_spin_unlock();
    return 0;
}

# Record one drawn byte. Mirrors exactly what `fb_putc` does to the cursor below.
fn fb_line_note(ch): i64 {
    if (fb_line_hold != 0) { return 0; }
    # ⚠ A drawn newline ENDS the operator's line as well as the row — Enter echoes one. Clearing `live`
    # here rather than in the syscall keeps the two facts in one place and cannot drift.
    if (ch == 10) { fb_line_n = 0; fb_line_live = 0; return 0; }   # newline: the row is finished
    if (ch == 13) { fb_line_n = 0; fb_line_live = 0; return 0; }   # CR: the row is being overwritten
    if (ch == 8) {                                      # backspace: the editor rubbed a char out
        if (fb_line_n > 0) { fb_line_n = fb_line_n - 1; }
        return 0;
    }
    # 1.57.18: a Tab moves the cursor and a byte >= 0x80 is part of a UTF-8 glyph, so both are KEPT — the replay re-feeds
    # them through the same decoder and lands the cursor where it was. Every other C0 byte draws nothing.
    if (ch < 0x20) { if (ch != 9) { return 0; } }
    # ⚠ OVERFLOW DROPS THE TAIL RATHER THAN WRAPPING. A wrapped ring would replay the line out of order,
    # which is worse than a long line replaying short. 512 B is past the widest console row.
    if (fb_line_n >= FB_LINE_MAX) { return 0; }
    store8(&fb_line_buf + fb_line_n, ch & 0xFF);
    fb_line_n = fb_line_n + 1;
    return 0;
}

# Called by `kprint`/`kprintln` INSIDE the console lock, before the fb write. -> 1 if a line was erased
# and `fb_oob_end` must replay it, 0 if there was nothing on the row.
fn fb_oob_begin(): i64 {
    if (fb_console_ready == 0) { return 0; }
    if (fb_defer != 0) { return 0; }
    # ⛔ THE COST GATE. Nothing happens unless the operator is mid-line — see `fb_line_live`. A kernel
    # line built from several `kprint` calls must NOT erase and replay between them.
    if (fb_line_live == 0) { return 0; }
    if (fb_line_n == 0) { return 0; }
    if (fb_grid() == 0) { return 0; }
    fb_line_hold = 1;                       # the erase and the log must not be captured
    if (fb_cur_drawn != 0) { fb_cursor_undraw(); }
    # 1.57.18: the row's cells are blanked by ONE span fill (it was a fb_putc(32) per cell — through the parser, which a
    # ring-3 program may have left mid-sequence). fb_cur_x is fb_g_cols while a wrap is pending: then the whole row.
    var back = fb_cur_x;
    if (back > fb_g_cols) { back = fb_g_cols; }
    if (fb_cur_y < fb_g_rows) { fb_fill_span(fb_cur_y, 0, back, fb_bg_color); }
    fb_cur_x = 0;
    return 1;
}

# Replay the saved line so the operator's cursor lands exactly where it was.
fn fb_oob_end(did): i64 {
    if (did == 0) { fb_line_hold = 0; return 0; }
    # 1.57.18: the operator's line replays through a parser in the NORMAL state, whatever the log left it in, and the
    # log's state comes back after (slot 1 — kprint's kernel bracket owns slot 0).
    fb_pstate_push(1);
    # ⚠ `kprint` (no trailing newline) can leave the cursor mid-row; the replay needs its own row or it
    # would append the prompt to the log line — the defect, inverted.
    if (fb_cur_x != 0) { fb_putc(10); }
    for (var i = 0; i < fb_line_n; i = i + 1) { fb_putc(load8(&fb_line_buf + i)); }
    fb_pstate_pop(1);
    fb_line_hold = 0;
    return 0;
}

# ═══════════════ 1.57.18 — the byte path: UTF-8, the escape parser, controls, cells ═══════════════
# fb_putc takes ONE byte. A UTF-8 sequence in flight takes its continuation bytes first (a byte that cannot continue
# it ends it as one replacement cell, then is processed on its own); then the escape parser (fb_ansi_feed) takes what
# belongs to a sequence; what is left is a C0 control, an ASCII glyph or a UTF-8 lead byte. ⛔ The cursor bar is taken
# off the glass FIRST, before any byte can move the cursor, scroll or erase under it: a bar left drawn while its
# pixels move or are cleared is the ghost (fb_cursor_undraw). The kprint emitters draw it again once, at the end.
fn fb_putc(ch) {
    if (fb_console_ready == 0) { return 0; }
    # Deferred: the byte is already in serial + klug (kprint tapped it before reaching here). Dropping the
    # DRAW is the whole mechanism — the release replays the ring, so nothing is lost, it is only delayed.
    if (fb_defer != 0) { return 0; }
    if (fb_cur_drawn != 0) { fb_cursor_undraw(); }
    if (fb_grid() == 0) { return 0; }
    var b = ch & 0xFF;
    if (fb_u8_need > 0) {
        if (b >= fb_u8_lo && b <= fb_u8_hi) {
            fb_line_note(b);
            fb_u8_cp = (fb_u8_cp << 6) | (b & 0x3F);
            fb_u8_lo = 0x80;
            fb_u8_hi = 0xBF;
            fb_u8_need = fb_u8_need - 1;
            if (fb_u8_need == 0) { fb_emit_cp(fb_u8_cp); }
            return 0;
        }
        # The bytes so far are ONE maximal subpart: one replacement cell; then `b` is processed on its own.
        fb_u8_need = 0;
        fb_u8_lo = 0x80;
        fb_u8_hi = 0xBF;
        fb_emit_cp(0xFFFD);
    }
    # ANSI/CSI/string interception (1.43.1, widened 1.57.18). 1 = the byte belonged to a sequence.
    if (fb_ansi_feed(b) == 1) { return 0; }
    # ⭐ CAPTURE HERE, past the defer and ANSI gates, so the buffer tracks what actually reaches the
    # glass — see the live-line banner above. Cheap: a compare and a store8 per drawn byte.
    fb_line_note(b);
    if (b < 0x20) { fb_ctrl(b); return 0; }
    if (b < 0x80) { fb_emit_cell(b); return 0; }          # ASCII (0x7F draws kashi's cell 0x7F, as it always did)
    if (b >= 0xC2 && b <= 0xDF) { fb_u8_need = 1; fb_u8_cp = b & 0x1F; return 0; }
    if (b >= 0xE0 && b <= 0xEF) {
        fb_u8_need = 2;
        fb_u8_cp = b & 0x0F;
        if (b == 0xE0) { fb_u8_lo = 0xA0; }               # no overlong 3-byte form
        if (b == 0xED) { fb_u8_hi = 0x9F; }               # no surrogate
        return 0;
    }
    if (b >= 0xF0 && b <= 0xF4) {
        fb_u8_need = 3;
        fb_u8_cp = b & 0x07;
        if (b == 0xF0) { fb_u8_lo = 0x90; }               # no overlong 4-byte form
        if (b == 0xF4) { fb_u8_hi = 0x8F; }               # nothing past U+10FFFF
        return 0;
    }
    fb_emit_cp(0xFFFD);                                   # 80..BF alone, C0, C1, F5..FF: never valid where they stand
    return 0;
}

# A C0 control outside a string (inside a CSI it is executed and the sequence goes on). LF is the console's newline
# (CR + LF: there is no tty layer to add the CR — unchanged since 1.30); BS is DESTRUCTIVE as it always was here (it
# rubs the cell out: the line editors send BS SP BS either way). From the pending wrap (fb_cur_x == cols) BS lands on
# the last column, the cell the last glyph went into. HT goes to the next multiple-of-8 column, never past the last
# (xterm's fixed tab stops; the cells it passes are not touched, as on every terminal). BEL and the rest: nothing.
fn fb_ctrl(b) {
    if (fb_grid() == 0) { return 0; }
    if (b == 10) { fb_cur_x = 0; fb_newline(); return 0; }
    if (b == 13) { fb_cur_x = 0; return 0; }
    if (b == 8) {
        if (fb_cur_x > 0) {
            fb_cur_x = fb_cur_x - 1;
            if (fb_cur_x >= fb_g_cols) { fb_cur_x = fb_g_cols - 1; }      # a grid that shrank under the cursor
            if (fb_cur_y < fb_g_rows) { fb_fill_span(fb_cur_y, fb_cur_x, fb_cur_x + 1, fb_bg_color); }
        }
        return 0;
    }
    if (b == 9) {
        var last = fb_g_cols - 1;
        if (fb_cur_x < last) {
            var nx = (fb_cur_x / 8 + 1) * 8;
            if (nx > last) { nx = last; }
            fb_cur_x = nx;
        }
        return 0;
    }
    return 0;
}

# LF's row advance: the bottom row scrolls the console up one text row.
fn fb_newline() {
    fb_cur_y = fb_cur_y + 1;
    if (fb_cur_y >= fb_g_rows) {
        fb_scroll_up();
        fb_cur_y = fb_g_rows - 1;
    }
    return 0;
}

# One glyph cell at the cursor. ⭐ THE LAST COLUMN (VT100 / xterm DECAWM, vt.c vc_need_wrap): a glyph drawn in the
# last column leaves fb_cur_x == cols — the PENDING WRAP, not a wrap — and only the NEXT glyph wraps (CR + LF) before
# it draws. CR, LF, BS, CUP, EL and ED all leave it (each sets fb_cur_x < cols), so a full row followed by CR LF never
# leaves a blank line, and a full bottom row does not scroll until something is written after it. ?7l (fb_awm 0): the
# last column is overwritten instead, the cursor never leaves it.
fn fb_emit_cell(cell) {
    if (fb_cur_x >= fb_g_cols) {
        if (fb_awm == 1) {
            fb_cur_x = 0;
            fb_newline();
        } else {
            fb_cur_x = fb_g_cols - 1;
        }
    }
    if (fb_cur_y >= fb_g_rows) { fb_cur_y = fb_g_rows - 1; }   # a grid that shrank under the cursor
    fb_draw_glyph(cell, fb_cur_x, fb_cur_y);
    if (fb_awm == 0) { if (fb_cur_x == fb_g_cols - 1) { return 0; } }
    fb_cur_x = fb_cur_x + 1;
    return 0;
}

# One decoded codepoint. Its cell: kashi_cp437_from_unicode — the CP437 cell that draws it (U+2500 '─' is 0xC4, U+00E9
# 'é' is 0x82, U+2026 and U+FFFD kashi's extension cells) — else kashi's U+FFFD glyph, ONE cell, so a row keeps its
# width (vt.c vc_get_glyph: the font's glyph, else U+FFFD). Its width (fb_ucs_width): 2 draws the cell and a blank pad
# (vt.c vc_con_write_normal's second-column ' '), wrapping first when only the last column is left (xterm); 0 (a
# combining mark, a zero-width format character) draws nothing — vt.c ignores a zero-width code point it cannot
# recompose, and this console keeps no cell buffer to recompose with.
fn fb_emit_cp(cp) {
    var w = fb_ucs_width(cp);
    if (w == 0) { return 0; }
    var cell = kashi_cp437_from_unicode(cp);
    if (cell == 0) { cell = kashi_cp437_from_unicode(0xFFFD); }
    if (w == 2) {
        if (fb_awm == 1) { if (fb_cur_x == fb_g_cols - 1) { fb_cur_x = fb_g_cols; } }
        fb_emit_cell(cell);
        fb_emit_cell(32);
        return 0;
    }
    fb_emit_cell(cell);
    return 0;
}

# The cells a codepoint takes. The East-Asian Wide / Fullwidth ranges are Markus Kuhn's wcwidth (mk_wcwidth, 2007 —
# the table Linux vt.c carried as `double_width[]` before ucs.c), its two emoji blocks included; the zero-width set is
# the combining-mark BLOCKS and the zero-width format characters, not the whole Mn/Me/Cf table (a mark outside these
# blocks takes one cell — the same width a terminal without the mark's font would give it).
fn fb_ucs_width(cp) {
    if (cp < 0x300) { return 1; }
    if (cp <= 0x36F) { return 0; }                          # Combining Diacritical Marks
    if (cp >= 0x483 && cp <= 0x489) { return 0; }           # Cyrillic combining
    if (cp >= 0x591 && cp <= 0x5BD) { return 0; }           # Hebrew points
    if (cp >= 0x64B && cp <= 0x65F) { return 0; }           # Arabic harakat
    if (cp < 0x1100) { return 1; }
    if (cp <= 0x115F) { return 2; }                         # Hangul Jamo initial consonants
    if (cp >= 0x1AB0 && cp <= 0x1AFF) { return 0; }         # Combining Diacritical Marks Extended
    if (cp >= 0x1DC0 && cp <= 0x1DFF) { return 0; }         # Combining Diacritical Marks Supplement
    if (cp >= 0x200B && cp <= 0x200F) { return 0; }         # ZWSP ZWNJ ZWJ LRM RLM
    if (cp >= 0x202A && cp <= 0x202E) { return 0; }         # bidi embeddings / overrides
    if (cp >= 0x2060 && cp <= 0x2064) { return 0; }         # word joiner, invisible operators
    if (cp >= 0x20D0 && cp <= 0x20FF) { return 0; }         # Combining Marks for Symbols
    if (cp == 0x2329 || cp == 0x232A) { return 2; }         # angle brackets
    if (cp >= 0x2E80 && cp <= 0x303E) { return 2; }         # CJK radicals .. CJK symbols
    if (cp >= 0x3040 && cp <= 0xA4CF) { return 2; }         # kana .. CJK .. Yi
    if (cp >= 0xAC00 && cp <= 0xD7A3) { return 2; }         # Hangul syllables
    if (cp >= 0xF900 && cp <= 0xFAFF) { return 2; }         # CJK compatibility ideographs
    if (cp >= 0xFE00 && cp <= 0xFE0F) { return 0; }         # variation selectors
    if (cp >= 0xFE10 && cp <= 0xFE19) { return 2; }         # vertical forms
    if (cp >= 0xFE20 && cp <= 0xFE2F) { return 0; }         # combining half marks
    if (cp >= 0xFE30 && cp <= 0xFE6F) { return 2; }         # CJK compatibility forms
    if (cp == 0xFEFF) { return 0; }                         # ZWNBSP / BOM
    if (cp >= 0xFF00 && cp <= 0xFF60) { return 2; }         # fullwidth forms
    if (cp >= 0xFFE0 && cp <= 0xFFE6) { return 2; }
    if (cp >= 0x1F300 && cp <= 0x1F64F) { return 2; }       # pictographs, emoticons
    if (cp >= 0x1F900 && cp <= 0x1F9FF) { return 2; }       # supplemental pictographs
    if (cp >= 0x20000 && cp <= 0x2FFFD) { return 2; }       # CJK extension B ..
    if (cp >= 0x30000 && cp <= 0x3FFFD) { return 2; }
    if (cp >= 0xE0100 && cp <= 0xE01EF) { return 0; }       # variation selectors supplement
    return 1;
}

# Render one 8x16 VGA glyph `cell` (a kashi cell: CP437 0x20..0xFF or an extension cell) at text cell (cx, cy),
# scaling each font bit into an SxS block so the on-screen cell is cell_w x cell_h (= 8*S x 16*S), fg on bg — swapped
# under SGR 7. Inner pixel paint loop runs cell_w*cell_h store32s per glyph (128 at scale=1, 512 at scale=2).
fn fb_draw_glyph(cell, cx, cy) {
    var glyph = kashi_glyph_ptr(KASHI_FONT_VGA_8X16, cell);
    if (glyph == 0) { return 0; }
    var fb = fb_g_fb;
    var pitch = fb_g_pitch;
    var s = fb_g_s;
    var fg = fb_fg_color;
    var bg = fb_bg_color;
    if (fb_rev == 1) { fg = fb_bg_color; bg = fb_fg_color; }
    var x_px = cx * fb_g_cw;
    var y_px = FB_CONSOLE_Y0 + cy * fb_g_ch;
    # Strength-reduce the per-pixel address: Cyrius has no loop-invariant code
    # motion, so the old `scan = fb + (y_px+row*s+dy)*pitch + (x_px+col*s)*4`
    # emitted ~3 imuls per inner iteration (up to 256/glyph at scale 2). Here
    # the only multiplies per glyph are the four base terms below; row advances
    # by s*pitch, columns by s*4, scanlines by pitch — all adds. Same pixels.
    var row_pitch = s * pitch;           # bytes one scaled glyph-row spans
    var col_stride = s * 4;              # bytes one scaled column spans (s px × 4 B)
    var row_top = fb + y_px * pitch + x_px * 4;   # byte addr of glyph (row 0, col 0)
    # Shadow mirror (1.53.7): sh_delta is the loop-invariant shadow-vs-FB address
    # bias; have_sh is loop-invariant so the per-pixel branch is perfectly predicted
    # and the extra WB store hits L1 (the shadow row is hot) — negligible next to the
    # WC store that dominates. The visible FB path is byte-identical to pre-1.53.7.
    var have_sh = 0;
    var sh_delta = 0;
    if (fb_shadow != 0) { have_sh = 1; sh_delta = fb_shadow - fb; }
    for (var row = 0; row < 16; row = row + 1) {
        var bits = load8(glyph + row);
        var scan0 = row_top;             # this glyph-row's top scanline, col 0
        for (var col = 0; col < 8; col = col + 1) {
            var on = (bits >> (7 - col)) & 1;
            var color = bg;
            if (on == 1) { color = fg; }
            var scan = scan0;
            for (var dy = 0; dy < s; dy = dy + 1) {
                var px = scan;
                for (var dx = 0; dx < s; dx = dx + 1) {
                    store32(px, color);
                    if (have_sh == 1) { store32(px + sh_delta, color); }
                    px = px + 4;
                }
                scan = scan + pitch;     # next scanline within this scaled row
            }
            scan0 = scan0 + col_stride;  # next column block
        }
        row_top = row_top + row_pitch;   # next scaled glyph row
    }
    return 0;
}

fn fb_print(buf, len) {
    for (var i = 0; i < len; i = i + 1) {
        fb_putc(load8(buf + i));
    }
    return 0;
}

fn fb_println(buf, len) {
    fb_print(buf, len);
    fb_putc(10);
    return 0;
}

#ifdef FB_ANSI_SELFTEST
# 1.43.1 — ANSI/CSI/SGR parser selftest (compile-gated). Feeds escape sequences
# through fb_ansi_feed() and asserts the resulting colour / cursor STATE — a
# deterministic parser gate that needs no pixel inspection. Emits one
# `fb-ansi: PASS/FAIL <case>` line per check to serial (captured by
# scripts/smoke/fb-ansi-smoke.sh). Uses fb_ansi_feed directly (not fb_putc) so the SGR
# checks don't depend on fb_console_ready; the CUP check uses the live FB geometry
# (present under QEMU OVMF GOP). Resets colour state at the end so the boot
# console continues clean.
fn fb_ansi_feed_str(s, len) {
    var i = 0;
    while (i < len) { fb_ansi_feed(load8(s + i)); i = i + 1; }
    return 0;
}
fn fb_ansi_check(name, namelen, got, want) {
    if (got == want) {
        serial_print("fb-ansi: PASS ", 14);
        serial_println(name, namelen);
    } else {
        serial_print("fb-ansi: FAIL ", 14);
        serial_print(name, namelen);
        serial_print(" got=", 5);
        kfmt_hex0x(got);
        serial_print(" want=", 6);
        kfmt_hex0x(want);
        serial_println("", 0);
    }
    return 0;
}
fn fb_ansi_selftest() {
    fb_ansi_state = 0;
    fb_fg_color = FB_FG;
    fb_bg_color = FB_BG;
    fb_cur_x = 0;
    fb_cur_y = 0;

    # SGR 31 → red foreground (16-colour)
    fb_ansi_feed_str("\x1b[31m", 5);
    fb_ansi_check("sgr31-red-fg", 12, fb_fg_color, fb_ansi16(1));

    # SGR 0 → reset to default white
    fb_ansi_feed_str("\x1b[0m", 4);
    fb_ansi_check("sgr0-reset-fg", 13, fb_fg_color, FB_FG);

    # SGR 38;5;196 → 256-colour index 196 (the path anuenue's rainbow drives)
    fb_ansi_feed_str("\x1b[38;5;196m", 11);
    fb_ansi_check("sgr256-196-fg", 13, fb_fg_color, fb_256_rgb(196));

    # SGR 38;2;10;20;30 → truecolour
    fb_ansi_feed_str("\x1b[38;2;10;20;30m", 16);
    fb_ansi_check("sgr-truecolor-fg", 16, fb_fg_color, fb_pack(10, 20, 30));

    # SGR 42 → green background
    fb_ansi_feed_str("\x1b[42m", 5);
    fb_ansi_check("sgr42-green-bg", 14, fb_bg_color, fb_ansi16(2));

    # CUP 5;10 → cursor row 5 col 10 (1-based) → cur_y=4, cur_x=9 (0-based)
    fb_ansi_feed_str("\x1b[5;10H", 7);
    fb_ansi_check("cup-row-y4", 10, fb_cur_y, 4);
    fb_ansi_check("cup-col-x9", 10, fb_cur_x, 9);

    # ED 2J → clears + homes the cursor
    fb_cur_x = 7;
    fb_cur_y = 7;
    fb_ansi_feed_str("\x1b[2J", 4);
    fb_ansi_check("ed2j-home-x0", 12, fb_cur_x, 0);
    fb_ansi_check("ed2j-home-y0", 12, fb_cur_y, 0);

    # Leave the console in a clean default state for the rest of boot.
    fb_ansi_state = 0;
    fb_fg_color = FB_FG;
    fb_bg_color = FB_BG;
    fb_cur_x = 0;
    fb_cur_y = 0;
    serial_println("fb-ansi: selftest done", 22);
    return 0;
}
#endif

#ifdef FB_ANSI_VISUAL
# 1.43.1 — VISUAL render of the ANSI console for a QEMU screendump (compile-gated,
# separate from the headless parser selftest). Paints colour swatches through the
# REAL render path (fb_putc → fb_ansi_feed → coloured glyphs) then cli/hlt-loops so
# the framebuffer stays static for capture. Run via scripts/tool/fb-ansi-screendump.sh.
fn fb_puts0(s) {
    var i = 0;
    while (load8(s + i) != 0) { fb_putc(load8(s + i)); i = i + 1; }
    return 0;
}
fn fb_emit_dec(n) {
    if (n >= 100) { fb_putc(0x30 + (n / 100)); }
    if (n >= 10)  { fb_putc(0x30 + ((n / 10) % 10)); }
    fb_putc(0x30 + (n % 10));
    return 0;
}
# Emit `ESC[38;5;<n>m` (256-colour foreground select).
fn fb_fg256(n) {
    fb_putc(0x1B); fb_putc(0x5B);
    fb_putc(0x33); fb_putc(0x38); fb_putc(0x3B); fb_putc(0x35); fb_putc(0x3B);  # "38;5;"
    fb_emit_dec(n);
    fb_putc(0x6D);   # 'm'
    return 0;
}
fn fb_ansi_visual() {
    fb_puts0("\x1b[2J\x1b[H");
    fb_puts0("AGNOS 1.43.1  --  FB ANSI / CSI / SGR console\n\n");
    fb_puts0("16-color:  \x1b[31mRED \x1b[32mGREEN \x1b[33mYELLOW \x1b[34mBLUE \x1b[35mMAGENTA \x1b[36mCYAN\x1b[0m\n");
    fb_puts0("bright:    \x1b[91mRED \x1b[92mGREEN \x1b[93mYELLOW \x1b[94mBLUE \x1b[95mMAGENTA \x1b[96mCYAN\x1b[0m\n\n");
    # 256-colour rainbow gradient bar (the path anuenue's lolcat rainbow drives) —
    # a hand-picked sweep through the 6x6x6 cube, each cell a solid block.
    fb_puts0("256 cube:  ");
    fb_fg256(196); fb_putc(0x23); fb_fg256(202); fb_putc(0x23); fb_fg256(208); fb_putc(0x23);
    fb_fg256(214); fb_putc(0x23); fb_fg256(220); fb_putc(0x23); fb_fg256(226); fb_putc(0x23);
    fb_fg256(190); fb_putc(0x23); fb_fg256(154); fb_putc(0x23); fb_fg256(118); fb_putc(0x23);
    fb_fg256(82);  fb_putc(0x23); fb_fg256(46);  fb_putc(0x23); fb_fg256(48);  fb_putc(0x23);
    fb_fg256(50);  fb_putc(0x23); fb_fg256(51);  fb_putc(0x23); fb_fg256(45);  fb_putc(0x23);
    fb_fg256(39);  fb_putc(0x23); fb_fg256(33);  fb_putc(0x23); fb_fg256(27);  fb_putc(0x23);
    fb_fg256(21);  fb_putc(0x23); fb_fg256(57);  fb_putc(0x23); fb_fg256(93);  fb_putc(0x23);
    fb_fg256(129); fb_putc(0x23); fb_fg256(165); fb_putc(0x23); fb_fg256(201); fb_putc(0x23);
    fb_puts0("\x1b[0m\n\n");
    fb_puts0("bg test:   \x1b[41;97m RED-BG \x1b[0m \x1b[42;30m GREEN-BG \x1b[0m \x1b[44;97m BLUE-BG \x1b[0m\n\n");
    fb_puts0("truecolor: \x1b[38;2;255;128;0mORANGE 255,128,0\x1b[0m   \x1b[38;2;128;0;255mVIOLET 128,0,255\x1b[0m\n\n");
    fb_puts0("clear (ESC[2J) + cursor (ESC[H) work; this screen IS the ESC[2J result.\n");
    serial_println("fb-ansi-visual: painted swatches, halting for screendump", 56);
    # Freeze: cli + hlt loop so nothing else paints over the swatches.
    while (1 == 1) { asm { 0xFA; 0xF4; } }
    return 0;
}
#endif
