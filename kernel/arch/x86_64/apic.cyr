# === Local APIC ===
# LAPIC base: 0xFEE00000 (default, from IA32_APIC_BASE MSR 0x1B)
# Must be identity-mapped for MMIO access.
var apic_base = 0xFEE00000;
var apic_enabled = 0;
var cpu_id = 0;

fn apic_read(off) { return load32(0xFEE00000 + off); }
fn apic_write(off, val) { store32(0xFEE00000 + off, val); return 0; }

fn apic_init() {
    # Map LAPIC at 0xFEE00000 (~4GB). Needs PDPT[3] -> new PD.
    # PDPT[3] covers 3GB-4GB. PD index = (0xFEE00000 >> 21) & 0x1FF = 503
    var apic_pd = pmm_alloc();
    for (var i = 0; i < 4096; i = i + 8) { store64(apic_pd + i, 0); }
    store64(0x2000 + 3 * 8, apic_pd | 0x03);
    var apic_phys = 0xFEE00000 & 0xFFFFFFFFFFE00000;
    store64(apic_pd + 503 * 8, apic_phys | 0x83);
    # Flush TLB
    asm { mov rax, cr3; }
    asm { mov cr3, rax; }
    apic_base = 0xFEE00000;

    # Enable APIC: spurious vector register at 0xF0
    store32(0xFEE000F0, 0x1FF);

    # Read APIC ID
    cpu_id = (apic_read(0x20) >> 24) & 0xFF;

    # Set task priority to 0 (accept all interrupts)
    apic_write(0x80, 0);

    apic_enabled = 1;
    return 0;
}

fn apic_eoi() {
    apic_write(0xB0, 0);
    return 0;
}

fn apic_timer_init(vector, count) {
    # Divide config: 0x0B = divide by 1
    apic_write(0x3E0, 0x0B);
    # LVT Timer: periodic mode (bit 17), vector
    apic_write(0x320, 0x20000 | vector);
    # Initial count — determines frequency
    # ~100Hz with divide-by-1: count depends on bus frequency
    # QEMU default bus ~1GHz, so count ~10000000 for ~100Hz
    apic_write(0x380, count);
    # 1.46.x SMP sub-bite 7 (#1): record the count the BSP configured so an AP can inherit
    # the SAME reload (ap_entry, smp.cyr) instead of carrying an independently-hardcoded
    # literal that could drift from the BSP. The BSP calls this once at boot (main.cyr) long
    # before any AP wakes, so the global is always set by AP-arm time. (Whatever rate this
    # count yields on the real chip, the BSP runs it as its own 100 Hz timebase and is
    # iron-proven across every 1.4x burn — so matching it makes the AP tick identically.)
    lapic_timer_count = count;
    return 0;
}

# Non-destructive latch-read of the running PIT channel-0 16-bit down-counter.
# ch0 is the legacy IRQ0 mode-2 rate generator pic_init() left free-running
# (divisor 11932, ~100Hz). Latch cmd 0x00 = channel 0 (bits7-6=00) + latch-count
# (bits5-4=00); read data port 0x40 lo then hi. Latch snapshots a stable 16-bit
# value into an internal register that survives both reads (no lo/hi tearing) and
# does NOT reload or perturb the counter — IRQ0 cadence is untouched. Driven by
# QEMU q35 (it drives ch0 to deliver IRQ0) and by real hardware alike. Touches
# NEITHER port 0x61 NOR ch2, so it avoids the q35 ch2-OUT-bit hang (apic.cyr note).
fn pit_ch0_read() {
    outb(0x43, 0x00);
    var lo = inb(0x40) & 0xFF;
    var hi = inb(0x40) & 0xFF;
    return (hi << 8) | lo;
}

# Calibrate the LAPIC timer's divide-by-1 input frequency at boot against PIT
# channel 0, returning the periodic reload count for a TRUE 100 Hz. Runs ONCE,
# AFTER apic_init() (LAPIC mapped) and BEFORE apic_timer_init()+pic_mask_pit()
# (ch0 must still be free-running; IF=0 so no ISR races the reads). Arms the LAPIC
# timer MASKED (no IRQ) one-shot from 0xFFFFFFFF at div1 and reads its current-count
# delta over an integer number of ch0 periods. One ch0 period (11932/1193182 s) ==
# 10 ms == one 100Hz tick, so LAPIC ticks per period IS the 100Hz reload — no scaling
# multiply (no i64-overflow path). apic_read(0x390) zero-extends the 32-bit count so
# the down-count delta is always a clean positive i64. Returns 0 on an implausible
# measure; the caller falls back to the QEMU-proven 10000000 literal so a bad calib
# never bricks boot. QEMU div1 ~1GHz -> reload ~10,000,000 (no-op-equivalent); real
# Zen div1 ~83MHz -> reload ~830,000 (fixes the ~8.3Hz / 12x-slow clock).
fn lapic_calibrate() {
    apic_write(0x3E0, 0x0B);           # divide config = divide-by-1 (same domain apic_timer_init uses)
    apic_write(0x320, 0x10000);        # LVT timer: bit16 mask=1, bit17 periodic=0 (one-shot) — no IRQ
    apic_write(0x380, 0xFFFFFFFF);     # initial count -> starts the one-shot down-counter

    # Sync to a ch0 period boundary (a reload shows as cur > prev — the count jumped up).
    var prev = pit_ch0_read();
    var synced = 0;
    var guard = 0;
    while (synced == 0) {
        var c0 = pit_ch0_read();
        if (c0 > prev) { synced = 1; }
        prev = c0;
        guard = guard + 1;
        if (guard >= 20000000) { return 0; }   # PIT frozen/absent -> bail to fallback
    }

    var start_lapic = apic_read(0x390);          # LAPIC current-count at the aligned start

    # Count 8 full ch0 periods (~80 ms), each a cur > prev wrap.
    var periods = 0;
    guard = 0;
    while (periods < 8) {
        var c1 = pit_ch0_read();
        if (c1 > prev) { periods = periods + 1; }
        prev = c1;
        guard = guard + 1;
        if (guard >= 200000000) { return 0; }   # window never completes -> bail to fallback
    }

    var end_lapic = apic_read(0x390);
    var delta = start_lapic - end_lapic;         # LAPIC counted DOWN; div1 => 1 tick per input clock
    if (delta <= 0) { return 0; }
    var reload = delta / 8;                      # ticks per ch0 period == ticks per 10ms == the 100Hz reload

    # Sanity band: reject garbage. Floor 100000 admits down to a ~10MHz-class LAPIC
    # (real Zen div1 ~83MHz -> ~830000; QEMU ~1GHz -> ~10000000). Ceil rejects runaway.
    if (reload < 100000) { return 0; }
    elif (reload > 200000000) { return 0; }
    return reload;
}

# Calibrated 100Hz reload with a safe fallback. Called INLINE from main.cyr's boot
# sequence — apic_timer_init(32, lapic_reload_100hz()) — so it runs in PARSE_PROG
# order (after apic_init, PIT still live), NOT as a module-scope `var x = call()`
# (that would run during gvar-init, before apic_init — the doom-argv gvar-init trap).
# `r` is function-local, so no gvar-init concern. On a bad/absent measure calibrate
# returns 0 -> fall back to the QEMU-proven 10000000 literal (never bricks boot).
fn lapic_reload_100hz() {
    var r = lapic_calibrate();
    if (r == 0) { return 10000000; }
    return r;
}

# 1.46.x SMP sub-bite 7 (#1): the LAPIC timer reload count the BSP configured (captured in
# apic_timer_init). An AP inherits THIS in ap_entry (smp.cyr) so every CPU's scheduler tick
# runs at the BSP's exact, iron-proven rate — no independently-hardcoded AP literal that could
# drift from the BSP. 0 only before the BSP's first apic_timer_init (never, by AP-wake time).
#
# Why not measure the LAPIC frequency directly: the BSP timebase IS the LAPIC timer (pic.cyr
# masks the legacy PIT IRQ0 "once the LAPIC timer owns the timebase"), so `timer_ticks` is
# driven by it — any reprogram-to-measure freezes timer_ticks and deadlocks. A PIT-channel-2
# port-0x61 readback alternative hung under QEMU q35 (that emulation doesn't drive the ch2 OUT
# bit). Inheriting the BSP's working count sidesteps both and matches AP↔BSP exactly. True
# Hz-calibration (if ever wanted) is a separate enhancement to the BSP timebase, not AP-side.
var lapic_timer_count = 10000000;

# 1.44.21 HARDENING: bound the ICR delivery-status (bit 12) wait. The 1.44.18 AP-wake
# un-gated smp_start_aps — the ONLY caller of these two fns — so this poll now runs on
# EVERY boot (it was dead before). On real Zen the status clears in ~µs (≈tens of
# iterations), so the bound NEVER fires on success → byte-identical to the unbounded
# loop. But a non-accepting target / firmware quirk would otherwise SPIN FOREVER and
# hang the boot (the next burn's flagged riskiest item: real-Zen INIT-SIPI timing). The
# bound makes it fail-SAFE: give up and move on — a non-responding AP simply never checks
# in (harmless under the parked-AP design; smp_start_aps already tolerates absent IDs).
# ICR_DELIVERY_WAIT: ~µs success exit; the cap is a generous failure backstop (MMIO-read-
# paced, ~hundreds of ms worst case per stuck IPI), not a calibrated delay.
var ICR_DELIVERY_WAIT = 1000000;

fn apic_send_init(target) {
    apic_write(0x310, target << 24);
    # INIT: delivery=5, level=assert, trigger=level
    apic_write(0x300, 0x00C500);
    var w0 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w0 >= ICR_DELIVERY_WAIT) { break; } w0 = w0 + 1; }
    # Deassert
    apic_write(0x300, 0x008500);
    var w1 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w1 >= ICR_DELIVERY_WAIT) { break; } w1 = w1 + 1; }
    return 0;
}

fn apic_send_sipi(target, vector) {
    apic_write(0x310, target << 24);
    # SIPI: delivery=6, vector = page number (e.g., 0x08 -> AP starts at 0x8000)
    apic_write(0x300, 0x000600 | vector);
    var w2 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w2 >= ICR_DELIVERY_WAIT) { break; } w2 = w2 + 1; }
    return 0;
}

# === TLB SHOOTDOWN (2026-08-03) ==================================================================
# agnos had NO cross-CPU TLB invalidation. Every `invlpg_va()` flushes only the CPU executing it, so
# when an address space is torn down and its PML4 handed straight back out by LIFO `pmm_alloc`, other
# CPUs keep translating the NEW occupant's addresses through the OLD occupant's cached entries. The
# page tables are correct — the CPU never consults them. That is the 2026-08-02 `-smp 4` fault:
# PDEs verified present at load, at spawn and at every dispatch, yet a not-present #PF whose victim
# address moves run to run. Without PCID a CR3 VALUE is the only TLB tag there is, so a recycled PML4
# is indistinguishable from the space it replaced.
#
# Design: sender flushes locally, IPIs all-but-self on vector 0xF0, then spins until every woken CPU
# acknowledges. The handler reloads CR3 (flushes all non-global entries — coarser than per-page
# invlpg, but correct, and this path is rare). Bounded wait so a wedged CPU degrades to a stale-TLB
# risk instead of hanging the box, matching apic_send_init's ICR_DELIVERY_WAIT posture.
var tlb_shoot_probe_n = 0;
fn tlb_probe_hex(v) {
    var b[16];
    if (v == 0) { klug_append("0", 1); return 0; }
    var n = fmt_hex_buf(v, &b);
    klug_append(&b, n);
    return 0;
}
var tlb_shoot_ack = 0;
var tlb_shoot_want = 0;
var TLB_SHOOT_VECTOR = 240;          # 0xF0 — clear of 7 / 32 / 33 / 80 / 81
var TLB_SHOOT_WAIT = 2000000;

# Handler body. Reload CR3 to flush this CPU's non-global TLB, then acknowledge and EOI.
fn tlb_shootdown_handler() {
    asm {
        0x0F; 0x20; 0xD8;            # mov rax, cr3
        0x0F; 0x22; 0xD8;            # mov cr3, rax
    }
    tlb_shoot_ack = tlb_shoot_ack + 1;
    apic_eoi();
    return 0;
}

# Build the vector-0xF0 stub — timer_isr_build's shape, minus the callee-saved block (this handler
# never context-switches, so only the caller-saved set the ABI lets it clobber must be preserved).
fn tlb_isr_build() {
    var p = &tlb_isr;
    var handler_addr = &tlb_shootdown_handler;
    var off = 0;
    store8(p + off, 0x50); off = off + 1;                                   # push rax
    store8(p + off, 0x51); off = off + 1;                                   # push rcx
    store8(p + off, 0x52); off = off + 1;                                   # push rdx
    store8(p + off, 0x56); off = off + 1;                                   # push rsi
    store8(p + off, 0x57); off = off + 1;                                   # push rdi
    store8(p + off, 0x41); store8(p + off + 1, 0x50); off = off + 2;        # push r8
    store8(p + off, 0x41); store8(p + off + 1, 0x51); off = off + 2;        # push r9
    store8(p + off, 0x41); store8(p + off + 1, 0x52); off = off + 2;        # push r10
    store8(p + off, 0x41); store8(p + off + 1, 0x53); off = off + 2;        # push r11
    store8(p + off, 0x48); store8(p + off + 1, 0xB8); off = off + 2;        # mov rax, imm64
    store64(p + off, handler_addr); off = off + 8;
    store8(p + off, 0xFF); store8(p + off + 1, 0xD0); off = off + 2;        # call rax
    store8(p + off, 0x41); store8(p + off + 1, 0x5B); off = off + 2;        # pop r11
    store8(p + off, 0x41); store8(p + off + 1, 0x5A); off = off + 2;        # pop r10
    store8(p + off, 0x41); store8(p + off + 1, 0x59); off = off + 2;        # pop r9
    store8(p + off, 0x41); store8(p + off + 1, 0x58); off = off + 2;        # pop r8
    store8(p + off, 0x5F); off = off + 1;                                   # pop rdi
    store8(p + off, 0x5E); off = off + 1;                                   # pop rsi
    store8(p + off, 0x5A); off = off + 1;                                   # pop rdx
    store8(p + off, 0x59); off = off + 1;                                   # pop rcx
    store8(p + off, 0x58); off = off + 1;                                   # pop rax
    store8(p + off, 0x48); store8(p + off + 1, 0xCF); off = off + 2;        # iretq
    return 0;
}

# Fixed-delivery IPI to ONE physical APIC id. No destination shorthand: 0x004000 | vector, with the
# target in ICR-high bits 31:24.
# ⛔ DO NOT use the all-but-self shorthand (0x0C4000) here. agnos parks every AP with APIC id >= 4
# (`smp.cyr:398`, `while (1==1) { hlt }`) BEFORE that AP programs its LAPIC or unmasks anything. On a
# box with more than 4 cores — archaemenid is 8c/16t — a broadcast reaches those parked APs too, and
# what they do with an unexpected vector is not something to discover during an iron burn. Targeting
# only the CPUs agnos actually runs makes the question moot.
fn apic_send_ipi_one(target, vector) {
    apic_write(0x310, target << 24);
    apic_write(0x300, 0x004000 | vector);
    var w = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w >= ICR_DELIVERY_WAIT) { break; } w = w + 1; }
    return 0;
}

# THE PUBLIC ENTRY. Call AFTER the page-table mutation is visible in memory and BEFORE the affected
# pages can be reused. Single-core (cpu_count < 2) is a pure local flush — no IPI, no wait.
fn tlb_shootdown_all() {
    asm {
        0x0F; 0x20; 0xD8;            # mov rax, cr3
        0x0F; 0x22; 0xD8;            # mov cr3, rax   (flush THIS cpu first, always)
    }
    if (apic_enabled == 0) { return 0; }
    if (cpu_count < 2) { return 0; }
    tlb_shoot_ack = 0;
    tlb_shoot_want = cpu_count - 1;
    var me = pcpu_cpu();
    var t = 0;
    while (t < cpu_count) {
        if (t != me) { apic_send_ipi_one(t, TLB_SHOOT_VECTOR); }
        t = t + 1;
    }
    var w = 0;
    while (tlb_shoot_ack < tlb_shoot_want) {
        if (w >= TLB_SHOOT_WAIT) { break; }    # fail-safe: degrade to stale-TLB risk, never hang
        w = w + 1;
        asm { 0xF3; 0x90; }                    # pause
    }
    #ifdef TLB_SHOOT_PROBE
    # CALIBRATE THE NULL: prove the shootdown fires and that acks come back. A silent fix is
    # indistinguishable from no fix, which is how this whole investigation kept going wrong.
    if (tlb_shoot_probe_n < 6) {
        tlb_shoot_probe_n = tlb_shoot_probe_n + 1;
        klug_append("TLBSHOOT want=", 14);
        tlb_probe_hex(tlb_shoot_want);
        klug_append(" ack=", 5);
        tlb_probe_hex(tlb_shoot_ack);
        klug_append(" cpus=", 6);
        tlb_probe_hex(cpu_count);
        klug_append(" apic=", 6);
        tlb_probe_hex(apic_enabled);
        klug_append(" spins=", 7);
        tlb_probe_hex(w);
        klug_putc(10);
    }
    #endif
    return 0;
}
