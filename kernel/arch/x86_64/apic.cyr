# === Local APIC ===
# LAPIC base: 0xFEE00000 (default, from IA32_APIC_BASE MSR 0x1B)
# Must be identity-mapped for MMIO access.
var apic_base = 0xFEE00000;
var apic_enabled = 0;
var cpu_id = 0;

fn apic_read(off) { return load32(0xFEE00000 + off); }
fn apic_write(off, val) { store32(0xFEE00000 + off, val); return 0; }

fn apic_init() {
    # Map LAPIC at 0xFEE00000 (~4GB). Needs PDPT[3] -> new PD.
    # PDPT[3] covers 3GB-4GB. PD index = (0xFEE00000 >> 21) & 0x1FF = 503
    var apic_pd = pmm_alloc();
    for (var i = 0; i < 4096; i = i + 8) { store64(apic_pd + i, 0); }
    store64(0x2000 + 3 * 8, apic_pd | 0x03);
    var apic_phys = 0xFEE00000 & 0xFFFFFFFFFFE00000;
    store64(apic_pd + 503 * 8, apic_phys | 0x83);
    # Flush TLB
    asm { mov rax, cr3; }
    asm { mov cr3, rax; }
    apic_base = 0xFEE00000;

    # Enable APIC: spurious vector register at 0xF0
    store32(0xFEE000F0, 0x1FF);

    # Read APIC ID
    cpu_id = (apic_read(0x20) >> 24) & 0xFF;

    # Set task priority to 0 (accept all interrupts)
    apic_write(0x80, 0);

    apic_enabled = 1;
    return 0;
}

fn apic_eoi() {
    apic_write(0xB0, 0);
    return 0;
}

fn apic_timer_init(vector, count) {
    # Divide config: 0x0B = divide by 1
    apic_write(0x3E0, 0x0B);
    # LVT Timer: periodic mode (bit 17), vector
    apic_write(0x320, 0x20000 | vector);
    # Initial count — determines frequency
    # ~100Hz with divide-by-1: count depends on bus frequency
    # QEMU default bus ~1GHz, so count ~10000000 for ~100Hz
    apic_write(0x380, count);
    # 1.46.x SMP sub-bite 7 (#1): record the count the BSP configured so an AP can inherit
    # the SAME reload (ap_entry, smp.cyr) instead of carrying an independently-hardcoded
    # literal that could drift from the BSP. The BSP calls this once at boot (main.cyr) long
    # before any AP wakes, so the global is always set by AP-arm time. (Whatever rate this
    # count yields on the real chip, the BSP runs it as its own 100 Hz timebase and is
    # iron-proven across every 1.4x burn — so matching it makes the AP tick identically.)
    lapic_timer_count = count;
    return 0;
}

# Non-destructive latch-read of the running PIT channel-0 16-bit down-counter.
# ch0 is the legacy IRQ0 mode-2 rate generator pic_init() left free-running
# (divisor 11932, ~100Hz). Latch cmd 0x00 = channel 0 (bits7-6=00) + latch-count
# (bits5-4=00); read data port 0x40 lo then hi. Latch snapshots a stable 16-bit
# value into an internal register that survives both reads (no lo/hi tearing) and
# does NOT reload or perturb the counter — IRQ0 cadence is untouched. Driven by
# QEMU q35 (it drives ch0 to deliver IRQ0) and by real hardware alike. Touches
# NEITHER port 0x61 NOR ch2, so it avoids the q35 ch2-OUT-bit hang (apic.cyr note).
fn pit_ch0_read() {
    outb(0x43, 0x00);
    var lo = inb(0x40) & 0xFF;
    var hi = inb(0x40) & 0xFF;
    return (hi << 8) | lo;
}

# ⭐ 1.57.7 (S1b) — THE LAPIC 100 Hz RELOAD AND THE KLOG TIMEBASE MEASURED AGAINST THE ACPI PM TIMER.
# lapic_calibrate (below) counts PIT ch0 wraps by POLLING: a vCPU descheduled for more than 10 ms misses a
# wrap, the window spans k > 8 periods but is divided by 8, and under a host CPU quota BOTH the reload
# (every timer_ticks deadline, uptime_ms#40) and klog_tsc_per_us came out k/8 too high (S1 measured 2.25x
# at 50%, 2.75x at 25%). The PM timer needs no interrupt delivery and no polling cadence: a throttle
# lengthens a window, and the window measures its own length. main.cyr learns the port BEFORE apic_init
# (acpi_pm_early_probe, boot_info RSDP only) and hands it to lapic_reload_100hz; lapic_calibrate is now
# only the PM-less fallback.
# ⛔ PARSE ORDER: apic.cyr is parsed long before acpi.cyr and main.cyr, and forward VARIABLE references do
# not resolve (boot_data.cyr). So the port is a PARAMETER, and the code below READS only its own globals
# and boot_data.cyr's (klog_tsc_per_us, tsc_cal_agree). It may CALL anything (tsc_pm_read, tsc_pm_alive,
# tsc_cal_median_agree in main.cyr).
var lapic_reload_src    = 0;   # 0 = the 10000000 literal (rate unknown); 1 = ACPI PM timer (a TRUE 100 Hz); 2 = the polled PIT window (a host quota can inflate it)
var lapic_cal_port      = 0;   # the PM port the reload was measured on (0 = the PM path did not produce the reload)
var lapic_cal_try_port  = 0;   # the port handed to lapic_reload_100hz (0 = none), set unconditionally
var lapic_cal_dead      = 0;   # 1 = that port did not count (tsc_pm_alive refused it)
var lapic_cal_smp_t     = 0;   # lapic_pm_sample: rdtsc midpoint of the tightest bracket
var lapic_cal_smp_w     = 0;   # lapic_pm_sample: that bracket's width in cycles
var lapic_cal_smp_c     = 0;   # lapic_pm_sample: the LAPIC current count read inside it
var lapic_cal_win_bad   = 0;   # the last window's endpoints were too uncertain
var lapic_cal_win_tcpms = 0;   # the last window's TSC cycles per MILLIsecond
var lapic_cal_seen      = 0;   # windows that completed, whatever their LAPIC count
var lapic_cal_valid     = 0;   # completed windows with a valid LAPIC count (they seed lo/hi)
var lapic_cal_ok        = 0;   # usable windows
var lapic_cal_agree     = 0;   # usable windows that agree with the reload median (0.5%)
var lapic_cal_tagree    = 0;   # usable windows that agree with the TSC-rate median (0.5%)
var lapic_cal_lo        = 0;   # lowest valid reload
var lapic_cal_hi        = 0;   # highest valid reload

# One BRACKETED sample: {ta = rdtsc; p = PM; c = LAPIC current count; tb = rdtsc}, 4 tries back to back,
# keeping the tightest (the tsc_pm_sample shape plus one MMIO read). Both reads sit inside the bracket,
# so their skew is bounded by its width. Returns p; midpoint/width/count go to lapic_cal_smp_t/_w/_c.
# No asm: rdtsc, inl (tsc_pm_read) and apic_read carry their own contracts.
fn lapic_pm_sample(port) {
    var ls_bw = 0x7FFFFFFFFFFFFFFF;
    var ls_bt = 0;
    var ls_bp = 0;
    var ls_bc = 0;
    var ls_i = 0;
    while (ls_i < 4) {
        var ls_a = rdtsc();
        var ls_p = tsc_pm_read(port);
        var ls_c = apic_read(0x390);
        var ls_b = rdtsc();
        var ls_w = ls_b - ls_a;
        if (ls_w >= 0) {
            if (ls_w < ls_bw) {
                ls_bw = ls_w;
                ls_bt = ls_a + ls_w / 2;
                ls_bp = ls_p;
                ls_bc = ls_c;
            }
        }
        ls_i = ls_i + 1;
    }
    lapic_cal_smp_t = ls_bt;
    lapic_cal_smp_w = ls_bw;
    lapic_cal_smp_c = ls_bc;
    return ls_bp;
}

# One ~10 ms window (35795 PM counts). Returns 0 when the reference stopped (aborts the tier), 0 - 1 when
# the window completed with no valid LAPIC count, else the reload (LAPIC div-1 counts per 10 ms), > 0.
# Also leaves the window's TSC cycles per MILLIsecond in lapic_cal_win_tcpms and its uncertainty flag in
# lapic_cal_win_bad. The masked one-shot is re-armed from 0xFFFFFFFF for EVERY window.
fn lapic_pm_window(port) {
    lapic_cal_win_bad = 0;
    lapic_cal_win_tcpms = 0;
    apic_write(0x380, 0xFFFFFFFF);
    var lw_p0 = lapic_pm_sample(port);
    var lw_t0 = lapic_cal_smp_t;
    var lw_w0 = lapic_cal_smp_w;
    var lw_c0 = lapic_cal_smp_c;
    var lw_go = 1;
    while (lw_go == 1) {
        if (((tsc_pm_read(port) - lw_p0) & 0xFFFFFF) >= 35795) {
            lw_go = 0;
        } else {
            if ((rdtsc() - lw_t0) > 0x800000000) { return 0; }   # ~2^35 cycles and no 10 ms of PM: it stopped
        }
    }
    var lw_p1 = lapic_pm_sample(port);
    var lw_t1 = lapic_cal_smp_t;
    var lw_w1 = lapic_cal_smp_w;
    var lw_c1 = lapic_cal_smp_c;
    var lw_dpm = (lw_p1 - lw_p0) & 0xFFFFFF;
    var lw_dt = lw_t1 - lw_t0;
    var lw_dc = lw_c0 - lw_c1;          # the LAPIC counts DOWN
    if (lw_dpm == 0) { return 0; }
    if (lw_dt <= 0) { return 0; }
    if (lw_dt > 0x10000000000) { return 0; }   # i64 guard for the products below
    if (lw_c1 == 0) { return 0 - 1; }          # the one-shot expired inside the window
    if (lw_dc <= 0) { return 0 - 1; }
    if (lw_w0 > lw_dt) { lapic_cal_win_bad = 1; }
    if (lw_w1 > lw_dt) { lapic_cal_win_bad = 1; }
    if (lapic_cal_win_bad == 0) {
        if ((lw_w0 + lw_w1) * 200 > lw_dt) { lapic_cal_win_bad = 1; }   # endpoints worse than 0.5%
    }
    if (lapic_cal_win_bad == 0) {
        if (lw_dpm > 0x800000) { lapic_cal_win_bad = 1; }   # more than half the 24-bit wrap: ambiguous
    }
    lapic_cal_win_tcpms = lw_dt * 3579545 / (lw_dpm * 1000);   # < 2^62
    var lw_rl = lw_dc * 3579545 / (lw_dpm * 100);              # counts per 10 ms; < 2^54
    if (lw_rl <= 0) { return 0 - 1; }
    return lw_rl;
}

# The PM-timer tier: the median of 5 usable windows (at most 8 tries), 3 of which must agree with it
# within 0.5% — for the reload AND for the TSC rate of the same windows. Returns the median reload, or
# 0 = refused. ⛔ BOTH OR NEITHER: klog_tsc_per_us is written only on success, so a refused tier leaves the
# PIT fallback to measure both, and a log timebase never pairs with a reload from another reference.
fn lapic_calibrate_pm(port) {
    var lc_r[64];   # ⛔ FUNCTION-LOCAL: 64 BYTES = 8 u64 slots lc_r[0..7]. want <= 5, so the index is <= 4.
    var lc_t[64];   # ⛔ FUNCTION-LOCAL: 64 BYTES = 8 u64 slots, same bound.
    lapic_cal_seen = 0;
    lapic_cal_valid = 0;
    lapic_cal_ok = 0;
    lapic_cal_agree = 0;
    lapic_cal_tagree = 0;
    lapic_cal_lo = 0;
    lapic_cal_hi = 0;
    apic_write(0x3E0, 0x0B);           # divide config = divide-by-1 (same domain apic_timer_init uses)
    apic_write(0x320, 0x10000);        # LVT timer: bit16 mask=1, one-shot — no IRQ
    var lc_want = 5;
    var lc_n = 0;
    var lc_tries = 0;
    while (lc_tries < 8) {
        if (lc_n >= lc_want) { break; }
        var lc_w = lapic_pm_window(port);
        lc_tries = lc_tries + 1;
        if (lc_w == 0) { break; }
        lapic_cal_seen = lapic_cal_seen + 1;
        if (lc_w > 0) {
            lapic_cal_valid = lapic_cal_valid + 1;
            if (lapic_cal_valid == 1) {
                lapic_cal_lo = lc_w;
                lapic_cal_hi = lc_w;
            }
            if (lc_w < lapic_cal_lo) { lapic_cal_lo = lc_w; }
            if (lc_w > lapic_cal_hi) { lapic_cal_hi = lc_w; }
            var lc_use = 0;
            if (lapic_cal_win_bad == 0) {
                if (lc_w >= 100000) {
                    if (lc_w <= 200000000) {
                        if (lapic_cal_win_tcpms >= 100000) {
                            if (lapic_cal_win_tcpms <= 10000000) { lc_use = 1; }
                        }
                    }
                }
            }
            if (lc_use == 1) {
                store64(&lc_r + lc_n * 8, lc_w);
                store64(&lc_t + lc_n * 8, lapic_cal_win_tcpms);
                lc_n = lc_n + 1;
            }
        }
    }
    lapic_cal_ok = lc_n;
    if (lc_n < 3) { return 0; }
    var lc_mr = tsc_cal_median_agree(&lc_r, lc_n, 200);
    lapic_cal_agree = tsc_cal_agree;
    var lc_mt = tsc_cal_median_agree(&lc_t, lc_n, 200);
    lapic_cal_tagree = tsc_cal_agree;
    if (lc_mr == 0) { return 0; }
    if (lc_mt == 0) { return 0; }
    klog_tsc_per_us = lc_mt / 1000;
    return lc_mr;
}

# The PM-LESS FALLBACK (since 1.57.7 S1b; the PM timer is the reference when the early probe found one).
# Calibrate the LAPIC timer's divide-by-1 input frequency at boot against PIT
# channel 0, returning the periodic reload count for a TRUE 100 Hz. Runs ONCE,
# AFTER apic_init() (LAPIC mapped) and BEFORE apic_timer_init()+pic_mask_pit()
# (ch0 must still be free-running; IF=0 so no ISR races the reads). Arms the LAPIC
# timer MASKED (no IRQ) one-shot from 0xFFFFFFFF at div1 and reads its current-count
# delta over an integer number of ch0 periods. One ch0 period (11932/1193182 s) ==
# 10 ms == one 100Hz tick, so LAPIC ticks per period IS the 100Hz reload — no scaling
# multiply (no i64-overflow path). apic_read(0x390) zero-extends the 32-bit count so
# the down-count delta is always a clean positive i64. Returns 0 on an implausible
# measure; the caller falls back to the QEMU-proven 10000000 literal so a bad calib
# never bricks boot. QEMU div1 ~1GHz -> reload ~10,000,000 (no-op-equivalent); real
# Zen div1 ~83MHz -> reload ~830,000 (fixes the ~8.3Hz / 12x-slow clock).
fn lapic_calibrate() {
    apic_write(0x3E0, 0x0B);           # divide config = divide-by-1 (same domain apic_timer_init uses)
    apic_write(0x320, 0x10000);        # LVT timer: bit16 mask=1, bit17 periodic=0 (one-shot) — no IRQ
    apic_write(0x380, 0xFFFFFFFF);     # initial count -> starts the one-shot down-counter

    # Sync to a ch0 period boundary (a reload shows as cur > prev — the count jumped up).
    var prev = pit_ch0_read();
    var synced = 0;
    var guard = 0;
    while (synced == 0) {
        var c0 = pit_ch0_read();
        if (c0 > prev) { synced = 1; }
        prev = c0;
        guard = guard + 1;
        if (guard >= 20000000) { return 0; }   # PIT frozen/absent -> bail to fallback
    }

    var start_lapic = apic_read(0x390);          # LAPIC current-count at the aligned start
    # ⭐ 1.56.58 — ON A PM-LESS BOX THE KERNEL LOG TIMEBASE RIDES THIS WINDOW FOR FREE. The loop below already measures
    # a known wall interval (8 ch0 periods) against a free-running PIT, needs NO interrupts, and runs
    # near the top of main.cyr's boot body. Two rdtsc reads convert it into cycles-per-microsecond
    # ~4,400 statements before `tsc_calibrate()` (main.cyr, the call right after the boot body's `sti`)
    # produces the same number — which matters because a timer_ticks-derived clock reads 0 until that
    # `sti`, i.e. for essentially the whole boot log, and `timer_ticks` additionally FREEZES inside a
    # foreground `run` (ring 3 executes IF=0).
    # ⚠ THIS WINDOW IS POLLED, SO A HOST CPU QUOTA CAN INFLATE IT. The loop below counts ch0 wraps by
    # polling; a vCPU descheduled for longer than one 10 ms period misses a wrap, and then BOTH the
    # LAPIC reload (the 100 Hz tick, so uptime_ms#40) and klog_tsc_per_us come out high by the same
    # factor. Since 1.57.7 (S1b) this runs ONLY when lapic_calibrate_pm (above) could not: no PM timer
    # found by the early probe, a port that does not count, or a refused PM tier — lapic_reload_src 2
    # records it, and the boot log says so (lapic_reload_report).
    # ⚠ Writes klog_tsc_per_us, NOT tsc_per_us — see the note in arch/x86_64/boot_data.cyr for why
    # those must stay distinct (uptime_us#95`s meaning, and hda/gpu`s documented pre-calibration
    # fallback both depend on tsc_per_us staying 0 until main.cyr).
    var start_tsc = rdtsc();

    # Count 8 full ch0 periods (~80 ms), each a cur > prev wrap.
    var periods = 0;
    guard = 0;
    while (periods < 8) {
        var c1 = pit_ch0_read();
        if (c1 > prev) { periods = periods + 1; }
        prev = c1;
        guard = guard + 1;
        if (guard >= 200000000) { return 0; }   # window never completes -> bail to fallback
    }

    var end_lapic = apic_read(0x390);
    var end_tsc   = rdtsc();
    # 8 ch0 periods == 8 * 11932/1193182 s == 80,001.2 us. Integer 80001 is within 15 ppm of the true
    # window and is the same 15.1 ppm the 100 Hz tick itself carries, so this adds no new error.
    # Sanity band mirrors tsc_calibrate()`s: below 100 MHz or above 10 GHz means the PIT misbehaved,
    # and a refused calibration must leave 0 (the log then renders 0.000000) rather than ship a
    # divisor that skews every timestamp built on it.
    var kcyc = end_tsc - start_tsc;
    if (kcyc > 0) {
        var kper = kcyc / 80001;
        if (kper >= 100) { if (kper <= 10000) { klog_tsc_per_us = kper; } }
    }
    var delta = start_lapic - end_lapic;         # LAPIC counted DOWN; div1 => 1 tick per input clock
    if (delta <= 0) { return 0; }
    var reload = delta / 8;                      # ticks per ch0 period == ticks per 10ms == the 100Hz reload

    # Sanity band: reject garbage. Floor 100000 admits down to a ~10MHz-class LAPIC
    # (real Zen div1 ~83MHz -> ~830000; QEMU ~1GHz -> ~10000000). Ceil rejects runaway.
    if (reload < 100000) { return 0; }
    elif (reload > 200000000) { return 0; }
    return reload;
}

# Calibrated 100Hz reload with a safe fallback. Called INLINE from main.cyr's boot
# sequence — apic_timer_init(32, lapic_reload_100hz(ep_port)) — so it runs in PARSE_PROG
# order (after apic_init, PIT still live), NOT as a module-scope `var x = call()`
# (that would run during gvar-init, before apic_init — the doom-argv gvar-init trap).
# `r` is function-local, so no gvar-init concern. On a bad/absent measure calibrate
# returns 0 -> fall back to the QEMU-proven 10000000 literal (never bricks boot).
#
# 1.57.6: lapic_reload_measured records WHETHER the reload was measured. tsc_calibrate's fallback tier
# (live ticks, main.cyr) derives cycles-per-microsecond from "one tick = 10 ms", which is a guess on
# the 10000000-literal fallback, so that tier refuses to run there.
# 1.57.7 (S1b): pm_port (the early probe's port, 0 = none) is tried FIRST — lapic_calibrate_pm, a TRUE
# 100 Hz (lapic_reload_src 1). A dead port or a refused PM tier falls back to the polled PIT window
# (src 2), and that to the literal (src 0). ⚠ lapic_reload_measured == 1 still does NOT prove 100 Hz
# (the PIT window can be inflated by a host CPU quota); only lapic_reload_src == 1 does.
var lapic_reload_measured = 0;   # 1 = the reload was MEASURED (PM timer or PIT, see lapic_reload_src), 0 = the 10000000 literal

fn lapic_reload_100hz(pm_port) {
    lapic_reload_src = 0;
    lapic_cal_port = 0;
    lapic_cal_dead = 0;
    lapic_cal_try_port = pm_port;
    lapic_cal_seen = 0;
    lapic_cal_valid = 0;
    lapic_cal_ok = 0;
    var lr_r = 0;
    if (pm_port != 0) {
        if (tsc_pm_alive(pm_port) == 1) {
            lr_r = lapic_calibrate_pm(pm_port);
            if (lr_r != 0) {
                lapic_reload_src = 1;
                lapic_cal_port = pm_port;
            }
        } else {
            lapic_cal_dead = 1;
        }
    }
    if (lr_r == 0) {
        lr_r = lapic_calibrate();             # the PIT method, UNCHANGED: the PM-less fallback
        if (lr_r != 0) { lapic_reload_src = 2; }
    }
    if (lr_r == 0) {
        lapic_reload_measured = 0;
        return 10000000;
    }
    lapic_reload_measured = 1;
    return lr_r;
}

# The boot log's account of WHICH reference measured the tick (main.cyr, right after `LAPIC: reload=`).
# A refused PM tier prints what it measured, so the bound it crossed is in the log. Reads only apic.cyr
# globals. Always ends with exactly one source line (tsc-smoke T2 matches the src-1 form).
fn lapic_reload_report() {
    if (lapic_cal_dead == 1) {
        kprint("lapic: acpi pm timer at port ", 29); kprint_hex(lapic_cal_try_port);
        kprintln(" does not count -- the tick is measured against the PIT", 55);
    } else {
        if (lapic_cal_try_port != 0) {
            if (lapic_reload_src != 1) {
                if (lapic_cal_seen == 0) {
                    kprintln("lapic: acpi pm timer REFUSED -- no window completed; the reference stopped", 74);
                } else {
                    if (lapic_cal_valid == 0) {
                        kprint("lapic: acpi pm timer REFUSED -- ", 32); kprint_num(lapic_cal_seen);
                        kprintln(" windows completed, none with a valid LAPIC count", 49);
                    } else {
                        kprint("lapic: acpi pm timer REFUSED -- ", 32); kprint_num(lapic_cal_ok);
                        kprint(" of ", 4); kprint_num(lapic_cal_seen);
                        kprint(" windows usable; reload measured ", 33); kprint_num(lapic_cal_lo);
                        kprint("..", 2); kprint_num(lapic_cal_hi);
                        kprintln("", 0);
                        if (lapic_cal_ok >= 3) {
                            if (lapic_cal_agree < 3) {
                                kprint("lapic:   only ", 14); kprint_num(lapic_cal_agree);
                                kprintln(" of them agree with their median reload", 39);
                            } else {
                                kprintln("lapic:   the reload agreed but the tsc rate of the same windows did not", 71);
                            }
                        }
                    }
                }
            }
        }
    }
    if (lapic_reload_src == 1) {
        kprint("lapic: 100 Hz reload measured against the acpi pm timer (", 57); kprint_num(lapic_cal_agree);
        kprint(" of ", 4); kprint_num(lapic_cal_ok);
        kprintln(" windows agree)", 15);
    }
    if (lapic_reload_src == 2) {
        kprintln("lapic: 100 Hz reload measured against the PIT (polled -- a host CPU quota can inflate it)", 89);
    }
    if (lapic_reload_src == 0) {
        kprintln("lapic: 100 Hz reload NOT measured -- the 10000000 literal (tick rate unknown)", 77);
    }
    return 0;
}

# 1.46.x SMP sub-bite 7 (#1): the LAPIC timer reload count the BSP configured (captured in
# apic_timer_init). An AP inherits THIS in ap_entry (smp.cyr) so every CPU's scheduler tick
# runs at the BSP's exact, iron-proven rate — no independently-hardcoded AP literal that could
# drift from the BSP. 0 only before the BSP's first apic_timer_init (never, by AP-wake time).
#
# Why not measure the LAPIC frequency directly: the BSP timebase IS the LAPIC timer (pic.cyr
# masks the legacy PIT IRQ0 "once the LAPIC timer owns the timebase"), so `timer_ticks` is
# driven by it — any reprogram-to-measure freezes timer_ticks and deadlocks. A PIT-channel-2
# port-0x61 readback alternative hung under QEMU q35 (that emulation doesn't drive the ch2 OUT
# bit). Inheriting the BSP's working count sidesteps both and matches AP↔BSP exactly. True
# Hz-calibration (if ever wanted) is a separate enhancement to the BSP timebase, not AP-side.
var lapic_timer_count = 10000000;

# 1.44.21 HARDENING: bound the ICR delivery-status (bit 12) wait. The 1.44.18 AP-wake
# un-gated smp_start_aps — the ONLY caller of these two fns — so this poll now runs on
# EVERY boot (it was dead before). On real Zen the status clears in ~µs (≈tens of
# iterations), so the bound NEVER fires on success → byte-identical to the unbounded
# loop. But a non-accepting target / firmware quirk would otherwise SPIN FOREVER and
# hang the boot (the next burn's flagged riskiest item: real-Zen INIT-SIPI timing). The
# bound makes it fail-SAFE: give up and move on — a non-responding AP simply never checks
# in (harmless under the parked-AP design; smp_start_aps already tolerates absent IDs).
# ICR_DELIVERY_WAIT: ~µs success exit; the cap is a generous failure backstop (MMIO-read-
# paced, ~hundreds of ms worst case per stuck IPI), not a calibrated delay.
var ICR_DELIVERY_WAIT = 1000000;

fn apic_send_init(target) {
    apic_write(0x310, target << 24);
    # INIT: delivery=5, level=assert, trigger=level
    apic_write(0x300, 0x00C500);
    var w0 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w0 >= ICR_DELIVERY_WAIT) { break; } w0 = w0 + 1; }
    # Deassert
    apic_write(0x300, 0x008500);
    var w1 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w1 >= ICR_DELIVERY_WAIT) { break; } w1 = w1 + 1; }
    return 0;
}

fn apic_send_sipi(target, vector) {
    apic_write(0x310, target << 24);
    # SIPI: delivery=6, vector = page number (e.g., 0x08 -> AP starts at 0x8000)
    apic_write(0x300, 0x000600 | vector);
    var w2 = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w2 >= ICR_DELIVERY_WAIT) { break; } w2 = w2 + 1; }
    return 0;
}

# === TLB SHOOTDOWN (2026-08-03) ==================================================================
# agnos had NO cross-CPU TLB invalidation. Every `invlpg_va()` flushes only the CPU executing it, so
# when an address space is torn down and its PML4 handed straight back out by LIFO `pmm_alloc`, other
# CPUs keep translating the NEW occupant's addresses through the OLD occupant's cached entries. The
# page tables are correct — the CPU never consults them. That is the 2026-08-02 `-smp 4` fault:
# PDEs verified present at load, at spawn and at every dispatch, yet a not-present #PF whose victim
# address moves run to run. Without PCID a CR3 VALUE is the only TLB tag there is, so a recycled PML4
# is indistinguishable from the space it replaced.
#
# Design: sender flushes locally, IPIs all-but-self on vector 0xF0, then spins until every woken CPU
# acknowledges. The handler reloads CR3 (flushes all non-global entries — coarser than per-page
# invlpg, but correct, and this path is rare). Bounded wait so a wedged CPU degrades to a stale-TLB
# risk instead of hanging the box, matching apic_send_init's ICR_DELIVERY_WAIT posture.
var tlb_shoot_probe_n = 0;
fn tlb_probe_hex(v) {
    var b[24];   # 1.56.52: fmt_hex_buf writes 17 B (16 digits + NUL) — [16] was a 1-byte OOB stack write
    if (v == 0) { klug_append("0", 1); return 0; }
    var n = fmt_hex_buf(v, &b);
    klug_append(&b, n);
    return 0;
}
var tlb_shoot_ack = 0;
var tlb_shoot_want = 0;
# ⛔⛔ 1.56.51 — THE HANDSHAKE WAS TWO UNLOCKED GLOBALS AND A NON-ATOMIC INCREMENT, so the mechanism
# built to PREVENT a stale TLB silently degraded to one whenever two CPUs shot down at once. Three
# compounding defects, all fixed here:
#   (1) `tlb_shoot_ack = tlb_shoot_ack + 1` in the handler is a read-modify-write executed by up to
#       three APs simultaneously — acks were simply lost. Now an atomic `lock inc` (tlb_ack_inc).
#   (2) A second sender's `tlb_shoot_ack = 0` wiped the first sender's tally MID-FLIGHT. The whole
#       reset/IPI/wait sequence is now serialised under tlb_shoot_lock, a dedicated leaf lock —
#       tlb_shootdown_all acquires nothing else, so it slots cleanly into smp.cyr's lock order.
#   (3) THE ONE THAT MADE THE OTHER TWO UNRECOVERABLE: every caller is a ring-3 syscall handler and
#       SFMASK 0x40700 clears IF on SYSCALL entry, so a spinning sender runs with IF=0 and CANNOT
#       take the other sender's vector-0xF0 IPI. Two concurrent shootdowns therefore blocked each
#       other until BOTH timed out, and both then proceeded with the flush unperformed. A lock alone
#       does not fix this — it just moves the block into the lock acquire. So a spinning CPU now
#       SERVICES its own pending shootdown inline (tlb_service_self), which is what lets the peer
#       make progress while this CPU is still IF=0.
# ⚠ The per-CPU pending flag is what keeps inline service and the real IPI from double-acking: the
# flag is taken ATOMICALLY (xchg), and whichever path takes it is the one that acks. The other sees
# 0 and only EOIs.
# ⚠ The 2,000,000-iteration bound is DELIBERATELY KEPT as the backstop. It is the reason a wedged
# CPU degrades instead of hanging the box, and none of the above removes the need for it.
var tlb_shoot_lock = 0;
var pcpu_tlb_pending[4];

# Atomic `lock inc [tlb_shoot_ack]`. Frame shape is spin_unlock's (one local `addr` at [rbp-0x08]) —
# the fixed-global, no-parameter form this file's lock-order banner requires; a parameterised
# variant was removed at 1.46.x precisely because cyrius spills the param and shifts these offsets.
# ⚠ REGISTER CONTRACT: reads `addr` from [rbp-0x08]; clobbers rax; no outputs.
fn tlb_ack_inc() {
    var addr = &tlb_shoot_ack;
    asm {
        0x48; 0x8B; 0x45; 0xF8;      # mov rax, [rbp-0x08] (addr)
        0xF0; 0x48; 0xFF; 0x00;      # lock inc qword [rax]
    }
    return 0;
}

# Atomically take THIS CPU's pending flag: returns its old value and leaves it 0.
# ⚠ REGISTER CONTRACT: `addr` at [rbp-0x10], `old` at [rbp-0x08] — spin_lock's exact frame shape.
# Clobbers rax, rcx.
fn tlb_pending_take() {
    var old = 0;
    var addr = &pcpu_tlb_pending + pcpu_cpu() * 8;
    asm {
        0x48; 0x8B; 0x45; 0xF0;      # mov rax, [rbp-0x10] (addr)
        0x48; 0x31; 0xC9;            # xor rcx, rcx
        0x48; 0x87; 0x08;            # xchg [rax], rcx
        0x48; 0x89; 0x4D; 0xF8;      # mov [rbp-0x08], rcx (old)
    }
    return old;
}

fn tlb_shoot_spin_lock() {
    preempt_disable();                                  # 1.57.6 (S3.2): a held plain spinlock is NON-PREEMPTIBLE (see smp.cyr's lock banner)
    var old = 1;
    while (old == 1) {
        var addr = &tlb_shoot_lock;
        asm {
            0x48; 0x8B; 0x45; 0xF0;                      # mov rax, [rbp-0x10] (addr)
            0x48; 0xC7; 0xC1; 0x01; 0x00; 0x00; 0x00;    # mov rcx, 1
            0x48; 0x87; 0x08;                            # xchg [rax], rcx
            0x48; 0x89; 0x4D; 0xF8;                      # mov [rbp-0x08], rcx (old)
        }
        tlb_service_self();      # ⭐ service the PEER while waiting — see defect (3) above
    }
    return 0;
}
fn tlb_shoot_spin_unlock() {
    var addr = &tlb_shoot_lock;
    asm {
        0x48; 0x8B; 0x45; 0xF8;      # mov rax, [rbp-0x08] (addr)
        0x48; 0x31; 0xC9;            # xor rcx, rcx
        0x48; 0x87; 0x08;            # xchg [rax], rcx
    }
    preempt_enable();                                   # 1.57.6 (S3.2): pairs the preempt_disable in the lock
    return 0;
}

# ⭐ VALIDATE THE HAND-ASM FRAME CONTRACT AT BOOT, because every function above addresses its locals
# through hardcoded [rbp-N] offsets and a wrong offset is SILENT: the xchg would simply operate on
# some other address, the lock would never be held, and the serialisation this file just gained
# would be decorative. That is not hypothetical in this codebase — a parameterised spin_lock_at()
# was removed at 1.46.x for exactly this (cyrius spilled the param, the asm read its "addr" from the
# slot holding `old`, and it xchg'd ADDRESS 1), and aarch64's timer.cyr still has five asm blocks
# addressing [sp,#0] that is frame padding rather than the intended local.
# Runs on the BSP before any AP is woken, so single-threaded and lock-free by construction.
# Returns 1 if every primitive moved the memory it claims to; 0 otherwise (reported by the caller).
fn tlb_lock_selftest() {
    var ok = 1;
    if (tlb_shoot_lock != 0) { ok = 0; }              # must start released
    tlb_shoot_spin_lock();
    if (tlb_shoot_lock != 1) { ok = 0; }              # xchg wrote the REAL global
    tlb_shoot_spin_unlock();
    if (tlb_shoot_lock != 0) { ok = 0; }              # and released it
    # tlb_ack_inc must move tlb_shoot_ack by exactly one.
    var a0 = tlb_shoot_ack;
    tlb_ack_inc();
    if (tlb_shoot_ack != a0 + 1) { ok = 0; }
    tlb_shoot_ack = a0;
    # tlb_pending_take must return the old value AND clear the slot.
    store64(&pcpu_tlb_pending + pcpu_cpu() * 8, 1);
    if (tlb_pending_take() != 1) { ok = 0; }
    if (load64(&pcpu_tlb_pending + pcpu_cpu() * 8) != 0) { ok = 0; }
    if (tlb_pending_take() != 0) { ok = 0; }          # idempotent once taken
    # 1.56.52 — the online MASK, not the count, is what the shootdown targets. No AP has been woken
    # at this point in boot, so the assertable facts are the invariants that hold for every mask:
    # bit 0 (the BSP) is always set, and no bit outside 0..3 can be — pcpu_tlb_pending has four slots
    # and apic_send_ipi_one would otherwise be handed an APIC id agnos never starts.
    var m = cpu_online_mask();
    if ((m & 1) != 1) { ok = 0; }                     # BSP must always be present
    if ((m & 0xFFFFFFFFFFFFFFF0) != 0) { ok = 0; }    # nothing above id 3
    return ok;
}

# cpu_online_mask() — the SET of online APIC ids as a bitmask, which is what the shootdown must
# target. Bit 0 is the BSP, always online and never represented in ap_online_mask (only ap_entry
# sets bits, and the BSP does not run it). Bits 1..3 come from ap_online_mask, set by each AP under
# smp.cyr's spinlock keyed on its OWN APIC id.
# ⛔ `cpu_count` is NOT a substitute: it is the CARDINALITY of this set, and the two coincide only
# when the online CPUs form a dense prefix. See the ⛔⛔ note in tlb_shootdown_all.
fn cpu_online_mask() {
    return 1 | ap_online_mask;
}

# Flush + ack THIS CPU's pending shootdown, if one is outstanding. Called from the two spin loops so
# an IF=0 CPU still answers a peer. No EOI here — no interrupt was taken; the real IPI arrives later,
# finds the flag already taken, and only EOIs.
fn tlb_service_self() {
    if (tlb_pending_take() == 1) {
        asm {
            0x0F; 0x20; 0xD8;        # mov rax, cr3
            0x0F; 0x22; 0xD8;        # mov cr3, rax
        }
        tlb_ack_inc();
    }
    return 0;
}
var TLB_SHOOT_VECTOR = 240;          # 0xF0 — clear of 7 / 32 / 33 / 80 / 81
var TLB_SHOOT_WAIT = 2000000;

# Handler body. Reload CR3 to flush this CPU's non-global TLB, then acknowledge and EOI.
fn tlb_shootdown_handler() {
    asm {
        0x0F; 0x20; 0xD8;            # mov rax, cr3
        0x0F; 0x22; 0xD8;            # mov cr3, rax
    }
    # 1.56.51: ack ONLY if this CPU's pending flag is still set. tlb_service_self may already have
    # flushed-and-acked for this request from inside a spin loop, in which case the flag is gone and
    # this delivery must not ack a second time — a double ack would let a sender believe a THIRD
    # CPU had answered. The CR3 reload above is unconditional and harmless either way.
    if (tlb_pending_take() == 1) { tlb_ack_inc(); }
    apic_eoi();
    return 0;
}

# Build the vector-0xF0 stub — timer_isr_build's shape, minus the callee-saved block (this handler
# never context-switches, so only the caller-saved set the ABI lets it clobber must be preserved).
# 1.57.7 (S3d): the body is isr_caller_saved_build below, SHARED with the 0xE1 reschedule-kick stub
# (sched.cyr resched_kick_isr_build) — one copy of the byte sequence, byte-identical output.
fn tlb_isr_build() {
    isr_caller_saved_build(&tlb_isr, &tlb_shootdown_handler);
    return 0;
}

# The caller-saved ISR stub shape, 43 bytes, into `p`: clac; push the nine caller-saved GPRs; mov rax, handler;
# call rax; pop them; iretq (bytes 41-42). Used by the TLB-shootdown stub (0xF0) and, since 1.57.7, the reschedule
# kick (0xE1). REGISTER CONTRACT of the stub: clac clears RFLAGS.AC (hardware does not on delivery — see below); the
# nine caller-saved GPRs are preserved around the call; the callee-saved ones are the handler's to keep (it is a
# cyrius function); rax carries the handler address into the call.
fn isr_caller_saved_build(p, handler_addr) {
    var off = 0;
    # 1.57.7 (S3.4) — clac FIRST: no inputs/outputs; clears RFLAGS.AC. Hardware does not clear AC on interrupt
    # delivery, so without it this ISR body would run with SMAP OFF whenever it lands on ring 3 that set AC with
    # popf, or inside a syscall after the entry stub's stac. The saved RFLAGS keeps the interrupted AC; iretq
    # restores it. (kstack-smoke's "isr clac" phase checks every gate's first three bytes.)
    store8(p + off, 0x0F); store8(p + off + 1, 0x01); store8(p + off + 2, 0xCA); off = off + 3;   # clac
    store8(p + off, 0x50); off = off + 1;                                   # push rax
    store8(p + off, 0x51); off = off + 1;                                   # push rcx
    store8(p + off, 0x52); off = off + 1;                                   # push rdx
    store8(p + off, 0x56); off = off + 1;                                   # push rsi
    store8(p + off, 0x57); off = off + 1;                                   # push rdi
    store8(p + off, 0x41); store8(p + off + 1, 0x50); off = off + 2;        # push r8
    store8(p + off, 0x41); store8(p + off + 1, 0x51); off = off + 2;        # push r9
    store8(p + off, 0x41); store8(p + off + 1, 0x52); off = off + 2;        # push r10
    store8(p + off, 0x41); store8(p + off + 1, 0x53); off = off + 2;        # push r11
    store8(p + off, 0x48); store8(p + off + 1, 0xB8); off = off + 2;        # mov rax, imm64
    store64(p + off, handler_addr); off = off + 8;
    store8(p + off, 0xFF); store8(p + off + 1, 0xD0); off = off + 2;        # call rax
    store8(p + off, 0x41); store8(p + off + 1, 0x5B); off = off + 2;        # pop r11
    store8(p + off, 0x41); store8(p + off + 1, 0x5A); off = off + 2;        # pop r10
    store8(p + off, 0x41); store8(p + off + 1, 0x59); off = off + 2;        # pop r9
    store8(p + off, 0x41); store8(p + off + 1, 0x58); off = off + 2;        # pop r8
    store8(p + off, 0x5F); off = off + 1;                                   # pop rdi
    store8(p + off, 0x5E); off = off + 1;                                   # pop rsi
    store8(p + off, 0x5A); off = off + 1;                                   # pop rdx
    store8(p + off, 0x59); off = off + 1;                                   # pop rcx
    store8(p + off, 0x58); off = off + 1;                                   # pop rax
    store8(p + off, 0x48); store8(p + off + 1, 0xCF); off = off + 2;        # iretq
    return 0;
}

# Fixed-delivery IPI to ONE physical APIC id. No destination shorthand: 0x004000 | vector, with the
# target in ICR-high bits 31:24.
# ⛔ DO NOT use the all-but-self shorthand (0x0C4000) here. agnos parks every AP with APIC id >= 4
# (`smp.cyr:398`, `while (1==1) { hlt }`) BEFORE that AP programs its LAPIC or unmasks anything. On a
# box with more than 4 cores — archaemenid is 8c/16t — a broadcast reaches those parked APs too, and
# what they do with an unexpected vector is not something to discover during an iron burn. Targeting
# only the CPUs agnos actually runs makes the question moot.
# ⭐ 1.57.6 (Path 2, S3.2): IRQ-SAVED. The ICR is written as TWO registers (destination high, then command
# low — the low write sends), and from S3.8 on IPIs are also sent from interrupt context (the reschedule
# kick). A same-CPU ISR landing between a non-ISR sender's high and low writes would re-point the high half
# and misdirect that sender's IPI (tlb_shootdown_all's, say). Masking for the two writes + the delivery wait
# closes it; the caller gets its own IF back.
fn apic_send_ipi_one(target, vector) {
    var ipf = kbd_irq_save();
    apic_write(0x310, target << 24);
    apic_write(0x300, 0x004000 | vector);
    var w = 0;
    while ((apic_read(0x300) & 0x1000) != 0) { if (w >= ICR_DELIVERY_WAIT) { break; } w = w + 1; }
    kbd_irq_restore(ipf);
    return 0;
}

# THE PUBLIC ENTRY. Call AFTER the page-table mutation is visible in memory and BEFORE the affected
# pages can be reused. Single-core (cpu_count < 2) is a pure local flush — no IPI, no wait.
fn tlb_shootdown_all() {
    asm {
        0x0F; 0x20; 0xD8;            # mov rax, cr3
        0x0F; 0x22; 0xD8;            # mov cr3, rax   (flush THIS cpu first, always)
    }
    if (apic_enabled == 0) { return 0; }
    if (cpu_count < 2) { return 0; }
    # 1.56.51: the whole reset/arm/IPI/wait is ONE critical section — see the banner at
    # tlb_shoot_lock. Acquiring also services any shootdown already aimed at this CPU, so waiting
    # for the lock cannot starve the peer that holds it.
    tlb_shoot_spin_lock();
    tlb_shoot_ack = 0;
    var me = pcpu_cpu();
    # ⛔⛔ 1.56.52 — ITERATE THE ONLINE MASK, NOT THE COUNT. These loops walked the dense prefix
    # `0..cpu_count-1` and handed the loop index straight to apic_send_ipi_one, which writes
    # `target << 24` into ICR_HI — so THE LOOP INDEX WAS USED AS A PHYSICAL APIC ID. But cpu_count is
    # only the CARDINALITY of the online set; the set itself is {0 (BSP)} u {i : bit i of
    # ap_online_mask}, which ap_entry fills by APIC id. Those two agree only when the online CPUs
    # happen to form a dense prefix.
    # ⚠ Divergence is not exotic: if AP 3 answers its SIPI and APs 1-2 do not (a sparse-APIC-id box,
    # or an AP that wedges before setting its bit), then ap_online_mask = 0b1000 and cpu_count = 2.
    # The old loops armed and IPI'd APIC id 1 — WHICH DOES NOT EXIST — while APIC id 3, the CPU that
    # is actually running procs and caching translations, was never armed and never IPI'd. want was
    # cpu_count-1 = 1 and ack stayed 0, so every shootdown burned the full 2,000,000-pause timeout
    # and then fell through with the flush unperformed on the one CPU that needed it. That is the
    # stale-TLB-across-address-spaces failure this whole mechanism exists to prevent, arrived at by a
    # different road.
    # ⚠ `want` is now COUNTED DURING THE ARM PASS rather than derived from cpu_count, so it can never
    # disagree with the set that was actually armed. It is published before the first IPI goes out.
    # ⚠ Bounds are the ARRAY SIZE (4) now, not a count, so pcpu_tlb_pending[4] cannot be exceeded
    # even if cpu_count were ever wrong.
    var mask = cpu_online_mask();
    var want = 0;
    var a = 0;
    while (a < 4) {
        if (a != me) {
            if (((mask >> a) & 1) == 1) {
                store64(&pcpu_tlb_pending + a * 8, 1);
                want = want + 1;
            }
        }
        a = a + 1;
    }
    tlb_shoot_want = want;
    var t = 0;
    while (t < 4) {
        if (t != me) {
            if (((mask >> t) & 1) == 1) { apic_send_ipi_one(t, TLB_SHOOT_VECTOR); }
        }
        t = t + 1;
    }
    var w = 0;
    while (tlb_shoot_ack < tlb_shoot_want) {
        if (w >= TLB_SHOOT_WAIT) { break; }    # fail-safe: degrade to stale-TLB risk, never hang
        w = w + 1;
        asm { 0xF3; 0x90; }                    # pause
    }
    # ⚠ Clear any flag that went unanswered (a CPU that timed out above), so a stale 1 cannot make
    # the NEXT request look pre-acked.
    # 1.56.52: clear ALL four slots unconditionally — cheaper than a mask test and strictly safer
    # against a stale 1 left by a CPU that went offline between two shootdowns.
    var c = 0;
    while (c < 4) {
        if (c != me) { store64(&pcpu_tlb_pending + c * 8, 0); }
        c = c + 1;
    }
    tlb_shoot_spin_unlock();
    #ifdef TLB_SHOOT_PROBE
    # CALIBRATE THE NULL: prove the shootdown fires and that acks come back. A silent fix is
    # indistinguishable from no fix, which is how this whole investigation kept going wrong.
    if (tlb_shoot_probe_n < 6) {
        tlb_shoot_probe_n = tlb_shoot_probe_n + 1;
        klug_append("TLBSHOOT want=", 14);
        tlb_probe_hex(tlb_shoot_want);
        klug_append(" ack=", 5);
        tlb_probe_hex(tlb_shoot_ack);
        klug_append(" cpus=", 6);
        tlb_probe_hex(cpu_count);
        klug_append(" apic=", 6);
        tlb_probe_hex(apic_enabled);
        klug_append(" spins=", 7);
        tlb_probe_hex(w);
        klug_putc(10);
    }
    #endif
    return 0;
}
