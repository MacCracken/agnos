# === HID-boot keyboard — report differ + kb_buf writer ===
#
# Phase 5 plumbing: feeds HID boot-protocol reports into the existing
# `kb_buf` ring that `arch/x86_64/keyboard.cyr`'s `scancode_to_ascii()`
# consumes. The translation table lives in hid_translate.cyr; this file
# owns module state, the report differ, and the kb_buf writer.
#
# Module state (set by Phase 4 / hid_kbd_init):
#   hid_kbd_slot_id     — xHCI slot ID for the keyboard (0 = no keyboard)
#   hid_kbd_interface   — bInterfaceNumber for the HID-boot interface
#   hid_kbd_ep_addr     — bEndpointAddress for the interrupt-IN endpoint
#   hid_kbd_ep_mps      — wMaxPacketSize for that endpoint (always 8 for boot)
#   hid_kbd_ep_interval — bInterval (frames between polls)
#   hid_kbd_xfer_ring   — phys of the transfer-ring page (allocated Phase 4)
#   hid_kbd_report_buf  — phys of the static 8-byte report buffer
#
# Single-keyboard scope for MVP per planning doc § "Architectural choices".
# Second keyboard plugged later is ignored — first-wins.

var hid_kbd_slot_id     = 0;
var hid_kbd_interface   = 0;
var hid_kbd_ep_addr     = 0;
var hid_kbd_ep_mps      = 8;
var hid_kbd_ep_interval = 0;
var hid_kbd_xfer_ring   = 0;
var hid_kbd_report_buf  = 0;
var hid_kbd_xfer_idx    = 0;   # Next TRB slot on kbd ring (0..255)
var hid_kbd_xfer_cycle  = 1;   # Producer cycle state for kbd ring

# Two 8-byte buffers: current and previous reports. Allocated statically
# (BSS) rather than from PMM since the DMA buffer is hid_kbd_report_buf
# (xHCI controller writes into that phys); these two copies are CPU-side
# scratch for the differ.
var hid_curr_report[8];
var hid_prev_report[8];

# ⛔⛔ THE BOUND-ENDPOINT REGISTRY — why `hid_poll` cannot simply grow a second matcher.
#
# `hid_poll` drains ONE event ring shared by every device on the controller, and it **consumes every
# event it looks at**, matched or not (see the drain loop). So a second poller — `hid_mouse_poll()`
# called after `hid_poll()` — can never work: whichever runs first eats the other's Transfer Events and
# the second sees an empty ring. There is exactly one drain, and it must dispatch.
#
# ⇒ Endpoints register here, and the drain looks up `(slot, DCI)`. Adding a device class is adding a row
# and a `kind` arm, never a second drain.
#
# ⚠ THE UNIT IS AN ENDPOINT, NOT A DEVICE, and that is forced by the hardware in front of us: the
# Keychron K2 on archaemenid exposes a boot **keyboard** on EP 0x81 *and* a boot **mouse** on EP 0x82
# **within the same slot**. Keying this table by slot would make those two collide. See
# `docs/development/planning/pointer.md` §0.
#
# ⚠ MODULE-SCOPE `var X[N]` IS N*8 BYTES in Cyrius (function-local is N bytes), so these are 8 u64 slots
# each and are indexed with `* 8`. Same convention as `hid_curr_report` above.
enum HidKind {
    HID_KIND_NONE  = 0;
    HID_KIND_KBD   = 1;
    HID_KIND_MOUSE = 2;   # registered in P2; the drain already routes it to a no-op arm
}
enum HidReg {
    HID_MAX_EP = 8;
}
var hid_ep_count = 0;
var hid_first_report = 0;   # one-shot: has the registry dispatched a keyboard report yet?

# ⛔⛔ THESE THREE EXIST BECAUSE `hid_poll` RUNS IN INTERRUPT CONTEXT AND MUST NEVER TOUCH THE CONSOLE.
# `kprintln` takes `console_spin_lock` (smp.cyr) — an unbounded `xchg` spin with NO `cli` and NO owner
# check — and `hid_poll` is called from the 100 Hz timer ISR (pic.cyr:79) and the MSI-X handler
# (pic.cyr:258). Ring-3 `write(1)` holds that lock with IF=0 (SYSCALL masks IF via SFMASK 0x40700) and
# so cannot be preempted, but the KEYSTROKE ECHO does not: syscall.cyr's read loop calls
# `kbd_irq_enable()` and then `kputc`, and an interrupt landing inside that window re-enters `hid_poll`
# → `kprintln` → spins forever on a lock its own CPU holds. Hard hang, no recovery, no further log.
# ⚠ The window is widened enormously by a line wrap: `fb_scroll_up` runs inside the held lock and is a
# 14.7 MB copy at 2560x1440.
# ⭐ The invariant was already written down in TWO places and was true when written — kprint.cyr's
# header and smp.cyr's console-lock banner both say "no ISR calls kprint". These one-shots broke it.
# ⛔ THE FIX IS NOT `serial_println`: archaemenid has no serial cable, so that would delete the
# instrument on the only machine that matters. Defer instead — set a flag here, print from thread
# context (`hid_service_deferred`, called from kb_has_key + the #98 ptrscan arm). The latches above/below
# stay, so the message is still exactly one line per boot; only WHERE it prints changed.
var hid_first_report_pending = 0;   # kbd one-shot owed to the console
var hid_mouse_first_pending  = 0;   # mouse one-shot owed to the console
var hid_ep_needs_reset[8];          # per-row: endpoint Halted, owed a reset from thread context
#ifdef HID_CC_INJECT
var hid_cc_inject_left = 20;        # test-only: reject this many completions (> the 16 armed TRBs)
#endif
var hid_ep_slot[8];    # xHCI slot id
var hid_ep_dci[8];     # Device Context Index of the interrupt-IN endpoint
var hid_ep_kind[8];    # HidKind
# ⛔⛔ BUTTONS ARE PER-ENDPOINT, AND ON THIS HARDWARE THAT IS NOT A REFINEMENT. `hid_mouse_btn` was a
# single global assigned `btn` by whichever interface reported LAST, and archaemenid binds TWO boot-mouse
# interfaces — the real mouse, and the Keychron's phantom mouse on its interface 1. One idle (all-zero)
# report from the keyboard therefore clears a button the user is physically HOLDING: a titlebar drag drops
# mid-gesture and ring 3 sees a release that never happened. ⇒ Keep each endpoint's own bitmap and OR them,
# so a device can only ever clear ITS OWN buttons.
var hid_ep_btn[8];     # last button bitmap reported by THIS endpoint
# ⭐ PER-ENDPOINT RING STATE. The keyboard keeps its `hid_kbd_*` globals (its re-arm path still reads
# them), but a second device cannot: archaemenid's Keychron puts a mouse endpoint in the SAME SLOT as the
# keyboard, so ring/buffer/cycle state has to be per ROW, not per device and certainly not per slot.
var hid_ep_ring[8];    # transfer-ring page phys
var hid_ep_buf[8];     # report buffer phys (the controller DMAs into this)
var hid_ep_idx[8];     # next Normal-TRB slot on that ring (0..254; 255 is the Link TRB)
var hid_ep_cycle[8];   # producer cycle state for that ring
var hid_ep_mps[8];     # wMaxPacketSize

# hid_ep_register(slot_id, ep_addr, kind) -> row index, or -1 if the table is full.
# ⚠ Stores the DCI, not the endpoint address: the Transfer Event reports a DCI, so converting once at
# registration keeps `xhci_dci_for_ep` out of the per-event path.
fn hid_ep_register(slot_id, ep_addr, kind, ring, buf, mps) {
    if (hid_ep_count >= HID_MAX_EP) { return 0 - 1; }
    var i = hid_ep_count;
    store64(&hid_ep_slot  + i * 8, slot_id);
    store64(&hid_ep_dci   + i * 8, xhci_dci_for_ep(ep_addr));
    store64(&hid_ep_kind  + i * 8, kind);
    store64(&hid_ep_ring  + i * 8, ring);
    store64(&hid_ep_buf   + i * 8, buf);
    store64(&hid_ep_idx   + i * 8, 0);
    store64(&hid_ep_cycle + i * 8, 1);
    store64(&hid_ep_mps   + i * 8, mps);
    hid_ep_count = hid_ep_count + 1;
    return i;
}

# Is any HID endpoint already bound on this slot?
# ⚠ Decides whether the mouse binder may issue SET_CONFIGURATION: re-issuing it on a slot the keyboard
# already configured would reset that keyboard's endpoint. A composite device is configured ONCE.
fn hid_ep_slot_bound(slot_id) {
    var i = 0;
    while (i < hid_ep_count) {
        if (load64(&hid_ep_slot + i * 8) == slot_id) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Arm one Normal TRB on row `i`'s ring, mirroring hid_arm_xfer_trb's contract for the keyboard: IOC so
# the completion surfaces as a Transfer Event, ISP so a short packet still completes, and a Link TRB
# wrap at slot 255 with the cycle flipped. ⚠ The 16-deep batch discipline the keyboard needs applies
# here too — a 1-deep interrupt-IN ring goes empty the moment polling pauses and the EP stalls.
fn hid_arm_row_trb(i) {
    var ring = load64(&hid_ep_ring + i * 8);
    var buf  = load64(&hid_ep_buf  + i * 8);
    if (ring == 0) { return 0; }
    if (buf == 0) { return 0; }
    var idx = load64(&hid_ep_idx + i * 8);
    var cyc = load64(&hid_ep_cycle + i * 8);
    var trb = ring + idx * 16;
    store64(trb + 0, buf);
    store32(trb + 8, load64(&hid_ep_mps + i * 8) & 0x1FFFF);
    store32(trb + 12, (1 << 5) | (1 << 2) | (XHCI_TRB_NORMAL << 10) | (cyc & 0x1));
    idx = idx + 1;
    if (idx == 255) {
        # Reached the Link TRB: align its cycle with the producer, flip ours, wrap to 0.
        var link = ring + 255 * 16;
        store32(link + 12, (XHCI_TRB_LINK << 10) | 0x2 | (cyc & 0x1));
        idx = 0;
        if (cyc == 1) { cyc = 0; } else { cyc = 1; }
    }
    store64(&hid_ep_idx + i * 8, idx);
    store64(&hid_ep_cycle + i * 8, cyc);
    return 1;
}

# hid_ep_find(slot_id, dci) -> row index, or -1 when this event is not ours.
# ⚠ A miss is NORMAL and must stay silent: EP0 control-transfer completions land in this same ring and
# belong to `xhci_wait_transfer_event`.
fn hid_ep_find(slot_id, dci) {
    var i = 0;
    while (i < hid_ep_count) {
        if (load64(&hid_ep_slot + i * 8) == slot_id) {
            if (load64(&hid_ep_dci + i * 8) == dci) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn hid_ep_kind_at(i) {
    if (i < 0) { return HidKind.HID_KIND_NONE; }
    if (i >= hid_ep_count) { return HidKind.HID_KIND_NONE; }
    return load64(&hid_ep_kind + i * 8);
}

# === HID-boot MOUSE — the accumulator and the binder ===
#
# ⛔⛔ WHY THIS ACCUMULATES INSTEAD OF LATCHING THE LAST REPORT. All 16 armed TRBs on an endpoint point
# at ONE report buffer, and the drain re-reads that buffer per Transfer Event. The keyboard's own
# comment calls the consequence acceptable — "a gap that coalesces >1 report keeps only the LAST" — and
# for a keyboard it IS: a report is idempotent STATE, so the differ sees curr == prev and nothing
# happens. A mouse report is a **relative delta**. Keeping only the last one and applying it N times is
# lossy AND amplifying: at 8 ms reports against a 16 ms frame that is a systematic ~2-3x motion
# multiplier, which would present as "the cursor is too fast" and get tuned with a sensitivity constant
# instead of fixed. ⇒ Sum dX/dY across every event, OR the buttons, and hand ring 3 one merged sample.
# ⚠ Buttons OR *and* keep the last state, so a press+release inside one coalescing gap is not swallowed.
var hid_mouse_dx = 0;        # accumulated since the last drain by ring 3
var hid_mouse_dy = 0;
var hid_mouse_btn = 0;       # current button bitmap (bit0 left, bit1 right, bit2 middle)
var hid_mouse_btn_seen = 0;  # OR of every bitmap seen since the last drain — catches a click in a gap
var hid_mouse_seq = 0;       # bumps on every accepted report; ring 3 can tell "no motion" from "no poll"
var hid_mouse_first = 0;     # one-shot marker latch
# ⭐⭐ THE WHEEL (1.56.49). Byte [3] of the boot-mouse report, summed like dx/dy since the last drain.
# ⛔ IT WAS DOCUMENTED IN THE LAYOUT COMMENT AND NEVER READ — "wheel (s8, optional)" sat above a
# function that loaded only `+1` and `+2`, so every scroll the hardware sent was discarded at the very
# bottom of the stack. Nothing above could have carried it: `#98 ptrscan`'s record had no field for it,
# bhumi had no scroll concept, and setu had no message kind. Five repos looked like they were missing
# a feature; the byte was being dropped here.
var hid_mouse_wheel = 0;
# ⚠ DIAGNOSTIC, ONE-SHOT, DRAINED IN THREAD CONTEXT. Records the first report that carried a NON-ZERO
# wheel byte, plus the event's residual field, so the assumption below is CHECKABLE from a serial log
# rather than argued. Printed from the `#98` arm, never from here — this file's own banner explains
# why a kprintln in ISR context deadlocks.
var hid_wheel_seen = 0;
var hid_wheel_seen_pending = 0;
var hid_wheel_dbg_b3 = 0;
var hid_wheel_dbg_resid = 0;

# Sign-extend one HID byte: the boot-mouse report carries dX/dY as SIGNED int8, and Cyrius has no i8.
fn hid_s8(b) {
    var v = b & 0xFF;
    if (v > 127) { return v - 256; }
    return v;
}

# Fold one boot-mouse report into the accumulator. Report layout (USB HID boot protocol):
#   [0] buttons bitmap   [1] dX (s8)   [2] dY (s8, POSITIVE IS DOWN)   [3] wheel (s8, optional)
fn hid_process_mouse_report(report_phys, bi, resid) {
    if (report_phys == 0) { return 0; }
    var btn = load8(report_phys + 0) & 0xFF;
    hid_mouse_dx = hid_mouse_dx + hid_s8(load8(report_phys + 1));
    hid_mouse_dy = hid_mouse_dy + hid_s8(load8(report_phys + 2));
    # ⭐ THE WHEEL, byte [3] (1.56.49). Folded exactly like dx/dy: it is a relative delta and keeping
    # only the last one of a coalescing gap would under-report a fast scroll the same way it amplified
    # motion — see this accumulator's header.
    # ⛔ READ UNCONDITIONALLY, AND HERE IS WHY THAT IS SAFE RATHER THAN SLOPPY. USB HID boot protocol
    # defines a 3-BYTE mouse report, so byte [3] is formally out of contract — but this file's own
    # SHORT_PACKET note already says the opposite in practice: *"the boot mouse's 4-byte reports on an
    # 8-byte endpoint"*. The report page is zeroed at configure time and each row owns its own page, so
    # a device that genuinely sends three bytes leaves byte [3] at 0 for the life of the boot and the
    # wheel simply stays 0. The failure mode a length gate would prevent — a stale byte re-read as a
    # scroll — needs a device that alternates report lengths, which a fixed report descriptor cannot do.
    # ⚠ THE ASSUMPTION IS INSTRUMENTED, NOT ASSERTED: `resid` is recorded below so a serial log can say
    # what the controller actually reported. Tighten this to a length gate if a 3-byte device appears.
    var wh = hid_s8(load8(report_phys + 3));
    hid_mouse_wheel = hid_mouse_wheel + wh;
    if (wh != 0) {
        if (hid_wheel_seen == 0) {
            hid_wheel_seen = 1;
            hid_wheel_seen_pending = 1;
            hid_wheel_dbg_b3 = load8(report_phys + 3) & 0xFF;
            hid_wheel_dbg_resid = resid;
        }
    }
    # ⛔ RECORD THIS ENDPOINT'S BITMAP, THEN UNION — never assign the global from one device. See the
    # `hid_ep_btn` banner: with two bound boot-mouse interfaces, last-writer-wins lets the keyboard's
    # phantom mouse release a button the real mouse is holding.
    if (bi >= 0) {
        if (bi < HID_MAX_EP) { store64(&hid_ep_btn + bi * 8, btn); }
    }
    var uni = 0;
    var bx = 0;
    while (bx < hid_ep_count) {
        if (load64(&hid_ep_kind + bx * 8) == HidKind.HID_KIND_MOUSE) {
            uni = uni | load64(&hid_ep_btn + bx * 8);
        }
        bx = bx + 1;
    }
    hid_mouse_btn = uni;
    hid_mouse_btn_seen = hid_mouse_btn_seen | uni;
    hid_mouse_seq = hid_mouse_seq + 1;
    # ⚠ FLAG, DO NOT PRINT — hid_process_mouse_report is reached from hid_poll in ISR context, and this
    # one-shot is the LIVE hazard of the pair: unlike the keyboard's (which cannot coincide with the echo
    # of a previous key), it fires at an arbitrary later instant and can land inside the kputc window.
    if (hid_mouse_first == 0) {
        hid_mouse_first = 1;
        hid_mouse_first_pending = 1;
    }
    return 0;
}

# hid_mouse_take(out): drain the accumulator into a 16-byte record and reset it.
# Returns 1 if there was anything to report, 0 if the pointer has been idle since the last drain.
#
# Record layout (little-endian, 16 bytes) — see `#98 ptrscan` in core/syscall.cyr:
#   +0  s32 dx            summed since the last drain (positive = right)
#   +4  s32 dy            summed since the last drain (POSITIVE = DOWN, as HID reports it)
#   +8  u32 buttons       the CURRENT bitmap (bit0 left, bit1 right, bit2 middle)
#   +12 u32 buttons_seen  OR of every bitmap seen since the last drain
#
# ⭐ WHY BOTH BUTTON FIELDS. `buttons` alone loses a click that begins and ends inside one drain
# interval — press and release both land, the last report reads 0, and the consumer never sees it.
# `buttons_seen` is what makes a fast click survive a slow frame. A consumer wanting edges compares
# the two: a bit set in `seen` but clear in `buttons` is a click that already completed.
#
# ⚠ THE ACCUMULATOR HAS AN INTERRUPT-CONTEXT WRITER (`hid_poll` also runs from the xHCI MSI-X ISR), so a
# read-modify-write here must be serialised against it. ⛔ THIS USED TO SAY "CALLER MUST HOLD IF=0" AND
# THAT WAS NOT ENOUGH: `cli` is per-CPU, and on four CPUs the syscall and the interrupt run on different
# ones. It takes `hid_poll_lock` itself now and does not rely on the caller for anything.
fn hid_mouse_take(out, cap) {
    if (out == 0) { return 0; }
    # ⛔⛔ `cli` IS NOT A LOCK ON FOUR CPUs, and the banner above claimed it was enough. This function
    # read-modify-writes the same accumulator `hid_process_mouse_report` folds into from the MSI-X ISR;
    # the syscall runs wherever agnsh migrated to (CPU 1 is routine) while the interrupt is delivered to
    # CPU 0, so disabling interrupts locally excludes nothing. Interleaved, a whole report's delta is lost:
    # this side reads `hid_mouse_dx`, the ISR adds to it, and this side then zeroes it.
    # ⭐ THE SAME TRY-LOCK `hid_poll` OWNS, and try rather than spin for the same reason — failing simply
    # means the drain is busy, and the accumulator PERSISTS, so the next poll gets the data. Lossless.
    if (hid_poll_trylock() == 0) { return 0; }
    var idle = 0;
    if (hid_mouse_dx == 0) {
        if (hid_mouse_dy == 0) {
            if (hid_mouse_btn == 0) {
                if (hid_mouse_btn_seen == 0) {
                    # ⛔ THE WHEEL COUNTS AS ACTIVITY. Without this a pure scroll — no motion, no
                    # button — reads as idle and the sample is dropped, which is exactly the shape of
                    # "scrolling does nothing" that would look like a bug five layers up.
                    if (hid_mouse_wheel == 0) { idle = 1; }
                }
            }
        }
    }
    if (idle == 1) { hid_poll_unlock(); return 0; }
    store32(out + 0,  hid_mouse_dx);
    store32(out + 4,  hid_mouse_dy);
    store32(out + 8,  hid_mouse_btn);
    store32(out + 12, hid_mouse_btn_seen);
    # ⭐ THE RECORD GREW FROM 16 TO 20 BYTES AND OLD CALLERS ARE UNAFFECTED (1.56.49). A caller that
    # asks for 16 gets exactly the 16 it always got; only one asking for >= 20 is told about the wheel.
    # ⛔ A FLAG DAY WOULD HAVE BEEN THE WRONG ANSWER: `#98`'s record layout is a documented syscall
    # contract with a live consumer (bhumi -> aethersafha), and growing it unconditionally would have
    # written past a 16-byte buffer in every existing caller.
    var n = 16;
    if (cap >= 20) {
        store32(out + 16, hid_mouse_wheel);
        n = 20;
    }
    # ⚠ RESET THE DELTAS, KEEP THE CURRENT BUTTON STATE. dx/dy are consumed — reporting them twice is
    # exactly the double-apply this whole path exists to avoid. `hid_mouse_btn` is LEVEL, not an edge,
    # so it persists until the device says otherwise; only the OR-accumulator is cleared.
    hid_mouse_dx = 0;
    hid_mouse_dy = 0;
    hid_mouse_btn_seen = hid_mouse_btn;
    # ⚠ CLEARED EVEN WHEN THE CALLER DID NOT ASK FOR IT. A 16-byte caller cannot see the wheel, and
    # leaving it to accumulate would hand the first 20-byte caller every scroll since boot as one
    # enormous delta.
    hid_mouse_wheel = 0;
    hid_poll_unlock();                             # the other exit is the idle branch above
    return n;
}

# hid_mouse_configure(slot_id): bind EVERY HID-boot-mouse interface this device exposes.
#
# ⛔ "FIND THE FIRST PROTOCOL-0x02 INTERFACE" IS THE TRAP THIS AVOIDS. On archaemenid the Keychron K2
# keyboard ALSO advertises a boot mouse (interface 1, EP 0x82) alongside its keyboard (interface 0, EP
# 0x81). A first-match search over devices can therefore bind the KEYBOARD and see no motion — the
# failure presents as "mouse enumerated, cursor dead", which costs a burn to diagnose. Binding every
# such interface and merging their motion into one pointer is also exactly what Linux's usbhid does:
# all mice are one seat. The Keychron's mouse interface simply stays silent.
# Returns the number of mouse interfaces bound on this slot.
fn hid_mouse_configure(slot_id) {
    if (xhci_desc_buf_phys == 0) { return 0; }
    var bound = 0;
    var skip = 0;
    while (skip < 4) {
        xhci_zero_page(xhci_desc_buf_phys);
        if (xhci_get_config_descriptor(slot_id, 0, 9) == 0) { return bound; }
        var total_len = load16(xhci_desc_buf_phys + 2);
        if (total_len < 18) { return bound; }
        if (total_len > 4096) { total_len = 4096; }
        xhci_zero_page(xhci_desc_buf_phys);
        if (xhci_get_config_descriptor(slot_id, 0, total_len) == 0) { return bound; }

        var intf_num = 0;
        var ep_addr = 0;
        var mps_buf[2];
        var interval_byte = 0;
        if (xhci_find_hid_boot_endpoint(total_len, 0x02, skip,
            &intf_num, &ep_addr, &mps_buf, &interval_byte) == 0) {
            return bound;                 # no further boot-mouse interface on this device
        }
        var mps = load16(&mps_buf);
        if (mps == 0) { mps = 8; }

        # ⚠ SET_CONFIGURATION ONLY IF NOTHING IS BOUND ON THIS SLOT YET. Re-issuing it on a composite
        # device whose keyboard is already configured would reset that keyboard's endpoint.
        if (hid_ep_slot_bound(slot_id) == 0) {
            var config_value = load8(xhci_desc_buf_phys + 5);
            if (xhci_control_no_data(slot_id, 0x00, 0x09, config_value, 0) == 0) {
                kprintln("hid: mouse SET_CONFIGURATION failed", 35);
                return bound;
            }
        }
        if (hid_set_protocol_boot(slot_id, intf_num) == 0) {
            kprintln("hid: mouse SET_PROTOCOL=boot failed", 35);
            return bound;
        }

        var xfer_ring = pmm_alloc();
        if (xfer_ring == 0) { kprintln("hid: mouse xfer ring alloc failed", 33); return bound; }
        if (vmm_is_mapped(xfer_ring) == 0) { vmm_map(xfer_ring, xfer_ring, 0x83); }
        iommu_register_dma(xfer_ring);
        xhci_zero_page(xfer_ring);
        var report_buf = pmm_alloc();
        if (report_buf == 0) { kprintln("hid: mouse report buf alloc failed", 34); return bound; }
        if (vmm_is_mapped(report_buf) == 0) { vmm_map(report_buf, report_buf, 0x83); }
        iommu_register_dma(report_buf);
        xhci_zero_page(report_buf);
        # Link TRB at slot 255, TC set — same wrap discipline as the keyboard ring.
        var link = xfer_ring + 255 * 16;
        store64(link, xfer_ring);
        store32(link + 8, 0);
        store32(link + 12, (XHCI_TRB_LINK << 10) | 0x2);

        var ictx = xhci_slot_get(xhci_slot_input_ctx, slot_id);
        if (ictx == 0) { return bound; }
        var speed = xhci_slot_get(xhci_slot_speed, slot_id);
        # ⚠ Add Flags become A0 | A_thisDCI, which does NOT disturb an endpoint already running on this
        # slot: Configure Endpoint only acts on flagged contexts. That is what makes the composite case
        # work without a separate code path.
        var dci = xhci_input_ctx_add_interrupt_in(ictx, ep_addr, mps, interval_byte, speed, xfer_ring);
        if (dci == 0) { return bound; }
        if (xhci_configure_endpoint(slot_id, ictx) == 0) {
            kprintln("hid: mouse Configure Endpoint failed", 36);
            return bound;
        }

        var row = hid_ep_register(slot_id, ep_addr, HidKind.HID_KIND_MOUSE, xfer_ring, report_buf, mps);
        if (row < 0) { kprintln("hid: mouse endpoint table full", 30); return bound; }
        # Arm the ring 16 deep before the first doorbell — see the KBD-RING-DEPTH note on the keyboard
        # ring: a shallow interrupt-IN ring empties during any polling gap and the EP stalls.
        var armed = 0;
        while (armed < 16) { hid_arm_row_trb(row); armed = armed + 1; }
        var db_addr = xhci_mmio_base + xhci_db_off + slot_id * 4;
        store32(db_addr, dci & 0xFF);

        kprint("hid: mouse configured, boot protocol on, EP=", 44);
        kprint_num(ep_addr);
        kprint(" interface=", 11);
        kprint_num(intf_num);
        kprintln("", 0);
        bound = bound + 1;
        skip = skip + 1;
    }
    return bound;
}

# Probe every addressed slot for boot-mouse interfaces. Mirrors msc_enumerate's shape — one pass over
# all slots with NO early exit, because more than one device can carry a mouse interface.
fn hid_mouse_enumerate() {
    if (xhci_running == 0) { return 0; }
    var total = 0;
    var sl = 1;
    while (sl <= 64) {
        if (xhci_slot_get(xhci_slot_input_ctx, sl) != 0) {
            total = total + hid_mouse_configure(sl);
        }
        sl = sl + 1;
    }
    kprint("hid: boot-mouse interfaces bound: ", 34);
    kprint_num(total);
    kprintln("", 0);
    return total;
}

# Initialize HID layer. Called from main.cyr after xhci_init. Does NOT
# require a keyboard to be present — keyboard discovery happens later
# when port enumeration finds a HID-boot-class device (Phase 4).
fn hid_kbd_init() {
    hid_translate_init();
    for (var i = 0; i < 8; i = i + 1) {
        store8(&hid_curr_report + i, 0);
        store8(&hid_prev_report + i, 0);
    }
    hid_kbd_slot_id = 0;
    hid_kbd_report_buf = 0;
    # ⚠ Reset the registry here too, or a re-init would leave stale rows pointing at slots that no
    # longer exist and the drain would dispatch reports out of a dead device's buffer.
    hid_ep_count = 0;
    kprintln("hid: keyboard layer initialized", 31);
    return 0;
}

# Push a single Set-1 scancode byte into kb_buf, advancing kb_head with 8-bit wrap.
# ⚠ SET-1 IS THIS PATH'S WIRE FORMAT, NOT A PS/2 LEFTOVER. `hid_translate.cyr` maps HID usages to Set-1
# so that one consumer (`scancode_to_ascii`) serves the whole system; the encoding outlived the bus that
# named it. ⭐ Since 2026-08-08 this is the ONLY producer of kb_buf — the i8042 ISR that used to share it
# is deleted (see the tombstone at the top of arch/x86_64/keyboard.cyr).
fn hid_kb_push(scancode) {
    # input_lock (keyboard.cyr): serialize the kb_head RMW vs the kb_isr IRQ1 producer
    # (same-CPU, excluded by cli-first) and a foreign-CPU accessor (cross-CPU spinlock).
    var f = kbd_irq_save();
    input_spin_lock();
    store8(&kb_buf + kb_head, scancode & 0xFF);
    kb_head = (kb_head + 1) & 0xFF;
    input_spin_unlock();
    kbd_irq_restore(f);
    return 0;
}

# Is HID usage code `code` present in the 6-slot keys array of report
# starting at `report_addr` + offset 2? Returns 1 if yes, 0 if no.
# 0x00 in a slot means empty; we don't have to handle that as a "present"
# because hid_usage_to_ps2(0) returns 0 (unmapped) and the differ skips
# zero translations.
fn hid_report_contains(report_addr, code) {
    for (var i = 2; i < 8; i = i + 1) {
        if (load8(report_addr + i) == code) { return 1; }
    }
    return 0;
}

# Diff the modifier byte (report[0]). For each of the 8 modifier bits:
#   - bit set in curr, clear in prev → make scancode pushed
#   - bit clear in curr, set in prev → break scancode pushed (sc | 0x80)
#   - same in both → no emit
# Unmapped modifier bits (LGui/RGui in MVP) have scancode 0 — silently
# dropped because scancode_to_ascii drops 0 anyway.
fn hid_modifier_diff(curr_mods, prev_mods) {
    var changed = curr_mods ^ prev_mods;
    if (changed == 0) { return 0; }
    for (var bit = 0; bit < 8; bit = bit + 1) {
        var mask = 1 << bit;
        if ((changed & mask) != 0) {
            var sc = hid_modifier_bit_to_ps2(bit);
            if (sc != 0) {
                if ((curr_mods & mask) != 0) {
                    hid_kb_push(sc);        # make
                } else {
                    hid_kb_push(sc | 0x80); # break
                }
            }
        }
    }
    return 0;
}

# Diff the 6-key slot array (report bytes 2..7) and emit make/break
# scancodes. Algorithm matches what Linux's hid-input.c does at the
# logical level:
#   - For each key in curr that's NOT in prev → make scancode
#   - For each key in prev that's NOT in curr → break scancode
#
# HID-boot reports are unordered (a slot is just "this key is pressed");
# matching by contains() over both arrays is the canonical translation.
# Error codes 0x01..0x03 (NKRO rollover / POST fail / undefined) in any
# slot are silently dropped because hid_usage_to_ps2 returns 0 for those
# unmapped HID codes.
fn hid_report_keys_diff(curr_addr, prev_addr) {
    # Emit makes for keys newly-present in curr. Extended keys (arrows / nav
    # cluster) get a leading 0xE0 so the byte stream is E0 + make, which bhumi's
    # set-1-ext decoder turns back into the arrow/nav HID usage.
    for (var i = 2; i < 8; i = i + 1) {
        var code = load8(curr_addr + i);
        if (code >= 4) {
            if (hid_report_contains(prev_addr, code) == 0) {
                var sc = hid_usage_to_ps2(code);
                if (sc != 0) {
                    if (hid_usage_is_ext(code) != 0) { hid_kb_push(0xE0); }
                    hid_kb_push(sc);
                }
            }
        }
    }
    # Emit breaks for keys that were in prev but absent in curr (E0 + break for ext).
    for (var j = 2; j < 8; j = j + 1) {
        var pcode = load8(prev_addr + j);
        if (pcode >= 4) {
            if (hid_report_contains(curr_addr, pcode) == 0) {
                var psc = hid_usage_to_ps2(pcode);
                if (psc != 0) {
                    if (hid_usage_is_ext(pcode) != 0) { hid_kb_push(0xE0); }
                    hid_kb_push(psc | 0x80);
                }
            }
        }
    }
    return 0;
}

# Phase 4 — issue SET_PROTOCOL = boot to the keyboard interface.
# HID 1.11 §7.2.6: bmRequestType=0x21 (H-to-D, Class, recipient=Interface),
# bRequest=0x0B (SET_PROTOCOL), wValue=0 (boot protocol), wIndex=interface,
# wLength=0. After this returns success the keyboard delivers fixed
# 8-byte boot reports regardless of any HID report descriptor it may
# also expose (which we deliberately don't parse — see planning doc §
# "Architectural choices" / HID descriptor parsing = skipped).
fn hid_set_protocol_boot(slot_id, interface) {
    return xhci_control_no_data(slot_id, 0x21, 0x0B, 0, interface);
}

# Phase 4 — full keyboard configuration sequence. Called from
# xhci_enumerate_port after Address Device + Get Device Descriptor have
# succeeded and the device is suspected to host a HID-boot-keyboard
# interface (device class is 0 / interface-defined, or device class 0x03).
# Sequence:
#   1. Get Configuration Descriptor (9-byte header, then full)
#   2. Walk for HID-boot-keyboard interface + interrupt-IN endpoint
#   3. SET_PROTOCOL = boot on the interface
#   4. Allocate transfer ring for the kbd IN endpoint
#   5. Update Input Context with the new EP via xhci_input_ctx_add_interrupt_in
#   6. Configure Endpoint command (TRB type 12)
#   7. Ring the kbd doorbell to kick the first IN transaction
# Returns 1 on success (keyboard ready to deliver reports), 0 otherwise.
fn hid_kbd_configure(slot_id) {
    # Reuse the shared descriptor scratch buffer xhci_get_device_descriptor
    # has already provisioned by this point.
    if (xhci_desc_buf_phys == 0) { return 0; }

    # Step 1a: read 9-byte config descriptor header to learn wTotalLength.
    xhci_zero_page(xhci_desc_buf_phys);
    if (xhci_get_config_descriptor(slot_id, 0, 9) == 0) {
        kprintln("hid: get config descriptor (9) failed", 37);
        return 0;
    }
    var total_len = load16(xhci_desc_buf_phys + 2);
    if (total_len < 18) { return 0; }   # need at least one intf + ep
    if (total_len > 4096) { total_len = 4096; } # clamp to scratch page

    # Step 1b: read full config descriptor.
    xhci_zero_page(xhci_desc_buf_phys);
    if (xhci_get_config_descriptor(slot_id, 0, total_len) == 0) {
        kprintln("hid: get config descriptor (full) failed", 40);
        return 0;
    }

    # Step 2: walk for HID-boot-keyboard interface + interrupt-IN endpoint.
    # Out-pointers live in this stack frame; copied to module globals on
    # success.
    var intf_num    = 0;
    var ep_addr     = 0;
    var mps_buf[2];                 # 16-bit slot
    var interval_byte = 0;
    store16(&mps_buf, 0);
    if (xhci_find_hid_boot_endpoint(total_len, 0x01, 0,
        &intf_num, &ep_addr, &mps_buf, &interval_byte) == 0) {
        kprintln("hid: no HID-boot-kbd interface in config", 40);
        return 0;
    }
    var mps = load16(&mps_buf);
    if (mps == 0) { mps = 8; }      # HID-boot reports are always 8 bytes

    # Step 2.5: SET_CONFIGURATION (USB 2.0 §9.4.7). Transitions the device
    # from Address → Configured state; per §9.1.1.5, endpoints other than
    # EP0 are NOT operational until the device is Configured. Skipping this
    # is why iron HID keyboards NAK every interrupt-IN poll forever after
    # Configure Endpoint succeeds host-side (QEMU's usb-kbd is permissive
    # and ships reports anyway; real firmware honors the state machine).
    # bConfigurationValue lives at config descriptor byte 5 — Linux
    # `usb_choose_configuration()` typically picks the first config, value
    # = 1 for single-config HID-boot keyboards.
    var config_value = load8(xhci_desc_buf_phys + 5);
    if (xhci_control_no_data(slot_id, 0x00, 0x09, config_value, 0) == 0) {
        kprintln("hid: SET_CONFIGURATION failed", 29);
        return 0;
    }

    # Step 3: SET_PROTOCOL = boot. Force the keyboard onto the predictable
    # boot-report format.
    if (hid_set_protocol_boot(slot_id, intf_num) == 0) {
        kprintln("hid: SET_PROTOCOL=boot failed", 29);
        return 0;
    }

    # Step 4: allocate the transfer ring + report buffer pages.
    var xfer_ring = pmm_alloc();
    if (xfer_ring == 0) { kprintln("hid: xfer ring alloc failed", 27); return 0; }
    if (vmm_is_mapped(xfer_ring) == 0) { vmm_map(xfer_ring, xfer_ring, 0x83); }
    iommu_register_dma(xfer_ring);
    xhci_zero_page(xfer_ring);

    var report_buf = pmm_alloc();
    if (report_buf == 0) { kprintln("hid: report buf alloc failed", 28); return 0; }
    if (vmm_is_mapped(report_buf) == 0) { vmm_map(report_buf, report_buf, 0x83); }
    iommu_register_dma(report_buf);
    xhci_zero_page(report_buf);

    # Pre-fill the first Normal TRB on the kbd xfer ring pointing to the
    # static 8-byte report buffer. IOC=1 so the Transfer Event surfaces
    # to the event ring once the controller writes the IN data.
    #   p_lo / p_hi = report_buf phys
    #   status      = TRB Transfer Length = mps (8) | Interrupter Target=0
    #   ctrl        = IOC=1 (bit 5) | type=Normal(1)<<10 | cycle=1
    # KBD-RING-DEPTH FIX (1.44.x iron "keyboard dies after the first command").
    # Arm a BATCH of Normal TRBs, not just one. A 1-deep interrupt-IN ring goes
    # EMPTY the instant polling pauses — the IF=0 command-execution gap between
    # two prompt reads (ring 3 runs IF=0 between syscalls; hid_poll only runs
    # from the read spin). The lone TRB is consumed by a key release during the
    # gap, the controller hits the empty ring at the next service interval and
    # STALLS the endpoint, and a bare re-arm+doorbell does NOT reliably restart
    # a stalled interrupt EP on real xHCI -> keyboard wedges after command 1
    # (frozen-not-rebooted; CPU alive on the timer). This is the SAME
    # EP-stall-on-ring-exhaustion class as the 1.33.4 run-off-the-end lockup the
    # Link TRB below fixed — different trigger (gap-depletion vs page-end wrap),
    # identical cure: keep the ring from emptying. Depth 16 >> the <=1 report a
    # builtin's gap can consume (the device sends at most one report per
    # bInterval and the gap is milliseconds), so the controller always finds a
    # valid TRB and never stalls. All TRBs point at the shared report_buf: only
    # one IN transaction completes per interval so reports never overlap
    # in flight; a gap that coalesces >1 report keeps only the LAST (the resting
    # key state once the user lifts off command 1) — applied once, clean, no
    # stranded keys. IOC=bit 5, ISP=bit 2 (Interrupt on Short Packet — Linux
    # always sets ISP for IN data; defensive against <mps bytes). cycle=1.
    var depth = 16;
    var di = 0;
    while (di < depth) {
        var dtrb = xfer_ring + di * 16;
        store64(dtrb + 0, report_buf);
        store32(dtrb + 8, mps & 0x1FFFF);
        store32(dtrb + 12, (1 << 5) | (1 << 2) | (XHCI_TRB_NORMAL << 10) | 0x1);
        di = di + 1;
    }
    hid_kbd_xfer_idx   = depth;   # next free TRB slot (we just filled 0..depth-1)
    hid_kbd_xfer_cycle = 1;

    # Link TRB at slot 255 wraps the transfer ring back to slot 0 (xHCI 1.2
    # §4.9.2.2). WITHOUT it the controller runs off the end of the 256-TRB
    # page after ~255 reports — the 1.33.4 interactive-lockup root cause: the
    # kbd interrupt-IN EP is polled continuously, so a few seconds of typing
    # exhausts the ring, the EP stalls, and keyboard input wedges (the CPU
    # stays alive on the timer, so from the user's seat it looks like a hard
    # freeze; query-status shows the vCPU still running). Mirrors the command
    # ring's Link TRB (xhci_ring.cyr:203-206) + wrap (xhci_cmd.cyr:112-130).
    # Initial C=0 (opposite of PCS=1) so HW won't follow it until
    # hid_arm_xfer_trb aligns its cycle on the first wrap; TC (bit 1) set so
    # HW flips its Consumer Cycle State when it does. Slot 255 is reserved —
    # never armed with a Normal TRB.
    var link = xfer_ring + 255 * 16;
    store64(link, xfer_ring);
    store32(link + 8, 0);
    store32(link + 12, (XHCI_TRB_LINK << 10) | 0x2);

    # Step 5: extend the input context. xhci_alloc_input_ctx left it
    # holding Slot + EP0; we add the kbd interrupt-IN EP context.
    var ictx = xhci_slot_get(xhci_slot_input_ctx, slot_id);
    if (ictx == 0) { return 0; }
    var speed = xhci_slot_get(xhci_slot_speed, slot_id);
    var dci = xhci_input_ctx_add_interrupt_in(ictx, ep_addr, mps,
      interval_byte, speed, xfer_ring);
    if (dci == 0) { return 0; }

    # Step 6: Configure Endpoint command. After this returns success the
    # new EP transitions to Running.
    if (xhci_configure_endpoint(slot_id, ictx) == 0) { return 0; }

    # Step 7: stash module state + kick first IN by ringing the kbd
    # doorbell. Doorbell Target = DCI for stream-less endpoints.
    hid_kbd_slot_id     = slot_id;
    hid_kbd_interface   = intf_num;
    hid_kbd_ep_addr     = ep_addr;
    hid_kbd_ep_mps      = mps;
    hid_kbd_ep_interval = interval_byte;
    hid_kbd_xfer_ring   = xfer_ring;
    hid_kbd_report_buf  = report_buf;
    # ⭐ AND REGISTER THE ENDPOINT, which is what `hid_poll` now matches on. The `hid_kbd_*` globals
    # above stay: they are this device's ring/buffer state and the re-arm path still reads them. The
    # registry answers a different question — "is this Transfer Event mine, and what kind of device is
    # it" — which is the question a second HID device makes ambiguous.
    hid_ep_register(slot_id, ep_addr, HidKind.HID_KIND_KBD, xfer_ring, report_buf, mps);
    var db_addr = xhci_mmio_base + xhci_db_off + slot_id * 4;
    store32(db_addr, dci & 0xFF);

    kprint("hid: keyboard configured, boot protocol on, EP=", 47);
    kprint_num(ep_addr);
    kprintln(", polling 8-byte reports", 24);
    xhci_cmos_stamp(0x50, 0x33);   # kcp = 0x33 per Phase 4 gate
    return 1;
}

# Process a fresh 8-byte HID boot report at phys `report_phys`. Called by
# hid_poll() (Phase 5 event-ring drain) once a Transfer Event arrives on
# the kbd endpoint. Reports a copy in/out via hid_curr_report / hid_prev_report
# so the differ has a stable view independent of further DMA writes.
fn hid_process_report(report_phys) {
    if (hid_kbd_slot_id == 0) { return 0; }
    # Snapshot the freshly-DMAed report into hid_curr_report. We work
    # off the CPU-side copy from here so the controller is free to start
    # the next IN transfer on the transfer ring.
    for (var i = 0; i < 8; i = i + 1) {
        store8(&hid_curr_report + i, load8(report_phys + i));
    }
    var curr_mods = load8(&hid_curr_report + 0);
    var prev_mods = load8(&hid_prev_report + 0);
    hid_modifier_diff(curr_mods, prev_mods);
    hid_report_keys_diff(&hid_curr_report, &hid_prev_report);
    # Promote curr → prev for the next diff cycle.
    for (var j = 0; j < 8; j = j + 1) {
        store8(&hid_prev_report + j, load8(&hid_curr_report + j));
    }
    return 0;
}

# Re-arm the kbd transfer ring with one fresh Normal TRB pointing at the
# shared report buffer. Called after each Transfer Event has been
# processed so the controller has another IN slot to fulfil. Ring is one
# page (256 TRBs at 16 bytes each); we advance enqueue with wrap-and-toggle.
fn hid_arm_xfer_trb() {
    if (hid_kbd_xfer_ring == 0) { return 0; }
    if (hid_kbd_report_buf == 0) { return 0; }
    var trb = hid_kbd_xfer_ring + hid_kbd_xfer_idx * 16;
    store64(trb + 0, hid_kbd_report_buf);
    store32(trb + 8, hid_kbd_ep_mps & 0x1FFFF);
    # IOC=bit 5, ISP=bit 2 — see hid_kbd_configure for rationale.
    var ctrl = (1 << 5) | (1 << 2) | (XHCI_TRB_NORMAL << 10) | (hid_kbd_xfer_cycle & 0x1);
    store32(trb + 12, ctrl);
    hid_kbd_xfer_idx = hid_kbd_xfer_idx + 1;
    # Reached the Link TRB slot (255, set up in hid_kbd_configure): align its
    # cycle bit with the current producer cycle so HW follows it, flip our
    # cycle, wrap to slot 0. Mirrors xhci_cmd_submit's wrap (xhci_cmd.cyr:115).
    # Pre-1.33.4 this wrapped at `>= 256` with no Link TRB — the controller
    # had no way to return to slot 0 and fell off the page end.
    if (hid_kbd_xfer_idx == 255) {
        var link = hid_kbd_xfer_ring + 255 * 16;
        var link_dw3 = load32(link + 12);
        if (hid_kbd_xfer_cycle == 1) { link_dw3 = link_dw3 | 0x1; }
        else { link_dw3 = link_dw3 & 0xFFFFFFFE; }
        store32(link + 12, link_dw3);
        if (hid_kbd_xfer_cycle == 1) { hid_kbd_xfer_cycle = 0; }
        else { hid_kbd_xfer_cycle = 1; }
        hid_kbd_xfer_idx = 0;
    }
    return 1;
}

# Restart kick for the kbd interrupt-IN endpoint: ring its doorbell so the
# controller re-evaluates the transfer ring. Ringing a Running endpoint's
# doorbell is a spec-defined no-op; ringing a STALLED-but-armed one resumes it.
# Called at the start of every blocking read so a read entered after an idle
# command-execution gap explicitly re-kicks the EP — belt-and-suspenders with
# the deep ring (which prevents the stall in the first place). KBD-RING-DEPTH FIX.
fn hid_kbd_kick() {
    if (hid_kbd_slot_id == 0) { return 0; }
    var our_dci = xhci_dci_for_ep(hid_kbd_ep_addr);
    var db_addr = xhci_mmio_base + xhci_db_off + hid_kbd_slot_id * 4;
    store32(db_addr, our_dci & 0xFF);
    return 0;
}

# Phase 5 poll entry — drain the event ring, processing any Transfer
# Events that belong to the kbd interrupt-IN endpoint. Non-blocking;
# returns immediately when no matching events are pending. Intended to
# be called from the timer-ISR / scheduler-tick path (one call site,
# trivial to wire — planning doc § Phase 5).
#
# Per xHCI 1.2 §6.4.2.1, Transfer Event TRB layout:
#   DW0/1 — pointer to the producer TRB that completed
#   DW2   — bits 31:24 ccode, bits 23:0 transfer length (mps − residual)
#   DW3   — bit 0 cycle, bits 15:10 type=32, bits 20:16 EP ID (DCI),
#           bits 31:24 slot ID
#
# Non-kbd events are passed through silently — xhci_wait_transfer_event
# is the synchronous consumer for EP0 events during Phase 3/4 control
# transfers, and shouldn't be running concurrently with hid_poll under
# the current cooperative-poll regime. If that invariant ever changes
# (interrupt-driven xHCI), this loop needs to become event-type-aware.
# ⭐⭐ THE DRAIN'S OWN TRY-LOCK — because `cli` is not a lock on four CPUs.
#
# ⛔⛔ `hid_poll` has TWO callers that can run at once: the `#98 ptrscan` / `#42 kbscan` syscall arms in
# ring 3, and `xhci_rx_handler` in the MSI-X ISR. It dequeues the shared xHCI event ring and folds into a
# shared accumulator, with no serialisation of any kind — and `keyboard.cyr`'s claim that this path is
# "self-guarded (input_lock, cli-first)" is FALSE: `input_lock` is taken only by `hid_kb_push` and
# `kb_read_scancode`, and guards `kb_buf` alone. On SMP, `cli` on one CPU does not exclude the MSI-X
# handler on another, so two drains can advance `xhci_evt_ring_idx` over the same event or interleave a
# read-modify-write on `hid_mouse_dx`.
#
# ⭐ A TRY-LOCK, NOT A SPIN, AND THAT CHOICE IS THE WHOLE SAFETY ARGUMENT. A spin would DEADLOCK the moment
# the ISR interrupted a lock-holder on the same CPU — which is exactly the common case, since the syscall
# arm enables interrupts around its drain. Failing to acquire simply means another context is already
# draining this ring; it will consume the events, so returning is correct rather than lossy.
# ⚠ Frame layout is load-bearing: this mirrors `input_spin_lock` in keyboard.cyr byte for byte, including
# the DECLARATION ORDER of `old` then `addr` — the hand-assembled `xchg` addresses them as [rbp-0x08] and
# [rbp-0x10]. Reordering these two lines silently breaks the lock.
var hid_poll_lock = 0;
fn hid_poll_trylock(): i64 {
    var old = 1;
    var addr = &hid_poll_lock;
    asm {
        0x48; 0x8B; 0x45; 0xF0;                    # mov rax, [rbp-0x10] (addr)
        0x48; 0xC7; 0xC1; 0x01; 0x00; 0x00; 0x00;  # mov rcx, 1
        0x48; 0x87; 0x08;                          # xchg [rax], rcx
        0x48; 0x89; 0x4D; 0xF8;                    # mov [rbp-0x08], rcx (old)
    }
    if (old == 0) { return 1; }                    # we took it
    return 0;                                      # someone else is draining
}
fn hid_poll_unlock() {
    var addr = &hid_poll_lock;
    asm {
        0x48; 0x8B; 0x45; 0xF8;                    # mov rax, [rbp-0x08] (addr)
        0x48; 0x31; 0xC9;                          # xor rcx, rcx
        0x48; 0x87; 0x08;                          # xchg [rax], rcx
    }
    return 0;
}

# ================= DEFERRED HID SERVICE — THREAD CONTEXT ONLY =====================================
#
# ⛔⛔ EVERYTHING IN HERE IS WORK `hid_poll` IS NOT ALLOWED TO DO, and the reason is the same for both
# halves: `hid_poll` runs in interrupt context (100 Hz timer tick, and the xHCI MSI-X handler), where
# taking the console lock can deadlock the CPU against itself and where a command that BLOCKS on a
# Command Completion Event can never complete. So the ISR records intent in a flag and returns; this
# function is the thread-context half that acts on it.
#
# ⚠ CALL SITES MUST BE THREAD CONTEXT. Today: `kb_has_key()` (the keyboard read loop) and the `#98`
# ptrscan syscall arm. Both are reached from ring 3 via a syscall, never from an ISR. ⛔ Do NOT add a
# call from `pic.cyr` or any other interrupt handler — that reintroduces exactly the hang this exists
# to prevent, and it would look like it works right up until a keystroke echo coincides with a tick.

# Print the one-shots the drain owed us. Latches live at their producers, so this stays one line each
# per boot no matter how often it is called.
# ⚠ Reading-then-clearing without a lock is safe here: the ISR only ever sets these 0 -> 1, so the worst
# interleaving is printing one tick later, never twice (the producer's own latch prevents a re-set).
fn hid_flush_oneshots() {
    if (hid_first_report_pending == 1) {
        hid_first_report_pending = 0;
        kprintln("hid: first keyboard report dispatched via the endpoint registry", 63);
    }
    if (hid_mouse_first_pending == 1) {
        hid_mouse_first_pending = 0;
        kprintln("hid: first mouse report accumulated", 35);
    }
    return 0;
}

# Recover any endpoint the drain saw halt. Stall (6), Transaction Error (4) and Babble (8) leave the
# endpoint Halted with its dequeue pointer pinned; re-arming the ring is inert until Reset Endpoint has
# moved it Halted -> Stopped and Set TR Dequeue has repositioned it. Mirrors the mass-storage recovery
# in msc.cyr, minus the bulk-specific CBW/CSW resynchronisation which has no HID analogue.
# ⚠ Gate Reset Endpoint on actually reading Halted: it is only legal from that state, and a Context
# State Error abort on a wrong-state reset is its own failure mode (msc.cyr records one that bricked a
# boot). If the state has already moved on, clear the flag and leave the endpoint alone.
# ⚠⚠ PROVEN REACHABLE, NOT PROVEN CORRECT — AND THE DIFFERENCE MATTERS FOR WHOEVER TOUCHES THIS NEXT.
# Injecting a halting completion code (HID_CC_INJECT with ccode 6) shows the flag is set, this function
# is called from thread context, and the system survives. It does NOT show the reset sequence works,
# because an injected code is fabricated by software: the CONTROLLER never actually halted, so
# xhci_ep_state() reports Running and the body below early-outs before issuing a single command.
# ⇒ The Reset Endpoint / Set TR Dequeue pair here has never executed anywhere. Validating it needs a
# genuine halt — a real Stall from real silicon, or a controller-level fault-injection agnos does not
# have. Treat the sequence as prior-art-shaped (it mirrors msc.cyr, which IS iron-proven) but untested.
fn hid_recover_halted() {
    var i = 0;
    while (i < hid_ep_count) {
        if (load64(&hid_ep_needs_reset + i * 8) == 1) {
            store64(&hid_ep_needs_reset + i * 8, 0);
            var slot = load64(&hid_ep_slot + i * 8);
            var dci  = load64(&hid_ep_dci  + i * 8);
            if (xhci_ep_state(slot, dci) == XHCI_EP_STATE_HALTED) {
                if (xhci_cmd_reset_endpoint(slot, dci) == 0) {
                    kprintln("hid: an endpoint halted and the controller refused to reset it", 62);
                } else {
                    # Reposition the dequeue pointer at the ring slot the producer will fill next, with
                    # the producer's current cycle state, then re-arm and ring the doorbell. Without the
                    # Set TR Dequeue the controller resumes at the pinned TRB and halts again immediately.
                    var ring = load64(&hid_ep_ring  + i * 8);
                    var idx  = load64(&hid_ep_idx   + i * 8);
                    var cyc  = load64(&hid_ep_cycle + i * 8);
                    if (xhci_cmd_set_tr_dequeue(slot, dci, ring + idx * 16, cyc & 0x1) == 0) {
                        kprintln("hid: an endpoint reset but its dequeue pointer would not move", 61);
                    } else {
                        hid_arm_row_trb(i);
                        var db = xhci_mmio_base + xhci_db_off + slot * 4;
                        store32(db, dci & 0xFF);
                        kprintln("hid: an endpoint halted and was reset; input from it should resume", 66);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# The one entry point callers use. Cheap to call often: both halves short-circuit on a clean system.
fn hid_service_deferred() {
    hid_flush_oneshots();
    hid_recover_halted();
    return 0;
}

fn hid_poll() {
    # ⛔ THIS USED TO READ `hid_kbd_slot_id == 0`, i.e. "no KEYBOARD, do nothing" — which on a box with a
    # mouse and no keyboard means nothing is drained AND `IMAN.IP` below is never cleared, so the
    # controller sends no further MSI-X and every device goes quiet. The guard's real job is to prove
    # xHCI init ran before `xhci_rt_base` is touched, and a non-empty registry proves that just as well.
    if (hid_ep_count == 0) { return 0; }
    if (hid_poll_trylock() == 0) { return 0; }     # another context owns the ring; it will drain it
    # Re-arm interrupter 0 FIRST (before draining): write-1-clear IMAN.IP (bit 0), keep IE (bit 1)
    # by writing 0x3 — the same value init used. Per xHCI 1.2 §5.5.2.1 an MSI-X message is generated
    # on the IP 0->1 edge; if software leaves IP set the controller sends NO further MSI-X, so the
    # interrupt-driven keyboard fires exactly ONCE and the hlt-blocked shell hangs. QEMU's xHCI
    # model is lenient about this; real AMD FCH (1022:1639) enforces the edge — this was the iron-
    # only "stuck after first USB-HID IRQ" hang. Clearing IP early means an event arriving mid-drain
    # re-sets IP (0->1) and queues the next message, so nothing is missed. The slot-id guard above
    # ensures xHCI init ran, so xhci_rt_base is valid before we touch the interrupter register.
    var ir0 = xhci_rt_base + XHCI_RT_IR0_BASE;
    xhci_rt_write32(ir0 + XHCI_IR_IMAN, 0x3);
    var processed = 0;
    var drained = 0;
    while (drained < 64) {       # bound — prevents runaway on corrupt cycle
        var evt_off = xhci_evt_ring_idx * 16;
        var evt     = xhci_evt_ring_phys + evt_off;
        var evt_dw3 = load32(evt + 12);
        var evt_cycle = evt_dw3 & 0x1;
        if (evt_cycle != xhci_evt_ring_cycle) {
            # No more events for us this tick — exit.
            break;
        }
        var evt_type = (evt_dw3 >> 10) & 0x3F;
        var evt_slot = (evt_dw3 >> 24) & 0xFF;
        var evt_ep   = (evt_dw3 >> 16) & 0x1F;
        if (evt_type == XHCI_TRB_TRANSFER_EVENT) {
            # ⭐ ONE DRAIN, DISPATCHED. This used to compare against `hid_kbd_slot_id` and a freshly
            # recomputed `xhci_dci_for_ep(hid_kbd_ep_addr)` — a hardcoded single-device match, below a
            # loop that consumes the event either way. A second HID device therefore could not be served
            # by a second poller: this loop would already have eaten its completions.
            # ⚠ The doorbell target is `evt_ep`, which IS the matched row's DCI — the event told us.
            # ⭐⭐ TWO VARIABLES, AND THE SPLIT IS THE WHOLE FIX. `row` is the endpoint this event
            # belongs to and is ALWAYS valid — it is used for ring MAINTENANCE (re-arm + doorbell), which
            # must happen whether or not the transfer carried data. `cc_ok` gates only whether the report
            # is FOLDED. Overloading one variable for both is what broke this: the old code did
            # `if (cc_ok == 0) { bi = 0 - 1; }` with the comment "re-arm below, fold nothing", but
            # `hid_ep_kind_at(-1)` is HID_KIND_NONE, so BOTH kind-gated blocks were skipped — and those
            # blocks hold the ONLY re-arm and doorbell writes. There was no re-arm below.
            # ⛔ THE CONSEQUENCE WAS SILENT AND TERMINAL. The event is consumed unconditionally further
            # down, so each rejected completion permanently spent one TRB of a 16-deep ring. Sixteen
            # cumulative errors empty the ring, and this file already documents what follows: "the
            # controller hits the empty ring at the next service interval and STALLS the endpoint."
            # Presents as INPUT FROZE, CPU STILL ALIVE, with nothing in the log.
            var row = hid_ep_find(evt_slot, evt_ep);
            # ⛔⛔ DID THE TRANSFER ACTUALLY SUCCEED? A Transaction Error, Babble, Stall or Data Buffer
            # Error still posts a Transfer Event with IOC set — the TRB completed, it just did not carry
            # data — and leaves the shared report page holding the PREVIOUS successful report. Folding
            # that page again re-adds the last dX/dY as if the user had moved: a phantom cursor jump on
            # every USB hiccup, of exactly the size of the last real motion. `xhci.cyr` checks this code
            # on the command ring (`ccode` at its line 847); the HID drain never did.
            # ⚠ Completion code is dword 2, bits 31..24. 1 = SUCCESS, 13 = SHORT_PACKET — a short packet
            # is NORMAL for an interrupt-IN endpoint that sent fewer than the max-packet bytes, so it must
            # be accepted or the boot mouse's 4-byte reports on an 8-byte endpoint would all be dropped.
            var evt_dw2 = load32(evt + 8);
            var ccode = (evt_dw2 >> 24) & 0xFF;
            var cc_ok = 0;
            if (ccode == 1) { cc_ok = 1; }
            if (ccode == 13) { cc_ok = 1; }
            #ifdef HID_CC_INJECT
            # ⭐ FAULT INJECTION — THE ONLY WAY TO PROVE THE RE-ARM PATH. QEMU never emits a rejected
            # completion code, so the "re-arm even when the report is unusable" fix above is otherwise
            # compiled-but-never-executed. This forces the first 20 completions to look like a
            # non-halting Data Buffer Error (2) — more than the 16 TRBs armed at init, so the ring is
            # provably exhausted. WITH the fix the ring keeps being re-armed and the keyboard works
            # again once injection stops; WITHOUT it the endpoint stalls and never recovers.
            # ⛔ Build-gated and OFF by default. Never ship a kernel with this defined.
            if (hid_cc_inject_left > 0) {
                hid_cc_inject_left = hid_cc_inject_left - 1;
                cc_ok = 0;
                ccode = 2;                # Data Buffer Error: rejected, but NOT a halting code
            }
            #endif
            # ⛔ A HALTING CODE MAKES A BARE RE-ARM INERT, so re-arming is necessary but NOT sufficient.
            # Stall (6), Transaction Error (4) and Babble (8) leave the endpoint HALTED with its dequeue
            # pointer pinned: the controller will not advance it again until software issues Reset
            # Endpoint + Set TR Dequeue Pointer. Those commands BLOCK on a Command Completion Event, so
            # they cannot run here in ISR context — flag the row and let hid_recover_halted() do it from
            # thread context. ⚠ Without this, one marginal cable or hub glitch kills that device until
            # reboot, silently. mass-storage has had this recovery for a while (msc.cyr); HID never did.
            if (row >= 0) {
                var halting = 0;
                if (ccode == 4) { halting = 1; }
                if (ccode == 6) { halting = 1; }
                if (ccode == 8) { halting = 1; }
                if (halting == 1) { store64(&hid_ep_needs_reset + row * 8, 1); }
            }
            if (hid_ep_kind_at(row) == HidKind.HID_KIND_KBD) {
                if (cc_ok == 1) {
                    # ⭐ NAME THE PATH THAT DELIVERED THE FIRST KEY, once. Without this the drain is
                    # silent, and silence is why a mutation test of this very dispatch read GREEN while
                    # the keyboard kept working — there was no way to tell whether keys came through here
                    # or through the PS/2 ISR that used to shadow it. A flag here makes the producer
                    # self-identifying on any boot, QEMU or iron. [[feedback_instrument_discipline]]
                    # ⚠ FLAG, DO NOT PRINT — this runs in ISR context. See the hid_first_report_pending
                    # banner at the top of this file for the deadlock a kprintln here causes.
                    if (hid_first_report == 0) {
                        hid_first_report = 1;
                        hid_first_report_pending = 1;
                    }
                    # Kbd IN report just landed in hid_kbd_report_buf.
                    hid_process_report(hid_kbd_report_buf);
                    processed = processed + 1;
                }
                # ⚠ UNCONDITIONAL — the ring must be re-armed even when the report was unusable.
                hid_arm_xfer_trb();
                var db_addr = xhci_mmio_base + xhci_db_off + evt_slot * 4;
                store32(db_addr, evt_ep & 0xFF);
            }
            # ⭐ THE MOUSE ARM. Every event is FOLDED, never latched — see the accumulator's header for
            # why keeping only the last report of a coalescing gap amplifies relative motion ~2-3x.
            if (hid_ep_kind_at(row) == HidKind.HID_KIND_MOUSE) {
                if (cc_ok == 1) {
                    hid_process_mouse_report(load64(&hid_ep_buf + row * 8), row, evt_dw2 & 0xFFFFFF);
                    processed = processed + 1;
                }
                # ⚠ UNCONDITIONAL — see the keyboard arm above.
                hid_arm_row_trb(row);
                var mdb = xhci_mmio_base + xhci_db_off + evt_slot * 4;
                store32(mdb, evt_ep & 0xFF);
            }
        }
        # Consume the event regardless of which path matched — non-kbd
        # events drop silently here. (If EP0 transfers run concurrently
        # this would race with xhci_wait_transfer_event; see note above.)
        xhci_evt_ring_idx = xhci_evt_ring_idx + 1;
        if (xhci_evt_ring_idx == XHCI_EVT_RING_SEGMENT_SIZE) {
            xhci_evt_ring_idx = 0;
            if (xhci_evt_ring_cycle == 1) { xhci_evt_ring_cycle = 0; }
            else { xhci_evt_ring_cycle = 1; }
        }
        drained = drained + 1;
    }
    if (drained > 0) {
        var ir0 = xhci_rt_base + XHCI_RT_IR0_BASE;
        var new_erdp = xhci_evt_ring_phys + xhci_evt_ring_idx * 16;
        xhci_rt_write64(ir0 + XHCI_IR_ERDP, new_erdp | 0x8);
    }
    # ⚠ THE ONLY EXIT PAST THE TRY-LOCK. Verified by inspection: between the acquire and here every branch
    # falls through rather than returning, so one release covers the function. Any `return` added inside
    # this body MUST release first, or the drain wedges for the rest of the boot and input dies silently.
    hid_poll_unlock();
    return processed;
}
