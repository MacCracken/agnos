# blend_alpha.emit.cyr — the SOVEREIGN SOURCE for blend_alpha: blend_rect plus a uniform per-surface
# alpha. 55 instructions, 69 dwords, 276 bytes. Reference listing: kernel/shaders/blend_alpha.s.
#
# ⛔⛔ THIS SHADER HAS NOT BEEN BURNED, AND THAT CHANGES WHAT THIS FILE IS.
# blend_rect.emit.cyr is checked against COMMITTED, IRON-PROVEN hex — the bytes ran on archaemenid and
# produced correct pixels, so byte-equivalence there is evidence about reality. blend_alpha has no such
# hex. Its only oracles are host artifacts written the same week from the same arithmetic story, and
# `scripts/check/shader-blob.sh:11-15` already records that an assembled-but-unrun blob "has not met
# the bar for a hardware run". Everything below is a PREDICTION.
#
# ⭐ WHAT IS GENUINELY INDEPENDENT HERE, AND IT IS THE ONE THING WORTH TRUSTING: this emit list runs
# through **mabda's encoder**, and `kernel/shaders/blend_alpha.s` runs through **llvm-mc**. Two
# assemblers, neither derived from the other, must produce the same 69 dwords. That is a real check —
# it is exactly the pairing agnos already relies on for the shaders it has burned.
#
# ⛔ THE KERNEL DOES NOT INCLUDE THIS FILE and there is no committed `blend_alpha_write` yet. Adding
# one is a later bite, gated on the burn.
#
# DERIVATION FROM blend_rect.emit.cyr — 9 inserted dwords, 5 CHANGED, 55 unchanged. Machine-checked by
# `scripts/check/shader-derive.sh`; this comment is documentation, not the gate.
#
# ⚠⚠ THE FIFTH CHANGE IS THE ONE THAT BITES. Taking s7 for `alpha` pushes USER_SGPR 7 -> 8, moving the
# TGIDs s7/s8 -> s8/s9. Four dwords READ a TGID and obviously follow. The fifth WRITES s9 as the column
# scratch — and under the new layout s9 IS tgid_y, so it would destroy the row index before the two
# `s_mul_i32 ..., s9, pitch` reads consume it. Column group 0 would write row 0 for every y. It
# assembles clean, matches its own blob byte for byte, and faults nothing. Scratch moved to s15.
#
# ⚠ Register budget: VGPR high-water v13 (was v12), SGPR high-water s21 (was s20). Both stay inside
# their granules, so RSRC1 is **0x002C00C3 — bit-identical to blend_rect's** and no new constant is
# needed. RSRC2 becomes 0x00000190, which already exists as GPU_COMPUTE_RSRC2_COV. Verified by reading
# llvm-mc's emitted kernel descriptor, not by arithmetic alone.
#
# ⚠ THE TIE RULE IS AN OPEN, BURN-OVERTURNABLE QUESTION. blend_rect never reached an exact .5 tie
# (gpu.cyr states it is unreachable there). blend_alpha reaches it: 5,905 in-range premultiplied ties,
# on which round-half-even and round-half-away differ for 3,010 outputs. This assumes RTNE, matching
# `.amdhsa_float_round_mode_32 0`. The tree's only burn evidence does not discriminate — burn 1's
# 249 -> 250 is a tie where 250 is even, so both rules agree there.

fn blend_alpha_emit(): i64 {

    var p = 0;

    # ---- BOUNDS GUARD: mask off lanes past the right edge BEFORE forming any address ----
    # ⚠ The guard precedes the LOADS, not just the store. A masked-off lane must not load either: a
    # load past the rect edge on the last row could read past the end of the mapped back buffer,
    # which is a fault rather than a wasted fetch.
    # ⚠⚠ CHANGED TWICE, AND THE DESTINATION IS THE DANGEROUS HALF. blend_rect wrote the column
    # scratch to s9; under USER_SGPR=8 s9 IS tgid_y, so that write would destroy the row index
    # before the two `s_mul_i32 ..., s9, pitch` below read it. Every row address would collapse to a
    # function of the column group. It assembles clean and faults nothing. Scratch moves to s15 —
    # the only unused SGPR below the saved-EXEC pair (blend_rect touches s0-s14, s16-s20).
    p = e_sop2(p, AG_SOP2_S_LSHL_B32, 15, S(8), K(6));           # s15 = tgid_x * 64      (first px x)
    p = e_vop2(p, AG_VOP2_V_ADD_U32, 12, S(15), 0);              # v12 = s15 + v0         (this lane's x)
    p = e_vopc(p, AG_VOPC_V_CMP_GT_U32, S(6), 12);               # vcc = width > x
    p = e_sop1(p, AG_SOP1_S_AND_SAVEEXEC_B64, 16, VCC);          # s[16:17] = exec; exec &= vcc

    # ---- scalar address setup: the whole group shares one row and one column base ----
    # Scalar ops run regardless of EXEC, so this is safe (and cheaper) after the mask.
    p = e_sop2(p, AG_SOP2_S_LSHL_B32, 10, S(8), K(8));           # s10 = tgid_x * 64 px * 4 B
    p = e_sop2(p, AG_SOP2_S_MUL_I32,  11, S(9), S(4));           # s11 = tgid_y * src_pitch
    p = e_sop2(p, AG_SOP2_S_ADD_U32,  11, S(11), S(10));
    p = e_sop2(p, AG_SOP2_S_ADD_U32,  12, S(0), S(11));          # s12 = src_lo + off   (sets SCC)
    p = e_sop2(p, AG_SOP2_S_ADDC_U32, 13, S(1), K(0));           # s13 = src_hi + carry -> s[12:13]
    p = e_sop2(p, AG_SOP2_S_MUL_I32,  14, S(9), S(5));           # s14 = tgid_y * dst_pitch
    p = e_sop2(p, AG_SOP2_S_ADD_U32,  14, S(14), S(10));
    p = e_sop2(p, AG_SOP2_S_ADD_U32,  18, S(2), S(14));          # s18 = dst_lo + off   (sets SCC)
    p = e_sop2(p, AG_SOP2_S_ADDC_U32, 19, S(3), K(0));           # s19 = dst_hi + carry -> s[18:19]

    p = e_vop2(p, AG_VOP2_V_LSHLREV_B32, 1, K(2), 0);            # v1 = v0 * 4  (byte offset in group)

    # ---- src pixel -> v2 ----
    p = e_vop1(p, AG_VOP1_V_MOV_B32, 4, S(12));
    p = e_vop1(p, AG_VOP1_V_MOV_B32, 5, S(13));
    p = e_vop2(p, AG_VOP2_V_ADD_CO_U32,  4, V(4), 1);            # v4 = v4 + v1, carry -> vcc
    p = e_vop2(p, AG_VOP2_V_ADDC_CO_U32, 5, K(0), 5);            # v5 = 0 + v5 + vcc
    p = e_flat(p, 0x14, 0, 2, 0, 4, 0);                          # global_load_dword v2, v[4:5], off

    # ---- dst pixel -> v3 ; v[6:7] is ALSO the store address (in place) ----
    p = e_vop1(p, AG_VOP1_V_MOV_B32, 6, S(18));
    p = e_vop1(p, AG_VOP1_V_MOV_B32, 7, S(19));
    p = e_vop2(p, AG_VOP2_V_ADD_CO_U32,  6, V(6), 1);
    p = e_vop2(p, AG_VOP2_V_ADDC_CO_U32, 7, K(0), 7);
    p = e_flat(p, 0x14, 0, 3, 0, 6, 0);                          # global_load_dword v3, v[6:7], off
    p = e_sopp(p, AG_SOPP_S_WAITCNT, AG_WAITCNT_VMCNT0);

    # ---- INSERTED PROLOGUE (4 dwords): fa = alpha / 255, in v13 ----
    # ⚠ Placed AFTER the EXEC mask so surplus lanes do not execute it, and after the waitcnt so it sits
    # outside the two SCC-coupled s_add_u32/s_addc_u32 address pairs — inserting between either pair
    # would drop a 64-bit carry silently.
    p = e_sop1_lit(p, AG_SOP1_S_MOV_B32, 21, 0x3B808081);        # s21 = +1/255f
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE0, 13, S(7));           # v13 = f32(alpha)   (VOP1 src0 reaches SGPRs)
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 13, S(21), 13);           # v13 = fa = alpha/255

    # ---- blend body: ia = 1 - src_a/255, as one FMA ----
    # ⛔ THE CONSTANT MUST BE STAGED IN AN SGPR. VOP3 has no 32-bit literal form on gfx9, so
    # -1/255f cannot ride inside the FMA; `s_mov_b32 s20, 0xBB808081` is a two-dword SOP1 whose
    # second dword IS the literal. asmlib's e_sop1_lit emits both in one call precisely because a
    # half-emitted pair shifts every instruction after it with no fault.
    # ⚠ s20 AND NOT s6. blend_premul.s stages this constant in s6, which here is the `width`
    # kernarg — reusing it would corrupt an argument. This is the single register difference
    # between the two kernels and the reason blend_rect is not a copy-paste of blend_premul.
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE3, 8, V(2));            # v8 = f32(src.a)
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 8, V(13), 8);             # INSERTED: sa' = src_a * fa
    p = e_sop1_lit(p, AG_SOP1_S_MOV_B32, 20, 0xBB808081);        # s20 = -1/255f
    p = e_vop3(p, AG_VOP3_V_FMA_F32, 8, V(8), S(20), F1);        # v8 = src_a * -1/255 + 1.0

    # Four channel blocks, identical but for the ubyte selector and the pk_u8 byte index.
    # ⚠ ROUNDING: v_cvt_pk_u8_f32 rounds to NEAREST — settled on iron (1.56.0 burn 1, where an
    # added +0.5 came out +1 on every channel). No rounding bias is applied.
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE0, 9,  V(2));
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 9, V(13), 9);              # INSERTED: scale the SOURCE only
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE0, 10, V(3));
    p = e_vop3(p, AG_VOP3_V_FMA_F32, 9, V(10), V(8), V(9));      # v9 = dst*ia + src
    p = e_vop3(p, AG_VOP3_V_CVT_PK_U8_F32, 11, V(9), K(0), V(11));

    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE1, 9,  V(2));
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 9, V(13), 9);              # INSERTED: scale the SOURCE only
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE1, 10, V(3));
    p = e_vop3(p, AG_VOP3_V_FMA_F32, 9, V(10), V(8), V(9));
    p = e_vop3(p, AG_VOP3_V_CVT_PK_U8_F32, 11, V(9), K(1), V(11));

    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE2, 9,  V(2));
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 9, V(13), 9);              # INSERTED: scale the SOURCE only
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE2, 10, V(3));
    p = e_vop3(p, AG_VOP3_V_FMA_F32, 9, V(10), V(8), V(9));
    p = e_vop3(p, AG_VOP3_V_CVT_PK_U8_F32, 11, V(9), K(2), V(11));

    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE3, 9,  V(2));
    p = e_vop2(p, GFX9_VOP2_V_MUL_F32, 9, V(13), 9);              # INSERTED: scale the SOURCE only
    p = e_vop1(p, AG_VOP1_V_CVT_F32_UBYTE3, 10, V(3));
    p = e_vop3(p, AG_VOP3_V_FMA_F32, 9, V(10), V(8), V(9));
    p = e_vop3(p, AG_VOP3_V_CVT_PK_U8_F32, 11, V(9), K(3), V(11));

    # ---- store in place over the dst pixel ----
    # ⚠ glc=1. The store must be globally coherent or the compositor's next read races it.
    p = e_flat(p, 0x1C, 1, 0, 11, 6, 0);                         # global_store_dword v[6:7], v11 glc
    p = e_sopp(p, AG_SOPP_S_WAITCNT, AG_WAITCNT_VMCNT0);
    p = e_sopp(p, AG_SOPP_S_ENDPGM, 0);

    # ⛔ NO PREFETCH PAD. Every mabda kernel builder appends `gfx9_emit_prefetch_pad` (64 bytes of
    # s_nop). agnos ships NONE: `grep -c 0xbf800000 kernel/core/gpu.cyr` is 0 and every agnos blob
    # ends on s_endpgm. asmlib deliberately does not re-export the pad so it cannot be added by
    # reflex. ⚠ agnos gets away with this only because arena slots are heavily over-allocated
    # (blend_rect's is a 4 KB slot for 240 B); an arena tightening would remove that safety net
    # silently. Recorded here because it is an undocumented load-bearing dependency.
    return p;
}
