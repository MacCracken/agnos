# === Kernel Test Suite ===
# Functional correctness tests run inside the kernel via QEMU serial.
# Usage: type 'test' at the AGNOS shell prompt.
#
# Assertion framework: test_pass/test_fail counters, serial output.

var test_pass = 0;
var test_fail = 0;

fn test_assert(cond, name, nlen) {
    if (cond != 0) {
        serial_print("  PASS: ", 8);
        serial_println(name, nlen);
        test_pass = test_pass + 1;
    } else {
        serial_print("  FAIL: ", 8);
        serial_println(name, nlen);
        test_fail = test_fail + 1;
    }
    return 0;
}

fn test_assert_eq(a, b, name, nlen) {
    if (a == b) {
        serial_print("  PASS: ", 8);
        serial_println(name, nlen);
        test_pass = test_pass + 1;
    } else {
        serial_print("  FAIL: ", 8);
        serial_print(name, nlen);
        serial_print(" (got ", 6);
        kfmt_int(a);
        serial_print(", want ", 7);
        kfmt_int(b);
        serial_println(")", 1);
        test_fail = test_fail + 1;
    }
    return 0;
}

# === PMM Tests ===
fn test_pmm() {
    serial_println("[pmm]", 5);
    var before = pmm_free_count();

    # Alloc returns non-zero, distinct pages
    var p1 = pmm_alloc();
    var p2 = pmm_alloc();
    var p3 = pmm_alloc();
    test_assert(p1 != 0, "alloc returns non-zero", 22);
    test_assert(p2 != 0, "alloc second non-zero", 21);
    test_assert(p1 != p2, "alloc distinct p1!=p2", 21);
    test_assert(p1 != p3, "alloc distinct p1!=p3", 21);
    test_assert(p2 != p3, "alloc distinct p2!=p3", 21);

    # Pages are 4KB aligned
    test_assert_eq(p1 & 0xFFF, 0, "p1 4KB aligned", 14);
    test_assert_eq(p2 & 0xFFF, 0, "p2 4KB aligned", 14);

    # Free count decreased by 3
    test_assert_eq(pmm_free_count(), before - 3, "free count -3", 13);

    # Free and re-check
    pmm_free(p1);
    pmm_free(p2);
    pmm_free(p3);
    test_assert_eq(pmm_free_count(), before, "free restores count", 19);

    # Double-free: freeing already-free page should be idempotent
    var before2 = pmm_free_count();
    pmm_free(p1);
    test_assert_eq(pmm_free_count(), before2, "double-free idempotent", 22);

    # Boundary: page 4095 (last valid)
    test_assert_eq(pmm_set(4095), 0, "set page 4095 ok", 16);
    test_assert_eq(pmm_test(4095), 1, "test page 4095 set", 18);
    pmm_clear(4095);
    test_assert_eq(pmm_test(4095), 0, "clear page 4095", 15);

    # ⛔⛔ 1.56.53 — THIS ASSERTED A 4096-PAGE BITMAP AND THE BITMAP HAS BEEN 65536 PAGES FOR A LONG
    # TIME, so both lines failed by construction and were carried in state.md as part of six
    # "pre-existing / Unexplained" ktest failures. Page 4096 is 16 MB in; `pmm_bitmap` is 8 KB =
    # 65536 pages = 256 MB (pmm.cyr), and `pmm_migrate_bitmap` grows it to cover full RAM on a big
    # box. Setting page 4096 is a perfectly legal operation now, so "rejected" could never hold.
    # ⭐ DERIVE THE BOUND, DO NOT WRITE IT DOWN. The previous literal went stale silently the moment
    # the bitmap grew; reading `pmm_bitmap_pages` means the boundary case follows the allocator
    # wherever it goes, including after migration. Same reasoning as check-initstack.sh re-deriving
    # the init-stack extent from the live constants instead of restating it.
    # ⚠ Page `pmm_bitmap_pages` is the first index PAST the end, so it must be refused; the in-range
    # neighbour above (4095) still exercises the accept side.
    test_assert_eq(pmm_set(pmm_bitmap_pages), 0 - 1, "set page past the bitmap rejected", 33);
    test_assert_eq(pmm_test(pmm_bitmap_pages), 0, "test page past the bitmap = 0", 29);

    return 0;
}

# === Heap Tests ===
fn test_heap() {
    serial_println("[heap]", 6);

    # slab_class_for returns correct classes
    test_assert_eq(slab_class_for(1), 0, "class for 1B = 0", 16);
    test_assert_eq(slab_class_for(32), 0, "class for 32B = 0", 17);
    test_assert_eq(slab_class_for(33), 1, "class for 33B = 1", 17);
    test_assert_eq(slab_class_for(64), 1, "class for 64B = 1", 17);
    test_assert_eq(slab_class_for(4096), 7, "class for 4096B = 7", 19);
    test_assert_eq(slab_class_for(4097), 0 - 1, "class for 4097B = -1", 20);

    # Zero-size alloc returns 0
    test_assert_eq(kmalloc(0), 0, "kmalloc(0) returns 0", 20);

    # Oversized alloc returns 0
    test_assert_eq(kmalloc(8192), 0, "kmalloc(8192) returns 0", 23);

    # Normal allocs return distinct non-zero pointers
    var a1 = kmalloc(32);
    var a2 = kmalloc(32);
    test_assert(a1 != 0, "kmalloc(32) non-zero", 20);
    test_assert(a2 != 0, "kmalloc(32) second non-zero", 27);
    test_assert(a1 != a2, "kmalloc(32) distinct", 20);

    # Allocated memory is zeroed
    test_assert_eq(load64(a1), 0, "kmalloc zeroes memory", 21);
    test_assert_eq(load64(a2), 0, "kmalloc zeroes second", 21);

    # Write and read back
    store64(a1, 0xDEADBEEF);
    test_assert_eq(load64(a1), 0xDEADBEEF, "heap write/read", 15);

    # No overlap: writing a1 doesn't corrupt a2
    test_assert_eq(load64(a2), 0, "no overlap a1->a2", 17);

    # Free and re-alloc should recycle
    kfree_sized(a1, 32);
    kfree_sized(a2, 32);
    var a3 = kmalloc(32);
    test_assert(a3 != 0, "re-alloc after free", 19);
    # Re-allocated memory should be zeroed (security)
    test_assert_eq(load64(a3), 0, "re-alloc is zeroed", 18);
    kfree_sized(a3, 32);

    # Different size classes don't interfere
    var s1 = kmalloc(32);
    var s2 = kmalloc(256);
    var s3 = kmalloc(4096);
    test_assert(s1 != 0, "multi-class 32B", 15);
    test_assert(s2 != 0, "multi-class 256B", 16);
    test_assert(s3 != 0, "multi-class 4096B", 17);
    test_assert(s1 != s2, "multi-class distinct 32!=256", 28);
    test_assert(s2 != s3, "multi-class distinct 256!=4096", 30);
    kfree_sized(s1, 32);
    kfree_sized(s2, 256);
    kfree_sized(s3, 4096);

    return 0;
}

# === VFS Tests ===
fn test_vfs() {
    serial_println("[vfs]", 5);

    # FD 0 is pre-allocated (serial device)
    var fd0_type = load64(vfs_fd_table());
    test_assert_eq(fd0_type, 1, "fd 0 is device type", 19);

    # Create memfile and read back
    var fd = vfs_create_memfile("HELLO", 5);
    test_assert(fd > 0, "memfile create returns fd", 25);
    var buf[16];
    var n = vfs_read(fd, &buf, 16);
    test_assert_eq(n, 5, "memfile read returns 5", 22);
    test_assert(memeq(&buf, "HELLO", 5) == 1, "memfile data correct", 20);

    # Second read returns 0 (EOF)
    var n2 = vfs_read(fd, &buf, 16);
    test_assert_eq(n2, 0, "memfile EOF returns 0", 21);

    # Close and verify type cleared
    vfs_close(fd);
    var closed_type = load64(vfs_fd_table() + fd * 32);
    test_assert_eq(closed_type, 0, "close clears fd type", 20);

    # Read on closed fd returns -1
    var n3 = vfs_read(fd, &buf, 16);
    test_assert_eq(n3, 0 - 1, "read closed fd = -1", 19);

    # Invalid fd returns -1
    test_assert_eq(vfs_read(0 - 1, &buf, 16), 0 - 1, "read fd=-1 rejected", 19);
    test_assert_eq(vfs_read(32, &buf, 16), 0 - 1, "read fd=32 rejected", 19);
    test_assert_eq(vfs_close(0 - 1), 0 - 1, "close fd=-1 rejected", 20);
    test_assert_eq(vfs_close(32), 0 - 1, "close fd=32 rejected", 20);

    # Pipe create, write, read
    var pfds[16];                     # BYTES (function-local): the pipe writes two u64 (rfd@0, wfd@8)
    var pr = vfs_create_pipe(&pfds);
    test_assert_eq(pr, 0, "pipe create ok", 14);
    var rfd = load64(&pfds);
    var wfd = load64(&pfds + 8);
    test_assert(rfd > 0, "pipe read fd valid", 18);
    test_assert(wfd > 0, "pipe write fd valid", 19);
    test_assert(rfd != wfd, "pipe fds distinct", 17);

    # Write to pipe and read back
    var wn = vfs_write(wfd, "PIPE", 4);
    test_assert_eq(wn, 4, "pipe write 4 bytes", 18);
    var pbuf[16];
    var rn = vfs_read(rfd, &pbuf, 16);
    test_assert_eq(rn, 4, "pipe read 4 bytes", 17);
    test_assert(memeq(&pbuf, "PIPE", 4) == 1, "pipe data correct", 17);

    # ⛔⛔ 1.56.53 — THIS ASSERTED THE OLD CONTRACT AND FAILED BY CONSTRUCTION, and it was on record as
    # a mystery. It read `test_assert_eq(rn2, 0, "empty pipe read = 0")`, which was correct until the
    # streaming-pipe work ("ipc bites 10/11", 1.56.39-40) made an empty pipe return **-2 WOULD_BLOCK**
    # while any writer is still open, and 0 only once every writer has closed — the change that lets a
    # reader tell "nothing yet" from "end of stream". `wfd` is open on the line below, so this could
    # never again read 0. state.md listed it among six ktest failures it called "pre-existing" and
    # "Unexplained"; it was neither — it was created by that fix and nothing swept the callers.
    # ⇒ A gate that cannot pass is not pre-existing noise, it is an unswept contract change wearing a
    # mystery`s clothes. Now it asserts BOTH halves of the real contract.
    var rn2 = vfs_read(rfd, &pbuf, 16);
    test_assert_eq(rn2, 0 - 2, "empty pipe + open writer = -2", 29);

    # Write on read-end rejected
    var bad_w = vfs_write(rfd, "X", 1);
    test_assert_eq(bad_w, 0 - 1, "write on read-end = -1", 22);

    # Read on write-end rejected
    var bad_r = vfs_read(wfd, &pbuf, 16);
    test_assert_eq(bad_r, 0 - 1, "read on write-end = -1", 22);

    # ⭐ THE OTHER HALF: once every writer is closed, the same read must return 0 = EOF. Without this
    # arm the assertion above is satisfied by a pipe that ALWAYS returns -2, which would make a reader
    # spin forever instead of terminating — the exact shape the -2/0 split exists to prevent.
    vfs_close(wfd);
    var rn3 = vfs_read(rfd, &pbuf, 16);
    test_assert_eq(rn3, 0, "empty pipe + writers closed = 0 (EOF)", 37);

    vfs_close(rfd);

    return 0;
}

# === Process Tests ===
fn test_proc() {
    serial_println("[proc]", 6);

    # proc_count tracks correctly
    var before = proc_count;
    test_assert(before > 0, "proc_count > 0 at start", 23);

    # proc_get_state for valid pid
    var st = proc_get_state(0);
    test_assert(st >= 0, "pid 0 state valid", 17);

    # proc_get_state for out-of-bounds pid
    test_assert_eq(proc_get_state(99), 0 - 1, "state pid=99 rejected", 21);

    # proc_set_cr3 bounds check
    test_assert_eq(proc_set_cr3(99, 0), 0 - 1, "set_cr3 pid=99 rejected", 23);

    # proc_get_cr3 bounds check
    test_assert_eq(proc_get_cr3(99), 0, "get_cr3 pid=99 returns 0", 24);

    # Signal delivery
    proc_send_signal(0, 10);
    var sig = load64(&proc_signals);
    test_assert((sig & (1 << 10)) != 0, "signal 10 delivered", 19);
    # Clear it
    store64(&proc_signals, sig & (0 - 1 - (1 << 10)));

    # Signal mask — clear all pending first
    store64(&proc_signals, 0);
    store64(&proc_sigmask, 1 << 10);
    proc_send_signal(0, 10);
    var unmasked = proc_check_pending_signals(0);
    test_assert_eq(unmasked, 0, "masked signal not unmasked", 26);
    # Clear
    store64(&proc_signals, 0);
    store64(&proc_sigmask, 0);
    pending_signal_flag = 0;

    return 0;
}

# === Syscall Tests ===
fn test_syscall() {
    serial_println("[syscall]", 9);

    # getpid returns current process
    var pid = ksyscall(2, 0, 0, 0);
    test_assert_eq(pid, proc_current_get(), "getpid == proc_current_get()", 28);

    # getuid returns 0 (root)
    var uid = ksyscall(15, 0, 0, 0);
    test_assert_eq(uid, 0, "getuid == 0 (root)", 18);

    # write to fd 0 (serial) returns byte count
    var wn = ksyscall(1, 0, ".", 1);
    test_assert_eq(wn, 1, "write(0, '.', 1) = 1", 20);

    # read with invalid fd
    var rbuf[8];
    var rn = ksyscall(5, 99, &rbuf, 8);
    test_assert_eq(rn, 0 - 1, "read(99) = -1", 13);

    # close invalid fd
    var cn = ksyscall(6, 99, 0, 0);
    test_assert_eq(cn, 0 - 1, "close(99) = -1", 14);
    # 1.57.7 (S5): #56's address-class decode and #106's packing (pure functions).
    test_assert_eq(sock_listen_decode(7070), 7070, "sock_listen_decode(7070)", 24);
    test_assert_eq(sock_listen_decode(7070 | (1 << 32)), 0x10000 | 7070, "decode(7070|1<<32) = LOOPBACK", 29);
    test_assert_eq(sock_listen_decode(7070 | (1 << 16)), 0 - 1, "decode(bit 16) = -1", 19);
    test_assert_eq(sock_listen_decode(0x100000000), 0 - 1, "decode(class 1, port 0) = -1", 28);
    test_assert_eq(sock_listen_decode(7070 | (2 << 32)), 0 - 1, "decode(class 2) = -1", 20);
    test_assert_eq(sock_listen_decode(7070 | (1 << 40)), 0 - 1, "decode(bit 40) = -1", 19);
    test_assert_eq(sock_listen_decode(0), 0 - 1, "decode(0) = -1", 14);
    test_assert_eq(sock_listen_decode(0 - 1), 0 - 1, "decode(-1) = -1", 15);
    test_assert_eq(tcp_peer_pack(0x7F000001, 7072), 0x7F0000011BA0, "tcp_peer_pack(127.0.0.1, 7072)", 30);

    # open + read + close via initrd
    var fd = ksyscall(7, "hello.txt", 9, 0);
    if (fd >= 0) {
        var obuf[16];
        var on = ksyscall(5, fd, &obuf, 16);
        test_assert(on > 0, "initrd read returns data", 24);
        ksyscall(6, fd, 0, 0);
        test_assert(1 == 1, "initrd open/read/close ok", 25);
    } else {
        test_assert(1 == 1, "initrd not loaded (skip)", 24);
    }

    # pipe syscall
    var pfds[16];                     # BYTES (function-local): the pipe writes two u64 (rfd@0, wfd@8)
    var pr = ksyscall(25, &pfds, 0, 0);
    test_assert_eq(pr, 0, "pipe syscall returns 0", 22);
    var rpfd = load64(&pfds);
    var wpfd = load64(&pfds + 8);
    test_assert(rpfd > 0, "pipe syscall read fd", 20);
    test_assert(wpfd > 0, "pipe syscall write fd", 21);
    ksyscall(6, rpfd, 0, 0);
    ksyscall(6, wpfd, 0, 0);

    return 0;
}

# === String/Fmt Tests (kernel stdlib) ===
fn test_kstdlib() {
    serial_println("[kstdlib]", 9);

    # strlen
    test_assert_eq(strlen("hello"), 5, "strlen hello = 5", 16);
    test_assert_eq(strlen(""), 0, "strlen empty = 0", 16);

    # streq
    test_assert_eq(streq("abc", "abc"), 1, "streq equal", 11);
    test_assert_eq(streq("abc", "xyz"), 0, "streq not equal", 15);
    test_assert_eq(streq("ab", "abc"), 0, "streq diff len", 14);

    # memeq
    test_assert_eq(memeq("abc", "abc", 3), 1, "memeq equal", 11);
    test_assert_eq(memeq("abc", "abd", 3), 0, "memeq differ", 12);
    test_assert_eq(memeq("abc", "abc", 0), 1, "memeq len=0", 11);

    # memcpy
    var dst[8];
    memcpy(&dst, "COPY", 4);
    store8(&dst + 4, 0);
    test_assert_eq(memeq(&dst, "COPY", 4), 1, "memcpy correct", 14);

    # memset
    var zbuf[8];
    memset(&zbuf, 0x41, 4);
    test_assert_eq(load8(&zbuf), 0x41, "memset byte 0", 13);
    test_assert_eq(load8(&zbuf + 3), 0x41, "memset byte 3", 13);

    # memchr
    test_assert_eq(memchr("hello", 108, 5), 2, "memchr 'l' at 2", 15);
    test_assert_eq(memchr("hello", 122, 5), 0 - 1, "memchr miss = -1", 16);

    # strchr
    test_assert_eq(strchr("hello", 108), 2, "strchr 'l' at 2", 15);
    test_assert_eq(strchr("hello", 122), 0 - 1, "strchr miss = -1", 16);

    # atoi
    test_assert_eq(atoi("42"), 42, "atoi 42", 7);
    test_assert_eq(atoi("0"), 0, "atoi 0", 6);

    # fmt_int_buf
    var ibuf[24];
    var ilen = fmt_int_buf(42, &ibuf);
    test_assert_eq(ilen, 2, "fmt_int_buf 42 len=2", 20);
    test_assert_eq(memeq(&ibuf, "42", 2), 1, "fmt_int_buf 42 correct", 22);

    var ilen2 = fmt_int_buf(0, &ibuf);
    test_assert_eq(ilen2, 1, "fmt_int_buf 0 len=1", 19);
    test_assert_eq(load8(&ibuf), 48, "fmt_int_buf 0 = '0'", 19);

    # fmt_hex_buf
    var hbuf[24];   # 1.56.52: fmt_hex_buf writes 17 B (16 digits + NUL) — [16] was a 1-byte OOB stack write
    var hlen = fmt_hex_buf(255, &hbuf);
    test_assert_eq(hlen, 2, "fmt_hex_buf ff len=2", 20);
    test_assert_eq(memeq(&hbuf, "ff", 2), 1, "fmt_hex_buf ff correct", 22);

    var hlen2 = fmt_hex_buf(0, &hbuf);
    test_assert_eq(hlen2, 1, "fmt_hex_buf 0 len=1", 19);

    # 1.56.52 REGRESSION LOCKS. A NEGATIVE value used to render as an EMPTY STRING (the loop gate was
    # a signed `> 0`), which three fault_kill_current sites then reported as a fabricated "0" — so the
    # kernel's own crash record claimed cr2 was null for any high-half faulting address. 0x8000...0087
    # is the exact shape proc_map_page_nx writes into every W^X PDE.
    var hlen_neg = fmt_hex_buf(0 - 9223372036854775807 - 1, &hbuf);   # INT64_MIN, bit 63 set
    test_assert_eq(hlen_neg, 16, "fmt_hex_buf negative len=16", 27);
    test_assert_eq(memeq(&hbuf, "8000000000000000", 16), 1, "fmt_hex_buf negative correct", 28);

    # fmt_int_buf: INT64_MIN negates to itself, so the old code rendered it as a bare "-".
    var ibuf2[24];
    var ilen_min = fmt_int_buf(0 - 9223372036854775807 - 1, &ibuf2);
    test_assert_eq(ilen_min, 20, "fmt_int_buf INT64_MIN len=20", 28);
    test_assert_eq(memeq(&ibuf2, "-9223372036854775808", 20), 1, "fmt_int_buf INT64_MIN correct", 29);
    var ilen_neg1 = fmt_int_buf(0 - 1, &ibuf2);
    test_assert_eq(ilen_neg1, 2, "fmt_int_buf -1 len=2", 20);
    test_assert_eq(memeq(&ibuf2, "-1", 2), 1, "fmt_int_buf -1 correct (no spurious 0)", 38);

    return 0;
}

# === Initrd Tests ===
fn test_initrd() {
    serial_println("[initrd]", 8);

    test_assert(initrd_count > 0, "initrd has files", 16);

    # Find existing file
    var idx = initrd_find("hello.txt", 9);
    test_assert(idx >= 0, "find hello.txt", 14);

    # Find nonexistent file
    var idx2 = initrd_find("nope", 4);
    test_assert_eq(idx2, 0 - 1, "find nope = -1", 14);

    # Open and read
    var fd = initrd_open("hello.txt", 9);
    test_assert(fd >= 0, "open hello.txt ok", 17);
    if (fd >= 0) {
        var buf[32];
        var n = vfs_read(fd, &buf, 32);
        test_assert(n > 0, "read hello.txt data", 19);
        test_assert(memeq(&buf, "Hello, AGNOS!", 13) == 1, "hello.txt content", 17);
        vfs_close(fd);
    }

    # Name match edge: partial match should fail
    var idx3 = initrd_find("hello", 5);
    test_assert_eq(idx3, 0 - 1, "partial name no match", 21);

    return 0;
}

# ═══════════════ 1.57.7 (S7) — ktest [lifecycle] (docs/architecture/process-lifecycle.md) ═══════════════
# The pure decision rows (wstat, authority, desc_walk, zombie_pred, the lc_* tables) with synthetic inputs, the kill#16
# arm's argument validation from kmain (init), the atomics, the unborn-slot release, the birth check through
# proc_create_user's real call site (T-L10), the klug lock's bound, the deferred spill, and the raw-disk arm owner.
# T-L2 / T-L7 carry the retired PPID_SELFTEST's assertions (a hand-run gate is not a gate).
fn tl_row3(tp, tpe, i, p, pe) { store64(tp + i * 8, p); store64(tpe + i * 8, pe); return 0; }
# 1.57.7 (S8): [limits] — K1 lim_eff, K2 spawn_limits#107 validation + cells, K3 elf_load_pages, K4 the footprint walk
# over a synthetic address space (low + high arena, two PDPT entries), K5 ptw_pt_ok. (K6 = T-L1 wstat(152,24)=280.)
fn tk_ph(ph, i, ty, va, msz) {
    var tp_p = ph + i * 56;
    memset(tp_p, 0, 56);
    store32(tp_p, ty);
    store64(tp_p + 16, va);
    store64(tp_p + 40, msz);
    return 0;
}
fn tk_arm(k2, a, b, want, m, c, name, nlen) {
    var ka_r = ksyscall(107, a, b, 0);
    var ka_ok = 0;
    if (ka_r == want) { if (load64(&proc_arm_mem + k2 * 8) == m) { if (load64(&proc_arm_cpu + k2 * 8) == c) { ka_ok = 1; } } }
    test_assert(ka_ok, name, nlen);
    return 0;
}
fn test_limits() {
    serial_println("[limits]", 8);
    test_assert_eq(lim_eff(0, 0), 0, "K1 lim_eff(0,0)=0", 17);
    test_assert_eq(lim_eff(0, 5), 5, "K1 lim_eff(0,5)=5", 17);
    test_assert_eq(lim_eff(7, 0), 7, "K1 lim_eff(7,0)=7", 17);
    test_assert_eq(lim_eff(7, 5), 5, "K1 lim_eff(7,5)=5", 17);
    test_assert_eq(lim_eff(5, 7), 5, "K1 lim_eff(5,7)=5 (an arm only lowers)", 38);
    var k2 = proc_current_get();
    lim_arm_clear(k2);
    tk_arm(k2, 512, 0, 0, 512, 0, "K2 arm (512,0) -> 0", 19);
    tk_arm(k2, 0 - 1, 0, 0 - 1, 512, 0, "K2 (-1,0) refused, arm unchanged", 32);
    tk_arm(k2, 0, 0 - 1, 0 - 1, 512, 0, "K2 (0,-1) refused, arm unchanged", 32);
    tk_arm(k2, 0x1000000001, 0, 0 - 1, 512, 0, "K2 (2^36+1,0) refused", 21);
    tk_arm(k2, 0, 0x10000000001, 0 - 1, 512, 0, "K2 (0,2^40+1) refused", 21);
    tk_arm(k2, 512, 1, 0, 512, 1, "K2 (512,1) -> cells 512/1", 25);
    tk_arm(k2, 0, 10, 0, 0, 1, "K2 (0,10) -> cells 0/1 (replaces both)", 38);
    tk_arm(k2, 0, 11, 0, 0, 2, "K2 (0,11) -> 2 ticks (ceil)", 27);
    tk_arm(k2, 0x1000000000, 0x10000000000, 0, 0x1000000000, 0x199999999A, "K2 (2^36,2^40) accepted", 23);
    tk_arm(k2, 0, 0, 0, 0, 0, "K2 (0,0) disarms", 16);
    lim_arm_clear(k2);
    var ph[512];                                   # 512 BYTES: up to 9 phdrs of 56
    tk_ph(&ph, 0, 1, 0x400000, 0x1000);
    test_assert_eq(elf_load_pages(&ph, 1, 56), 1, "K3 one page", 11);
    tk_ph(&ph, 1, 1, 0x800000, 0x3000);
    test_assert_eq(elf_load_pages(&ph, 2, 56), 2, "K3 text + data -> 2", 19);
    tk_ph(&ph, 0, 1, 0x5FF000, 0x2000);
    test_assert_eq(elf_load_pages(&ph, 1, 56), 2, "K3 straddling segment -> 2", 26);
    tk_ph(&ph, 0, 1, 0x400000, 0);
    test_assert_eq(elf_load_pages(&ph, 1, 56), 0, "K3 aligned memsz 0 -> 0", 23);
    tk_ph(&ph, 0, 1, 0x400800, 0);
    test_assert_eq(elf_load_pages(&ph, 1, 56), 1, "K3 unaligned memsz 0 -> 1", 25);
    tk_ph(&ph, 0, 0, 0x400000, 0x1000);
    tk_ph(&ph, 1, 1, 0x400000, 0x1000);
    test_assert_eq(elf_load_pages(&ph, 2, 56), 1, "K3 PT_NULL ignored", 18);
    tk_ph(&ph, 0, 1, 0x400000, 0x1000);
    tk_ph(&ph, 1, 1, 0x401000, 0x1000);
    test_assert_eq(elf_load_pages(&ph, 2, 56), 0 - 1, "K3 two segments in one page -> -1", 33);
    tk_ph(&ph, 0, 1, 0x400000, 0xBB);
    tk_ph(&ph, 1, 1, 0x401000, 0x1000);
    test_assert_eq(elf_load_pages(&ph, 2, 56), 0 - 1, "K3 ovl phdrs -> -1", 18);
    tk_ph(&ph, 1, 1, 0x600000, 0x1000);
    test_assert_eq(elf_load_pages(&ph, 2, 56), 2, "K3 ovlok phdrs -> 2", 19);
    test_assert_eq(ptw_pt_ok(0x400000), 1, "K5 ptw_pt_ok(0x400000)=1", 24);
    test_assert_eq(ptw_pt_ok(0x3FF000), 0, "K5 ptw_pt_ok(0x3FF000)=0", 24);
    test_assert_eq(ptw_pt_ok(0xFFFF000), 1, "K5 ptw_pt_ok(0xFFFF000)=1", 25);
    test_assert_eq(ptw_pt_ok(0x10000000), 0, "K5 ptw_pt_ok(0x10000000)=0", 26);
    test_assert_eq(ptw_pt_ok(0x400800), 0, "K5 ptw_pt_ok(0x400800)=0", 24);
    test_assert_eq(ptw_pt_ok(0), 0, "K5 ptw_pt_ok(0)=0", 17);
    test_assert_eq(ptw_pt_ok(0 - 4096), 0, "K5 ptw_pt_ok(-4096)=0", 21);
    # K4 — needs 5 frames + page tables; too little RAM is a FAILURE, never a pass.
    if (pmm_count_2mb_free() < 6) { test_assert(0, "K4 SKIP: < 6 free 2 MB pages", 28); return 0; }
    var k4_f2 = pmm_count_2mb_free();
    var k4_f4 = pmm_free_count();
    var k4_cr3 = proc_create_address_space();
    if (k4_cr3 == 0) { test_assert(0, "K4 address space", 16); return 0; }
    var k4_hf = himmap_floor();
    var k4_ok = 1;
    if (proc_map_page_nx(k4_cr3, 0x10000000, pmm_alloc_2mb()) != 0) { k4_ok = 0; }
    if (proc_map_page_nx(k4_cr3, 0x10200000, pmm_alloc_2mb()) != 0) { k4_ok = 0; }
    if (proc_map_page_hi(k4_cr3, k4_hf, pmm_alloc_2mb()) != 0) { k4_ok = 0; }
    if (proc_map_page_hi(k4_cr3, k4_hf + 0x200000, pmm_alloc_2mb()) != 0) { k4_ok = 0; }
    if (proc_map_page_hi(k4_cr3, k4_hf + 0x40000000, pmm_alloc_2mb()) != 0) { k4_ok = 0; }
    test_assert(k4_ok, "K4 five pages mapped", 20);
    test_assert_eq(proc_user_pages_cr3(k4_cr3), 5 * 512, "K4 footprint = 5 x 512 (2 low + 3 high, 2 PDPTEs)", 49);
    test_assert_eq(proc_va_present_2mb(k4_cr3, 0x10200000), 1, "K4 low page present", 19);
    test_assert_eq(proc_va_present_2mb(k4_cr3, 0x10400000), 0, "K4 next low page absent", 23);
    test_assert_eq(proc_va_present_2mb(k4_cr3, k4_hf + 0x40000000), 1, "K4 high page present", 20);
    test_assert_eq(proc_va_present_2mb(k4_cr3, k4_hf + 0x80000000), 0, "K4 absent PDPT entry -> 0", 25);
    test_assert_eq(proc_user_pages_cr3(0x1000), 0, "K4 boot cr3 -> 0", 16);
    proc_free_address_space(k4_cr3);
    test_assert_eq(pmm_count_2mb_free(), k4_f2, "K4 2 MB pages restored", 22);
    test_assert_eq(pmm_free_count(), k4_f4, "K4 4 KB pages restored", 22);
    return 0;
}

fn test_lifecycle() {
    serial_println("[lifecycle]", 11);
    test_assert_eq(wstat_encode(0, 0), 0, "T-L1 wstat(0,0)=0", 17);
    test_assert_eq(wstat_encode(7, 0), 7, "T-L1 wstat(7,0)=7", 17);
    test_assert_eq(wstat_encode(265, 0), 9, "T-L1 wstat(265,0)=9", 19);
    test_assert_eq(wstat_encode(0 - 2, 0), 254, "T-L1 wstat(0-2,0)=254", 21);
    test_assert_eq(wstat_encode(0 - 1, 0), 255, "T-L1 wstat(0-1,0)=255", 21);
    test_assert_eq(wstat_encode(142, 0), 142, "T-L1 wstat(142,0)=142", 21);
    test_assert_eq(wstat_encode(256, 0), 0, "T-L1 wstat(256,0)=0", 19);
    test_assert_eq(wstat_encode(137, 9), 265, "T-L1 wstat(137,9)=265", 21);
    test_assert_eq(wstat_encode(152, 24), 280, "T-L1 wstat(152,24)=280", 22);
    test_assert(sig_auth_ok(0, 5, 3, 1, 9) == 1, "T-L2 init signals anyone", 24);
    test_assert(sig_auth_ok(4, 0, 0, 0, 1) == 0, "T-L2 non-init never signals 0", 29);
    test_assert(sig_auth_ok(4, 4, 2, 1, 1) == 1, "T-L2 self", 9);
    test_assert(sig_auth_ok(3, 5, 3, 7, 7) == 1, "T-L2 child with matching epoch", 30);
    test_assert(sig_auth_ok(3, 5, 3, 6, 7) == 0, "T-L2 child with STALE epoch refused", 35);
    test_assert(sig_auth_ok(2, 5, 3, 7, 7) == 0, "T-L2 stranger refused", 21);
    test_assert(reap_auth_ok(0, 3, 7, 9) == 1, "T-L2 init reaps anyone", 22);
    test_assert(reap_auth_ok(3, 3, 7, 7) == 1, "T-L2 parent reaps child", 23);
    test_assert(reap_auth_ok(3, 3, 6, 7) == 0, "T-L2 stale-epoch reap refused", 29);
    test_assert(reap_auth_ok(2, 3, 7, 7) == 0, "T-L2 stranger reap refused", 26);
    var tp[128];
    var tpe[128];
    var te[128];
    var tl_i = 0;
    while (tl_i < 16) { store64(&te + tl_i * 8, 100 + tl_i); store64(&tp + tl_i * 8, 0); store64(&tpe + tl_i * 8, 100); tl_i = tl_i + 1; }
    tl_row3(&tp, &tpe, 1, 0, 100);
    tl_row3(&tp, &tpe, 3, 1, 101);
    tl_row3(&tp, &tpe, 4, 3, 103);
    tl_row3(&tp, &tpe, 5, 4, 104);
    tl_row3(&tp, &tpe, 6, 6, 106);
    tl_row3(&tp, &tpe, 7, 0, 100);
    tl_row3(&tp, &tpe, 8, 9, 109);
    tl_row3(&tp, &tpe, 9, 8, 108);
    test_assert_eq(desc_walk(4, 3, &tp, &tpe, &te, 16), 1, "T-L3 child 4 of root 3", 22);
    test_assert_eq(desc_walk(5, 3, &tp, &tpe, &te, 16), 1, "T-L3 grandchild 5 (dead intermediate links)", 43);
    store64(&tpe + 4 * 8, 999);
    test_assert_eq(desc_walk(5, 3, &tp, &tpe, &te, 16), 0, "T-L3 stale link refused", 23);
    store64(&tpe + 4 * 8, 103);
    test_assert_eq(desc_walk(6, 3, &tp, &tpe, &te, 16), 0, "T-L3 self-parent refused", 24);
    test_assert_eq(desc_walk(7, 3, &tp, &tpe, &te, 16), 0, "T-L3 ppid 0 never meets root", 28);
    test_assert_eq(desc_walk(3, 3, &tp, &tpe, &te, 16), 0, "T-L3 q == root is 0", 19);
    test_assert_eq(desc_walk(8, 3, &tp, &tpe, &te, 16), 0, "T-L3 2-cycle terminates 0", 25);
    test_assert_eq(chan_pty_desc_pure(3, 3, &tp, &tpe, &te, 16), 1, "T-L11 owner itself", 18);
    test_assert_eq(chan_pty_desc_pure(3, 5, &tp, &tpe, &te, 16), 1, "T-L11 grandchild with valid links", 33);
    store64(&tpe + 5 * 8, 999);
    test_assert_eq(chan_pty_desc_pure(3, 5, &tp, &tpe, &te, 16), 0, "T-L11 stale link refused", 24);
    store64(&tpe + 5 * 8, 104);
    test_assert_eq(chan_pty_desc_pure(4, 3, &tp, &tpe, &te, 16), 0, "T-L11 swapped owner/cur refused", 31);
    var tl_s0 = load64(&proc_signals);
    test_assert_eq(ksyscall(16, 0, 0, 0), 0, "T-L4 kill(0,0) probe = 0", 24);
    test_assert_eq(load64(&proc_signals), tl_s0, "T-L4 probe sets no bit", 22);
    test_assert_eq(ksyscall(16, 0, 0x209, 0), 0 - 1, "T-L4 kill(0,0x209) = -1", 23);
    test_assert_eq(ksyscall(16, 0, 64, 0), 0 - 1, "T-L4 kill(0,64) = -1", 20);
    test_assert_eq(ksyscall(16, 0, 0 - 1, 0), 0 - 1, "T-L4 kill(0,-1) = -1", 20);
    test_assert_eq(ksyscall(16, proc_count, 9, 0), 0 - 1, "T-L4 kill(proc_count,9) = -1", 28);
    test_assert_eq(ksyscall(16, 0, 10, 0), 0, "T-L4 kill(0,10) = 0", 19);
    test_assert((load64(&proc_signals) & (1 << 10)) != 0, "T-L4 bit 10 set", 15);
    atomic_and64(&proc_signals, 0 - 1 - (1 << 10));
    test_assert_eq(ksyscall(16, 0, 9, 0), 0 - 1, "T-L4 kill(0,9) = -1 (not a user process)", 40);
    test_assert_eq(ksyscall(16, 0, 9 | 0x100, 0), 0 - 1, "T-L4 kill(0,9|TREE) = -1", 24);
    test_assert_eq(ksyscall(16, 0, 19, 0), 0 - 1, "T-L4 kill(0,19) = -1", 20);
    test_assert_eq(ksyscall(16, 0, 18, 0), 0 - 1, "T-L4 kill(0,18) = -1", 20);
    test_assert_eq(proc_is_user(0), 0, "T-L5 kmain is not a user process", 32);
    test_assert_eq(proc_stoppable(0), 0, "T-L5 kmain is not stoppable", 27);
    test_assert_eq(proc_is_user(proc_count), 0, "T-L5 proc_is_user(proc_count) = 0", 33);
    test_assert_eq(proc_parent_live(proc_count), 0, "T-L5 proc_parent_live(proc_count) = 0", 37);
    test_assert_eq(zombie_pred(0, 3, 1, 0), 1, "T-L6 live-parent zombie", 23);
    test_assert_eq(zombie_pred(0, 3, 0, 0), 0, "T-L6 parent gone (dead/recycled/done) -> not a zombie", 53);
    test_assert_eq(zombie_pred(2, 3, 1, 0), 0, "T-L6 alive child is not a zombie", 32);
    test_assert_eq(zombie_pred(0, 0, 1, 1), 1, "T-L6 kmain fg child is a zombie", 31);
    test_assert_eq(zombie_pred(0, 0, 1, 0), 0, "T-L6 reaped slot is not a zombie", 32);
    test_assert_eq(lc_parent_live(3, 8, 0, 5, 5, 0), 0, "T-L6 parent_live: dead parent gone", 34);
    test_assert_eq(lc_parent_live(3, 8, 2, 5, 5, 1), 0, "T-L6 parent_live: done parent gone", 34);
    test_assert_eq(proc_get_ppid(proc_count), 0 - 1, "T-L7 proc_get_ppid(proc_count) = -1", 35);
    if (proc_count < 16) {
        var tl7_f = kbd_irq_save();
        var tl7_r = proc_count;
        var tl7_c = load64(&proc_on_cpu + tl7_r * 8);
        store64(&proc_on_cpu + tl7_r * 8, pcpu_cpu());
        proc_reap_off_cpu_fence(tl7_r);
        var tl7_ok = 0;
        if (on_cpu_get(tl7_r) == (0 - 1)) { tl7_ok = 1; }
        store64(&proc_on_cpu + tl7_r * 8, tl7_c);
        kbd_irq_restore(tl7_f);
        test_assert(tl7_ok == 1, "T-L7 reap fence self-owned fast path", 36);
    }
    var tl8[8];
    store64(&tl8, 0x5);
    atomic_or64(&tl8, 0x100);
    test_assert_eq(load64(&tl8), 0x105, "T-L8 atomic_or64 sets, keeps the rest", 37);
    atomic_and64(&tl8, 0 - 1 - 1);
    test_assert_eq(load64(&tl8), 0x104, "T-L8 atomic_and64 clears, keeps the rest", 40);
    var tl9 = proc_alloc_slot();
    if (tl9 >= 0) {
        store64(&proc_ppid + tl9 * 8, 3);
        store64(&proc_ppid_epoch + tl9 * 8, 7);
        store64(&proc_kill_pending + tl9 * 8, 9);
        store64(&proc_stop_pending + tl9 * 8, 1);
        var tl9_pc = proc_count;
        proc_slot_release_unborn(tl9);
        var tl9_ok = 1;
        if (load64(&proc_table + tl9 * 176 + 8) != 0) { tl9_ok = 0; }
        if (load64(&proc_ppid + tl9 * 8) != 0) { tl9_ok = 0; }
        if (load64(&proc_ppid_epoch + tl9 * 8) != 0) { tl9_ok = 0; }
        if (load64(&proc_kill_pending + tl9 * 8) != 0) { tl9_ok = 0; }
        if (load64(&proc_stop_pending + tl9 * 8) != 0) { tl9_ok = 0; }
        if (load64(&proc_table + tl9 * 176 + 160) != 0x1000) { tl9_ok = 0; }
        if (tl9 < proc_count) {
            if (proc_is_zombie(tl9) != 0) { tl9_ok = 0; }
        }
        if (proc_slot_reusable(tl9) != 1) { tl9_ok = 0; }
        test_assert(tl9_ok == 1, "T-L9 release_unborn clears the whole row", 40);
    }
    var tl10_pc = proc_count;
    var tl10_f = kbd_irq_save();
    sched_spin_lock(); store64(&proc_kill_pending, 9); sched_spin_unlock();
    var tl10_r = proc_create_user(0, 0);
    sched_spin_lock(); store64(&proc_kill_pending, 0); sched_spin_unlock();
    var tl10_three = 0;
    var tl10_i = 0;
    while (tl10_i < proc_count) { if (load64(&proc_table + tl10_i * 176 + 8) == 3) { tl10_three = tl10_three + 1; } tl10_i = tl10_i + 1; }
    kbd_irq_restore(tl10_f);
    test_assert_eq(tl10_r, 0 - 1, "T-L10 a creator with a pending kill creates no child", 52);
    test_assert_eq(tl10_three, 0, "T-L10 no CLAIMING slot left behind", 34);
    test_assert_eq(proc_count, tl10_pc, "T-L10 proc_count restored", 25);
    var tl10b_f = kbd_irq_save();
    sched_spin_lock(); store64(&proc_stop_pending, 2); sched_spin_unlock();
    var tl10b = proc_create_user(0, 0);
    sched_spin_lock(); store64(&proc_stop_pending, 0); sched_spin_unlock();
    var tl10b_sp = 0 - 1;
    if (tl10b >= 0) { tl10b_sp = load64(&proc_stop_pending + tl10b * 8); proc_destroy_fd_table(tl10b, 0); proc_slot_release_unborn(tl10b); }
    sched_spin_lock(); store64(&proc_stop_pending, 1); sched_spin_unlock();
    var tl10c = proc_create_user(0, 0);
    sched_spin_lock(); store64(&proc_stop_pending, 0); sched_spin_unlock();
    var tl10c_sp = 0 - 1;
    if (tl10c >= 0) { tl10c_sp = load64(&proc_stop_pending + tl10c * 8); proc_destroy_fd_table(tl10c, 0); proc_slot_release_unborn(tl10c); }
    kbd_irq_restore(tl10b_f);
    test_assert_eq(tl10b_sp, 2, "T-L10b a tree-stopped creator bears a stop-pending child", 56);
    test_assert_eq(tl10c_sp, 0, "T-L10b a direct stop is not inherited", 37);
    test_assert_eq(lc_kill_action(0, 1, 1), 0, "T-L12 kill st0 NOOP", 19);
    test_assert_eq(lc_kill_action(4, 1, 1), 0, "T-L12 kill st4 NOOP", 19);
    test_assert_eq(lc_kill_action(3, 0, 0), 1, "T-L12 kill birth MARK", 21);
    test_assert_eq(lc_kill_action(2, 0, 0), 0 - 1, "T-L12 kill non-user REFUSE", 26);
    test_assert_eq(lc_kill_action(1, 1, 1), 2, "T-L12 kill claimable CLAIM", 26);
    test_assert_eq(lc_kill_action(5, 1, 0), 3, "T-L12 kill st5 not claimable WAKE_KICK", 38);
    test_assert_eq(lc_kill_action(6, 1, 0), 4, "T-L12 kill blocked INTERRUPT", 28);
    test_assert_eq(lc_kill_action(2, 1, 0), 5, "T-L12 kill running KICK", 23);
    test_assert_eq(lc_stop_action(0, 1, 0, 1, 1, 1), 0, "T-L12 stop st0 NOOP", 19);
    test_assert_eq(lc_stop_action(1, 1, 9, 1, 1, 1), 0, "T-L12 stop with kp pending NOOP", 31);
    test_assert_eq(lc_stop_action(3, 1, 0, 1, 1, 0), 6, "T-L12 stop birth PEND_BIRTH", 27);
    test_assert_eq(lc_stop_action(1, 0, 0, 1, 1, 1), 0 - 1, "T-L12 stop non-user REFUSE", 26);
    test_assert_eq(lc_stop_action(1, 1, 0, 0, 1, 1), 0 - 1, "T-L12 stop unstoppable REFUSE", 29);
    test_assert_eq(lc_stop_action(1, 1, 0, 1, 0, 1), 0 - 1, "T-L12 stop no live parent REFUSE", 32);
    test_assert_eq(lc_stop_action(5, 1, 0, 1, 1, 1), 0, "T-L12 stop st5 NOOP", 19);
    test_assert_eq(lc_stop_action(1, 1, 0, 1, 1, 1), 2, "T-L12 stop claimable CLAIM_STOP", 31);
    test_assert_eq(lc_stop_action(6, 1, 0, 1, 1, 0), 4, "T-L12 stop blocked PEND_INTERRUPT", 33);
    test_assert_eq(lc_stop_action(2, 1, 0, 1, 1, 0), 5, "T-L12 stop running PEND_KICK", 28);
    test_assert_eq(lc_tick_action(9, 1, 1, 1), 1, "T-L12 tick kp DIE (never STOP)", 30);
    test_assert_eq(lc_tick_action(0, 0, 1, 1), 0, "T-L12 tick nothing NONE", 23);
    test_assert_eq(lc_tick_action(0, 1, 0, 1), 3, "T-L12 tick unstoppable DROP", 27);
    test_assert_eq(lc_tick_action(0, 1, 1, 0), 3, "T-L12 tick no live parent DROP", 30);
    test_assert_eq(lc_tick_action(0, 2, 1, 1), 2, "T-L12 tick STOP", 15);
    test_assert_eq(lc_park_action(9, 1, 1, 1, 0), 1, "T-L12 park kp ABORT (never PARK)", 32);
    test_assert_eq(lc_park_action(0, 0, 1, 1, 0), 0, "T-L12 park nothing CONTINUE", 27);
    test_assert_eq(lc_park_action(0, 1, 0, 1, 0), 3, "T-L12 park unstoppable DROP", 27);
    test_assert_eq(lc_park_action(0, 1, 1, 0, 0), 3, "T-L12 park no live parent DROP", 30);
    test_assert_eq(lc_park_action(0, 1, 1, 1, 1), 4, "T-L12 park preempt held PREEMPT_HELD", 36);
    test_assert_eq(lc_park_action(0, 1, 1, 1, 0), 2, "T-L12 park PARK", 15);
    test_assert_eq(lc_birth_action(9, 0), 0, "T-L12 birth kp REFUSE", 21);
    test_assert_eq(lc_birth_action(0, 2), 2, "T-L12 birth tree stop INHERIT", 29);
    test_assert_eq(lc_birth_action(0, 1), 1, "T-L12 birth direct stop OK", 26);
    test_assert_eq(lc_orphan(3, 8, 2, 5, 5, 1), 1, "T-L12 orphan: parent done -> orphan", 35);
    test_assert_eq(lc_orphan(3, 8, 2, 5, 5, 0), 0, "T-L12 orphan: live parent -> not", 32);
    test_assert_eq(lc_orphan(0, 8, 0, 0, 0, 0), 0, "T-L12 orphan: kmain child never", 31);
    test_assert_eq(lc_orphan(3, 8, 0, 5, 5, 0), 1, "T-L12 orphan: dead parent -> orphan", 35);
    test_assert_eq(lc_parent_live(3, 8, 4, 5, 5, 0), 1, "T-L12 parent_live: dying parent (not done) live", 47);
    test_assert_eq(lc_parent_live(3, 8, 2, 6, 5, 0), 0, "T-L12 parent_live: recycled parent gone", 39);
    test_assert_eq(lc_parent_live(9, 8, 2, 5, 5, 0), 0, "T-L12 parent_live: out of range gone", 36);
    # 1.57.7 ENDFIX (S7-R1): a slot being RECYCLED (state 3, CLAIMING) still carries the dead parent's epoch and a
    # scrubbed done=0 until proc_alloc_slot finishes — it is never an existing process's parent.
    test_assert_eq(lc_parent_live(3, 8, 3, 5, 5, 0), 0, "T-L12 parent_live: CLAIMING slot (a recycle in flight) gone", 59);
    test_assert_eq(lc_orphan(3, 8, 3, 5, 5, 0), 1, "T-L12 orphan: CLAIMING parent slot, old epoch, done 0 -> orphan", 63);
    var tl13_t1 = klug_lock_acquire();
    var tl13_to = klug_lock_timeouts;
    var tl13_t2 = klug_lock_acquire();
    var tl13_held2 = tl13_t2 & 1;
    var tl13_rose = klug_lock_timeouts - tl13_to;
    klug_lock_release(tl13_t2);
    klug_lock_release(tl13_t1);
    test_assert_eq(tl13_held2, 0, "T-L13 a nested acquire gives a not-held token after the bound", 61);
    test_assert(tl13_rose >= 1, "T-L13 klug_lock_timeouts counted the bound", 42);
    klug_spill_owed = 1;
    klug_spill_owed_run();
    test_assert_eq(klug_spill_owed, 0, "T-L13 klug_spill_owed_run clears the debt", 41);
    test_assert_eq(gpu_release_pid_isr(99), 0, "T-L13 gpu_release_pid_isr non-owner = 0", 39);
    test_assert_eq(klug_spill_owed, 0, "T-L13 non-owner leaves no spill debt", 36);
    var tl14_a = blk_rw_test_armed();
    var tl14_o = blk_rw_test_owner();
    blk_rw_test_set(1, 5 + 1);
    blk_rw_disarm_pid(7);
    var tl14_keep = blk_rw_test_armed();
    blk_rw_disarm_pid(5);
    var tl14_gone = blk_rw_test_armed() + blk_rw_test_owner();
    blk_rw_test_set(tl14_a, tl14_o);
    test_assert_eq(tl14_keep, 1, "T-L14 an unrelated death keeps the arm", 38);
    test_assert_eq(tl14_gone, 0, "T-L14 the arming death clears arm + owner", 41);
    return 0;
}


# === Main Test Runner ===
fn sh_cmd_test() {
    serial_println("=== AGNOS Kernel Test Suite ===", 31);
    test_pass = 0;
    test_fail = 0;

    test_pmm();
    test_heap();
    test_vfs();
    test_proc();
    test_lifecycle();       # 1.57.7 (S7): [lifecycle] — the decision rows, kill#16 validation, births, klug lock, spill, blk arm
    test_limits();          # 1.57.7 (S8): [limits] K1-K5 — spawn_limits#107, the loader pre-pass, the footprint walk
    test_fgwait();          # 1.57.7 (S3b): T12 — proc_slot_reusable + the INV-FG-2 fgwait cell (sched.cyr #ifdef TEST)
    test_wq();              # 1.57.7 (S3.4): the wait/wake primitive (sched.cyr #ifdef TEST)
    test_flock();           # 1.57.7 (S3.5): the flock table's wakes (T7) and rules (T9)
    test_syscall();
    test_kstdlib();
    test_initrd();
    test_wq_latches();      # 1.57.7 (S3.4): LAST — no latched wq/scheduler invariant fired during the suite

    serial_println("===", 3);
    serial_print("TOTAL: ", 7);
    kfmt_int(test_pass);
    serial_print(" passed, ", 9);
    kfmt_int(test_fail);
    serial_println(" failed", 7);
    if (test_fail == 0) {
        serial_println("ALL TESTS PASSED", 16);
    } else {
        serial_println("TESTS FAILED", 12);
    }
    return 0;
}
